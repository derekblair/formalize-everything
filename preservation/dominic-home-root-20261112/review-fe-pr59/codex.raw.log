     1	import Mathlib.MeasureTheory.Function.EssSup
     2	import Mathlib.Tactic.Linarith
     3	
     4	/-!
     5	Chapter 3 is inventoried in `INVENTORY-CH03.md` and otherwise deferred by Stage 2.
     6	The following declarations record a fidelity event in Definition 3.7; they are
     7	not a claim that a numbered book item has been completed.
     8	-/
     9	
    10	namespace RudinRCA.Chapter03
    11	
    12	open MeasureTheory Set
    13	open scoped ENNReal
    14	
    15	/-- The threshold set printed in 3.7, specialized to the zero function and zero
    16	measure on a singleton, has no real lower bound. Thus its real infimum cannot
    17	be used as a definition of a nonnegative norm. -/
    18	theorem definition_3_7_zero_measure_counterexample :
    19	    ¬ BddBelow {a : ℝ | (0 : Measure Unit) {_x | a < (0 : ℝ)} = 0} := by
    20	  intro h
    21	  obtain ⟨b, hb⟩ := h
    22	  have hbad : b ≤ b - 1 := hb (by simp)
    23	  linarith
    24	
    25	/-- Explicit correction of 3.7: take thresholds in the complete nonnegative
    26	extended reals. This is a correction, not a silent restatement of the book. -/
    27	noncomputable def correctedEssentialSupremum {X : Type*} [MeasurableSpace X]
    28	    (g : X → ℝ≥0∞) (μ : Measure X) : ℝ≥0∞ := essSup g μ
    29	
    30	/-- The corrected threshold construction matches the measure-zero formula. -/
    31	theorem correctedEssentialSupremum_eq_sInf {X : Type*} [MeasurableSpace X]
    32	    (g : X → ℝ≥0∞) (μ : Measure X) :
    33	    correctedEssentialSupremum g μ = sInf {a : ℝ≥0∞ | μ {x | a < g x} = 0} :=
    34	  essSup_eq_sInf μ g
    35	
    36	/-- The corrected value is the least almost-everywhere upper bound. -/
    37	theorem correctedEssentialSupremum_le_iff {X : Type*} [MeasurableSpace X]
    38	    (g : X → ℝ≥0∞) (μ : Measure X) (a : ℝ≥0∞) :
    39	    correctedEssentialSupremum g μ ≤ a ↔ ∀ᵐ x ∂μ, g x ≤ a := by
    40	  constructor
    41	  · intro h
    42	    filter_upwards [ENNReal.ae_le_essSup g] with x hx using hx.trans h
    43	  · intro h
    44	    exact essSup_le_of_ae_le a h
    45	
    46	/-- In particular, the corrected norm convention handles zero measure. -/
    47	theorem correctedEssentialSupremum_zero_measure {X : Type*} [MeasurableSpace X]
    48	    (g : X → ℝ≥0∞) : correctedEssentialSupremum g (0 : Measure X) = 0 :=
    49	  essSup_measure_zero
    50	
    51	end RudinRCA.Chapter03
   435	variable [MeasurableSpace X]
   436	
   437	/-- Outer regularity of a specified set, with the open-superset formula
   438	of 2.14(c) used by 2.15. -/
   439	def BookOuterRegularSet (μ : Measure X) (E : Set X) : Prop :=
   440	  μ E = ⨅ (V : Set X) (_ : E ⊆ V) (_ : IsOpen V), μ V
   441	
   442	/-- Inner regularity of a specified set, with the compact-subset formula
   443	of 2.14(d) used by 2.15 and 2.16. -/
   444	def BookInnerRegularSet (μ : Measure X) (E : Set X) : Prop :=
   445	  μ E = ⨆ (K : Set X) (_ : K ⊆ E) (_ : IsCompact K), μ K
   446	
   447	end SetRegularity
   448	
   449	/-- Rudin 2.15 requires both forms of regularity on every Borel set.
   450	This is deliberately not an abbreviation of Mathlib's `Measure.Regular`,
   451	whose compact inner-regularity condition only concerns open sets. -/
   452	def BookRegularBorelMeasure (μ : BookPositiveBorelMeasure X) : Prop :=
   453	  ∀ E : Set X, @MeasurableSet X (borel X) E →
   454	    @BookOuterRegularSet X _ (borel X) μ E ∧ @BookInnerRegularSet X _ (borel X) μ E
   455	
   456	/-- Expansion of the book's regularity condition with all quantifiers visible. -/
   457	theorem definition_2_15_regular (μ : BookPositiveBorelMeasure X) :
   458	    BookRegularBorelMeasure μ ↔ ∀ E : Set X, @MeasurableSet X (borel X) E →
   459	      (μ E = ⨅ (V : Set X) (_ : E ⊆ V) (_ : IsOpen V), μ V) ∧
   460	      (μ E = ⨆ (K : Set X) (_ : K ⊆ E) (_ : IsCompact K), μ K) :=
   461	  Iff.rfl
   462	
   463	/-- 2.16: sigma-compactness is a countable union of compact sets. -/
   464	theorem definition_2_16_sigmaCompact (E : Set X) :
   465	    IsSigmaCompact E ↔ ∃ K : ℕ → Set X, (∀ n, IsCompact (K n)) ∧ ⋃ n, K n = E :=
   466	  Iff.rfl
   467	
   468	section SigmaFiniteSets
   469	
   470	variable [MeasurableSpace X]
   471	
   472	/-- 2.16's setwise sigma-finiteness, rather than a global assumption on the measure.
   473	Mathlib's measure also assigns outer measures to nonmeasurable sets; the next
   474	lemma recovers a measurable cover whenever the set itself is measurable. -/
   475	def BookSigmaFiniteSet (μ : Measure X) (E : Set X) : Prop :=
   476	  ∃ A : ℕ → Set X, (∀ n, μ (A n) < ∞) ∧ ⋃ n, A n = E
   477	
   478	omit [TopologicalSpace X] in
   479	/-- On a measurable set, allowing outer-measure-finite cover sets does not
   480	change the book's measurable-set notion of sigma-finiteness. -/
   481	theorem definition_2_16_measurableCover (μ : Measure X) {E : Set X}
   482	    (hE : MeasurableSet E) :
   483	    BookSigmaFiniteSet μ E ↔ ∃ A : ℕ → Set X,
   484	      (∀ n, MeasurableSet (A n) ∧ μ (A n) < ∞) ∧ ⋃ n, A n = E := by
   485	  constructor
   486	  · rintro ⟨A, hA, hcov⟩
   487	    refine ⟨fun n => E ∩ toMeasurable μ (A n), ?_, ?_⟩
   488	    · intro n
   489	      refine ⟨hE.inter (measurableSet_toMeasurable _ _), ?_⟩
   490	      exact (measure_mono inter_subset_right).trans_lt (by simpa using hA n)
   491	    · apply subset_antisymm
   492	      · exact iUnion_subset (fun _ => inter_subset_left)
   493	      · intro x hx
   494	        obtain ⟨n, hn⟩ := mem_iUnion.mp (hcov.symm ▸ hx)
   495	        exact mem_iUnion.mpr ⟨n, hx, subset_toMeasurable μ (A n) hn⟩
   496	  · rintro ⟨A, hA, hcov⟩
   497	    exact ⟨A, fun n => (hA n).2, hcov⟩
   498	
   499	/-- The first implication following 2.16 uses exactly compact finiteness,
   500	which is clause (b) of 2.14. -/
   501	theorem proposition_2_16_sigmaFinite (μ : Measure X)
   502	    (hcompact : ∀ K : Set X, IsCompact K → μ K < ∞)
   503	    {E : Set X} (hE : IsSigmaCompact E) : BookSigmaFiniteSet μ E := by
   504	  obtain ⟨K, hK, hcov⟩ := hE
   505	  exact ⟨K, fun n => hcompact (K n) (hK n), hcov⟩
   506	
   507	/-- The second implication following 2.16. The only regularity input is
   508	2.14(d) for finite measurable sets; no global sigma-finiteness is required. -/
   509	theorem proposition_2_16_innerRegular (μ : Measure X)
   510	    (hfinite : ∀ A : Set X, MeasurableSet A → μ A < ∞ → BookInnerRegularSet μ A)
   511	    {E : Set X} (hE : MeasurableSet E) (hσ : BookSigmaFiniteSet μ E) :
   512	    BookInnerRegularSet μ E := by
   513	  obtain ⟨A, hA, hcov⟩ := (definition_2_16_measurableCover μ hE).mp hσ
   514	  have hsub (n : ℕ) : accumulate A n ⊆ E := by
   515	    rw [← hcov]
   516	    exact accumulate_subset_iUnion n
   517	  have hmeas (n : ℕ) : MeasurableSet (accumulate A n) := by
   518	    rw [accumulate_def]
   519	    exact MeasurableSet.iUnion (fun i => MeasurableSet.iUnion (fun _ => (hA i).1))
   520	  have hfin (n : ℕ) : μ (accumulate A n) < ∞ := by
   521	    rw [accumulate_def]
   522	    exact measure_biUnion_lt_top (finite_Iic n) (fun i _ => (hA i).2)
   523	  unfold BookInnerRegularSet
   524	  apply le_antisymm
   525	  · have hsup : μ E = ⨆ n, μ (accumulate A n) := by
   526	      rw [← hcov, measure_iUnion_eq_iSup_accumulate]
   527	    rw [hsup]
   528	    refine iSup_le (fun n => ?_)
   529	    rw [hfinite _ (hmeas n) (hfin n)]
   530	    refine iSup_le (fun K => iSup_le (fun hK => iSup_le (fun hc => ?_)))
   531	    exact le_iSup_of_le K (le_iSup_of_le (hK.trans (hsub n)) (le_iSup_of_le hc le_rfl))
   532	  · exact iSup_le (fun K => iSup_le (fun hK => iSup_le (fun _ => measure_mono hK)))
   533	
   534	end SigmaFiniteSets
   535	
   536	end RudinRCA.Chapter02
