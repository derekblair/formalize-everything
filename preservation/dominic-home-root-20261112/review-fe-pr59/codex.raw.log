     2	"""Exercise the real AuditA against isolated, minimal Lean fixture graphs.
     3	
     4	Run from any directory with the book's pinned toolchain and dependency cache
     5	already available:
     6	
     7	    python3 books/rudin-real-and-complex-analysis/scripts/check_audit.py
     8	
     9	The audit and umbrella are copied unchanged. Chapter contents are deliberately
    10	small fixtures; this tests the audit's rejection behavior, not the mathematics.
    11	Every case uses a fresh temporary package and fresh project oleans. Only the
    12	existing dependency directory is shared, through a symlink; no live source or
    13	live project build artifact is changed. No dependency installer is invoked.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import argparse
    19	from dataclasses import dataclass
    20	import json
    21	from pathlib import Path
    22	import shutil
    23	import subprocess
    24	import sys
    25	import tempfile
    26	
    27	
    28	PIN = "d13f23b723b8a846827a245b89c10fc7d3f11612"
    29	TOOLCHAIN = "leanprover/lean4:v4.34.1"
    30	
    31	
    32	@dataclass(frozen=True)
    33	class Case:
    34	    name: str
    35	    injection: str = ""
    36	    extra_source: bool = False
    37	    expected: tuple[str, ...] = ()
    38	
    39	
    40	CASES = (
    41	    Case("clean_baseline"),
    42	    Case(
    43	        "sorry_backed_declaration",
    44	        "theorem RudinRCA.fixtureSorry : False := by sorry\n",
    45	        expected=("depends on disallowed axiom sorryAx",),
    46	    ),
    47	    Case(
    48	        "user_axiom",
    49	        "axiom RudinRCA.fixtureUserAxiom : True\n",
    50	        expected=("Project declares an axiom: RudinRCA.fixtureUserAxiom",),
    51	    ),
    52	    Case(
    53	        "private_axiom_outside_namespace",
    54	        "namespace OutsideBook\nprivate axiom hidden : True\nend OutsideBook\n",
    55	        expected=("Project declares an axiom: _private.", "OutsideBook.hidden"),
    56	    ),
    57	    Case(
    58	        "unimported_project_source",
    59	        extra_source=True,
    60	        expected=("source module Unimported", "not imported into the audited import graph"),
    61	    ),
    62	)
    63	
    64	
    65	class Failure(Exception):
    66	    pass
    67	
    68	
    69	def invoke(lake: str, root: Path, args: list[str], timeout: float) -> subprocess.CompletedProcess[str]:
    70	    try:
    71	        return subprocess.run(
    72	            [lake, "env", "lean", *args],
    73	            cwd=root,
    74	            text=True,
    75	            stdout=subprocess.PIPE,
    76	            stderr=subprocess.STDOUT,
    77	            timeout=timeout,
    78	            check=False,
    79	        )
    80	    except subprocess.TimeoutExpired as exc:
    81	        raise Failure(f"command timed out in fixture {root.name}: {args}") from exc
    82	
    83	
    84	def write_fixture(root: Path, snapshot: dict[str, bytes], packages: Path, case: Case) -> None:
    85	    root.mkdir()
    86	    for name, content in snapshot.items():
    87	        destination = root / name
    88	        destination.parent.mkdir(parents=True, exist_ok=True)
    89	        destination.write_bytes(content)
    90	    (root / ".lake").mkdir()
    91	    (root / ".lake" / "packages").symlink_to(packages, target_is_directory=True)
    92	    for chapter in (1, 2, 3, 4, 5):
    93	        source = f"theorem RudinRCA.fixtureChapter{chapter} : True := True.intro\n"
    94	        if chapter == 1:
    95	            source += case.injection
    96	        (root / "RudinRCA" / f"Chapter{chapter:02}.lean").write_text(source)
    97	    if case.extra_source:
    98	        # Deliberately outside RudinRCA/: ownership is the source tree, not a prefix.
    99	        (root / "Unimported.lean").write_text(
   100	            "theorem OutsideBook.unimported : True := True.intro\n"
   101	        )
   102	
   103	
   104	def run_case(lake: str, root: Path, case: Case, timeout: float) -> None:
   105	    output_root = root / ".lake" / "build" / "lib" / "lean"
   106	    # Compile every project import explicitly. The empty, per-case output tree
   107	    # prevents a successful audit of stale oleans from masquerading as rejection.
   108	    for module in (
   109	        "RudinRCA/Chapter01",
   110	        "RudinRCA/Chapter02",
   111	        "RudinRCA/Chapter03",
   112	        "RudinRCA/Chapter04",
   113	        "RudinRCA/Chapter05",
   114	        "RudinRCA",
   115	    ):
   116	        output = output_root / f"{module}.olean"
   117	        output.parent.mkdir(parents=True, exist_ok=True)
   118	        result = invoke(lake, root, ["-o", str(output), f"{module}.lean"], timeout)
   119	        if result.returncode != 0:
   120	            raise Failure(
   121	                f"{case.name}: fixture compilation failed before the audit ({module}); "
   122	                f"exit {result.returncode}\n{result.stdout}"
   123	            )
   124	        if not output.is_file():
   125	            raise Failure(f"{case.name}: compiler did not produce {output}")
   126	    result = invoke(lake, root, ["RudinRCA/AuditA.lean"], timeout)
   127	    if not case.expected:
   128	        if result.returncode != 0 or "Axiom audit passed for 5 project declarations" not in result.stdout:
   129	            raise Failure(f"baseline audit did not pass nonvacuously; exit {result.returncode}\n{result.stdout}")
   130	        diagnostic = next(line for line in result.stdout.splitlines() if "Axiom audit passed" in line)
   131	        print(f"PASS {case.name}: exit 0; {diagnostic}", flush=True)
   132	        return
   133	    if result.returncode == 0:
   134	        raise Failure(f"{case.name}: audit incorrectly accepted the fixture\n{result.stdout}")
   135	    if any(fragment not in result.stdout for fragment in case.expected):
   136	        raise Failure(
   137	            f"{case.name}: audit failed for an unexpected reason; exit {result.returncode}\n{result.stdout}"
   138	        )
   139	    diagnostic = next(line for line in result.stdout.splitlines() if case.expected[0] in line)
   140	    print(f"PASS {case.name}: exit {result.returncode}; {diagnostic}", flush=True)
   141	
   142	
   143	def main() -> int:
   144	    parser = argparse.ArgumentParser(description=__doc__)
   145	    parser.add_argument("--timeout", type=float, default=120, help="maximum seconds per Lean invocation")
   146	    args = parser.parse_args()
   147	    book = Path(__file__).resolve().parents[1]
   148	    packages = (book / ".lake" / "packages").resolve()
   149	    lake = shutil.which("lake")
   150	    if lake is None:
   151	        raise Failure("lake is not on PATH; this harness does not install it")
   152	    snapshot_names = (
   153	        "lakefile.toml", "lake-manifest.json", "lean-toolchain", "RudinRCA.lean", "RudinRCA/AuditA.lean"
   154	    )
   155	    snapshot = {name: (book / name).read_bytes() for name in snapshot_names}
   156	    manifest = json.loads(snapshot["lake-manifest.json"])
   157	    mathlib = next((package for package in manifest["packages"] if package["name"] == "mathlib"), None)
   158	    if mathlib is None or mathlib["rev"] != PIN or snapshot["lean-toolchain"].decode().strip() != TOOLCHAIN:
   159	        raise Failure("book pins differ from the required toolchain/Mathlib revision")
   160	    if not (packages / "mathlib" / ".lake" / "build" / "lib" / "lean" / "Mathlib.olean").is_file():
   161	        raise Failure("pinned Mathlib oleans are absent; prepare the dependency cache before running")
   162	    with tempfile.TemporaryDirectory(prefix="rca-audit-regression-") as temporary:
   163	        parent = Path(temporary)
   164	        for case in CASES:
   165	            root = parent / case.name
   166	            write_fixture(root, snapshot, packages, case)
   167	            run_case(lake, root, case, args.timeout)
   168	    print("PASS: 1 nonvacuous baseline and 4 expected audit rejections; live sources untouched.", flush=True)
   169	    return 0
   170	
   171	
   172	if __name__ == "__main__":
   173	    try:
   174	        sys.exit(main())
   175	    except (Failure, OSError, ValueError) as exc:
   176	        print(f"FAIL: {exc}", file=sys.stderr)
   177	        sys.exit(1)
     1	import RudinRCA
     2	import Lean.Util.CollectAxioms
     3	import Lean.Elab.Command
     4	
     5	/-!
     6	Build-enforced, transitive axiom audit over every module whose
     7	source belongs to this package, in the style of the sibling
     8	targets (Merkle's `Checks.lean`, Bech32's `Audit.lean`).
     9	
    10	This entrypoint imports the umbrella module `RudinRCA`, so the
    11	environment it audits is the library's import graph. Declarations
    12	are selected by their originating project module, together with every
    13	`RudinRCA.*` constant in the environment: private helpers and generated
    14	equations/termination declarations are included. No local axiom
    15	declarations are allowed, and dependencies may use only the
    16	standard three axioms below.
    17	
    18	Module-coverage guard (three-way inventory): the audit compares
    19	three independently derived sets of project modules.
    20	
    21	* DISCOVERED — every `.lean` source file belonging to this
    22	  package, found by walking the package source tree at audit
    23	  time (the library root directory `RudinRCA/` plus the package-root
    24	  modules such as `RudinRCA.lean` itself; `.lake` build output is
    25	  excluded), mapped to module names by path. Ownership is the
    26	  source tree, never a module-name prefix.
    27	* AUDITED — the project modules present in this audit's
    28	  environment (`env.header.moduleNames` restricted to the
    29	  discovered inventory).
    30	* EXPECTED — the explicit `expectedModules` inventory below.
    31	
    32	The build fails whenever a discovered source module is absent
    33	from the audited environment (present in the tree but not
    34	imported into the audited graph), whenever a discovered or
    35	audited project module is absent from the expected inventory, or
    36	whenever an expected module is missing from the environment. So
    37	every module whose source belongs to this package is audited on
    38	any build in which this audit elaborates — including clean
    39	builds, where the default target compiles every library module,
    40	this entrypoint included.
    41	
    42	The inventoried tree is anchored to this audit file itself: the
    43	package root is derived from the source path of the audit module
    44	being elaborated — a relative filename is resolved against the
    45	working directory, and the path is then canonicalized with the
    46	operating system's own path resolution (`IO.FS.realPath`), under
    47	which the filesystem follows symbolic links before applying
    48	`..` — so the inventory describes the tree that physically owns
    49	this file, never another checkout found by searching the working
    50	directory's ancestors or by reinterpreting the supplied path
    51	lexically. If the root cannot be derived or fails validation,
    52	the audit fails loudly rather than passing vacuously.
    53	
    54	Two inventory entries are import-only and declare nothing: the
    55	umbrella `RudinRCA` itself, and this audit entrypoint `RudinRCA.AuditA`
    56	(a module cannot appear in its own import environment, so the
    57	entrypoint is accounted for by name rather than by presence).
    58	
    59	Set `RUDIN_RCA_AUDIT_VERBOSE=1` when elaborating this file to print
    60	every declaration's result.
    61	-/
    62	
    63	open Lean in
    64	run_cmd do
    65	  let env ← getEnv
    66	  let allowed := #[``propext, ``Classical.choice, ``Quot.sound]
    67	  let verbose := (← IO.getEnv "RUDIN_RCA_AUDIT_VERBOSE") == some "1"
    68	  -- Expected inventory of project modules. `RudinRCA` (the umbrella)
    69	  -- and `RudinRCA.AuditA` (this entrypoint) are import-only: they
    70	  -- contribute no declarations of their own.
    71	  let expectedModules : Array Name :=
    72	    #[`RudinRCA, `RudinRCA.Chapter01, `RudinRCA.Chapter02, `RudinRCA.Chapter03,
    73	      `RudinRCA.Chapter04, `RudinRCA.Chapter05, `RudinRCA.AuditA]
    74	  let entrypoint : Name := `RudinRCA.AuditA
    75	  -- Resolve the package root from this audit module's own source
    76	  -- position, anchored to the file actually being elaborated.
    77	  -- The reported source filename — absolute under `lake build`,
    78	  -- but possibly relative under a direct `lean` invocation — is
    79	  -- resolved against the working directory when relative, then
    80	  -- canonicalized with the operating system's own path
    81	  -- resolution (`IO.FS.realPath`, the POSIX `realpath`
    82	  -- function), under which the filesystem follows symbolic
    83	  -- links before applying `..`. The result is therefore the
    84	  -- physical file Lean opened, never a lexical reinterpretation
    85	  -- of the supplied path — a purely lexical normalization
    86	  -- mis-derives the root whenever a path reaches this file
    87	  -- through a symlinked directory followed by `..`. The root
    88	  -- is then the resolved file's grandparent directory
    89	  -- (`<root>/RudinRCA/AuditA.lean`). There is deliberately no search
    90	  -- over ancestors of the working directory or anywhere else:
    91	  -- a directory is the package root only if it owns this very
    92	  -- file, so the inventory below describes the tree the
    93	  -- audited declarations came from, never another checkout.
    94	  -- `realPath` throws when the file cannot be resolved, which
    95	  -- fails this audit rather than letting it pass.
    96	  let isPackageRoot (dir : System.FilePath) : IO Bool := do
    97	    let hasAudit ← (dir / "RudinRCA" / "AuditA.lean").pathExists
    98	    let hasToml ← (dir / "lakefile.toml").pathExists
    99	    let hasLean ← (dir / "lakefile.lean").pathExists
   100	    return hasAudit && (hasToml || hasLean)
   101	  let ownRaw : System.FilePath := (← getFileName)
   102	  let cwd ← IO.currentDir
   103	  let ownPath : System.FilePath ← IO.FS.realPath
   104	    (if ownRaw.isAbsolute then ownRaw else cwd / ownRaw)
   105	  unless ownPath.fileName == some "AuditA.lean" &&
   106	      (ownPath.parent.bind System.FilePath.fileName) == some "RudinRCA" do
   107	    throwError "Axiom audit could not locate the package source tree: this audit module's own source path {ownPath} is not of the form <root>/RudinRCA/AuditA.lean; refusing to pass without a source-tree inventory"
   108	  let root ← match ownPath.parent.bind System.FilePath.parent with
   109	    | some r =>
   110	      if ← isPackageRoot r then
   111	        pure r
   112	      else
   113	        throwError "Axiom audit could not locate the package source tree: the root {r} derived from this audit module's own source path {ownPath} does not contain a lakefile together with RudinRCA/AuditA.lean; refusing to pass without a source-tree inventory"
   114	    | none =>
