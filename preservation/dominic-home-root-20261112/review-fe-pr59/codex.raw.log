 succeeded in 0ms:
"""Read-only Codex account + weekly quota snapshot via `codex app-server` JSON-RPC.
Consumes no quota: sandbox read-only, approvals never, only account/read and
account/rateLimits/read are called. Prints one JSON object to stdout."""

import json
import select
import subprocess
import sys
import time


def main():
    proc = subprocess.Popen(
        ["codex", "-s", "read-only", "-a", "never", "app-server"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
        text=True,
        bufsize=1,
    )

    def send(obj):
        proc.stdin.write(json.dumps(obj) + "\n")
        proc.stdin.flush()

    try:
        send({
            "jsonrpc": "2.0", "id": 1, "method": "initialize",
            "params": {"clientInfo": {"name": "quota-snapshot", "version": "1.0"}},
        })
        send({"jsonrpc": "2.0", "method": "initialized"})
        send({"jsonrpc": "2.0", "id": 2, "method": "account/read",
              "params": {}})
        send({"jsonrpc": "2.0", "id": 3, "method": "account/rateLimits/read"})

        results = {}
        deadline = time.time() + 45
        while time.time() < deadline and not (2 in results and 3 in results):
            ready, _, _ = select.select([proc.stdout], [], [], 2)
            if not ready:
                continue
            line = proc.stdout.readline()
            if not line:
                break
            line = line.strip()
            if not line.startswith("{"):
                continue
            try:
                msg = json.loads(line)
            except Exception:
                continue
            if isinstance(msg, dict) and msg.get("id") in (2, 3):
                results[msg["id"]] = msg
    finally:
        try:
            proc.stdin.close()
        except Exception:
            pass
        proc.terminate()
        try:
            proc.wait(timeout=5)
        except Exception:
            proc.kill()

    out = {"account": None, "rateLimits": None, "errors": {}}
    r2 = results.get(2)
    if r2 is not None:
        if "result" in r2:
            out["account"] = r2["result"]
        else:
            out["errors"]["account/read"] = r2.get("error")
    else:
        out["errors"]["account/read"] = "no response"
    r3 = results.get(3)
    if r3 is not None:
        if "result" in r3:
            out["rateLimits"] = r3["result"]
        else:
            out["errors"]["account/rateLimits/read"] = r3.get("error")
    else:
        out["errors"]["account/rateLimits/read"] = "no response"
    print(json.dumps(out))


if __name__ == "__main__":
    main()
