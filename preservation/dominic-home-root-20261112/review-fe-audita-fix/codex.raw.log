#!/bin/bash
# with-ledger.sh — Fleet Harness Spec section 15.7: run a command, then append
# one completion record to the Ledger (Dropbox /FleetHarness/Ledger/<machine>/).
# Usage: with-ledger.sh <job-slug> <command...>
# LEDGER_DIR overrides the ledger root (testing only). Never fails the job:
# the wrapped command's exit code is preserved; ledger errors are swallowed.
JOB="$1"; shift
START=$(date -u +%Y-%m-%dT%H:%M:%SZ); SSEC=$(date +%s)
"$@"; EC=$?
END=$(date -u +%Y-%m-%dT%H:%M:%SZ)
MACHINE=$(hostname -s)
LEDGER_DIR="${LEDGER_DIR:-$HOME/Dropbox/FleetHarness/Ledger/$MACHINE}"
LOG="${LEDGER_LOG:-}"
mkdir -p "$LEDGER_DIR" 2>/dev/null
jq -cn --arg automation "$JOB" --arg machine "$MACHINE" --arg started "$START" --arg finished "$END" --argjson exit_code "$EC" --arg log "$LOG" \
  '{automation:$automation, machine:$machine, started:$started, finished:$finished, status:(if $exit_code == 0 then "ok" else "failed" end), exit_code:$exit_code, log:$log}' >> "$LEDGER_DIR/$(date -u +%F).jsonl" 2>/dev/null || true
exit $EC

