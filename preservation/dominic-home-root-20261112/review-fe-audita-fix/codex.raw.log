/bin/bash -lc "python3 - <<'PY'
from pathlib import Path
import subprocess, hashlib, json, re, os
r=Path('/root/review-fe-audita-fix'); p=r/'books/rudin-real-and-complex-analysis'; f=Path('/tmp/fe-pr64-evidence.json'); data=json.loads(f.read_text()); b=data['base']; h=data['head']
def git(*a): return subprocess.check_output(['git',*a],cwd=r)
def sha(v): return hashlib.sha256(v).hexdigest()
audit='books/rudin-real-and-complex-analysis/RudinRCA/AuditA.lean'; before=git('show',f'{b}:{audit}'); after=(r/audit).read_bytes()
old=b'      "'`RudinRCA.Chapter04, `RudinRCA.Chapter05, `RudinRCA.AuditA]'"'
new=b'      "'`RudinRCA.Chapter04, `RudinRCA.Chapter05, `RudinRCA.Chapter08,'"\\n      "'`RudinRCA.Chapter13, `RudinRCA.Chapter15, `RudinRCA.AuditA]'"'
assert before.count(old)==1 and before.replace(old,new)==after
assert after==git('show',f'{h}:{audit}')
data['audit']={'base_sha256':sha(before),'head_sha256':sha(after),'base_bytes':len(before),'head_bytes':len(after),'exact_replacement_verified':True,'diff':git('diff',b,h,'--',audit).decode()};print('AuditA exact replacement:', data['audit'])
sources=[]; symlinks=[]
for root,dirs,files in os.walk(p,followlinks=True):
 dirs[:]=[d for d in dirs if d"'!='"'.lake']
 for name in dirs+files:
  path=Path(root)/name
  if path.is_symlink(): symlinks.append(str(path.relative_to(p)))
 for name in files:
  if name.endswith('.lean'):sources.append(Path(root)/name)
retained=[]
for path in sorted(sources):
 rel=str(path.relative_to(r))
 if rel==audit:continue
 a=git('show',f'{b}:{rel}'); z=path.read_bytes(); assert a==z==git('show',f'{h}:{rel}')
 retained.append({'path':rel,'base_sha256':sha(a),'head_sha256':sha(z),'bytes':len(z)})
assert len(retained)==9
data['retained']=retained; print('Retained byte-identical:',len(retained))
# Strip nested block comments, line comments and string contents for source inspection.
def code_only(s):
 out=[]; i=0; depth=0
 while i<len(s):
  if depth:
   if s.startswith('/-',i):depth+=1;i+=2
   elif s.startswith('-/',i):depth-=1;i+=2
   else:out.append('\\n' if s[i]=='\\n' else ' ');i+=1
  elif s.startswith('/-',i):depth=1;out.append(' ');i+=2
  elif s.startswith('--',i):
   j=s.find('\\n',i);i=len(s) if j<0 else j
  elif s[i]=='\"':
   out.append(' ');i+=1
   while i<len(s):
    if s[i]=='\\\\':i+=2
    elif s[i]=='\"':i+=1;break
    else:out.append('\\n' if s[i]=='\\n' else ' ');i+=1
  else:out.append(s[i]);i+=1
 assert depth==0
 return ''.join(out)
modules={'.'.join(path.relative_to(p).with_suffix('').parts):path for path in sources}
imports={m:re.findall(r'"'^'"\\s*(?:public\\s+)?import\\s+(["'^'"\\n]+)',code_only(path.read_text()),re.M) for m,path in modules.items()}
imports={m:[x for line in lines for x in line.split()] for m,lines in imports.items()}
entry='RudinRCA.AuditA'; reached=set(); pending=list(imports[entry]); external=set()
while pending:
 m=pending.pop()
 if m not in modules: external.add(m);continue
 if m in reached:continue
 reached.add(m);pending+=imports[m]
expected_list=re.findall(r'"'`(RudinRCA(?:'"\\.\\w+)*)',re.search(r'let expectedModules : Array Name :=(.*?)let entrypoint',after.decode(),re.S).group(1));expected=set(expected_list)
assert len(expected_list)==len(expected)==10
