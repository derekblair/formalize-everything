+    simpa only [ρ, Measure.restrict_restrict hE, inter_eq_left.mpr hES] using hr
+  have hcompat : ∀ n m, ∀ᵐ x ∂μ, x ∈ S n → x ∈ S m → gn n x = gn m x := by
+    intro n m
+    let H := S n ∩ S m
