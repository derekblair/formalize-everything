+/-- Equality on finite-measure indicators determines a bounded Lp functional
+for arbitrary positive measures when p is finite. -/
+theorem lpFunctional_eq_of_finite_indicator (hp : p ≠ ∞)
+    (Φ : Lp ℂ p μ →L[ℂ] ℂ) (G : Lp ℂ q μ)
