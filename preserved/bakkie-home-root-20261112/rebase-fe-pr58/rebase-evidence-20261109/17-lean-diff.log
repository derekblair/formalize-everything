+theorem norm_dualityPhase_of_ne_zero {z : ℂ} (hz : z ≠ 0) : ‖dualityPhase z‖ = 1 := by
+  simp [dualityPhase, norm_div, norm_ne_zero_iff.mpr hz]
+
+variable (μ : Measure X) [IsFiniteMeasure μ] (p q : ℝ≥0∞)
