+    have hnH : Integrable (gn n : X → ℂ) (μ.restrict H) :=
+      (hgnint n).mono_set inter_subset_left
+    have hmH : Integrable (gn m : X → ℂ) (μ.restrict H) :=
+      (hgnint m).mono_set inter_subset_right
