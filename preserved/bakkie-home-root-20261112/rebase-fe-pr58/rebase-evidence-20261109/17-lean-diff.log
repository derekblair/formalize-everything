+      rw [h₁, h₂]
+      by_cases hx : x ∈ E
+      · simpa [hx] using hfbound x
+      · simp [f, hx]
+    simpa [norm_indicatorConstLp one_ne_zero ENNReal.one_ne_top] using hle
