+/-! ## Entire logarithms and removable quotients for 15.10 -/
+section
+open Set
+open scoped Classical
+
+/-- A continuous logarithm of a holomorphic function is holomorphic. The
+nonzero derivative of the exponential supplies the derivative of the branch. -/
+theorem differentiableOn_of_continuous_log {U : Set ℂ} {f g : ℂ → ℂ}
+    (hU : IsOpen U) (hf : DifferentiableOn ℂ f U) (hg : ContinuousOn g U)
+    (heq : EqOn (Complex.exp ∘ g) f U) : DifferentiableOn ℂ g U := by
+  intro z hz
+  apply DifferentiableAt.differentiableWithinAt
+  have hgc : ContinuousAt g z := hg.continuousAt (hU.mem_nhds hz)
+  have hfd : HasDerivAt f (deriv f z) z :=
+    (hf.differentiableAt (hU.mem_nhds hz)).hasDerivAt
+  have hevent : Complex.exp ∘ g =ᶠ[𝓝 z] f := by
+    filter_upwards [hU.mem_nhds hz] with w hw
+    exact heq hw
+  exact (HasDerivAt.of_comp_left hgc (Complex.hasDerivAt_exp (g z)) hfd
+    (Complex.exp_ne_zero (g z)) hevent).differentiableAt
+
+/-- A zero-free holomorphic function on an open simply connected domain has a
+holomorphic logarithm. Its existence is derived from the covering-space lift. -/
+theorem exists_holomorphic_log {U : Set ℂ} {f : ℂ → ℂ}
+    (hU : IsOpen U) (hsc : IsSimplyConnected U)
+    (hf : DifferentiableOn ℂ f U) (hzero : ∀ z ∈ U, f z ≠ 0) :
+    ∃ g : ℂ → ℂ, DifferentiableOn ℂ g U ∧ ∀ z ∈ U, Complex.exp (g z) = f z := by
+  have hzero' : 0 ∉ f '' U := by
+    rintro ⟨z, hz, heq⟩
+    exact hzero z hz heq
+  obtain ⟨g, hgc, hgexp⟩ :=
+    Complex.exists_continuousOn_eqOn_exp_comp hsc hU hf.continuousOn hzero'
+  exact ⟨g, differentiableOn_of_continuous_log hU hf hgc hgexp, hgexp⟩
+
+/-- The exponential-factor prerequisite of Theorem 15.10: every zero-free entire
+function is the exponential of an entire function. This does not assert the
+canonical-product factorization or enumerate its zeros. -/
+theorem exists_entire_log {f : ℂ → ℂ}
+    (hf : Differentiable ℂ f) (hzero : ∀ z, f z ≠ 0) :
+    ∃ g : ℂ → ℂ, Differentiable ℂ g ∧ ∀ z, Complex.exp (g z) = f z := by
+  have hsc : IsSimplyConnected (univ : Set ℂ) := by
+    let : ContractibleSpace (univ : Set ℂ) :=
+      (convex_univ : Convex ℝ (univ : Set ℂ)).contractibleSpace univ_nonempty
+    exact inferInstanceAs (SimplyConnectedSpace (univ : Set ℂ))
+  obtain ⟨g, hg, heq⟩ := exists_holomorphic_log isOpen_univ hsc hf.differentiableOn
+    (fun z _ ↦ hzero z)
+  exact ⟨g, differentiableOn_univ.1 hg, fun z ↦ heq z (mem_univ z)⟩
+
+/-- A natural-valued count with an actual finite sum has finite support. Using
+`HasSum` rather than an equality involving `tsum` excludes its default-value case. -/
+theorem finite_fiber_of_hasSum_count {ι X : Type*} (a : ι → X) (z : X) (m : ℕ)
+    (h : HasSum (fun n ↦ if a n = z then (1 : ℕ) else 0) m) :
+    (a ⁻¹' {z}).Finite := by
+  classical
+  have hi := h.map (Nat.castAddMonoidHom ℤ) continuous_of_discreteTopology
+  have hs := hi.summable.hasFiniteSupport_of_discreteTopology _
+  change Set.Finite {x | a x = z}
+  simpa [Function.HasFiniteSupport, Function.support, Function.comp_def] using hs
+
+/-- A sequence of zeros of a nonzero entire function, with each zero repeated
+only finitely often, leaves every bounded set. Completeness of the enumeration
+is not needed for this implication. -/
+theorem zero_sequence_norm_tendsto_atTop {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : Differentiable ℂ f) (h0 : f 0 ≠ 0)
+    (ha : ∀ n, f (a n) = 0) (hfiber : ∀ z, (a ⁻¹' {z}).Finite) :
+    Tendsto (fun n ↦ ‖a n‖) atTop atTop := by
+  have hfa : AnalyticOnNhd ℂ f univ := fun z _ ↦ hf.analyticAt z
+  have hcod := hfa.preimage_zero_mem_codiscrete h0
+  have hzd : IsClosed (f ⁻¹' {0}) ∧ IsDiscrete (f ⁻¹' {0}) :=
+    compl_mem_codiscrete_iff.mp hcod
+  have hproper : Tendsto a cofinite (cocompact ℂ) := by
+    apply tendsto_cofinite_cocompact_iff.mpr
+    intro K hK
+    have hfin : (K ∩ f ⁻¹' {0}).Finite :=
+      (hK.inter_right hzd.1).finite (hzd.2.mono inter_subset_right)
+    have hpre : (a ⁻¹' (K ∩ f ⁻¹' {0})).Finite :=
+      hfin.preimage' (fun z _ ↦ hfiber z)
+    exact hpre.subset (fun n hn ↦ ⟨hn, ha n⟩)
+  simpa only [Nat.cofinite_eq_atTop, Function.comp_def] using
+    tendsto_norm_cocompact_atTop.comp hproper
+
+/-- The printed zero enumeration in 15.10 forces its nonzero entries to tend to
+infinity; this is a conclusion, not an extra canonical-product hypothesis. -/
+theorem zero_enumeration_norm_tendsto_atTop {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : Differentiable ℂ f) (h0 : f 0 ≠ 0) (ha : ∀ n, f (a n) = 0)
+    (hcount : ∀ z, HasSum (fun n ↦ if a n = z then (1 : ℕ) else 0)
+      (analyticOrderNatAt f z)) :
+    (∀ n, a n ≠ 0) ∧ Tendsto (fun n ↦ ‖a n‖) atTop atTop := by
+  refine ⟨fun n hn ↦ h0 (hn ▸ ha n), zero_sequence_norm_tendsto_atTop hf h0 ha ?_⟩
+  intro z
+  exact finite_fiber_of_hasSum_count a z (analyticOrderNatAt f z) (hcount z)
+
+/-- The removable quotient prerequisite for 15.10. Equal finite vanishing orders
+give an entire nonvanishing quotient. This is conditional on a supplied entire
+product and does not itself construct that canonical product. -/
+theorem exists_entire_nonvanishing_quotient_of_order_eq {f P : ℂ → ℂ}
+    (hf : Differentiable ℂ f) (hP : Differentiable ℂ P)
+    (hfinite : ∀ z, analyticOrderAt P z ≠ ⊤)
+    (horder : ∀ z, analyticOrderAt f z = analyticOrderAt P z) :
+    ∃ q : ℂ → ℂ, Differentiable ℂ q ∧ (∀ z, q z ≠ 0) ∧ ∀ z, f z = q z * P z := by
+  let q : ℂ → ℂ := toMeromorphicNFOn (f / P) univ
+  have hm : MeromorphicOn (f / P) univ :=
+    fun z _ ↦ (hf.analyticAt z).meromorphicAt.div (hP.analyticAt z).meromorphicAt
+  have hnf : ∀ z, MeromorphicNFAt q z :=
+    fun z ↦ meromorphicNFOn_toMeromorphicNFOn (f / P) univ (mem_univ z)
+  have hqord : ∀ z, meromorphicOrderAt q z = 0 := by
+    intro z
+    dsimp only [q]
+    rw [meromorphicOrderAt_toMeromorphicNFOn hm (mem_univ z),
+      meromorphicOrderAt_div (hf.analyticAt z).meromorphicAt (hP.analyticAt z).meromorphicAt,
+      (hf.analyticAt z).meromorphicOrderAt_eq, (hP.analyticAt z).meromorphicOrderAt_eq,
+      horder z]
+    obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp (hfinite z)
+    rw [← hm]
+    simp
+  have hqa : ∀ z, AnalyticAt ℂ q z := fun z ↦
+    (hnf z).meromorphicOrderAt_nonneg_iff_analyticAt.mp (le_of_eq (hqord z).symm)
+  have hqd : Differentiable ℂ q := fun z ↦ (hqa z).differentiableAt
+  refine ⟨q, hqd, fun z ↦ (hnf z).meromorphicOrderAt_eq_zero_iff.mp (hqord z), ?_⟩
+  intro z
+  have hne : ∀ᶠ w in 𝓝[≠] z, P w ≠ 0 :=
+    (hP.analyticAt z).eventually_eq_zero_or_eventually_ne_zero.resolve_left
+      (fun h ↦ hfinite z (analyticOrderAt_eq_top.mpr h))
+  have heq : (fun w ↦ q w * P w) =ᶠ[𝓝[≠] z] f := by
+    filter_upwards [hm.toMeromorphicNFOn_eq_self_on_nhdsNE (mem_univ z), hne] with w hw hPw
+    change q w = f w / P w at hw
+    rw [hw, div_mul_cancel₀ _ hPw]
+  have hmul : ContinuousAt (fun w ↦ q w * P w) z :=
+    hqd.continuous.continuousAt.mul hP.continuous.continuousAt
+  have heqnhds : (fun w ↦ q w * P w) =ᶠ[𝓝 z] f :=
+    (ContinuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE hmul
+      hf.continuous.continuousAt).mp heq
+  exact heqnhds.eq_of_nhds.symm
+
+/-- Once the canonical product has the actual orders of `f`, the missing factor
+is the exponential of an entire function. Product existence remains a separate
+obligation of the full 15.10 theorem. -/
+theorem exists_entire_exponential_factor_of_order_eq {f P : ℂ → ℂ}
+    (hf : Differentiable ℂ f) (hP : Differentiable ℂ P)
+    (hfinite : ∀ z, analyticOrderAt P z ≠ ⊤)
+    (horder : ∀ z, analyticOrderAt f z = analyticOrderAt P z) :
+    ∃ g : ℂ → ℂ, Differentiable ℂ g ∧ ∀ z, f z = Complex.exp (g z) * P z := by
+  obtain ⟨q, hqd, hqne, heq⟩ :=
+    exists_entire_nonvanishing_quotient_of_order_eq hf hP hfinite horder
+  obtain ⟨g, hgd, hg⟩ := exists_entire_log hqd hqne
+  exact ⟨g, hgd, fun z ↦ by rw [hg z]; exact heq z⟩
+
+/-- A nonzero entire function has finite order at every point. -/
+theorem analyticOrderAt_ne_top_of_entire_nonzero {f : ℂ → ℂ}
+    (hf : Differentiable ℂ f) (h0 : f 0 ≠ 0) (z : ℂ) :
+    analyticOrderAt f z ≠ ⊤ := by
+  intro htop
+  have hfun : f = 0 :=
+    (AnalyticOnNhd.analyticOrderAt_eq_top_iff_eq_zero z hf.analyticAt).mp htop
+  exact h0 (congrFun hfun 0)
+
+/-- A natural-order interface for the exponential factor, suitable for the
+finite multiplicity sum supplied by 15.9. -/
+theorem exists_entire_exponential_factor_of_nat_order_eq {f P : ℂ → ℂ}
+    (hf : Differentiable ℂ f) (hP : Differentiable ℂ P)
+    (hf0 : f 0 ≠ 0) (hP0 : P 0 ≠ 0)
+    (horder : ∀ z, analyticOrderNatAt f z = analyticOrderNatAt P z) :
+    ∃ g : ℂ → ℂ, Differentiable ℂ g ∧ ∀ z, f z = Complex.exp (g z) * P z := by
+  have hfinf := analyticOrderAt_ne_top_of_entire_nonzero hf hf0
+  have hfinP := analyticOrderAt_ne_top_of_entire_nonzero hP hP0
+  apply exists_entire_exponential_factor_of_order_eq hf hP hfinP
+  intro z
+  rw [← Nat.cast_analyticOrderNatAt (hfinf z), ← Nat.cast_analyticOrderNatAt (hfinP z),
+    horder z]
+
+#print axioms differentiableOn_of_continuous_log
+#print axioms exists_holomorphic_log
+#print axioms exists_entire_log
+#print axioms finite_fiber_of_hasSum_count
+#print axioms zero_sequence_norm_tendsto_atTop
+#print axioms zero_enumeration_norm_tendsto_atTop
+#print axioms exists_entire_nonvanishing_quotient_of_order_eq
+#print axioms exists_entire_exponential_factor_of_order_eq
+#print axioms analyticOrderAt_ne_top_of_entire_nonzero
+#print axioms exists_entire_exponential_factor_of_nat_order_eq
+
+
+end
+
+
+
+/-- The admissibility assertion in 15.9: with zero-based indexing, `p n = n`
+always works for a sequence of nonzero points escaping to infinity. -/
+theorem summable_primary_majorant_nat {a : ℕ → ℂ}
+    (ha : ∀ n, a n ≠ 0) (hinfty : Tendsto (fun n ↦ ‖a n‖) atTop atTop)
+    {r : ℝ} (hr : 0 < r) :
+    Summable (fun n ↦ (r / ‖a n‖) ^ (n + 1)) := by
+  have hgeo : Summable (fun n : ℕ ↦ (1 / 2 : ℝ) ^ (n + 1)) :=
+    (summable_geometric_of_norm_lt_one (by norm_num : ‖(1 / 2 : ℝ)‖ < 1)).comp_injective
+      (fun n m h ↦ Nat.add_right_cancel h)
+  apply hgeo.of_norm_bounded_eventually_nat
+  filter_upwards [hinfty.eventually (eventually_ge_atTop (2 * r))] with n hn
+  have hapos : 0 < ‖a n‖ := norm_pos_iff.mpr (ha n)
+  have hnonneg : 0 ≤ r / ‖a n‖ := div_nonneg hr.le hapos.le
+  rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hnonneg _)]
+  apply pow_le_pow_left₀ hnonneg
+  apply (div_le_iff₀ hapos).2
+  linarith
+
+/-- Local uniform summability of the primary-factor errors in 15.9. -/
+theorem primary_errors_locally_uniform {a : ℕ → ℂ} {p : ℕ → ℕ}
+    (ha : ∀ n, a n ≠ 0) (hinfty : Tendsto (fun n ↦ ‖a n‖) atTop atTop)
+    (hsum : ∀ r : ℝ, 0 < r → Summable (fun n ↦ (r / ‖a n‖) ^ (p n + 1))) :
+    TendstoLocallyUniformlyOn
+      (fun N z ↦ ∑ n ∈ range N, ‖1 - elementaryFactor (p n) (z / a n)‖)
+      (fun z ↦ ∑' n, ‖1 - elementaryFactor (p n) (z / a n)‖) atTop Set.univ := by
+  apply (tendstoLocallyUniformlyOn_iff_forall_isCompact isOpen_univ).2
+  intro K _ hK
+  obtain ⟨R, hR⟩ := hK.exists_bound_of_continuousOn (f := fun z : ℂ ↦ z) continuousOn_id
+  let r : ℝ := max R 1
+  have hr : 0 < r := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
+  apply tendstoUniformlyOn_tsum_nat_eventually (hsum r hr)
+  filter_upwards [hinfty.eventually (eventually_ge_atTop r)] with n hn z hz
+  have hapos : 0 < ‖a n‖ := norm_pos_iff.mpr (ha n)
+  have hzr : ‖z‖ ≤ r := (hR z hz).trans (le_max_left _ _)
+  have hz1 : ‖z / a n‖ ≤ 1 := by
+    rw [norm_div, div_le_one hapos]
+    exact hzr.trans hn
+  rw [Real.norm_of_nonneg (norm_nonneg _)]
+  exact (norm_one_sub_elementaryFactor_le (p n) (z / a n) hz1).trans
+    (pow_le_pow_left₀ (norm_nonneg (z / a n))
+      (by rw [norm_div]; exact div_le_div_of_nonneg_right hzr hapos.le) (p n + 1))
+
+/-- The entire product and multiplicities in 15.9, with repetitions of the
+sequence counted by the natural sum of their indicator functions. -/
+theorem entire_primary_product {a : ℕ → ℂ} {p : ℕ → ℕ}
+    (ha : ∀ n, a n ≠ 0) (hinfty : Tendsto (fun n ↦ ‖a n‖) atTop atTop)
+    (hsum : ∀ r : ℝ, 0 < r → Summable (fun n ↦ (r / ‖a n‖) ^ (p n + 1))) :
+    let f := fun z ↦ ∏' n, elementaryFactor (p n) (z / a n)
+    TendstoLocallyUniformlyOn
+      (fun N z ↦ ∏ n ∈ range N, elementaryFactor (p n) (z / a n)) f atTop Set.univ ∧
+    Differentiable ℂ f ∧
+    ∀ z, (f z = 0 ↔ ∃ n, z = a n) ∧
+      analyticOrderAt f z ≠ ⊤ ∧
+      analyticOrderNatAt f z = ∑' n, if z = a n then (1 : ℕ) else 0 := by
+  let F : ℕ → ℂ → ℂ := fun n z ↦ elementaryFactor (p n) (z / a n)
+  have hF : ∀ n, DifferentiableOn ℂ (F n) Set.univ := by
+    intro n
+    exact ((differentiable_elementaryFactor (p n)).comp
+      (differentiable_id.div_const (a n))).differentiableOn
+  have hnonzero : ∀ n z, z ∈ (Set.univ : Set ℂ) →
+      ∃ w ∈ connectedComponentIn Set.univ z, F n w ≠ 0 := by
+    intro n z _
+    refine ⟨0, by simp [connectedComponentIn_univ, PreconnectedSpace.connectedComponent_eq_univ], ?_⟩
+    simp [F, elementaryFactor, elementaryExponent]
+  have herr := primary_errors_locally_uniform ha hinfty hsum
+  obtain ⟨hlim, hhol, horder⟩ := holomorphic_product_multiplicity
+    isOpen_univ hF hnonzero ⟨_, herr⟩
+  refine ⟨hlim, differentiableOn_univ.mp hhol, ?_⟩
+  intro z
+  obtain ⟨_, hfinite, hm, _⟩ := horder z (Set.mem_univ z)
+  have hsz : Summable (fun n ↦ ‖1 - F n z‖) :=
+    ((hasSum_iff_tendsto_nat_of_nonneg (fun n ↦ norm_nonneg _) _).2
+      (herr.tendsto_at (Set.mem_univ z))).summable
+  have hzero : (∏' n, F n z) = 0 ↔ ∃ n, z = a n := by
+    constructor
+    · intro hz
+      by_contra h
+      push_neg at h
+      have hnone : ∀ n, F n z ≠ 0 := by
+        intro n
+        simpa [F, elementaryFactor_eq_zero_iff, div_eq_one_iff_eq (ha n)] using h n
+      have hone : ∀ n, 1 + (F n z - 1) = F n z := by intro n; ring
+      have hnorm : Summable (fun n ↦ ‖F n z - 1‖) := by simpa only [norm_sub_rev] using hsz
+      have hn := tprod_one_add_ne_zero_of_summable
+        (fun n ↦ by simpa only [hone] using hnone n) hnorm
+      exact hn (by simpa only [hone] using hz)
+    · rintro ⟨n, hz⟩
+      exact tprod_of_exists_eq_zero ⟨n, by simp [F, hz, ha n]⟩
+  refine ⟨hzero, hfinite, ?_⟩
+  rw [hm]
+  apply tsum_congr
+  intro n
+  simp only [F, analyticOrderNatAt, analyticOrderAt_scaled_elementaryFactor (p n) (ha n)]
+  split_ifs <;> simp
+
+/-- Finite and empty products obey the same entire-function and zero-count
+conventions used in 15.9–15.10. -/
+theorem finite_primary_product {ι : Type*} (s : Finset ι) (a : ι → ℂ) (p : ι → ℕ)
+    (ha : ∀ n ∈ s, a n ≠ 0) :
+    let f := fun z ↦ ∏ n ∈ s, elementaryFactor (p n) (z / a n)
+    Differentiable ℂ f ∧ f 0 = 1 ∧
+      ∀ z, (f z = 0 ↔ ∃ n ∈ s, z = a n) ∧
+        analyticOrderAt f z = ∑ n ∈ s, if z = a n then (1 : ℕ∞) else 0 := by
+  classical
+  have hd (n : ι) : Differentiable ℂ (fun z ↦ elementaryFactor (p n) (z / a n)) :=
+    (differentiable_elementaryFactor (p n)).comp (differentiable_id.div_const (a n))
+  refine ⟨Differentiable.fun_finsetProd (fun n _ ↦ hd n), ?_, ?_⟩
+  · simp [elementaryFactor, elementaryExponent]
+  · intro z
+    constructor
+    · rw [Finset.prod_eq_zero_iff]
+      constructor
+      · rintro ⟨n, hn, hz⟩
+        exact ⟨n, hn, (div_eq_one_iff_eq (ha n hn)).1
+          ((elementaryFactor_eq_zero_iff (p n) (z / a n)).1 hz)⟩
+      · rintro ⟨n, hn, hz⟩
+        refine ⟨n, hn, (elementaryFactor_eq_zero_iff (p n) (z / a n)).2 ?_⟩
+        exact (div_eq_one_iff_eq (ha n hn)).2 hz
+    · rw [analyticOrderAt_finset_product s (fun n _ ↦ (hd n).analyticAt z)]
+      apply Finset.sum_congr rfl
+      intro n hn
+      exact analyticOrderAt_scaled_elementaryFactor (p n) (ha n hn) z
+
+#print axioms finite_primary_product
+#print axioms summable_primary_majorant_nat
+#print axioms primary_errors_locally_uniform
+#print axioms entire_primary_product
+
+/-- The convention following 15.10: remove the finite-order zero at the origin
+before applying the nonvanishing-at-zero factorization statement. -/
+theorem entire_remove_zero_at_origin {f : ℂ → ℂ}
+    (hf : Differentiable ℂ f) (hne : f ≠ 0) :
+    ∃ h : ℂ → ℂ, Differentiable ℂ h ∧ h 0 ≠ 0 ∧
+      ∀ z, f z = z ^ analyticOrderNatAt f 0 * h z := by
+  have hfinite : analyticOrderAt f 0 ≠ ⊤ := by
+    intro htop
+    exact hne ((AnalyticOnNhd.analyticOrderAt_eq_top_iff_eq_zero 0 hf.analyticAt).mp htop)
+  obtain ⟨g, hga, hg0, heq⟩ := (hf.analyticAt 0).analyticOrderAt_ne_top.mp hfinite
+  let k := analyticOrderNatAt f 0
+  let h : ℂ → ℂ := fun z ↦ if z = 0 then g 0 else f z / z ^ k
+  have heq' : f =ᶠ[𝓝 0] fun z ↦ z ^ k * g z := by
+    simpa only [sub_zero, smul_eq_mul] using heq
+  have hnear : h =ᶠ[𝓝 0] g := by
+    filter_upwards [heq'] with z hz
+    by_cases hz0 : z = 0
+    · simp [h, hz0]
+    · simp [h, hz0, hz, mul_div_cancel_left₀, pow_ne_zero _ hz0]
+  have hh : Differentiable ℂ h := by
+    intro z
+    by_cases hz0 : z = 0
+    · subst z
+      exact (hga.congr hnear.symm).differentiableAt
+    · apply AnalyticAt.differentiableAt
+      apply ((hf.analyticAt z).div (analyticAt_id.pow k) (pow_ne_zero _ hz0)).congr
+      filter_upwards [isOpen_ne.mem_nhds hz0] with w hw
+      simp [h, hw]
+  refine ⟨h, hh, by simpa [h] using hg0, ?_⟩
+  intro z
+  by_cases hz0 : z = 0
+  · subst z
+    simpa only [h, if_pos rfl] using heq'.eq_of_nhds
+  · dsimp only [h]
+    rw [if_neg hz0]
+    exact (mul_div_cancel₀ (f z) (pow_ne_zero k hz0)).symm
+
+/-- Theorem 15.10 for an infinite sequence listing all zeros with multiplicity.
+`HasSum` records actual finite multiplicities, and escape to infinity is derived.
+With zero-based indexing the admissible choice is `p n = n`. -/
+theorem entire_function_factorization_infinite {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : Differentiable ℂ f) (h0 : f 0 ≠ 0)
+    (ha : ∀ n, f (a n) = 0)
+    (hcount : ∀ z, HasSum (fun n ↦ if a n = z then (1 : ℕ) else 0)
+      (analyticOrderNatAt f z)) :
+    ∃ p : ℕ → ℕ, ∃ g : ℂ → ℂ,
+      p = (fun n ↦ n) ∧ Differentiable ℂ g ∧
+      TendstoLocallyUniformlyOn
+        (fun N z ↦ ∏ n ∈ range N, elementaryFactor (p n) (z / a n))
+        (fun z ↦ ∏' n, elementaryFactor (p n) (z / a n)) atTop Set.univ ∧
+      ∀ z, f z = Complex.exp (g z) * ∏' n, elementaryFactor (p n) (z / a n) := by
+  obtain ⟨ha0, hinfty⟩ := zero_enumeration_norm_tendsto_atTop hf h0 ha hcount
+  obtain ⟨hlim, hP, hprop⟩ := entire_primary_product (p := fun n ↦ n) ha0 hinfty
+    (fun r hr ↦ summable_primary_majorant_nat ha0 hinfty hr)
+  have hP0 : (∏' n, elementaryFactor n (0 / a n)) ≠ 0 := by
+    intro hz
+    obtain ⟨n, hn⟩ := (hprop 0).1.mp hz
+    exact ha0 n hn.symm
+  have hm : ∀ z, analyticOrderNatAt f z =
+      analyticOrderNatAt (fun w ↦ ∏' n, elementaryFactor n (w / a n)) z := by
+    intro z
+    rw [(hprop z).2.2]
+    simpa only [eq_comm] using (hcount z).tsum_eq.symm
+  obtain ⟨g, hg, heq⟩ :=
+    exists_entire_exponential_factor_of_nat_order_eq hf hP h0 hP0 hm
+  exact ⟨(fun n ↦ n), g, rfl, hg, hlim, heq⟩
+
+/-- The finite and empty zero-list cases of 15.10. The primary factors may all
+have genus zero, and an empty list gives the entire logarithm theorem. The finite
+sum hypothesis counts every zero exactly with its multiplicity. -/
+theorem entire_function_factorization_finite {ι : Type*} {f : ℂ → ℂ}
+    (s : Finset ι) (a : ι → ℂ) (hf : Differentiable ℂ f) (h0 : f 0 ≠ 0)
+    (ha : ∀ n ∈ s, f (a n) = 0)
+    (hcount : ∀ z, (∑ n ∈ s, if a n = z then (1 : ℕ) else 0) =
+      analyticOrderNatAt f z) :
+    ∃ g : ℂ → ℂ, Differentiable ℂ g ∧
+      ∀ z, f z = Complex.exp (g z) * ∏ n ∈ s, elementaryFactor 0 (z / a n) := by
+  classical
+  have ha0 : ∀ n ∈ s, a n ≠ 0 := by
+    intro n hn hzero
+    exact h0 (hzero ▸ ha n hn)
+  obtain ⟨hP, hP0, hprop⟩ := finite_primary_product s a (fun _ ↦ 0) ha0
+  have hPne : (∏ n ∈ s, elementaryFactor 0 (0 / a n)) ≠ 0 := by
+    exact hP0.trans_ne one_ne_zero
+  have hfinite := analyticOrderAt_ne_top_of_entire_nonzero hP hPne
+  have hfinitef := analyticOrderAt_ne_top_of_entire_nonzero hf h0
+  apply exists_entire_exponential_factor_of_order_eq hf hP hfinite
+  intro z
+  rw [(hprop z).2, ← Nat.cast_analyticOrderNatAt (hfinitef z), ← hcount z,
+    Nat.cast_sum]
+  apply Finset.sum_congr rfl
+  intro n hn
+  by_cases hz : a n = z
+  · simp [hz]
+  · simp [hz, Ne.symm hz]
+
+#print axioms entire_function_factorization_infinite
+#print axioms entire_function_factorization_finite
+#print axioms entire_remove_zero_at_origin
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/Scratch61.lean b/books/rudin-real-and-complex-analysis/Scratch61.lean
new file mode 100644
index 0000000..34027ef
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/Scratch61.lean
@@ -0,0 +1,53 @@
+import Mathlib.MeasureTheory.Measure.Complex
+import Mathlib.MeasureTheory.VectorMeasure.Variation.Basic
+
+noncomputable section
+open MeasureTheory Set
+open scoped ENNReal Function
+namespace RudinRCA.Chapter06
+universe u
+variable {X : Type u} [MeasurableSpace X]
+
+/-- A countable measurable partition; finite and empty index types are allowed. -/
+structure CountablePartition (E : Set X) where
+  Index : Type u
+  countable : Countable Index
+  part : Index → Set X
+  measurable : ∀ i, MeasurableSet (part i)
+  disjoint : Pairwise (Disjoint on part)
+  covers : (⋃ i, part i) = E
+
+attribute [instance] CountablePartition.countable
+
+/-- Rudin's definition of total variation as the supremum over countable partitions. -/
+theorem variation_eq_iSup_countablePartitions (μ : ComplexMeasure X) {E : Set X}
+    (hE : MeasurableSet E) :
+    μ.variation E = ⨆ P : CountablePartition E, ∑' i, ‖μ (P.part i)‖ₑ := by
+  classical
+  apply le_antisymm
+  · change preVariation (‖μ ·‖ₑ) _ _ E ≤ _
+    rw [preVariation_apply, VectorMeasure.ennrealToMeasure_apply hE,
+      ennrealPreVariation_apply, preVariationFun_apply _ hE]
+    apply iSup_le
+    intro P
+    let Q : CountablePartition E := {
+      Index := P.parts
+      countable := inferInstance
+      part := fun i => i.val.val
+      measurable := fun i => i.val.property
+      disjoint := by
+        intro i j hij
+        exact (P.pairwiseDisjoint_apply (fun _ _ => rfl) rfl)
+          i.property j.property (fun h => hij (Subtype.ext h))
+      covers := by
+        simpa only [Finset.sup_set_eq_biUnion, Set.iUnion_coe_set, Finset.mem_coe]
+          using P.sup_parts_apply (fun _ _ => rfl) rfl }
+    have h := le_iSup (fun Q : CountablePartition E => ∑' i, ‖μ (Q.part i)‖ₑ) Q
+    simpa only [Q, tsum_fintype, Finset.sum_coe_sort] using h
+  · apply iSup_le
+    intro P
+    calc
+      (∑' i, ‖μ (P.part i)‖ₑ) ≤ ∑' i, μ.variation (P.part i) :=
+        ENNReal.tsum_le_tsum fun i => μ.enorm_measure_le_variation _
+      _ = μ.variation E := by rw [← measure_iUnion P.disjoint P.measurable, P.covers]
+end RudinRCA.Chapter06
diff --git a/books/rudin-real-and-complex-analysis/Scratch610Discussion.lean b/books/rudin-real-and-complex-analysis/Scratch610Discussion.lean
new file mode 100644
index 0000000..c645655
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/Scratch610Discussion.lean
@@ -0,0 +1,216 @@
+import Mathlib.MeasureTheory.Measure.Decomposition.RadonNikodym
+import Mathlib.MeasureTheory.Measure.Count
+import Mathlib.MeasureTheory.Constructions.UnitInterval
+import Mathlib.MeasureTheory.Measure.NullMeasurable
+import Mathlib.MeasureTheory.Integral.Bochner.Basic
+import Mathlib.Analysis.Complex.Basic
+
+noncomputable section
+open MeasureTheory Set Filter
+open scoped ENNReal unitInterval
+
+namespace RCA610Discussion
+
+variable {X : Type*} [MeasurableSpace X]
+
+/-- Every measure is absolutely continuous with respect to counting measure. -/
+theorem absolutelyContinuous_count (μ : Measure X) : μ ≪ Measure.count := by
+  intro E hE
+  rw [Measure.count_eq_zero_iff.mp hE]
+  exact measure_empty
+
+/-- Counting measure has no absolutely-continuous/singular decomposition relative
+to a nonzero measure that vanishes on singletons. -/
+theorem count_no_decomposition [MeasurableSingletonClass X]
+    (μ : Measure X) [NullSingletonClass μ] (hμ : μ ≠ 0) :
+    ¬ ∃ a s : Measure X, Measure.count = a + s ∧ a ≪ μ ∧ s ⟂ₘ μ := by
+  rintro ⟨a, s, hsum, hac, N, hN, hsN, hμNc⟩
+  have hNempty : N = ∅ := by
+    apply Set.eq_empty_iff_forall_notMem.mpr
+    intro x hx
+    have ha : a {x} = 0 := hac (measure_singleton x)
+    have hs : s {x} = 0 := measure_mono_null (singleton_subset_iff.mpr hx) hsN
+    have h := congrArg (fun ν : Measure X ↦ ν {x}) hsum
+    simpa only [Measure.count_singleton, Measure.add_apply, ha, hs, zero_add,
+      one_ne_zero] using h
+  apply hμ
+  apply Measure.measure_univ_eq_zero.mp
+  simpa only [hNempty, compl_empty] using hμNc
+
+/-- A nonzero measure vanishing on singletons cannot have a density with respect
+to counting measure: every singleton would force the density to vanish there. -/
+theorem count_no_density [MeasurableSingletonClass X]
+    (μ : Measure X) [NullSingletonClass μ] (hμ : μ ≠ 0) :
+    ¬ ∃ f : X → ℝ≥0∞, Measure.count.withDensity f = μ := by
+  rintro ⟨f, hf⟩
+  have hfzero : f = 0 := by
+    funext x
+    have h := congrArg (fun ν : Measure X ↦ ν {x}) hf
+    simpa only [withDensity_apply _ (measurableSet_singleton x), lintegral_singleton,
+      Measure.count_singleton, mul_one, measure_singleton, Pi.zero_apply] using h
+  apply hμ
+  rw [← hf, hfzero]
+  exact withDensity_zero
+
+/-- The same obstruction applies to real or complex integrable densities in
+Rudin's set-integral formulation. -/
+theorem count_no_complex_density [MeasurableSingletonClass X]
+    (μ : Measure X) [NullSingletonClass μ] [IsFiniteMeasure μ] (hμ : μ ≠ 0) :
+    ¬ ∃ f : X → ℂ, Integrable f Measure.count ∧
+      ∀ E : Set X, MeasurableSet E →
+        (μ.real E : ℂ) = ∫ x in E, f x ∂Measure.count := by
+  rintro ⟨f, _, hf⟩
+  have hfzero : f = 0 := by
+    funext x
+    have h := hf {x} (measurableSet_singleton x)
+    simpa only [measureReal_def, measure_singleton, ENNReal.toReal_zero,
+      Complex.ofReal_zero, integral_singleton, count_real_singleton, one_smul,
+      Measure.count_singleton, ENNReal.toReal_one, Pi.zero_apply] using h.symm
+  have huniv : (μ Set.univ).toReal = 0 := by
+    have h := congrArg Complex.re (hf Set.univ MeasurableSet.univ)
+    simpa [hfzero, measureReal_def] using h
+  apply hμ
+  apply Measure.measure_univ_eq_zero.mp
+  exact ((ENNReal.toReal_eq_zero_iff _).mp huniv).resolve_right (measure_ne_top μ Set.univ)
+
+/-- A closed-unit-interval variant: counting measure cannot
+be decomposed relative to Lebesgue measure, while Lebesgue measure is absolutely
+continuous with respect to counting measure but has no density. -/
+theorem unitInterval_counterexamples :
+    (volume : Measure I) ≪ Measure.count ∧
+    (¬ ∃ a s : Measure I, Measure.count = a + s ∧ a ≪ volume ∧ s ⟂ₘ volume) ∧
+    (¬ ∃ f : I → ℝ≥0∞, Measure.count.withDensity f = volume) ∧
+    (¬ ∃ f : I → ℂ, Integrable f Measure.count ∧
+      ∀ E : Set I, MeasurableSet E →
+        ((volume : Measure I).real E : ℂ) = ∫ x in E, f x ∂Measure.count) := by
+  have hμ : (volume : Measure I) ≠ 0 := IsProbabilityMeasure.ne_zero _
+  exact ⟨absolutelyContinuous_count _, count_no_decomposition _ hμ,
+    count_no_density _ hμ, count_no_complex_density _ hμ⟩
+
+/-- The reference counting measure in the second counterexample is not
+sigma-finite. -/
+theorem unitInterval_count_not_sigmaFinite : ¬ SigmaFinite (Measure.count : Measure I) := by
+  intro hcount
+  letI : SigmaFinite (Measure.count : Measure I) := hcount
+  apply count_no_density (volume : Measure I) (IsProbabilityMeasure.ne_zero _)
+  exact ⟨(volume : Measure I).rnDeriv Measure.count,
+    Measure.withDensity_rnDeriv_eq _ _ (absolutelyContinuous_count _)⟩
+
+/-- Borel Lebesgue measure restricted to the open unit interval. -/
+def openIntervalVolume : Measure (Ioo (0 : ℝ) 1) :=
+  Measure.comap Subtype.val volume
+
+/-- Rudin's space (0,1) with the Lebesgue-completed sigma algebra. -/
+abbrev CompletedOpenUnitInterval :=
+  NullMeasurableSpace (Ioo (0 : ℝ) 1) openIntervalVolume
+
+/-- The completed Lebesgue measure used by the printed counterexamples. -/
+def openIntervalLebesgue : Measure CompletedOpenUnitInterval := openIntervalVolume.completion
+
+/-- Completion changes the sigma algebra, while preserving the outer-measure
+value of every subset. -/
+theorem openIntervalLebesgue_apply (E : Set CompletedOpenUnitInterval) :
+    openIntervalLebesgue E = volume (Subtype.val '' E : Set ℝ) := by
+  change openIntervalVolume E = volume (Subtype.val '' E : Set ℝ)
+  exact Measure.comap_subtype_coe_apply measurableSet_Ioo volume E
+
+/-- Measurability in this type is precisely null-measurability for Borel
+Lebesgue measure on (0,1), not merely Borel measurability. -/
+theorem completedOpenUnitInterval_measurable_iff (E : Set CompletedOpenUnitInterval) :
+    MeasurableSet E ↔ NullMeasurableSet (E : Set (Ioo (0 : ℝ) 1)) openIntervalVolume :=
+  Iff.rfl
+
+instance openIntervalLebesgue_isComplete : openIntervalLebesgue.IsComplete := by
+  change openIntervalVolume.completion.IsComplete
+  infer_instance
+
+instance openIntervalLebesgue_isProbabilityMeasure : IsProbabilityMeasure openIntervalLebesgue := by
+  constructor
+  rw [openIntervalLebesgue_apply]
+  simp only [image_univ, Subtype.range_coe, Real.volume_Ioo, sub_zero, ENNReal.ofReal_one]
+
+instance openIntervalLebesgue_nullSingletonClass : NullSingletonClass openIntervalLebesgue where
+  measure_singleton x := by
+    rw [openIntervalLebesgue_apply]
+    simp only [image_singleton, measure_singleton]
+
+/-- The two counterexamples following 6.10, on the printed space (0,1) with
+Lebesgue-measurable sets and completed Lebesgue measure. -/
+theorem openInterval_counterexamples :
+    openIntervalLebesgue.IsComplete ∧ openIntervalLebesgue ≪ Measure.count ∧
+    (¬ ∃ a s : Measure CompletedOpenUnitInterval,
+      Measure.count = a + s ∧ a ≪ openIntervalLebesgue ∧ s ⟂ₘ openIntervalLebesgue) ∧
+    (¬ ∃ f : CompletedOpenUnitInterval → ℝ≥0∞,
+      Measure.count.withDensity f = openIntervalLebesgue) ∧
+    (¬ ∃ f : CompletedOpenUnitInterval → ℂ, Integrable f Measure.count ∧
+      ∀ E : Set CompletedOpenUnitInterval, MeasurableSet E →
+        (openIntervalLebesgue.real E : ℂ) = ∫ x in E, f x ∂Measure.count) := by
+  have hμ : openIntervalLebesgue ≠ 0 := IsProbabilityMeasure.ne_zero _
+  exact ⟨inferInstance, absolutelyContinuous_count _, count_no_decomposition _ hμ,
+    count_no_density _ hμ, count_no_complex_density _ hμ⟩
+
+theorem completedOpenUnitInterval_count_not_sigmaFinite :
+    ¬ SigmaFinite (Measure.count : Measure CompletedOpenUnitInterval) := by
+  intro hcount
+  letI : SigmaFinite (Measure.count : Measure CompletedOpenUnitInterval) := hcount
+  apply count_no_density openIntervalLebesgue (IsProbabilityMeasure.ne_zero _)
+  exact ⟨openIntervalLebesgue.rnDeriv Measure.count,
+    Measure.withDensity_rnDeriv_eq _ _ (absolutelyContinuous_count _)⟩
+
+/-- The positive sigma-finite extension of Rudin 6.10.  The density is an
+everywhere finite, nonnegative real function and is integrable on each set of
+finite mass for the original measure. -/
+theorem sigmaFinite_positive_decomposition (ν μ : Measure X)
+    [SigmaFinite ν] [SigmaFinite μ] :
+    ∃ s : Measure X, ∃ h : X → ℝ,
+      Measurable h ∧ (∀ x, 0 ≤ h x) ∧ s ⟂ₘ μ ∧
+      ν = s + μ.withDensity (fun x ↦ ENNReal.ofReal (h x)) ∧
+      (∀ E : Set X, ν E ≠ ∞ → IntegrableOn h E μ) ∧
+      (∀ t : Measure X, ∀ g : X → ℝ≥0∞, Measurable g → t ⟂ₘ μ →
+        ν = t + μ.withDensity g →
+        t = s ∧ g =ᵐ[μ] (fun x ↦ ENNReal.ofReal (h x))) := by
+  have hdensity : (fun x ↦ ENNReal.ofReal ((ν.rnDeriv μ x).toReal)) =ᵐ[μ] ν.rnDeriv μ := by
+    filter_upwards [Measure.rnDeriv_ne_top ν μ] with x hx
+    exact ENNReal.ofReal_toReal hx
+  refine ⟨ν.singularPart μ, fun x ↦ (ν.rnDeriv μ x).toReal,
+    (Measure.measurable_rnDeriv _ _).ennreal_toReal,
+    fun _ ↦ ENNReal.toReal_nonneg, Measure.mutuallySingular_singularPart _ _, ?_, ?_, ?_⟩
+  · rw [withDensity_congr_ae hdensity]
+    exact Measure.haveLebesgueDecomposition_add _ _
+  · intro E hE
+    exact Measure.integrableOn_toReal_rnDeriv hE
+  · intro t g hg ht heq
+    exact ⟨Measure.eq_singularPart hg ht heq,
+      (Measure.eq_rnDeriv hg ht heq).trans hdensity.symm⟩
+
+/-- In the sigma-finite positive extension, global integrability of the density
+cannot be required. Counting measure on the natural numbers has density one
+relative to itself; this density is integrable on every finite-mass set but not
+on the whole space. -/
+theorem sigmaFinite_density_need_not_be_integrable :
+    SigmaFinite (Measure.count : Measure ℕ) ∧
+    (Measure.count : Measure ℕ).withDensity (fun _ ↦ ENNReal.ofReal (1 : ℝ)) =
+      Measure.count ∧
+    (∀ E : Set ℕ, Measure.count E ≠ ∞ →
+      IntegrableOn (fun _ : ℕ ↦ (1 : ℝ)) E Measure.count) ∧
+    ¬ Integrable (fun _ : ℕ ↦ (1 : ℝ)) Measure.count := by
+  refine ⟨inferInstance, ?_, ?_, ?_⟩
+  · simp
+  · intro E hE
+    exact integrableOn_const hE
+  · rw [integrable_const_iff_isFiniteMeasure one_ne_zero, not_isFiniteMeasure_iff]
+    exact Measure.count_apply_infinite (Set.infinite_univ : (Set.univ : Set ℕ).Infinite)
+
+#print axioms count_no_decomposition
+#print axioms count_no_density
+#print axioms count_no_complex_density
+#print axioms unitInterval_counterexamples
+#print axioms unitInterval_count_not_sigmaFinite
+#print axioms openIntervalLebesgue_apply
+#print axioms completedOpenUnitInterval_measurable_iff
+#print axioms openInterval_counterexamples
+#print axioms completedOpenUnitInterval_count_not_sigmaFinite
+#print axioms sigmaFinite_positive_decomposition
+#print axioms sigmaFinite_density_need_not_be_integrable
+
+end RCA610Discussion
diff --git a/books/rudin-real-and-complex-analysis/Scratch610Exhaustion.lean b/books/rudin-real-and-complex-analysis/Scratch610Exhaustion.lean
new file mode 100644
index 0000000..3f287bc
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/Scratch610Exhaustion.lean
@@ -0,0 +1,34 @@
+import Scratch610Discussion
+
+noncomputable section
+open MeasureTheory Set
+open scoped ENNReal
+
+namespace RCA610Discussion
+
+variable {X : Type*} [MeasurableSpace X]
+
+/-- The sigma-finite positive extension of 6.10 admits one increasing measurable
+exhaustion that is finite for both measures; the density is integrable on every
+member of that exhaustion. -/
+theorem sigmaFinite_positive_decomposition_with_exhaustion (ν μ : Measure X)
+    [SigmaFinite ν] [SigmaFinite μ] :
+    ∃ s : Measure X, ∃ h : X → ℝ, ∃ A : ℕ → Set X,
+      Measurable h ∧ (∀ x, 0 ≤ h x) ∧ s ⟂ₘ μ ∧
+      ν = s + μ.withDensity (fun x ↦ ENNReal.ofReal (h x)) ∧
+      Monotone A ∧ (∀ n, MeasurableSet (A n)) ∧ (⋃ n, A n) = univ ∧
+      ∀ n, μ (A n) < ∞ ∧ ν (A n) < ∞ ∧ IntegrableOn h (A n) μ := by
+  obtain ⟨s, h, hm, hpos, hsing, hdecomp, hlocal, _⟩ :=
+    sigmaFinite_positive_decomposition ν μ
+  refine ⟨s, h, spanningSets (μ + ν), hm, hpos, hsing, hdecomp,
+    monotone_spanningSets _, measurableSet_spanningSets _, iUnion_spanningSets _, ?_⟩
+  intro n
+  have hμ : μ (spanningSets (μ + ν) n) < ∞ :=
+    (self_le_add_right _ _).trans_lt (measure_spanningSets_lt_top (μ + ν) n)
+  have hν : ν (spanningSets (μ + ν) n) < ∞ :=
+    (self_le_add_left _ _).trans_lt (measure_spanningSets_lt_top (μ + ν) n)
+  exact ⟨hμ, hν, hlocal _ hν.ne⟩
+
+#print axioms sigmaFinite_positive_decomposition_with_exhaustion
+
+end RCA610Discussion
diff --git a/books/rudin-real-and-complex-analysis/Scratch611Completed.lean b/books/rudin-real-and-complex-analysis/Scratch611Completed.lean
new file mode 100644
index 0000000..178784d
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/Scratch611Completed.lean
@@ -0,0 +1,83 @@
+import Scratch610Discussion
+import Scratch611Example
+import Mathlib.MeasureTheory.Integral.Lebesgue.Map
+
+noncomputable section
+open MeasureTheory Set
+open scoped ENNReal
+
+namespace RCA611Completed
+
+open RCA610Discussion RudinRCA.Chapter06
+
+/-- The inclusion from the completed open interval into the real line is
+measurable: the completed domain sigma algebra contains the Borel sets. -/
+theorem measurable_interval_val :
+    Measurable (fun x : CompletedOpenUnitInterval ↦ (x.val : ℝ)) :=
+  ((measurable_subtype_coe : Measurable (fun x : Ioo (0 : ℝ) 1 ↦ x.val)).nullMeasurable
+    (μ := openIntervalVolume)).measurable'
+
+/-- Completion and restriction give precisely the ambient restricted Lebesgue
+measure under the inclusion map. This is the transfer bridge for the example. -/
+theorem interval_val_measurePreserving :
+    MeasurePreserving (fun x : CompletedOpenUnitInterval ↦ (x.val : ℝ))
+      openIntervalLebesgue unitIntervalMeasure where
+  measurable := measurable_interval_val
+  map_eq := by
+    ext E hE
+    rw [Measure.map_apply measurable_interval_val hE, openIntervalLebesgue_apply,
+      unitIntervalMeasure, Measure.restrict_apply hE, image_preimage_eq_inter_range]
+    have hrange : Set.range (fun x : CompletedOpenUnitInterval ↦ (x.val : ℝ)) =
+        Ioo (0 : ℝ) 1 := Subtype.range_coe
+    rw [hrange]
+
+/-- The reciprocal density on the Lebesgue-completed open interval, as in the
+discussion following Rudin 6.11. -/
+def completedInverseDensity : Measure CompletedOpenUnitInterval :=
+  openIntervalLebesgue.withDensity (fun x ↦ ENNReal.ofReal (x.val⁻¹))
+
+theorem completedInverseDensity_absolutelyContinuous :
+    completedInverseDensity ≪ openIntervalLebesgue :=
+  withDensity_absolutelyContinuous _ _
+
+/-- On every Borel test set, the density measure agrees with the ambient
+inverse-density example under the inclusion. -/
+theorem completedInverseDensity_preimage {E : Set ℝ} (hE : MeasurableSet E) :
+    completedInverseDensity ((fun x : CompletedOpenUnitInterval ↦ (x.val : ℝ)) ⁻¹' E) =
+      inverseDensityMeasure E := by
+  rw [completedInverseDensity,
+    withDensity_apply _ (hE.preimage measurable_interval_val),
+    inverseDensityMeasure, withDensity_apply _ hE]
+  exact interval_val_measurePreserving.setLIntegral_comp_preimage hE
+    measurable_inv.ennreal_ofReal
+
+theorem completedInverseDensity_Ioo {a : ℝ} (ha : 0 < a) (ha1 : a ≤ 1) :
+    completedInverseDensity
+      ((fun x : CompletedOpenUnitInterval ↦ (x.val : ℝ)) ⁻¹' Ioo 0 a) = ∞ :=
+  (completedInverseDensity_preimage measurableSet_Ioo).trans (inverseDensity_Ioo ha ha1)
+
+/-- The exact completed-space counterexample: the positive measure is absolutely
+continuous, but its mass is infinite on sets of arbitrarily small Lebesgue mass. -/
+theorem completedInverseDensity_fails_uniform_absoluteContinuity :
+    completedInverseDensity ≪ openIntervalLebesgue ∧
+      ∀ δ : ℝ, 0 < δ → ∃ E : Set CompletedOpenUnitInterval, MeasurableSet E ∧
+        openIntervalLebesgue E < ENNReal.ofReal δ ∧ completedInverseDensity E = ∞ := by
+  refine ⟨completedInverseDensity_absolutelyContinuous, ?_⟩
+  intro δ hδ
+  obtain ⟨E, hE, hsmall, hinfty⟩ := inverseDensity_fails_uniform_absoluteContinuity δ hδ
+  refine ⟨(fun x : CompletedOpenUnitInterval ↦ (x.val : ℝ)) ⁻¹' E,
+    hE.preimage measurable_interval_val, ?_, ?_⟩
+  · have hmass : openIntervalLebesgue
+        ((fun x : CompletedOpenUnitInterval ↦ (x.val : ℝ)) ⁻¹' E) = unitIntervalMeasure E := by
+      rw [← Measure.map_apply measurable_interval_val hE, interval_val_measurePreserving.map_eq]
+    exact hmass.symm ▸ hsmall
+  · exact (completedInverseDensity_preimage hE).trans hinfty
+
+#print axioms measurable_interval_val
+#print axioms interval_val_measurePreserving
+#print axioms completedInverseDensity_absolutelyContinuous
+#print axioms completedInverseDensity_preimage
+#print axioms completedInverseDensity_Ioo
+#print axioms completedInverseDensity_fails_uniform_absoluteContinuity
+
+end RCA611Completed
diff --git a/books/rudin-real-and-complex-analysis/Scratch611Example.lean b/books/rudin-real-and-complex-analysis/Scratch611Example.lean
new file mode 100644
index 0000000..f22c7c7
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/Scratch611Example.lean
@@ -0,0 +1,57 @@
+import Mathlib.Analysis.SpecialFunctions.Integrability.Basic
+import Mathlib.MeasureTheory.Measure.WithDensity
+import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
+import Mathlib.Tactic.Linarith
+
+noncomputable section
+open MeasureTheory Set
+open scoped ENNReal
+
+namespace RudinRCA.Chapter06
+
+/-- Lebesgue measure on (0,1), extended by zero outside the interval. -/
+def unitIntervalMeasure : Measure ℝ := volume.restrict (Ioo 0 1)
+
+/-- The positive, unbounded measure used in the discussion of Rudin 6.11. -/
+def inverseDensityMeasure : Measure ℝ :=
+  unitIntervalMeasure.withDensity (fun x ↦ ENNReal.ofReal x⁻¹)
+
+theorem inverseDensity_absolutelyContinuous :
+    inverseDensityMeasure ≪ unitIntervalMeasure :=
+  withDensity_absolutelyContinuous _ _
+
+theorem inverseDensity_Ioo {a : ℝ} (ha : 0 < a) (ha1 : a ≤ 1) :
+    inverseDensityMeasure (Ioo 0 a) = ∞ := by
+  rw [inverseDensityMeasure, withDensity_apply _ measurableSet_Ioo,
+    unitIntervalMeasure, Measure.restrict_restrict_of_subset (Ioo_subset_Ioo le_rfl ha1)]
+  apply Classical.byContradiction
+  intro hfinite
+  have hmeas : AEStronglyMeasurable (fun x : ℝ ↦ x⁻¹)
+      (volume.restrict (Ioo 0 a)) := measurable_inv.aestronglyMeasurable
+  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioo 0 a)] (fun x : ℝ ↦ x⁻¹) :=
+    ae_restrict_of_forall_mem measurableSet_Ioo fun x hx ↦ (inv_pos.mpr hx.1).le
+  have hi := (lintegral_ofReal_ne_top_iff_integrable hmeas hnonneg).mp hfinite
+  have hr : IntegrableOn (fun x : ℝ ↦ x ^ (-1 : ℝ)) (Ioo 0 a) := by
+    simpa only [IntegrableOn, Real.rpow_neg_one] using hi
+  have := (intervalIntegral.integrableOn_Ioo_rpow_iff ha).mp hr
+  exact (lt_irrefl (-1 : ℝ)) this
+
+/-- Although absolutely continuous, this positive measure has infinite mass on
+arbitrarily small intervals, so it fails the epsilon/delta criterion of 6.11. -/
+theorem inverseDensity_fails_uniform_absoluteContinuity :
+    ∀ δ : ℝ, 0 < δ → ∃ E : Set ℝ, MeasurableSet E ∧
+      unitIntervalMeasure E < ENNReal.ofReal δ ∧ inverseDensityMeasure E = ∞ := by
+  intro δ hδ
+  let a := min (δ / 2) (1 / 2)
+  have ha : 0 < a := lt_min (half_pos hδ) (by norm_num)
+  have ha1 : a ≤ 1 := (min_le_right _ _).trans (by norm_num)
+  have had : a < δ := (min_le_left _ _).trans_lt (half_lt_self hδ)
+  refine ⟨Ioo 0 a, measurableSet_Ioo, ?_, inverseDensity_Ioo ha ha1⟩
+  rw [unitIntervalMeasure, Measure.restrict_apply measurableSet_Ioo,
+    inter_eq_left.mpr (Ioo_subset_Ioo le_rfl ha1), Real.volume_Ioo, sub_zero]
+  exact (ENNReal.ofReal_lt_ofReal_iff hδ).mpr had
+
+#print axioms inverseDensity_absolutelyContinuous
+#print axioms inverseDensity_Ioo
+#print axioms inverseDensity_fails_uniform_absoluteContinuity
+end RudinRCA.Chapter06
diff --git a/books/rudin-real-and-complex-analysis/Scratch614Signs.lean b/books/rudin-real-and-complex-analysis/Scratch614Signs.lean
new file mode 100644
index 0000000..75517e2
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/Scratch614Signs.lean
@@ -0,0 +1,37 @@
+import Scratch69
+
+noncomputable section
+open MeasureTheory Set
+
+namespace RudinRCA.Chapter06
+
+variable {X : Type*} [MeasurableSpace X]
+
+/-- The Hahn partition from 6.14 has nonnegative signed measure on every
+measurable subset of its positive part, and nonpositive signed measure on every
+measurable subset of its negative part. The same partition realizes the Jordan
+variation identities. -/
+theorem theorem_6_14_signs (s : SignedMeasure X) :
+    ∃ A B : Set X, MeasurableSet A ∧ MeasurableSet B ∧ A ∪ B = univ ∧ Disjoint A B ∧
+      (∀ E, MeasurableSet E →
+        s.toJordanDecomposition.posPart.real E = s (E ∩ A) ∧
+        s.toJordanDecomposition.negPart.real E = -s (E ∩ B)) ∧
+      (∀ E, MeasurableSet E → E ⊆ A → 0 ≤ s E) ∧
+      (∀ E, MeasurableSet E → E ⊆ B → s E ≤ 0) := by
+  obtain ⟨A, B, hA, hB, hcover, hdisjoint, hparts⟩ := theorem_6_14 s
+  refine ⟨A, B, hA, hB, hcover, hdisjoint, hparts, ?_, ?_⟩
+  · intro E hE hEA
+    have heq := (hparts E hE).1
+    rw [inter_eq_left.mpr hEA] at heq
+    rw [← heq]
+    exact measureReal_nonneg
+  · intro E hE hEB
+    have heq := (hparts E hE).2
+    rw [inter_eq_left.mpr hEB] at heq
+    apply neg_nonneg.mp
+    rw [← heq]
+    exact measureReal_nonneg
+
+#print axioms theorem_6_14_signs
+
+end RudinRCA.Chapter06
diff --git a/books/rudin-real-and-complex-analysis/Scratch615General.lean b/books/rudin-real-and-complex-analysis/Scratch615General.lean
new file mode 100644
index 0000000..b4497ea
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/Scratch615General.lean
@@ -0,0 +1,152 @@
+import Scratch615GeneralSupport
+
+/-! The unrestricted-positive-measure duality assertion in the discussion 6.15.
+The endpoint p = 1 is intentionally excluded here; theorem 6.16 includes it
+under its printed sigma-finiteness hypothesis. -/
+
+noncomputable section
+
+open MeasureTheory Set Filter
+open scoped ENNReal NNReal Topology
+
+namespace RudinRCA.Chapter06
+
+variable {X : Type*} [MeasurableSpace X]
+
+theorem integral_lpZeroExtend_mul (μ : Measure X) (p : ℝ≥0∞) [Fact (1 ≤ p)]
+    {S : Set X} (hS : MeasurableSet S) (F : Lp ℂ p (μ.restrict S)) (g : X → ℂ) :
+    (∫ x, lpZeroExtend μ p hS F x * g x ∂μ) = ∫ x in S, F x * g x ∂μ := by
+  have heq : (fun x => lpZeroExtend μ p hS F x * g x) =ᵐ[μ]
+      S.indicator (fun x => F x * g x) := by
+    filter_upwards [lpZeroExtend_coeFn μ p hS F] with x hx
+    rw [hx]
+    by_cases hxS : x ∈ S <;> simp [hxS]
+  rw [integral_congr_ae heq, integral_indicator hS]
+
+theorem integral_mul_lpZeroExtend (μ : Measure X) (q : ℝ≥0∞) [Fact (1 ≤ q)]
+    {S : Set X} (hS : MeasurableSet S) (f : X → ℂ) (G : Lp ℂ q (μ.restrict S)) :
+    (∫ x, f x * lpZeroExtend μ q hS G x ∂μ) = ∫ x in S, f x * G x ∂μ := by
+  simpa only [mul_comm] using integral_lpZeroExtend_mul μ q hS G f
+
+/-- Extend the representing density of a sigma-finite restriction by zero.
+It represents the functional on all Lp classes supported on that restriction. -/
+theorem lpFunctional_density_on_sigmaFinite_restriction (μ : Measure X)
+    (p q : ℝ≥0∞) [Fact (1 ≤ p)] [Fact (1 ≤ q)] [ENNReal.HolderConjugate p q]
+    (hp : p ≠ ∞) (Φ : Lp ℂ p μ →L[ℂ] ℂ) {S : Set X} (hS : MeasurableSet S)
+    [SigmaFinite (μ.restrict S)] :
+    ∃ G : Lp ℂ q μ,
+      (∀ f : Lp ℂ p μ, (f : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 →
+        Φ f = ∫ x, f x * G x ∂μ) ∧
+      ‖G‖ = ‖lpFunctionalOnRestriction μ p Φ hS‖ ∧
+      (G : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 := by
+  obtain ⟨Glocal, ⟨hrep, hnorm⟩, _⟩ := theorem_6_16 (μ.restrict S) p q hp
+    (lpFunctionalOnRestriction μ p Φ hS)
+  let G := lpZeroExtend μ q hS Glocal
+  refine ⟨G, ?_, ?_, lpZeroExtend_ae_zero_compl μ q hS Glocal⟩
+  · intro f hfzero
+    let F := ((Lp.memLp f).restrict S).toLp f
+    have hext : lpZeroExtend μ p hS F = f := lpZeroExtend_restrict_eq μ p hS f hfzero
+    calc
+      Φ f = lpFunctionalOnRestriction μ p Φ hS F := by
+        change Φ f = Φ (lpZeroExtend μ p hS F)
+        rw [hext]
+      _ = ∫ x in S, F x * Glocal x ∂μ := hrep F
+      _ = ∫ x in S, f x * Glocal x ∂μ := by
+        apply integral_congr_ae
+        filter_upwards [MemLp.coeFn_toLp ((Lp.memLp f).restrict S)] with x hx
+        rw [hx]
+      _ = ∫ x, f x * G x ∂μ := (integral_mul_lpZeroExtend μ q hS f Glocal).symm
+  · exact ((lpZeroExtend μ q hS).norm_map Glocal).trans hnorm.symm
+
+/-- Two global densities representing the same functional on a sigma-finite
+restriction agree as Lq classes on that restriction. -/
+theorem lp_density_restrictions_eq (μ : Measure X) (p q : ℝ≥0∞)
+    [Fact (1 ≤ p)] [Fact (1 ≤ q)] (Φ : Lp ℂ p μ →L[ℂ] ℂ)
+    {S : Set X} (hS : MeasurableSet S) [SigmaFinite (μ.restrict S)]
+    (G H : Lp ℂ q μ)
+    (hG : ∀ f : Lp ℂ p μ, (f : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 →
+      Φ f = ∫ x, f x * G x ∂μ)
+    (hH : ∀ f : Lp ℂ p μ, (f : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 →
+      Φ f = ∫ x, f x * H x ∂μ) :
+    ((Lp.memLp G).restrict S).toLp G = ((Lp.memLp H).restrict S).toLp H := by
+  apply lp_integral_pairing_unique (μ.restrict S) p q
+  intro F
+  have hzero := lpZeroExtend_ae_zero_compl μ p hS F
+  have hvalue := (hG (lpZeroExtend μ p hS F) hzero).symm.trans
+    (hH (lpZeroExtend μ p hS F) hzero)
+  rw [integral_lpZeroExtend_mul μ p hS F G,
+    integral_lpZeroExtend_mul μ p hS F H] at hvalue
+  calc
+    (∫ x in S, F x * ((Lp.memLp G).restrict S).toLp G x ∂μ) =
+        ∫ x in S, F x * G x ∂μ := by
+      apply integral_congr_ae
+      filter_upwards [MemLp.coeFn_toLp ((Lp.memLp G).restrict S)] with x hx
+      rw [hx]
+    _ = ∫ x in S, F x * H x ∂μ := hvalue
+    _ = ∫ x in S, F x * ((Lp.memLp H).restrict S).toLp H x ∂μ := by
+      apply integral_congr_ae
+      filter_upwards [MemLp.coeFn_toLp ((Lp.memLp H).restrict S)] with x hx
+      rw [hx]
+
+/-- The affirmative answer for 1 < p < ∞ stated in Rudin 6.15 holds for
+arbitrary positive measures, without sigma-finiteness or completeness assumptions. -/
+theorem theorem_6_15_duality_arbitrary_measure (μ : Measure X)
+    (p q : ℝ≥0∞) [Fact (1 ≤ p)] [ENNReal.HolderConjugate p q]
+    (hp1 : 1 < p) (hp : p ≠ ∞) (Φ : Lp ℂ p μ →L[ℂ] ℂ) :
+    ∃! G : Lp ℂ q μ, (∀ f : Lp ℂ p μ, Φ f = ∫ x, f x * G x ∂μ) ∧ ‖Φ‖ = ‖G‖ := by
+  classical
+  letI : Fact (1 ≤ q) := ⟨ENNReal.HolderConjugate.one_le q p⟩
+  have hq : q ≠ ∞ := by
+    intro htop
+    exact hp1.ne' ((ENNReal.HolderConjugate.eq_top_iff_eq_one q p).mp htop)
+  obtain ⟨S, hS, hSF, hnormS⟩ := lpFunctional_exists_sigmaFinite_norm_support μ p hp Φ
+  letI : SigmaFinite (μ.restrict S) := hSF
+  obtain ⟨G, hGrep, hGnorm, hGzero⟩ :=
+    lpFunctional_density_on_sigmaFinite_restriction μ p q hp Φ hS
+  have hnormG : ‖G‖ = ‖Φ‖ := hGnorm.trans hnormS
+  have hrep : ∀ f : Lp ℂ p μ, Φ f = ∫ x, f x * G x ∂μ := by
+    intro f
+    obtain ⟨T, hT, hfzero, hTF⟩ := ((Lp.memLp f).aefinStronglyMeasurable
+      (one_pos.trans_le hp1.le).ne' hp).exists_set_sigmaFinite
+    letI : SigmaFinite (μ.restrict T) := hTF
+    let U := S ∪ T
+    have hU : MeasurableSet U := hS.union hT
+    letI : SigmaFinite (μ.restrict U) := by dsimp [U]; infer_instance
+    obtain ⟨H, hHrep, hHnorm, hHzero⟩ :=
+      lpFunctional_density_on_sigmaFinite_restriction μ p q hp Φ hU
+    have hHrepS : ∀ k : Lp ℂ p μ, (k : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 →
+        Φ k = ∫ x, k x * H x ∂μ := by
+      intro k hk
+      apply hHrep k
+      exact ae_restrict_of_ae_restrict_of_subset
+        (compl_subset_compl.mpr subset_union_left) hk
+    have hrestr := lp_density_restrictions_eq μ p q Φ hS H G hHrepS hGrep
+    have hGrestrictNorm : ‖((Lp.memLp G).restrict S).toLp G‖ = ‖G‖ := by
+      rw [← (lpZeroExtend μ q hS).norm_map (((Lp.memLp G).restrict S).toLp G),
+        lpZeroExtend_restrict_eq μ q hS G hGzero]
+    have hHnormLe : ‖H‖ ≤ ‖((Lp.memLp H).restrict S).toLp H‖ := by
+      rw [hrestr, hGrestrictNorm, hnormG]
+      exact hHnorm.le.trans (lpFunctionalOnRestriction_norm_le μ p Φ hU)
+    have hHzeroS := lp_ae_zero_compl_of_norm_le_restrict μ q hq H hS hHnormLe
+    have hHG : H = G := by
+      calc
+        H = lpZeroExtend μ q hS (((Lp.memLp H).restrict S).toLp H) :=
+          (lpZeroExtend_restrict_eq μ q hS H hHzeroS).symm
+        _ = lpZeroExtend μ q hS (((Lp.memLp G).restrict S).toLp G) :=
+          congrArg (lpZeroExtend μ q hS) hrestr
+        _ = G := lpZeroExtend_restrict_eq μ q hS G hGzero
+    have hfzeroU : (f : X → ℂ) =ᵐ[μ.restrict Uᶜ] 0 :=
+      ae_restrict_of_ae_restrict_of_subset (compl_subset_compl.mpr subset_union_right) hfzero
+    exact (hHrep f hfzeroU).trans (congrArg (fun K : Lp ℂ q μ => ∫ x, f x * K x ∂μ) hHG)
+  refine ⟨G, ⟨hrep, hnormG.symm⟩, ?_⟩
+  intro H hH
+  exact lp_integral_pairing_unique_finite_exponent μ p q hq H G fun f =>
+    (hH.1 f).symm.trans (hrep f)
+
+#print axioms integral_lpZeroExtend_mul
+#print axioms integral_mul_lpZeroExtend
+#print axioms lpFunctional_density_on_sigmaFinite_restriction
+#print axioms lp_density_restrictions_eq
+#print axioms theorem_6_15_duality_arbitrary_measure
+
+end RudinRCA.Chapter06
diff --git a/books/rudin-real-and-complex-analysis/Scratch615GeneralSupport.lean b/books/rudin-real-and-complex-analysis/Scratch615GeneralSupport.lean
new file mode 100644
index 0000000..81c7c83
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/Scratch615GeneralSupport.lean
@@ -0,0 +1,171 @@
+import Scratch616J
+import Mathlib.Analysis.Normed.Operator.NNNorm
+import Mathlib.MeasureTheory.Function.StronglyMeasurable.Lp
+import Mathlib.MeasureTheory.Integral.Lebesgue.Basic
+
+/-! Sigma-finite supports and finite-exponent norm rigidity for the unrestricted
+measure assertion in Rudin 6.15. -/
+
+noncomputable section
+
+open MeasureTheory Set Filter
+open scoped ENNReal NNReal Topology
+
+namespace RudinRCA.Chapter06
+
+variable {X : Type*} [MeasurableSpace X]
+
+theorem lpZeroExtend_restrict_eq (μ : Measure X) (p : ℝ≥0∞) [Fact (1 ≤ p)]
+    {S : Set X} (hS : MeasurableSet S) (f : Lp ℂ p μ)
+    (hfzero : (f : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0) :
+    lpZeroExtend μ p hS (((Lp.memLp f).restrict S).toLp f) = f := by
+  apply Lp.ext
+  have hr := (ae_eq_restrict_iff_indicator_ae_eq hS).mp
+    (MemLp.coeFn_toLp ((Lp.memLp f).restrict S))
+  have hz := (ae_restrict_iff' hS.compl).mp hfzero
+  filter_upwards [lpZeroExtend_coeFn μ p hS (((Lp.memLp f).restrict S).toLp f), hr, hz]
+    with x h₁ h₂ h₃
+  rw [h₁, h₂]
+  by_cases hx : x ∈ S
+  · exact indicator_of_mem hx _
+  · rw [indicator_of_notMem hx, h₃ hx]
+
+theorem lpZeroExtend_ae_zero_compl (μ : Measure X) (p : ℝ≥0∞) [Fact (1 ≤ p)]
+    {S : Set X} (hS : MeasurableSet S) (f : Lp ℂ p (μ.restrict S)) :
+    (lpZeroExtend μ p hS f : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 := by
+  apply (ae_restrict_iff' hS.compl).mpr
+  filter_upwards [lpZeroExtend_coeFn μ p hS f] with x hx
+  intro hxS
+  rw [hx, indicator_of_notMem hxS]
+
+theorem lp_integral_pairing_unique_finite_exponent (μ : Measure X)
+    (p q : ℝ≥0∞) [Fact (1 ≤ p)] [Fact (1 ≤ q)] (hq : q ≠ ∞)
+    (g h : Lp ℂ q μ)
+    (heq : ∀ f : Lp ℂ p μ, (∫ x, f x * g x ∂μ) = ∫ x, f x * h x ∂μ) : g = h := by
+  have hint : ∀ k : Lp ℂ q μ, ∀ E, MeasurableSet E → μ E < ∞ → IntegrableOn k E μ := by
+    intro k E hE hμE
+    letI : IsFiniteMeasure (μ.restrict E) := ⟨by simpa using hμE⟩
+    exact ((Lp.memLp k).restrict E).integrable (Fact.out : 1 ≤ q)
+  apply Lp.ext
+  apply Lp.ae_eq_of_forall_setIntegral_eq g h
+    (one_pos.trans_le (Fact.out : 1 ≤ q)).ne' hq (hint g) (hint h)
+  intro E hE hμE
+  have ht := heq (indicatorConstLp p hE hμE.ne (1 : ℂ))
+  simpa only [integral_indicatorConstLp_mul μ p hE hμE.ne] using ht
+
+/-- A bounded functional on finite-exponent Lp captures its whole norm on a
+sigma-finite measurable restriction, even when the ambient measure is arbitrary. -/
+theorem lpFunctional_exists_sigmaFinite_norm_support (μ : Measure X)
+    (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp : p ≠ ∞) (Φ : Lp ℂ p μ →L[ℂ] ℂ) :
+    ∃ S, ∃ hS : MeasurableSet S, SigmaFinite (μ.restrict S) ∧
+      ‖lpFunctionalOnRestriction μ p Φ hS‖ = ‖Φ‖ := by
+  classical
+  have happrox : ∀ n : ℕ, ∃ f : Lp ℂ p μ,
+      ‖f‖ < 1 ∧ ‖Φ‖ - 1 / ((n : ℝ) + 1) < ‖Φ f‖ := by
+    intro n
+    apply Φ.exists_lt_apply_of_lt_opNorm
+    exact sub_lt_self _ (by positivity)
+  choose fn hfn hval using happrox
+  have hsupp : ∀ n, ∃ S, MeasurableSet S ∧
+      (fn n : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 ∧ SigmaFinite (μ.restrict S) := by
+    intro n
+    exact ((Lp.memLp (fn n)).aefinStronglyMeasurable
+      (one_pos.trans_le (Fact.out : 1 ≤ p)).ne' hp).exists_set_sigmaFinite
+  choose Sn hSn hzero hsig using hsupp
+  let S : Set X := ⋃ n, Sn n
+  have hS : MeasurableSet S := MeasurableSet.iUnion hSn
+  letI : ∀ n, SigmaFinite (μ.restrict (Sn n)) := hsig
+  have hSF : SigmaFinite (μ.restrict S) := by
+    let cover : ℕ × ℕ → Set X := fun nk =>
+      Sn nk.1 ∩ spanningSets (μ.restrict (Sn nk.1)) nk.2
+    apply Measure.sigmaFinite_of_countable
+      ((countable_range cover).insert Sᶜ) (S := insert Sᶜ (range cover))
+    · intro E hE
+      rcases hE with rfl | ⟨⟨n, k⟩, rfl⟩
+      · simp [Measure.restrict_apply hS.compl]
+      · calc
+          (μ.restrict S) (cover (n, k)) ≤ μ (cover (n, k)) := Measure.restrict_le_self _
+          _ = (μ.restrict (Sn n)) (spanningSets (μ.restrict (Sn n)) k) := by
+            rw [Measure.restrict_apply' (hSn n)]
+            exact congrArg μ (inter_comm _ _)
+          _ < ∞ := measure_spanningSets_lt_top (μ.restrict (Sn n)) k
+    · apply eq_univ_of_forall
+      intro x
+      apply mem_sUnion.mpr
+      by_cases hxS : x ∈ S
+      · obtain ⟨n, hxn⟩ := mem_iUnion.mp hxS
+        let k := spanningSetsIndex (μ.restrict (Sn n)) x
+        exact ⟨cover (n, k), mem_insert_of_mem _ ⟨(n, k), rfl⟩,
+          hxn, mem_spanningSetsIndex (μ.restrict (Sn n)) x⟩
+      · exact ⟨Sᶜ, mem_insert _ _, hxS⟩
+  let Ψ := lpFunctionalOnRestriction μ p Φ hS
+  have hnormLower : ∀ n, ‖Φ‖ - 1 / ((n : ℝ) + 1) < ‖Ψ‖ := by
+    intro n
+    let fS := ((Lp.memLp (fn n)).restrict S).toLp (fn n)
+    have hz : (fn n : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 :=
+      ae_restrict_of_ae_restrict_of_subset
+        (compl_subset_compl.mpr (subset_iUnion Sn n)) (hzero n)
+    have hext : lpZeroExtend μ p hS fS = fn n := lpZeroExtend_restrict_eq μ p hS (fn n) hz
+    have hfSnorm : ‖fS‖ = ‖fn n‖ := by
+      rw [← (lpZeroExtend μ p hS).norm_map fS, hext]
+    have hΦeq : Ψ fS = Φ (fn n) := by
+      change Φ (lpZeroExtend μ p hS fS) = _
+      rw [hext]
+    have hbound : ‖Φ (fn n)‖ ≤ ‖Ψ‖ := by
+      rw [← hΦeq]
+      calc
+        ‖Ψ fS‖ ≤ ‖Ψ‖ * ‖fS‖ := Ψ.le_opNorm fS
+        _ ≤ ‖Ψ‖ * 1 := mul_le_mul_of_nonneg_left
+          (by rw [hfSnorm]; exact (hfn n).le) (norm_nonneg Ψ)
+        _ = ‖Ψ‖ := mul_one _
+    exact (hval n).trans_le hbound
+  refine ⟨S, hS, hSF, le_antisymm (lpFunctionalOnRestriction_norm_le μ p Φ hS) ?_⟩
+  by_contra h
+  have hpos : 0 < ‖Φ‖ - ‖Ψ‖ := sub_pos.mpr (lt_of_not_ge h)
+  obtain ⟨n, hn⟩ := exists_nat_one_div_lt hpos
+  have hlt := hnormLower n
+  linarith
+
+/-- For a finite nonzero exponent, a restriction can retain the full Lq norm
+only if the function vanishes almost everywhere on the complement. -/
+theorem memLp_ae_zero_compl_of_eLpNorm_le_restrict (μ : Measure X)
+    (q : ℝ≥0∞) (hq0 : q ≠ 0) (hq : q ≠ ∞) {g : X → ℂ} (hg : MemLp g q μ)
+    {S : Set X} (hS : MeasurableSet S)
+    (hnorm : eLpNorm g q μ ≤ eLpNorm g q (μ.restrict S)) :
+    g =ᵐ[μ.restrict Sᶜ] 0 := by
+  have hqr : 0 < q.toReal := ENNReal.toReal_pos hq0 hq
+  have heq : eLpNorm g q (μ.restrict S) = eLpNorm g q μ :=
+    le_antisymm (eLpNorm_restrict_le g q μ S) hnorm
+  have hmass : (∫⁻ x in S, ‖g x‖ₑ ^ q.toReal ∂μ) = ∫⁻ x, ‖g x‖ₑ ^ q.toReal ∂μ := by
+    have hpow := congrArg (fun z : ℝ≥0∞ => z ^ q.toReal) heq
+    rw [eLpNorm_eq_eLpNorm' hq0 hq hg.aestronglyMeasurable.restrict,
+      eLpNorm_eq_eLpNorm' hq0 hq hg.aestronglyMeasurable,
+      ← lintegral_rpow_enorm_eq_rpow_eLpNorm' hqr,
+      ← lintegral_rpow_enorm_eq_rpow_eLpNorm' hqr] at hpow
+    exact hpow
+  have hfinite : (∫⁻ x in S, ‖g x‖ₑ ^ q.toReal ∂μ) ≠ ∞ :=
+    (lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top hq0 hq ((hg.restrict S))).ne
+  have hcompl : (∫⁻ x in Sᶜ, ‖g x‖ₑ ^ q.toReal ∂μ) = 0 := by
+    rw [setLIntegral_compl hS hfinite, hmass, tsub_self]
+  apply (eLpNorm_eq_zero_iff hq0).mp
+  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hq0 hq hg.aestronglyMeasurable.restrict,
+    hcompl, ENNReal.zero_rpow_of_pos (one_div_pos.mpr hqr)]
+
+theorem lp_ae_zero_compl_of_norm_le_restrict (μ : Measure X)
+    (q : ℝ≥0∞) [Fact (1 ≤ q)] (hq : q ≠ ∞) (g : Lp ℂ q μ)
+    {S : Set X} (hS : MeasurableSet S)
+    (hnorm : ‖g‖ ≤ ‖((Lp.memLp g).restrict S).toLp g‖) :
+    (g : X → ℂ) =ᵐ[μ.restrict Sᶜ] 0 := by
+  apply memLp_ae_zero_compl_of_eLpNorm_le_restrict μ q
+    (one_pos.trans_le (Fact.out : 1 ≤ q)).ne' hq (Lp.memLp g) hS
+  rw [Lp.norm_def, Lp.norm_toLp] at hnorm
+  exact (ENNReal.toReal_le_toReal (Lp.memLp g).ne ((Lp.memLp g).restrict S).ne).mp hnorm
+
+#print axioms lpZeroExtend_restrict_eq
+#print axioms lpZeroExtend_ae_zero_compl
+#print axioms lp_integral_pairing_unique_finite_exponent
+#print axioms lpFunctional_exists_sigmaFinite_norm_support
+#print axioms memLp_ae_zero_compl_of_eLpNorm_le_restrict
+#print axioms lp_ae_zero_compl_of_norm_le_restrict
+
+end RudinRCA.Chapter06
diff --git a/books/rudin-real-and-complex-analysis/Scratch615Infinity.lean b/books/rudin-real-and-complex-analysis/Scratch615Infinity.lean
