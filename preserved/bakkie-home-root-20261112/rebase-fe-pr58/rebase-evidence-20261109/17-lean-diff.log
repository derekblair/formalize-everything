+theorem lpOneFunctional_density_memLp_top
+    (Φ : Lp ℂ 1 μ →L[ℂ] ℂ) {g : X → ℂ} (hgm : Measurable g) (hg : Integrable g μ)
+    (hind : ∀ E (hE : MeasurableSet E),
