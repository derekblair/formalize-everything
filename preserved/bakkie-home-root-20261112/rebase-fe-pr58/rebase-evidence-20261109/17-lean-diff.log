@@ -0,0 +1,612 @@
+import Mathlib.Analysis.Complex.JensenFormula
+import Mathlib.Analysis.Complex.CauchyIntegral
+import Mathlib.Algebra.BigOperators.Finprod
+import Mathlib.MeasureTheory.Integral.IntervalIntegral.Periodic
+import Mathlib.Tactic.Ring
+import Mathlib.Analysis.Complex.AbsMax
+import Mathlib.Analysis.Complex.RemovableSingularity
+import Mathlib.Analysis.Complex.OpenMapping
+import Mathlib.Analysis.SpecialFunctions.Complex.Log
+import Mathlib.Analysis.SpecialFunctions.Pow.Real
+import Mathlib.Analysis.SpecialFunctions.ExpDeriv
+import Mathlib.Topology.Order.LiminfLimsup
+import Mathlib.Tactic.FunProp
+import Mathlib.Tactic.NormNum
+import Mathlib.Tactic.Positivity
+import Mathlib.Tactic.FieldSimp
+import Mathlib.Tactic.Linarith
+
+
+/-!
+Rudin 15.17–15.18. The angular integrals below are Lebesgue interval integrals.
+The explicit integrability conclusions account for logarithmic singularities at
+zeros on the circle; changing the value at those finitely many points does not
+change these integrals.
+-/
+
+namespace RudinRCA.Chapter15.JensenWork
+
+open MeasureTheory Metric Real Set
+
+/-- Rudin 15.17, with integrability at the endpoint singularities included. -/
+theorem log_one_sub_exp_circle_integral :
+    IntervalIntegrable (fun θ : ℝ ↦ Real.log ‖1 - Complex.exp ((θ : ℂ) * Complex.I)‖)
+        volume 0 (2 * Real.pi) ∧
+      (2 * Real.pi)⁻¹ *
+        (∫ θ : ℝ in 0..2 * Real.pi,
+          Real.log ‖1 - Complex.exp ((θ : ℂ) * Complex.I)‖) = 0 := by
+  constructor
+  · simpa [CircleIntegrable, circleMap, norm_sub_rev] using
+      (circleIntegrable_log_norm_sub_const (a := (1 : ℂ)) (c := 0) 1)
+  · simpa [circleAverage, circleMap, smul_eq_mul, norm_sub_rev] using
+      (circleAverage_log_norm_sub_const₁ (a := (1 : ℂ)) (by simp))
+
+/-- Write the circle average with Rudin's interval of angles `[-π, π]`. -/
+theorem circleAverage_eq_angular_integral (g : ℂ → ℝ) (r : ℝ) :
+    circleAverage g 0 r = (2 * Real.pi)⁻¹ *
+      (∫ θ : ℝ in -Real.pi..Real.pi, g ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))) := by
+  have hp : Function.Periodic (fun θ ↦ g (circleMap 0 r θ)) (2 * Real.pi) :=
+    fun θ ↦ by rw [periodic_circleMap 0 r θ]
+  have hi := hp.intervalIntegral_add_eq 0 (-Real.pi)
+  have hend : -Real.pi + 2 * Real.pi = Real.pi := by ring
+  simp only [zero_add, hend] at hi
+  rw [circleAverage, hi]
+  simp only [smul_eq_mul, circleMap_zero]
+
+/-- Number of appearances of `z` in a finite indexed list, including repetitions. -/
+noncomputable def zeroMultiplicity {N : ℕ} (a : Fin N → ℂ) (z : ℂ) : ℕ := by
+  classical
+  exact (Finset.univ.filter fun i ↦ a i = z).card
+
+/-- A finite list of all zeros in the closed disc, with each zero repeated exactly
+as often as its analytic order. In particular, zeros on the boundary are included. -/
+structure EnumeratesClosedDiscZeros {N : ℕ} (f : ℂ → ℂ) (r : ℝ) (a : Fin N → ℂ) : Prop where
+  location : ∀ i, ‖a i‖ ≤ r
+  zero : ∀ i, f (a i) = 0
+  multiplicity : ∀ z, ‖z‖ ≤ r → analyticOrderAt f z = (zeroMultiplicity a z : ℕ∞)
+
+theorem finsum_zeroMultiplicity {N : ℕ} (a : Fin N → ℂ) (w : ℂ → ℝ) :
+    (∑ᶠ z, (zeroMultiplicity a z : ℝ) * w z) = ∑ i, w (a i) := by
+  classical
+  have hfib (z : ℂ) :
+      (∑ i ∈ Finset.univ.filter (fun i ↦ a i = z), w (a i)) =
+        (zeroMultiplicity a z : ℝ) * w z := by
+    calc
+      (∑ i ∈ Finset.univ.filter (fun i ↦ a i = z), w (a i)) =
+          ∑ i ∈ Finset.univ.filter (fun i ↦ a i = z), w z := by
+        apply Finset.sum_congr rfl
+        intro i hi
+        rw [(Finset.mem_filter.mp hi).2]
+      _ = _ := by simp [zeroMultiplicity, nsmul_eq_mul]
+  simpa only [hfib] using
+    (finsum_sum_filter a Finset.univ (fun i ↦ w (a i)))
+
+theorem EnumeratesClosedDiscZeros.divisor_eq {N : ℕ} {f : ℂ → ℂ} {r : ℝ}
+    {a : Fin N → ℂ} (ha : EnumeratesClosedDiscZeros f r a)
+    (hf : AnalyticOnNhd ℂ f (closedBall 0 r)) (z : ℂ) :
+    MeromorphicOn.divisor f (closedBall 0 r) z = (zeroMultiplicity a z : ℤ) := by
+  classical
+  by_cases hz : z ∈ closedBall (0 : ℂ) r
+  · simp [hf.divisor_apply hz, ha.multiplicity z (by simpa using hz)]
+  · rw [Function.locallyFinsuppWithin.apply_eq_zero_of_notMem _ hz]
+    have hc : zeroMultiplicity a z = 0 := by
+      unfold zeroMultiplicity
+      apply Finset.card_eq_zero.mpr
+      apply Finset.filter_eq_empty_iff.mpr
+      intro i hi hai
+      apply hz
+      simpa [← hai] using ha.location i
+    simp [hc]
+
+theorem jensen_angular_log_integrable {R r : ℝ} {f : ℂ → ℂ}
+    (hr : 0 < r) (hrR : r < R) (hf : DifferentiableOn ℂ f (ball 0 R)) :
+    IntervalIntegrable (fun θ : ℝ ↦
+      Real.log ‖f ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))‖)
+      volume (-Real.pi) Real.pi := by
+  have hA : AnalyticOnNhd ℂ f (closedBall 0 |r|) := by
+    apply (hf.analyticOnNhd isOpen_ball).mono
+    simpa [abs_of_pos hr] using closedBall_subset_ball hrR
+  have hc : CircleIntegrable (fun z ↦ Real.log ‖f z‖) 0 r :=
+    (hA.mono sphere_subset_closedBall).meromorphicOn.circleIntegrable_log_norm
+  have hp : Function.Periodic (fun θ ↦ Real.log ‖f (circleMap 0 r θ)‖) (2 * Real.pi) :=
+    fun θ ↦ by rw [periodic_circleMap 0 r θ]
+  simpa only [circleMap_zero] using
+    hp.intervalIntegrable₀ (mul_ne_zero two_ne_zero Real.pi_ne_zero) hc (-Real.pi) Real.pi
+
+/-- Rudin 15.18 in its printed product form, for the closed-disc list of zeros and
+the angular interval `[-π,π]`. Boundary zeros contribute the factor `r / r = 1`. -/
+theorem jensen_formula {N : ℕ} {R r : ℝ} {f : ℂ → ℂ} (a : Fin N → ℂ)
+    (hr : 0 < r) (hrR : r < R) (hf : DifferentiableOn ℂ f (ball 0 R))
+    (hf0 : f 0 ≠ 0) (ha : EnumeratesClosedDiscZeros f r a) :
+    IntervalIntegrable (fun θ : ℝ ↦
+      Real.log ‖f ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))‖)
+      volume (-Real.pi) Real.pi ∧
+    ‖f 0‖ * (∏ i, r / ‖a i‖) = Real.exp ((2 * Real.pi)⁻¹ *
+      (∫ θ : ℝ in -Real.pi..Real.pi,
+        Real.log ‖f ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))‖)) := by
+  refine ⟨jensen_angular_log_integrable hr hrR hf, ?_⟩
+  have hA : AnalyticOnNhd ℂ f (closedBall 0 r) :=
+    (hf.analyticOnNhd isOpen_ball).mono (closedBall_subset_ball hrR)
+  have hA' : AnalyticOnNhd ℂ f (closedBall 0 |r|) := by
+    simpa only [abs_of_pos hr] using hA
+  have hne (i : Fin N) : a i ≠ 0 := by
+    intro hi
+    exact hf0 (by simpa [hi] using ha.zero i)
+  have hj := hA'.circleAverage_log_norm hr.ne' hf0
+  simp only [abs_of_pos hr, ha.divisor_eq hA, Int.cast_natCast, zero_sub, norm_neg,
+    ← div_eq_mul_inv] at hj
+  rw [finsum_zeroMultiplicity] at hj
+  have hexp (i : Fin N) : Real.exp (Real.log (r / ‖a i‖)) = r / ‖a i‖ :=
+    Real.exp_log (div_pos hr (norm_pos_iff.mpr (hne i)))
+  have he := congrArg Real.exp hj
+  rw [Real.exp_add, Real.exp_sum, Real.exp_log (norm_pos_iff.mpr hf0)] at he
+  simp only [hexp] at he
+  calc
+    ‖f 0‖ * (∏ i, r / ‖a i‖) = Real.exp (circleAverage (fun z ↦ Real.log ‖f z‖) 0 r) := by
+      simpa only [mul_comm] using he.symm
+    _ = _ := by rw [circleAverage_eq_angular_integral]
+
+#print axioms log_one_sub_exp_circle_integral
+#print axioms circleAverage_eq_angular_integral
+#print axioms finsum_zeroMultiplicity
+#print axioms EnumeratesClosedDiscZeros.divisor_eq
+#print axioms jensen_angular_log_integrable
+#print axioms jensen_formula
+
+end RudinRCA.Chapter15.JensenWork
+
+
+namespace RudinRCA.Chapter15.ZeroGrowthWork
+
+open Filter Metric Set
+open scoped Topology
+
+/-- The maximum modulus on the circle of radius `r`. -/
+noncomputable def maximumModulus (f : ℂ → ℂ) (r : ℝ) : ℝ :=
+  sSup ((fun z ↦ ‖f z‖) '' sphere 0 r)
+
+/-- Closed-disc zero count, with multiplicity. Entire functions have nonnegative
+divisors, so `toNat` here only changes the representation of their sum. -/
+noncomputable def entireZeroCount (f : ℂ → ℂ) (r : ℝ) : ℕ :=
+  Int.toNat (∑ᶠ z, MeromorphicOn.divisor f (closedBall 0 r) z)
+
+theorem norm_le_maximumModulus {f : ℂ → ℂ} (hf : Continuous f) {r : ℝ} {z : ℂ}
+    (hz : z ∈ sphere 0 r) : ‖f z‖ ≤ maximumModulus f r := by
+  exact le_csSup ((isCompact_sphere (0 : ℂ) r).image hf.norm).bddAbove ⟨z, hz, rfl⟩
+
+theorem one_le_maximumModulus {f : ℂ → ℂ} (hf : Differentiable ℂ f) (hf0 : f 0 = 1)
+    {r : ℝ} (hr : 0 < r) : 1 ≤ maximumModulus f r := by
+  have h := Complex.norm_le_of_forall_mem_frontier_norm_le
+    (f := f) (U := ball (0 : ℂ) r) isBounded_ball
+    ⟨hf.differentiableOn, hf.continuous.continuousOn⟩
+    (fun z hz ↦ norm_le_maximumModulus hf.continuous (frontier_ball_subset_sphere hz))
+    (subset_closure (mem_ball_self hr))
+  simpa [hf0] using h
+
+theorem entireZeroCount_intCast {f : ℂ → ℂ} (hf : Differentiable ℂ f) (r : ℝ) :
+    (entireZeroCount f r : ℤ) = ∑ᶠ z, MeromorphicOn.divisor f (closedBall 0 r) z := by
+  have hA : AnalyticOnNhd ℂ f (closedBall 0 r) := fun z _ ↦ hf.analyticAt z
+  exact Int.toNat_of_nonneg (finsum_nonneg (fun z ↦ hA.divisor_nonneg z))
+
+/-- Rudin 15.20(2), using the actual circle maximum and the closed-disc zero count. -/
+theorem zero_count_log_two_le {f : ℂ → ℂ} (hf : Differentiable ℂ f) (hf0 : f 0 = 1)
+    {r : ℝ} (hr : 0 < r) :
+    (entireZeroCount f r : ℝ) * Real.log 2 ≤ Real.log (maximumModulus f (2 * r)) := by
+  have h2r : 0 < 2 * r := mul_pos (by norm_num) hr
+  have hA : AnalyticOnNhd ℂ f (closedBall 0 |2 * r|) := fun z _ ↦ hf.analyticAt z
+  have hb : ∀ z ∈ sphere (0 : ℂ) |2 * r|, ‖f z‖ ≤ maximumModulus f (2 * r) := by
+    intro z hz
+    apply norm_le_maximumModulus hf.continuous
+    simpa only [abs_of_pos h2r] using hz
+  have hj := hA.sum_divisor_le (r := r) (R := 2 * r)
+    (by simpa [abs_of_pos hr] using hr)
+    (by simp only [abs_of_pos hr, abs_of_pos h2r]; linarith)
+    (one_le_maximumModulus hf hf0 h2r) (by simp [hf0]) hb
+  have hc : (entireZeroCount f r : ℝ) =
+      ((∑ᶠ z, MeromorphicOn.divisor f (closedBall 0 r) z : ℤ) : ℝ) := by
+    simpa only [Int.cast_natCast] using congrArg (fun n : ℤ ↦ (n : ℝ)) (entireZeroCount_intCast hf r)
+  have hratio : (2 * r) / r = 2 := by field_simp [hr.ne']
+  simp only [abs_of_pos hr, hf0, norm_one, div_one, hratio] at hj
+  rw [← hc] at hj
+  exact (le_div_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 2))).mp hj
+
+/-- A general logarithmic growth bound for natural-valued counts. The library's
+`log 0 = 0` convention gives zero for an identically zero count; the corresponding
+extended-real logarithm is `-∞` and also satisfies the asserted upper bound. -/
+theorem limsup_log_count_le_of_polynomial_bound (n : ℝ → ℕ) {C k : ℝ}
+    (hC : 1 ≤ C) (hk : 0 ≤ k)
+    (hn : ∀ᶠ r in atTop, (n r : ℝ) ≤ C * r ^ k) :
+    Filter.limsup (fun r : ℝ ↦ Real.log (n r) / Real.log r) atTop ≤ k := by
+  have hCpos : 0 < C := zero_lt_one.trans_le hC
+  have hu : ∀ᶠ r in atTop,
+      Real.log (n r) / Real.log r ≤ Real.log C / Real.log r + k := by
+    filter_upwards [hn, eventually_gt_atTop (1 : ℝ)] with r hnr hr
+    have hrpos : 0 < r := zero_lt_one.trans hr
+    have hlr : 0 < Real.log r := Real.log_pos hr
+    by_cases hn0 : n r = 0
+    · simp only [hn0, Nat.cast_zero, Real.log_zero, zero_div]
+      exact add_nonneg (div_nonneg (Real.log_nonneg hC) hlr.le) hk
+    · have hnpos : (0 : ℝ) < n r := by exact_mod_cast Nat.pos_of_ne_zero hn0
+      calc
+        Real.log (n r) / Real.log r ≤ Real.log (C * r ^ k) / Real.log r :=
+          div_le_div_of_nonneg_right (Real.log_le_log hnpos hnr) hlr.le
+        _ = Real.log C / Real.log r + k := by
+          rw [Real.log_mul hCpos.ne' (Real.rpow_pos_of_pos hrpos k).ne',
+            Real.log_rpow hrpos, add_div, mul_div_cancel_right₀ _ hlr.ne']
+  have hlow : ∀ᶠ r in atTop, 0 ≤ Real.log (n r) / Real.log r := by
+    filter_upwards [eventually_gt_atTop (1 : ℝ)] with r hr
+    exact div_nonneg (Real.log_natCast_nonneg _) (Real.log_pos hr).le
+  have hco := isCoboundedUnder_le_of_eventually_le atTop hlow
+  have ht : Tendsto (fun r : ℝ ↦ Real.log C / Real.log r + k) atTop (𝓝 k) := by
+    have ht0 : Tendsto (fun r : ℝ ↦ Real.log C / Real.log r) atTop (𝓝 0) :=
+      tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
+    simpa using ht0.add_const k
+  apply le_of_forall_gt_imp_ge_of_dense
+  intro b hb
+  apply Filter.limsup_le_of_le hco
+  filter_upwards [hu, ht.eventually_lt_const hb] with r hur hr
+  exact hur.trans hr.le
+
+/-- Rudin 15.20(3)–(4): an eventual exponential bound for the maximum modulus
+controls the upper logarithmic growth rate of the zero count. -/
+theorem zero_count_growth_limsup {f : ℂ → ℂ} (hf : Differentiable ℂ f) (hf0 : f 0 = 1)
+    {A k : ℝ} (hA : 0 < A) (hk : 0 < k)
+    (hgrowth : ∀ᶠ r in atTop, maximumModulus f r ≤ Real.exp (A * r ^ k)) :
+    Filter.limsup (fun r : ℝ ↦ Real.log (entireZeroCount f r) / Real.log r) atTop ≤ k := by
+  let C : ℝ := A * (2 : ℝ) ^ k / Real.log 2
+  apply limsup_log_count_le_of_polynomial_bound (C := max 1 C) (le_max_left _ _) hk.le
+  obtain ⟨r₀, hr₀⟩ := eventually_atTop.mp hgrowth
+  filter_upwards [eventually_ge_atTop (max 1 r₀)] with r hr
+  have hr1 : 1 ≤ r := (le_max_left _ _).trans hr
+  have hrpos : 0 < r := zero_lt_one.trans_le hr1
+  have h2r : 0 < 2 * r := mul_pos (by norm_num) hrpos
+  have h₂ : maximumModulus f (2 * r) ≤ Real.exp (A * (2 * r) ^ k) :=
+    hr₀ (2 * r) (by have := (le_max_right 1 r₀).trans hr; linarith)
+  have hlog : Real.log (maximumModulus f (2 * r)) ≤ A * (2 * r) ^ k := by
+    simpa only [Real.log_exp] using Real.log_le_log
+      (zero_lt_one.trans_le (one_le_maximumModulus hf hf0 h2r)) h₂
+  have hn := (zero_count_log_two_le hf hf0 hrpos).trans hlog
+  have hln2 : 0 < Real.log 2 := Real.log_pos (by norm_num)
+  calc
+    (entireZeroCount f r : ℝ) ≤ A * (2 * r) ^ k / Real.log 2 := (le_div_iff₀ hln2).mpr hn
+    _ = C * r ^ k := by rw [Real.mul_rpow (by norm_num) hrpos.le]; dsimp [C]; ring
+    _ ≤ max 1 C * r ^ k :=
+      mul_le_mul_of_nonneg_right (le_max_right _ _) (Real.rpow_nonneg hrpos.le k)
+
+/-- Remove the order-`k` origin zero of `1 - exp(z^k)` and normalize to value one. -/
+noncomputable def normalizedSharpnessExample (k : ℕ) (z : ℂ) : ℂ :=
+  dslope Complex.exp 0 (z ^ k)
+
+theorem normalizedSharpnessExample_entire (k : ℕ) :
+    Differentiable ℂ (normalizedSharpnessExample k) := by
+  have hd : Differentiable ℂ (dslope Complex.exp 0) := by
+    rw [← differentiableOn_univ]
+    exact (Complex.differentiableOn_dslope (by simp)).mpr Complex.differentiable_exp.differentiableOn
+  exact hd.comp (differentiable_id.pow k)
+
+theorem normalizedSharpnessExample_at_zero {k : ℕ} (hk : 0 < k) :
+    normalizedSharpnessExample k 0 = 1 := by
+  simp [normalizedSharpnessExample, zero_pow hk.ne', Complex.deriv_exp]
+
+theorem sharpnessExample_origin_factor {k : ℕ} (hk : 0 < k) (z : ℂ) :
+    1 - Complex.exp (z ^ k) = -(z ^ k) * normalizedSharpnessExample k z := by
+  by_cases hz : z = 0
+  · simp [hz, zero_pow hk.ne']
+  · rw [normalizedSharpnessExample, dslope_of_ne _ (pow_ne_zero _ hz)]
+    simp only [slope, sub_zero, Complex.exp_zero, smul_eq_mul]
+    field_simp [pow_ne_zero k hz] <;> ring
+
+/-- The unnormalized printed sharpness example has an origin zero of exactly
+order `k`; the normalized example removes precisely this zero. -/
+theorem sharpnessExample_origin_order {k : ℕ} (hk : 0 < k) :
+    analyticOrderAt (fun z : ℂ ↦ 1 - Complex.exp (z ^ k)) 0 = (k : ℕ∞) := by
+  have hg := (normalizedSharpnessExample_entire k).analyticAt 0
+  have hgz : analyticOrderAt (normalizedSharpnessExample k) 0 = 0 :=
+    hg.analyticOrderAt_eq_zero.mpr (by rw [normalizedSharpnessExample_at_zero hk]; norm_num)
+  have heq : (fun z : ℂ ↦ 1 - Complex.exp (z ^ k)) =
+      (-((id : ℂ → ℂ) ^ k)) * normalizedSharpnessExample k := by
+    funext z
+    exact sharpnessExample_origin_factor hk z
+  rw [heq, analyticOrderAt_mul (by fun_prop) hg]
+  simp [analyticOrderAt_neg, analyticOrderAt_pow (analyticAt_id : AnalyticAt ℂ (id : ℂ → ℂ) 0),
+    hgz]
+
+/-- Each zero of a nonzero entire function contributes at least one to its divisor. -/
+theorem one_le_divisor_of_zero {f : ℂ → ℂ} (hf : Differentiable ℂ f) (hf0 : f 0 ≠ 0)
+    {r : ℝ} {z : ℂ} (hz : z ∈ closedBall 0 r) (hfz : f z = 0) :
+    (1 : ℤ) ≤ MeromorphicOn.divisor f (closedBall 0 r) z := by
+  have hA : AnalyticOnNhd ℂ f Set.univ := fun w _ ↦ hf.analyticAt w
+  have hfin : analyticOrderAt f z ≠ ⊤ :=
+    hA.analyticOrderAt_ne_top_of_isPreconnected isPreconnected_univ (mem_univ 0) (mem_univ z)
+      (by rw [(hf.analyticAt 0).analyticOrderAt_eq_zero.mpr hf0]; simp)
+  obtain ⟨m, hm⟩ := ENat.ne_top_iff_exists.mp hfin
+  have hmpos : 0 < m := by
+    have hne := (hf.analyticAt z).analyticOrderAt_ne_zero.mpr hfz
+    rw [← hm] at hne
+    exact Nat.pos_of_ne_zero (by simpa using hne)
+  have hAr : AnalyticOnNhd ℂ f (closedBall 0 r) := fun w _ ↦ hf.analyticAt w
+  rw [hAr.divisor_apply hz, ← hm]
+  simpa using (show (1 : ℤ) ≤ m by exact_mod_cast hmpos)
+
+/-- Any finite collection of distinct zeros gives a lower bound for the count. -/
+theorem finite_distinct_zeros_le_count {f : ℂ → ℂ} (hf : Differentiable ℂ f)
+    (hf0 : f 0 ≠ 0) {r : ℝ} {N : ℕ} (a : Fin N → ℂ) (ha : Function.Injective a)
+    (har : ∀ i, a i ∈ closedBall 0 r) (haz : ∀ i, f (a i) = 0) :
+    N ≤ entireZeroCount f r := by
+  classical
+  let d := MeromorphicOn.divisor f (closedBall 0 r)
+  have hA : AnalyticOnNhd ℂ f (closedBall 0 r) := fun w _ ↦ hf.analyticAt w
+  have hd : d.support.Finite := d.finiteSupport (isCompact_closedBall 0 r)
+  let s : Finset ℂ := Finset.univ.image a
+  have hs : s ⊆ hd.toFinset := by
+    intro z hz
+    obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hz
+    apply hd.mem_toFinset.mpr
+    exact ne_of_gt ((by norm_num : (0 : ℤ) < 1).trans_le
+      (one_le_divisor_of_zero hf hf0 (har i) (haz i)))
+  have hn : (N : ℤ) ≤ ∑ᶠ z, d z := by
+    rw [finsum_eq_finsetSum_of_support_subset d (s := hd.toFinset)
+      (by simp only [Set.Finite.coe_toFinset]; exact subset_rfl)]
+    calc
+      (N : ℤ) = ∑ i : Fin N, (1 : ℤ) := by simp
+      _ ≤ ∑ i : Fin N, d (a i) := Finset.sum_le_sum fun i _ ↦
+        one_le_divisor_of_zero hf hf0 (har i) (haz i)
+      _ = ∑ z ∈ s, d z := (Finset.sum_image (fun i _ j _ h ↦ ha h)).symm
+      _ ≤ ∑ z ∈ hd.toFinset, d z :=
+        Finset.sum_le_sum_of_subset_of_nonneg hs (fun z _ _ ↦ hA.divisor_nonneg z)
+  rw [← entireZeroCount_intCast hf r] at hn
+  exact_mod_cast hn
+
+/-- Select one zero for every positive integer exponential period. -/
+theorem exists_sharpness_zero_sequence {k : ℕ} (hk : 0 < k) :
+    ∃ a : ℕ → ℂ, Function.Injective a ∧
+      (∀ n, normalizedSharpnessExample k (a n) = 0) ∧
+      (∀ n, ‖a n‖ ^ k = 2 * Real.pi * (n + 1 : ℕ)) := by
+  classical
+  letI : NeZero k := ⟨hk.ne'⟩
+  have hex : ∀ n : ℕ, ∃ z : ℂ, z ^ k = (n + 1 : ℕ) * (2 * Real.pi * Complex.I) :=
+    fun n ↦ (Complex.isOpenQuotientMap_pow k).surjective _
+  choose a ha using hex
+  have hperiod : (2 * Real.pi * Complex.I : ℂ) ≠ 0 := by
+    exact mul_ne_zero (mul_ne_zero (by norm_num) (by exact_mod_cast Real.pi_ne_zero)) Complex.I_ne_zero
+  refine ⟨a, ?_, ?_, ?_⟩
+  · intro m n h
+    have hp : ((m + 1 : ℕ) : ℂ) = (n + 1 : ℕ) :=
+      mul_right_cancel₀ hperiod (by rw [← ha m, ← ha n, h])
+    exact Nat.add_right_cancel (by exact_mod_cast hp)
+  · intro n
+    have hne : a n ^ k ≠ 0 := by
+      rw [ha n]
+      exact mul_ne_zero (by exact_mod_cast Nat.add_one_ne_zero n) hperiod
+    rw [normalizedSharpnessExample, dslope_of_ne _ hne]
+    simp [slope, ha n, Complex.exp_nat_mul_two_pi_mul_I]
+  · intro n
+    have h := congrArg norm (ha n)
+    simpa only [norm_pow, norm_mul, Complex.norm_natCast, Complex.norm_I, mul_one,
+      Complex.norm_ofNat, Complex.norm_real, Real.norm_eq_abs, abs_of_pos Real.pi_pos,
+      mul_comm] using h
+
+/-- A quantitative lower count sufficient for sharpness, retaining the origin normalization. -/
+theorem sharpness_zero_count_floor_le {k : ℕ} (hk : 0 < k) {r : ℝ} (hr : 0 ≤ r) :
+    ⌊r ^ k / (2 * Real.pi)⌋₊ ≤ entireZeroCount (normalizedSharpnessExample k) r := by
+  obtain ⟨a, ha, haz, hanorm⟩ := exists_sharpness_zero_sequence hk
+  let N := ⌊r ^ k / (2 * Real.pi)⌋₊
+  apply finite_distinct_zeros_le_count (normalizedSharpnessExample_entire k)
+    (by rw [normalizedSharpnessExample_at_zero hk]; norm_num)
+    (fun i : Fin N ↦ a i) (ha.comp Fin.val_injective) _ (fun i ↦ haz i)
+  intro i
+  simp only [mem_closedBall, dist_zero_right]
+  apply (pow_le_pow_iff_left₀ (norm_nonneg _) hr hk.ne').mp
+  rw [hanorm]
+  have hi : ((i.val + 1 : ℕ) : ℝ) ≤ N := by exact_mod_cast i.isLt
+  have hN : (N : ℝ) ≤ r ^ k / (2 * Real.pi) :=
+    Nat.floor_le (div_nonneg (pow_nonneg hr _) (by positivity))
+  have h := (le_div_iff₀ (by positivity : 0 < 2 * Real.pi)).mp (hi.trans hN)
+  simpa only [mul_comm] using h
+
+theorem norm_normalizedSharpnessExample_le (k : ℕ) (z : ℂ) :
+    ‖normalizedSharpnessExample k z‖ ≤ Real.exp (‖z‖ ^ k) := by
+  by_cases hz : z ^ k = 0
+  · simp only [normalizedSharpnessExample, hz, dslope_same, Complex.deriv_exp,
+      Complex.exp_zero, norm_one]
+    exact Real.one_le_exp (pow_nonneg (norm_nonneg _) _)
+  · have h : ‖Complex.exp (z ^ k) - 1‖ ≤ ‖z ^ k‖ * Real.exp ‖z ^ k‖ := by
+      simpa using Complex.norm_exp_sub_sum_le_norm_mul_exp (z ^ k) 1
+    rw [normalizedSharpnessExample, dslope_of_ne _ hz]
+    simp only [slope, sub_zero, Complex.exp_zero, smul_eq_mul, norm_mul, norm_inv]
+    calc
+      ‖z ^ k‖⁻¹ * ‖Complex.exp (z ^ k) - 1‖ ≤
+          ‖z ^ k‖⁻¹ * (‖z ^ k‖ * Real.exp ‖z ^ k‖) :=
+        mul_le_mul_of_nonneg_left h (inv_nonneg.mpr (norm_nonneg _))
+      _ = Real.exp (‖z‖ ^ k) := by rw [← mul_assoc, inv_mul_cancel₀ (norm_ne_zero_iff.mpr hz), one_mul, norm_pow]
+
+theorem maximumModulus_normalizedSharpnessExample_le (k : ℕ) {r : ℝ} (hr : 0 ≤ r) :
+    maximumModulus (normalizedSharpnessExample k) r ≤ Real.exp (r ^ k) := by
+  apply csSup_le
+  · refine ⟨‖normalizedSharpnessExample k (r : ℂ)‖, (r : ℂ), ?_, rfl⟩
+    simp [mem_sphere, dist_zero_right, abs_of_nonneg hr]
+  · rintro x ⟨z, hz, rfl⟩
+    have hnorm : ‖z‖ = r := by simpa only [mem_sphere, dist_zero_right] using hz
+    simpa only [hnorm] using norm_normalizedSharpnessExample_le k z
+
+/-- The unnormalized printed example obeys the required exponential growth bound. -/
+theorem maximumModulus_sharpnessExample_le {k : ℕ} (hk : 0 < k) {r : ℝ} (hr : 0 ≤ r) :
+    maximumModulus (fun z : ℂ ↦ 1 - Complex.exp (z ^ k)) r ≤ Real.exp (2 * r ^ k) := by
+  apply csSup_le
+  · refine ⟨‖1 - Complex.exp ((r : ℂ) ^ k)‖, (r : ℂ), ?_, rfl⟩
+    simp [mem_sphere, dist_zero_right, abs_of_nonneg hr]
+  · rintro x ⟨z, hz, rfl⟩
+    have hnorm : ‖z‖ = r := by simpa only [mem_sphere, dist_zero_right] using hz
+    rw [sharpnessExample_origin_factor hk, norm_mul, norm_neg, norm_pow, hnorm]
+    have hg := norm_normalizedSharpnessExample_le k z
+    rw [hnorm] at hg
+    calc
+      r ^ k * ‖normalizedSharpnessExample k z‖ ≤ r ^ k * Real.exp (r ^ k) :=
+        mul_le_mul_of_nonneg_left hg (pow_nonneg hr _)
+      _ ≤ Real.exp (r ^ k) * Real.exp (r ^ k) :=
+        mul_le_mul_of_nonneg_right (by linarith [Real.add_one_le_exp (r ^ k)]) (Real.exp_pos _).le
+      _ = Real.exp (2 * r ^ k) := by rw [← Real.exp_add]; congr 1; ring
+
+/-- Polynomial upper and lower bounds give the exact logarithmic growth exponent. -/
+theorem tendsto_log_count_of_polynomial_bounds (n : ℝ → ℕ) (k : ℕ) {c C : ℝ}
+    (hc : 0 < c) (hC : 0 < C)
+    (hb : ∀ᶠ r in atTop, c * r ^ k ≤ n r ∧ (n r : ℝ) ≤ C * r ^ k) :
+    Tendsto (fun r : ℝ ↦ Real.log (n r) / Real.log r) atTop (𝓝 (k : ℝ)) := by
+  have hlim (b : ℝ) : Tendsto (fun r : ℝ ↦ Real.log b / Real.log r + k)
+      atTop (𝓝 (k : ℝ)) := by
+    have hzero : Tendsto (fun r : ℝ ↦ Real.log b / Real.log r) atTop (𝓝 0) :=
+      tendsto_const_nhds.div_atTop Real.tendsto_log_atTop
+    simpa using hzero.add_const (k : ℝ)
+  have heq (b : ℝ) (hb : 0 < b) {r : ℝ} (hr : 1 < r) :
+      Real.log (b * r ^ k) / Real.log r = Real.log b / Real.log r + k := by
+    rw [Real.log_mul hb.ne' (pow_pos (zero_lt_one.trans hr) k).ne', Real.log_pow,
+      add_div, mul_div_cancel_right₀ _ (Real.log_pos hr).ne']
+  apply tendsto_of_tendsto_of_tendsto_of_le_of_le' (hlim c) (hlim C)
+  · filter_upwards [hb, eventually_gt_atTop (1 : ℝ)] with r hrb hr
+    rw [← heq c hc hr]
+    exact div_le_div_of_nonneg_right
+      (Real.log_le_log (mul_pos hc (pow_pos (zero_lt_one.trans hr) k)) hrb.1)
+      (Real.log_pos hr).le
+  · filter_upwards [hb, eventually_gt_atTop (1 : ℝ)] with r hrb hr
+    rw [← heq C hC hr]
+    exact div_le_div_of_nonneg_right
+      (Real.log_le_log ((mul_pos hc (pow_pos (zero_lt_one.trans hr) k)).trans_le hrb.1) hrb.2)
+      (Real.log_pos hr).le
+
+/-- Matching polynomial bounds for the normalized example's zero count. -/
+theorem normalizedSharpnessExample_polynomial_zero_bounds {k : ℕ} (hk : 0 < k) :
+    ∃ c C : ℝ, 0 < c ∧ 0 < C ∧ ∀ᶠ r in atTop,
+      c * r ^ k ≤ entireZeroCount (normalizedSharpnessExample k) r ∧
+      (entireZeroCount (normalizedSharpnessExample k) r : ℝ) ≤ C * r ^ k := by
+  let c : ℝ := 1 / (4 * Real.pi)
+  let C : ℝ := (2 : ℝ) ^ k / Real.log 2
+  have hc : 0 < c := by dsimp [c]; positivity
+  have hC : 0 < C := div_pos (pow_pos (by norm_num) _) (Real.log_pos (by norm_num))
+  refine ⟨c, C, hc, hC, ?_⟩
+  filter_upwards [eventually_ge_atTop (max 1 (4 * Real.pi))] with r hr
+  have hr1 : 1 ≤ r := (le_max_left _ _).trans hr
+  have hrpos : 0 < r := zero_lt_one.trans_le hr1
+  have hrpow : 4 * Real.pi ≤ r ^ k :=
+    ((le_max_right _ _).trans hr).trans (le_self_pow₀ hr1 hk.ne')
+  constructor
+  · have hf := Nat.lt_floor_add_one (r ^ k / (2 * Real.pi))
+    have hl := sharpness_zero_count_floor_le hk hrpos.le
+    have hl' : (⌊r ^ k / (2 * Real.pi)⌋₊ : ℝ) ≤
+        entireZeroCount (normalizedSharpnessExample k) r := by exact_mod_cast hl
+    have hunit : 1 ≤ r ^ k / (4 * Real.pi) :=
+      (le_div_iff₀ (by positivity : 0 < 4 * Real.pi)).mpr (by simpa using hrpow)
+    have heq : r ^ k / (2 * Real.pi) = 2 * (r ^ k / (4 * Real.pi)) := by
+      field_simp
+      <;> ring
+    rw [heq] at hf
+    dsimp [c]
+    rw [one_div_mul_eq_div]
+    linarith
+  · have hbound := zero_count_log_two_le (normalizedSharpnessExample_entire k)
+      (normalizedSharpnessExample_at_zero hk) hrpos
+    have hm := maximumModulus_normalizedSharpnessExample_le k (mul_nonneg (by norm_num) hrpos.le)
+    have hMpos := zero_lt_one.trans_le (one_le_maximumModulus
+      (normalizedSharpnessExample_entire k) (normalizedSharpnessExample_at_zero hk)
+      (mul_pos (by norm_num) hrpos))
+    have hlog := Real.log_le_log hMpos hm
+    rw [Real.log_exp, mul_pow] at hlog
+    have h := (le_div_iff₀ (Real.log_pos (by norm_num : (1 : ℝ) < 2))).mpr (hbound.trans hlog)
+    simpa only [C, div_mul_eq_mul_div] using h
+
+/-- The normalized printed example attains the exponent in 15.20. -/
+theorem normalizedSharpnessExample_zero_count_limit {k : ℕ} (hk : 0 < k) :
+    Tendsto (fun r : ℝ ↦ Real.log (entireZeroCount (normalizedSharpnessExample k) r) /
+      Real.log r) atTop (𝓝 (k : ℝ)) := by
+  obtain ⟨c, C, hc, hC, hb⟩ := normalizedSharpnessExample_polynomial_zero_bounds hk
+  exact tendsto_log_count_of_polynomial_bounds _ k hc hC hb
+
+/-- Normalization removes exactly the `k` zeros at the origin from every closed disc. -/
+theorem sharpnessExample_zero_count_eq {k : ℕ} (hk : 0 < k) {r : ℝ} (hr : 0 ≤ r) :
+    entireZeroCount (fun z : ℂ ↦ 1 - Complex.exp (z ^ k)) r =
+      k + entireZeroCount (normalizedSharpnessExample k) r := by
+  classical
+  let f : ℂ → ℂ := fun z ↦ 1 - Complex.exp (z ^ k)
+  let g := normalizedSharpnessExample k
+  have hf : Differentiable ℂ f := by dsimp [f]; fun_prop
+  have hg : Differentiable ℂ g := normalizedSharpnessExample_entire k
+  have hAf : AnalyticOnNhd ℂ f (closedBall 0 r) := fun z _ ↦ hf.analyticAt z
+  have hAg : AnalyticOnNhd ℂ g (closedBall 0 r) := fun z _ ↦ hg.analyticAt z
+  have heq : f = (-((id : ℂ → ℂ) ^ k)) * g := by
+    funext z
+    exact sharpnessExample_origin_factor hk z
+  have hord (z : ℂ) (hz : z ≠ 0) : analyticOrderAt f z = analyticOrderAt g z := by
+    rw [heq, analyticOrderAt_mul (by fun_prop) (hg.analyticAt z)]
+    have hP : AnalyticAt ℂ (-((id : ℂ → ℂ) ^ k)) z := by fun_prop
+    rw [hP.analyticOrderAt_eq_zero.mpr (by simpa using pow_ne_zero k hz), zero_add]
+  let e : ℂ → ℤ := fun z ↦ if z = 0 then k else 0
+  have hd (z : ℂ) : MeromorphicOn.divisor f (closedBall 0 r) z =
+      e z + MeromorphicOn.divisor g (closedBall 0 r) z := by
+    by_cases hz : z = 0
+    · subst z
+      have h0 : (0 : ℂ) ∈ closedBall 0 r := by simpa using hr
+      rw [hAf.divisor_apply h0, hAg.divisor_apply h0]
+      have hgz : analyticOrderAt g 0 = 0 := (hg.analyticAt 0).analyticOrderAt_eq_zero.mpr
+        (by dsimp [g]; rw [normalizedSharpnessExample_at_zero hk]; norm_num)
+      simp [f, e, sharpnessExample_origin_order hk, hgz]
+    · by_cases hzr : z ∈ closedBall 0 r
+      · rw [hAf.divisor_apply hzr, hAg.divisor_apply hzr, hord z hz]
+        simp [e, hz]
+      · simp [Function.locallyFinsuppWithin.apply_eq_zero_of_notMem _ hzr, e, hz]
+  have hefin : e.support.Finite := by
+    apply (Set.finite_singleton (0 : ℂ)).subset
+    intro z hz
+    by_contra hz0
+    exact hz (by simp [e, hz0])
+  have he : (∑ᶠ z, e z) = k := by
+    rw [finsum_eq_single e 0 (by intro z hz; simp [e, hz])]
+    simp [e]
+  have hs : (∑ᶠ z, MeromorphicOn.divisor f (closedBall 0 r) z) =
+      (k : ℤ) + ∑ᶠ z, MeromorphicOn.divisor g (closedBall 0 r) z := by
+    simp_rw [hd]
+    rw [finsum_add_distrib hefin
+      ((MeromorphicOn.divisor g (closedBall 0 r)).finiteSupport (isCompact_closedBall 0 r)), he]
+  rw [← entireZeroCount_intCast hf r, ← entireZeroCount_intCast hg r] at hs
+  exact_mod_cast hs
+
+/-- Rudin's printed example `1 - exp(z^k)` has exactly the asserted limiting exponent. -/
+theorem sharpnessExample_zero_count_limit {k : ℕ} (hk : 0 < k) :
+    Tendsto (fun r : ℝ ↦
+      Real.log (entireZeroCount (fun z : ℂ ↦ 1 - Complex.exp (z ^ k)) r) / Real.log r)
+      atTop (𝓝 (k : ℝ)) := by
+  obtain ⟨c, C, hc, hC, hb⟩ := normalizedSharpnessExample_polynomial_zero_bounds hk
+  apply tendsto_log_count_of_polynomial_bounds _ k hc
+    (show 0 < C + k from add_pos_of_pos_of_nonneg hC (Nat.cast_nonneg k))
+  filter_upwards [hb, eventually_ge_atTop (1 : ℝ)] with r hrb hr
+  have hr0 : 0 ≤ r := zero_le_one.trans hr
+  rw [sharpnessExample_zero_count_eq hk hr0, Nat.cast_add]
+  constructor
+  · exact hrb.1.trans (le_add_of_nonneg_left (Nat.cast_nonneg k))
+  · calc
+      (k : ℝ) + entireZeroCount (normalizedSharpnessExample k) r ≤ k * r ^ k + C * r ^ k :=
+        add_le_add (le_mul_of_one_le_right (Nat.cast_nonneg k) (one_le_pow₀ hr)) hrb.2
+      _ = (C + k) * r ^ k := by ring
+
+#print axioms norm_le_maximumModulus
+#print axioms one_le_maximumModulus
+#print axioms entireZeroCount_intCast
+#print axioms zero_count_log_two_le
+#print axioms limsup_log_count_le_of_polynomial_bound
+#print axioms zero_count_growth_limsup
+#print axioms normalizedSharpnessExample_entire
+#print axioms normalizedSharpnessExample_at_zero
+#print axioms sharpnessExample_origin_factor
+#print axioms sharpnessExample_origin_order
+#print axioms one_le_divisor_of_zero
+#print axioms finite_distinct_zeros_le_count
+#print axioms exists_sharpness_zero_sequence
+#print axioms sharpness_zero_count_floor_le
+#print axioms norm_normalizedSharpnessExample_le
+#print axioms maximumModulus_normalizedSharpnessExample_le
+#print axioms maximumModulus_sharpnessExample_le
+#print axioms tendsto_log_count_of_polynomial_bounds
+#print axioms normalizedSharpnessExample_polynomial_zero_bounds
+#print axioms normalizedSharpnessExample_zero_count_limit
+#print axioms sharpnessExample_zero_count_eq
+#print axioms sharpnessExample_zero_count_limit
+
+end RudinRCA.Chapter15.ZeroGrowthWork
diff --git a/books/rudin-real-and-complex-analysis/LogMeansWork.lean b/books/rudin-real-and-complex-analysis/LogMeansWork.lean
new file mode 100644
index 0000000..397d9a3
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/LogMeansWork.lean
@@ -0,0 +1,666 @@
+import RudinRCA.Chapter15
+import Mathlib.Analysis.Complex.JensenFormula
+import Mathlib.Analysis.SpecialFunctions.Log.PosLog
+import Mathlib.Analysis.SpecialFunctions.Log.ENNRealLogExp
+import Mathlib.MeasureTheory.Integral.Lebesgue.Add
+import Mathlib.MeasureTheory.Integral.Lebesgue.Markov
+import Mathlib.Topology.Instances.EReal.Lemmas
+
+noncomputable section
+open Filter Set MeasureTheory
+open scoped Topology ENNReal
+
+namespace RudinRCA.Chapter15
+
+/-- The extended logarithm used in 15.19; it has value -∞ at zero. -/
+def extendedLogNorm (z : ℂ) : EReal := ENNReal.log (ENNReal.ofReal ‖z‖)
+
+@[simp] theorem extendedLogNorm_zero : extendedLogNorm 0 = ⊥ := by
+  simp [extendedLogNorm]
+
+theorem extendedLogNorm_of_ne_zero {z : ℂ} (hz : z ≠ 0) :
+    extendedLogNorm z = (Real.log ‖z‖ : EReal) :=
+  ENNReal.log_ofReal_of_pos (norm_pos_iff.mpr hz)
+
+theorem continuous_extendedLogNorm : Continuous extendedLogNorm :=
+  ENNReal.continuous_log.comp (ENNReal.continuous_ofReal.comp continuous_norm)
+
+/-- The negative part of the extended logarithm, retaining +∞ at a zero. -/
+def negativeLogNorm (z : ℂ) : ℝ≥0∞ := (-extendedLogNorm z).toENNReal
+
+@[simp] theorem negativeLogNorm_zero : negativeLogNorm 0 = ⊤ := by
+  simp [negativeLogNorm]
+
+theorem continuous_negativeLogNorm : Continuous negativeLogNorm :=
+  EReal.continuous_toENNReal.comp continuous_extendedLogNorm.neg
+
+/-- For positive radii, isolated zeros have angular measure zero. Thus the real
+integral used here agrees with the extended-log convention once integrability
+and the negligible-zero-set bridge have been established. -/
+def logCircleMean (f : ℂ → ℂ) (r : ℝ) : ℝ :=
+  Real.circleAverage (fun z ↦ Real.log ‖f z‖) 0 r
+
+/-- Jensen's sum on a single fixed larger disk, with positive logarithms.
+This form makes monotonicity in the smaller radius explicit. -/
+theorem logCircleMean_eq_posLog_divisor_sum {f : ℂ → ℂ} {r s : ℝ}
+    (hr : 0 < r) (hrs : r ≤ s)
+    (hf : AnalyticOnNhd ℂ f (Metric.closedBall 0 s)) (h0 : f 0 ≠ 0) :
+    logCircleMean f r =
+      (∑ᶠ z, (MeromorphicOn.divisor f (Metric.closedBall 0 s) z : ℝ) *
+        Real.posLog (r / ‖z‖)) + Real.log ‖f 0‖ := by
+  have hfr : AnalyticOnNhd ℂ f (Metric.closedBall 0 r) :=
+    hf.mono (Metric.closedBall_subset_closedBall hrs)
+  have hfr' : AnalyticOnNhd ℂ f (Metric.closedBall 0 |r|) := by
+    simpa only [abs_of_pos hr] using hfr
+  have hj := hfr'.circleAverage_log_norm hr.ne' h0
+  rw [abs_of_pos hr] at hj
+  change logCircleMean f r = _ at hj
+  rw [hj]
+  congr 1
+  apply finsum_congr
+  intro z
+  by_cases hz0 : z = 0
+  · subst z
+    have hd0 (t : ℝ) (ht : 0 ≤ t) (hft : AnalyticOnNhd ℂ f (Metric.closedBall 0 t)) :
+        MeromorphicOn.divisor f (Metric.closedBall 0 t) 0 = 0 := by
+      rw [hft.divisor_apply (Metric.mem_closedBall_self ht),
+        (hft 0 (Metric.mem_closedBall_self ht)).analyticOrderAt_eq_zero.mpr h0]
+      simp
+    simp [hd0 r hr.le hfr, hd0 s (hr.le.trans hrs) hf]
+  · have hzn : 0 < ‖z‖ := norm_pos_iff.mpr hz0
+    by_cases hzr : ‖z‖ ≤ r
+    · have hzr' : z ∈ Metric.closedBall (0 : ℂ) r := by simpa using hzr
+      have hzs' : z ∈ Metric.closedBall (0 : ℂ) s := by simpa using hzr.trans hrs
+      have hlog : Real.posLog (r / ‖z‖) = Real.log (r / ‖z‖) := by
+        apply Real.posLog_eq_log
+        rw [abs_of_nonneg (div_nonneg hr.le hzn.le)]
+        exact (le_div_iff₀ hzn).2 (by simpa using hzr)
+      rw [hfr.meromorphicOn.divisor_apply hzr', hf.meromorphicOn.divisor_apply hzs', hlog]
+      simp [div_eq_mul_inv]
+    · have hzr' : z ∉ Metric.closedBall (0 : ℂ) r := by simpa using hzr
+      have hd0 : MeromorphicOn.divisor f (Metric.closedBall 0 r) z = 0 := by
+        by_contra hn
+        exact hzr' ((MeromorphicOn.divisor f (Metric.closedBall 0 r)).supportWithinDomain hn)
+      have hlog : Real.posLog (r / ‖z‖) = 0 := by
+        apply (Real.posLog_eq_zero_iff _).2
+        rw [abs_of_nonneg (div_nonneg hr.le hzn.le)]
+        exact (div_le_one hzn).2 (le_of_lt (lt_of_not_ge hzr))
+      simp [hd0, hlog]
+
+/-- Monotonicity in 15.19 when the center value is nonzero. The general case
+follows by removing the finite-order zero at the origin. -/
+theorem logCircleMean_mono_of_center_ne_zero {f : ℂ → ℂ} {r s : ℝ}
+    (hr : 0 < r) (hrs : r ≤ s)
+    (hf : AnalyticOnNhd ℂ f (Metric.closedBall 0 s)) (h0 : f 0 ≠ 0) :
+    logCircleMean f r ≤ logCircleMean f s := by
+  have hs : 0 < s := hr.trans_le hrs
+  rw [logCircleMean_eq_posLog_divisor_sum hr hrs hf h0,
+    logCircleMean_eq_posLog_divisor_sum hs le_rfl hf h0]
+  apply add_le_add_right
+  have hD : Function.HasFiniteSupport
+      (fun z ↦ (MeromorphicOn.divisor f (Metric.closedBall 0 s) z : ℝ)) := by
+    simpa [Function.HasFiniteSupport, Function.support] using
+      (MeromorphicOn.divisor f (Metric.closedBall 0 s)).finiteSupport (isCompact_closedBall 0 s)
+  apply finsum_le_finsum (hD.mul_left _) (hD.mul_left _)
+  intro z
+  have hm : (0 : ℝ) ≤ MeromorphicOn.divisor f (Metric.closedBall 0 s) z := by
+    exact_mod_cast hf.divisor_nonneg z
+  apply mul_le_mul_of_nonneg_left _ hm
+  apply Real.posLog_le_posLog
+  · have hn : 0 ≤ r / ‖z‖ := div_nonneg hr.le (norm_nonneg z)
+    linarith
+  · exact div_le_div_of_nonneg_right hrs (norm_nonneg z)
+
+/-- The origin correction in Jensen's formula is retained when the center is
+itself a zero. This identity uses a single larger-disk divisor. -/
+theorem logCircleMean_eq_posLog_divisor_sum_general {f : ℂ → ℂ} {r s : ℝ}
+    (hr : 0 < r) (hrs : r ≤ s)
+    (hf : AnalyticOnNhd ℂ f (Metric.closedBall 0 s)) :
+    logCircleMean f r =
+      (∑ᶠ z, (MeromorphicOn.divisor f (Metric.closedBall 0 s) z : ℝ) *
+        Real.posLog (r / ‖z‖)) +
+      (MeromorphicOn.divisor f (Metric.closedBall 0 s) 0 : ℝ) * Real.log r +
+      Real.log ‖meromorphicTrailingCoeffAt f 0‖ := by
+  have hfr : AnalyticOnNhd ℂ f (Metric.closedBall 0 r) :=
+    hf.mono (Metric.closedBall_subset_closedBall hrs)
+  have hfr' : AnalyticOnNhd ℂ f (Metric.closedBall 0 |r|) := by
+    simpa only [abs_of_pos hr] using hfr
+  have hj := hfr'.meromorphicOn.circleAverage_log_norm hr.ne'
+  rw [abs_of_pos hr] at hj
+  change logCircleMean f r = _ at hj
+  rw [hj]
+  have hcenter : MeromorphicOn.divisor f (Metric.closedBall 0 r) 0 =
+      MeromorphicOn.divisor f (Metric.closedBall 0 s) 0 := by
+    rw [hfr.meromorphicOn.divisor_apply (Metric.mem_closedBall_self hr.le),
+      hf.meromorphicOn.divisor_apply (Metric.mem_closedBall_self (hr.le.trans hrs))]
+  rw [hcenter]
+  congr 2
+  apply finsum_congr
+  intro z
+  by_cases hz0 : z = 0
+  · subst z
+    simp
+  · have hzn : 0 < ‖z‖ := norm_pos_iff.mpr hz0
+    by_cases hzr : ‖z‖ ≤ r
+    · have hzr' : z ∈ Metric.closedBall (0 : ℂ) r := by simpa using hzr
+      have hzs' : z ∈ Metric.closedBall (0 : ℂ) s := by simpa using hzr.trans hrs
+      have hlog : Real.posLog (r / ‖z‖) = Real.log (r / ‖z‖) := by
+        apply Real.posLog_eq_log
+        rw [abs_of_nonneg (div_nonneg hr.le hzn.le)]
+        exact (le_div_iff₀ hzn).2 (by simpa using hzr)
+      rw [hfr.meromorphicOn.divisor_apply hzr', hf.meromorphicOn.divisor_apply hzs', hlog]
+      simp [div_eq_mul_inv]
+    · have hzr' : z ∉ Metric.closedBall (0 : ℂ) r := by simpa using hzr
+      have hd0 : MeromorphicOn.divisor f (Metric.closedBall 0 r) z = 0 := by
+        by_contra hn
+        exact hzr' ((MeromorphicOn.divisor f (Metric.closedBall 0 r)).supportWithinDomain hn)
+      have hlog : Real.posLog (r / ‖z‖) = 0 := by
+        apply (Real.posLog_eq_zero_iff _).2
+        rw [abs_of_nonneg (div_nonneg hr.le hzn.le)]
+        exact (div_le_one hzn).2 (le_of_lt (lt_of_not_ge hzr))
+      simp [hd0, hlog]
+
+/-- The monotonicity conclusion of 15.19, including zeros at the center. -/
+theorem logCircleMean_mono {f : ℂ → ℂ} {r s : ℝ}
+    (hr : 0 < r) (hrs : r ≤ s)
+    (hf : AnalyticOnNhd ℂ f (Metric.closedBall 0 s)) :
+    logCircleMean f r ≤ logCircleMean f s := by
+  have hs : 0 < s := hr.trans_le hrs
+  rw [logCircleMean_eq_posLog_divisor_sum_general hr hrs hf,
+    logCircleMean_eq_posLog_divisor_sum_general hs le_rfl hf]
+  apply add_le_add_right
+  apply add_le_add
+  · have hD : Function.HasFiniteSupport
+        (fun z ↦ (MeromorphicOn.divisor f (Metric.closedBall 0 s) z : ℝ)) := by
+      simpa [Function.HasFiniteSupport, Function.support] using
+        (MeromorphicOn.divisor f (Metric.closedBall 0 s)).finiteSupport (isCompact_closedBall 0 s)
+    apply finsum_le_finsum (hD.mul_left _) (hD.mul_left _)
+    intro z
+    have hm : (0 : ℝ) ≤ MeromorphicOn.divisor f (Metric.closedBall 0 s) z := by
+      exact_mod_cast hf.divisor_nonneg z
+    apply mul_le_mul_of_nonneg_left _ hm
+    apply Real.posLog_le_posLog
+    · have hn : 0 ≤ r / ‖z‖ := div_nonneg hr.le (norm_nonneg z)
+      linarith
+    · exact div_le_div_of_nonneg_right hrs (norm_nonneg z)
+  · apply mul_le_mul_of_nonneg_left (Real.log_le_log hr hrs)
+    exact_mod_cast hf.divisor_nonneg 0
+
+/-- The disk version requires no analytic extension across its boundary. -/
+theorem disk_logCircleMean_mono {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1)) {r s : ℝ}
+    (hr : 0 < r) (hrs : r ≤ s) (hs : s < 1) :
+    logCircleMean f r ≤ logCircleMean f s :=
+  logCircleMean_mono hr hrs
+    ((hf.analyticOnNhd Metric.isOpen_ball).mono (Metric.closedBall_subset_ball hs))
+
+/-- Removing the origin zero on the unit disk, without any extension hypothesis
+outside the disk. This is the local-to-global step used in 15.19. -/
+theorem disk_remove_zero_at_origin {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0) :
+    ∃ h : ℂ → ℂ, DifferentiableOn ℂ h (Metric.ball 0 1) ∧ h 0 ≠ 0 ∧
+      ∀ z ∈ Metric.ball 0 1, f z = z ^ analyticOrderNatAt f 0 * h z := by
+  have hfa := hf.analyticOnNhd Metric.isOpen_ball
+  have hfinite : analyticOrderAt f 0 ≠ ⊤ := by
+    apply analyticOrderAt_ne_top_of_component_nonzero Metric.isOpen_ball hf
+    · intro z hz
+      rw [(convex_ball (0 : ℂ) 1).isPreconnected.connectedComponentIn hz]
+      exact hne
+    · exact Metric.mem_ball_self zero_lt_one
+  obtain ⟨g, hga, hg0, heq⟩ :=
+    (hfa 0 (Metric.mem_ball_self zero_lt_one)).analyticOrderAt_ne_top.mp hfinite
+  let k := analyticOrderNatAt f 0
+  let h : ℂ → ℂ := fun z ↦ if z = 0 then g 0 else f z / z ^ k
+  have heq' : f =ᶠ[𝓝 0] fun z ↦ z ^ k * g z := by
+    simpa only [sub_zero, smul_eq_mul] using heq
+  have hnear : h =ᶠ[𝓝 0] g := by
+    filter_upwards [heq'] with z hz
+    by_cases hz0 : z = 0
+    · simp [h, hz0]
+    · simp [h, hz0, hz, mul_div_cancel_left₀, pow_ne_zero _ hz0]
+  have hh : DifferentiableOn ℂ h (Metric.ball 0 1) := by
+    intro z hz
+    apply DifferentiableAt.differentiableWithinAt
+    by_cases hz0 : z = 0
+    · subst z
+      exact (hga.congr hnear.symm).differentiableAt
+    · apply AnalyticAt.differentiableAt
+      apply ((hfa z hz).div (analyticAt_id.pow k) (pow_ne_zero _ hz0)).congr
+      filter_upwards [isOpen_ne.mem_nhds hz0] with w hw
+      simp [h, hw]
+  refine ⟨h, hh, by simpa [h] using hg0, ?_⟩
+  intro z hz
+  by_cases hz0 : z = 0
+  · subst z
+    simpa only [h, if_pos rfl] using heq'.eq_of_nhds
+  · dsimp only [h]
+    rw [if_neg hz0]
+    exact (mul_div_cancel₀ (f z) (pow_ne_zero k hz0)).symm
+
+/-- Near the origin the logarithmic mean has the exact form k log r + C.
+This includes the extended-real limit -∞ when the origin is a zero. -/
+theorem exists_small_radius_logCircleMean_formula {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0) :
+    ∃ k : ℕ, ∃ C R : ℝ, 0 < R ∧ (k = 0 ↔ f 0 ≠ 0) ∧
+      (k = 0 → C = Real.log ‖f 0‖) ∧
+      ∀ r : ℝ, 0 < r → r < R → logCircleMean f r = (k : ℝ) * Real.log r + C := by
+  obtain ⟨h, hh, hh0, heq⟩ := disk_remove_zero_at_origin hf hne
+  let k := analyticOrderNatAt f 0
+  have h0mem : (0 : ℂ) ∈ Metric.ball 0 1 := Metric.mem_ball_self zero_lt_one
+  have hha := hh.analyticOnNhd Metric.isOpen_ball
+  have hzero := (hha 0 h0mem).continuousAt.eventually_ne hh0
+  obtain ⟨ε, hε, hεzero⟩ := Metric.eventually_nhds_iff.mp hzero
+  let R := min ε 1
+  have hR : 0 < R := lt_min hε zero_lt_one
+  have hk : k = 0 ↔ f 0 ≠ 0 := by
+    constructor
+    · intro hk
+      have hz := heq 0 h0mem
+      have hz' : f 0 = h 0 := by
+        simpa only [← show analyticOrderNatAt f 0 = k from rfl, hk, pow_zero, one_mul] using hz
+      exact hz'.trans_ne hh0
+    · intro hfn
+      have hz : analyticOrderAt f 0 = 0 :=
+        ((hf.analyticOnNhd Metric.isOpen_ball) 0 h0mem).analyticOrderAt_eq_zero.mpr hfn
+      simp only [k, analyticOrderNatAt, hz, ENat.toNat_zero]
+  refine ⟨k, Real.log ‖h 0‖, R, hR, hk, ?_, ?_⟩
+  · intro hk0
+    have hz := heq 0 h0mem
+    have hz' : f 0 = h 0 := by simpa only [← show analyticOrderNatAt f 0 = k from rfl,
+      hk0, pow_zero, one_mul] using hz
+    rw [hz']
+  · intro r hr hrR
+    have hr1 : r < 1 := hrR.trans_le (min_le_right _ _)
+    have hrε : r < ε := hrR.trans_le (min_le_left _ _)
+    have hclosed : Metric.closedBall (0 : ℂ) |r| ⊆ Metric.ball 0 1 := by
+      exact Metric.closedBall_subset_ball (by simpa only [abs_of_pos hr] using hr1)
+    have hhclosed := hha.mono hclosed
+    have hhz : ∀ z ∈ Metric.closedBall (0 : ℂ) |r|, h z ≠ 0 := by
+      intro z hz
+      apply hεzero
+      have hzn : ‖z‖ ≤ r := by simpa only [Metric.mem_closedBall, dist_zero_right,
+        abs_of_pos hr] using hz
+      simpa only [dist_zero_right] using hzn.trans_lt hrε
+    have hcongr : Set.EqOn (fun z ↦ Real.log ‖f z‖)
+        (fun z ↦ (k : ℝ) * Real.log r + Real.log ‖h z‖)
+        (Metric.sphere 0 |r|) := by
+      intro z hz
+      have hzn : ‖z‖ = r := by simpa only [Metric.mem_sphere, dist_zero_right,
+        abs_of_pos hr] using hz
+      have hzneq : ‖z‖ ≠ 0 := by rw [hzn]; exact hr.ne'
+      rw [heq z (hclosed (Metric.sphere_subset_closedBall hz)), norm_mul, norm_pow,
+        Real.log_mul (pow_ne_zero _ hzneq)
+          (norm_ne_zero_iff.mpr (hhz z (Metric.sphere_subset_closedBall hz))),
+        Real.log_pow, hzn]
+    rw [logCircleMean, Real.circleAverage_congr_sphere hcongr,
+      Real.circleAverage_fun_add (circleIntegrable_const _ _ _)
+        (hhclosed.mono Metric.sphere_subset_closedBall).meromorphicOn.circleIntegrable_log_norm,
+      Real.circleAverage_const, hhclosed.circleAverage_log_norm_of_ne_zero hhz]
+
+/-- The r↓0 conclusion of 15.19, with the printed extended value log 0=-∞. -/
+theorem logCircleMean_tendsto_origin {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0) :
+    Tendsto (fun r : ℝ ↦ (logCircleMean f r : EReal)) (𝓝[>] 0)
+      (𝓝 (extendedLogNorm (f 0))) := by
+  obtain ⟨k, C, R, hR, hk, hC, heq⟩ := exists_small_radius_logCircleMean_formula hf hne
+  have hevent : (fun r : ℝ ↦ (logCircleMean f r : EReal)) =ᶠ[𝓝[>] 0]
+      (fun r ↦ ((k : ℝ) * Real.log r + C : EReal)) := by
+    filter_upwards [self_mem_nhdsWithin,
+      (nhdsWithin_le_nhds (Iio_mem_nhds hR) : ∀ᶠ r : ℝ in 𝓝[>] 0, r < R)] with r hr hrR
+    exact congrArg (fun x : ℝ ↦ (x : EReal)) (heq r hr hrR)
+  by_cases h0 : f 0 = 0
+  · have hk0 : k ≠ 0 := fun h ↦ (hk.mp h) h0
+    have hkpos : (0 : ℝ) < k := by exact_mod_cast Nat.pos_of_ne_zero hk0
+    have ht : Tendsto (fun r : ℝ ↦ (k : ℝ) * Real.log r + C) (𝓝[>] 0) atBot :=
+      tendsto_atBot_add_const_right _ C (Real.tendsto_log_nhdsGT_zero.const_mul_atBot hkpos)
+    rw [h0, extendedLogNorm_zero]
+    exact (EReal.tendsto_coe_atBot.comp ht).congr' hevent.symm
+  · have hk0 := hk.mpr h0
+    have hconst : Tendsto (fun r : ℝ ↦ ((k : ℝ) * Real.log r + C : EReal))
+        (𝓝[>] 0) (𝓝 (extendedLogNorm (f 0))) := by
+      simpa only [hk0, Nat.cast_zero, zero_mul, zero_add, hC hk0,
+        extendedLogNorm_of_ne_zero h0] using
+        (tendsto_const_nhds : Tendsto (fun _ : ℝ ↦ (Real.log ‖f 0‖ : EReal))
+          (𝓝[>] 0) (𝓝 (Real.log ‖f 0‖ : EReal)))
+    exact hconst.congr' hevent.symm
+
+/-- The nonzero points form a codiscrete set on the disk. -/
+theorem disk_codiscrete_nonzero {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0) :
+    ∀ᶠ z in codiscreteWithin (Metric.ball (0 : ℂ) 1), f z ≠ 0 := by
+  rcases (hf.analyticOnNhd Metric.isOpen_ball).
+    eqOn_zero_or_eventually_ne_zero_of_preconnected
+      (convex_ball (0 : ℂ) 1).isPreconnected with hz | hn
+  · obtain ⟨w, hw, hfw⟩ := hne
+    exact False.elim (hfw (hz hw))
+  · exact hn
+
+/-- Isolated interior zeros meet each circle in an angular null set. -/
+theorem disk_angular_ae_nonzero {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0) {r : ℝ}
+    (hr : 0 < r) (hr1 : r < 1) :
+    ∀ᵐ θ : ℝ, f (circleMap 0 r θ) ≠ 0 := by
+  have hcod : ∀ᶠ z in codiscreteWithin (Metric.ball (0 : ℂ) 1), f z ≠ 0 := by
+    rcases (hf.analyticOnNhd Metric.isOpen_ball).
+      eqOn_zero_or_eventually_ne_zero_of_preconnected
+        (convex_ball (0 : ℂ) 1).isPreconnected with hz | hn
+    · obtain ⟨w, hw, hfw⟩ := hne
+      exact False.elim (hfw (hz hw))
+    · exact hn
+  have hsub : Metric.sphere (0 : ℂ) |r| ⊆ Metric.ball 0 1 :=
+    Metric.sphere_subset_ball (by simpa only [abs_of_pos hr] using hr1)
+  have hθ := circleMap_preimage_codiscrete hr.ne'
+    (codiscreteWithin_mono hsub hcod)
+  have hae : ae (volume : Measure ℝ) ≤ codiscrete ℝ := by
+    simpa using (ae_restrict_le_codiscreteWithin
+      (μ := (volume : Measure ℝ)) measurableSet_univ)
+  exact hae hθ
+
+/-- The real logarithm agrees almost everywhere with the printed extended-log
+convention on every positive circle inside the disk. -/
+theorem disk_angular_extendedLogNorm_eq {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0) {r : ℝ}
+    (hr : 0 < r) (hr1 : r < 1) :
+    ∀ᵐ θ : ℝ, extendedLogNorm (f (circleMap 0 r θ)) =
+      (Real.log ‖f (circleMap 0 r θ)‖ : EReal) :=
+  (disk_angular_ae_nonzero hf hne hr hr1).mono
+    (fun _ hθ ↦ extendedLogNorm_of_ne_zero hθ)
+
+theorem negativeLogNorm_of_ne_zero {z : ℂ} (hz : z ≠ 0) :
+    negativeLogNorm z = ENNReal.ofReal (-Real.log ‖z‖) := by
+  rw [negativeLogNorm, extendedLogNorm_of_ne_zero hz, ← EReal.coe_neg,
+    EReal.real_coe_toENNReal]
+
+/-- Unnormalized angular measure; the factor `2π` is explicit in mean identities. -/
+def angularMeasure : Measure ℝ := volume.restrict (Ioc 0 (2 * Real.pi))
+
+/-- Exact conversion between the nonnegative extended integral and the usual
+circle mean, under the harmless normalization `|f| ≤ 1`. -/
+theorem negativeLogNorm_angular_integral_eq {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0)
+    (hbound : ∀ z ∈ Metric.ball 0 1, ‖f z‖ ≤ 1) {r : ℝ}
+    (hr : 0 < r) (hr1 : r < 1) :
+    (∫⁻ θ, negativeLogNorm (f (circleMap 0 r θ)) ∂angularMeasure) =
+      ENNReal.ofReal (-(2 * Real.pi) * logCircleMean f r) := by
+  have hs : Metric.sphere (0 : ℂ) |r| ⊆ Metric.ball 0 1 :=
+    Metric.sphere_subset_ball (by simpa only [abs_of_pos hr] using hr1)
+  have hi : CircleIntegrable (fun z ↦ Real.log ‖f z‖) 0 r :=
+    ((hf.analyticOnNhd Metric.isOpen_ball).mono hs).meromorphicOn.circleIntegrable_log_norm
+  have hi' : Integrable (fun θ ↦ Real.log ‖f (circleMap 0 r θ)‖) angularMeasure :=
+    (intervalIntegrable_iff_integrableOn_Ioc_of_le (by positivity : 0 ≤ 2 * Real.pi)).1 hi
+  have hn : ∀ᵐ θ ∂angularMeasure, 0 ≤ -Real.log ‖f (circleMap 0 r θ)‖ := by
+    apply ae_of_all
+    intro θ
+    apply neg_nonneg.mpr
+    exact Real.log_nonpos (norm_nonneg _) (hbound _ (hs (circleMap_mem_sphere' _ _ _)))
+  have heq : (fun θ ↦ negativeLogNorm (f (circleMap 0 r θ))) =ᵐ[angularMeasure]
+      (fun θ ↦ ENNReal.ofReal (-Real.log ‖f (circleMap 0 r θ)‖)) := by
+    have hzero := ae_restrict_of_ae (disk_angular_ae_nonzero hf hne hr hr1)
+    exact hzero.mono fun _ hz ↦ negativeLogNorm_of_ne_zero hz
+  rw [lintegral_congr_ae heq, ← ofReal_integral_eq_lintegral_ofReal hi'.neg hn]
+  congr 1
+  rw [integral_neg]
+  simp only [logCircleMean, Real.circleAverage, smul_eq_mul,
+    intervalIntegral.integral_of_le (by positivity : 0 ≤ 2 * Real.pi), angularMeasure]
+  field_simp
+
+/-- Fatou's step in 15.19, stated independently of the existence theorem for
+radial boundary values. The extended negative logarithm detects boundary zeros. -/
+theorem negativeLogNorm_fatou {α : Type*} [MeasurableSpace α] {μ : Measure α}
+    {f : ℕ → α → ℂ} {g : α → ℂ}
+    (hmeas : ∀ n, AEMeasurable (f n) μ)
+    (hlim : ∀ᵐ x ∂μ, Tendsto (fun n ↦ f n x) atTop (𝓝 (g x))) :
+    (∫⁻ x, negativeLogNorm (g x) ∂μ) ≤
+      liminf (fun n ↦ ∫⁻ x, negativeLogNorm (f n x) ∂μ) atTop := by
+  have h := lintegral_liminf_le'
+    (fun n ↦ continuous_negativeLogNorm.measurable.comp_aemeasurable (hmeas n))
+  have heq : (fun x ↦ liminf (fun n ↦ negativeLogNorm (f n x)) atTop) =ᵐ[μ]
+      (fun x ↦ negativeLogNorm (g x)) := by
+    filter_upwards [hlim] with x hx
+    exact (continuous_negativeLogNorm.continuousAt.tendsto.comp hx).liminf_eq
+  rwa [lintegral_congr_ae heq] at h
+
+/-- A finite integral of the extended negative logarithm rules out zeros on any
+set of positive measure, as required for the final assertion of 15.19. -/
+theorem ae_nonzero_of_negativeLogNorm_integral_finite {α : Type*}
+    [MeasurableSpace α] {μ : Measure α} {g : α → ℂ}
+    (hg : AEMeasurable g μ) (hfinite : (∫⁻ x, negativeLogNorm (g x) ∂μ) ≠ ⊤) :
+    ∀ᵐ x ∂μ, g x ≠ 0 := by
+  have hlt := ae_lt_top'
+    (continuous_negativeLogNorm.measurable.comp_aemeasurable hg) hfinite
+  filter_upwards [hlt] with x hx hz
+  simpa only [hz, negativeLogNorm_zero, lt_self_iff_false] using hx
+
+/-- Finite negative-log integral implies ordinary logarithmic integrability
+when the boundary function has norm at most one. -/
+theorem integrable_log_norm_of_negativeLogNorm_finite {α : Type*}
+    [MeasurableSpace α] {μ : Measure α} {g : α → ℂ}
+    (hg : AEMeasurable g μ) (hbound : ∀ᵐ x ∂μ, ‖g x‖ ≤ 1)
+    (hfinite : (∫⁻ x, negativeLogNorm (g x) ∂μ) ≠ ⊤) :
+    Integrable (fun x ↦ Real.log ‖g x‖) μ := by
+  have hmeas := continuous_negativeLogNorm.measurable.comp_aemeasurable hg
+  have hi := integrable_toReal_of_lintegral_ne_top hmeas hfinite
+  apply hi.neg.congr
+  filter_upwards [ae_nonzero_of_negativeLogNorm_integral_finite hg hfinite, hbound]
+    with x hx hxb
+  rw [negativeLogNorm_of_ne_zero hx,
+    ENNReal.toReal_ofReal (neg_nonneg.mpr (Real.log_nonpos (norm_nonneg _) hxb)), neg_neg]
+
+/-- The normalized boundary conclusion of 15.19, conditional only on actual
+radial convergence along the specified circles. A separate existence proof
+supplies these limits; this helper is not counted as that existence theorem. -/
+theorem disk_boundary_log_integrable_of_radial_sequence {f : ℂ → ℂ} {g : ℝ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0)
+    (hbound : ∀ z ∈ Metric.ball 0 1, ‖f z‖ ≤ 1)
+    (r : ℕ → ℝ) {r₀ : ℝ} (hr₀ : 0 < r₀)
+    (hrlower : ∀ n, r₀ ≤ r n) (hrupper : ∀ n, r n < 1)
+    (hlim : ∀ᵐ θ ∂angularMeasure,
+      Tendsto (fun n ↦ f (circleMap 0 (r n) θ)) atTop (𝓝 (g θ))) :
+    (∫⁻ θ, negativeLogNorm (g θ) ∂angularMeasure) ≤
+      ENNReal.ofReal (-(2 * Real.pi) * logCircleMean f r₀) ∧
+    Integrable (fun θ ↦ Real.log ‖g θ‖) angularMeasure ∧
+    (∀ᵐ θ ∂angularMeasure, g θ ≠ 0) := by
+  have hrpos (n : ℕ) : 0 < r n := hr₀.trans_le (hrlower n)
+  have hcircle (n : ℕ) (θ : ℝ) : circleMap 0 (r n) θ ∈ Metric.ball (0 : ℂ) 1 := by
+    apply Metric.sphere_subset_ball _ (circleMap_mem_sphere' _ _ _)
+    simpa only [abs_of_pos (hrpos n)] using hrupper n
+  have hmeas (n : ℕ) : AEMeasurable (fun θ ↦ f (circleMap 0 (r n) θ)) angularMeasure :=
+    (hf.continuousOn.comp_continuous (continuous_circleMap 0 (r n)) (hcircle n)).measurable.aemeasurable
+  have hgm : AEMeasurable g angularMeasure :=
+    aemeasurable_of_tendsto_metrizable_ae atTop hmeas hlim
+  have hgb : ∀ᵐ θ ∂angularMeasure, ‖g θ‖ ≤ 1 := by
+    filter_upwards [hlim] with θ hθ
+    exact le_of_tendsto hθ.norm (Eventually.of_forall (fun n ↦ hbound _ (hcircle n θ)))
+  have hb (n : ℕ) :
+      (∫⁻ θ, negativeLogNorm (f (circleMap 0 (r n) θ)) ∂angularMeasure) ≤
+        ENNReal.ofReal (-(2 * Real.pi) * logCircleMean f r₀) := by
+    rw [negativeLogNorm_angular_integral_eq hf hne hbound (hrpos n) (hrupper n)]
+    apply ENNReal.ofReal_le_ofReal
+    exact mul_le_mul_of_nonpos_left
+      (disk_logCircleMean_mono hf hr₀ (hrlower n) (hrupper n)) (by positivity)
+  have hb' := (negativeLogNorm_fatou hmeas hlim).trans
+    (liminf_le_of_frequently_le' (Eventually.of_forall hb).frequently)
+  have hfinite : (∫⁻ θ, negativeLogNorm (g θ) ∂angularMeasure) ≠ ⊤ :=
+    ne_top_of_le_ne_top ENNReal.ofReal_ne_top hb'
+  exact ⟨hb', integrable_log_norm_of_negativeLogNorm_finite hgm hgb hfinite,
+    ae_nonzero_of_negativeLogNorm_integral_finite hgm hfinite⟩
+
+/-- Conversion for boundary functions after the null-zero-set and integrability
+conclusions have been established. -/
+theorem negativeLogNorm_integral_eq_of_integrable {α : Type*}
+    [MeasurableSpace α] {μ : Measure α} {g : α → ℂ}
+    (hzero : ∀ᵐ x ∂μ, g x ≠ 0) (hbound : ∀ᵐ x ∂μ, ‖g x‖ ≤ 1)
+    (hi : Integrable (fun x ↦ Real.log ‖g x‖) μ) :
+    (∫⁻ x, negativeLogNorm (g x) ∂μ) =
+      ENNReal.ofReal (-(∫ x, Real.log ‖g x‖ ∂μ)) := by
+  have heq : (fun x ↦ negativeLogNorm (g x)) =ᵐ[μ]
+      (fun x ↦ ENNReal.ofReal (-Real.log ‖g x‖)) :=
+    hzero.mono (fun _ hx ↦ negativeLogNorm_of_ne_zero hx)
+  have hnonneg : ∀ᵐ x ∂μ, 0 ≤ -Real.log ‖g x‖ :=
+    hbound.mono (fun _ hx ↦ neg_nonneg.mpr (Real.log_nonpos (norm_nonneg _) hx))
+  rw [lintegral_congr_ae heq, ← ofReal_integral_eq_lintegral_ofReal hi.neg hnonneg,
+    integral_neg]
+
+/-- The mean inequality in 15.19 follows with its exact normalization from the
+extended Fatou bound. -/
+theorem mean_le_boundary_log_mean {g : ℝ → ℂ} {m : ℝ} (hm : m ≤ 0)
+    (hzero : ∀ᵐ θ ∂angularMeasure, g θ ≠ 0)
+    (hbound : ∀ᵐ θ ∂angularMeasure, ‖g θ‖ ≤ 1)
+    (hi : Integrable (fun θ ↦ Real.log ‖g θ‖) angularMeasure)
+    (hfatou : (∫⁻ θ, negativeLogNorm (g θ) ∂angularMeasure) ≤
+      ENNReal.ofReal (-(2 * Real.pi) * m)) :
+    m ≤ (2 * Real.pi)⁻¹ * ∫ θ, Real.log ‖g θ‖ ∂angularMeasure := by
+  rw [negativeLogNorm_integral_eq_of_integrable hzero hbound hi] at hfatou
+  have hnonneg : 0 ≤ -(2 * Real.pi) * m := mul_nonneg_of_nonpos_of_nonpos (by positivity) hm
+  have hreal := (ENNReal.ofReal_le_ofReal_iff hnonneg).mp hfatou
+  have hdiv : m ≤ (∫ θ, Real.log ‖g θ‖ ∂angularMeasure) / (2 * Real.pi) :=
+    (le_div_iff₀ (by positivity : 0 < 2 * Real.pi)).2 (by linarith)
+  simpa only [div_eq_mul_inv, mul_comm] using hdiv
+
+/-- A concrete sequence approaching 1 through the interval [r₀,1). -/
+theorem exists_radial_sequence_above {r₀ : ℝ} (hr₀ : r₀ < 1) :
+    ∃ r : ℕ → ℝ, (∀ n, r₀ ≤ r n) ∧ (∀ n, r n < 1) ∧
+      Tendsto r atTop (𝓝[<] 1) := by
+  let r : ℕ → ℝ := fun n ↦ 1 - (1 - r₀) * (1 / 2 : ℝ) ^ n
+  have hpos : 0 < 1 - r₀ := sub_pos.mpr hr₀
+  have hlow (n : ℕ) : r₀ ≤ r n := by
+    have hp : (1 / 2 : ℝ) ^ n ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
+    have h := mul_le_mul_of_nonneg_left hp hpos.le
+    dsimp [r]
+    linarith
+  have hupp (n : ℕ) : r n < 1 := by
+    have hp : 0 < (1 / 2 : ℝ) ^ n := pow_pos (by norm_num) n
+    dsimp [r]
+    exact sub_lt_self _ (mul_pos hpos hp)
+  have ht : Tendsto r atTop (𝓝 1) := by
+    have hp := tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2)
+      (by norm_num : (1 / 2 : ℝ) < 1)
+    simpa only [r, mul_zero, sub_zero] using
+      tendsto_const_nhds.sub (hp.const_mul (1 - r₀))
+  exact ⟨r, hlow, hupp, tendsto_nhdsWithin_iff.mpr ⟨ht, Eventually.of_forall hupp⟩⟩
+
+/-- Actual radial convergence gives the normalized boundary estimate in 15.19.
+The existence of the radial function is supplied by the separate Fatou theorem. -/
+theorem normalized_log_means_of_radial_limits {f : ℂ → ℂ} {g : ℝ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0)
+    (hbound : ∀ z ∈ Metric.ball 0 1, ‖f z‖ ≤ 1)
+    (hradial : ∀ᵐ θ : ℝ,
+      Tendsto (fun r : ℝ ↦ f (circleMap 0 r θ)) (𝓝[<] 1) (𝓝 (g θ))) :
+    Integrable (fun θ ↦ Real.log ‖g θ‖) angularMeasure ∧
+      (∀ᵐ θ ∂angularMeasure, g θ ≠ 0) ∧
+      ∀ r : ℝ, 0 < r → r < 1 →
+        logCircleMean f r ≤ (2 * Real.pi)⁻¹ * ∫ θ, Real.log ‖g θ‖ ∂angularMeasure := by
+  have hrang : ∀ᵐ θ ∂angularMeasure,
+      Tendsto (fun r : ℝ ↦ f (circleMap 0 r θ)) (𝓝[<] 1) (𝓝 (g θ)) :=
+    ae_restrict_of_ae hradial
+  obtain ⟨r, hrl, hru, hrt⟩ := exists_radial_sequence_above (by norm_num : (1 / 2 : ℝ) < 1)
+  have hseq : ∀ᵐ θ ∂angularMeasure,
+      Tendsto (fun n ↦ f (circleMap 0 (r n) θ)) atTop (𝓝 (g θ)) :=
+    hrang.mono (fun _ hθ ↦ hθ.comp hrt)
+  obtain ⟨_, hi, hzero⟩ := disk_boundary_log_integrable_of_radial_sequence hf hne hbound r
+    (by norm_num : (0 : ℝ) < 1 / 2) hrl hru hseq
+  have hgb : ∀ᵐ θ ∂angularMeasure, ‖g θ‖ ≤ 1 := by
+    filter_upwards [hseq] with θ hθ
+    apply le_of_tendsto hθ.norm
+    apply Eventually.of_forall
+    intro n
+    apply hbound
+    apply Metric.sphere_subset_ball _ (circleMap_mem_sphere' _ _ _)
+    rw [abs_of_pos (lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) (hrl n))]
+    exact hru n
+  refine ⟨hi, hzero, ?_⟩
+  intro s hs hs1
+  obtain ⟨r', hr'l, hr'u, hr't⟩ := exists_radial_sequence_above hs1
+  have hseq' : ∀ᵐ θ ∂angularMeasure,
+      Tendsto (fun n ↦ f (circleMap 0 (r' n) θ)) atTop (𝓝 (g θ)) :=
+    hrang.mono (fun _ hθ ↦ hθ.comp hr't)
+  obtain ⟨hfatou, _, _⟩ := disk_boundary_log_integrable_of_radial_sequence hf hne hbound r'
+    hs hr'l hr'u hseq'
+  have hsub : Metric.sphere (0 : ℂ) |s| ⊆ Metric.ball 0 1 :=
+    Metric.sphere_subset_ball (by simpa only [abs_of_pos hs] using hs1)
+  have hmean : logCircleMean f s ≤ 0 := by
+    apply Real.circleAverage_mono_on_of_le_circle
+      ((hf.analyticOnNhd Metric.isOpen_ball).mono hsub).meromorphicOn.circleIntegrable_log_norm
+    intro z hz
+    exact Real.log_nonpos (norm_nonneg _) (hbound z (hsub hz))
+  exact mean_le_boundary_log_mean hmean hzero hgb hi hfatou
+
+/-- Positive constant rescaling shifts every interior logarithmic mean by the
+same real constant; angular zeros are handled by codiscrete equality. -/
+theorem logCircleMean_div_pos_const {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0) {C r : ℝ}
+    (hC : 0 < C) (hr : 0 < r) (hr1 : r < 1) :
+    logCircleMean (fun z ↦ f z / (C : ℂ)) r = logCircleMean f r - Real.log C := by
+  have hsub : Metric.sphere (0 : ℂ) |r| ⊆ Metric.ball 0 1 :=
+    Metric.sphere_subset_ball (by simpa only [abs_of_pos hr] using hr1)
+  have hzero := codiscreteWithin_mono hsub (disk_codiscrete_nonzero hf hne)
+  have heq : (fun z ↦ Real.log ‖f z / (C : ℂ)‖) =ᶠ[codiscreteWithin (Metric.sphere 0 |r|)]
+      (fun z ↦ Real.log ‖f z‖ - Real.log C) := by
+    filter_upwards [hzero] with z hz
+    rw [norm_div, Complex.norm_of_nonneg hC.le, Real.log_div (norm_ne_zero_iff.mpr hz) hC.ne']
+  rw [logCircleMean, Real.circleAverage_congr_codiscreteWithin heq hr.ne',
+    Real.circleAverage_fun_sub
+      ((hf.analyticOnNhd Metric.isOpen_ball).mono hsub).meromorphicOn.circleIntegrable_log_norm
+      (circleIntegrable_const _ _ _), Real.circleAverage_const]
+  rfl
+
+/-- Every bounded nonzero disk function admits a positive normalization to the
+closed unit ball without changing its zero set. -/
+theorem normalize_bounded_holomorphic {f : ℂ → ℂ}
+    (hf : DifferentiableOn ℂ f (Metric.ball 0 1))
+    (hne : ∃ w ∈ Metric.ball 0 1, f w ≠ 0)
+    (hbounded : ∃ M : ℝ, ∀ z ∈ Metric.ball 0 1, ‖f z‖ ≤ M) :
+    ∃ C : ℝ, 0 < C ∧ DifferentiableOn ℂ (fun z ↦ f z / (C : ℂ)) (Metric.ball 0 1) ∧
+      (∃ w ∈ Metric.ball 0 1, f w / (C : ℂ) ≠ 0) ∧
+      ∀ z ∈ Metric.ball 0 1, ‖f z / (C : ℂ)‖ ≤ 1 := by
+  obtain ⟨M, hM⟩ := hbounded
+  let C : ℝ := max M 1
+  have hC : 0 < C := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
+  have hC0 : (C : ℂ) ≠ 0 := by exact_mod_cast hC.ne'
+  refine ⟨C, hC, hf.div_const _, ?_, ?_⟩
+  · obtain ⟨w, hw, hfw⟩ := hne
+    exact ⟨w, hw, div_ne_zero hfw hC0⟩
+  · intro z hz
+    rw [norm_div, Complex.norm_of_nonneg hC.le, div_le_one hC]
+    exact (hM z hz).trans (le_max_left _ _)
+
+#print axioms extendedLogNorm_zero
+#print axioms extendedLogNorm_of_ne_zero
+#print axioms continuous_extendedLogNorm
+#print axioms negativeLogNorm_zero
+#print axioms continuous_negativeLogNorm
+#print axioms logCircleMean_eq_posLog_divisor_sum
+#print axioms logCircleMean_mono_of_center_ne_zero
+#print axioms disk_remove_zero_at_origin
+#print axioms logCircleMean_eq_posLog_divisor_sum_general
+#print axioms logCircleMean_mono
+#print axioms disk_logCircleMean_mono
+#print axioms exists_small_radius_logCircleMean_formula
+#print axioms logCircleMean_tendsto_origin
+#print axioms disk_angular_ae_nonzero
+#print axioms disk_angular_extendedLogNorm_eq
+#print axioms negativeLogNorm_of_ne_zero
+#print axioms negativeLogNorm_angular_integral_eq
+#print axioms negativeLogNorm_fatou
+#print axioms ae_nonzero_of_negativeLogNorm_integral_finite
+#print axioms integrable_log_norm_of_negativeLogNorm_finite
+#print axioms disk_boundary_log_integrable_of_radial_sequence
+#print axioms negativeLogNorm_integral_eq_of_integrable
+#print axioms mean_le_boundary_log_mean
+#print axioms exists_radial_sequence_above
+#print axioms disk_codiscrete_nonzero
+#print axioms normalized_log_means_of_radial_limits
+#print axioms logCircleMean_div_pos_const
+#print axioms normalize_bounded_holomorphic
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/MellinFunctionalWork.lean b/books/rudin-real-and-complex-analysis/MellinFunctionalWork.lean
new file mode 100644
index 0000000..30c349c
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/MellinFunctionalWork.lean
@@ -0,0 +1,179 @@
+import MuntzSzaszWork
+import Mathlib.Analysis.Complex.CauchyIntegral
+import Mathlib.Analysis.SpecialFunctions.Pow.Deriv
+import Mathlib.Analysis.Normed.Group.Quotient
+import Mathlib.Topology.Algebra.Module.ContinuousLinearMap.Quotient
+
+noncomputable section
+
+open Filter Set Metric MeasureTheory
+open scoped Topology
+
+namespace RudinRCA.Chapter15.MuntzSzaszWork
+
+theorem continuousMap_circleIntegral_apply {X : Type*} [TopologicalSpace X] [CompactSpace X]
+    {F : ℂ → C(X, ℂ)} {c : ℂ} {r : ℝ} (hf : CircleIntegrable F c r) (x : X) :
+    (∮ z in C(c, r), F z) x = ∮ z in C(c, r), F z x := by
+  simpa only [circleIntegral, map_smul, ContinuousMap.evalCLM_apply] using
+    ((ContinuousMap.evalCLM ℂ x).intervalIntegral_comp_comm hf.out).symm
+
+/-- Continuous families of continuous functions are holomorphic when every
+point evaluation is holomorphic. The compact domain gives the supremum norm. -/
+theorem differentiableOn_continuousMap_of_eval {X : Type*} [TopologicalSpace X] [CompactSpace X]
+    {Ω : Set ℂ} (hΩ : IsOpen Ω) {F : ℂ → C(X, ℂ)} (hF : ContinuousOn F Ω)
+    (hpoint : ∀ x, DifferentiableOn ℂ (fun z ↦ F z x) Ω) : DifferentiableOn ℂ F Ω := by
+  intro c hc
+  obtain ⟨r, hr, hrΩ⟩ := Metric.nhds_basis_closedBall.mem_iff.mp (hΩ.mem_nhds hc)
+  have hcircle : CircleIntegrable F c r :=
+    (hF.mono (sphere_subset_closedBall.trans hrΩ)).circleIntegrable hr.le
+  have hrep (w : ℂ) (hw : w ∈ ball c r) :
+      (∮ z in C(c, r), (z - w)⁻¹ • F z) = (2 * Real.pi * Complex.I : ℂ) • F w := by
+    have hwne : w ∉ sphere c |r| := by
+      rw [abs_of_pos hr]
+      exact Set.disjoint_left.mp disjoint_ball_sphere hw
+    ext x
+    rw [continuousMap_circleIntegral_apply
+      (by simpa only [zpow_neg_one] using hcircle.sub_zpow_smul (-1) hwne) x]
+    exact ((hpoint x).mono hrΩ).circleIntegral_sub_inv_smul hw
+  have hcenter : c ∉ sphere c |r| := by simp [hr.ne']
+  have hd := (Complex.hasDerivAt_circleIntegral_sub_inv_smul hcircle hcenter).const_smul
+    ((2 * Real.pi * Complex.I : ℂ)⁻¹)
+  have heq : (fun w ↦ (2 * Real.pi * Complex.I : ℂ)⁻¹ •
+      (∮ z in C(c, r), (z - w)⁻¹ • F z)) =ᶠ[𝓝 c] F := by
+    filter_upwards [ball_mem_nhds c hr] with w hw
+    rw [hrep w hw, smul_smul, inv_mul_cancel₀, one_smul]
+    exact mul_ne_zero (mul_ne_zero (by norm_num) (by exact_mod_cast Real.pi_ne_zero)) Complex.I_ne_zero
+  exact (hd.differentiableAt.congr_of_eventuallyEq heq.symm).differentiableWithinAt
+
+/-- The vector-valued Mellin kernel, extended by zero outside the open right half-plane. -/
+def intervalComplexPower (z : ℂ) : C(UnitInterval, ℂ) :=
+  if hz : 0 < z.re then
+    ⟨fun t ↦ (t.val : ℂ) ^ z,
+      (Complex.continuous_ofReal_cpow_const hz).comp continuous_subtype_val⟩
+  else 0
+
+theorem intervalComplexPower_apply {z : ℂ} (hz : 0 < z.re) (t : UnitInterval) :
+    intervalComplexPower z t = (t.val : ℂ) ^ z := by
+  simp only [intervalComplexPower, dif_pos hz, ContinuousMap.coe_mk]
+
+theorem intervalComplexPower_continuousOn :
+    ContinuousOn intervalComplexPower {z | 0 < z.re} := by
+  apply ContinuousMap.continuousOn_of_continuousOn_uncurry
+  have hc : ContinuousOn (fun p : ℂ × UnitInterval ↦ (p.2.val : ℂ) ^ p.1)
+      ({z : ℂ | 0 < z.re} ×ˢ (univ : Set UnitInterval)) := by
+    intro p hp
+    have hcp := Complex.continuousAt_cpow_of_re_pos
+      (p := ((p.2.val : ℂ), p.1)) (Or.inl p.2.property.1) hp.1
+    have hprod : ContinuousAt (fun q : ℂ × UnitInterval ↦ ((q.2.val : ℂ), q.1)) p := by
+      fun_prop
+    exact (Filter.Tendsto.comp hcp hprod).continuousWithinAt
+  apply hc.congr
+  intro p hp
+  exact (intervalComplexPower_apply hp.1 p.2).symm
+
+theorem intervalComplexPower_differentiableOn :
+    DifferentiableOn ℂ intervalComplexPower {z | 0 < z.re} := by
+  apply differentiableOn_continuousMap_of_eval
+    (isOpen_lt continuous_const Complex.continuous_re) intervalComplexPower_continuousOn
+  intro t
+  have hc : DifferentiableOn ℂ (fun z : ℂ ↦ (t.val : ℂ) ^ z) {z | 0 < z.re} :=
+    differentiableOn_id.const_cpow (Or.inr fun z hz ↦ by intro h; simpa [h] using hz)
+  apply hc.congr
+  intro z hz
+  exact (intervalComplexPower_apply hz t).symm
+
+theorem norm_intervalComplexPower_le_one {z : ℂ} (hz : 0 < z.re) :
+    ‖intervalComplexPower z‖ ≤ 1 := by
+  apply (ContinuousMap.norm_le (by norm_num : (0 : ℝ) ≤ 1)).mpr
+  intro t
+  rw [intervalComplexPower_apply hz,
+    Complex.norm_cpow_eq_rpow_re_of_nonneg t.property.1 hz.ne']
+  exact Real.rpow_le_one t.property.1 t.property.2 hz.le
+
+theorem intervalComplexPower_ofReal {q : ℝ} (hq : 0 < q) :
+    intervalComplexPower (q : ℂ) = intervalRealPower q hq.le := by
+  ext t
+  rw [intervalComplexPower_apply (by simpa using hq)]
+  exact (Complex.ofReal_cpow t.property.1 q).symm
+
+/-- Applying any continuous linear functional produces the bounded holomorphic
+Mellin transform needed by the separating-functional proof. -/
+theorem functional_mellin_holomorphic_bounded (L : C(UnitInterval, ℂ) →L[ℂ] ℂ) :
+    DifferentiableOn ℂ (fun z ↦ L (intervalComplexPower z)) {z | 0 < z.re} ∧
+      ∀ z, 0 < z.re → ‖L (intervalComplexPower z)‖ ≤ ‖L‖ := by
+  constructor
+  · exact L.differentiable.comp_differentiableOn intervalComplexPower_differentiableOn
+  · intro z hz
+    exact (L.le_opNorm _).trans (by simpa using
+      mul_le_mul_of_nonneg_left (norm_intervalComplexPower_le_one hz) (norm_nonneg L))
+
+/-- Hahn–Banach separation in the exact form needed for a closed subspace. -/
+theorem mem_closed_submodule_of_annihilator {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
+    (S : Submodule ℂ E) (hS : IsClosed (S : Set E)) {v : E}
+    (hv : ∀ L : E →L[ℂ] ℂ, (∀ w ∈ S, L w = 0) → L v = 0) : v ∈ S := by
+  letI : IsClosed (S : Set E) := hS
+  by_contra hvS
+  have hq : (Submodule.Quotient.mk v : E ⧸ S) ≠ 0 :=
+    fun h ↦ hvS (Submodule.Quotient.mk_eq_zero.mp h)
+  obtain ⟨L, hL⟩ := SeparatingDual.exists_ne_zero (R := ℂ) hq
+  apply hL
+  apply hv (L.comp S.mkQL)
+  intro w hw
+  simp [Submodule.Quotient.mk_eq_zero.mpr hw]
+
+/-- Rudin 15.26(a), the Müntz–Szász density implication for arbitrary strictly
+increasing positive real exponents, including sequences with finite accumulation. -/
+theorem muntz_szasz_dense {λ : ℕ → ℝ} (hλ0 : 0 < λ 0) (hλ : StrictMono λ)
+    (hdiv : ¬ Summable (fun n ↦ 1 / λ n)) :
+    muntzClosure λ (fun n ↦ (hλ0.trans_le (hλ.monotone (Nat.zero_le n))).le) = ⊤ := by
+  let hpos : ∀ n, 0 < λ n := fun n ↦ hλ0.trans_le (hλ.monotone (Nat.zero_le n))
+  apply muntzClosure_eq_top_of_contains_powers
+  intro n
+  by_cases hn : n = 0
+  · simpa only [hn, pow_zero] using one_mem_muntzClosure λ (fun n ↦ (hpos n).le)
+  · apply mem_closed_submodule_of_annihilator _ (Submodule.isClosed_topologicalClosure _)
+    intro L hL
+    obtain ⟨hhol, hbound⟩ := functional_mellin_holomorphic_bounded L
+    have hfzero := bounded_halfPlane_zero_on_positive_reals hhol ⟨‖L‖, hbound⟩ hλ0 hλ hdiv
+      (fun j ↦ by rw [intervalComplexPower_ofReal (hpos j)];
+        exact hL _ (intervalRealPower_mem_muntzClosure λ (fun n ↦ (hpos n).le) j))
+    have h := hfzero n (by exact_mod_cast Nat.pos_of_ne_zero hn)
+    rw [intervalComplexPower_ofReal (by exact_mod_cast Nat.pos_of_ne_zero hn),
+      intervalRealPower_nat] at h
+    exact h
+
+/-- The constructive deletion assertion behind 15.27: a divergent Müntz family
+has a subsequence with infinitely many omitted exponents and the same dense span. -/
+theorem muntz_exists_infinite_removal_dense {λ : ℕ → ℝ}
+    (hλ0 : 0 < λ 0) (hλ : StrictMono λ)
+    (hdiv : ¬ Summable (fun n ↦ 1 / λ n)) :
+    ∃ b : ℕ → ℕ, StrictMono b ∧ (range b)ᶜ.Infinite ∧
+      muntzClosure (λ ∘ b)
+        (fun n ↦ (hλ0.trans_le (hλ.monotone (Nat.zero_le (b n)))).le) = ⊤ := by
+  obtain ⟨b, hb, hbinf, hbdiv⟩ := exists_infinite_removal_preserving_divergence hdiv
+  refine ⟨b, hb, hbinf, ?_⟩
+  exact muntz_szasz_dense (hλ0.trans_le (hλ.monotone (Nat.zero_le (b 0))))
+    (hλ.comp hb) hbdiv
+
+/-- Removing the constant always strictly reduces the closed Müntz span, since
+every positive power vanishes at the origin. This includes the constant member
+in the non-density assertion of 15.27. -/
+theorem muntz_constant_removal_strict {λ : ℕ → ℝ} (hλ : ∀ n, 0 < λ n) :
+    (Submodule.span ℂ (range fun n ↦ intervalRealPower (λ n) (hλ n).le)).topologicalClosure <
+      muntzClosure λ (fun n ↦ (hλ n).le) := by
+  exact closed_span_strictly_decreases_of_removed_vector
+    (subset_insert 1 _) (mem_insert 1 _) (one_not_mem_closed_span_positive_powers hλ)
+
+#print axioms continuousMap_circleIntegral_apply
+#print axioms differentiableOn_continuousMap_of_eval
+#print axioms intervalComplexPower_continuousOn
+#print axioms intervalComplexPower_differentiableOn
+#print axioms norm_intervalComplexPower_le_one
+#print axioms intervalComplexPower_ofReal
+#print axioms functional_mellin_holomorphic_bounded
+#print axioms mem_closed_submodule_of_annihilator
+#print axioms muntz_szasz_dense
+#print axioms muntz_exists_infinite_removal_dense
+#print axioms muntz_constant_removal_strict
+
+end RudinRCA.Chapter15.MuntzSzaszWork
diff --git a/books/rudin-real-and-complex-analysis/MeromorphicPoleDataWork.lean b/books/rudin-real-and-complex-analysis/MeromorphicPoleDataWork.lean
new file mode 100644
index 0000000..3a047f3
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/MeromorphicPoleDataWork.lean
@@ -0,0 +1,129 @@
+import Mathlib.Analysis.Meromorphic.NormalForm
+import Mathlib.Topology.LocallyFinsupp
+
+noncomputable section
+open Filter Set
+open scoped Topology
+
+namespace RudinRCA.Chapter15
+
+/-- The poles used as zero data for the denominator in 15.12. The divisor is
+zero outside the domain and on locally identically-zero components. -/
+def meromorphicPoleSet (f : ℂ → ℂ) (Ω : Set ℂ) : Set ℂ :=
+  {z | MeromorphicOn.divisor f Ω z < 0}
+
+/-- The positive pole order, extended by zero at all other points. -/
+def meromorphicPoleMultiplicity (f : ℂ → ℂ) (Ω : Set ℂ) (z : ℂ) : ℕ :=
+  (-MeromorphicOn.divisor f Ω z).toNat
+
+theorem meromorphicPoleSet_subset_support (f : ℂ → ℂ) (Ω : Set ℂ) :
+    meromorphicPoleSet f Ω ⊆ (MeromorphicOn.divisor f Ω).support := by
+  intro z hz
+  exact ne_of_lt hz
+
+theorem meromorphicPoleSet_subset (f : ℂ → ℂ) (Ω : Set ℂ) :
+    meromorphicPoleSet f Ω ⊆ Ω :=
+  (meromorphicPoleSet_subset_support f Ω).trans
+    (MeromorphicOn.divisor f Ω).supportWithinDomain
+
+/-- Local finiteness is retained explicitly; mere discreteness would not exclude
+an accumulation at another point of the domain. -/
+theorem meromorphicPoleSet_locallyFinite (f : ℂ → ℂ) (Ω : Set ℂ) :
+    ∀ z ∈ Ω, ∃ t ∈ 𝓝 z, (t ∩ meromorphicPoleSet f Ω).Finite := by
+  intro z hz
+  obtain ⟨t, ht, hfin⟩ := (MeromorphicOn.divisor f Ω).supportLocallyFiniteWithinDomain z hz
+  exact ⟨t, ht, hfin.subset (inter_subset_inter_left _
+    (meromorphicPoleSet_subset_support f Ω))⟩
+
+/-- The precise no-interior-accumulation hypothesis required by 15.11. -/
+theorem meromorphicPoleSet_no_accPt (f : ℂ → ℂ) (Ω : Set ℂ) :
+    ∀ z ∈ Ω, ¬ AccPt z (𝓟 (meromorphicPoleSet f Ω)) := by
+  have hcod : (meromorphicPoleSet f Ω)ᶜ ∈ codiscreteWithin Ω := by
+    filter_upwards [(MeromorphicOn.divisor f Ω).eq_zero_codiscreteWithin] with z hz
+    change ¬ MeromorphicOn.divisor f Ω z < 0
+    change MeromorphicOn.divisor f Ω z = 0 at hz
+    rw [hz]
+    exact lt_irrefl 0
+  have hset : Ω \ (meromorphicPoleSet f Ω)ᶜ = meromorphicPoleSet f Ω := by
+    ext z
+    simp only [mem_sdiff, mem_compl_iff, not_not]
+    exact ⟨fun hz ↦ hz.2, fun hz ↦ ⟨meromorphicPoleSet_subset f Ω hz, hz⟩⟩
+  simpa only [hset] using mem_codiscreteWithin_accPt.mp hcod
+
+theorem meromorphicPoleMultiplicity_pos {f : ℂ → ℂ} {Ω : Set ℂ} {z : ℂ}
+    (hz : z ∈ meromorphicPoleSet f Ω) : 0 < meromorphicPoleMultiplicity f Ω z := by
+  exact Int.pos_iff_toNat_pos.mp (neg_pos.mpr hz)
+
+theorem meromorphicPoleMultiplicity_eq_zero {f : ℂ → ℂ} {Ω : Set ℂ} {z : ℂ}
+    (hz : z ∉ meromorphicPoleSet f Ω) : meromorphicPoleMultiplicity f Ω z = 0 := by
+  apply Int.toNat_eq_zero.mpr
+  exact neg_nonpos.mpr (le_of_not_gt hz)
+
+/-- Outside the actual pole set, the meromorphic order is nonnegative, including
+order infinity on an identically-zero component. -/
+theorem meromorphicOrderAt_nonneg_of_not_pole {Ω : Set ℂ} {f : ℂ → ℂ}
+    (hf : MeromorphicOn f Ω) {z : ℂ} (hz : z ∈ Ω)
+    (hpole : z ∉ meromorphicPoleSet f Ω) : 0 ≤ meromorphicOrderAt f z := by
+  by_cases htop : meromorphicOrderAt f z = ⊤
+  · simp [htop]
+  · obtain ⟨n, hn⟩ := WithTop.ne_top_iff_exists.mp htop
+    have hnonneg : 0 ≤ n := by
+      have hd : MeromorphicOn.divisor f Ω z = n := by
+        rw [hf.divisor_apply hz, ← hn]
+        rfl
+      change ¬ MeromorphicOn.divisor f Ω z < 0 at hpole
+      rw [hd] at hpole
+      exact le_of_not_gt hpole
+    rw [← hn]
+    exact_mod_cast hnonneg
+
+/-- Zero-set data and the positive multiplicities supplied by 15.11 determine
+the denominator order at every point, including nonpoles. -/
+theorem denominator_order_of_pole_data {Ω : Set ℂ} {f h : ℂ → ℂ}
+    (hh : AnalyticOnNhd ℂ h Ω)
+    (hzeros : ∀ z ∈ Ω, h z = 0 ↔ z ∈ meromorphicPoleSet f Ω)
+    (horders : ∀ z ∈ meromorphicPoleSet f Ω,
+      analyticOrderAt h z = (meromorphicPoleMultiplicity f Ω z : ℕ∞)) :
+    ∀ z ∈ Ω, analyticOrderAt h z = (meromorphicPoleMultiplicity f Ω z : ℕ∞) := by
+  intro z hz
+  by_cases hpole : z ∈ meromorphicPoleSet f Ω
+  · exact horders z hpole
+  · have hne : h z ≠ 0 := fun hzero ↦ hpole ((hzeros z hz).mp hzero)
+    rw [(hh z hz).analyticOrderAt_eq_zero.mpr hne,
+      meromorphicPoleMultiplicity_eq_zero hpole]
+    simp
+
+/-- The actual pole data cancels every negative order. No finite-order condition
+is imposed on f: order infinity on an identically-zero component is allowed. -/
+theorem nonnegative_order_of_pole_denominator {Ω : Set ℂ} {f h : ℂ → ℂ}
+    (hf : MeromorphicOn f Ω) (hh : AnalyticOnNhd ℂ h Ω)
+    (horders : ∀ z ∈ Ω,
+      analyticOrderAt h z = (meromorphicPoleMultiplicity f Ω z : ℕ∞)) :
+    (∀ z ∈ Ω, analyticOrderAt h z ≠ ⊤) ∧
+      ∀ z ∈ Ω, 0 ≤ meromorphicOrderAt f z + meromorphicOrderAt h z := by
+  refine ⟨fun z hz ↦ by simp [horders z hz], ?_⟩
+  intro z hz
+  rw [(hh z hz).meromorphicOrderAt_eq, horders z hz, ENat.map_natCast]
+  by_cases htop : meromorphicOrderAt f z = ⊤
+  · simp [htop]
+  · obtain ⟨n, hn⟩ := WithTop.ne_top_iff_exists.mp htop
+    have hd : MeromorphicOn.divisor f Ω z = n := by
+      rw [hf.divisor_apply hz, ← hn]
+      rfl
+    rw [← hn]
+    dsimp only [meromorphicPoleMultiplicity]
+    rw [hd]
+    have hnonneg : 0 ≤ n + ((-n).toNat : ℤ) := by omega
+    exact_mod_cast hnonneg
+
+#print axioms meromorphicPoleSet_subset_support
+#print axioms meromorphicPoleSet_subset
+#print axioms meromorphicPoleSet_locallyFinite
+#print axioms meromorphicPoleSet_no_accPt
+#print axioms meromorphicPoleMultiplicity_pos
+#print axioms meromorphicPoleMultiplicity_eq_zero
+#print axioms meromorphicOrderAt_nonneg_of_not_pole
+#print axioms denominator_order_of_pole_data
+#print axioms nonnegative_order_of_pole_denominator
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/MeromorphicQuotientAssemblyWork.lean b/books/rudin-real-and-complex-analysis/MeromorphicQuotientAssemblyWork.lean
new file mode 100644
index 0000000..a01708a
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/MeromorphicQuotientAssemblyWork.lean
@@ -0,0 +1,72 @@
+import RudinRCA.Chapter15
+
+/-!
+Final 15.12 assembly against the planned Chapter15 interface. This file requires
+the actual 15.11 existence theorem and the pole-data/quotient prerequisites to
+have been integrated; no denominator-existence hypothesis is assumed here.
+-/
+
+noncomputable section
+open Filter Set
+open scoped Topology
+
+namespace RudinRCA.Chapter15
+
+/-- Theorem 15.12 in Mathlib's meromorphic-class interpretation. A scalar-valued
+`MeromorphicOn` function may have arbitrary isolated point values, so the identity
+is initially stated as equality outside a codiscrete set. The denominator has
+exactly the actual poles as its zeros and finite order everywhere. -/
+theorem meromorphic_function_quotient {Ω : Set ℂ} {f : ℂ → ℂ}
+    (hΩ : IsOpen Ω) (hf : MeromorphicOn f Ω) :
+    ∃ g h : ℂ → ℂ, AnalyticOnNhd ℂ g Ω ∧ AnalyticOnNhd ℂ h Ω ∧
+      (∀ z ∈ Ω, h z = 0 ↔ z ∈ meromorphicPoleSet f Ω) ∧
+      (∀ z ∈ Ω, analyticOrderAt h z ≠ ⊤) ∧
+      f =ᶠ[codiscreteWithin Ω] (fun z ↦ g z / h z) := by
+  obtain ⟨h, hhol, hzeros, horders⟩ := prescribed_zeros_on_plane hΩ
+    (meromorphicPoleSet_subset f Ω) (meromorphicPoleSet_no_accPt f Ω)
+    (meromorphicPoleMultiplicity f Ω) (fun z hz ↦ meromorphicPoleMultiplicity_pos hz)
+  have hhan : AnalyticOnNhd ℂ h Ω := hhol.analyticOnNhd hΩ
+  have hall := denominator_order_of_pole_data hhan hzeros horders
+  obtain ⟨hfinite, hcancel⟩ := nonnegative_order_of_pole_denominator hf hhan hall
+  obtain ⟨g, hga, heq⟩ := meromorphic_quotient_of_canceling_denominator hf hhan hfinite hcancel
+  exact ⟨g, h, hga, hhan, hzeros, hfinite, heq⟩
+
+/-- At an analytic nonpole, equality of meromorphic classes is actual equality.
+This supplies the printed identity on Ω minus its pole set. -/
+theorem quotient_eq_at_of_codiscrete {Ω : Set ℂ} {f g h : ℂ → ℂ}
+    (hΩ : IsOpen Ω) (hg : AnalyticOnNhd ℂ g Ω) (hh : AnalyticOnNhd ℂ h Ω)
+    (heq : f =ᶠ[codiscreteWithin Ω] (fun z ↦ g z / h z))
+    {z : ℂ} (hz : z ∈ Ω) (hfz : AnalyticAt ℂ f z) (hhz : h z ≠ 0) :
+    f z = g z / h z := by
+  have hnear : f =ᶠ[𝓝[≠] z] (fun w ↦ g w / h w) := by
+    have hlocal := eventuallyEq_codiscreteWithin_iff_forall_eventuallyEq_nhdsNE.mp heq z hz
+    filter_upwards [hlocal, (hΩ.mem_nhds hz).filter_mono nhdsWithin_le_nhds] with w hw hwΩ
+    exact hw hwΩ
+  exact (hfz.continuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE
+    (((hg z hz).div (hh z hz) hhz).continuousAt)).mp hnear |>.eq_of_nhds
+
+/-- The pointwise form of 15.12 for the normal-form representative of a
+meromorphic function: f=g/h at every point outside its actual poles. This
+convention removes Mathlib's arbitrary isolated values, not any mathematical
+domain components. -/
+theorem meromorphic_function_quotient_off_poles {Ω : Set ℂ} {f : ℂ → ℂ}
+    (hΩ : IsOpen Ω) (hf : MeromorphicNFOn f Ω) :
+    ∃ g h : ℂ → ℂ, AnalyticOnNhd ℂ g Ω ∧ AnalyticOnNhd ℂ h Ω ∧
+      (∀ z ∈ Ω, h z = 0 ↔ z ∈ meromorphicPoleSet f Ω) ∧
+      (∀ z ∈ Ω, analyticOrderAt h z ≠ ⊤) ∧
+      ∀ z ∈ Ω, z ∉ meromorphicPoleSet f Ω → f z = g z / h z := by
+  obtain ⟨g, h, hg, hh, hzeros, hfinite, heq⟩ :=
+    meromorphic_function_quotient hΩ hf.meromorphicOn
+  refine ⟨g, h, hg, hh, hzeros, hfinite, ?_⟩
+  intro z hz hpole
+  have hfz : AnalyticAt ℂ f z :=
+    (hf hz).meromorphicOrderAt_nonneg_iff_analyticAt.mp
+      (meromorphicOrderAt_nonneg_of_not_pole hf.meromorphicOn hz hpole)
+  have hhz : h z ≠ 0 := fun hzero ↦ hpole ((hzeros z hz).mp hzero)
+  exact quotient_eq_at_of_codiscrete hΩ hg hh heq hz hfz hhz
+
+#print axioms meromorphic_function_quotient
+#print axioms quotient_eq_at_of_codiscrete
+#print axioms meromorphic_function_quotient_off_poles
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/MeromorphicQuotientWork.lean b/books/rudin-real-and-complex-analysis/MeromorphicQuotientWork.lean
new file mode 100644
index 0000000..65c5386
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/MeromorphicQuotientWork.lean
@@ -0,0 +1,68 @@
+import RudinRCA.Chapter15
+import Mathlib.Analysis.Meromorphic.NormalForm
+
+noncomputable section
+open Filter Set
+open scoped Topology
+
+namespace RudinRCA.Chapter15
+
+/-- The removable-singularity step used in 15.12: a meromorphic function with
+no negative orders has a holomorphic representative of its meromorphic class. -/
+theorem holomorphic_regularization_of_nonnegative_orders {Ω : Set ℂ} {f : ℂ → ℂ}
+    (hf : MeromorphicOn f Ω) (hord : ∀ z ∈ Ω, 0 ≤ meromorphicOrderAt f z) :
+    ∃ g : ℂ → ℂ, AnalyticOnNhd ℂ g Ω ∧ f =ᶠ[codiscreteWithin Ω] g := by
+  refine ⟨toMeromorphicNFOn f Ω, ?_, toMeromorphicNFOn_eqOn_codiscrete hf⟩
+  intro z hz
+  apply ((meromorphicNFOn_toMeromorphicNFOn f Ω) hz)
+    .meromorphicOrderAt_nonneg_iff_analyticAt.mp
+  rw [meromorphicOrderAt_toMeromorphicNFOn hf hz]
+  exact hord z hz
+
+/-- Finite analytic orders exclude an identically zero component, so zeros may
+be removed on a codiscrete set even when the domain is disconnected. -/
+theorem holomorphic_nonzero_codiscrete {Ω : Set ℂ} {g : ℂ → ℂ}
+    (hg : AnalyticOnNhd ℂ g Ω) (hfinite : ∀ z ∈ Ω, analyticOrderAt g z ≠ ⊤) :
+    ∀ᶠ z in codiscreteWithin Ω, g z ≠ 0 := by
+  have hΩ : Ω ∈ codiscreteWithin Ω := by simp
+  filter_upwards [hg.codiscreteWithin_setOfPred_analyticOrderAt_eq_zero_or_top, hΩ] with z hz hzΩ
+  exact (hg z hzΩ).analyticOrderAt_eq_zero.mp (hz.resolve_right (hfinite z hzΩ))
+
+/-- The denominator assembly for 15.12. The remaining existence obligation is
+to construct h with exactly the pole multiplicities, using 15.11. This helper
+must not itself be counted as the numbered quotient theorem. -/
+theorem meromorphic_quotient_of_canceling_denominator {Ω : Set ℂ} {f h : ℂ → ℂ}
+    (hf : MeromorphicOn f Ω) (hh : AnalyticOnNhd ℂ h Ω)
+    (hfinite : ∀ z ∈ Ω, analyticOrderAt h z ≠ ⊤)
+    (hcancel : ∀ z ∈ Ω, 0 ≤ meromorphicOrderAt f z + meromorphicOrderAt h z) :
+    ∃ g : ℂ → ℂ, AnalyticOnNhd ℂ g Ω ∧
+      f =ᶠ[codiscreteWithin Ω] (fun z ↦ g z / h z) := by
+  have hprod : MeromorphicOn (f * h) Ω := hf.mul hh.meromorphicOn
+  have hprodorder : ∀ z ∈ Ω, 0 ≤ meromorphicOrderAt (f * h) z := by
+    intro z hz
+    rw [meromorphicOrderAt_mul (hf z hz) (hh z hz).meromorphicAt]
+    exact hcancel z hz
+  obtain ⟨g, hg, heq⟩ := holomorphic_regularization_of_nonnegative_orders hprod hprodorder
+  refine ⟨g, hg, ?_⟩
+  filter_upwards [heq, holomorphic_nonzero_codiscrete hh hfinite] with z hz hh0
+  change f z * h z = g z at hz
+  rw [← hz, mul_div_cancel_right₀ _ hh0]
+
+/-- The converse accompanying 15.12. The standard meromorphic interpretation
+ignores isolated arbitrary values at poles; componentwise nonvanishing gives
+finite denominator orders and is retained explicitly as in the printed text. -/
+theorem quotient_holomorphic_meromorphic {Ω : Set ℂ} {g h : ℂ → ℂ}
+    (hΩ : IsOpen Ω) (hg : DifferentiableOn ℂ g Ω) (hh : DifferentiableOn ℂ h Ω)
+    (hnonzero : ∀ z ∈ Ω, ∃ w ∈ connectedComponentIn Ω z, h w ≠ 0) :
+    MeromorphicOn (fun z ↦ g z / h z) Ω ∧ ∀ z ∈ Ω, analyticOrderAt h z ≠ ⊤ := by
+  refine ⟨?_, fun z hz ↦ analyticOrderAt_ne_top_of_component_nonzero hΩ hh hnonzero hz⟩
+  intro z hz
+  exact ((hg.analyticOnNhd hΩ) z hz).meromorphicAt.div
+    ((hh.analyticOnNhd hΩ) z hz).meromorphicAt
+
+#print axioms holomorphic_regularization_of_nonnegative_orders
+#print axioms holomorphic_nonzero_codiscrete
+#print axioms meromorphic_quotient_of_canceling_denominator
+#print axioms quotient_holomorphic_meromorphic
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/MittagLefflerInfinityWork.lean b/books/rudin-real-and-complex-analysis/MittagLefflerInfinityWork.lean
new file mode 100644
index 0000000..5d6ed69
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/MittagLefflerInfinityWork.lean
@@ -0,0 +1,143 @@
+import MittagLefflerSeriesWork
+import Mathlib.Tactic.LinearCombination
+
+/-!
+The infinity chart of the explicit Mittag-Leffler series. This is required when
+a point of the original domain is moved to infinity by normalization. Every
+corrected summand has value zero in this chart at zero, and the same geometric
+majorant proves normal convergence on a fixed chart disc.
+
+Draft: awaiting the serialized Lean check.
+-/
+
+noncomputable section
+open Filter Finset Set Metric
+open scoped Topology
+
+namespace RudinRCA.Chapter15
+
+def reciprocalExpansionAtInfinity (N : ℕ) (a b w : ℂ) : ℂ :=
+  ∑ k ∈ range N, ((a - b) * w / (1 - b * w)) ^ k * (w / (1 - b * w))
+
+def correctedPrincipalPartAtInfinity (P : Polynomial ℂ) (N : ℕ) (a b w : ℂ) : ℂ :=
+  P.eval (w / (1 - a * w)) - P.eval (reciprocalExpansionAtInfinity N a b w)
+
+theorem reciprocal_at_infinity_eq {a w : ℂ} (hw : w ≠ 0) :
+    w / (1 - a * w) = 1 / (1 / w - a) := by
+  by_cases hd : 1 - a * w = 0
+  · have hd' : 1 / w - a = 0 := by
+      apply (mul_right_cancel₀ hw)
+      field_simp [hw]
+      linear_combination hd
+    simp [hd, hd']
+  · have hd' : 1 / w - a ≠ 0 := by
+      intro h
+      apply hd
+      field_simp [hw] at h
+      linear_combination h
+    field_simp [hw, hd, hd']
+
+theorem reciprocalExpansionAtInfinity_eq (N : ℕ) (a b : ℂ)
+    {w : ℂ} (hw : w ≠ 0) :
+    reciprocalExpansionAtInfinity N a b w = reciprocalExpansion N a b (1 / w) := by
+  apply Finset.sum_congr rfl
+  intro k _
+  have hr : (a - b) * w / (1 - b * w) = (a - b) / (1 / w - b) := by
+    calc
+      (a - b) * w / (1 - b * w) = (a - b) * (w / (1 - b * w)) := by ring
+      _ = (a - b) * (1 / (1 / w - b)) := by rw [reciprocal_at_infinity_eq hw]
+      _ = (a - b) / (1 / w - b) := by ring
+  rw [hr, reciprocal_at_infinity_eq hw]
+  ring
+
+theorem correctedPrincipalPartAtInfinity_eq (P : Polynomial ℂ) (N : ℕ)
+    (a b : ℂ) {w : ℂ} (hw : w ≠ 0) :
+    correctedPrincipalPartAtInfinity P N a b w =
+      correctedPrincipalPart P N a b (1 / w) := by
+  simp only [correctedPrincipalPartAtInfinity, correctedPrincipalPart,
+    reciprocal_at_infinity_eq hw, reciprocalExpansionAtInfinity_eq N a b hw]
+
+@[simp] theorem correctedPrincipalPartAtInfinity_zero
+    (P : Polynomial ℂ) (N : ℕ) (a b : ℂ) :
+    correctedPrincipalPartAtInfinity P N a b 0 = 0 := by
+  simp [correctedPrincipalPartAtInfinity, reciprocalExpansionAtInfinity]
+
+theorem correctedPrincipalPartAtInfinity_analyticAt (P : Polynomial ℂ) (N : ℕ)
+    {a b w : ℂ} (ha : 1 - a * w ≠ 0) (hb : 1 - b * w ≠ 0) :
+    AnalyticAt ℂ (correctedPrincipalPartAtInfinity P N a b) w := by
+  have had : AnalyticAt ℂ (fun v : ℂ ↦ 1 - a * v) w :=
+    analyticAt_const.sub (analyticAt_const.mul analyticAt_id)
+  have hbd : AnalyticAt ℂ (fun v : ℂ ↦ 1 - b * v) w :=
+    analyticAt_const.sub (analyticAt_const.mul analyticAt_id)
+  have htrue : AnalyticAt ℂ (fun v : ℂ ↦ v / (1 - a * v)) w := analyticAt_id.div had ha
+  have happ : AnalyticAt ℂ (reciprocalExpansionAtInfinity N a b) w :=
+    Finset.analyticAt_fun_sum _ fun k _ ↦
+      (((analyticAt_const.mul analyticAt_id).div hbd hb).pow k).mul
+        (analyticAt_id.div hbd hb)
+  exact (htrue.aeval_polynomial P).sub (happ.aeval_polynomial P)
+
+theorem infinity_exterior_of_small_difference {a b w : ℂ}
+    (hw : w ≠ 0) (hw1 : ‖w‖ ≤ 1)
+    (hden : (1 / 2 : ℝ) ≤ ‖1 - b * w‖) (hab : ‖a - b‖ ≤ 1 / 4) :
+    2 * ‖a - b‖ ≤ ‖1 / w - b‖ := by
+  have hwp : 0 < ‖w‖ := norm_pos_iff.mpr hw
+  have heq : 1 / w - b = (1 - b * w) / w := by field_simp [hw]
+  rw [heq, norm_div, le_div_iff₀ hwp]
+  have hprod : 2 * ‖a - b‖ * ‖w‖ ≤ 2 * (1 / 4 : ℝ) * 1 :=
+    mul_le_mul (mul_le_mul_of_nonneg_left hab (by norm_num)) hw1
+      (norm_nonneg _) (by norm_num)
+  linarith
+
+/-- The corrected series is analytic in a full neighborhood of infinity. Its
+chart value at zero is zero, which makes the normalization point removable. -/
+theorem principal_part_series_analytic_at_infinity
+    (P : ℕ → Polynomial ℂ) (N : ℕ → ℕ) (a b : ℕ → ℂ)
+    (B : ℝ) (hB : 0 < B) (haB : ∀ n, ‖a n‖ ≤ B) (hbB : ∀ n, ‖b n‖ ≤ B)
+    (hsmall : Tendsto (fun n ↦ ‖a n - b n‖) atTop (𝓝 0))
+    (happrox : ∀ n z, 2 * ‖a n - b n‖ ≤ ‖z - b n‖ →
+      ‖correctedPrincipalPart (P n) (N n) (a n) (b n) z‖ < (1 / 2 : ℝ) ^ n) :
+    let G := fun w ↦ ∑' n, correctedPrincipalPartAtInfinity (P n) (N n) (a n) (b n) w
+    AnalyticAt ℂ G 0 ∧ G 0 = 0 ∧
+      ∀ w, w ≠ 0 → G w = ∑' n, correctedPrincipalPart (P n) (N n) (a n) (b n) (1 / w) := by
+  obtain ⟨ρa, hρa, hρa1, ha⟩ := exists_infinity_disc_denominator_lower_bound a B hB haB
+  obtain ⟨ρb, hρb, hρb1, hb⟩ := exists_infinity_disc_denominator_lower_bound b B hB hbB
+  let ρ := min ρa ρb
+  have hρ : 0 < ρ := lt_min hρa hρb
+  have hρ1 : ρ ≤ 1 := (min_le_left _ _).trans hρa1
+  have hbound : ∀ᶠ n in atTop, ∀ w ∈ closedBall (0 : ℂ) ρ,
+      ‖correctedPrincipalPartAtInfinity (P n) (N n) (a n) (b n) w‖ ≤ (1 / 2 : ℝ) ^ n := by
+    filter_upwards [(tendsto_order.mp hsmall).2 (1 / 4) (by norm_num)] with n hn w hw
+    have hwρ : ‖w‖ ≤ ρ := by simpa only [mem_closedBall, dist_zero_right] using hw
+    by_cases hw0 : w = 0
+    · simp [hw0, pow_nonneg]
+    · rw [correctedPrincipalPartAtInfinity_eq (P n) (N n) (a n) (b n) hw0]
+      exact (happrox n (1 / w) (infinity_exterior_of_small_difference hw0 (hwρ.trans hρ1)
+        (hb n w (hwρ.trans (min_le_right _ _))) hn.le)).le
+  have hconv := tendstoUniformlyOn_tsum_nat_eventually
+    (summable_geometric_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num)) hbound
+  have han : ∀ n, AnalyticOnNhd ℂ
+      (correctedPrincipalPartAtInfinity (P n) (N n) (a n) (b n)) (ball 0 ρ) := by
+    intro n w hw
+    have hwρ : ‖w‖ ≤ ρ := (by simpa only [mem_ball, dist_zero_right] using hw : ‖w‖ < ρ).le
+    apply correctedPrincipalPartAtInfinity_analyticAt
+    · exact norm_pos_iff.mp ((by norm_num : (0 : ℝ) < 1 / 2).trans_le
+        (ha n w (hwρ.trans (min_le_left _ _))))
+    · exact norm_pos_iff.mp ((by norm_num : (0 : ℝ) < 1 / 2).trans_le
+        (hb n w (hwρ.trans (min_le_right _ _))))
+  have hhol := (hconv.tendstoLocallyUniformlyOn.mono ball_subset_closedBall).differentiableOn
+    (Eventually.of_forall fun M ↦ DifferentiableOn.fun_sum
+      fun n _ ↦ (han n).differentiableOn) isOpen_ball
+  refine ⟨(hhol.analyticOnNhd isOpen_ball) 0 (mem_ball_self hρ), ?_, ?_⟩
+  · simp
+  · intro w hw
+    exact tsum_congr fun n ↦ correctedPrincipalPartAtInfinity_eq (P n) (N n) (a n) (b n) hw
+
+#print axioms reciprocal_at_infinity_eq
+#print axioms reciprocalExpansionAtInfinity_eq
+#print axioms correctedPrincipalPartAtInfinity_eq
+#print axioms correctedPrincipalPartAtInfinity_zero
+#print axioms correctedPrincipalPartAtInfinity_analyticAt
+#print axioms infinity_exterior_of_small_difference
+#print axioms principal_part_series_analytic_at_infinity
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/MittagLefflerKernelWork.lean b/books/rudin-real-and-complex-analysis/MittagLefflerKernelWork.lean
new file mode 100644
index 0000000..a661ca8
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/MittagLefflerKernelWork.lean
@@ -0,0 +1,148 @@
+import Mathlib.Analysis.Complex.Basic
+import Mathlib.Analysis.Analytic.Polynomial
+import Mathlib.Analysis.SpecificLimits.Normed
+import Mathlib.Topology.Algebra.Polynomial
+import Mathlib.Topology.UniformSpace.HeineCantor
+import Mathlib.Tactic.FieldSimp
+import Mathlib.Tactic.Ring
+import Mathlib.Tactic.Linarith
+import Mathlib.Tactic.Positivity
+
+/-!
+Explicit rational approximations for the Mittag-Leffler construction underlying
+15.13. No Runge or Mittag-Leffler existence theorem is assumed. The finite
+geometric expansion moves an approximate simple pole from a to the omitted
+point b, with a uniform geometric error outside a controlled disc about b.
+-/
+
+noncomputable section
+open Filter Finset Set Metric
+open scoped Topology
+
+namespace RudinRCA.Chapter15
+
+def reciprocalExpansion (N : ℕ) (a b z : ℂ) : ℂ :=
+  ∑ k ∈ range N, ((a - b) / (z - b)) ^ k / (z - b)
+
+/-- Exact remainder after replacing a simple pole at a by poles at b. -/
+theorem reciprocalExpansion_error (N : ℕ) (a b z : ℂ)
+    (hza : z ≠ a) (hzb : z ≠ b) :
+    1 / (z - a) - reciprocalExpansion N a b z =
+      ((a - b) / (z - b)) ^ N / (z - a) := by
+  induction N with
+  | zero => simp [reciprocalExpansion]
+  | succ N hN =>
+    rw [reciprocalExpansion, sum_range_succ]
+    change 1 / (z - a) - (reciprocalExpansion N a b z +
+      ((a - b) / (z - b)) ^ N / (z - b)) = _
+    rw [sub_add_eq_sub_sub, hN, pow_succ]
+    field_simp [sub_ne_zero.mpr hza, sub_ne_zero.mpr hzb]
+    ring
+
+/-- Every approximant is analytic away from the chosen omitted point. -/
+theorem analyticAt_reciprocalExpansion (N : ℕ) (a b : ℂ) {z : ℂ} (hzb : z ≠ b) :
+    AnalyticAt ℂ (reciprocalExpansion N a b) z := by
+  have hd : AnalyticAt ℂ (fun w : ℂ ↦ w - b) z :=
+    analyticAt_id.sub analyticAt_const
+  exact Finset.analyticAt_fun_sum _ fun k _ ↦
+    ((analyticAt_const.div hd (sub_ne_zero.mpr hzb)).pow k).div hd
+      (sub_ne_zero.mpr hzb)
+
+/-- On the exterior disc used by the construction, both the true pole and its
+finite expansion stay a definite distance from their singularities. -/
+theorem reciprocalExpansion_exterior_geometry {a b z : ℂ} (hab : a ≠ b)
+    (hz : 2 * ‖a - b‖ ≤ ‖z - b‖) :
+    z ≠ a ∧ z ≠ b ∧ ‖a - b‖ ≤ ‖z - a‖ ∧
+      ‖(a - b) / (z - b)‖ ≤ (1 / 2 : ℝ) := by
+  have hD : 0 < ‖a - b‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hab)
+  have hden : 0 < ‖z - b‖ := by linarith
+  have htri : ‖z - b‖ ≤ ‖z - a‖ + ‖a - b‖ := by
+    calc
+      ‖z - b‖ = ‖(z - a) + (a - b)‖ := by congr 1; ring
+      _ ≤ ‖z - a‖ + ‖a - b‖ := norm_add_le _ _
+  have hdist : ‖a - b‖ ≤ ‖z - a‖ := by linarith
+  refine ⟨sub_ne_zero.mp (norm_pos_iff.mp (hD.trans_le hdist)),
+    sub_ne_zero.mp (norm_pos_iff.mp hden), hdist, ?_⟩
+  rw [norm_div, div_le_iff₀ hden]
+  linarith
+
+theorem norm_reciprocalExpansion_error_le (N : ℕ) {a b z : ℂ} (hab : a ≠ b)
+    (hz : 2 * ‖a - b‖ ≤ ‖z - b‖) :
+    ‖1 / (z - a) - reciprocalExpansion N a b z‖ ≤
+      (1 / 2 : ℝ) ^ N / ‖a - b‖ := by
+  obtain ⟨hza, hzb, hdist, hratio⟩ := reciprocalExpansion_exterior_geometry hab hz
+  have hD : 0 < ‖a - b‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hab)
+  rw [reciprocalExpansion_error N a b z hza hzb, norm_div, norm_pow]
+  calc
+    ‖(a - b) / (z - b)‖ ^ N / ‖z - a‖ ≤ (1 / 2 : ℝ) ^ N / ‖z - a‖ :=
+      div_le_div_of_nonneg_right (pow_le_pow_left₀ (norm_nonneg _) hratio N) (norm_nonneg _)
+    _ ≤ (1 / 2 : ℝ) ^ N / ‖a - b‖ :=
+      div_le_div_of_nonneg_left (pow_nonneg (by norm_num) _) hD hdist
+
+/-- Uniform simple-pole approximation on the whole exterior region, rather than
+only on a particular compact set. -/
+theorem reciprocalExpansion_tendstoUniformlyOn {a b : ℂ} (hab : a ≠ b) :
+    TendstoUniformlyOn (fun N z ↦ reciprocalExpansion N a b z)
+      (fun z ↦ 1 / (z - a)) atTop {z : ℂ | 2 * ‖a - b‖ ≤ ‖z - b‖} := by
+  have hlim : Tendsto (fun N : ℕ ↦ (1 / 2 : ℝ) ^ N / ‖a - b‖) atTop (𝓝 0) := by
+    simpa using (tendsto_pow_atTop_nhds_zero_of_lt_one
+      (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 / 2 : ℝ) < 1)).div_const ‖a - b‖
+  apply Metric.tendstoUniformlyOn_iff.mpr
+  intro ε hε
+  filter_upwards [(tendsto_order.mp hlim).2 ε hε] with N hN z hz
+  rw [dist_eq_norm]
+  exact (norm_reciprocalExpansion_error_le N hab hz).trans_lt hN
+
+theorem reciprocalExpansion_uniform_bounds (N : ℕ) {a b z : ℂ} (hab : a ≠ b)
+    (hz : 2 * ‖a - b‖ ≤ ‖z - b‖) :
+    ‖1 / (z - a)‖ ≤ 2 / ‖a - b‖ ∧
+      ‖reciprocalExpansion N a b z‖ ≤ 2 / ‖a - b‖ := by
+  have hD : 0 < ‖a - b‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hab)
+  have hdist := (reciprocalExpansion_exterior_geometry hab hz).2.2.1
+  have hinv : ‖1 / (z - a)‖ ≤ 1 / ‖a - b‖ := by
+    rw [norm_div, norm_one]
+    exact one_div_le_one_div_of_le hD hdist
+  have herr : ‖1 / (z - a) - reciprocalExpansion N a b z‖ ≤ 1 / ‖a - b‖ :=
+    (norm_reciprocalExpansion_error_le N hab hz).trans
+      (div_le_div_of_nonneg_right (pow_le_one₀ (by norm_num) (by norm_num)) hD.le)
+  constructor
+  · exact hinv.trans (div_le_div_of_nonneg_right (by norm_num) hD.le)
+  · calc
+      ‖reciprocalExpansion N a b z‖ =
+          ‖(reciprocalExpansion N a b z - 1 / (z - a)) + 1 / (z - a)‖ := by
+            congr 1; ring
+      _ ≤ ‖reciprocalExpansion N a b z - 1 / (z - a)‖ + ‖1 / (z - a)‖ := norm_add_le _ _
+      _ ≤ 1 / ‖a - b‖ + 1 / ‖a - b‖ := by
+        rw [norm_sub_rev]
+        exact add_le_add herr hinv
+      _ = 2 / ‖a - b‖ := by ring
+
+/-- Every finite principal-part polynomial has an arbitrarily accurate rational
+approximation with poles only at b. This is the approximation step needed in the
+direct Mittag-Leffler series; it does not assume a global approximation theorem. -/
+theorem exists_polynomial_reciprocal_approximation (P : Polynomial ℂ)
+    {a b : ℂ} (hab : a ≠ b) {ε : ℝ} (hε : 0 < ε) :
+    ∃ N : ℕ, ∀ z : ℂ, 2 * ‖a - b‖ ≤ ‖z - b‖ →
+      ‖P.eval (1 / (z - a)) - P.eval (reciprocalExpansion N a b z)‖ < ε := by
+  have huc : UniformContinuousOn P.eval (closedBall 0 (2 / ‖a - b‖)) :=
+    (isCompact_closedBall (0 : ℂ) (2 / ‖a - b‖)).uniformContinuousOn_of_continuous P.continuousOn
+  obtain ⟨δ, hδ, hdist⟩ := Metric.uniformContinuousOn_iff.mp huc ε hε
+  obtain ⟨N, hN⟩ := (Metric.tendstoUniformlyOn_iff.mp
+    (reciprocalExpansion_tendstoUniformlyOn hab) δ hδ).exists
+  refine ⟨N, fun z hz ↦ ?_⟩
+  obtain ⟨htrue, happ⟩ := reciprocalExpansion_uniform_bounds N hab hz
+  have htrue' : 1 / (z - a) ∈ closedBall 0 (2 / ‖a - b‖) := by
+    simpa only [mem_closedBall, dist_zero_right] using htrue
+  have happ' : reciprocalExpansion N a b z ∈ closedBall 0 (2 / ‖a - b‖) := by
+    simpa only [mem_closedBall, dist_zero_right] using happ
+  simpa only [dist_eq_norm] using hdist _ htrue' _ happ' (hN z hz)
+
+#print axioms reciprocalExpansion_error
+#print axioms analyticAt_reciprocalExpansion
+#print axioms reciprocalExpansion_exterior_geometry
+#print axioms norm_reciprocalExpansion_error_le
+#print axioms reciprocalExpansion_tendstoUniformlyOn
+#print axioms reciprocalExpansion_uniform_bounds
+#print axioms exists_polynomial_reciprocal_approximation
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/MittagLefflerSeriesWork.lean b/books/rudin-real-and-complex-analysis/MittagLefflerSeriesWork.lean
new file mode 100644
index 0000000..1cb1fa5
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/MittagLefflerSeriesWork.lean
@@ -0,0 +1,275 @@
+import MittagLefflerKernelWork
+import BoundaryProductGeometryWork
+import Mathlib.Analysis.Complex.LocallyUniformLimit
+import Mathlib.Analysis.Meromorphic.Basic
+import Mathlib.Analysis.Normed.Group.FunctionSeries
+
+/-!
+Direct Mittag-Leffler construction on a normalized plane domain. The omitted
+closed set is nonempty, and the poles have chosen boundary points whose distance
+tends to zero. These geometric hypotheses are supplied by domain normalization;
+no Mittag-Leffler or approximation existence theorem is assumed here.
+
+Draft: all declarations in this file still await the serialized Lean check.
+-/
+
+noncomputable section
+open Filter Finset Set Metric
+open scoped Topology
+
+namespace RudinRCA.Chapter15
+
+/-- Finite principal-part polynomials preserve meromorphicity. -/
+theorem meromorphicAt_polynomial_eval {f : ℂ → ℂ} {z : ℂ}
+    (hf : MeromorphicAt f z) (P : Polynomial ℂ) :
+    MeromorphicAt (fun w ↦ P.eval (f w)) z := by
+  induction P using Polynomial.induction_on' with
+  | add P Q hP hQ => simpa only [Polynomial.eval_add] using hP.add hQ
+  | monomial n c =>
+    simpa only [Polynomial.eval_monomial] using (MeromorphicAt.const c z).mul (hf.pow n)
+
+/-- A uniformly convergent complex series remains uniformly convergent after
+removing an arbitrary finite prefix. -/
+theorem uniformOn_complex_series_tail {S : Type*} {K : Set S}
+    (u : ℕ → S → ℂ) (A : S → ℂ)
+    (hconv : TendstoUniformlyOn (fun n s ↦ ∑ i ∈ range n, u i s) A atTop K)
+    (N : ℕ) :
+    TendstoUniformlyOn (fun n s ↦ ∑ i ∈ range n, u (i + N) s)
+      (fun s ↦ A s - ∑ i ∈ range N, u i s) atTop K := by
+  apply Metric.tendstoUniformlyOn_iff.2
+  intro ε hε
+  have hshift := (tendsto_add_atTop_nat N).eventually
+    (Metric.tendstoUniformlyOn_iff.1 hconv ε hε)
+  filter_upwards [hshift] with n hn s hs
+  have hsum : (∑ i ∈ range (n + N), u i s) =
+      (∑ i ∈ range N, u i s) + ∑ i ∈ range n, u (i + N) s := by
+    simpa [Nat.add_comm] using sum_range_add (fun i ↦ u i s) N n
+  have hdist : dist (A s - ∑ i ∈ range N, u i s)
+      (∑ i ∈ range n, u (i + N) s) =
+      dist (A s) (∑ i ∈ range (n + N), u i s) := by
+    rw [dist_eq_norm, dist_eq_norm, hsum]
+    congr 1
+    ring
+  rw [hdist]
+  exact hn s hs
+
+theorem locallyUniform_complex_series_tail {Ω : Set ℂ}
+    (hΩ : IsOpen Ω) (u : ℕ → ℂ → ℂ) (A : ℂ → ℂ)
+    (hconv : TendstoLocallyUniformlyOn (fun n s ↦ ∑ i ∈ range n, u i s) A atTop Ω)
+    (N : ℕ) :
+    TendstoLocallyUniformlyOn (fun n s ↦ ∑ i ∈ range n, u (i + N) s)
+      (fun s ↦ A s - ∑ i ∈ range N, u i s) atTop Ω := by
+  apply (tendstoLocallyUniformlyOn_iff_forall_isCompact hΩ).2
+  intro K hKΩ hK
+  exact uniformOn_complex_series_tail u A
+    ((tendstoLocallyUniformlyOn_iff_forall_isCompact hΩ).1 hconv K hKΩ hK) N
+
+/-- Uniform convergence and analyticity of all sufficiently late summands on a
+neighborhood make the remainder after a finite prefix analytic there. -/
+theorem analyticOnNhd_series_remainder {Ω V : Set ℂ}
+    (hΩ : IsOpen Ω) (hV : IsOpen V) (hVΩ : V ⊆ Ω)
+    {u : ℕ → ℂ → ℂ} {A : ℂ → ℂ}
+    (hconv : TendstoLocallyUniformlyOn (fun n s ↦ ∑ i ∈ range n, u i s) A atTop Ω)
+    (N : ℕ) (hu : ∀ n, AnalyticOnNhd ℂ (u (n + N)) V) :
+    AnalyticOnNhd ℂ (fun s ↦ A s - ∑ i ∈ range N, u i s) V := by
+  have hlim := (locallyUniform_complex_series_tail hΩ u A hconv N).mono hVΩ
+  apply (hlim.differentiableOn _ hV).analyticOnNhd hV
+  exact Eventually.of_forall fun M ↦ DifferentiableOn.fun_sum
+    fun n _ ↦ (hu n).differentiableOn
+
+/-- Every compact part of the domain eventually lies in the exterior region
+on which the explicit principal-part approximation is small. -/
+theorem boundary_exteriors_contain_compacts (a b : ℕ → ℂ) {C K : Set ℂ}
+    (hC : IsClosed C) (hCne : C.Nonempty) (hb : ∀ n, b n ∈ C)
+    (hsmall : Tendsto (fun n ↦ ‖a n - b n‖) atTop (𝓝 0))
+    (hK : IsCompact K) (hKC : K ⊆ Cᶜ) :
+    ∀ᶠ n in atTop, ∀ z ∈ K, 2 * ‖a n - b n‖ ≤ ‖z - b n‖ := by
+  obtain ⟨δ, hδ, hδK⟩ := compact_infDist_lower_bound hC hCne hK hKC
+  filter_upwards [(tendsto_order.mp hsmall).2 (δ / 2) (half_pos hδ)] with n hn z hz
+  have hden : δ ≤ ‖z - b n‖ :=
+    (hδK z hz).trans (by simpa only [dist_eq_norm] using infDist_le_dist_of_mem (hb n))
+  linarith
+
+def correctedPrincipalPart (P : Polynomial ℂ) (N : ℕ) (a b z : ℂ) : ℂ :=
+  P.eval (1 / (z - a)) - P.eval (reciprocalExpansion N a b z)
+
+theorem correctedPrincipalPart_analyticAt (P : Polynomial ℂ) (N : ℕ)
+    {a b z : ℂ} (hza : z ≠ a) (hzb : z ≠ b) :
+    AnalyticAt ℂ (correctedPrincipalPart P N a b) z := by
+  have htrue : AnalyticAt ℂ (fun w : ℂ ↦ 1 / (w - a)) z :=
+    analyticAt_const.div (analyticAt_id.sub analyticAt_const) (sub_ne_zero.mpr hza)
+  exact (htrue.aeval_polynomial P).sub
+    ((analyticAt_reciprocalExpansion N a b hzb).aeval_polynomial P)
+
+theorem correctedPrincipalPart_meromorphicAt (P : Polynomial ℂ) (N : ℕ)
+    (a b z : ℂ) : MeromorphicAt (correctedPrincipalPart P N a b) z := by
+  have htrue : MeromorphicAt (fun w : ℂ ↦ 1 / (w - a)) z :=
+    (MeromorphicAt.const 1 z).div ((MeromorphicAt.id z).sub (.const a z))
+  have happ : MeromorphicAt (reciprocalExpansion N a b) z := by
+    apply MeromorphicAt.fun_sum
+    intro k _
+    exact (((MeromorphicAt.const (a - b) z).div
+      ((MeromorphicAt.id z).sub (.const b z))).pow k).div
+        ((MeromorphicAt.id z).sub (.const b z))
+  exact (meromorphicAt_polynomial_eval htrue P).sub
+    (meromorphicAt_polynomial_eval happ P)
+
+/-- The truncation orders are chosen from the proved geometric approximation,
+and the resulting series converges locally uniformly on the whole domain. -/
+theorem exists_locally_uniform_principal_part_series
+    (P : ℕ → Polynomial ℂ) (a b : ℕ → ℂ) {C : Set ℂ}
+    (hC : IsClosed C) (hCne : C.Nonempty) (ha : ∀ n, a n ∉ C)
+    (hb : ∀ n, b n ∈ C)
+    (hsmall : Tendsto (fun n ↦ ‖a n - b n‖) atTop (𝓝 0)) :
+    ∃ N : ℕ → ℕ,
+      (∀ n z, 2 * ‖a n - b n‖ ≤ ‖z - b n‖ →
+        ‖correctedPrincipalPart (P n) (N n) (a n) (b n) z‖ < (1 / 2 : ℝ) ^ n) ∧
+      TendstoLocallyUniformlyOn
+        (fun M z ↦ ∑ n ∈ range M, correctedPrincipalPart (P n) (N n) (a n) (b n) z)
+        (fun z ↦ ∑' n, correctedPrincipalPart (P n) (N n) (a n) (b n) z)
+        atTop Cᶜ := by
+  have hab : ∀ n, a n ≠ b n := fun n h ↦ ha n (h.symm ▸ hb n)
+  have happrox : ∀ n, ∃ k : ℕ, ∀ z : ℂ, 2 * ‖a n - b n‖ ≤ ‖z - b n‖ →
+      ‖correctedPrincipalPart (P n) k (a n) (b n) z‖ < (1 / 2 : ℝ) ^ n := by
+    intro n
+    exact exists_polynomial_reciprocal_approximation (P n) (hab n) (by positivity)
+  choose N hN using happrox
+  refine ⟨N, hN, (tendstoLocallyUniformlyOn_iff_forall_isCompact hC.isOpen_compl).2 ?_⟩
+  intro K hKC hK
+  apply tendstoUniformlyOn_tsum_nat_eventually
+    (summable_geometric_of_lt_one (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num))
+  filter_upwards [boundary_exteriors_contain_compacts a b hC hCne hb hsmall hK hKC]
+    with n hn z hz
+  exact (hN n z (hn z hz)).le
+
+/-- Near any domain point all sufficiently late summands are analytic. The
+finite prefix is allowed to contain actual poles. -/
+theorem correctedPrincipalPart_eventually_analytic_near
+    (P : ℕ → Polynomial ℂ) (N : ℕ → ℕ) (a b : ℕ → ℂ) {C : Set ℂ}
+    (hC : IsClosed C) (hCne : C.Nonempty) (ha : ∀ n, a n ∉ C)
+    (hb : ∀ n, b n ∈ C)
+    (hsmall : Tendsto (fun n ↦ ‖a n - b n‖) atTop (𝓝 0))
+    {z : ℂ} (hz : z ∉ C) :
+    ∃ V : Set ℂ, IsOpen V ∧ z ∈ V ∧ V ⊆ Cᶜ ∧
+      ∀ᶠ n in atTop, AnalyticOnNhd ℂ
+        (correctedPrincipalPart (P n) (N n) (a n) (b n)) V := by
+  obtain ⟨K, ⟨hKz, hK⟩, hKC⟩ :=
+    (compact_basis_nhds z).mem_iff.mp (hC.isOpen_compl.mem_nhds hz)
+  refine ⟨interior K, isOpen_interior, mem_interior_iff_mem_nhds.mpr hKz,
+    interior_subset.trans hKC, ?_⟩
+  filter_upwards [boundary_exteriors_contain_compacts a b hC hCne hb hsmall hK hKC]
+    with n hn w hw
+  have hab : a n ≠ b n := fun h ↦ ha n (h.symm ▸ hb n)
+  obtain ⟨hwa, hwb, _⟩ := reciprocalExpansion_exterior_geometry hab (hn w (interior_subset hw))
+  exact correctedPrincipalPart_analyticAt (P n) (N n) hwa hwb
+
+/-- A locally uniform series with an analytic tail and meromorphic summands
+has a meromorphic sum. This retains the finite principal parts. -/
+theorem meromorphicAt_of_locally_uniform_series
+    {Ω : Set ℂ} (hΩ : IsOpen Ω) {u : ℕ → ℂ → ℂ} {A : ℂ → ℂ}
+    (hconv : TendstoLocallyUniformlyOn (fun n s ↦ ∑ i ∈ range n, u i s) A atTop Ω)
+    {z : ℂ} (hu : ∀ n, MeromorphicAt (u n) z)
+    (htail : ∃ V : Set ℂ, IsOpen V ∧ z ∈ V ∧ V ⊆ Ω ∧
+      ∀ᶠ n in atTop, AnalyticOnNhd ℂ (u n) V) : MeromorphicAt A z := by
+  obtain ⟨V, hV, hzV, hVΩ, htail⟩ := htail
+  obtain ⟨N, hN⟩ := eventually_atTop.1 htail
+  have hrem := analyticOnNhd_series_remainder hΩ hV hVΩ hconv N
+    (fun n ↦ hN (n + N) (Nat.le_add_left N n)) z hzV
+  have hprefix : MeromorphicAt (fun w ↦ ∑ n ∈ range N, u n w) z :=
+    MeromorphicAt.fun_sum fun n _ ↦ hu n
+  convert hrem.meromorphicAt.add hprefix using 1
+  ext w
+  exact (sub_add_cancel _ _).symm
+
+/-- If all other summands are analytic at z, removing the selected summand
+removes the whole principal part of the series there. -/
+theorem analyticAt_of_locally_uniform_series
+    {Ω : Set ℂ} (hΩ : IsOpen Ω) {u : ℕ → ℂ → ℂ} {A : ℂ → ℂ}
+    (hconv : TendstoLocallyUniformlyOn (fun n s ↦ ∑ i ∈ range n, u i s) A atTop Ω)
+    {z : ℂ} (hu : ∀ n, AnalyticAt ℂ (u n) z)
+    (htail : ∃ V : Set ℂ, IsOpen V ∧ z ∈ V ∧ V ⊆ Ω ∧
+      ∀ᶠ n in atTop, AnalyticOnNhd ℂ (u n) V) : AnalyticAt ℂ A z := by
+  obtain ⟨V, hV, hzV, hVΩ, htail⟩ := htail
+  obtain ⟨N, hN⟩ := eventually_atTop.1 htail
+  have hrem := analyticOnNhd_series_remainder hΩ hV hVΩ hconv N
+    (fun n ↦ hN (n + N) (Nat.le_add_left N n)) z hzV
+  have hprefix : AnalyticAt ℂ (fun w ↦ ∑ n ∈ range N, u n w) z :=
+    Finset.analyticAt_fun_sum _ fun n _ ↦ hu n
+  convert hrem.add hprefix using 1
+  ext w
+  exact (sub_add_cancel _ _).symm
+
+/-- Removing one term from the sum preserves every other analytic germ. -/
+theorem analyticAt_series_sub_term
+    {Ω : Set ℂ} (hΩ : IsOpen Ω) {u : ℕ → ℂ → ℂ} {A : ℂ → ℂ}
+    (hconv : TendstoLocallyUniformlyOn (fun n s ↦ ∑ i ∈ range n, u i s) A atTop Ω)
+    {z : ℂ} (j : ℕ) (hu : ∀ n, n ≠ j → AnalyticAt ℂ (u n) z)
+    (htail : ∃ V : Set ℂ, IsOpen V ∧ z ∈ V ∧ V ⊆ Ω ∧
+      ∀ᶠ n in atTop, AnalyticOnNhd ℂ (u n) V) :
+    AnalyticAt ℂ (fun w ↦ A w - u j w) z := by
+  obtain ⟨V, hV, hzV, hVΩ, htail⟩ := htail
+  obtain ⟨N, hN⟩ := eventually_atTop.1 htail
+  let M := max N (j + 1)
+  have hjM : j ∈ range M := mem_range.2 (lt_of_lt_of_le (Nat.lt_succ_self j) (le_max_right _ _))
+  have hrem := analyticOnNhd_series_remainder hΩ hV hVΩ hconv M
+    (fun n ↦ hN (n + M) ((le_max_left _ _).trans (Nat.le_add_left M n))) z hzV
+  have hprefix : AnalyticAt ℂ (fun w ↦ ∑ n ∈ (range M).erase j, u n w) z :=
+    Finset.analyticAt_fun_sum _ fun n hn ↦ hu n (mem_erase.mp hn).1
+  convert hrem.add hprefix using 1
+  ext w
+  have hsum := sum_erase_add (range M) (fun n ↦ u n w) hjM
+  dsimp only
+  rw [← hsum]
+  ring
+
+/-- The normalized Mittag-Leffler conclusion, including each prescribed
+principal part. Injectivity says each distinct pole is listed once; arbitrary
+finite pole order is stored in its polynomial. -/
+theorem exists_normalized_mittag_leffler
+    (P : ℕ → Polynomial ℂ) (a b : ℕ → ℂ) {C : Set ℂ}
+    (hC : IsClosed C) (hCne : C.Nonempty) (ha : ∀ n, a n ∉ C)
+    (hb : ∀ n, b n ∈ C) (hainj : Function.Injective a)
+    (hsmall : Tendsto (fun n ↦ ‖a n - b n‖) atTop (𝓝 0)) :
+    ∃ F : ℂ → ℂ, MeromorphicOn F Cᶜ ∧
+      ∀ j, AnalyticAt ℂ (fun z ↦ F z - (P j).eval (1 / (z - a j))) (a j) := by
+  obtain ⟨N, _, hconv⟩ :=
+    exists_locally_uniform_principal_part_series P a b hC hCne ha hb hsmall
+  let u := fun n z ↦ correctedPrincipalPart (P n) (N n) (a n) (b n) z
+  let F := fun z ↦ ∑' n, u n z
+  have htail := fun z hz ↦
+    correctedPrincipalPart_eventually_analytic_near P N a b hC hCne ha hb hsmall (z := z) hz
+  refine ⟨F, ?_, ?_⟩
+  · intro z hz
+    exact meromorphicAt_of_locally_uniform_series hC.isOpen_compl hconv
+      (fun n ↦ correctedPrincipalPart_meromorphicAt (P n) (N n) (a n) (b n) z)
+      (htail z hz)
+  · intro j
+    have hother : ∀ n, n ≠ j → AnalyticAt ℂ (u n) (a j) := by
+      intro n hnj
+      exact correctedPrincipalPart_analyticAt (P n) (N n)
+        (fun h ↦ hnj (hainj h.symm)) (fun h ↦ ha j (h.symm ▸ hb n))
+    have hsub := analyticAt_series_sub_term hC.isOpen_compl hconv j hother (htail (a j) (ha j))
+    have happ : AnalyticAt ℂ (fun z ↦ (P j).eval (reciprocalExpansion (N j) (a j) (b j) z))
+        (a j) :=
+      (analyticAt_reciprocalExpansion (N j) (a j) (b j)
+        (fun h ↦ ha j (h.symm ▸ hb j))).aeval_polynomial (P j)
+    convert hsub.sub happ using 1
+    ext z
+    dsimp [u, correctedPrincipalPart]
+    ring
+
+#print axioms meromorphicAt_polynomial_eval
+#print axioms uniformOn_complex_series_tail
+#print axioms locallyUniform_complex_series_tail
+#print axioms analyticOnNhd_series_remainder
+#print axioms boundary_exteriors_contain_compacts
+#print axioms correctedPrincipalPart_analyticAt
+#print axioms correctedPrincipalPart_meromorphicAt
+#print axioms exists_locally_uniform_principal_part_series
+#print axioms correctedPrincipalPart_eventually_analytic_near
+#print axioms meromorphicAt_of_locally_uniform_series
+#print axioms analyticAt_of_locally_uniform_series
+#print axioms analyticAt_series_sub_term
+#print axioms exists_normalized_mittag_leffler
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/MittagLefflerSetWork.lean b/books/rudin-real-and-complex-analysis/MittagLefflerSetWork.lean
new file mode 100644
index 0000000..54cb9cd
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/MittagLefflerSetWork.lean
@@ -0,0 +1,148 @@
+import MittagLefflerInfinityWork
+import ZeroSetNormalizationWork
+import Mathlib.Basic.Denumerable
+
+/-! Set-indexed normalized Mittag-Leffler construction, including finite and
+empty sets and regularity at infinity. Draft awaiting a serialized Lean check. -/
+
+noncomputable section
+open Filter Set Finset Metric Bornology
+open scoped Topology OnePoint
+
+namespace RudinRCA.Chapter15
+
+def principalPartOnSphere (P : Polynomial ℂ) (a : ℂ) (p : ComplexSphere) : ℂ :=
+  p.elim (P.eval 0) (fun z ↦ P.eval (1 / (z - a)))
+
+theorem principalPartOnSphere_infinity_chart (P : Polynomial ℂ) (a : ℂ) :
+    principalPartOnSphere P a ∘ sphereInfinityChart =
+      fun w ↦ P.eval (w / (1 - a * w)) := by
+  funext w
+  by_cases hw : w = 0
+  · subst w; simp [principalPartOnSphere]
+  · simp only [Function.comp_def, sphereInfinityChart_of_ne_zero hw, principalPartOnSphere,
+      OnePoint.elim_some, ← one_div, ← reciprocal_at_infinity_eq hw]
+
+theorem principalPartOnSphere_analytic_infinity (P : Polynomial ℂ) (a : ℂ) :
+    SphereAnalyticAt (principalPartOnSphere P a) ∞ := by
+  rw [sphereAnalyticAt_infty, principalPartOnSphere_infinity_chart]
+  exact (analyticAt_id.div
+    (analyticAt_const.sub (analyticAt_const.mul analyticAt_id)) (by simp)).aeval_polynomial P
+
+/-- The normalized Mittag-Leffler theorem for a bounded discrete set. The
+function is analytic at infinity and away from the specified finite poles. -/
+theorem normalized_mittag_leffler_on_set {C S : Set ℂ}
+    (hC : IsCompact C) (hCne : C.Nonempty) (hS : S ⊆ Cᶜ)
+    (hScount : S.Countable) (hSbound : IsBounded S)
+    (hno : ∀ z ∈ Cᶜ, ¬ AccPt z (𝓟 S)) (P : S → Polynomial ℂ) :
+    ∃ F : ComplexSphere → ℂ,
+      MeromorphicOn (fun z ↦ F (↑z)) Cᶜ ∧
+      SphereAnalyticAt F ∞ ∧
+      (∀ z ∈ Cᶜ, z ∉ S → AnalyticAt ℂ (fun w ↦ F (↑w)) z) ∧
+      ∀ a : S, AnalyticAt ℂ
+        (fun z ↦ F (↑z) - (P a).eval (1 / (z - a))) a := by
+  classical
+  cases finite_or_infinite S with
+  | inl hfinite =>
+    letI := hfinite
+    letI : Fintype S := Fintype.ofFinite S
+    let F : ComplexSphere → ℂ := fun p ↦ ∑ a : S, principalPartOnSphere (P a) a p
+    refine ⟨F, ?_, ?_, ?_, ?_⟩
+    · intro z hz
+      exact MeromorphicAt.fun_sum fun a _ ↦ meromorphicAt_polynomial_eval
+        ((MeromorphicAt.const 1 z).div ((MeromorphicAt.id z).sub (.const a z))) (P a)
+    · change AnalyticAt ℂ (fun w ↦ ∑ a : S, principalPartOnSphere (P a) a (sphereInfinityChart w)) 0
+      exact Finset.analyticAt_fun_sum _ fun a _ ↦ principalPartOnSphere_analytic_infinity (P a) a
+    · intro z hz hzS
+      apply Finset.analyticAt_fun_sum
+      intro a _
+      have hza : z ≠ a := fun h ↦ hzS (h.symm ▸ a.property)
+      exact (analyticAt_const.div (analyticAt_id.sub analyticAt_const)
+        (sub_ne_zero.mpr hza)).aeval_polynomial (P a)
+    · intro a
+      have hsum : AnalyticAt ℂ
+          (fun z ↦ ∑ b ∈ (univ : Finset S).erase a, (P b).eval (1 / (z - b))) a := by
+        apply Finset.analyticAt_fun_sum
+        intro b hb
+        have hab : (a : ℂ) ≠ b := fun h ↦ (mem_erase.mp hb).1 (Subtype.ext h).symm
+        exact (analyticAt_const.div (analyticAt_id.sub analyticAt_const)
+          (sub_ne_zero.mpr hab)).aeval_polynomial (P b)
+      convert hsum using 1
+      ext z
+      dsimp [F, principalPartOnSphere]
+      exact (sub_eq_iff_eq_add).2 (sum_erase_add univ
+        (fun b : S ↦ (P b).eval (1 / (z - b))) (mem_univ a)).symm
+  | inr hinfinite =>
+    letI := hinfinite
+    haveI : Countable S := hScount.to_subtype
+    let e : ℕ ≃ S := Classical.choice inferInstance
+    let a : ℕ → ℂ := fun n ↦ e n
+    have haS (n : ℕ) : a n ∈ S := (e n).property
+    have ha (n : ℕ) : a n ∉ C := hS (haS n)
+    have hainj : Function.Injective a := Subtype.val_injective.comp e.injective
+    have hescape : ∀ K : Set ℂ, IsCompact K → K ⊆ Cᶜ →
+        ∀ᶠ n in atTop, a n ∉ K := by
+      intro K hK hKC
+      have hSK := finite_inter_compact_of_no_accumulation hno hK hKC
+      have hpre : (a ⁻¹' (S ∩ K)).Finite := hSK.preimage hainj.injOn
+      have hpre' : {n : ℕ | a n ∈ K}.Finite := hpre.subset fun n hn ↦ ⟨haS n, hn⟩
+      simpa only [Nat.cofinite_eq_atTop] using hpre'.eventually_cofinite_notMem
+    choose b hb hnearest using (fun n ↦ hC.exists_infDist_eq_dist hCne (a n))
+    obtain ⟨Ra, hRa, hbounda⟩ := hSbound.exists_pos_norm_le
+    obtain ⟨Rb, hRb, hboundb⟩ := hC.isBounded.exists_pos_norm_le
+    have hd := infDist_tendsto_zero_of_bounded_escape a C Ra
+      (fun n ↦ hbounda (a n) (haS n)) hescape
+    have hsmall := nearest_boundary_difference_tendsto_zero a b C hnearest hd
+    let Q : ℕ → Polynomial ℂ := fun n ↦ P (e n)
+    obtain ⟨N, happrox, hconv⟩ :=
+      exists_locally_uniform_principal_part_series Q a b hC.isClosed hCne ha hb hsmall
+    let u := fun n z ↦ correctedPrincipalPart (Q n) (N n) (a n) (b n) z
+    let F : ComplexSphere → ℂ := fun p ↦ p.elim 0 (fun z ↦ ∑' n, u n z)
+    have htail := fun z hz ↦ correctedPrincipalPart_eventually_analytic_near Q N a b
+      hC.isClosed hCne ha hb hsmall (z := z) hz
+    have hinfty := principal_part_series_analytic_at_infinity Q N a b (max Ra Rb)
+      (hRa.trans_le (le_max_left _ _))
+      (fun n ↦ (hbounda (a n) (haS n)).trans (le_max_left _ _))
+      (fun n ↦ (hboundb (b n) (hb n)).trans (le_max_right _ _)) hsmall happrox
+    refine ⟨F, ?_, ?_, ?_, ?_⟩
+    · intro z hz
+      exact meromorphicAt_of_locally_uniform_series hC.isClosed.isOpen_compl hconv
+        (fun n ↦ correctedPrincipalPart_meromorphicAt (Q n) (N n) (a n) (b n) z)
+        (htail z hz)
+    · change AnalyticAt ℂ (F ∘ sphereInfinityChart) 0
+      have heq : F ∘ sphereInfinityChart = fun w ↦
+          ∑' n, correctedPrincipalPartAtInfinity (Q n) (N n) (a n) (b n) w := by
+        funext w
+        by_cases hw : w = 0
+        · subst w; simp [F]
+        · simp only [Function.comp_def, sphereInfinityChart_of_ne_zero hw, F, OnePoint.elim_some]
+          simpa only [one_div] using (hinfty.2.2 w hw).symm
+      rw [heq]
+      exact hinfty.1
+    · intro z hz hzS
+      apply analyticAt_of_locally_uniform_series hC.isClosed.isOpen_compl hconv _ (htail z hz)
+      intro n
+      exact correctedPrincipalPart_analyticAt (Q n) (N n)
+        (fun h ↦ hzS (h.symm ▸ haS n)) (fun h ↦ hz (h.symm ▸ hb n))
+    · intro aj
+      obtain ⟨j, rfl⟩ := e.surjective aj
+      have hother : ∀ n, n ≠ j → AnalyticAt ℂ (u n) (a j) := by
+        intro n hnj
+        exact correctedPrincipalPart_analyticAt (Q n) (N n)
+          (fun h ↦ hnj (hainj h.symm)) (fun h ↦ ha j (h.symm ▸ hb n))
+      have hsub := analyticAt_series_sub_term hC.isClosed.isOpen_compl hconv j hother
+        (htail (a j) (ha j))
+      have happ : AnalyticAt ℂ (fun z ↦ (Q j).eval (reciprocalExpansion (N j) (a j) (b j) z))
+          (a j) :=
+        (analyticAt_reciprocalExpansion (N j) (a j) (b j)
+          (fun h ↦ ha j (h.symm ▸ hb j))).aeval_polynomial (Q j)
+      convert hsub.sub happ using 1
+      ext z
+      dsimp [F, u, Q, a, correctedPrincipalPart]
+      ring
+
+#print axioms principalPartOnSphere_infinity_chart
+#print axioms principalPartOnSphere_analytic_infinity
+#print axioms normalized_mittag_leffler_on_set
+
+end RudinRCA.Chapter15
