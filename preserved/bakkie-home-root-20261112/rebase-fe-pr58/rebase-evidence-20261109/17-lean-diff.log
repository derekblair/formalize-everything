index 0000000..c490881
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/BlaschkeNecessityWork.lean
@@ -0,0 +1,292 @@
+import NevanlinnaWork
+import Mathlib.Analysis.Complex.JensenFormula
+import Mathlib.Topology.Algebra.InfiniteSum.Real
+import Mathlib.Tactic.FunProp
+import Mathlib.Tactic.NormNum
+import Mathlib.Tactic.Positivity
+import Mathlib.Tactic.Ring
+import Mathlib.Tactic.FieldSimp
+import Mathlib.Tactic.Linarith
+
+noncomputable section
+
+open Filter Metric Real Set
+open scoped Topology
+
+namespace RudinRCA.Chapter15.BlaschkeNecessityWork
+
+theorem divisor_eq_analyticOrderNatAt {f : ℂ → ℂ} {r : ℝ}
+    (hf : AnalyticOnNhd ℂ f (closedBall 0 r)) {z : ℂ} (hz : z ∈ closedBall 0 r) :
+    MeromorphicOn.divisor f (closedBall 0 r) z = (analyticOrderNatAt f z : ℤ) := by
+  rw [hf.divisor_apply hz]
+  by_cases ht : analyticOrderAt f z = ⊤
+  · simp [analyticOrderNatAt, ht]
+  · rw [← Nat.cast_analyticOrderNatAt ht]
+    simp
+
+/-- A finite list may use each zero at most its actual multiplicity. -/
+def CountsAtMostOrders (f : ℂ → ℂ) (a : ℕ → ℂ) : Prop := by
+  classical
+  exact ∀ z ∈ ball (0 : ℂ) 1, ∀ s : Finset ℕ,
+    (s.filter fun n ↦ a n = z).card ≤ analyticOrderNatAt f z
+
+theorem countsAtMostOrders_of_hasSum {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hcount : ∀ z ∈ ball (0 : ℂ) 1,
+      HasSum (fun n ↦ if a n = z then (1 : ℕ) else 0) (analyticOrderNatAt f z)) :
+    CountsAtMostOrders f a := by
+  classical
+  intro z hz s
+  simpa only [Finset.sum_boole] using
+    sum_le_hasSum s (fun n _ ↦ Nat.zero_le _) (hcount z hz)
+
+theorem finite_fiber_weight_sum (s : Finset ℕ) (a : ℕ → ℂ) (w : ℂ → ℝ) :
+    ∑ᶠ z, ((s.filter fun n ↦ a n = z).card : ℝ) * w z = ∑ n ∈ s, w (a n) := by
+  classical
+  have heq (z : ℂ) : (∑ n ∈ s.filter (fun n ↦ a n = z), w (a n)) =
+      ((s.filter fun n ↦ a n = z).card : ℝ) * w z := by
+    calc
+      (∑ n ∈ s.filter (fun n ↦ a n = z), w (a n)) =
+          ∑ n ∈ s.filter (fun n ↦ a n = z), w z := by
+        apply Finset.sum_congr rfl
+        intro n hn
+        rw [(Finset.mem_filter.mp hn).2]
+      _ = _ := by simp [nsmul_eq_mul]
+  simpa only [heq] using finsum_sum_filter a s (fun n ↦ w (a n))
+
+/-- Jensen's sum dominates every finite list that respects zero multiplicities. -/
+theorem finite_zero_log_sum_le_jensen {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : DifferentiableOn ℂ f (ball 0 1)) (hc : CountsAtMostOrders f a)
+    (s : Finset ℕ) {r : ℝ} (hr0 : 0 < r) (hr1 : r < 1)
+    (har : ∀ n ∈ s, ‖a n‖ ≤ r) :
+    ∑ n ∈ s, Real.log (r / ‖a n‖) ≤
+      ∑ᶠ z, (MeromorphicOn.divisor f (closedBall 0 r) z : ℝ) * Real.log (r / ‖z‖) := by
+  classical
+  have hA : AnalyticOnNhd ℂ f (closedBall 0 r) :=
+    (hf.analyticOnNhd isOpen_ball).mono (closedBall_subset_ball hr1)
+  let b : ℂ → ℝ := fun z ↦ ((s.filter fun n ↦ a n = z).card : ℝ)
+  let d := MeromorphicOn.divisor f (closedBall 0 r)
+  let w : ℂ → ℝ := fun z ↦ Real.log (r / ‖z‖)
+  have hbfin : b.support.Finite := by
+    apply (s.finite_toSet.image a).subset
+    intro z hz
+    by_contra h
+    have hz0 : (s.filter fun n ↦ a n = z) = ∅ := by
+      apply Finset.filter_eq_empty_iff.mpr
+      intro n hn heq
+      exact h ⟨n, hn, heq⟩
+    exact hz (by simp [b, hz0])
+  have hdfin : (fun z ↦ (d z : ℝ)).support.Finite := by
+    apply (d.finiteSupport (isCompact_closedBall 0 r)).subset
+    intro z hz hdz
+    exact hz (by simp [hdz])
+  rw [← finite_fiber_weight_sum s a w]
+  apply finsum_le_finsum (hbfin.subset (Function.support_mul_subset_left _ _))
+    (hdfin.subset (Function.support_mul_subset_left _ _))
+  intro z
+  by_cases hz : z ∈ closedBall (0 : ℂ) r
+  · have hzU : z ∈ ball (0 : ℂ) 1 := (closedBall_subset_ball hr1) hz
+    have hbd : b z ≤ d z := by
+      dsimp [b, d]
+      rw [divisor_eq_analyticOrderNatAt hA hz]
+      exact_mod_cast hc z hzU s
+    have hw : 0 ≤ w z := by
+      dsimp [w]
+      by_cases hz0 : z = 0
+      · simp [hz0]
+      · apply Real.log_nonneg
+        exact (le_div_iff₀ (norm_pos_iff.mpr hz0)).mpr (by simpa using hz)
+    exact mul_le_mul_of_nonneg_right hbd hw
+  · have hb0 : b z = 0 := by
+      dsimp [b]
+      have he : s.filter (fun n ↦ a n = z) = ∅ := by
+        apply Finset.filter_eq_empty_iff.mpr
+        intro n hn heq
+        apply hz
+        simpa [← heq] using har n hn
+      simp [he]
+    have hd0 : d z = 0 := Function.locallyFinsuppWithin.apply_eq_zero_of_notMem _ hz
+    simp [hb0, hd0]
+
+/-- A uniform upper bound for Jensen's non-origin zero sum on `1/2 ≤ r < 1`. -/
+theorem nevanlinna_jensen_sum_le {f : ℂ → ℂ} (hf : NevanlinnaClass f)
+    {M : ℝ} (hM : ∀ r ∈ Ioo (0 : ℝ) 1,
+      circleAverage (fun z ↦ Real.posLog ‖f z‖) 0 r ≤ M)
+    {r : ℝ} (hrhalf : (1 / 2 : ℝ) ≤ r) (hr1 : r < 1) :
+    (∑ᶠ z, (MeromorphicOn.divisor f (closedBall 0 r) z : ℝ) * Real.log (r / ‖z‖)) ≤
+      M + (analyticOrderNatAt f 0 : ℝ) * Real.log 2 - Real.log ‖meromorphicTrailingCoeffAt f 0‖ := by
+  have hr0 : 0 < r := (by norm_num : (0 : ℝ) < 1 / 2).trans_le hrhalf
+  have hA : AnalyticOnNhd ℂ f (closedBall 0 r) :=
+    (hf.1.analyticOnNhd isOpen_ball).mono (closedBall_subset_ball hr1)
+  have hAr : AnalyticOnNhd ℂ f (closedBall 0 |r|) := by simpa [abs_of_pos hr0] using hA
+  have hj := hAr.meromorphicOn.circleAverage_log_norm hr0.ne'
+  simp only [abs_of_pos hr0, zero_sub, norm_neg, ← div_eq_mul_inv] at hj
+  have hlogmean : circleAverage (fun z ↦ Real.log ‖f z‖) 0 r ≤ M := by
+    apply le_trans _ (hM r ⟨hr0, hr1⟩)
+    apply circleAverage_mono (hAr.mono sphere_subset_closedBall).meromorphicOn.circleIntegrable_log_norm
+      (circleIntegrable_posLog_norm hf.1 hr0.le hr1)
+    intro z hz
+    exact le_max_right _ _
+  have hd0 := divisor_eq_analyticOrderNatAt hA (show (0 : ℂ) ∈ closedBall 0 r by simp [hr0.le])
+  rw [hd0] at hj
+  have hlr : -Real.log 2 ≤ Real.log r := by
+    have h := Real.log_le_log (by norm_num : (0 : ℝ) < 1 / 2) hrhalf
+    simpa only [one_div, Real.log_inv] using h
+  have hm := mul_le_mul_of_nonneg_left hlr (Nat.cast_nonneg (analyticOrderNatAt f 0) :
+    (0 : ℝ) ≤ analyticOrderNatAt f 0)
+  simp only [Int.cast_natCast] at hj
+  linarith
+
+/-- Elementary logarithmic lower bound used without passing a circle through a zero. -/
+theorem half_one_sub_le_log_ratio {x r : ℝ} (hx : 0 < x) (hx1 : x < 1)
+    (hr : (1 + x) / 2 ≤ r) (hr1 : r < 1) :
+    (1 - x) / 2 ≤ Real.log (r / x) := by
+  have hr0 : 0 < r := (by linarith : 0 < (1 + x) / 2).trans_le hr
+  have h := Real.one_sub_inv_le_log_of_pos (div_pos hr0 hx)
+  rw [inv_div] at h
+  have hxr : x ≤ r := by linarith
+  have h1 : (1 - x) / 2 ≤ r - x := by linarith
+  have h2 : r - x ≤ 1 - x / r := by
+    have hmul : (r - x) * r ≤ r - x := mul_le_of_le_one_right (by linarith) hr1.le
+    have hdiv := (le_div_iff₀ hr0).mpr hmul
+    have heq : (r - x) / r = 1 - x / r := by field_simp; ring
+    simpa only [heq] using hdiv
+  exact h1.trans (h2.trans h)
+
+theorem exists_radius_for_finite_zeros (s : Finset ℕ) {a : ℕ → ℂ}
+    (ha : ∀ n, ‖a n‖ < 1) :
+    ∃ r : ℝ, (1 / 2 : ℝ) ≤ r ∧ r < 1 ∧ ∀ n ∈ s, (1 + ‖a n‖) / 2 ≤ r := by
+  classical
+  induction s using Finset.induction with
+  | empty => exact ⟨3 / 4, by norm_num, by norm_num, by simp⟩
+  | @insert n s hn ih =>
+    obtain ⟨r, hrhalf, hr1, hsr⟩ := ih
+    refine ⟨max r ((1 + ‖a n‖) / 2), hrhalf.trans (le_max_left _ _), ?_, ?_⟩
+    · exact max_lt_iff.mpr ⟨hr1, by linarith [ha n]⟩
+    · intro j hj
+      rcases Finset.mem_insert.mp hj with rfl | hj
+      · exact le_max_right _ _
+      · exact (hsr j hj).trans (le_max_left _ _)
+
+/-- The Blaschke condition holds for every sequence using each zero no more
+often than its analytic multiplicity. No preexisting summability or escape
+assumption is used. -/
+theorem nevanlinna_blaschke_summable_of_counts {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : NevanlinnaClass f) (ha : ∀ n, ‖a n‖ < 1) (hc : CountsAtMostOrders f a) :
+    Summable (fun n ↦ 1 - ‖a n‖) := by
+  classical
+  obtain ⟨M, hM⟩ := hf.2
+  let C : ℝ := M + (analyticOrderNatAt f 0 : ℝ) * Real.log 2 -
+    Real.log ‖meromorphicTrailingCoeffAt f 0‖
+  have hs : Summable (fun n ↦ if a n = 0 then (0 : ℝ) else 1 - ‖a n‖) := by
+    apply summable_of_sum_le (c := 2 * C)
+    · intro n
+      split_ifs
+      · exact le_rfl
+      · exact sub_nonneg.mpr (ha n).le
+    · intro s
+      obtain ⟨r, hrhalf, hr1, har⟩ := exists_radius_for_finite_zeros s ha
+      have hr0 : 0 < r := (by norm_num : (0 : ℝ) < 1 / 2).trans_le hrhalf
+      have hlogs := (finite_zero_log_sum_le_jensen hf.1 hc s hr0 hr1
+        (fun n hn ↦ by have := har n hn; have := ha n; linarith)).trans
+        (nevanlinna_jensen_sum_le hf hM hrhalf hr1)
+      have hhalf : (∑ n ∈ s, if a n = 0 then (0 : ℝ) else 1 - ‖a n‖) / 2 ≤
+          ∑ n ∈ s, Real.log (r / ‖a n‖) := by
+        rw [Finset.sum_div]
+        apply Finset.sum_le_sum
+        intro n hn
+        by_cases hn0 : a n = 0
+        · simp [hn0]
+        · simp only [if_neg hn0]
+          exact half_one_sub_le_log_ratio (norm_pos_iff.mpr hn0) (ha n) (har n hn) hr1
+      dsimp [C]
+      linarith
+  have hs0 : Summable (fun n ↦ if a n = 0 then (1 : ℝ) else 0) := by
+    apply summable_of_sum_le (c := (analyticOrderNatAt f 0 : ℝ))
+    · intro n
+      split_ifs <;> norm_num
+    · intro s
+      have h := hc 0 (by simp) s
+      simpa only [Finset.sum_boole] using (show
+        ((s.filter fun n ↦ a n = 0).card : ℝ) ≤ analyticOrderNatAt f 0 by exact_mod_cast h)
+  have heq : (fun n ↦ 1 - ‖a n‖) =
+      (fun n ↦ if a n = 0 then (1 : ℝ) else 0) +
+      (fun n ↦ if a n = 0 then (0 : ℝ) else 1 - ‖a n‖) := by
+    funext n
+    by_cases hn : a n = 0 <;> simp [hn]
+  rw [heq]
+  exact hs0.add hs
+
+/-- Rudin 15.23 for a complete zero list with actual finite multiplicity sums. -/
+theorem nevanlinna_zeros_blaschke {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : NevanlinnaClass f) (ha : ∀ n, ‖a n‖ < 1)
+    (hcount : ∀ z ∈ ball (0 : ℂ) 1,
+      HasSum (fun n ↦ if a n = z then (1 : ℕ) else 0) (analyticOrderNatAt f z)) :
+    Summable (fun n ↦ 1 - ‖a n‖) :=
+  nevanlinna_blaschke_summable_of_counts hf ha (countsAtMostOrders_of_hasSum hcount)
+
+/-- Finite and empty zero lists automatically satisfy the same condition. -/
+theorem finite_zeros_blaschke {ι : Type*} [Finite ι] (a : ι → ℂ) :
+    Summable (fun n ↦ 1 - ‖a n‖) := by
+  letI : Fintype ι := Fintype.ofFinite ι
+  exact (hasSum_fintype (fun n ↦ 1 - ‖a n‖)).summable
+
+theorem countsAtMostOrders_of_injective_zeros {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : DifferentiableOn ℂ f (ball 0 1))
+    (hne : ∃ z ∈ ball (0 : ℂ) 1, f z ≠ 0)
+    (ha : Function.Injective a) (haz : ∀ n, f (a n) = 0) : CountsAtMostOrders f a := by
+  classical
+  obtain ⟨w, hw, hfw⟩ := hne
+  have hA := hf.analyticOnNhd isOpen_ball
+  have hfinite (z : ℂ) (hz : z ∈ ball (0 : ℂ) 1) : analyticOrderAt f z ≠ ⊤ :=
+    hA.analyticOrderAt_ne_top_of_isPreconnected (convex_ball (0 : ℂ) 1).isPreconnected hw hz
+      (by rw [(hA w hw).analyticOrderAt_eq_zero.mpr hfw]; simp)
+  intro z hz s
+  by_cases hs : (s.filter fun n ↦ a n = z).Nonempty
+  · obtain ⟨n, hn⟩ := hs
+    have hnz := (Finset.mem_filter.mp hn).2
+    have hfz : f z = 0 := by rw [← hnz]; exact haz n
+    have ho : 0 < analyticOrderNatAt f z := by
+      apply Nat.pos_of_ne_zero
+      intro hzero
+      have ht := (hA z hz).analyticOrderAt_ne_zero.mpr hfz
+      rw [← Nat.cast_analyticOrderNatAt (hfinite z hz), hzero, Nat.cast_zero] at ht
+      exact ht rfl
+    apply (show (s.filter fun n ↦ a n = z).card ≤ 1 from ?_).trans ho
+    apply Finset.card_le_one.mpr
+    intro i hi j hj
+    exact ha ((Finset.mem_filter.mp hi).2.trans (Finset.mem_filter.mp hj).2.symm)
+  · simp only [Finset.not_nonempty_iff_eq_empty.mp hs, Finset.card_empty, Nat.zero_le]
+
+/-- The uniqueness corollary of 15.23: a non-Blaschke sequence of distinct zeros
+forces a Nevanlinna function to vanish throughout the unit disc. -/
+theorem nevanlinna_zero_of_non_blaschke {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : NevanlinnaClass f) (haU : ∀ n, ‖a n‖ < 1) (ha : Function.Injective a)
+    (haz : ∀ n, f (a n) = 0) (hdiv : ¬ Summable (fun n ↦ 1 - ‖a n‖)) :
+    ∀ z ∈ ball (0 : ℂ) 1, f z = 0 := by
+  by_contra h
+  push_neg at h
+  exact hdiv (nevanlinna_blaschke_summable_of_counts hf haU
+    (countsAtMostOrders_of_injective_zeros hf.1 h ha haz))
+
+/-- In particular, the same uniqueness conclusion holds for bounded holomorphic functions. -/
+theorem boundedHolomorphic_zero_of_non_blaschke {f : ℂ → ℂ} {a : ℕ → ℂ}
+    (hf : BoundedHolomorphic f) (haU : ∀ n, ‖a n‖ < 1) (ha : Function.Injective a)
+    (haz : ∀ n, f (a n) = 0) (hdiv : ¬ Summable (fun n ↦ 1 - ‖a n‖)) :
+    ∀ z ∈ ball (0 : ℂ) 1, f z = 0 :=
+  nevanlinna_zero_of_non_blaschke hf.nevanlinnaClass haU ha haz hdiv
+
+#print axioms divisor_eq_analyticOrderNatAt
+#print axioms countsAtMostOrders_of_hasSum
+#print axioms finite_fiber_weight_sum
+#print axioms finite_zero_log_sum_le_jensen
+#print axioms nevanlinna_jensen_sum_le
+#print axioms half_one_sub_le_log_ratio
+#print axioms exists_radius_for_finite_zeros
+#print axioms nevanlinna_blaschke_summable_of_counts
+#print axioms nevanlinna_zeros_blaschke
+#print axioms finite_zeros_blaschke
+#print axioms countsAtMostOrders_of_injective_zeros
+#print axioms nevanlinna_zero_of_non_blaschke
+#print axioms boundedHolomorphic_zero_of_non_blaschke
+
+end RudinRCA.Chapter15.BlaschkeNecessityWork
diff --git a/books/rudin-real-and-complex-analysis/BlaschkeWork.lean b/books/rudin-real-and-complex-analysis/BlaschkeWork.lean
new file mode 100644
index 0000000..ffffa24
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/BlaschkeWork.lean
@@ -0,0 +1,333 @@
+import RudinRCA.Chapter15
+import Mathlib.Analysis.Complex.Poisson
+import Mathlib.Topology.Order.Compact
+import Mathlib.Analysis.Normed.Group.FunctionSeries
+import Mathlib.Tactic.FieldSimp
+
+noncomputable section
+open Filter Finset
+open scoped Topology ComplexConjugate
+
+namespace RudinRCA.Chapter15
+
+/-- The normalized zero factor in Rudin 15.21. -/
+def blaschkeFactor (a z : ℂ) : ℂ :=
+  (‖a‖ : ℂ) / a * (a - z) / (1 - conj a * z)
+
+theorem blaschke_denominator_ne_zero {a z : ℂ} (ha : ‖a‖ < 1) (hz : ‖z‖ ≤ 1) :
+    1 - conj a * z ≠ 0 := by
+  apply sub_ne_zero.mpr
+  intro heq
+  have hlt : ‖conj a * z‖ < 1 := by
+    rw [norm_mul, Complex.norm_conj]
+    exact (mul_le_of_le_one_right (norm_nonneg a) hz).trans_lt ha
+  rw [← heq, norm_one] at hlt
+  exact (lt_irrefl (1 : ℝ)) hlt
+
+theorem norm_blaschke_phase {a : ℂ} (ha : a ≠ 0) : ‖(‖a‖ : ℂ) / a‖ = 1 := by
+  rw [norm_div, Complex.norm_of_nonneg (norm_nonneg a), div_self (norm_ne_zero_iff.mpr ha)]
+
+theorem blaschkeFactor_zero {a : ℂ} (ha : a ≠ 0) :
+    blaschkeFactor a 0 = (‖a‖ : ℂ) := by
+  simp [blaschkeFactor, ha]
+
+theorem blaschkeFactor_eq_zero_iff {a z : ℂ} (ha0 : a ≠ 0) (ha : ‖a‖ < 1)
+    (hz : ‖z‖ < 1) : blaschkeFactor a z = 0 ↔ z = a := by
+  have hnorm : (‖a‖ : ℂ) ≠ 0 := by exact_mod_cast norm_ne_zero_iff.mpr ha0
+  simp only [blaschkeFactor, div_eq_zero_iff, mul_eq_zero, hnorm, ha0,
+    blaschke_denominator_ne_zero ha hz.le, or_false, false_or, sub_eq_zero]
+  exact eq_comm
+
+theorem differentiableOn_blaschkeFactor {a : ℂ} (ha : ‖a‖ < 1) :
+    DifferentiableOn ℂ (blaschkeFactor a) (Metric.ball 0 1) := by
+  intro z hz
+  have hz' : ‖z‖ < 1 := by simpa using hz
+  have hden := blaschke_denominator_ne_zero ha hz'.le
+  unfold blaschkeFactor
+  fun_prop
+
+/-- The elementary disk-automorphism identity, valid also on the boundary. -/
+theorem blaschke_norm_difference (a z : ℂ) :
+    ‖1 - conj a * z‖ ^ 2 - ‖a - z‖ ^ 2 =
+      (1 - ‖a‖ ^ 2) * (1 - ‖z‖ ^ 2) := by
+  simp only [← Complex.normSq_eq_norm_sq, Complex.normSq_sub, Complex.normSq_one,
+    Complex.normSq_mul, Complex.normSq_conj, one_mul, Complex.conj_re,
+    Complex.mul_re, Complex.conj_im]
+  ring
+
+theorem norm_blaschkeFactor_le_one {a z : ℂ} (ha0 : a ≠ 0) (ha : ‖a‖ < 1)
+    (hz : ‖z‖ ≤ 1) : ‖blaschkeFactor a z‖ ≤ 1 := by
+  have ha2 : 0 ≤ 1 - ‖a‖ ^ 2 := by nlinarith [norm_nonneg a]
+  have hz2 : 0 ≤ 1 - ‖z‖ ^ 2 := by nlinarith [norm_nonneg z]
+  have hsq := blaschke_norm_difference a z
+  have hle : ‖a - z‖ ≤ ‖1 - conj a * z‖ := by
+    nlinarith [mul_nonneg ha2 hz2, norm_nonneg (a - z), norm_nonneg (1 - conj a * z)]
+  rw [blaschkeFactor, norm_div, norm_mul, norm_blaschke_phase ha0, one_mul]
+  exact (div_le_one (norm_pos_iff.mpr (blaschke_denominator_ne_zero ha hz))).2 hle
+
+theorem one_sub_blaschkeFactor {a z : ℂ} (ha0 : a ≠ 0)
+    (hden : 1 - conj a * z ≠ 0) :
+    1 - blaschkeFactor a z =
+      ((1 - ‖a‖ : ℝ) : ℂ) * (1 + ((‖a‖ : ℂ) / a) * z) / (1 - conj a * z) := by
+  have haa : conj a * a = (‖a‖ : ℂ) ^ 2 := by
+    rw [← Complex.normSq_eq_conj_mul_self, Complex.normSq_eq_norm_sq, Complex.ofReal_pow]
+  unfold blaschkeFactor
+  push_cast
+  field_simp
+  linear_combination z * haa
+
+/-- The compact-disk majorant for the infinite Blaschke product. -/
+theorem norm_one_sub_blaschkeFactor_le {a z : ℂ} (ha0 : a ≠ 0) (ha : ‖a‖ < 1)
+    {r : ℝ} (hr0 : 0 ≤ r) (hr : r < 1) (hz : ‖z‖ ≤ r) :
+    ‖1 - blaschkeFactor a z‖ ≤ (1 - ‖a‖) * ((1 + r) / (1 - r)) := by
+  have hden := blaschke_denominator_ne_zero ha (hz.trans hr.le)
+  have hdpos : 0 < 1 - r := sub_pos.mpr hr
+  have hd : 1 - r ≤ ‖1 - conj a * z‖ := by
+    have hrev := norm_sub_norm_le (1 : ℂ) (conj a * z)
+    simp only [norm_one, norm_mul, Complex.norm_conj] at hrev
+    have hamul : ‖a‖ * ‖z‖ ≤ r :=
+      (mul_le_mul_of_nonneg_right ha.le (norm_nonneg z)).trans (by simpa using hz)
+    linarith
+  rw [one_sub_blaschkeFactor ha0 hden, norm_div, norm_mul,
+    Complex.norm_of_nonneg (sub_nonneg.mpr ha.le)]
+  have hnum : ‖1 + (‖a‖ : ℂ) / a * z‖ ≤ 1 + r := by
+    calc
+      _ ≤ ‖(1 : ℂ)‖ + ‖(‖a‖ : ℂ) / a * z‖ := norm_add_le _ _
+      _ = 1 + ‖z‖ := by rw [norm_one, norm_mul, norm_blaschke_phase ha0, one_mul]
+      _ ≤ 1 + r := add_le_add_left hz _
+  calc
+    _ ≤ ((1 - ‖a‖) * (1 + r)) / (1 - r) :=
+      div_le_div₀ (mul_nonneg (sub_nonneg.mpr ha.le) (by positivity))
+        (mul_le_mul_of_nonneg_left hnum (sub_nonneg.mpr ha.le)) hdpos hd
+    _ = _ := by ring
+
+theorem analyticOrderAt_blaschkeFactor {a z : ℂ} (ha0 : a ≠ 0) (ha : ‖a‖ < 1)
+    (hz : ‖z‖ < 1) :
+    analyticOrderAt (blaschkeFactor a) z = if z = a then 1 else 0 := by
+  have hden := blaschke_denominator_ne_zero ha hz.le
+  have hc : (‖a‖ : ℂ) / a ≠ 0 := by
+    apply div_ne_zero _ ha0
+    exact_mod_cast norm_ne_zero_iff.mpr ha0
+  let q : ℂ → ℂ := fun w ↦ ((‖a‖ : ℂ) / a) / (1 - conj a * w)
+  have hq : AnalyticAt ℂ q z := by dsimp [q]; fun_prop
+  have hq0 : q z ≠ 0 := div_ne_zero hc hden
+  have hlin : AnalyticAt ℂ (fun w : ℂ ↦ a - w) z := by fun_prop
+  have heq : blaschkeFactor a = q * (fun w ↦ a - w) := by
+    funext w
+    simp only [blaschkeFactor, q, Pi.mul_apply]
+    ring
+  rw [heq, analyticOrderAt_mul hq hlin, hq.analyticOrderAt_eq_zero.mpr hq0, zero_add]
+  have hneg : (fun w : ℂ ↦ a - w) = -(fun w : ℂ ↦ w - a) := by
+    funext w
+    simp
+  rw [hneg, analyticOrderAt_neg]
+  by_cases he : z = a
+  · subst z
+    simp
+  · simp [he, analyticOrderAt_id_sub_const_of_ne he]
+
+/-- Uniform convergence of the norm-error series on compact subsets of the disk. -/
+theorem blaschke_errors_locally_uniform {a : ℕ → ℂ}
+    (ha0 : ∀ n, a n ≠ 0) (ha : ∀ n, ‖a n‖ < 1)
+    (hsum : Summable (fun n ↦ 1 - ‖a n‖)) :
+    TendstoLocallyUniformlyOn
+      (fun N z ↦ ∑ n ∈ range N, ‖1 - blaschkeFactor (a n) z‖)
+      (fun z ↦ ∑' n, ‖1 - blaschkeFactor (a n) z‖) atTop (Metric.ball 0 1) := by
+  apply (tendstoLocallyUniformlyOn_iff_forall_isCompact Metric.isOpen_ball).2
+  intro K hKU hK
+  by_cases hne : K.Nonempty
+  · obtain ⟨w, hw, hmax⟩ := hK.exists_isMaxOn hne continuous_norm.continuousOn
+    have hw1 : ‖w‖ < 1 := by simpa using hKU hw
+    apply tendstoUniformlyOn_tsum_nat_eventually
+      (hsum.mul_right ((1 + ‖w‖) / (1 - ‖w‖)))
+    apply Filter.Eventually.of_forall
+    intro n z hz
+    rw [Real.norm_of_nonneg (norm_nonneg _)]
+    exact norm_one_sub_blaschkeFactor_le (ha0 n) (ha n) (norm_nonneg w) hw1 (hmax hz)
+  · rw [Set.not_nonempty_iff_eq_empty.mp hne]
+    exact tendstoUniformlyOn_empty
+
+/-- The product assertion of 15.21 away from the optional zero at the origin. -/
+theorem infinite_blaschke_product {a : ℕ → ℂ}
+    (ha0 : ∀ n, a n ≠ 0) (ha : ∀ n, ‖a n‖ < 1)
+    (hsum : Summable (fun n ↦ 1 - ‖a n‖)) :
+    let B := fun z ↦ ∏' n, blaschkeFactor (a n) z
+    TendstoLocallyUniformlyOn
+      (fun N z ↦ ∏ n ∈ range N, blaschkeFactor (a n) z) B atTop (Metric.ball 0 1) ∧
+    DifferentiableOn ℂ B (Metric.ball 0 1) ∧
+    ∀ z ∈ Metric.ball 0 1, ‖B z‖ ≤ 1 ∧
+      (B z = 0 ↔ ∃ n, z = a n) ∧ analyticOrderAt B z ≠ ⊤ ∧
+      analyticOrderNatAt B z = ∑' n, if z = a n then (1 : ℕ) else 0 := by
+  have hF : ∀ n, DifferentiableOn ℂ (blaschkeFactor (a n)) (Metric.ball 0 1) :=
+    fun n ↦ differentiableOn_blaschkeFactor (ha n)
+  have hnonzero : ∀ n z, z ∈ Metric.ball (0 : ℂ) 1 →
+      ∃ w ∈ connectedComponentIn (Metric.ball 0 1) z, blaschkeFactor (a n) w ≠ 0 := by
+    intro n z hz
+    refine ⟨0, ?_, ?_⟩
+    · rw [(convex_ball (0 : ℂ) 1).isPreconnected.connectedComponentIn hz]
+      exact Metric.mem_ball_self zero_lt_one
+    · rw [blaschkeFactor_zero (ha0 n)]
+      exact_mod_cast norm_ne_zero_iff.mpr (ha0 n)
+  have herr := blaschke_errors_locally_uniform ha0 ha hsum
+  obtain ⟨hlim, hhol, horder⟩ := holomorphic_product_multiplicity
+    Metric.isOpen_ball hF hnonzero ⟨_, herr⟩
+  refine ⟨hlim, hhol, ?_⟩
+  intro z hz
+  have hz1 : ‖z‖ < 1 := by simpa using hz
+  have hbound : ‖∏' n, blaschkeFactor (a n) z‖ ≤ 1 := by
+    apply le_of_tendsto (continuous_norm.tendsto _ |>.comp (hlim.tendsto_at hz))
+    apply Filter.Eventually.of_forall
+    intro N
+    rw [norm_prod]
+    exact Finset.prod_le_one₀ (fun n _ ↦ norm_nonneg _) (fun n _ ↦
+      norm_blaschkeFactor_le_one (ha0 n) (ha n) hz1.le)
+  have hsz : Summable (fun n ↦ ‖1 - blaschkeFactor (a n) z‖) :=
+    ((hasSum_iff_tendsto_nat_of_nonneg (fun n ↦ norm_nonneg _) _).2
+      (herr.tendsto_at hz)).summable
+  have hzero : (∏' n, blaschkeFactor (a n) z) = 0 ↔ ∃ n, z = a n := by
+    constructor
+    · intro hb
+      by_contra h
+      push_neg at h
+      have hnone : ∀ n, blaschkeFactor (a n) z ≠ 0 := by
+        intro n
+        exact mt (blaschkeFactor_eq_zero_iff (ha0 n) (ha n) hz1).mp (h n)
+      have hone : ∀ n, 1 + (blaschkeFactor (a n) z - 1) = blaschkeFactor (a n) z :=
+        fun n ↦ by ring
+      have hnorm : Summable (fun n ↦ ‖blaschkeFactor (a n) z - 1‖) := by
+        simpa only [norm_sub_rev] using hsz
+      have hn := tprod_one_add_ne_zero_of_summable
+        (fun n ↦ by simpa only [hone] using hnone n) hnorm
+      exact hn (by simpa only [hone] using hb)
+    · rintro ⟨n, hn⟩
+      exact tprod_of_exists_eq_zero ⟨n, (blaschkeFactor_eq_zero_iff (ha0 n) (ha n) hz1).2 hn⟩
+  obtain ⟨_, hfinite, hm, _⟩ := horder z hz
+  refine ⟨hbound, hzero, hfinite, ?_⟩
+  rw [hm]
+  apply tsum_congr
+  intro n
+  simp only [analyticOrderNatAt, analyticOrderAt_blaschkeFactor (ha0 n) (ha n) hz1]
+  split_ifs <;> simp
+
+/-- Definition 15.21, including a zero of prescribed order at the origin. -/
+def blaschkeProduct (k : ℕ) (a : ℕ → ℂ) (z : ℂ) : ℂ :=
+  z ^ k * ∏' n, blaschkeFactor (a n) z
+
+theorem analyticOrderAt_power (k : ℕ) (z : ℂ) :
+    analyticOrderAt (fun w : ℂ ↦ w ^ k) z = if z = 0 then (k : ℕ∞) else 0 := by
+  by_cases hz : z = 0
+  · subst z
+    simpa using analyticOrderAt_pow (f := id) (z₀ := (0 : ℂ)) analyticAt_id k
+  · rw [if_neg hz]
+    exact (analyticAt_id.pow k).analyticOrderAt_eq_zero.mpr (pow_ne_zero k hz)
+
+/-- Rudin 15.21, including the zero at the origin and its exact multiplicity. -/
+theorem blaschke_product_properties (k : ℕ) {a : ℕ → ℂ}
+    (ha0 : ∀ n, a n ≠ 0) (ha : ∀ n, ‖a n‖ < 1)
+    (hsum : Summable (fun n ↦ 1 - ‖a n‖)) :
+    DifferentiableOn ℂ (blaschkeProduct k a) (Metric.ball 0 1) ∧
+    ∀ z ∈ Metric.ball 0 1, ‖blaschkeProduct k a z‖ ≤ 1 ∧
+      (blaschkeProduct k a z = 0 ↔ (z = 0 ∧ 0 < k) ∨ ∃ n, z = a n) ∧
+      analyticOrderAt (blaschkeProduct k a) z ≠ ⊤ ∧
+      analyticOrderNatAt (blaschkeProduct k a) z =
+        (if z = 0 then k else 0) + ∑' n, if z = a n then (1 : ℕ) else 0 := by
+  obtain ⟨_, hB, hprop⟩ := infinite_blaschke_product ha0 ha hsum
+  have hp : Differentiable ℂ (fun z : ℂ ↦ z ^ k) := differentiable_id.pow k
+  refine ⟨hp.differentiableOn.mul hB, ?_⟩
+  intro z hz
+  have hz1 : ‖z‖ < 1 := by simpa using hz
+  obtain ⟨hbound, hzero, hfinite, hm⟩ := hprop z hz
+  have hpa := hp.analyticAt z
+  have hBa := (hB.analyticOnNhd Metric.isOpen_ball) z hz
+  have hpf : analyticOrderAt (fun w : ℂ ↦ w ^ k) z ≠ ⊤ := by
+    rw [analyticOrderAt_power]
+    split_ifs <;> simp
+  refine ⟨?_, ?_, ?_, ?_⟩
+  · rw [blaschkeProduct, norm_mul, norm_pow]
+    exact mul_le_one₀ (pow_le_one₀ (norm_nonneg z) hz1.le)
+      (norm_nonneg _) hbound
+  · change z ^ k * _ = 0 ↔ _
+    rw [mul_eq_zero, hzero]
+    by_cases hk : k = 0
+    · simp [hk]
+    · simp [pow_eq_zero_iff hk, Nat.pos_iff_ne_zero, hk]
+  · change analyticOrderAt ((fun w : ℂ ↦ w ^ k) * (fun w ↦ ∏' n, blaschkeFactor (a n) w)) z ≠ ⊤
+    rw [analyticOrderAt_mul hpa hBa]
+    simp [ENat.add_eq_top, hpf, hfinite]
+  · change analyticOrderNatAt ((fun w : ℂ ↦ w ^ k) * (fun w ↦ ∏' n, blaschkeFactor (a n) w)) z = _
+    rw [analyticOrderNatAt_mul hpa hBa hpf hfinite, hm]
+    congr 1
+    simp only [analyticOrderNatAt, analyticOrderAt_power]
+    split_ifs <;> simp
+
+/-- The finite-list convention in Definition 15.21; the empty list yields z^k. -/
+def finiteBlaschkeProduct {ι : Type*} (k : ℕ) (s : Finset ι) (a : ι → ℂ) (z : ℂ) : ℂ :=
+  z ^ k * ∏ n ∈ s, blaschkeFactor (a n) z
+
+/-- Finite and empty Blaschke products, including exact multiplicities. -/
+theorem finite_blaschke_product_properties {ι : Type*} (k : ℕ) (s : Finset ι) (a : ι → ℂ)
+    (ha0 : ∀ n ∈ s, a n ≠ 0) (ha : ∀ n ∈ s, ‖a n‖ < 1) :
+    DifferentiableOn ℂ (finiteBlaschkeProduct k s a) (Metric.ball 0 1) ∧
+    ∀ z ∈ Metric.ball 0 1, ‖finiteBlaschkeProduct k s a z‖ ≤ 1 ∧
+      (finiteBlaschkeProduct k s a z = 0 ↔
+        (z = 0 ∧ 0 < k) ∨ ∃ n ∈ s, z = a n) ∧
+      analyticOrderAt (finiteBlaschkeProduct k s a) z =
+        (if z = 0 then (k : ℕ∞) else 0) + ∑ n ∈ s, if z = a n then (1 : ℕ∞) else 0 := by
+  classical
+  have hF : ∀ n ∈ s, DifferentiableOn ℂ (blaschkeFactor (a n)) (Metric.ball 0 1) :=
+    fun n hn ↦ differentiableOn_blaschkeFactor (ha n hn)
+  have hp : Differentiable ℂ (fun z : ℂ ↦ z ^ k) := differentiable_id.pow k
+  have hprod : DifferentiableOn ℂ (fun z ↦ ∏ n ∈ s, blaschkeFactor (a n) z)
+      (Metric.ball 0 1) := DifferentiableOn.fun_finsetProd hF
+  refine ⟨hp.differentiableOn.mul hprod, ?_⟩
+  intro z hz
+  have hz1 : ‖z‖ < 1 := by simpa using hz
+  have hbound : ‖∏ n ∈ s, blaschkeFactor (a n) z‖ ≤ 1 := by
+    rw [norm_prod]
+    exact Finset.prod_le_one₀ (fun n _ ↦ norm_nonneg _)
+      (fun n hn ↦ norm_blaschkeFactor_le_one (ha0 n hn) (ha n hn) hz1.le)
+  have hzero : (∏ n ∈ s, blaschkeFactor (a n) z) = 0 ↔ ∃ n ∈ s, z = a n := by
+    rw [Finset.prod_eq_zero_iff]
+    constructor
+    · rintro ⟨n, hn, he⟩
+      exact ⟨n, hn, (blaschkeFactor_eq_zero_iff (ha0 n hn) (ha n hn) hz1).mp he⟩
+    · rintro ⟨n, hn, he⟩
+      exact ⟨n, hn, (blaschkeFactor_eq_zero_iff (ha0 n hn) (ha n hn) hz1).mpr he⟩
+  refine ⟨?_, ?_, ?_⟩
+  · rw [finiteBlaschkeProduct, norm_mul, norm_pow]
+    exact mul_le_one₀ (pow_le_one₀ (norm_nonneg z) hz1.le) (norm_nonneg _) hbound
+  · change z ^ k * _ = 0 ↔ _
+    rw [mul_eq_zero, hzero]
+    by_cases hk : k = 0
+    · simp [hk]
+    · simp [pow_eq_zero_iff hk, Nat.pos_iff_ne_zero, hk]
+  · change analyticOrderAt ((fun w : ℂ ↦ w ^ k) *
+      (fun w ↦ ∏ n ∈ s, blaschkeFactor (a n) w)) z = _
+    rw [analyticOrderAt_mul (hp.analyticAt z) ((hprod.analyticOnNhd Metric.isOpen_ball) z hz),
+      analyticOrderAt_power, analyticOrderAt_finset_product s
+        (fun n hn ↦ ((hF n hn).analyticOnNhd Metric.isOpen_ball) z hz)]
+    congr 1
+    apply Finset.sum_congr rfl
+    intro n hn
+    exact analyticOrderAt_blaschkeFactor (ha0 n hn) (ha n hn) hz1
+
+#print axioms finite_blaschke_product_properties
+
+#print axioms analyticOrderAt_power
+#print axioms blaschke_product_properties
+
+#print axioms blaschke_errors_locally_uniform
+#print axioms infinite_blaschke_product
+
+#print axioms blaschke_denominator_ne_zero
+#print axioms norm_blaschke_phase
+#print axioms blaschkeFactor_zero
+#print axioms blaschkeFactor_eq_zero_iff
+#print axioms differentiableOn_blaschkeFactor
+#print axioms blaschke_norm_difference
+#print axioms norm_blaschkeFactor_le_one
+#print axioms one_sub_blaschkeFactor
+#print axioms norm_one_sub_blaschkeFactor_le
+#print axioms analyticOrderAt_blaschkeFactor
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/BoundaryProductGeometryWork.lean b/books/rudin-real-and-complex-analysis/BoundaryProductGeometryWork.lean
new file mode 100644
index 0000000..87fcc16
--- /dev/null
+++ b/books/rudin-real-and-complex-analysis/BoundaryProductGeometryWork.lean
@@ -0,0 +1,140 @@
+import Mathlib.Analysis.Complex.Basic
+import Mathlib.Analysis.Normed.Group.Bounded
+import Mathlib.Topology.MetricSpace.HausdorffDistance
+import Mathlib.Topology.Order.Compact
+import Mathlib.Tactic.Linarith
+import Mathlib.Tactic.Positivity
+import Mathlib.Tactic.FieldSimp
+import Mathlib.Tactic.NormNum
+
+/-!
+Geometry for the normalized proof of Rudin 15.11.
+
+After a point of the domain outside the zero set is moved to infinity, the
+finite zero sequence is bounded and the omitted set C is compact. The first
+lemma extracts convergence of the nearest-boundary distance from escape from
+compact subsets. The remaining lemmas give one-half ratio bounds on compact
+plane sets and on a fixed infinity-chart disc. These are the geometric inputs
+for the elementary-factor estimate 15.8 and holomorphic product theorem 15.6.
+
+This draft is not a completed prescribed-zero existence theorem.
+-/
+
+noncomputable section
+
+open Filter Set Metric Bornology
+open scoped Topology
+
+namespace RudinRCA.Chapter15
+
+/-- A bounded zero sequence escaping every compact subset of the domain must
+approach its closed complement. Compactness of the complement is not needed
+for this particular implication. -/
+theorem infDist_tendsto_zero_of_bounded_escape (a : ℕ → ℂ) (C : Set ℂ)
+    (R : ℝ) (hbound : ∀ n, ‖a n‖ ≤ R)
+    (hescape : ∀ K : Set ℂ, IsCompact K → K ⊆ Cᶜ →
+      ∀ᶠ n in atTop, a n ∉ K) :
+    Tendsto (fun n ↦ infDist (a n) C) atTop (𝓝 0) := by
+  apply tendsto_order.2
+  constructor
+  · intro r hr
+    exact Eventually.of_forall (fun n ↦ hr.trans_le infDist_nonneg)
+  · intro ε hε
+    let K : Set ℂ := closedBall 0 R ∩ {z | ε ≤ infDist z C}
+    have hK : IsCompact K :=
+      (isCompact_closedBall 0 R).inter_right
+        (isClosed_le continuous_const (continuous_infDist_pt C))
+    have hKC : K ⊆ Cᶜ := by
+      intro z hz hzin
+      have h := hz.2
+      rw [infDist_zero_of_mem hzin] at h
+      exact (not_le_of_gt hε) h
+    filter_upwards [hescape K hK hKC] with n hn
+    apply lt_of_not_ge
+    intro h
+    exact hn ⟨by simpa only [mem_closedBall, dist_zero_right] using hbound n, h⟩
+
+/-- A nearest-point choice gives an actual small complex difference. -/
+theorem nearest_boundary_difference_tendsto_zero (a b : ℕ → ℂ) (C : Set ℂ)
+    (hnearest : ∀ n, infDist (a n) C = dist (a n) (b n))
+    (h : Tendsto (fun n ↦ infDist (a n) C) atTop (𝓝 0)) :
+    Tendsto (fun n ↦ ‖a n - b n‖) atTop (𝓝 0) := by
+  simpa only [hnearest, dist_eq_norm] using h
+
+/-- Uniform positive distance from a compact set to a disjoint nonempty closed set. -/
+theorem compact_infDist_lower_bound {C K : Set ℂ} (hC : IsClosed C)
+    (hCne : C.Nonempty) (hK : IsCompact K) (hKC : K ⊆ Cᶜ) :
+    ∃ δ : ℝ, 0 < δ ∧ ∀ z ∈ K, δ ≤ infDist z C := by
+  apply hK.exists_forall_le' (continuous_infDist_pt C).continuousOn
+  intro z hz
+  exact (hC.notMem_iff_infDist_pos hCne).1 (hKC hz)
+
+/-- The pole factors' arguments eventually have norm at most one half on every
+compact subset of the domain. -/
+theorem boundary_ratios_small_on_compact (a b : ℕ → ℂ) {C K : Set ℂ}
+    (hC : IsClosed C) (hCne : C.Nonempty) (hb : ∀ n, b n ∈ C)
+    (hsmall : Tendsto (fun n ↦ ‖a n - b n‖) atTop (𝓝 0))
+    (hK : IsCompact K) (hKC : K ⊆ Cᶜ) :
+    ∀ᶠ n in atTop, ∀ z ∈ K, ‖(a n - b n) / (z - b n)‖ ≤ (1 / 2 : ℝ) := by
+  obtain ⟨δ, hδ, hδK⟩ := compact_infDist_lower_bound hC hCne hK hKC
+  filter_upwards [(tendsto_order.1 hsmall).2 (δ / 2) (half_pos hδ)] with n hn
+  intro z hz
+  have hden : δ ≤ ‖z - b n‖ :=
+    (hδK z hz).trans (by simpa only [dist_eq_norm] using infDist_le_dist_of_mem (hb n))
+  rw [norm_div, div_le_iff₀ (hδ.trans_le hden)]
+  linarith
+
+/-- A uniform pole bound supplies a single infinity-chart disc on which all
+denominators are nonzero. -/
+theorem exists_infinity_disc_denominator_lower_bound (b : ℕ → ℂ)
+    (B : ℝ) (hB : 0 < B) (hb : ∀ n, ‖b n‖ ≤ B) :
+    ∃ ρ : ℝ, 0 < ρ ∧ ρ ≤ 1 ∧
+      ∀ n (w : ℂ), ‖w‖ ≤ ρ → (1 / 2 : ℝ) ≤ ‖1 - b n * w‖ := by
+  let ρ : ℝ := min 1 (1 / (2 * B))
+  have hρ : 0 < ρ := lt_min zero_lt_one (one_div_pos.2 (by positivity))
+  refine ⟨ρ, hρ, min_le_left _ _, ?_⟩
+  intro n w hw
+  have hmul : ‖b n * w‖ ≤ (1 / 2 : ℝ) := by
+    calc
+      ‖b n * w‖ = ‖b n‖ * ‖w‖ := norm_mul _ _
+      _ ≤ B * (1 / (2 * B)) :=
+        mul_le_mul (hb n) (hw.trans (min_le_right _ _)) (norm_nonneg _) hB.le
+      _ = 1 / 2 := by field_simp [hB.ne']
+  have h := norm_sub_norm_le (1 : ℂ) (b n * w)
+  norm_num only [norm_one] at h
+  linarith
+
+/-- The same one-half ratio estimate holds on a fixed neighborhood of infinity,
+using its actual local coordinate w=1/z and the exact rational expression. -/
+theorem boundary_ratios_small_at_infinity (a b : ℕ → ℂ)
+    (B : ℝ) (hB : 0 < B) (hb : ∀ n, ‖b n‖ ≤ B)
+    (hsmall : Tendsto (fun n ↦ ‖a n - b n‖) atTop (𝓝 0)) :
+    ∃ ρ : ℝ, 0 < ρ ∧
+      (∀ n (w : ℂ), ‖w‖ ≤ ρ → 1 - b n * w ≠ 0) ∧
+      (∀ᶠ n in atTop, ∀ w : ℂ, ‖w‖ ≤ ρ →
+        ‖(a n - b n) * w / (1 - b n * w)‖ ≤ (1 / 2 : ℝ)) := by
+  obtain ⟨ρ, hρ, hρ1, hden⟩ :=
+    exists_infinity_disc_denominator_lower_bound b B hB hb
+  refine ⟨ρ, hρ, ?_, ?_⟩
+  · intro n w hw hzero
+    have h := hden n w hw
+    simpa [hzero] using h
+  · filter_upwards [(tendsto_order.1 hsmall).2 (1 / 4) (by norm_num)] with n hn
+    intro w hw
+    have hd := hden n w hw
+    have hdpos : 0 < ‖1 - b n * w‖ := (by norm_num : (0 : ℝ) < 1 / 2).trans_le hd
+    rw [norm_div, div_le_iff₀ hdpos, norm_mul]
+    have hnum : ‖a n - b n‖ * ‖w‖ ≤ (1 / 4 : ℝ) := by
+      calc
+        ‖a n - b n‖ * ‖w‖ ≤ (1 / 4 : ℝ) * 1 :=
+          mul_le_mul hn.le (hw.trans hρ1) (norm_nonneg _) (by norm_num)
+        _ = 1 / 4 := mul_one _
+    linarith
+
+#print axioms infDist_tendsto_zero_of_bounded_escape
+#print axioms nearest_boundary_difference_tendsto_zero
+#print axioms boundary_ratios_small_on_compact
+#print axioms exists_infinity_disc_denominator_lower_bound
+#print axioms boundary_ratios_small_at_infinity
+
+end RudinRCA.Chapter15
diff --git a/books/rudin-real-and-complex-analysis/BoundaryProductWork.lean b/books/rudin-real-and-complex-analysis/BoundaryProductWork.lean
