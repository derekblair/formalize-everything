import Mathlib

/-!
# Chapter 1: Abstract integration

Numbering follows the 1987 third edition. `ℝ≥0∞` represents `[0,∞]`,
`EReal` represents `[-∞,∞]`, and `Measurable` into a topological space always
uses its Borel sigma algebra. Sequences start at zero (a reindexing of the
book's positive integers). See `INVENTORY-CH01.md` for coverage and sources.
-/

noncomputable section
open Set Filter MeasureTheory
open scoped Topology ENNReal NNReal

namespace RudinRCA.Chapter01
universe u
variable {X : Type*} [MeasurableSpace X]

/-! §§1.1–1.4 introduce sets, topology and measurability. These are represented
by Lean's `Set`, `TopologicalSpace`, `MeasurableSpace`, `Continuous` and
`Measurable`; the codomain measurable structure in §1.3(c) is `borel`. -/

/-! RCA 1.1 uses Lean's `Set`, `Set.Subset`, union/intersection/difference,
    `Set.Icc/Ioo/Ico/Ioc`, `Set.image/preimage`, `Function.Injective/Surjective`,
    and function composition directly. `EReal` is its extended real line. -/

/-- RCA 1.1: least upper and greatest lower bounds exist in the extended line. -/
theorem proposition_1_1 (E : Set EReal) : IsLUB E (sSup E) ∧ IsGLB E (sInf E) :=
  ⟨isLUB_sSup E, isGLB_sInf E⟩

/-- RCA 1.2(a,b): the topology axioms, with finite intersections. -/
theorem definition_1_2_topology (X : Type*) [TopologicalSpace X] :
    IsOpen (∅ : Set X) ∧ IsOpen (Set.univ : Set X) ∧
    (∀ (n : ℕ) (V : Fin n → Set X), (∀ i, IsOpen (V i)) → IsOpen (⋂ i, V i)) ∧
    (∀ S : Set (Set X), (∀ s ∈ S, IsOpen s) → IsOpen (⋃₀ S)) := by
  exact ⟨isOpen_empty, isOpen_univ, fun _ _ h => isOpen_iInter_of_finite h,
    fun _ h => isOpen_sUnion h⟩

/-- RCA 1.2(c): the inverse-image definition of continuity. -/
theorem definition_1_2_continuous {X Y : Type*} [TopologicalSpace X]
    [TopologicalSpace Y] (f : X → Y) :
    Continuous f ↔ ∀ V : Set Y, IsOpen V → IsOpen (f ⁻¹' V) := continuous_def

/-- RCA 1.3(a,b): the sigma-algebra axioms. -/
theorem definition_1_3_sigma (X : Type*) [MeasurableSpace X] :
    MeasurableSet (Set.univ : Set X) ∧
    (∀ A : Set X, MeasurableSet A → MeasurableSet Aᶜ) ∧
    (∀ A : ℕ → Set X, (∀ n, MeasurableSet (A n)) → MeasurableSet (⋃ n, A n)) :=
  ⟨MeasurableSet.univ, fun _ h => h.compl, fun _ h => MeasurableSet.iUnion h⟩

/-- RCA 1.3(c): the topological-target definition is exactly Borel measurability. -/
theorem definition_1_3_measurable {X Y : Type*} [MeasurableSpace X]
    [TopologicalSpace Y] (f : X → Y) :
    @Measurable X Y _ (borel Y) f ↔
      ∀ V : Set Y, IsOpen V → MeasurableSet (f ⁻¹' V) := by
  let : MeasurableSpace Y := borel Y
  let : BorelSpace Y := ⟨rfl⟩
  exact ⟨fun hf _ hV => hf hV.measurableSet, measurable_of_isOpen⟩

/-- RCA 1.4's metric axioms; finiteness is built into the real codomain. -/
theorem definition_1_4_metric (X : Type*) [MetricSpace X] :
    (∀ x y : X, 0 ≤ dist x y) ∧
    (∀ x y : X, dist x y = 0 ↔ x = y) ∧
    (∀ x y : X, dist x y = dist y x) ∧
    (∀ x y z : X, dist x y ≤ dist x z + dist z y) :=
  ⟨fun _ _ => dist_nonneg, fun _ _ => dist_eq_zero,
    dist_comm, fun x y z => dist_triangle x z y⟩

/-- RCA 1.4's local definition uses open neighborhoods, exactly as in the book. -/
theorem definition_1_4_local {X Y : Type*} [TopologicalSpace X]
    [TopologicalSpace Y] (f : X → Y) (a : X) :
    ContinuousAt f a ↔ ∀ V : Set Y, f a ∈ V ∧ IsOpen V →
      ∃ W : Set X, (a ∈ W ∧ IsOpen W) ∧ Set.MapsTo f W V :=
  (nhds_basis_opens a).tendsto_iff (nhds_basis_opens (f a))

/-- RCA 1.4: metric-space open sets are precisely unions of open balls. -/
theorem proposition_1_4_balls {X : Type*} [MetricSpace X] (U : Set X) :
    IsOpen U ↔ ∃ S : Set (X × ℝ), (∀ p ∈ S, 0 < p.2) ∧
      U = ⋃ p ∈ S, Metric.ball p.1 p.2 := by
  constructor
  · intro hU
    refine ⟨{p | 0 < p.2 ∧ Metric.ball p.1 p.2 ⊆ U}, fun _ h => h.1, ?_⟩
    ext x
    constructor
    · intro hx
      rcases Metric.isOpen_iff.mp hU x hx with ⟨r, hr, hball⟩
      exact Set.mem_iUnion.mpr ⟨(x, r), Set.mem_iUnion.mpr ⟨⟨hr, hball⟩, by simpa⟩⟩
    · intro hx
      rcases Set.mem_iUnion.mp hx with ⟨p, hp⟩
      rcases Set.mem_iUnion.mp hp with ⟨hpS, hxp⟩
      exact hpS.2 hxp
  · rintro ⟨S, _, rfl⟩
    exact isOpen_iUnion fun _ => isOpen_iUnion fun _ => Metric.isOpen_ball

/-- RCA 1.4: the epsilon-delta form of pointwise continuity. -/
theorem proposition_1_4_metric_continuousAt {X Y : Type*} [MetricSpace X]
    [MetricSpace Y] (f : X → Y) (a : X) :
    ContinuousAt f a ↔ ∀ ε > 0, ∃ δ > 0,
      ∀ ⦃x : X⦄, dist x a < δ → dist (f x) (f a) < ε :=
  Metric.continuousAt_iff

/-- RCA 1.4: the sequential form for metric spaces. -/
theorem proposition_1_4_sequential {X Y : Type*} [MetricSpace X] [MetricSpace Y]
    (f : X → Y) (a : X) : ContinuousAt f a ↔
      ∀ x : ℕ → X, Tendsto x atTop (𝓝 a) → Tendsto (f ∘ x) atTop (𝓝 (f a)) :=
  tendsto_nhds_iff_seq_tendsto

/-- RCA 1.4's extended-line topology is generated by the real-ended open rays;
    their finite intersections are the stated open intervals. -/
theorem proposition_1_4_ereal_topology :
    (inferInstance : TopologicalSpace EReal) =
      TopologicalSpace.generateFrom
        (Set.Ioi '' Set.range ((↑) : ℝ → EReal) ∪ Set.Iio '' Set.range ((↑) : ℝ → EReal)) := by
  apply Dense.topology_eq_generateFrom
  apply dense_of_exists_between
  intro a b hab
  rcases EReal.exists_between_coe_real hab with ⟨r, har, hrb⟩
  exact ⟨r, ⟨r, rfl⟩, har, hrb⟩

/-- 1.5: global continuity is continuity at every point. -/
theorem theorem_1_5 {X Y : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    (f : X → Y) : Continuous f ↔ ∀ x, ContinuousAt f x :=
  continuous_iff_continuousAt

/-- 1.6: empty sets, finite unions, countable intersections and differences. -/
theorem proposition_1_6 {X : Type*} [MeasurableSpace X] :
    MeasurableSet (∅ : Set X) ∧
    (∀ (n : ℕ) (A : Fin n → Set X), (∀ i, MeasurableSet (A i)) →
      MeasurableSet (⋃ i, A i)) ∧
    (∀ A : ℕ → Set X, (∀ n, MeasurableSet (A n)) → MeasurableSet (⋂ n, A n)) ∧
    (∀ (n : ℕ) (A : Fin n → Set X), (∀ i, MeasurableSet (A i)) →
      MeasurableSet (⋂ i, A i)) ∧
    (∀ A B : Set X, MeasurableSet A → MeasurableSet B → MeasurableSet (A \ B)) := by
  exact ⟨MeasurableSet.empty, fun _ _ h => MeasurableSet.iUnion h,
    fun _ h => MeasurableSet.iInter h, fun _ _ h => MeasurableSet.iInter h,
    fun _ _ hA hB => hA.diff hB⟩

/-- 1.7(a). -/
theorem theorem_1_7a {X Y Z : Type*} [TopologicalSpace X] [TopologicalSpace Y]
    [TopologicalSpace Z] {f : X → Y} {g : Y → Z}
    (hf : Continuous f) (hg : Continuous g) : Continuous (g ∘ f) := hg.comp hf

/-- 1.7(b), with precisely the Borel interpretation of §1.3(c). -/
theorem theorem_1_7b {X Y Z : Type*} [MeasurableSpace X]
    [TopologicalSpace Y] [TopologicalSpace Z] {f : X → Y} {g : Y → Z}
    (hf : @Measurable X Y _ (borel Y) f) (hg : Continuous g) :
    @Measurable X Z _ (borel Z) (g ∘ f) := by
  exact hg.borel_measurable.comp hf

/-- 1.8: a continuous function of two real measurable functions. -/
theorem theorem_1_8 {X Y : Type*} [MeasurableSpace X] [TopologicalSpace Y]
    {u v : X → ℝ} {Φ : ℝ × ℝ → Y}
    (hu : Measurable u) (hv : Measurable v) (hΦ : Continuous Φ) :
    @Measurable X Y _ (borel Y) (fun x => Φ (u x, v x)) := by
  borelize Y
  exact hΦ.measurable.comp (hu.prodMk hv)

/-- 1.9(a–d): measurable complex functions and indicators. -/
theorem proposition_1_9a {X : Type*} [MeasurableSpace X] {u v : X → ℝ}
    (hu : Measurable u) (hv : Measurable v) :
    Measurable (fun x => (u x : ℂ) + (v x : ℂ) * Complex.I) := by fun_prop

theorem proposition_1_9b {X : Type*} [MeasurableSpace X] {f : X → ℂ}
    (hf : Measurable f) :
    Measurable (fun x => (f x).re) ∧ Measurable (fun x => (f x).im) ∧
      Measurable (fun x => ‖f x‖) := by
  exact ⟨hf.re, hf.im, hf.norm⟩

theorem proposition_1_9c {X : Type*} [MeasurableSpace X] {f g : X → ℂ}
    (hf : Measurable f) (hg : Measurable g) :
    Measurable (f + g) ∧ Measurable (f * g) := ⟨hf.add hg, hf.mul hg⟩

theorem proposition_1_9d {X : Type*} [MeasurableSpace X] {E : Set X}
    (hE : MeasurableSet E) : Measurable (E.indicator (fun _ => (1 : ℂ))) :=
  measurable_const.indicator hE

/-- 1.9(e): the phase is chosen to be one at zeros. -/
theorem proposition_1_9e {X : Type*} [MeasurableSpace X] {f : X → ℂ}
    (hf : Measurable f) :
    ∃ a : X → ℂ, Measurable a ∧ (∀ x, ‖a x‖ = 1) ∧
      ∀ x, f x = a x * (‖f x‖ : ℂ) := by
  let a : X → ℂ := fun x => if f x = 0 then 1 else f x / (‖f x‖ : ℂ)
  refine ⟨a, ?_, ?_, ?_⟩
  · exact measurable_const.ite (hf (measurableSet_singleton 0)) (hf.div hf.norm.complex_ofReal)
  · intro x
    dsimp [a]
    split_ifs with hx
    · simp
    · simp [norm_ne_zero_iff.mpr hx]
  · intro x
    dsimp [a]
    split_ifs with hx
    · simp [hx]
    · exact (div_mul_cancel₀ (f x) (by exact_mod_cast norm_ne_zero_iff.mpr hx)).symm

/-- 1.10: existence and minimality of the generated sigma algebra. -/
theorem theorem_1_10 {X : Type*} (F : Set (Set X)) :
    ∃ m : MeasurableSpace X, (∀ s ∈ F, @MeasurableSet X m s) ∧
      ∀ m' : MeasurableSpace X, (∀ s ∈ F, @MeasurableSet X m' s) → m ≤ m' := by
  exact ⟨MeasurableSpace.generateFrom F,
    fun _ hs => MeasurableSpace.measurableSet_generateFrom hs,
    fun _ h => MeasurableSpace.generateFrom_le h⟩

/-- 1.11: Fσ means a countable union of closed sets. -/
def IsFSigma {X : Type*} [TopologicalSpace X] (s : Set X) : Prop :=
  ∃ F : ℕ → Set X, (∀ n, IsClosed (F n)) ∧ s = ⋃ n, F n

/-- 1.11: closed, Fσ and Gδ sets are Borel measurable. -/
theorem definition_1_11_borel {X : Type*} [TopologicalSpace X] {s : Set X} :
    (IsClosed s → @MeasurableSet X (borel X) s) ∧
    (IsFSigma s → @MeasurableSet X (borel X) s) ∧
    (IsGδ s → @MeasurableSet X (borel X) s) := by
  let : MeasurableSpace X := borel X
  let : BorelSpace X := ⟨rfl⟩
  refine ⟨fun h => h.measurableSet, ?_, fun h => h.measurableSet⟩
  rintro ⟨F, hF, rfl⟩
  exact MeasurableSet.iUnion fun n => (hF n).measurableSet

/-- 1.11: the half-open interval is both Fσ and Gδ. -/
theorem definition_1_11_halfOpen (a b : ℝ) : IsFSigma (Ico a b) ∧ IsGδ (Ico a b) := by
  have hcompl : IsGδ ((Ico a b)ᶜ) := by
    have hc : (Ico a b)ᶜ = Iio a ∪ Ici b := by ext x; simp only [mem_compl_iff, mem_Ico, mem_union, mem_Iio, mem_Ici, not_and_or, not_le, not_lt]
    rw [hc]
    exact isOpen_Iio.isGδ.union isClosed_Ici.isGδ
  obtain ⟨V, hV, heq⟩ := isGδ_iff_eq_iInter_nat.mp hcompl
  refine ⟨⟨fun n => (V n)ᶜ, fun n => (hV n).isClosed_compl, ?_⟩, ?_⟩
  · have := congrArg (fun s : Set ℝ => sᶜ) heq
    simpa only [compl_compl, compl_iInter] using this
  · rw [← Ici_inter_Iio]
    exact isClosed_Ici.isGδ.inter isOpen_Iio.isGδ

/-- 1.11: continuity gives Borel measurability. -/
theorem definition_1_11_continuous {X Y : Type*} [TopologicalSpace X]
    [TopologicalSpace Y] (f : X → Y) (hf : Continuous f) :
    @Measurable X Y (borel X) (borel Y) f := hf.borel_measurable

/-- 1.12(a): the sets with measurable inverse image form a sigma algebra. -/
abbrev pullbackSigma {X Y : Type*} [m : MeasurableSpace X] (f : X → Y) :
    MeasurableSpace Y := MeasurableSpace.map f m

theorem theorem_1_12a {X Y : Type*} [MeasurableSpace X] (f : X → Y) (E : Set Y) :
    @MeasurableSet Y (pullbackSigma f) E ↔ MeasurableSet (f ⁻¹' E) := Iff.rfl

/-- 1.12(b): inverse images of Borel sets. -/
theorem theorem_1_12b {X Y : Type*} [MeasurableSpace X] [TopologicalSpace Y]
    {f : X → Y} (hf : @Measurable X Y _ (borel Y) f)
    {E : Set Y} (hE : @MeasurableSet Y (borel Y) E) :
    MeasurableSet (f ⁻¹' E) := hf hE

/-- 1.12(c): only real cut levels are assumed, although the range is extended. -/
theorem theorem_1_12c {X : Type*} [MeasurableSpace X] {f : X → EReal}
    (hf : ∀ a : ℝ, MeasurableSet {x | (a : EReal) < f x}) : Measurable f := by
  apply measurable_of_Ioi
  intro a
  induction a using EReal.rec with
  | bot =>
    have heq : f ⁻¹' Ioi ⊥ = ⋃ q : ℚ, {x | ((q : ℝ) : EReal) < f x} := by
      ext x
      simp only [mem_preimage, mem_Ioi, mem_iUnion, mem_ofPred_eq]
      constructor
      · intro h
        obtain ⟨q, _, hq⟩ := EReal.exists_rat_btwn_of_lt h
        exact ⟨q, hq⟩
      · rintro ⟨q, hq⟩
        exact (EReal.bot_lt_coe (q : ℝ)).trans hq
    rw [heq]
    exact MeasurableSet.iUnion fun q => hf q
  | coe a => exact hf a
  | top => simp

/-- 1.12(d): composition with a Borel map. -/
theorem theorem_1_12d {X Y Z : Type*} [MeasurableSpace X]
    [TopologicalSpace Y] [TopologicalSpace Z] {f : X → Y} {g : Y → Z}
    (hf : @Measurable X Y _ (borel Y) f)
    (hg : @Measurable Y Z (borel Y) (borel Z) g) :
    @Measurable X Z _ (borel Z) (g ∘ f) := hg.comp hf

/-- 1.13: the book's infimum of tail suprema is the limsup. -/
theorem definition_1_13_formula (a : ℕ → EReal) :
    limsup a atTop = ⨅ n : ℕ, ⨆ i ≥ n, a i := limsup_eq_iInf_iSup_of_nat

/-- 1.13: tail suprema decrease. -/
theorem definition_1_13_antitone (a : ℕ → EReal) :
    Antitone (fun n : ℕ => ⨆ i ≥ n, a i) := by
  intro m n hmn
  exact iSup_le fun i => iSup_le fun hni => le_iSup_of_le i (le_iSup_of_le (hmn.trans hni) le_rfl)

/-- 1.13: tail suprema converge to the upper limit. -/
theorem definition_1_13_tail_tendsto (a : ℕ → EReal) :
    Tendsto (fun n : ℕ => ⨆ i ≥ n, a i) atTop (𝓝 (limsup a atTop)) := by
  rw [definition_1_13_formula]
  exact tendsto_atTop_iInf (definition_1_13_antitone a)

/-- 1.13: a strictly increasing subsequence attains the upper limit. -/
theorem definition_1_13_subsequence (a : ℕ → EReal) :
    ∃ n : ℕ → ℕ, StrictMono n ∧ Tendsto (a ∘ n) atTop (𝓝 (limsup a atTop)) := by
  obtain ⟨r, hr, hrTop⟩ := exists_seq_tendsto_limsup (u := a) (f := atTop)
  obtain ⟨n, hn, hrn⟩ := strictMono_subseq_of_tendsto_atTop hrTop
  exact ⟨r ∘ n, hrn, hr.comp hn.tendsto_atTop⟩

/-- 1.13: every subsequential limit is bounded by the upper limit. -/
theorem definition_1_13_largest (a : ℕ → EReal) (n : ℕ → ℕ)
    (hn : StrictMono n) {l : EReal} (hl : Tendsto (a ∘ n) atTop (𝓝 l)) :
    l ≤ limsup a atTop := by
  rw [← hl.limsup_eq]
  exact hn.tendsto_atTop.limsup_comp_le_limsup

/-- 1.13: sign reversal interchanges lower and upper limits. -/
theorem definition_1_13_liminf_neg (a : ℕ → EReal) :
    liminf a atTop = -limsup (-a) atTop := by simp [EReal.limsup_neg]

/-- 1.13: a convergent sequence has equal upper and lower limits. -/
theorem definition_1_13_of_tendsto (a : ℕ → EReal) (l : EReal)
    (h : Tendsto a atTop (𝓝 l)) : limsup a atTop = l ∧ liminf a atTop = l :=
  ⟨h.limsup_eq, h.liminf_eq⟩

/-- 1.13: the analogous lower-limit formula. -/
theorem definition_1_13_liminf_formula (a : ℕ → EReal) :
    liminf a atTop = ⨆ n : ℕ, ⨅ i ≥ n, a i := liminf_eq_iSup_iInf_of_nat

/-- 1.13: pointwise supremum of a sequence of extended-real functions. -/
def pointwiseSup {X : Type*} (f : ℕ → X → EReal) (x : X) : EReal := ⨆ n, f n x

/-- 1.13: pointwise upper limit. -/
def pointwiseLimsup {X : Type*} (f : ℕ → X → EReal) (x : X) : EReal :=
  limsup (fun n => f n x) atTop

/-- 1.13: the pointwise convergence convention. -/
def IsPointwiseLimit {X : Type*} (f : ℕ → X → EReal) (g : X → EReal) : Prop :=
  ∀ x, Tendsto (fun n => f n x) atTop (𝓝 (g x))

/-- 1.14: measurable suprema and upper limits, including infinite values. -/
theorem theorem_1_14 {X : Type*} [MeasurableSpace X] {f : ℕ → X → EReal}
    (hf : ∀ n, Measurable (f n)) :
    Measurable (fun x => ⨆ n, f n x) ∧
      Measurable (fun x => limsup (fun n => f n x) atTop) := by
  constructor
  · exact Measurable.iSup hf
  · simp only [limsup_eq_iInf_iSup_of_nat]
    exact Measurable.iInf fun n => Measurable.iSup fun i => Measurable.iSup fun _ => hf i

/-- The infimum and lower-limit counterparts used in 1.14. -/
theorem theorem_1_14_inf {X : Type*} [MeasurableSpace X] {f : ℕ → X → EReal}
    (hf : ∀ n, Measurable (f n)) :
    Measurable (fun x => ⨅ n, f n x) ∧
      Measurable (fun x => liminf (fun n => f n x) atTop) := by
  constructor
  · exact Measurable.iInf hf
  · simp only [liminf_eq_iSup_iInf_of_nat]
    exact Measurable.iSup fun n => Measurable.iInf fun i => Measurable.iInf fun _ => hf i

/-- Corollary 1.14(a). -/
theorem corollary_1_14a {X : Type*} [MeasurableSpace X] {f : ℕ → X → ℂ}
    {g : X → ℂ} (hf : ∀ n, Measurable (f n))
    (hlim : ∀ x, Tendsto (fun n => f n x) atTop (𝓝 (g x))) : Measurable g :=
  measurable_of_tendsto_metrizable hf (tendsto_pi_nhds.mpr hlim)

/-- Corollary 1.14(b), including positive and negative parts. -/
theorem corollary_1_14b {X : Type*} [MeasurableSpace X] {f g : X → EReal}
    (hf : Measurable f) (hg : Measurable g) :
    Measurable (fun x => max (f x) (g x)) ∧
    Measurable (fun x => min (f x) (g x)) ∧
    Measurable (fun x => max (f x) 0) ∧
    Measurable (fun x => -min (f x) 0) := by
  exact ⟨hf.max hg, hf.min hg, hf.max measurable_const, (hf.min measurable_const).neg⟩

/-- 1.15: positive and negative parts and their decomposition. -/
theorem definition_1_15 (f : EReal) :
    0 ≤ max f 0 ∧ 0 ≤ -min f 0 ∧
    (f.abs : EReal) = max f 0 + (-min f 0) ∧ f = max f 0 - (-min f 0) := by
  induction f using EReal.rec with
  | bot => simp
  | top => simp
  | coe r =>
    rcases le_total 0 r with hr | hr
    · have h : (0 : EReal) ≤ r := by exact_mod_cast hr
      simp [EReal.coe_abs, abs_of_nonneg hr, h]
    · have h : (r : EReal) ≤ 0 := by exact_mod_cast hr
      simp [EReal.coe_abs, abs_of_nonpos hr, h, ← EReal.coe_neg, hr]

/-- The proposition inside 1.15, also valid for Mathlib's totalized
extended subtraction. No extra finiteness hypothesis is imposed. -/
theorem proposition_1_15 {f g h : EReal} (hg : 0 ≤ g) (hh : 0 ≤ h)
    (heq : f = g - h) :
    max f 0 ≤ g ∧ -min f 0 ≤ h := by
  by_cases hdefined : g ≠ ⊤ ∨ h ≠ ⊤
  ·
    have hfg : f ≤ g := by
      rw [heq]
      simpa using EReal.sub_le_sub (le_refl g) hh
    have hneg : -f ≤ h := by
      rw [heq, EReal.neg_sub (Or.inl (ne_of_gt (EReal.bot_lt_zero.trans_le hg))) hdefined]
      simpa only [sub_eq_add_neg, add_comm, neg_zero, add_zero] using EReal.sub_le_sub (le_refl h) hg
    refine ⟨max_le hfg hg, ?_⟩
    rcases le_total f 0 with hf | hf
    · simpa [min_eq_left hf] using hneg
    · simpa [min_eq_right hf] using hh
  · have hgT : g = ⊤ := by tauto
    have hhT : h = ⊤ := by tauto
    simp [hgT, hhT]

/-- 1.16: being simple before imposing measurability means finite range. -/
def IsSimple (s : X → ℂ) : Prop := (range s).Finite

/-- 1.16: a finite-range complex function is measurable exactly when each
fiber is measurable. Mathlib's SimpleFunc bundles both requirements. -/
theorem definition_1_16_measurable_iff {X : Type*} [MeasurableSpace X]
    {s : X → ℂ} (hs : IsSimple s) :
    Measurable s ↔ ∀ a : ℂ, MeasurableSet (s ⁻¹' {a}) := by
  constructor
  · intro hm a
    exact hm (measurableSet_singleton a)
  · intro hm
    exact (SimpleFunc.measurable
      (f := { toFun := s, measurableSet_fiber' := hm, finite_range' := hs }))

/-- 1.16: the sum of distinct values times their fiber indicators. -/
theorem definition_1_16_sum {X : Type*} (s : X → ℂ) (hs : IsSimple s) (x : X) :
    s x = ∑ a ∈ hs.toFinset, a * (s ⁻¹' {a}).indicator (fun _ => (1 : ℂ)) x := by
  classical
  rw [Finset.sum_eq_single (s x)]
  · simp
  · intro a ha hne
    simp [Ne.symm hne]
  · intro hx
    exact False.elim (hx (hs.mem_toFinset.mpr (mem_range_self x)))

/-- 1.16: nonnegative simple functions have finite range in the finite
nonnegative reals, not in an extended type admitting infinity as a value. -/
def IsNonnegativeSimple {X : Type*} (s : X → ℝ≥0) : Prop := (range s).Finite

theorem definition_1_16_no_infinite_values {X : Type*} (s : X → ℝ≥0) (x : X) :
    (s x : ℝ≥0∞) ≠ ∞ := ENNReal.coe_ne_top

/-- 1.17: monotone, finite-valued measurable simple approximants. -/
theorem theorem_1_17 {X : Type*} [MeasurableSpace X] {f : X → ℝ≥0∞}
    (hf : Measurable f) : ∃ s : ℕ → SimpleFunc X ℝ≥0∞,
    (∀ n x, s n x < ∞) ∧ Monotone (fun n x => s n x) ∧
    (∀ n x, s n x ≤ f x) ∧
    ∀ x, Tendsto (fun n => s n x) atTop (𝓝 (f x)) := by
  refine ⟨SimpleFunc.eapprox f, SimpleFunc.eapprox_lt_top f,
    SimpleFunc.monotone_eapprox f, ?_, SimpleFunc.tendsto_eapprox hf⟩
  intro n x
  rw [← SimpleFunc.iSup_eapprox_apply hf x]
  exact le_iSup (fun n => SimpleFunc.eapprox f n x) n

/-- 1.18(a): the book's positive measure data, with values only on measurable
sets. Finite mass of one measurable set excludes the identically-infinite map. -/
structure BookPositiveMeasure (X : Type*) [MeasurableSpace X] where
  value : ∀ s : Set X, MeasurableSet s → ℝ≥0∞
  countably_additive : ∀ (s : ℕ → Set X) (hs : ∀ n, MeasurableSet (s n)),
    Pairwise (fun i j => Disjoint (s i) (s j)) →
      value (⋃ n, s n) (MeasurableSet.iUnion hs) = ∑' n, value (s n) (hs n)
  finite_somewhere : ∃ s : Set X, ∃ hs : MeasurableSet s, value s hs < ∞

/-- 1.18: the finiteness condition forces the empty set to have mass zero. -/
theorem BookPositiveMeasure.empty {X : Type*} [MeasurableSpace X]
    (m : BookPositiveMeasure X) : m.value ∅ MeasurableSet.empty = 0 := by
  classical
  obtain ⟨A, hA, hAfin⟩ := m.finite_somewhere
  let s : ℕ → Set X := fun n => if n = 0 then A else ∅
  have hs : ∀ n, MeasurableSet (s n) := by
    intro n
    dsimp [s]
    split
    · exact hA
    · exact MeasurableSet.empty
  have hd : Pairwise (fun i j => Disjoint (s i) (s j)) := by
    intro i j hij
    dsimp [s]
    split_ifs with hi hj hj
    · exact False.elim (hij (hi.trans hj.symm))
    · exact disjoint_empty _
    · exact empty_disjoint _
    · exact disjoint_empty _
  have hU : (⋃ n, s n) = A := by
    ext x
    simp only [mem_iUnion]
    constructor
    · rintro ⟨n, hn⟩
      by_cases hn0 : n = 0
      · simpa [s, hn0] using hn
      · simp [s, hn0] at hn
    · intro hx
      exact ⟨0, by simpa [s] using hx⟩
  have hsum := m.countably_additive s hs hd
  have hle : m.value A hA + m.value ∅ MeasurableSet.empty ≤ m.value A hA := by
    have hh := ENNReal.sum_le_tsum (s := ({0, 1} : Finset ℕ)) (f := fun n => m.value (s n) (hs n))
    have hsumeq : m.value A hA = ∑' n, m.value (s n) (hs n) := by simpa [hU] using hsum
    rw [← hsumeq] at hh
    simpa [s] using hh
  have hle' : m.value A hA + m.value ∅ MeasurableSet.empty ≤ m.value A hA + 0 := by simpa using hle
  exact le_antisymm ((ENNReal.add_le_add_iff_left hAfin.ne).mp hle') zero_le

/-- 1.18: book measure data extend to a Mathlib measure without changing any
measurable-set value. Values on other sets use the standard outer extension. -/
def BookPositiveMeasure.toMeasure {X : Type*} [MeasurableSpace X]
    (m : BookPositiveMeasure X) : Measure X :=
  Measure.ofMeasurable m.value m.empty (fun {_} hs hd => m.countably_additive _ hs hd)

theorem BookPositiveMeasure.toMeasure_apply {X : Type*} [MeasurableSpace X]
    (m : BookPositiveMeasure X) (s : Set X) (hs : MeasurableSet s) :
    m.toMeasure s = m.value s hs := Measure.ofMeasurable_apply s hs

/-- Every Mathlib measure supplies the exact book data; the empty set is
finite. No σ-finiteness assumption is introduced. -/
def BookPositiveMeasure.ofMeasure {X : Type*} [MeasurableSpace X]
    (μ : Measure X) : BookPositiveMeasure X where
  value s _ := μ s
  countably_additive s hs hd := measure_iUnion hd hs
  finite_somewhere := ⟨∅, MeasurableSet.empty, by simp⟩

/-- The positive-measure bridge preserves the entire Mathlib measure. -/
theorem BookPositiveMeasure.toMeasure_ofMeasure {X : Type*} [MeasurableSpace X]
    (μ : Measure X) : (BookPositiveMeasure.ofMeasure μ).toMeasure = μ := by
  apply Measure.ext
  intro s hs
  exact BookPositiveMeasure.toMeasure_apply _ s hs

/-- 1.18(c): countable additivity for a complex-valued function on the
measurable sets includes convergence of the series, recorded by `HasSum`. -/
structure BookComplexMeasure (X : Type*) [MeasurableSpace X] where
  value : ∀ s : Set X, MeasurableSet s → ℂ
  countably_additive : ∀ (s : ℕ → Set X) (hs : ∀ n, MeasurableSet (s n)),
    Pairwise (fun i j => Disjoint (s i) (s j)) →
      HasSum (fun n => value (s n) (hs n)) (value (⋃ n, s n) (MeasurableSet.iUnion hs))

/-- Complex countable additivity already forces the empty-set value to zero. -/
theorem BookComplexMeasure.empty {X : Type*} [MeasurableSpace X]
    (m : BookComplexMeasure X) : m.value ∅ MeasurableSet.empty = 0 := by
  have h := m.countably_additive (fun _ => ∅) (fun _ => MeasurableSet.empty)
    (fun _ _ _ => disjoint_empty ∅)
  have hs := h.summable
  simpa only [summable_const_iff] using hs

/-- The complex-measure bridge changes only the unused nonmeasurable-set
values, assigning them zero as Mathlib's VectorMeasure convention requires. -/
def BookComplexMeasure.toComplexMeasure {X : Type*} [MeasurableSpace X]
    (m : BookComplexMeasure X) : ComplexMeasure X := by
  classical
  exact {
    measureOf' := fun s => if hs : MeasurableSet s then m.value s hs else 0
    empty' := by simp [m.empty]
    not_measurable' := fun {_} hs => by simp [hs]
    m_iUnion' := fun {f} hf hd => by
      simpa only [dite_eq_left (MeasurableSet.iUnion hf), dite_eq_left (hf _)] using
        m.countably_additive f hf hd }

theorem BookComplexMeasure.toComplexMeasure_apply {X : Type*} [MeasurableSpace X]
    (m : BookComplexMeasure X) (s : Set X) (hs : MeasurableSet s) :
    m.toComplexMeasure s = m.value s hs := by
  classical
  change (if h : MeasurableSet s then m.value s h else 0) = m.value s hs
  rw [dite_eq_left hs]

/-- Conversely, every Mathlib complex measure supplies the book's data. -/
def BookComplexMeasure.ofComplexMeasure {X : Type*} [MeasurableSpace X]
    (μ : ComplexMeasure X) : BookComplexMeasure X where
  value s _ := μ s
  countably_additive _s hs hd := μ.m_iUnion hs hd

/-- 1.19(a). -/
theorem theorem_1_19a {X : Type*} [MeasurableSpace X] (μ : Measure X) :
    μ ∅ = 0 := measure_empty

/-- 1.19(b). -/
theorem theorem_1_19b {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (n : ℕ) (A : Fin n → Set X) (hA : ∀ i, MeasurableSet (A i))
    (hd : Pairwise (fun i j => Disjoint (A i) (A j))) : μ (⋃ i, A i) = ∑ i, μ (A i) := by
  rw [measure_iUnion hd hA, tsum_fintype]

/-- 1.19(c). -/
theorem theorem_1_19c {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {A B : Set X} (h : A ⊆ B) : μ A ≤ μ B := measure_mono h

/-- 1.19(d). -/
theorem theorem_1_19d {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {A : ℕ → Set X} (hA : Monotone A) :
    Tendsto (fun n => μ (A n)) atTop (𝓝 (μ (⋃ n, A n))) :=
  tendsto_measure_iUnion_atTop hA

/-- 1.19(e), retaining the finite first-set assumption. -/
theorem theorem_1_19e {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {A : ℕ → Set X} (hm : ∀ n, MeasurableSet (A n))
    (hA : Antitone A) (hfin : μ (A 0) ≠ ∞) :
    Tendsto (fun n => μ (A n)) atTop (𝓝 (μ (⋂ n, A n))) :=
  tendsto_measure_iInter_atTop (fun n => (hm n).nullMeasurableSet) hA ⟨0, hfin⟩

/-- 1.19(a), complex-measure addendum on p.17. -/
theorem theorem_1_19a_complex {X : Type*} [MeasurableSpace X] (μ : ComplexMeasure X) :
    μ ∅ = 0 := μ.empty

/-- 1.19(b), complex-measure finite additivity. -/
theorem theorem_1_19b_complex {X : Type*} [MeasurableSpace X] (μ : ComplexMeasure X)
    (n : ℕ) (A : Fin n → Set X) (hm : ∀ i, MeasurableSet (A i))
    (hd : Pairwise (fun i j => Disjoint (A i) (A j))) : μ (⋃ i, A i) = ∑ i, μ (A i) := by
  simpa using μ.of_biUnion_finset (s := Finset.univ)
    (fun i _ j _ hij => hd hij) (fun i _ => hm i)

/-- 1.19(d), complex-measure continuity on increasing sequences. -/
theorem theorem_1_19d_complex {X : Type*} [MeasurableSpace X] (μ : ComplexMeasure X)
    (A : ℕ → Set X) (hm : ∀ n, MeasurableSet (A n)) (hmono : Monotone A) :
    Tendsto (fun n => μ (A n)) atTop (𝓝 (μ (⋃ n, A n))) := by
  exact VectorMeasure.tendsto_vectorMeasure_iUnion_atTop_nat (v := μ) hmono hm

/-- 1.19(e), complex-measure continuity on decreasing sequences. Every value
of a complex measure is finite, so the positive-measure finiteness proviso is automatic. -/
theorem theorem_1_19e_complex {X : Type*} [MeasurableSpace X] (μ : ComplexMeasure X)
    (A : ℕ → Set X) (hm : ∀ n, MeasurableSet (A n)) (hanti : Antitone A) :
    Tendsto (fun n => μ (A n)) atTop (𝓝 (μ (⋂ n, A n))) := by
  exact VectorMeasure.tendsto_vectorMeasure_iInter_atTop_nat (v := μ) hanti hm

/-- 1.20(a): counting measure is the finite cardinality on finite sets. -/
theorem example_1_20a_finite (X : Type*) (s : Set X) (hs : s.Finite) :
    @Measure.count X ⊤ s = hs.toFinset.card := by
  let : MeasurableSpace X := ⊤
  exact Measure.count_apply_finite' hs MeasurableSpace.measurableSet_top

/-- 1.20(a): counting measure is infinite on infinite sets. -/
theorem example_1_20a_infinite (X : Type*) (s : Set X) (hs : s.Infinite) :
    @Measure.count X ⊤ s = ∞ := by
  let : MeasurableSpace X := ⊤
  exact Measure.count_apply_infinite hs

/-- 1.20(b): the unit point mass, on the full power-set σ-algebra. -/
theorem example_1_20b (X : Type*) (x : X) (s : Set X) :
    @Measure.dirac X ⊤ x s = s.indicator (fun _ => (1 : ℝ≥0∞)) x := by
  let : MeasurableSpace X := ⊤
  exact Measure.dirac_apply' x MeasurableSpace.measurableSet_top

/-- 1.20(c), reindexed from positive integers to naturals: decreasing
counting-measure tails have empty intersection, but every tail is infinite. -/
theorem example_1_20c :
    (⋂ n : ℕ, Ici n) = (∅ : Set ℕ) ∧
      (∀ n : ℕ, Measure.count (Ici n) = ∞) ∧
      ¬ Tendsto (fun n : ℕ => Measure.count (Ici n)) atTop
        (𝓝 (Measure.count (⋂ n : ℕ, Ici n))) := by
  have hempty : (⋂ n : ℕ, Ici n) = (∅ : Set ℕ) := by
    apply eq_empty_iff_forall_notMem.mpr
    intro x hx
    exact (Nat.not_succ_le_self x) (mem_iInter.mp hx (x + 1))
  have hinf : ∀ n : ℕ, Measure.count (Ici n) = ∞ := fun n =>
    Measure.count_apply_infinite (Set.Ici_infinite n)
  refine ⟨hempty, hinf, ?_⟩
  intro h
  have htop : Tendsto (fun n : ℕ => Measure.count (Ici n)) atTop (𝓝 ∞) := by
    simpa only [hinf] using (tendsto_const_nhds : Tendsto (fun _ : ℕ => (∞ : ℝ≥0∞)) atTop (𝓝 ∞))
  have heq := tendsto_nhds_unique h htop
  simp [hempty] at heq

/-- RCA 1.21: explicitly bundled data for the book's ordered-triple convention.
    This packages exactly the existing measurable structure and measure. -/
abbrev BookMeasureSpaceData := Σ X : Type u, Σ m : MeasurableSpace X, @Measure X m

def measureSpaceData {X : Type u} [m : MeasurableSpace X] (μ : Measure X) :
    BookMeasureSpaceData := ⟨X, m, μ⟩

/-- 1.22: the extended nonnegative arithmetic conventions. -/
theorem definition_1_22 (a b c : ℝ≥0∞) :
    a + ∞ = ∞ ∧ ∞ + a = ∞ ∧ (0 : ℝ≥0∞) * ∞ = 0 ∧
    (a ≠ 0 → a * ∞ = ∞) ∧ a + b = b + a ∧ a * b = b * a ∧
    (a + b) + c = a + (b + c) ∧ (a * b) * c = a * (b * c) ∧
    a * (b + c) = a * b + a * c := by
  exact ⟨by simp, by simp, by simp, fun ha => ENNReal.mul_top ha,
    add_comm _ _, mul_comm _ _, add_assoc _ _ _, mul_assoc _ _ _, mul_add _ _ _⟩

/-- Cancellation in 1.22 retains exactly the finite/nonzero restrictions. -/
theorem proposition_1_22_cancel {a b c : ℝ≥0∞} (ha : a ≠ ∞) :
    (a + b = a + c ↔ b = c) ∧ (a ≠ 0 → (a * b = a * c ↔ b = c)) := by
  exact ⟨ENNReal.add_right_inj ha, fun h0 => ENNReal.mul_right_inj h0 ha⟩

/-- The monotone-product proposition in 1.22, including 0 times infinity. -/
theorem proposition_1_22 {a b : ℕ → ℝ≥0∞} {A B : ℝ≥0∞}
    (ha : Monotone a) (hb : Monotone b)
    (hA : Tendsto a atTop (𝓝 A)) (hB : Tendsto b atTop (𝓝 B)) :
    Tendsto (fun n => a n * b n) atTop (𝓝 (A * B)) := by
  by_cases hA0 : A = 0
  · have hz : ∀ n, a n = 0 := fun n => le_antisymm
      (hA0 ▸ ha.ge_of_tendsto hA n) bot_le
    simp_rw [hz, hA0, zero_mul]
    exact tendsto_const_nhds
  by_cases hB0 : B = 0
  · have hz : ∀ n, b n = 0 := fun n => le_antisymm
      (hB0 ▸ hb.ge_of_tendsto hB n) bot_le
    simp_rw [hz, hB0, mul_zero]
    exact tendsto_const_nhds
  exact ENNReal.Tendsto.mul hA (Or.inl hA0) hB (Or.inl hB0)

/-- The measurable sum/product conclusion of 1.22. -/
theorem proposition_1_22_measurable {X : Type*} [MeasurableSpace X]
    {f g : X → ℝ≥0∞} (hf : Measurable f) (hg : Measurable g) :
    Measurable (fun x => f x + g x) ∧ Measurable (fun x => f x * g x) :=
  ⟨hf.add hg, hf.mul hg⟩

/-- 1.23: the lower integral is exactly the supremum over finite-valued
nonnegative measurable simple functions, even when the integral is infinite. -/
theorem definition_1_23 {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (E : Set X) (f : X → ℝ≥0∞) :
    (∫⁻ x in E, f x ∂μ) =
      ⨆ (s : SimpleFunc X ℝ≥0) (_ : ∀ x, (s x : ℝ≥0∞) ≤ f x),
        (s.map ((↑) : ℝ≥0 → ℝ≥0∞)).lintegral (μ.restrict E) :=
  lintegral_eq_nnreal f (μ.restrict E)

/-- The finite sum definition in 1.23, on the distinct values of the simple function. -/
theorem definition_1_23_simple {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (E : Set X) (_hE : MeasurableSet E) (s : SimpleFunc X ℝ≥0∞)
    (_hfinite : ∀ x, s x < ∞) :
    (∫⁻ x in E, s x ∂μ) = ∑ a ∈ s.range, a * μ (s ⁻¹' {a} ∩ E) := by
  rw [SimpleFunc.lintegral_eq_lintegral, SimpleFunc.lintegral]
  congr 1
  ext a
  rw [Measure.restrict_apply (s.measurableSet_fiber a)]

/-- 1.24(a–f): elementary properties of the nonnegative integral. -/
theorem proposition_1_24a {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (E : Set X) {f g : X → ℝ≥0∞} (h : f ≤ g) :
    ∫⁻ x in E, f x ∂μ ≤ ∫⁻ x in E, g x ∂μ := lintegral_mono h

theorem proposition_1_24b {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {A B : Set X} (h : A ⊆ B) (f : X → ℝ≥0∞) :
    ∫⁻ x in A, f x ∂μ ≤ ∫⁻ x in B, f x ∂μ := lintegral_mono_set h

theorem proposition_1_24c {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (E : Set X) {f : X → ℝ≥0∞} (hf : Measurable f) (c : ℝ≥0) :
    ∫⁻ x in E, (c : ℝ≥0∞) * f x ∂μ = c * ∫⁻ x in E, f x ∂μ :=
  lintegral_const_mul _ hf

theorem proposition_1_24d {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {E : Set X} (hE : MeasurableSet E) {f : X → ℝ≥0∞} (h : ∀ x ∈ E, f x = 0) :
    ∫⁻ x in E, f x ∂μ = 0 := setLIntegral_eq_zero hE h

theorem proposition_1_24e {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {E : Set X} (h : μ E = 0) (f : X → ℝ≥0∞) : ∫⁻ x in E, f x ∂μ = 0 := by
  simp [Measure.restrict_eq_zero.mpr h]

theorem proposition_1_24f {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {E : Set X} (hE : MeasurableSet E) (f : X → ℝ≥0∞) :
    ∫⁻ x in E, f x ∂μ = ∫⁻ x, E.indicator f x ∂μ := (lintegral_indicator hE f).symm

/-- RCA 1.25. A nonnegative, finite-valued measurable simple function defines
    a measure by integration; the simple integral is additive. -/
theorem proposition_1_25 (μ : Measure X) (s t : SimpleFunc X ℝ≥0) :
    (∃ φ : Measure X, ∀ E : Set X, MeasurableSet E →
      φ E = ∫⁻ x in E, (s x : ℝ≥0∞) ∂μ) ∧
    (∫⁻ x, ((s x : ℝ≥0∞) + (t x : ℝ≥0∞)) ∂μ) =
      (∫⁻ x, (s x : ℝ≥0∞) ∂μ) + ∫⁻ x, (t x : ℝ≥0∞) ∂μ := by
  constructor
  · exact ⟨μ.withDensity (fun x => (s x : ℝ≥0∞)),
      fun E hE => withDensity_apply _ hE⟩
  · exact lintegral_add_left s.measurable.coe_nnreal_ennreal _

/-- RCA 1.26, including measurability of the pointwise limit. -/
theorem theorem_1_26 (μ : Measure X) (f : ℕ → X → ℝ≥0∞) (F : X → ℝ≥0∞)
    (hf : ∀ n, Measurable (f n))
    (hmono : ∀ x, Monotone (fun n => f n x))
    (hlim : ∀ x, Tendsto (fun n => f n x) atTop (𝓝 (F x))) :
    Measurable F ∧
      Tendsto (fun n => ∫⁻ x, f n x ∂μ) atTop (𝓝 (∫⁻ x, F x ∂μ)) := by
  exact ⟨ENNReal.measurable_of_tendsto hf (tendsto_pi_nhds.mpr hlim),
    lintegral_tendsto_of_tendsto_of_monotone (fun n => (hf n).aemeasurable)
      (Filter.Eventually.of_forall hmono) (Filter.Eventually.of_forall hlim)⟩

/-- RCA 1.27: nonnegative series can be integrated term by term. -/
theorem theorem_1_27 (μ : Measure X) (f : ℕ → X → ℝ≥0∞)
    (hf : ∀ n, Measurable (f n)) :
    (∫⁻ x, ∑' n, f n x ∂μ) = ∑' n, ∫⁻ x, f n x ∂μ := by
  exact lintegral_tsum (fun n => (hf n).aemeasurable)

/-- The unnumbered corollary attached to RCA 1.27. -/
theorem corollary_1_27 (a : ℕ → ℕ → ℝ≥0∞) :
    (∑' i, ∑' j, a i j) = ∑' j, ∑' i, a i j := by
  exact ENNReal.tsum_comm

/-- RCA 1.28 (Fatou's lemma). -/
theorem theorem_1_28 (μ : Measure X) (f : ℕ → X → ℝ≥0∞)
    (hf : ∀ n, Measurable (f n)) :
    (∫⁻ x, Filter.liminf (fun n => f n x) atTop ∂μ) ≤
      Filter.liminf (fun n => ∫⁻ x, f n x ∂μ) atTop := by
  exact lintegral_liminf_le hf

/-- RCA 1.29: the measure defined by a density and its change-of-measure
    identity. No finiteness or sigma-finiteness assumption is added. -/
theorem theorem_1_29 (μ : Measure X) (f : X → ℝ≥0∞) (hf : Measurable f) :
    ∃ φ : Measure X,
      (∀ E : Set X, MeasurableSet E → φ E = ∫⁻ x in E, f x ∂μ) ∧
      (∀ g : X → ℝ≥0∞, Measurable g →
        (∫⁻ x, g x ∂φ) = ∫⁻ x, g x * f x ∂μ) := by
  refine ⟨μ.withDensity f, (fun E hE => withDensity_apply _ hE), ?_⟩
  intro g hg
  simpa only [Pi.mul_apply, mul_comm] using
    lintegral_withDensity_eq_lintegral_mul μ hf hg

/-- RCA 1.30, before the enlargement in 1.37: ordinary measurable complex
    functions whose absolute-value integral is finite. -/
def BookL1 (μ : Measure X) (f : X → ℂ) : Prop :=
  Measurable f ∧ (∫⁻ x, ENNReal.ofReal ‖f x‖ ∂μ) < ∞

/-- The exact bridge between the book's 1.30 and Mathlib integrability. -/
theorem definition_1_30 (μ : Measure X) (f : X → ℂ) :
    BookL1 μ f ↔ Measurable f ∧ Integrable f μ := by
  constructor
  · rintro ⟨hm, hfin⟩
    exact ⟨hm, hm.aestronglyMeasurable, (hasFiniteIntegral_iff_norm f).mpr hfin⟩
  · rintro ⟨hm, hi⟩
    exact ⟨hm, (hasFiniteIntegral_iff_norm f).mp hi.hasFiniteIntegral⟩

/-- RCA 1.31's four-part definition, using `ofReal r` for the nonnegative
    part of the real number `r`; the negative part is `ofReal (-r)`. -/
def BookComplexIntegral (μ : Measure X) (E : Set X) (f : X → ℂ) : ℂ :=
  (((∫⁻ x in E, ENNReal.ofReal (f x).re ∂μ).toReal -
    (∫⁻ x in E, ENNReal.ofReal (-(f x).re) ∂μ).toReal : ℝ) : ℂ) +
  (((∫⁻ x in E, ENNReal.ofReal (f x).im ∂μ).toReal -
    (∫⁻ x in E, ENNReal.ofReal (-(f x).im) ∂μ).toReal : ℝ) : ℂ) * Complex.I

/-- The four nonnegative integrals in 1.31 are finite. -/
theorem definition_1_31_finite (μ : Measure X) (E : Set X) (f : X → ℂ)
    (hf : BookL1 μ f) :
    (∫⁻ x in E, ENNReal.ofReal (f x).re ∂μ) < ∞ ∧
    (∫⁻ x in E, ENNReal.ofReal (-(f x).re) ∂μ) < ∞ ∧
    (∫⁻ x in E, ENNReal.ofReal (f x).im ∂μ) < ∞ ∧
    (∫⁻ x in E, ENNReal.ofReal (-(f x).im) ∂μ) < ∞ := by
  have hi : Integrable f (μ.restrict E) := ((definition_1_30 μ f).mp hf).2.restrict
  simpa only [RCLike.re_to_complex, RCLike.im_to_complex, Pi.neg_apply] using
    And.intro hi.re.lintegral_lt_top
      (And.intro hi.re.neg.lintegral_lt_top
        (And.intro hi.im.lintegral_lt_top hi.im.neg.lintegral_lt_top))

/-- The 1.31 definition agrees with Mathlib's integral on its stated domain. -/
theorem definition_1_31 (μ : Measure X) (E : Set X) (f : X → ℂ)
    (hf : BookL1 μ f) : BookComplexIntegral μ E f = ∫ x in E, f x ∂μ := by
  have hi : Integrable f (μ.restrict E) := ((definition_1_30 μ f).mp hf).2.restrict
  have hre := integral_eq_lintegral_pos_part_sub_lintegral_neg_part hi.re
  have him := integral_eq_lintegral_pos_part_sub_lintegral_neg_part hi.im
  simp only [RCLike.re_to_complex, RCLike.im_to_complex] at hre him
  unfold BookComplexIntegral
  change (∫ x in E, (f x).re ∂μ) = _ at hre
  change (∫ x in E, (f x).im ∂μ) = _ at him
  rw [← hre, ← him]
  exact integral_re_add_im hi

/-- The extended-real convention at the end of RCA 1.31 is used only when
    at least one of the positive and negative integrals is finite. -/
def ExtendedIntegralDefined (μ : Measure X) (E : Set X) (f : X → EReal) : Prop :=
  Measurable f ∧ ((∫⁻ x in E, (f x).toENNReal ∂μ) < ∞ ∨
    (∫⁻ x in E, (-f x).toENNReal ∂μ) < ∞)

def BookExtendedIntegral (μ : Measure X) (E : Set X) (f : X → EReal)
    (_hf : ExtendedIntegralDefined μ E f) : EReal :=
  ((∫⁻ x in E, (f x).toENNReal ∂μ) : EReal) -
    ((∫⁻ x in E, (-f x).toENNReal ∂μ) : EReal)

/-- 1.32: complex linearity, including membership in L1. -/
theorem theorem_1_32 {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {f g : X → ℂ} (hf : Measurable f) (hg : Measurable g)
    (hfi : Integrable f μ) (hgi : Integrable g μ) (a b : ℂ) :
    Measurable (fun x => a * f x + b * g x) ∧
    Integrable (fun x => a * f x + b * g x) μ ∧
    (∫ x, a * f x + b * g x ∂μ) = a * (∫ x, f x ∂μ) + b * (∫ x, g x ∂μ) := by
  refine ⟨(measurable_const.mul hf).add (measurable_const.mul hg),
    (hfi.const_mul a).add (hgi.const_mul b), ?_⟩
  rw [integral_add (hfi.const_mul a) (hgi.const_mul b), integral_const_mul,
    integral_const_mul]

/-- 1.33: the norm of a complex integral is bounded by the integral of the norm. -/
theorem theorem_1_33 {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (f : X → ℂ) (_hf : Measurable f) (_hfi : Integrable f μ) :
    ‖∫ x, f x ∂μ‖ ≤ ∫ x, ‖f x‖ ∂μ := norm_integral_le_integral_norm f

/-- 1.34: all three conclusions of dominated convergence. -/
theorem theorem_1_34 {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {F : ℕ → X → ℂ} {f : X → ℂ} {g : X → ℝ}
    (hF : ∀ n, Measurable (F n)) (hg : Integrable g μ)
    (hbound : ∀ n x, ‖F n x‖ ≤ g x)
    (hlim : ∀ x, Tendsto (fun n => F n x) atTop (𝓝 (f x))) :
    Measurable f ∧ Integrable f μ ∧
    Tendsto (fun n => ∫ x, ‖F n x - f x‖ ∂μ) atTop (𝓝 0) ∧
    Tendsto (fun n => ∫ x, F n x ∂μ) atTop (𝓝 (∫ x, f x ∂μ)) := by
  have hfm : Measurable f := measurable_of_tendsto_metrizable hF (tendsto_pi_nhds.mpr hlim)
  have hba : ∀ n, ∀ᵐ x ∂μ, ‖F n x‖ ≤ g x := fun n => ae_of_all _ (hbound n)
  have hla : ∀ᵐ x ∂μ, Tendsto (fun n => F n x) atTop (𝓝 (f x)) := ae_of_all _ hlim
  have hfi : Integrable f μ := ⟨hfm.aestronglyMeasurable,
    hasFiniteIntegral_of_dominated_convergence hg.2 hba hla⟩
  refine ⟨hfm, hfi, ?_, tendsto_integral_of_dominated_convergence g
    (fun n => (hF n).aestronglyMeasurable) hg hba hla⟩
  have hfb : ∀ x, ‖f x‖ ≤ g x := fun x =>
    le_of_tendsto (hlim x).norm (Eventually.of_forall (fun n => hbound n x))
  have hconv := tendsto_integral_of_dominated_convergence (fun x => 2 * g x)
    (fun n => ((hF n).sub hfm).norm.aestronglyMeasurable)
    (hg.const_mul 2)
    (fun n => ae_of_all _ (fun x => by
      rw [Real.norm_of_nonneg (norm_nonneg _)]
      exact (norm_sub_le _ _).trans (by linarith [hbound n x, hfb x])))
    (ae_of_all μ (fun x => by simpa using ((hlim x).sub tendsto_const_nhds).norm))
  simpa using hconv

/-- RCA 1.35's measurable exceptional-set definition of almost everywhere on E. -/
def BookAEOn (μ : Measure X) (E : Set X) (P : X → Prop) : Prop :=
  ∃ N : Set X, MeasurableSet N ∧ μ N = 0 ∧ N ⊆ E ∧ ∀ x ∈ E \ N, P x

/-- Equivalence with Mathlib's almost-everywhere filter, including measurable
    containment of the exceptional set inside E. -/
theorem definition_1_35 (μ : Measure X) (E : Set X) (hE : MeasurableSet E)
    (P : X → Prop) : BookAEOn μ E P ↔ ∀ᵐ x ∂μ.restrict E, P x := by
  rw [ae_restrict_iff' hE]
  constructor
  · rintro ⟨N, _, hN, _, hP⟩
    apply ae_iff.mpr
    apply measure_mono_null (t := N) ?_ hN
    intro x hx
    simp only [Set.mem_ofPred_eq, not_imp] at hx
    by_contra hxN
    exact hx.2 (hP x ⟨hx.1, hxN⟩)
  · intro hP
    rcases exists_measurable_superset_of_null (ae_iff.mp hP) with ⟨N, hsub, hNm, hN⟩
    refine ⟨N ∩ E, hNm.inter hE, measure_mono_null inter_subset_left hN,
      inter_subset_right, ?_⟩
    intro x hx
    by_contra hxP
    exact hx.2 ⟨hsub (by simp only [Set.mem_ofPred_eq, not_imp]; exact ⟨hx.1, hxP⟩), hx.1⟩

/-- RCA 1.35: equality a.e. is an equivalence relation. -/
theorem proposition_1_35_equivalence (μ : Measure X) :
    Equivalence (fun f g : X → ℂ => f =ᵐ[μ] g) := by
  exact ⟨fun _ => Filter.EventuallyEq.rfl, fun h => h.symm, fun h₁ h₂ => h₁.trans h₂⟩

/-- RCA 1.35: null modifications do not change integrals over any measurable set. -/
theorem proposition_1_35_integral (μ : Measure X) (E : Set X)
    {f g : X → ℂ} (h : f =ᵐ[μ] g) :
    (∫ x in E, f x ∂μ) = ∫ x in E, g x ∂μ :=
  integral_congr_ae (ae_restrict_of_ae h)

theorem proposition_1_35_lintegral (μ : Measure X) (E : Set X)
    {f g : X → ℝ≥0∞} (h : f =ᵐ[μ] g) :
    (∫⁻ x in E, f x ∂μ) = ∫⁻ x in E, g x ∂μ :=
  lintegral_congr_ae (ae_restrict_of_ae h)

/-- The sigma-algebra in RCA 1.36. The type tag only changes the measurable
    structure; the underlying points and subsets are unchanged. -/
abbrev completionSigma (μ : Measure X) : MeasurableSpace X :=
  inferInstanceAs (MeasurableSpace (NullMeasurableSpace X μ))

/-- The completed measure in RCA 1.36. -/
def completedMeasure (μ : Measure X) : @Measure X (completionSigma μ) :=
  μ.completion

/-- RCA 1.36: exactly the measurable-sandwich characterization, exactly the
    prescribed value on a sandwich, and completeness of the extension. -/
theorem theorem_1_36 (μ : Measure X) :
    (∀ E : Set X, @MeasurableSet X (completionSigma μ) E ↔
      ∃ A B : Set X, MeasurableSet A ∧ MeasurableSet B ∧
        A ⊆ E ∧ E ⊆ B ∧ μ (B \ A) = 0) ∧
    (∀ E A B : Set X, MeasurableSet A → MeasurableSet B →
      A ⊆ E → E ⊆ B → μ (B \ A) = 0 → completedMeasure μ E = μ A) ∧
    (∀ N E : Set X, @MeasurableSet X (completionSigma μ) N →
      completedMeasure μ N = 0 → E ⊆ N →
        @MeasurableSet X (completionSigma μ) E) := by
  have eq_of_sandwich {E A B : Set X} (hAE : A ⊆ E) (hEB : E ⊆ B)
      (hnull : μ (B \ A) = 0) : E =ᵐ[μ] A := by
    apply Filter.EventuallyLE.antisymm
    · exact ae_le_set.mpr (measure_mono_null (sdiff_subset_sdiff_left hEB) hnull)
    · exact hAE.eventuallySubset
  refine ⟨?_, ?_, ?_⟩
  · intro E
    change NullMeasurableSet E μ ↔ _
    constructor
    · intro hE
      rcases hE.exists_measurable_subset_ae_eq with ⟨A, hAE, hA, hAe⟩
      rcases hE.exists_measurable_superset_ae_eq with ⟨B, hEB, hB, hBe⟩
      exact ⟨A, B, hA, hB, hAE, hEB, ae_le_set.mp (hBe.trans hAe.symm).le⟩
    · rintro ⟨A, B, hA, _, hAE, hEB, hnull⟩
      exact hA.nullMeasurableSet.congr (eq_of_sandwich hAE hEB hnull).symm
  · intro E A B _ _ hAE hEB hnull
    change μ E = μ A
    exact measure_congr (eq_of_sandwich hAE hEB hnull)
  · intro N E _ hN hEN
    change NullMeasurableSet E μ
    exact NullMeasurableSet.of_null (measure_mono_null hEN hN)

/-- RCA 1.37: zero extension from a measurable conull domain is measurable;
    arbitrary extensions are a.e. measurable, give identical integrals, and
    are ordinarily measurable when the measure is complete. -/
theorem proposition_1_37 (μ : Measure X) (E : Set X) (hE : MeasurableSet E)
    (hnull : μ Eᶜ = 0) (f : E → ℂ) (hf : Measurable f) :
    ∃ g : X → ℂ, Measurable g ∧ (∀ x : E, g x = f x) ∧
      (∀ x ∉ E, g x = 0) ∧
      ∀ h : X → ℂ, (∀ x : E, h x = f x) →
        AEMeasurable h μ ∧
        (∀ A : Set X, (∫ x in A, h x ∂μ) = ∫ x in A, g x ∂μ) ∧
        (μ.IsComplete → Measurable h) := by
  classical
  let g : X → ℂ := fun x => if hx : x ∈ E then f ⟨x, hx⟩ else 0
  have hg : Measurable g := Measurable.dite hf measurable_const hE
  refine ⟨g, hg, ?_, ?_, ?_⟩
  · intro x
    simp [g, x.property]
  · intro x hx
    simp [g, hx]
  · intro h hh
    have hEq : h =ᵐ[μ] g := by
      filter_upwards [ae_iff.mpr hnull] with x hx
      simpa [g, hx] using hh ⟨x, hx⟩
    refine ⟨hg.aemeasurable.congr hEq.symm, ?_, ?_⟩
    · intro A
      exact integral_congr_ae (ae_restrict_of_ae hEq)
    · intro hcomplete
      let : μ.IsComplete := hcomplete
      exact hg.congr_ae hEq.symm

/-- 1.38: absolute convergence almost everywhere, integrability of the sum,
and termwise integration. The extended sum hypothesis also ensures every term
is integrable; representatives may be only AE measurable as allowed by 1.37. -/
theorem theorem_1_38 {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (F : ℕ → X → ℂ) (hF : ∀ n, AEStronglyMeasurable (F n) μ)
    (hsum : (∑' n, ∫⁻ x, ‖F n x‖ₑ ∂μ) < ∞) :
    (∀ᵐ x ∂μ, Summable (fun n => ‖F n x‖)) ∧
    Integrable (fun x => ∑' n, F n x) μ ∧
    (∫ x, ∑' n, F n x ∂μ) = ∑' n, ∫ x, F n x ∂μ := by
  have hn : ∀ᵐ x ∂μ, Summable (fun n => ‖F n x‖) := by
    apply summable_norm_of_tsum_eLpNorm_ne_top (p := 1) le_rfl
    simpa only [eLpNorm_one_eq_lintegral_enorm (hF _)] using hsum.ne
  refine ⟨hn, ?_, integral_tsum hF hsum.ne⟩
  refine ⟨?_, hasFiniteIntegral_iff_enorm.mpr ?_⟩
  · exact aestronglyMeasurable_of_tendsto_ae _
      (fun n => Finset.aestronglyMeasurable_sum (Finset.range n) (fun i _ => hF i))
      (hn.mono (fun x hx => by simpa using hx.of_norm.tendsto_sum_tsum_nat))
  · calc
      (∫⁻ x, ‖∑' n, F n x‖ₑ ∂μ) ≤ ∫⁻ x, ∑' n, ‖F n x‖ₑ ∂μ :=
        lintegral_mono (fun _ => enorm_tsum_le_tsum_enorm)
      _ = ∑' n, ∫⁻ x, ‖F n x‖ₑ ∂μ := lintegral_tsum (fun n => (hF n).enorm)
      _ < ∞ := hsum

/-- 1.39(a): a nonnegative function with zero set integral vanishes there AE. -/
theorem theorem_1_39a {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {f : X → ℝ≥0∞} (hf : AEMeasurable f μ) {E : Set X} (_hE : MeasurableSet E)
    (hzero : ∫⁻ x in E, f x ∂μ = 0) : f =ᵐ[μ.restrict E] 0 :=
  (lintegral_eq_zero_iff' hf.restrict).mp hzero

/-- 1.39(b): vanishing integrals on every measurable set force vanishing AE. -/
theorem theorem_1_39b {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {f : X → ℂ} (hfi : Integrable f μ)
    (hzero : ∀ E, MeasurableSet E → ∫ x in E, f x ∂μ = 0) : f =ᵐ[μ] 0 :=
  hfi.ae_eq_zero_of_forall_setIntegral_eq_zero (fun E hE _ => hzero E hE)

/-- 1.39(c): equality in the complex integral triangle inequality forces
one constant phase almost everywhere. -/
theorem theorem_1_39c {X : Type*} [MeasurableSpace X] (μ : Measure X)
    {f : X → ℂ} (hfi : Integrable f μ)
    (heq : ‖∫ x, f x ∂μ‖ = ∫ x, ‖f x‖ ∂μ) :
    ∃ a : ℂ, ‖a‖ = 1 ∧ ∀ᵐ x ∂μ, a * f x = (‖f x‖ : ℂ) := by
  obtain ⟨c, hc, hcz⟩ := Complex.exists_norm_mul_eq_self (∫ x, f x ∂μ)
  let a := starRingEnd ℂ c
  have ha : ‖a‖ = 1 := by simpa [a] using hc
  have haz : a * (∫ x, f x ∂μ) = (‖∫ x, f x ∂μ‖ : ℂ) := by
    rw [← hcz, ← mul_assoc]
    simp [a, Complex.conj_mul', hc]
  have hnorm (x : X) : ‖a * f x‖ = ‖f x‖ := by rw [norm_mul, ha, one_mul]
  have hnonneg (x : X) : 0 ≤ ‖f x‖ - (a * f x).re := by
    have h := Complex.re_le_norm (a * f x)
    rw [hnorm] at h
    exact sub_nonneg.mpr h
  have hint : Integrable (fun x => ‖f x‖ - (a * f x).re) μ :=
    hfi.norm.sub (hfi.const_mul a).re
  have hzero : (∫ x, ‖f x‖ - (a * f x).re ∂μ) = 0 := by
    change (∫ x, ‖f x‖ - RCLike.re (a * f x) ∂μ) = 0
    rw [integral_sub hfi.norm (hfi.const_mul a).re]
    rw [integral_re (hfi.const_mul a), integral_const_mul, haz]
    simp [heq]
  have hae := (integral_eq_zero_iff_of_nonneg hnonneg hint).mp hzero
  refine ⟨a, ha, ?_⟩
  filter_upwards [hae] with x hx
  have hre : (a * f x).re = ‖f x‖ := (sub_eq_zero.mp hx).symm
  apply Complex.ext
  · simpa using hre
  · rw [Complex.ofReal_im]
    apply Complex.abs_re_eq_norm.mp
    rw [hre, abs_of_nonneg (norm_nonneg _), hnorm]

/-- 1.40: if every positive-measure set average belongs to a closed set,
the function belongs to it almost everywhere. No convexity of that set is assumed. -/
theorem closed_set_averages_of_measurable {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (hμ : μ Set.univ < ∞) {f : X → ℂ} (hf : Measurable f) (hfi : Integrable f μ)
    {S : Set ℂ} (hS : IsClosed S)
    (havg : ∀ E : Set X, MeasurableSet E → 0 < μ E → (⨍ x in E, f x ∂μ) ∈ S) :
    ∀ᵐ x ∂μ, f x ∈ S := by
  let : IsFiniteMeasure μ := ⟨hμ⟩
  have hball (z : ℂ) (r : ℝ) (hsub : Metric.closedBall z r ⊆ Sᶜ) :
      μ (f ⁻¹' Metric.closedBall z r) = 0 := by
    by_contra hn
    have hm : MeasurableSet (f ⁻¹' Metric.closedBall z r) :=
      hf Metric.isClosed_closedBall.measurableSet
    have hb : (⨍ x in f ⁻¹' Metric.closedBall z r, f x ∂μ) ∈ Metric.closedBall z r :=
      (convex_closedBall z r).set_average_mem Metric.isClosed_closedBall hn
        (measure_ne_top _ _) (ae_restrict_mem hm) hfi.integrableOn
    exact hsub hb (havg _ hm (pos_iff_ne_zero.mpr hn))
  have hex : ∀ z : ↥(Sᶜ), ∃ r : ℝ, 0 < r ∧ Metric.closedBall (z : ℂ) r ⊆ Sᶜ := by
    intro z
    exact Metric.nhds_basis_closedBall.mem_iff.mp (hS.isOpen_compl.mem_nhds z.property)
  choose r hr hsub using hex
  have hcover : Sᶜ ⊆ ⋃ z : ↥(Sᶜ), Metric.ball (z : ℂ) (r z) := by
    intro z hz
    exact mem_iUnion.mpr ⟨⟨z, hz⟩, Metric.mem_ball_self (hr ⟨z, hz⟩)⟩
  obtain ⟨C, hCc, hC⟩ := (HereditarilyLindelofSpace.isLindelof (Sᶜ)).elim_countable_subcover
    (fun z : ↥(Sᶜ) => Metric.ball (z : ℂ) (r z)) (fun _ => Metric.isOpen_ball) hcover
  have hnull : μ (⋃ z ∈ C, f ⁻¹' Metric.ball (z : ℂ) (r z)) = 0 := by
    apply (measure_biUnion_null_iff hCc).mpr
    intro z _
    exact measure_mono_null (preimage_mono Metric.ball_subset_closedBall) (hball z (r z) (hsub z))
  rw [ae_iff]
  apply measure_mono_null _ hnull
  intro x hx
  have hx' := hC hx
  simpa only [mem_iUnion, mem_preimage] using hx'

/-- 1.40 with the enlarged measurability convention of 1.37: no ordinary
measurability assumption is imposed on the chosen representative. -/
theorem theorem_1_40 {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (hμ : μ Set.univ < ∞) {f : X → ℂ} (hfi : Integrable f μ)
    {S : Set ℂ} (hS : IsClosed S)
    (havg : ∀ E : Set X, MeasurableSet E → 0 < μ E → (⨍ x in E, f x ∂μ) ∈ S) :
    ∀ᵐ x ∂μ, f x ∈ S := by
  have hm : AEMeasurable f μ := hfi.aemeasurable
  have heq := hm.ae_eq_mk
  have hgi : Integrable (hm.mk f) μ := hfi.congr heq
  have hga : ∀ E : Set X, MeasurableSet E → 0 < μ E →
      (⨍ x in E, hm.mk f x ∂μ) ∈ S := by
    intro E hE hpos
    rw [← average_congr (ae_restrict_of_ae heq)]
    exact havg E hE hpos
  have hgm := closed_set_averages_of_measurable μ hμ hm.measurable_mk hgi hS hga
  filter_upwards [heq, hgm] with x hx hxS
  rwa [hx]

/-- 1.41: first Borel–Cantelli, stated as finite membership almost everywhere. -/
theorem theorem_1_41 {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (E : ℕ → Set X) (_hE : ∀ n, MeasurableSet (E n))
    (hsum : (∑' n, μ (E n)) < ∞) : ∀ᵐ x ∂μ, {n | x ∈ E n}.Finite :=
  ae_finite_setOfPred_mem hsum.ne

end RudinRCA.Chapter01
