/-- **17.20 (Hilbert-space linear isometry `ℓ²(ℕ, ℂ) ≃ₗᵢ[ℂ] H²`, RCA p. 347).** -/
abbrev coeffEquivH2 : lp (fun _ : ℕ ↦ ℂ) 2 ≃ₗᵢ[ℂ] HardyElem 2 :=
