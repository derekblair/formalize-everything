    rwa [← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _)] at h
  have hbd_le_M : ∀ᵐ ζ ∂circleMeasure, ‖radialBoundaryLimit f ζ‖ ≤ M_dom ζ := by
