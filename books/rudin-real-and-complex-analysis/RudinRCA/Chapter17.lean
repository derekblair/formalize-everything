                    (Real.rpow_nonneg (norm_nonneg _) _)
              _ = ‖h z‖ ^ (2 / p_real) := one_mul _
          calc ‖f z‖ₑ = ENNReal.ofReal ‖f z‖ := (ofReal_norm _).symm
            _ ≤ ENNReal.ofReal (‖h z‖ ^ (2 / p_real)) := ENNReal.ofReal_le_ofReal hnorm_le
            _ = (ENNReal.ofReal ‖h z‖) ^ (2 / p_real) :=
                (ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) h2divp_pos.le).symm
            _ = ‖h z‖ₑ ^ (2 / p_real) := by rw [ofReal_norm]
            _ ≤ nontangentialMaximalENNReal α h ζ ^ (2 / p_real) :=
                ENNReal.rpow_le_rpow (le_biSup (fun w ↦ ‖h w‖ₑ) hz) h2divp_pos.le
        have hf_lint_lt : ∫⁻ ζ, nontangentialMaximalENNReal α f ζ ^ p_real ∂circleMeasure < ⊤ := by
