      fun w hw ↦ hg_R_hol_ρ w (Metric.ball_subset_ball hρ_gt1.le hw)
    have hg_R_cont_cb : ContinuousOn g_R (Metric.closedBall (0 : ℂ) 1) :=
      (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hg_R_hol_ρ).mono
        (Metric.closedBall_subset_ball hρ_gt1)
    obtain ⟨w_max, _, hw_max⟩ := (isCompact_closedBall (0 : ℂ) 1).exists_isMaxOn
      ⟨0, Metric.mem_closedBall_self zero_le_one⟩ hg_R_cont_cb.norm
    have hg_R_top : IsInHardySpace ⊤ g_R := by
      refine ⟨ENNReal.top_ne_zero, hg_R_hol1, ?_⟩
      rw [hardySizeENNReal_top_eq_biSup hg_R_hol1]
      refine lt_of_le_of_lt (iSup₂_le fun w hw ↦ ?_) (ENNReal.ofReal_lt_top (r := ‖g_R w_max‖))
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (hw_max (Metric.ball_subset_closedBall hw))
    have hg_R_h2 : IsInHardySpace 2 g_R := hg_R_top.mono_exponent (by norm_num) le_top
    have hbd_gR : ∀ ζ : FourierCircle, radialBoundaryLimit g_R ζ = radialSlice f R ζ := by
      intro ζ
      have htend : Tendsto (fun r : ℝ ↦ radialSlice g_R r ζ) (𝓝[<] 1)
          (𝓝 (radialSlice f R ζ)) := by
        have hmem_ball : (R : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
          simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos hR_pos] using hR.2
        have hca_f : ContinuousAt f ((R : ℂ) * circlePoint ζ) :=
          (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf.2.1).continuousAt
            (Metric.isOpen_ball.mem_nhds hmem_ball)
        have hcont_arg : Continuous (fun r : ℝ ↦ (R : ℂ) * ((r : ℂ) * circlePoint ζ)) := by
          fun_prop
        have harg1 : (R : ℂ) * (((1 : ℝ) : ℂ) * circlePoint ζ) = (R : ℂ) * circlePoint ζ := by
          simp
        have hca_r : ContinuousAt (fun r : ℝ ↦ radialSlice g_R r ζ) 1 := by
          change ContinuousAt (fun r : ℝ ↦ f ((R : ℂ) * ((r : ℂ) * circlePoint ζ))) 1
          exact ContinuousAt.comp (harg1.symm ▸ hca_f) hcont_arg.continuousAt
        have hval1 : radialSlice g_R 1 ζ = radialSlice f R ζ := by
          simp [g_R, radialSlice]
        exact hval1 ▸ hca_r.tendsto.mono_left nhdsWithin_le_nhds
      exact htend.limUnder_eq
    have hpoisson_R := ((h2_powerSeries_and_boundary hg_R_hol1).2.2 hg_R_h2).2.2.2.2.2.1
      (z / (R : ℂ)) hw₀_ball
