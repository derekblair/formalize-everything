  have hcauchy_lim := tendsto_integral_kernel_mul_of_L1_tendsto
    hKC_ev hKC0_cont (hunif_of_joint_cont Ψ_C hΨ_C_cont) hF_int_ev hbd_int hL1_tendsto
  have hcauchy_const : Tendsto
      (fun R : ℝ ↦ ∫ ζ, Ψ_C (R, ζ) * radialSlice f R ζ ∂circleMeasure)
      (𝓝[<] 1) (𝓝 (f z)) := by
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [Ioo_mem_nhdsLT hR₀_lt1] with R hR
    exact (hrescaled_both R hR).2
  have hcauchy_final : f z =
      ∫ ζ, (1 - z * star (circlePoint ζ))⁻¹ • radialBoundaryLimit f ζ ∂circleMeasure := by
    have heq := tendsto_nhds_unique hcauchy_const hcauchy_lim
    rw [heq]
    refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
    dsimp [Ψ_C]
    rw [div_one]
  have hcauchy_quot : f z =
      ∫ ζ, (radialBoundaryLimit f ζ * circlePoint ζ) / (circlePoint ζ - z) ∂circleMeasure := by
    rw [hcauchy_final]
    refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
    dsimp only
    rw [smul_eq_mul]
    let w := circlePoint ζ
    have hw_mul : w * star w = 1 := by
      rw [RCLike.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq, norm_circlePoint,
        one_pow, Complex.ofReal_one]
    have hw_ne : w ≠ 0 := fun h0 ↦ by simpa [w, h0] using norm_circlePoint ζ
    have hker : (1 - z * star w)⁻¹ = w / (w - z) := by
      rw [inv_eq_iff_eq_inv, inv_div, eq_div_iff hw_ne]
      calc (1 - z * star w) * w = w - z * (w * star w) := by ring
        _ = w - z := by rw [hw_mul, mul_one]
    change (1 - z * star w)⁻¹ * radialBoundaryLimit f ζ =
      (radialBoundaryLimit f ζ * w) / (w - z)
    rw [hker]
    ring
  exact ⟨hpoisson_final, hcauchy_final, hcauchy_quot⟩

/-- Boundary convergence, `L^∞` isometric boundary norm, and Poisson representation for `H^∞`
(`p = ⊤`), completing `HardyPartBInterface.hardy_boundary` for all `0 < p ≤ ∞`. -/
private theorem h_infty_boundary {f : ℂ → ℂ} (hf : IsInHardySpace ⊤ f) :
    (∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
    MemLp (radialBoundaryLimit f) ⊤ circleMeasure ∧
    eLpNorm (radialBoundaryLimit f) ⊤ circleMeasure = hardySizeENNReal ⊤ f ∧
    (∀ z ∈ Metric.ball (0 : ℂ) 1,
      f z = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit f ζ
        ∂circleMeasure) := by
  have hf1 : IsInHardySpace 1 f := hf.mono_exponent one_ne_zero le_top
  have h11 := theorem17_11 one_ne_zero ENNReal.one_ne_top hf1
  have hae_rad : ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ)) := by
    filter_upwards [h11.2.1] with ζ hζ using hζ.2
  have hbd_aem : AEStronglyMeasurable (radialBoundaryLimit f) circleMeasure :=
    h11.2.2.1.aestronglyMeasurable
  have hf_le_M : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ ≤ hardySize ⊤ f := by
    intro z hz
    have hle_enn : ‖f z‖ₑ ≤ hardySizeENNReal ⊤ f := by
      rw [hardySizeENNReal_top_eq_biSup hf.2.1]
      exact le_biSup (fun w ↦ ‖f w‖ₑ) hz
    have h := ENNReal.toReal_mono hf.2.2.ne hle_enn
    rwa [← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _)] at h
  have hbd_le_M : ∀ᵐ ζ ∂circleMeasure, ‖radialBoundaryLimit f ζ‖ ≤ hardySize ⊤ f := by
    filter_upwards [hae_rad] with ζ hrad
    refine le_of_tendsto hrad.norm ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    refine hf_le_M _ ?_
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr.1] using hr.2
  have hmemLp_top : MemLp (radialBoundaryLimit f) ⊤ circleMeasure :=
    MemLp.of_bound hbd_aem (hardySize ⊤ f) hbd_le_M
  have hpoisson : ∀ z ∈ Metric.ball (0 : ℂ) 1,
      f z = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit f ζ
        ∂circleMeasure :=
    fun z hz ↦ (h11.2.2.2.2.2 le_rfl z hz).1
  have heLp_eq : eLpNorm (radialBoundaryLimit f) ⊤ circleMeasure = hardySizeENNReal ⊤ f := by
    refine le_antisymm ?_ ?_
    · calc eLpNorm (radialBoundaryLimit f) ⊤ circleMeasure
          ≤ ENNReal.ofReal (hardySize ⊤ f) := by
            rw [eLpNorm_exponent_top hbd_aem]
            exact eLpNormEssSup_le_of_ae_bound hbd_le_M
        _ = hardySizeENNReal ⊤ f := ENNReal.ofReal_toReal hf.2.2.ne
    · rw [hardySizeENNReal_top_eq_biSup hf.2.1]
      refine iSup₂_le fun z hz ↦ ?_
      let L_norm : ℝ := (eLpNorm (radialBoundaryLimit f) ⊤ circleMeasure).toReal
      have hae_le_L : ∀ᵐ ζ ∂circleMeasure, ‖radialBoundaryLimit f ζ‖ ≤ L_norm := by
        filter_upwards [ae_le_eLpNormEssSup (f := radialBoundaryLimit f) (μ := circleMeasure)]
          with ζ hζ
        have htop_eq : eLpNormEssSup (radialBoundaryLimit f) circleMeasure =
            eLpNorm (radialBoundaryLimit f) ⊤ circleMeasure :=
          (eLpNorm_exponent_top hbd_aem).symm
        rw [htop_eq] at hζ
        have h := ENNReal.toReal_mono hmemLp_top.eLpNorm_lt_top.ne hζ
        rwa [← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _)] at h
      have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
      have hP_nn : ∀ ζ : FourierCircle, 0 ≤ _root_.poissonKernel 0 z (circlePoint ζ) := by
        intro ζ
        simp only [_root_.poissonKernel, sub_zero, norm_circlePoint, one_pow]
        have h1 : 0 ≤ 1 - ‖z‖ ^ 2 := by nlinarith [norm_nonneg z]
        exact div_nonneg h1 (sq_nonneg _)
      have hP_cont : Continuous (fun ζ : FourierCircle ↦ _root_.poissonKernel 0 z (circlePoint ζ)) := by
        simp only [_root_.poissonKernel, sub_zero, norm_circlePoint, one_pow]
        refine continuous_const.div ((continuous_circlePoint.sub continuous_const).norm.pow 2) ?_
        intro ζ
        have hpos : 0 < ‖circlePoint ζ - z‖ := by
          have htri := norm_sub_norm_le (circlePoint ζ) z
          rw [norm_circlePoint] at htri
          linarith
        exact (sq_pos_of_pos hpos).ne'
      have hP_int1 : ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂circleMeasure = 1 := by
        obtain ⟨θ, hθ⟩ : ∃ θ : ℝ, ((‖z‖ : ℝ) : ℂ) * Complex.exp ((θ : ℂ) * Complex.I) = z := by
          by_cases hz0 : z = 0
          · exact ⟨0, by simp [hz0]⟩
          · have hr_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz0
            have hw : z / (‖z‖ : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
              rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
                Real.norm_eq_abs, abs_of_pos hr_pos, div_self hr_pos.ne']
            obtain ⟨ζ, hζ⟩ := circlePoint_surjective_sphere hw
            obtain ⟨θ, rfl⟩ := QuotientAddGroup.mk_surjective ζ
            exact ⟨θ, by rw [← circlePoint_coe, hζ,
              mul_div_cancel₀ z (Complex.ofReal_ne_zero.mpr hr_pos.ne')]⟩
        have h1 := poissonIntegral_circleMeasure_eq_interval (fun _ : FourierCircle ↦ (1 : ℝ))
          (norm_nonneg z) θ
        simp only [smul_eq_mul, mul_one] at h1
        rw [← hθ, h1]
        have hper : Function.Periodic
            (fun t ↦ RudinRCA.Chapter11.poissonKernel ‖z‖ (θ - t)) (2 * Real.pi) := by
          intro t
          dsimp only
          rw [← RudinRCA.Chapter11.node11_5_even ‖z‖ (θ - (t + 2 * Real.pi)),
            ← RudinRCA.Chapter11.node11_5_even ‖z‖ (θ - t)]
          have : -(θ - (t + 2 * Real.pi)) = -(θ - t) + 2 * Real.pi := by ring
          rw [this, RudinRCA.Chapter11.node11_5_periodic]
        have hshift := hper.intervalIntegral_add_eq (θ - Real.pi) (-Real.pi)
        rw [show θ - Real.pi + 2 * Real.pi = θ + Real.pi by ring,
          show -Real.pi + 2 * Real.pi = Real.pi by ring] at hshift
        rw [← hshift]
        have hcomp := intervalIntegral.integral_comp_sub_left
          (RudinRCA.Chapter11.poissonKernel ‖z‖) θ (a := θ - Real.pi) (b := θ + Real.pi)
        rw [show θ - (θ + Real.pi) = -Real.pi by ring,
          show θ - (θ - Real.pi) = Real.pi by ring] at hcomp
        rw [hcomp]
        exact (RudinRCA.Chapter11.node11_5_integral_eq_one (norm_nonneg z) hz_lt).1
      have hfz_le : ‖f z‖ ≤ L_norm := by
        rw [hpoisson z hz]
        have hPbd_int : Integrable
            (fun ζ ↦ _root_.poissonKernel 0 z (circlePoint ζ) * ‖radialBoundaryLimit f ζ‖)
            circleMeasure := by
          obtain ⟨ζ_m, _, hm⟩ := isCompact_univ.exists_isMaxOn univ_nonempty hP_cont.norm.continuousOn
          exact (h11.2.2.1.integrable le_rfl).norm.bdd_mul hP_cont.aestronglyMeasurable
            (Eventually.of_forall fun ζ ↦ hm (mem_univ ζ))
        have hPL_int : Integrable
            (fun ζ ↦ _root_.poissonKernel 0 z (circlePoint ζ) * L_norm) circleMeasure :=
          (hP_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)).mul_const L_norm
        calc ‖∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit f ζ
              ∂circleMeasure‖
            ≤ ∫ ζ, ‖_root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit f ζ‖
                ∂circleMeasure := norm_integral_le_integral_norm _
          _ = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) * ‖radialBoundaryLimit f ζ‖
                ∂circleMeasure := by
              refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
              dsimp only
              rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (hP_nn ζ)]
          _ ≤ ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) * L_norm ∂circleMeasure := by
              refine integral_mono_ae hPbd_int hPL_int ?_
              filter_upwards [hae_le_L] with ζ hζ
              exact mul_le_mul_of_nonneg_left hζ (hP_nn ζ)
          _ = L_norm := by rw [integral_mul_const, hP_int1, one_mul]
      calc ‖f z‖ₑ = ENNReal.ofReal ‖f z‖ := (ofReal_norm _).symm
        _ ≤ ENNReal.ofReal L_norm := ENNReal.ofReal_le_ofReal hfz_le
        _ = eLpNorm (radialBoundaryLimit f) ⊤ circleMeasure :=
            ENNReal.ofReal_toReal hmemLp_top.eLpNorm_lt_top.ne
  exact ⟨hae_rad, hmemLp_top, heLp_eq, hpoisson⟩

/-! ### 17.13: The F. and M. Riesz Theorem (Rudin pp. 341–342) -/

private theorem complexMeasure_variation_finite {X : Type*} [MeasurableSpace X]
    (μ : MeasureTheory.ComplexMeasure X) : MeasureTheory.IsFiniteMeasure μ.variation where
  measure_univ_lt_top := by
    have hle : μ.variation ≤ μ.re.totalVariation + μ.im.totalVariation := by
      apply MeasureTheory.VectorMeasure.variation_le_of_forall_enorm_le
      intro E _
      have h : ‖μ E‖ ≤ μ.re.totalVariation.real E + μ.im.totalVariation.real E := by
        calc ‖μ E‖ ≤ |(μ E).re| + |(μ E).im| := Complex.norm_le_abs_re_add_abs_im _
          _ ≤ μ.re.totalVariation.real E + μ.im.totalVariation.real E := by
            have h₁ := μ.re.norm_le_totalVariation E
            have h₂ := μ.im.norm_le_totalVariation E
            change ‖(μ E).re‖ ≤ _ at h₁
            change ‖(μ E).im‖ ≤ _ at h₂
            rw [Real.norm_eq_abs] at h₁ h₂
            exact add_le_add h₁ h₂
      calc ‖μ E‖ₑ = ENNReal.ofReal ‖μ E‖ := (ofReal_norm _).symm
        _ ≤ ENNReal.ofReal (μ.re.totalVariation.real E + μ.im.totalVariation.real E) :=
          ENNReal.ofReal_le_ofReal h
        _ = (μ.re.totalVariation + μ.im.totalVariation) E := by
          rw [ENNReal.ofReal_add MeasureTheory.measureReal_nonneg MeasureTheory.measureReal_nonneg]
          simp only [MeasureTheory.measureReal_def,
            ENNReal.ofReal_toReal (MeasureTheory.measure_ne_top _ _),
            MeasureTheory.Measure.add_apply]
    exact lt_of_le_of_lt (hle Set.univ) (MeasureTheory.measure_lt_top _ _)

private theorem norm_mul_clm_le_one : ‖ContinuousLinearMap.mul ℝ ℂ‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun z ↦ ?_
  rw [one_mul]
  refine ContinuousLinearMap.opNorm_le_bound _ (norm_nonneg z) fun w ↦ ?_
  simp

private theorem enorm_complexMeasureIntegral_le_lintegral_enorm
    (μ : MeasureTheory.ComplexMeasure FourierCircle) (g : FourierCircle → ℂ) :
    ‖RudinRCA.Chapter10.complexMeasureIntegral μ g‖ₑ ≤ ∫⁻ ζ, ‖g ζ‖ₑ ∂μ.variation := by
  unfold RudinRCA.Chapter10.complexMeasureIntegral
  have hB : ‖ContinuousLinearMap.mul ℝ ℂ‖ₑ ≤ 1 := by
    rw [← ofReal_norm, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal norm_mul_clm_le_one
  calc ‖∫ᵛ ζ, g ζ ∂[ContinuousLinearMap.mul ℝ ℂ; μ]‖ₑ
      ≤ ‖ContinuousLinearMap.mul ℝ ℂ‖ₑ * ∫⁻ ζ, ‖g ζ‖ₑ ∂μ.variation :=
        MeasureTheory.VectorMeasure.enorm_integral_le_lintegral_enorm
    _ ≤ 1 * ∫⁻ ζ, ‖g ζ‖ₑ ∂μ.variation := by gcongr
    _ = ∫⁻ ζ, ‖g ζ‖ₑ ∂μ.variation := one_mul _

private theorem complexMeasureIntegral_indicator_one
    (μ : MeasureTheory.ComplexMeasure FourierCircle)
    {E : Set FourierCircle} (hE : MeasurableSet E) :
    RudinRCA.Chapter10.complexMeasureIntegral μ (E.indicator fun _ ↦ (1 : ℂ)) = μ E := by
  have : MeasureTheory.IsFiniteMeasure μ.variation := complexMeasure_variation_finite μ
  unfold RudinRCA.Chapter10.complexMeasureIntegral MeasureTheory.VectorMeasure.integral
  rw [MeasureTheory.setToFun_indicator_const _ hE (measure_ne_top μ.variation E) (1 : ℂ),
    MeasureTheory.transpose_eq_cbmApplyMeasure, MeasureTheory.cbmApplyMeasure_apply]
  simp

private theorem poissonKernel_circlePoint_nonneg {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1)
    (ζ : FourierCircle) :
    0 ≤ _root_.poissonKernel 0 z (circlePoint ζ) := by
  have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
  simp only [_root_.poissonKernel, sub_zero, norm_circlePoint, one_pow]
  have h1 : 0 ≤ 1 - ‖z‖ ^ 2 := by nlinarith [norm_nonneg z]
  exact div_nonneg h1 (sq_nonneg _)

private theorem continuous_poissonKernel_circlePoint {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    Continuous (fun ζ : FourierCircle ↦ _root_.poissonKernel 0 z (circlePoint ζ)) := by
  have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
  simp only [_root_.poissonKernel, sub_zero, norm_circlePoint, one_pow]
  refine continuous_const.div ((continuous_circlePoint.sub continuous_const).norm.pow 2) ?_
  intro ζ
  have htri := norm_sub_norm_le (circlePoint ζ) z
  rw [norm_circlePoint] at htri
  exact (sq_pos_of_pos (by linarith)).ne'

private theorem continuous_poissonKernel_pair {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Continuous (fun p : FourierCircle × FourierCircle ↦
      _root_.poissonKernel 0 ((r : ℂ) * circlePoint p.1) (circlePoint p.2)) := by
  have heq : (fun p : FourierCircle × FourierCircle ↦
      _root_.poissonKernel 0 ((r : ℂ) * circlePoint p.1) (circlePoint p.2)) =
      fun p : FourierCircle × FourierCircle ↦
      (1 - ‖(r : ℂ) * circlePoint p.1‖ ^ 2) /
        ‖circlePoint p.2 - (r : ℂ) * circlePoint p.1‖ ^ 2 := by
    funext p
    simp [_root_.poissonKernel]
  rw [heq]
  have h1 : Continuous (fun p : FourierCircle × FourierCircle ↦
      (r : ℂ) * circlePoint p.1) :=
    continuous_const.mul (continuous_circlePoint.comp continuous_fst)
  have h2 : Continuous (fun p : FourierCircle × FourierCircle ↦ circlePoint p.2) :=
    continuous_circlePoint.comp continuous_snd
  refine (continuous_const.sub (h1.norm.pow 2)).div ((h2.sub h1).norm.pow 2) fun p ↦ ?_
  have hlt1 : ‖(r : ℂ) * circlePoint p.1‖ < 1 := by
    simpa [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0] using hr1
  have htri := norm_sub_norm_le (circlePoint p.2) ((r : ℂ) * circlePoint p.1)
  rw [norm_circlePoint] at htri
  exact (sq_pos_of_pos (by linarith)).ne'

private theorem integral_poissonKernel_circleMeasure {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂circleMeasure = 1 := by
  have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
  obtain ⟨θ, hθ⟩ : ∃ θ : ℝ, ((‖z‖ : ℝ) : ℂ) * Complex.exp ((θ : ℂ) * Complex.I) = z := by
    by_cases hz0 : z = 0
    · exact ⟨0, by simp [hz0]⟩
    · have hr_pos : 0 < ‖z‖ := norm_pos_iff.mpr hz0
      have hw : z / (‖z‖ : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
        rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
          Real.norm_eq_abs, abs_of_pos hr_pos, div_self hr_pos.ne']
      obtain ⟨ζ, hζ⟩ := circlePoint_surjective_sphere hw
      obtain ⟨θ, rfl⟩ := QuotientAddGroup.mk_surjective ζ
      exact ⟨θ, by rw [← circlePoint_coe, hζ,
        mul_div_cancel₀ z (Complex.ofReal_ne_zero.mpr hr_pos.ne')]⟩
  have h1 := poissonIntegral_circleMeasure_eq_interval (fun _ : FourierCircle ↦ (1 : ℝ))
    (norm_nonneg z) θ
  simp only [smul_eq_mul, mul_one] at h1
  rw [← hθ, h1]
  have hper : Function.Periodic
      (fun t ↦ RudinRCA.Chapter11.poissonKernel ‖z‖ (θ - t)) (2 * Real.pi) := by
    intro t
    dsimp only
    rw [← RudinRCA.Chapter11.node11_5_even ‖z‖ (θ - (t + 2 * Real.pi)),
      ← RudinRCA.Chapter11.node11_5_even ‖z‖ (θ - t)]
    have : -(θ - (t + 2 * Real.pi)) = -(θ - t) + 2 * Real.pi := by ring
    rw [this, RudinRCA.Chapter11.node11_5_periodic]
  have hshift := hper.intervalIntegral_add_eq (θ - Real.pi) (-Real.pi)
  rw [show θ - Real.pi + 2 * Real.pi = θ + Real.pi by ring,
    show -Real.pi + 2 * Real.pi = Real.pi by ring] at hshift
  rw [← hshift]
  have hcomp := intervalIntegral.integral_comp_sub_left
    (RudinRCA.Chapter11.poissonKernel ‖z‖) θ (a := θ - Real.pi) (b := θ + Real.pi)
  rw [show θ - (θ + Real.pi) = -Real.pi by ring,
    show θ - (θ - Real.pi) = Real.pi by ring] at hcomp
  rw [hcomp]
  exact (RudinRCA.Chapter11.node11_5_integral_eq_one (norm_nonneg z) hz_lt).1

/-- Coordinate-free rational identity for the Poisson kernel on the unit circle:
for `z ∈ Metric.ball 0 1` and `w = circlePoint ζ`,
`(poissonKernel 0 z w : ℂ) = (1 - z * star w)⁻¹ + (star z * w) * (1 - star z * w)⁻¹`. -/
private theorem poissonKernel_eq_inv_sum {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1)
    (ζ : FourierCircle) :
    ((_root_.poissonKernel 0 z (circlePoint ζ) : ℝ) : ℂ) =
      (1 - z * star (circlePoint ζ))⁻¹ +
        (star z * circlePoint ζ) * (1 - star z * circlePoint ζ)⁻¹ := by
  have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
  let w : ℂ := circlePoint ζ
  let q : ℂ := z * star w
  let p : ℂ := star z * w
  have hw_mul : w * star w = 1 := by
    rw [RCLike.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq, norm_circlePoint,
      one_pow, Complex.ofReal_one]
  have hz_mul : z * star z = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
    rw [RCLike.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq]
  have hqp : q * p = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
    dsimp only [q, p]
    calc (z * star w) * (star z * w) = (z * star z) * (w * star w) := by ring
      _ = ((‖z‖ ^ 2 : ℝ) : ℂ) := by rw [hz_mul, hw_mul, mul_one]
  have hq_lt : ‖q‖ < 1 := by
    dsimp only [q, w]
    rw [norm_mul, norm_star, norm_circlePoint, mul_one]
    exact hz_lt
  have hp_lt : ‖p‖ < 1 := by
    dsimp only [p, w]
    rw [norm_mul, norm_star, norm_circlePoint, mul_one]
    exact hz_lt
  have h1q_ne : 1 - q ≠ 0 := sub_ne_zero.mpr (fun h ↦ hq_lt.ne' (by rw [← h, norm_one]))
  have h1p_ne : 1 - p ≠ 0 := sub_ne_zero.mpr (fun h ↦ hp_lt.ne' (by rw [← h, norm_one]))
  have hdenom : ((‖w - z‖ ^ 2 : ℝ) : ℂ) = (1 - q) * (1 - p) := by
    rw [← Complex.normSq_eq_norm_sq, ← Complex.mul_conj, ← RCLike.star_def, star_sub]
    dsimp only [q, p]
    calc (w - z) * (star w - star z)
        = w * star w - z * star w - star z * w + (z * star z) * 1 := by ring
      _ = 1 - z * star w - star z * w + (z * star z) * (w * star w) := by rw [hw_mul]
      _ = (1 - z * star w) * (1 - star z * w) := by ring
  have hrhs : (1 - q)⁻¹ + p * (1 - p)⁻¹ = (1 - q * p) / ((1 - q) * (1 - p)) := by
    field_simp [h1q_ne, h1p_ne]
    ring
  change ((_root_.poissonKernel 0 z w : ℝ) : ℂ) = (1 - q)⁻¹ + p * (1 - p)⁻¹
  rw [hrhs, hqp, ← hdenom]
  dsimp only [w, _root_.poissonKernel]
  simp only [sub_zero, norm_circlePoint, one_pow]
  push_cast
  rfl

/-- Radial symmetry of the unit-disc Poisson kernel:
`P_r(ζ - η) = P_r(η - ζ)` for `r : ℝ` and `ζ, η : FourierCircle`. -/
private theorem poissonKernel_radial_symm (r : ℝ) (ζ η : FourierCircle) :
    _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) =
      _root_.poissonKernel 0 ((r : ℂ) * circlePoint η) (circlePoint ζ) := by
  let u : ℂ := circlePoint ζ
  let v : ℂ := circlePoint η
  have hu_mul : u * star u = 1 := by
    rw [RCLike.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq, norm_circlePoint,
      one_pow, Complex.ofReal_one]
  have hv_mul : v * star v = 1 := by
    rw [RCLike.star_def, Complex.mul_conj, Complex.normSq_eq_norm_sq, norm_circlePoint,
      one_pow, Complex.ofReal_one]
  have hid : (u * v) * star (u - (r : ℂ) * v) = v - (r : ℂ) * u := by
    rw [star_sub, star_mul, Complex.star_def, Complex.conj_ofReal, ← RCLike.star_def]
    calc (u * v) * (star u - star v * (r : ℂ))
        = (u * star u) * v - (r : ℂ) * u * (v * star v) := by ring
      _ = v - (r : ℂ) * u := by rw [hu_mul, hv_mul]; ring
  have hnorm_eq : ‖v - (r : ℂ) * u‖ = ‖u - (r : ℂ) * v‖ := by
    rw [← hid, norm_mul, norm_mul, norm_star]
    dsimp only [u, v]
    rw [norm_circlePoint, norm_circlePoint, mul_one, one_mul]
  simp only [_root_.poissonKernel, sub_zero, norm_circlePoint, one_pow, norm_mul, mul_one]
  change (1 - ‖(r : ℂ)‖ ^ 2) / ‖v - (r : ℂ) * u‖ ^ 2 =
    (1 - ‖(r : ℂ)‖ ^ 2) / ‖u - (r : ℂ) * v‖ ^ 2
  rw [hnorm_eq]

private theorem circlePoint_pow_eq_trigMonomial (m : ℕ) (ζ : FourierCircle) :
    circlePoint ζ ^ m = RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
  rw [circlePoint_coe, ← Complex.exp_nat_mul, RudinRCA.Chapter04.trigMonomial_apply_real]
  congr 1
  push_cast
  ring

private theorem star_trigMonomial (n : ℤ) (ζ : FourierCircle) :
    star (RudinRCA.Chapter04.trigMonomial n ζ) = RudinRCA.Chapter04.trigMonomial (-n) ζ := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
  have h1 := RudinRCA.Chapter04.trigMonomial_apply_real n t
  have h2 := RudinRCA.Chapter04.trigMonomial_apply_real (-n) t
  simp only [RudinRCA.Chapter04.trigMonomial] at h1 h2 ⊢
  rw [h1, h2, RCLike.star_def, ← Complex.exp_conj]
  congr 1
  simp

private theorem norm_trigMonomial_apply (n : ℤ) (ζ : FourierCircle) :
    ‖RudinRCA.Chapter04.trigMonomial n ζ‖ = 1 := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
  rw [RudinRCA.Chapter04.trigMonomial_apply_real]
  have : ((n : ℂ) * (t : ℂ)) * Complex.I = (((n : ℝ) * t : ℝ) : ℂ) * Complex.I := by
    push_cast; ring
  rw [this, Complex.norm_exp_ofReal_mul_I]

/-- **Theorem 17.13 (The F. and M. Riesz Theorem)** (Rudin, *Real and Complex Analysis*, 3rd ed.,
pp. 341–342; see `SCOPING-G.md` line 105):
If `μ` is a complex Borel measure on the unit circle `FourierCircle` whose Fourier coefficients
`∫ e^{-int} dμ(t)` vanish at every negative integer (`n < 0`), then `μ` is absolutely continuous
with respect to normalized Lebesgue measure `circleMeasure` (equivalently `μ.variation ≪ circleMeasure`),
and in fact there exists `f ∈ H^1` such that `dμ = f* dσ` (`μ E = ∫_E radialBoundaryLimit f dσ`
for every Borel set `E`). -/
theorem theorem17_13 (μ : MeasureTheory.ComplexMeasure FourierCircle)
    (hμ_neg : ∀ n : ℤ, n < 0 →
      RudinRCA.Chapter10.complexMeasureIntegral μ
        (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)) = 0) :
    μ ≪ᵥ circleMeasure.toENNRealVectorMeasure ∧
    μ.variation ≪ circleMeasure ∧
    (∀ E : Set FourierCircle, MeasurableSet E → circleMeasure E = 0 → μ E = 0) ∧
    (∃ f : ℂ → ℂ, IsInHardySpace 1 f ∧
      ∀ E : Set FourierCircle, MeasurableSet E →
        μ E = ∫ ζ in E, radialBoundaryLimit f ζ ∂circleMeasure) := by
  have : MeasureTheory.IsFiniteMeasure μ.variation := complexMeasure_variation_finite μ
  -- Step 1: Define the Poisson integral `f(z) = ∫ P_z(ζ) dμ(ζ)` and prove its `ℕ`-power series
  let f : ℂ → ℂ := fun z ↦
    RudinRCA.Chapter10.complexMeasureIntegral μ
      (fun ζ ↦ ((_root_.poissonKernel 0 z (circlePoint ζ) : ℝ) : ℂ))
  let c : ℕ → ℂ := fun m ↦
    RudinRCA.Chapter10.complexMeasureIntegral μ
      (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ))
  have hc_bdd : ∀ m : ℕ, ‖c m‖ ≤ μ.variation.real Set.univ := by
    intro m
    have hle := RudinRCA.Chapter10.norm_complexMeasureIntegral_le_of_norm_le_const μ zero_le_one
      (g := fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ))
      (fun ζ ↦ by rw [norm_star, norm_trigMonomial_apply])
    simpa only [one_mul] using hle
  have hf_hasSum : ∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun m : ℕ ↦ c m * z ^ m) (f z) := by
    intro z hz
    have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
    let F : ℕ → FourierCircle → ℂ := fun m ζ ↦
      star (RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ) * z ^ m +
        star (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ)) ζ) * star z ^ (m + 1)
    let bound : ℕ → FourierCircle → ℝ := fun m _ ↦ ‖z‖ ^ m + ‖z‖ ^ (m + 1)
    have hF_cont : ∀ m : ℕ, Continuous (F m) := by
      intro m
      dsimp only [F]
      exact ((continuous_star.comp (RudinRCA.Chapter04.trigMonomial (m : ℤ)).continuous).mul
          continuous_const).add
        ((continuous_star.comp
          (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ))).continuous).mul
          continuous_const)
    have hF_meas : ∀ m : ℕ, AEStronglyMeasurable (F m) μ.variation :=
      fun m ↦ (hF_cont m).aestronglyMeasurable
    have hF_bound : ∀ m : ℕ, ∀ᵐ ζ ∂μ.variation, ‖F m ζ‖ ≤ bound m ζ := by
      intro m
      refine Eventually.of_forall fun ζ ↦ ?_
      dsimp only [F, bound]
      calc ‖star (RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ) * z ^ m +
              star (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ)) ζ) * star z ^ (m + 1)‖
          ≤ ‖star (RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ) * z ^ m‖ +
              ‖star (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ)) ζ) * star z ^ (m + 1)‖ :=
            norm_add_le _ _
        _ = ‖z‖ ^ m + ‖z‖ ^ (m + 1) := by
            rw [norm_mul, norm_mul, norm_star, norm_star, norm_trigMonomial_apply,
              norm_trigMonomial_apply, one_mul, one_mul, norm_pow, norm_pow, norm_star]
    have hsum_z : Summable (fun m : ℕ ↦ ‖z‖ ^ m + ‖z‖ ^ (m + 1)) := by
      have hg := summable_geometric_of_lt_one (norm_nonneg z) hz_lt
      have hg1 : Summable (fun m : ℕ ↦ ‖z‖ ^ (m + 1)) := by
        simpa only [pow_succ] using hg.mul_right ‖z‖
      exact hg.add hg1
    have hbound_sum : ∀ᵐ ζ ∂μ.variation, Summable (fun m : ℕ ↦ bound m ζ) :=
      Eventually.of_forall fun _ ↦ hsum_z
    have hbound_int : Integrable (fun ζ : FourierCircle ↦ ∑' m : ℕ, bound m ζ) μ.variation := by
      dsimp only [bound]
      exact integrable_const _
    have hF_lim : ∀ᵐ ζ ∂μ.variation,
        HasSum (fun m : ℕ ↦ F m ζ) ((_root_.poissonKernel 0 z (circlePoint ζ) : ℝ) : ℂ) := by
      refine Eventually.of_forall fun ζ ↦ ?_
      let w : ℂ := circlePoint ζ
      let q : ℂ := z * star w
      let p : ℂ := star z * w
      have hq_lt : ‖q‖ < 1 := by
        dsimp only [q, w]
        rw [norm_mul, norm_star, norm_circlePoint, mul_one]; exact hz_lt
      have hp_lt : ‖p‖ < 1 := by
        dsimp only [p, w]
        rw [norm_mul, norm_star, norm_circlePoint, mul_one]; exact hz_lt
      have hgeom_q := hasSum_geometric_of_norm_lt_one hq_lt
      have hgeom_p := (hasSum_geometric_of_norm_lt_one hp_lt).mul_left p
      have hadd := hgeom_q.add hgeom_p
      rw [← poissonKernel_eq_inv_sum hz ζ] at hadd
      refine hadd.congr_fun fun m ↦ ?_
      dsimp only [F, q, p, w]
      have hterm1 : (z * star (circlePoint ζ)) ^ m =
          star (RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ) * z ^ m := by
        rw [mul_pow, ← star_pow, circlePoint_pow_eq_trigMonomial, mul_comm]
      have hterm2 : star z * circlePoint ζ * (star z * circlePoint ζ) ^ m =
          star (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ)) ζ) * star z ^ (m + 1) := by
        rw [← pow_succ', mul_pow, circlePoint_pow_eq_trigMonomial,
          star_trigMonomial (-((m + 1 : ℕ) : ℤ)) ζ, neg_neg, mul_comm]
      rw [hterm1, hterm2]
    have hdom := MeasureTheory.VectorMeasure.hasSum_integral_of_dominated_convergence
      (μ := μ) (B := ContinuousLinearMap.mul ℝ ℂ) bound hF_meas hF_bound hbound_sum hbound_int hF_lim
    have hint_F : (fun m : ℕ ↦ ∫ᵛ ζ, F m ζ ∂[ContinuousLinearMap.mul ℝ ℂ; μ]) =
        fun m : ℕ ↦ c m * z ^ m := by
      funext m
      have hi1 : μ.Integrable
          (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ) * z ^ m) :=
        (((continuous_star.comp (RudinRCA.Chapter04.trigMonomial (m : ℤ)).continuous).mul
          continuous_const)).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
      have hi2 : μ.Integrable
          (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ)) ζ) *
            star z ^ (m + 1)) :=
        (((continuous_star.comp
          (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ))).continuous).mul
          continuous_const)).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
      dsimp only [F]
      rw [MeasureTheory.VectorMeasure.integral_fun_add hi1 hi2]
      have hm1 := RudinRCA.Chapter10.complexMeasureIntegral_mul_const μ
        (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ)) (z ^ m)
      have hm2 := RudinRCA.Chapter10.complexMeasureIntegral_mul_const μ
        (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ)) ζ))
        (star z ^ (m + 1))
      unfold RudinRCA.Chapter10.complexMeasureIntegral at hm1 hm2
      rw [hm1, hm2]
      have hneg_zero : (∫ᵛ ζ, star (RudinRCA.Chapter04.trigMonomial (-((m + 1 : ℕ) : ℤ)) ζ)
          ∂[ContinuousLinearMap.mul ℝ ℂ; μ]) = 0 :=
        hμ_neg (-((m + 1 : ℕ) : ℤ)) (by omega)
      rw [hneg_zero, zero_mul, add_zero]
      rfl
    rwa [hint_F] at hdom
  -- Step 2: `HolomorphicOn f (Metric.ball 0 1)` and `IsInHardySpace 1 f`
  have hf_hol : HolomorphicOn f (Metric.ball (0 : ℂ) 1) := by
    intro z₀ hz₀
    have hz₀_lt : ‖z₀‖ < 1 := by simpa [Metric.mem_ball] using hz₀
    let R : ℝ := (‖z₀‖ + 1) / 2
    have hR0 : 0 < R := by dsimp [R]; linarith [norm_nonneg z₀]
    have hR1 : R < 1 := by dsimp [R]; linarith
    have hz₀_R : z₀ ∈ Metric.ball (0 : ℂ) R := by
      rw [Metric.mem_ball, dist_zero_right]; dsimp [R]; linarith
    let M_c : ℝ := μ.variation.real Set.univ
    have hMc_nn : 0 ≤ M_c := MeasureTheory.measureReal_nonneg
    have hmaj : Summable (fun m : ℕ ↦ M_c * R ^ m) :=
      (summable_geometric_of_lt_one hR0.le hR1).mul_left M_c
    have hunif : TendstoUniformlyOn
        (fun N z ↦ ∑ m ∈ Finset.range N, c m * z ^ m)
        (fun z ↦ ∑' m : ℕ, c m * z ^ m) atTop (Metric.ball (0 : ℂ) R) := by
      refine tendstoUniformlyOn_tsum_nat hmaj fun m z hz ↦ ?_
      have hzR : ‖z‖ ≤ R := le_of_lt (by simpa [Metric.mem_ball] using hz)
      rw [norm_mul, norm_pow]
      exact mul_le_mul (hc_bdd m) (pow_le_pow_left₀ (norm_nonneg z) hzR m)
        (pow_nonneg (norm_nonneg z) m) hMc_nn
    have hdiff_tsum : DifferentiableOn ℂ (fun z ↦ ∑' m : ℕ, c m * z ^ m) (Metric.ball (0 : ℂ) R) :=
      hunif.tendstoLocallyUniformlyOn.differentiableOn
        (Eventually.of_forall fun N z _ ↦
          (DifferentiableAt.fun_sum fun m _ ↦
            (differentiableAt_id.pow m).const_mul (c m)).differentiableWithinAt)
        Metric.isOpen_ball
    have hdiff_R : DifferentiableOn ℂ f (Metric.ball (0 : ℂ) R) :=
      hdiff_tsum.congr fun z hz ↦
        (hf_hasSum z (Metric.ball_subset_ball hR1.le hz)).tsum_eq.symm
    exact hdiff_R.differentiableAt (Metric.isOpen_ball.mem_nhds hz₀_R)
  have hf_h1 : IsInHardySpace 1 f := by
    refine ⟨one_ne_zero, hf_hol, ?_⟩
    have hrad_le : ∀ r ∈ Set.Ico (0 : ℝ) 1,
        radialSizeENNReal 1 f r ≤ μ.variation Set.univ := by
      intro r hr
      have hslice_cont : Continuous (radialSlice f r) :=
        continuous_radialSlice_of_holomorphicOn hf_hol hr.1 hr.2
      simp only [radialSizeENNReal, one_ne_zero, ↓reduceIte]
      rw [eLpNorm_one_eq_lintegral_enorm hslice_cont.aestronglyMeasurable]
      have hz_ball : ∀ ζ : FourierCircle,
          (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
        intro ζ
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg hr.1] using hr.2
      have hpt_le : ∀ ζ : FourierCircle,
          ‖radialSlice f r ζ‖ₑ ≤
            ∫⁻ η, ENNReal.ofReal
              (_root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η))
              ∂μ.variation := by
        intro ζ
        have h1 := enorm_complexMeasureIntegral_le_lintegral_enorm μ
          (fun η ↦ ((_root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) : ℝ) : ℂ))
        refine h1.trans (lintegral_mono fun η ↦ ?_)
        dsimp only
        rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg (poissonKernel_circlePoint_nonneg (hz_ball ζ) η)]
      have hprod_meas : AEMeasurable
          (Function.uncurry fun ζ η : FourierCircle ↦
            ENNReal.ofReal (_root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η)))
          (circleMeasure.prod μ.variation) :=
        (continuous_poissonKernel_pair hr.1 hr.2).measurable.ennreal_ofReal.aemeasurable
      calc ∫⁻ ζ, ‖radialSlice f r ζ‖ₑ ∂circleMeasure
          ≤ ∫⁻ ζ, (∫⁻ η, ENNReal.ofReal
              (_root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η)) ∂μ.variation)
              ∂circleMeasure := lintegral_mono hpt_le
        _ = ∫⁻ η, (∫⁻ ζ, ENNReal.ofReal
              (_root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η)) ∂circleMeasure)
              ∂μ.variation := lintegral_lintegral_swap hprod_meas
        _ = ∫⁻ _ : FourierCircle, (1 : ℝ≥0∞) ∂μ.variation := by
            refine lintegral_congr fun η ↦ ?_
            have hsym : (fun ζ : FourierCircle ↦
                ENNReal.ofReal (_root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η))) =
                fun ζ : FourierCircle ↦
                ENNReal.ofReal (_root_.poissonKernel 0 ((r : ℂ) * circlePoint η) (circlePoint ζ)) := by
              funext ζ
              rw [poissonKernel_radial_symm r ζ η]
            rw [hsym]
            have hint_η : Integrable (fun ζ : FourierCircle ↦
                _root_.poissonKernel 0 ((r : ℂ) * circlePoint η) (circlePoint ζ)) circleMeasure :=
              (continuous_poissonKernel_circlePoint
                (hz_ball η)).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
            rw [← ofReal_integral_eq_lintegral_ofReal hint_η
              (Eventually.of_forall fun ζ ↦ poissonKernel_circlePoint_nonneg (hz_ball η) ζ),
              integral_poissonKernel_circleMeasure (hz_ball η), ENNReal.ofReal_one]
        _ = μ.variation Set.univ := lintegral_one
    exact lt_of_le_of_lt (iSup₂_le hrad_le) (measure_lt_top μ.variation Set.univ)
  -- Step 3: Match all Fourier coefficients (`ℤ`) of `μ` and `radialBoundaryLimit f dσ`
  have h11 := theorem17_11 one_ne_zero ENNReal.one_ne_top hf_h1
  have hbd_int : Integrable (radialBoundaryLimit f) circleMeasure :=
    h11.2.2.1.integrable le_rfl
  have hL1_tendsto : Tendsto
      (fun R : ℝ ↦ ∫ ζ, ‖radialSlice f R ζ - radialBoundaryLimit f ζ‖ ∂circleMeasure)
      (𝓝[<] 1) (𝓝 0) := by
    have htoReal := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp h11.2.2.2.1
    simp only [ENNReal.toReal_zero, Function.comp_def] at htoReal
    refine htoReal.congr' ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with R hR
    have hsub_int : Integrable (radialSlice f R - radialBoundaryLimit f) circleMeasure :=
      ((continuous_radialSlice_of_holomorphicOn hf_hol hR.1.le hR.2).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)).sub hbd_int
    have hsub_memLp1 : MemLp (radialSlice f R - radialBoundaryLimit f) 1 circleMeasure :=
      memLp_one_iff_integrable.mpr hsub_int
    rw [hsub_memLp1.eLpNorm_eq_integral_rpow_norm one_ne_zero ENNReal.one_ne_top]
    simp [ENNReal.toReal_ofReal (integral_nonneg fun _ ↦ norm_nonneg _)]
  have hfour_eq : ∀ n : ℤ,
      RudinRCA.Chapter10.complexMeasureIntegral μ
        (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)) =
      ∫ ζ, radialBoundaryLimit f ζ * star (RudinRCA.Chapter04.trigMonomial n ζ)
        ∂circleMeasure := by
    intro n
    have hslice_four : ∀ R ∈ Set.Ioo (0 : ℝ) 1,
        ∫ ζ, radialSlice f R ζ * star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure =
          if 0 ≤ n then c n.toNat * (R : ℂ) ^ n.toNat else 0 := by
      intro R hR
      let c_R : ℕ → ℂ := fun m ↦ c m * (R : ℂ) ^ m
      have hcR_l2 : Summable (fun m : ℕ ↦ ‖c_R m‖ ^ 2) := by
        let M_c : ℝ := μ.variation.real Set.univ
        have hMc_nn : 0 ≤ M_c := MeasureTheory.measureReal_nonneg
        have hgeom : Summable (fun m : ℕ ↦ M_c ^ 2 * (R ^ 2) ^ m) :=
          (summable_geometric_of_lt_one (sq_nonneg R)
            (by nlinarith [hR.1, hR.2])).mul_left (M_c ^ 2)
        refine hgeom.of_nonneg_of_le (fun _ ↦ sq_nonneg _) fun m ↦ ?_
        dsimp only [c_R]
        rw [norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR.1,
          mul_pow, ← pow_mul, mul_comm m 2, pow_mul]
        exact mul_le_mul (pow_le_pow_left₀ (norm_nonneg _) (hc_bdd m) 2) le_rfl
          (by positivity) (sq_nonneg M_c)
      have hl2 := theorem17_12_of_l2 hcR_l2
      let g_R : ℂ → ℂ := fun w ↦ ∑' m : ℕ, c_R m * w ^ m
      have hgR_eq : ∀ w ∈ Metric.ball (0 : ℂ) 1, g_R w = f ((R : ℂ) * w) := by
        intro w hw
        have hw_lt : ‖w‖ < 1 := by simpa [Metric.mem_ball] using hw
        have hRw_ball : (R : ℂ) * w ∈ Metric.ball (0 : ℂ) 1 := by
          rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real,
            Real.norm_eq_abs, abs_of_pos hR.1]
          nlinarith [norm_nonneg w, hR.1, hR.2]
        have hs1 : HasSum (fun m : ℕ ↦ c_R m * w ^ m) (g_R w) := hl2.1 w hw
        have hs2 : HasSum (fun m : ℕ ↦ c_R m * w ^ m) (f ((R : ℂ) * w)) := by
          refine (hf_hasSum ((R : ℂ) * w) hRw_ball).congr_fun fun m ↦ ?_
          dsimp only [c_R]
          rw [mul_pow]
          ring
        exact hs1.unique hs2
      have hbd_gR : ∀ ζ : FourierCircle, radialBoundaryLimit g_R ζ = radialSlice f R ζ := by
        intro ζ
        have htend : Tendsto (fun r : ℝ ↦ radialSlice g_R r ζ) (𝓝[<] 1)
            (𝓝 (radialSlice f R ζ)) := by
          have hmem_ball : (R : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
            simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_pos hR.1] using hR.2
          have hca_f : ContinuousAt f ((R : ℂ) * circlePoint ζ) :=
            (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf_hol).continuousAt
              (Metric.isOpen_ball.mem_nhds hmem_ball)
          have hcont_arg : Continuous (fun r : ℝ ↦ (R : ℂ) * ((r : ℂ) * circlePoint ζ)) := by
            fun_prop
          have harg1 : (R : ℂ) * (((1 : ℝ) : ℂ) * circlePoint ζ) = (R : ℂ) * circlePoint ζ := by
            simp
          have hca_r : ContinuousAt
              (fun r : ℝ ↦ f ((R : ℂ) * ((r : ℂ) * circlePoint ζ))) 1 :=
            ContinuousAt.comp (g := f)
              (f := fun r : ℝ ↦ (R : ℂ) * ((r : ℂ) * circlePoint ζ))
              (by simpa only [harg1] using hca_f) hcont_arg.continuousAt
          have ht1 : Tendsto (fun r : ℝ ↦ f ((R : ℂ) * ((r : ℂ) * circlePoint ζ)))
              (𝓝[<] 1) (𝓝 (radialSlice f R ζ)) := by
            have hval1 : f ((R : ℂ) * (((1 : ℝ) : ℂ) * circlePoint ζ)) = radialSlice f R ζ := by
              simp [radialSlice]
            exact hval1 ▸ hca_r.tendsto.mono_left nhdsWithin_le_nhds
          refine ht1.congr' ?_
          filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
          have hr_ball : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
            simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_pos hr.1] using hr.2
          exact (hgR_eq _ hr_ball).symm
        exact htend.limUnder_eq
      have h12_gR := ((theorem17_12 hl2.2.1).2.2 hl2.2.2.2.1).2 n
      dsimp only [g_R] at hbd_gR
      simp only [hl2.2.2.1, hbd_gR] at h12_gR
      exact h12_gR
    -- Pass `R → 1⁻` on both sides
    have hK_cont : Continuous (fun ζ : FourierCircle ↦
        star (RudinRCA.Chapter04.trigMonomial n ζ)) :=
      continuous_star.comp (RudinRCA.Chapter04.trigMonomial n).continuous
    have hK_unif : TendstoUniformly
        (fun (_ : ℝ) (ζ : FourierCircle) ↦ star (RudinRCA.Chapter04.trigMonomial n ζ))
        (fun ζ : FourierCircle ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)) (𝓝[<] 1) :=
      Metric.tendstoUniformly_iff.mpr fun ε hε ↦
        Eventually.of_forall fun _ _ ↦ by simpa using hε
    have hF_int_ev : ∀ᶠ R in 𝓝[<] (1 : ℝ), Integrable (radialSlice f R) circleMeasure := by
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with R hR
      exact (continuous_radialSlice_of_holomorphicOn hf_hol
        hR.1.le hR.2).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    have hlhs_tend := tendsto_integral_kernel_mul_of_L1_tendsto
      (Eventually.of_forall fun _ ↦ hK_cont) hK_cont hK_unif hF_int_ev hbd_int hL1_tendsto
    simp_rw [mul_comm (star (RudinRCA.Chapter04.trigMonomial n _))] at hlhs_tend
    have hrhs_tend : Tendsto
        (fun R : ℝ ↦ ∫ ζ, radialSlice f R ζ * star (RudinRCA.Chapter04.trigMonomial n ζ)
          ∂circleMeasure)
        (𝓝[<] 1)
        (𝓝 (RudinRCA.Chapter10.complexMeasureIntegral μ
          (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)))) := by
      have hlim_ite : Tendsto
          (fun R : ℝ ↦ if 0 ≤ n then c n.toNat * (R : ℂ) ^ n.toNat else 0) (𝓝[<] 1)
          (𝓝 (RudinRCA.Chapter10.complexMeasureIntegral μ
            (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)))) := by
        by_cases hn : 0 ≤ n
        · simp only [hn, ↓reduceIte]
          have hpow : Tendsto (fun R : ℝ ↦ c n.toNat * (R : ℂ) ^ n.toNat) (𝓝[<] 1)
              (𝓝 (c n.toNat * ((1 : ℝ) : ℂ) ^ n.toNat)) :=
            ((continuous_const.mul (Complex.continuous_ofReal.pow n.toNat)).tendsto 1).mono_left
              nhdsWithin_le_nhds
          simp only [Complex.ofReal_one, one_pow, mul_one] at hpow
          have hcn : c n.toNat = RudinRCA.Chapter10.complexMeasureIntegral μ
              (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)) := by
            dsimp only [c]
            rw [Int.toNat_of_nonneg hn]
          rwa [← hcn]
        · simp only [hn, ↓reduceIte]
          rw [hμ_neg n (not_le.mp hn)]
          exact tendsto_const_nhds
      refine hlim_ite.congr' ?_
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with R hR
      exact (hslice_four R hR).symm
    exact tendsto_nhds_unique hrhs_tend hlhs_tend
  -- Step 4: Match `complexMeasureIntegral μ g = ∫ g * f* dσ` for all `g : C(FourierCircle, ℂ)`
  have hmonom_eq : ∀ k : ℤ,
      RudinRCA.Chapter10.complexMeasureIntegral μ (RudinRCA.Chapter04.trigMonomial k) =
        ∫ ζ, RudinRCA.Chapter04.trigMonomial k ζ * radialBoundaryLimit f ζ ∂circleMeasure := by
    intro k
    have hst : (fun ζ : FourierCircle ↦ star (RudinRCA.Chapter04.trigMonomial (-k) ζ)) =
        RudinRCA.Chapter04.trigMonomial k := by
      funext ζ
      rw [star_trigMonomial, neg_neg]
    have h := hfour_eq (-k)
    rw [hst] at h
    rw [h]
    refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
    dsimp only
    rw [star_trigMonomial, neg_neg, mul_comm]
  have hpoly_eq : ∀ p_coeff : ℤ →₀ ℂ,
      RudinRCA.Chapter10.complexMeasureIntegral μ
          (RudinRCA.Chapter04.trigPolynomial p_coeff) =
        ∫ ζ, RudinRCA.Chapter04.trigPolynomial p_coeff ζ * radialBoundaryLimit f ζ
          ∂circleMeasure := by
    intro p_coeff
    have hval : ∀ ζ : FourierCircle,
        RudinRCA.Chapter04.trigPolynomial p_coeff ζ =
          ∑ k ∈ p_coeff.support, p_coeff k * RudinRCA.Chapter04.trigMonomial k ζ := by
      intro ζ
      simp [RudinRCA.Chapter04.trigPolynomial, Finsupp.sum]
    have hpoly_fn : (RudinRCA.Chapter04.trigPolynomial p_coeff : FourierCircle → ℂ) =
        fun ζ ↦ ∑ k ∈ p_coeff.support, p_coeff k * RudinRCA.Chapter04.trigMonomial k ζ :=
      funext hval
    have hlhs : RudinRCA.Chapter10.complexMeasureIntegral μ
          (RudinRCA.Chapter04.trigPolynomial p_coeff) =
        ∑ k ∈ p_coeff.support, p_coeff k *
          RudinRCA.Chapter10.complexMeasureIntegral μ (RudinRCA.Chapter04.trigMonomial k) := by
      rw [hpoly_fn]
      unfold RudinRCA.Chapter10.complexMeasureIntegral
      dsimp only
      rw [MeasureTheory.VectorMeasure.integral_finsetSum p_coeff.support
        (f := fun k x ↦ p_coeff k * RudinRCA.Chapter04.trigMonomial k x) fun k _ ↦
          ((RudinRCA.Chapter04.trigMonomial k).continuous.const_mul
            (p_coeff k)).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)]
      refine Finset.sum_congr rfl fun k _ ↦ ?_
      exact RudinRCA.Chapter10.complexMeasureIntegral_const_mul μ (p_coeff k)
        (RudinRCA.Chapter04.trigMonomial k)
    have hrhs : ∫ ζ, RudinRCA.Chapter04.trigPolynomial p_coeff ζ * radialBoundaryLimit f ζ
          ∂circleMeasure =
        ∑ k ∈ p_coeff.support, p_coeff k *
          ∫ ζ, RudinRCA.Chapter04.trigMonomial k ζ * radialBoundaryLimit f ζ ∂circleMeasure := by
      have hcongr : (fun ζ : FourierCircle ↦
          RudinRCA.Chapter04.trigPolynomial p_coeff ζ * radialBoundaryLimit f ζ) =
          fun ζ : FourierCircle ↦ ∑ k ∈ p_coeff.support,
            p_coeff k * (RudinRCA.Chapter04.trigMonomial k ζ * radialBoundaryLimit f ζ) := by
        funext ζ
        rw [hval ζ, Finset.sum_mul]
        refine Finset.sum_congr rfl fun k _ ↦ mul_assoc _ _ _
      rw [hcongr, integral_finsetSum p_coeff.support]
      · refine Finset.sum_congr rfl fun k _ ↦ integral_const_mul (p_coeff k) _
      · intro k _
        have hbd_k : Integrable
            (fun ζ ↦ RudinRCA.Chapter04.trigMonomial k ζ * radialBoundaryLimit f ζ)
            circleMeasure :=
          hbd_int.bdd_mul (RudinRCA.Chapter04.trigMonomial k).continuous.aestronglyMeasurable
            (Eventually.of_forall fun ζ ↦ (norm_trigMonomial_apply k ζ).le)
        exact hbd_k.const_mul (p_coeff k)
    rw [hlhs, hrhs]
    refine Finset.sum_congr rfl fun k _ ↦ by rw [hmonom_eq k]
  have hcont_eq : ∀ g : C(FourierCircle, ℂ),
      RudinRCA.Chapter10.complexMeasureIntegral μ g =
        ∫ ζ, g ζ * radialBoundaryLimit f ζ ∂circleMeasure := by
    intro g
    suffices hzero : ‖RudinRCA.Chapter10.complexMeasureIntegral μ g -
        ∫ ζ, g ζ * radialBoundaryLimit f ζ ∂circleMeasure‖ = 0 from
      sub_eq_zero.mp (norm_eq_zero.mp hzero)
    refine le_antisymm ?_ (norm_nonneg _)
    refine le_of_forall_pos_le_add fun ε hε ↦ ?_
    rw [ zero_add ]
    let C_tot : ℝ := μ.variation.real Set.univ +
      (∫ ζ, ‖radialBoundaryLimit f ζ‖ ∂circleMeasure) + 1
    have hint_nn : 0 ≤ ∫ ζ, ‖radialBoundaryLimit f ζ‖ ∂circleMeasure :=
      integral_nonneg fun _ ↦ norm_nonneg _
    have hC_pos : 0 < C_tot := by
      dsimp only [C_tot]
      linarith [MeasureTheory.measureReal_nonneg (μ := μ.variation) (s := Set.univ)]
    let δ : ℝ := ε / C_tot
    have hδ_pos : 0 < δ := div_pos hε hC_pos
    obtain ⟨p_coeff, hp_approx⟩ := RudinRCA.Chapter04.uniform_trigonometric_approximation g δ hδ_pos
    let P : C(FourierCircle, ℂ) := RudinRCA.Chapter04.trigPolynomial p_coeff
    have hpt_δ : ∀ ζ : FourierCircle, ‖g ζ - P ζ‖ ≤ δ := fun ζ ↦
      (ContinuousMap.norm_coe_le_norm (g - P) ζ).trans hp_approx.le
    have hg_vint : μ.Integrable g :=
      g.continuous.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    have hP_vint : μ.Integrable P :=
      P.continuous.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    have hsub_mu : RudinRCA.Chapter10.complexMeasureIntegral μ g -
          RudinRCA.Chapter10.complexMeasureIntegral μ P =
        RudinRCA.Chapter10.complexMeasureIntegral μ (fun ζ ↦ g ζ - P ζ) :=
      (MeasureTheory.VectorMeasure.integral_fun_sub hg_vint hP_vint).symm
    have hmu_diff : ‖RudinRCA.Chapter10.complexMeasureIntegral μ g -
          RudinRCA.Chapter10.complexMeasureIntegral μ P‖ ≤
        δ * μ.variation.real Set.univ := by
      rw [hsub_mu]
      exact RudinRCA.Chapter10.norm_complexMeasureIntegral_le_of_norm_le_const μ hδ_pos.le hpt_δ
    have hg_cint : Integrable (fun ζ ↦ g ζ * radialBoundaryLimit f ζ) circleMeasure := by
      obtain ⟨ζ_m, _, hm⟩ := isCompact_univ.exists_isMaxOn univ_nonempty g.continuous.norm.continuousOn
      exact hbd_int.bdd_mul g.continuous.aestronglyMeasurable
        (Eventually.of_forall fun ζ ↦ hm (mem_univ ζ))
    have hP_cint : Integrable (fun ζ ↦ P ζ * radialBoundaryLimit f ζ) circleMeasure := by
      obtain ⟨ζ_m, _, hm⟩ := isCompact_univ.exists_isMaxOn univ_nonempty P.continuous.norm.continuousOn
      exact hbd_int.bdd_mul P.continuous.aestronglyMeasurable
        (Eventually.of_forall fun ζ ↦ hm (mem_univ ζ))
    have hcirc_diff : ‖(∫ ζ, g ζ * radialBoundaryLimit f ζ ∂circleMeasure) -
          (∫ ζ, P ζ * radialBoundaryLimit f ζ ∂circleMeasure)‖ ≤
        δ * ∫ ζ, ‖radialBoundaryLimit f ζ‖ ∂circleMeasure := by
      rw [← integral_sub hg_cint hP_cint]
      calc ‖∫ ζ, (g ζ * radialBoundaryLimit f ζ - P ζ * radialBoundaryLimit f ζ) ∂circleMeasure‖
          ≤ ∫ ζ, ‖g ζ * radialBoundaryLimit f ζ - P ζ * radialBoundaryLimit f ζ‖ ∂circleMeasure :=
            norm_integral_le_integral_norm _
        _ ≤ ∫ ζ, δ * ‖radialBoundaryLimit f ζ‖ ∂circleMeasure := by
            refine integral_mono (hg_cint.sub hP_cint).norm (hbd_int.norm.const_mul δ) fun ζ ↦ ?_
            dsimp only
            rw [← sub_mul, norm_mul]
            exact mul_le_mul_of_nonneg_right (hpt_δ ζ) (norm_nonneg _)
        _ = δ * ∫ ζ, ‖radialBoundaryLimit f ζ‖ ∂circleMeasure := integral_const_mul δ _
    have hP_eq : RudinRCA.Chapter10.complexMeasureIntegral μ P =
        ∫ ζ, P ζ * radialBoundaryLimit f ζ ∂circleMeasure := hpoly_eq p_coeff
    calc ‖RudinRCA.Chapter10.complexMeasureIntegral μ g -
            ∫ ζ, g ζ * radialBoundaryLimit f ζ ∂circleMeasure‖
        = ‖(RudinRCA.Chapter10.complexMeasureIntegral μ g -
              RudinRCA.Chapter10.complexMeasureIntegral μ P) +
            ((∫ ζ, P ζ * radialBoundaryLimit f ζ ∂circleMeasure) -
              (∫ ζ, g ζ * radialBoundaryLimit f ζ ∂circleMeasure))‖ := by
          rw [hP_eq]; ring_nf
      _ ≤ ‖RudinRCA.Chapter10.complexMeasureIntegral μ g -
              RudinRCA.Chapter10.complexMeasureIntegral μ P‖ +
            ‖(∫ ζ, g ζ * radialBoundaryLimit f ζ ∂circleMeasure) -
              (∫ ζ, P ζ * radialBoundaryLimit f ζ ∂circleMeasure)‖ := by
          refine (norm_add_le _ _).trans ?_
          rw [norm_sub_rev (∫ ζ, P ζ * radialBoundaryLimit f ζ ∂circleMeasure)]
      _ ≤ δ * μ.variation.real Set.univ + δ * ∫ ζ, ‖radialBoundaryLimit f ζ‖ ∂circleMeasure :=
          add_le_add hmu_diff hcirc_diff
      _ ≤ δ * C_tot := by
          dsimp only [C_tot]
          nlinarith [hδ_pos]
      _ = ε := div_mul_cancel₀ ε hC_pos.ne'
  -- Step 5: Closed sets → all Borel sets via Dynkin π-λ induction → absolute continuity
  have hclosed : ∀ K : Set FourierCircle, IsClosed K →
      μ K = ∫ ζ in K, radialBoundaryLimit f ζ ∂circleMeasure := by
    intro K hK
    rcases K.eq_empty_or_nonempty with rfl | hKne
    · simp
    · let g_seq : ℕ → C(FourierCircle, ℂ) := fun k ↦
        ⟨fun ζ ↦ ((max 0 (1 - ((k : ℝ) + 1) * Metric.infDist ζ K) : ℝ) : ℂ),
          Complex.continuous_ofReal.comp (continuous_const.max
            (continuous_const.sub (continuous_const.mul (Metric.continuous_infDist_pt K))))⟩
      have hg_bdd : ∀ (k : ℕ) (ζ : FourierCircle), ‖g_seq k ζ‖ ≤ 1 := by
        intro k ζ
        dsimp only [g_seq]
        change ‖((max 0 (1 - ((k : ℝ) + 1) * Metric.infDist ζ K) : ℝ) : ℂ)‖ ≤ 1
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (le_max_left _ _)]
        refine max_le zero_le_one ?_
        have hnn : 0 ≤ ((k : ℝ) + 1) * Metric.infDist ζ K :=
          mul_nonneg (by positivity) Metric.infDist_nonneg
        linarith
      have hg_lim : ∀ ζ : FourierCircle,
          Tendsto (fun k : ℕ ↦ g_seq k ζ) atTop (𝓝 (K.indicator (fun _ ↦ (1 : ℂ)) ζ)) := by
        intro ζ
        by_cases hζ : ζ ∈ K
        · rw [Set.indicator_of_mem hζ]
          refine tendsto_const_nhds.congr fun k ↦ ?_
          change ((1 : ℝ) : ℂ) = ((max 0 (1 - ((k : ℝ) + 1) * Metric.infDist ζ K) : ℝ) : ℂ)
          rw [Metric.infDist_zero_of_mem hζ, mul_zero, sub_zero, max_eq_right zero_le_one]
        · rw [Set.indicator_of_notMem hζ]
          have hd_pos : 0 < Metric.infDist ζ K := (hK.notMem_iff_infDist_pos hKne).mp hζ
          obtain ⟨N, hN⟩ := exists_nat_ge (1 / Metric.infDist ζ K)
          refine tendsto_const_nhds.congr' ?_
          filter_upwards [eventually_ge_atTop N] with k hk
          change (0 : ℂ) = ((max 0 (1 - ((k : ℝ) + 1) * Metric.infDist ζ K) : ℝ) : ℂ)
          have h1 : 1 ≤ ((k : ℝ) + 1) * Metric.infDist ζ K := by
            have hk' : (N : ℝ) ≤ (k : ℝ) + 1 := by
              have : (N : ℝ) ≤ (k : ℝ) := Nat.cast_le.mpr hk
              linarith
            have hmul := mul_le_mul_of_nonneg_right (hN.trans hk') hd_pos.le
            rwa [one_div_mul_cancel hd_pos.ne'] at hmul
          rw [max_eq_left (by linarith), Complex.ofReal_zero]
      have hlhs_lim : Tendsto
          (fun k : ℕ ↦ RudinRCA.Chapter10.complexMeasureIntegral μ (g_seq k))
          atTop (𝓝 (μ K)) := by
        have hdom := MeasureTheory.VectorMeasure.tendsto_integral_of_dominated_convergence
          (μ := μ) (B := ContinuousLinearMap.mul ℝ ℂ)
          (fun _ ↦ (1 : ℝ))
          (fun k ↦ (g_seq k).continuous.aestronglyMeasurable)
          (integrable_const _)
          (fun k ↦ Eventually.of_forall (hg_bdd k))
          (Eventually.of_forall hg_lim)
        rwa [← complexMeasureIntegral_indicator_one μ hK.measurableSet]
      have hrhs_lim : Tendsto
          (fun k : ℕ ↦ ∫ ζ, g_seq k ζ * radialBoundaryLimit f ζ ∂circleMeasure)
          atTop (𝓝 (∫ ζ in K, radialBoundaryLimit f ζ ∂circleMeasure)) := by
        have hdom := MeasureTheory.tendsto_integral_of_dominated_convergence
          (F := fun k ζ ↦ g_seq k ζ * radialBoundaryLimit f ζ)
          (f := fun ζ ↦ K.indicator (fun _ ↦ (1 : ℂ)) ζ * radialBoundaryLimit f ζ)
          (fun ζ ↦ ‖radialBoundaryLimit f ζ‖)
          (fun k ↦ (g_seq k).continuous.aestronglyMeasurable.mul hbd_int.aestronglyMeasurable)
          hbd_int.norm
          (fun k ↦ Eventually.of_forall fun ζ ↦ by
            rw [norm_mul]; exact mul_le_of_le_one_left (norm_nonneg _) (hg_bdd k ζ))
          (Eventually.of_forall fun ζ ↦ (hg_lim ζ).mul tendsto_const_nhds)
        have hind_eq : (∫ ζ, K.indicator (fun _ ↦ (1 : ℂ)) ζ * radialBoundaryLimit f ζ
              ∂circleMeasure) =
            ∫ ζ in K, radialBoundaryLimit f ζ ∂circleMeasure := by
          rw [← integral_indicator hK.measurableSet]
          refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
          by_cases hζ : ζ ∈ K <;> simp [hζ]
        rwa [hind_eq] at hdom
      have hrhs_lim' : Tendsto
          (fun k : ℕ ↦ RudinRCA.Chapter10.complexMeasureIntegral μ (g_seq k))
          atTop (𝓝 (∫ ζ in K, radialBoundaryLimit f ζ ∂circleMeasure)) :=
        hrhs_lim.congr fun k ↦ (hcont_eq (g_seq k)).symm
      exact tendsto_nhds_unique hlhs_lim hrhs_lim'
  have hborel : ∀ E : Set FourierCircle, MeasurableSet E →
      μ E = ∫ ζ in E, radialBoundaryLimit f ζ ∂circleMeasure := by
    have hgen : (inferInstance : MeasurableSpace FourierCircle) =
        MeasurableSpace.generateFrom {K : Set FourierCircle | IsClosed K} := by
      rw [BorelSpace.measurable_eq (α := FourierCircle), borel_eq_generateFrom_isClosed]
    intro E hE
    refine MeasurableSpace.induction_on_inter hgen isPiSystem_isClosed
      (C := fun s _ ↦ μ s = ∫ ζ in s, radialBoundaryLimit f ζ ∂circleMeasure)
      ?_ ?_ ?_ ?_ E hE
    · simp
    · intro K hK
      exact hclosed K hK
    · intro t ht iht
      rw [μ.of_compl ht, iht, hclosed Set.univ isClosed_univ, setIntegral_univ,
        setIntegral_compl ht hbd_int]
    · intro g hfd hfm ih
      rw [μ.of_disjoint_iUnion hfm hfd, integral_iUnion hfm hfd hbd_int.integrableOn]
      simp_rw [ih]
  have hnull : ∀ E : Set FourierCircle, MeasurableSet E → circleMeasure E = 0 → μ E = 0 := by
    intro E hE h0
    rw [hborel E hE, Measure.restrict_eq_zero.mpr h0, integral_zero_measure]
  have hac : μ ≪ᵥ circleMeasure.toENNRealVectorMeasure :=
    (RudinRCA.Chapter06.absolutelyContinuous_iff_null_sets μ circleMeasure).mpr hnull
  have hvar_ac : μ.variation ≪ circleMeasure :=
    RudinRCA.Chapter06.variation_absolutelyContinuous hac
  exact ⟨hac, hvar_ac, hnull, ⟨f, hf_h1, hborel⟩⟩

/-- Positive-monomial formulation of the **F. and M. Riesz Theorem** (Rudin p. 341, eq. (2)):
if `∫ e^{ikt} dμ(t) = 0` for every positive integer `k > 0` (i.e., `n = -k < 0` in the Fourier
coefficient convention `c_n = ∫ e^{-int} dμ(t)`), then `μ` is absolutely continuous with respect to
`circleMeasure` and `dμ = f* dσ` for some `f ∈ H^1`. -/
theorem theorem17_13_pos_monomial (μ : MeasureTheory.ComplexMeasure FourierCircle)
    (hμ_pos : ∀ k : ℕ, 0 < k →
      RudinRCA.Chapter10.complexMeasureIntegral μ
        (RudinRCA.Chapter04.trigMonomial (k : ℤ)) = 0) :
    μ ≪ᵥ circleMeasure.toENNRealVectorMeasure ∧
    μ.variation ≪ circleMeasure ∧
    (∀ E : Set FourierCircle, MeasurableSet E → circleMeasure E = 0 → μ E = 0) ∧
    (∃ f : ℂ → ℂ, IsInHardySpace 1 f ∧
      ∀ E : Set FourierCircle, MeasurableSet E →
        μ E = ∫ ζ in E, radialBoundaryLimit f ζ ∂circleMeasure) := by
  refine theorem17_13 μ fun n hn ↦ ?_
  have hk_pos : 0 < (-n).toNat := by omega
  have hst : (fun ζ : FourierCircle ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)) =
      RudinRCA.Chapter04.trigMonomial ((-n).toNat : ℤ) := by
    funext ζ
    rw [star_trigMonomial, Int.toNat_of_nonneg (by omega : 0 ≤ -n)]
  rw [hst]
  exact hμ_pos (-n).toNat hk_pos

/-! ### Exported Interface for Chapter 17 Part C (`HardyPartBInterface`) -/

theorem hardyPartBInterface_holds : HardyPartBInterface where
  blaschke_div := fun hfN hnz ↦ theorem17_9 hfN hnz
  hardy_boundary := by
    intro p f hp0 hf
    rcases eq_or_ne p ⊤ with rfl | hptop
    · have h := h_infty_boundary hf
      exact ⟨h.1, h.2.1, h.2.2.1, fun hne ↦ (hne rfl).elim, fun _ ↦ h.2.2.2⟩
    · have h := theorem17_11 hp0 hptop hf
      exact ⟨h.2.1.mono fun _ hζ ↦ hζ.2, h.2.2.1, h.2.2.2.2.1, fun _ ↦ h.2.2.2.1,
        fun hp1 z hz ↦ (h.2.2.2.2.2 hp1 z hz).1⟩
  h2_series := fun hf ↦ theorem17_12 hf

end PartB

namespace PartC
open MeasureTheory Filter Set CompactlySupportedContinuousMap RudinRCA.Chapter04 RudinRCA.Chapter10
open scoped ENNReal NNReal Real ComplexConjugate Topology CompactlySupported

/-! ### Basic `circlePoint`, `circleMeasure`, and `radialBoundaryLimit` bridges -/

theorem circlePoint_coe (t : ℝ) :
    circlePoint (t : FourierCircle) = Complex.exp ((t : ℂ) * Complex.I) :=
  rfl

@[continuity, fun_prop]
theorem continuous_circlePoint : Continuous circlePoint :=
  continuous_subtype_val.comp fourierCircleHomeomorphism.continuous

@[simp]
theorem norm_circlePoint (ζ : FourierCircle) : ‖circlePoint ζ‖ = 1 :=
  Circle.norm_coe _

theorem circlePoint_mem_sphere (ζ : FourierCircle) :
    circlePoint ζ ∈ Metric.sphere (0 : ℂ) 1 := by
  simp

theorem circlePoint_ne_zero (ζ : FourierCircle) : circlePoint ζ ≠ 0 := by
  intro h
  have hn := norm_circlePoint ζ
  rw [h, norm_zero] at hn
  exact zero_ne_one hn

@[simp]
theorem circlePoint_zero : circlePoint 0 = 1 := by
  rw [← QuotientAddGroup.mk_zero, circlePoint_coe]
  simp

theorem circlePoint_surjective_sphere {w : ℂ} (hw : w ∈ Metric.sphere (0 : ℂ) 1) :
    ∃ ζ : FourierCircle, circlePoint ζ = w := by
  let u : Circle := ⟨w, hw⟩
  refine ⟨fourierCircleHomeomorphism.symm u, ?_⟩
  exact congr_arg Subtype.val (fourierCircleHomeomorphism.apply_symm_apply u)

theorem integral_radialSlice_eq_circleAverage {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] (G : ℂ → E) (r : ℝ) :
    (∫ ζ, G ((r : ℂ) * circlePoint ζ) ∂circleMeasure) = Real.circleAverage G 0 r := by
  rw [AddCircle.integral_haarAddCircle,
    ← AddCircle.intervalIntegral_preimage (2 * Real.pi) 0
      (fun ζ : FourierCircle ↦ G ((r : ℂ) * circlePoint ζ)),
    zero_add, Real.circleAverage_def]
  congr 2
  ext θ
  simp [circleMap]

theorem continuous_radialSlice_of_holomorphicOn {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Continuous (radialSlice f r) := by
  refine (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).comp_continuous
    (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_
  simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hr0] using hr1

theorem memLp_circleMeasure_of_continuous {E : Type*} [NormedAddCommGroup E]
    {g : FourierCircle → E} (hg : Continuous g) (p : ℝ≥0∞) :
    MemLp g p circleMeasure := by
  obtain ⟨ζ_max, _, hmax⟩ := isCompact_univ.exists_isMaxOn univ_nonempty hg.norm.continuousOn
  exact MemLp.of_bound hg.aestronglyMeasurable ‖g ζ_max‖
    (Eventually.of_forall fun ζ ↦ hmax (mem_univ ζ))

theorem eLpNorm_top_eq_iSup_of_continuous (g : FourierCircle → ℂ) (hg : Continuous g) :
    eLpNorm g ⊤ circleMeasure = ⨆ ζ : FourierCircle, ‖g ζ‖ₑ := by
  rw [eLpNorm_exponent_top hg.aestronglyMeasurable, eLpNormEssSup_eq_essSup_enorm]
  have hg_enorm : Continuous (fun ζ : FourierCircle ↦ ‖g ζ‖ₑ) := by
    simpa only [enorm_eq_nnnorm, Function.comp_def] using ENNReal.continuous_coe.comp hg.nnnorm
  exact (iSup_eq_essSup fun ζ _ ha ↦
    (isOpen_lt continuous_const hg_enorm).measure_ne_zero circleMeasure ⟨ζ, ha⟩).symm

theorem hardySizeENNReal_top_eq_biSup {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    hardySizeENNReal ⊤ f = ⨆ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ₑ := by
  unfold hardySizeENNReal
  refine le_antisymm ?_ ?_
  · refine iSup₂_le fun r hr ↦ ?_
    have hcont := continuous_radialSlice_of_holomorphicOn hf hr.1 hr.2
    unfold radialSizeENNReal
    rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
      eLpNorm_top_eq_iSup_of_continuous _ hcont]
    refine iSup_le fun ζ ↦ ?_
    have hz_mem : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hr.1] using hr.2
    exact le_biSup (fun z ↦ ‖f z‖ₑ) hz_mem
  · refine iSup₂_le fun z hz ↦ ?_
    have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
    let r : ℝ := ‖z‖
    have hr_mem : r ∈ Set.Ico (0 : ℝ) 1 := ⟨norm_nonneg z, hz_lt⟩
    have hcont := continuous_radialSlice_of_holomorphicOn hf hr_mem.1 hr_mem.2
    obtain ⟨ζ, hζ⟩ : ∃ ζ : FourierCircle, (r : ℂ) * circlePoint ζ = z := by
      by_cases hz0 : z = 0
      · refine ⟨0, ?_⟩
        simp [r, hz0]
      · have hr_pos : 0 < r := norm_pos_iff.mpr hz0
        have hw : z / (r : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
          rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
            Real.norm_eq_abs, abs_of_pos hr_pos, div_self hr_pos.ne']
        obtain ⟨ζ, hζ⟩ := circlePoint_surjective_sphere hw
        refine ⟨ζ, ?_⟩
        rw [hζ, mul_div_cancel₀ z (Complex.ofReal_ne_zero.mpr hr_pos.ne')]
    calc ‖f z‖ₑ
        = ‖radialSlice f r ζ‖ₑ := by simp [radialSlice, hζ]
      _ ≤ radialSizeENNReal ⊤ f r := by
          unfold radialSizeENNReal
          rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
            eLpNorm_top_eq_iSup_of_continuous _ hcont]
          exact le_iSup (fun η ↦ ‖radialSlice f r η‖ₑ) ζ
      _ ≤ ⨆ ρ ∈ Set.Ico (0 : ℝ) 1, radialSizeENNReal ⊤ f ρ :=
          le_biSup (radialSizeENNReal ⊤ f) hr_mem

theorem isInHardySpace_top_iff (f : ℂ → ℂ) :
    IsInHardySpace ⊤ f ↔
      HolomorphicOn f (Metric.ball (0 : ℂ) 1) ∧
        BddAbove ((fun z ↦ ‖f z‖) '' Metric.ball (0 : ℂ) 1) := by
  unfold IsInHardySpace
  constructor
  · rintro ⟨_, hf, hlt⟩
    rw [hardySizeENNReal_top_eq_biSup hf] at hlt
    refine ⟨hf, (⨆ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ₑ).toReal, ?_⟩
    rintro _ ⟨z, hz, rfl⟩
    have hle : ‖f z‖ₑ ≤ ⨆ w ∈ Metric.ball (0 : ℂ) 1, ‖f w‖ₑ := le_biSup (fun w ↦ ‖f w‖ₑ) hz
    rw [← ofReal_norm] at hle
    exact (ENNReal.ofReal_le_iff_le_toReal hlt.ne).mp hle
  · rintro ⟨hf, M, hM⟩
    refine ⟨ENNReal.top_ne_zero, hf, ?_⟩
    rw [hardySizeENNReal_top_eq_biSup hf]
    refine lt_of_le_of_lt (iSup₂_le fun z hz ↦ ?_) (ENNReal.ofReal_lt_top (r := M))
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hM ⟨z, hz, rfl⟩)

theorem radialBoundaryLimit_eq_of_tendsto {f : ℂ → ℂ} {ζ : FourierCircle} {w : ℂ}
    (h : Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] (1 : ℝ)) (𝓝 w)) :
    radialBoundaryLimit f ζ = w :=
  h.limUnder_eq

theorem radialBoundaryLimit_congr_ball {f g : ℂ → ℂ}
    (hfg : Set.EqOn f g (Metric.ball (0 : ℂ) 1)) (ζ : FourierCircle) :
    radialBoundaryLimit f ζ = radialBoundaryLimit g ζ := by
  unfold radialBoundaryLimit limUnder
  have hev : (fun r : ℝ ↦ radialSlice f r ζ) =ᶠ[𝓝[<] (1 : ℝ)]
      (fun r : ℝ ↦ radialSlice g r ζ) := by
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    refine hfg ?_
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr.1] using hr.2
  rw [Filter.map_congr hev]

/-- Transfer any `volume`-a.e. property on `ℝ` to `circleMeasure`-a.e. on `FourierCircle`. -/
theorem ae_circleMeasure_of_ae_volume {P : FourierCircle → Prop}
    (hae : ∀ᵐ θ : ℝ ∂MeasureTheory.volume, P (θ : FourierCircle)) :
    ∀ᵐ ζ ∂circleMeasure, P ζ := by
  have : Fact (0 < 2 * Real.pi) := ⟨Real.two_pi_pos⟩
  let e := AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
  let E₀ : Set ℝ := toMeasurable MeasureTheory.volume {θ : ℝ | ¬ P (θ : FourierCircle)}
  have hE₀_meas : MeasurableSet E₀ := measurableSet_toMeasurable _ _
  have hE₀_sub : {θ : ℝ | ¬ P (θ : FourierCircle)} ⊆ E₀ := subset_toMeasurable _ _
  have hE₀_null : MeasureTheory.volume E₀ = 0 := by
    rw [measure_toMeasurable]
    exact mem_ae_iff.mp hae
  let B : Set FourierCircle := (fun ζ ↦ ((e ζ : Set.Ioc _ _) : ℝ)) ⁻¹' E₀
  have hB_meas : MeasurableSet B := (measurable_subtype_coe.comp e.measurable) hE₀_meas
  have hB_vol_zero : (MeasureTheory.volume : Measure FourierCircle) B = 0 := by
    rw [← (AddCircle.measurePreserving_mk (2 * Real.pi) (-Real.pi)).map_eq,
      Measure.map_apply AddCircle.measurable_mk' hB_meas,
      Measure.restrict_apply (AddCircle.measurable_mk' hB_meas)]
    refine measure_mono_null (fun x hx ↦ ?_) hE₀_null
    rcases hx with ⟨hxB, hxIoc⟩
    change ((e (x : FourierCircle) : Set.Ioc _ _) : ℝ) ∈ E₀ at hxB
    have he_coe : (e (x : FourierCircle) : Set.Ioc _ _) = ⟨x, hxIoc⟩ :=
      (AddCircle.equivIoc (2 * Real.pi) (-Real.pi)).right_inv ⟨x, hxIoc⟩
    rwa [he_coe] at hxB
  have hB_circle_zero : circleMeasure B = 0 := by
    rw [AddCircle.volume_eq_smul_haarAddCircle, Measure.smul_apply, smul_eq_mul, mul_eq_zero]
      at hB_vol_zero
    exact hB_vol_zero.resolve_left (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne'
  filter_upwards [compl_mem_ae_iff.mpr hB_circle_zero] with ζ hζ
  by_contra hnot
  have hx₁_coe : (((e ζ : Set.Ioc _ _) : ℝ) : FourierCircle) = ζ :=
    (AddCircle.equivIoc (2 * Real.pi) (-Real.pi)).left_inv ζ
  have hmem : ((e ζ : Set.Ioc _ _) : ℝ) ∈ E₀ := by
    apply hE₀_sub
    change ¬ P ((((e ζ : Set.Ioc _ _) : ℝ) : FourierCircle))
    rwa [hx₁_coe]
  exact hζ hmem

/-- Transfer a `2π`-periodic Borel measurable function on `ℝ` interval-integrable on `(-π, π)` to
an integrable function on `(FourierCircle, circleMeasure)`. -/
theorem integrable_circleMeasure_of_periodic_intervalIntegrable {E : Type*}
    [NormedAddCommGroup E] [MeasurableSpace E] [BorelSpace E] [SecondCountableTopology E]
    {g : ℝ → E}
    (hg_per : Function.Periodic g (2 * Real.pi)) (hg_meas : Measurable g)
    (hg_int : IntervalIntegrable g MeasureTheory.volume (-Real.pi) Real.pi) :
    let e := AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
    Integrable (fun ζ : FourierCircle ↦ g ((e ζ : Set.Ioc _ _) : ℝ)) circleMeasure ∧
    (∀ θ : ℝ, g ((e (θ : FourierCircle) : Set.Ioc _ _) : ℝ) = g θ) := by
  have : Fact (0 < 2 * Real.pi) := ⟨Real.two_pi_pos⟩
  let e := AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
  let G : FourierCircle → E := fun ζ ↦ g ((e ζ : Set.Ioc _ _) : ℝ)
  have hG_coe : ∀ θ : ℝ, G (θ : FourierCircle) = g θ := by
    intro θ
    have hcoe : (((e (θ : FourierCircle) : Set.Ioc _ _) : ℝ) : FourierCircle) =
        (θ : FourierCircle) :=
      (AddCircle.equivIoc (2 * Real.pi) (-Real.pi)).left_inv (θ : FourierCircle)
    obtain ⟨k, hk⟩ := QuotientAddGroup.eq.mp hcoe
    have hform : θ = ((e (θ : FourierCircle) : Set.Ioc _ _) : ℝ) + (k : ℝ) * (2 * Real.pi) := by
      have hk' : (k : ℝ) * (2 * Real.pi) = -((e (θ : FourierCircle) : Set.Ioc _ _) : ℝ) + θ := by
        simpa [zsmul_eq_mul] using hk
      linarith
    calc G (θ : FourierCircle)
        = g (((e (θ : FourierCircle) : Set.Ioc _ _) : ℝ) + (k : ℝ) * (2 * Real.pi)) := by
            simpa [G, mul_comm] using (hg_per.int_mul k _).symm
      _ = g θ := by rw [← hform]
  have hG_meas : Measurable G := hg_meas.comp (measurable_subtype_coe.comp e.measurable)
  have hIoc_eq : -Real.pi + 2 * Real.pi = Real.pi := by ring
  have hint_Ioc : IntegrableOn (fun θ : ℝ ↦ G (θ : FourierCircle))
      (Set.Ioc (-Real.pi) (-Real.pi + 2 * Real.pi)) MeasureTheory.volume := by
    rw [hIoc_eq]
    have hi := hg_int.1
    exact hi.congr_fun (fun θ _ ↦ (hG_coe θ).symm) measurableSet_Ioc
  have hmp := AddCircle.measurePreserving_mk (2 * Real.pi) (-Real.pi)
  have hG_vol : Integrable G (MeasureTheory.volume : Measure FourierCircle) :=
    (hmp.integrable_comp hG_meas.aestronglyMeasurable).mp hint_Ioc
  have hG_haar : Integrable G circleMeasure := by
    rw [AddCircle.volume_eq_smul_haarAddCircle] at hG_vol
    have hsmul := hG_vol.smul_measure (c := (ENNReal.ofReal (2 * Real.pi))⁻¹)
      (ENNReal.inv_ne_top.mpr (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne')
    rwa [smul_smul, ENNReal.inv_mul_cancel (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne'
      ENNReal.ofReal_ne_top, one_smul] at hsmul
  exact ⟨hG_haar, hG_coe⟩

/-- Every bounded holomorphic function `f` on `Metric.ball 0 1` converges radially `circleMeasure`-a.e.
to `radialBoundaryLimit f`, which is `AEMeasurable` and bounded by `M` `circleMeasure`-a.e. -/
theorem bounded_holomorphic_radialBoundaryLimit {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {M : ℝ}
    (hM : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ ≤ M) :
    (∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
    AEMeasurable (radialBoundaryLimit f) circleMeasure ∧
    (∀ᵐ ζ ∂circleMeasure, ‖radialBoundaryLimit f ζ‖ ≤ M) := by
  have hf_diff : DifferentiableOn ℂ f (Metric.ball (0 : ℂ) 1) :=
    (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hf
  obtain ⟨fStar, hfStar_per, hfStar_meas, hfStar_bdd, _, hae_vol, _⟩ :=
    RudinRCA.Chapter15.exists_radial_limit_of_bounded_holomorphic.{0} hf_diff hM
  let e := AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
  let G : FourierCircle → ℂ := fun ζ ↦ fStar ((e ζ : Set.Ioc _ _) : ℝ)
  have hG_meas : Measurable G := hfStar_meas.comp (measurable_subtype_coe.comp e.measurable)
  have hG_coe : ∀ θ : ℝ, G (θ : FourierCircle) = fStar θ := by
    have hM_nn : 0 ≤ M := (norm_nonneg (f 0)).trans (hM 0 (Metric.mem_ball_self zero_lt_one))
    have hint : IntervalIntegrable fStar MeasureTheory.volume (-Real.pi) Real.pi := by
      rw [intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith [Real.pi_pos])]
      exact Integrable.of_bound hfStar_meas.aestronglyMeasurable M
        (Eventually.of_forall fun θ ↦ hfStar_bdd θ)
    exact (integrable_circleMeasure_of_periodic_intervalIntegrable hfStar_per hfStar_meas hint).2
  have hae_G : ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (G ζ)) := by
    refine ae_circleMeasure_of_ae_volume ?_
    filter_upwards [hae_vol] with θ hθ
    rw [hG_coe θ]
    exact hθ.2
  have hae_eq : radialBoundaryLimit f =ᵐ[circleMeasure] G := by
    filter_upwards [hae_G] with ζ hζ
    exact radialBoundaryLimit_eq_of_tendsto hζ
  refine ⟨?_, hG_meas.aemeasurable.congr hae_eq.symm, ?_⟩
  · filter_upwards [hae_G, hae_eq] with ζ hζ heq
    rwa [heq]
  · filter_upwards [hae_eq] with ζ heq
    rw [heq]
    exact hfStar_bdd _

/-- Circle-measure wrapper around `Chapter15.theorem15_19`: every bounded nonzero holomorphic
function `f` on `Metric.ball 0 1` has `radialBoundaryLimit f ζ ≠ 0` `circleMeasure`-a.e. and
`Integrable (fun ζ ↦ Real.log ‖radialBoundaryLimit f ζ‖) circleMeasure`. -/
theorem bounded_nonzero_holomorphic_boundary_log {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1))
    (hbdd : ∃ M : ℝ, ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ ≤ M)
    (hnonzero : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) :
    (∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
    (∀ᵐ ζ ∂circleMeasure, radialBoundaryLimit f ζ ≠ 0) ∧
    Integrable (fun ζ ↦ Real.log ‖radialBoundaryLimit f ζ‖) circleMeasure := by
  have hf_diff : DifferentiableOn ℂ f (Metric.ball (0 : ℂ) 1) :=
    (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hf
  obtain ⟨fStar, hfStar_per, hfStar_meas, _, _, hae_rad_vol, _, _, _,
      hint_log, _, _, hae_nz_vol, _, _⟩ :=
    RudinRCA.Chapter15.theorem15_19 hf_diff hbdd hnonzero
  have hper_log : Function.Periodic (fun θ : ℝ ↦ Real.log ‖fStar θ‖) (2 * Real.pi) :=
    fun θ ↦ by simp [hfStar_per θ]
  have hmeas_log : Measurable (fun θ : ℝ ↦ Real.log ‖fStar θ‖) :=
    Real.measurable_log.comp hfStar_meas.norm
  obtain ⟨hlog_int, hlog_coe⟩ :=
    integrable_circleMeasure_of_periodic_intervalIntegrable hper_log hmeas_log hint_log
  let e := AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
  have hae_lim_nz : ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ)) ∧
      radialBoundaryLimit f ζ ≠ 0 ∧
      Real.log ‖radialBoundaryLimit f ζ‖ = Real.log ‖fStar ((e ζ : Set.Ioc _ _) : ℝ)‖ := by
    refine ae_circleMeasure_of_ae_volume ?_
    filter_upwards [hae_rad_vol, hae_nz_vol] with θ hrad hnz
    have heq : radialBoundaryLimit f (θ : FourierCircle) = fStar θ :=
      radialBoundaryLimit_eq_of_tendsto hrad
    refine ⟨heq ▸ hrad, heq ▸ hnz, ?_⟩
    rw [heq, ← hlog_coe θ]
  refine ⟨hae_lim_nz.mono fun _ h ↦ h.1, hae_lim_nz.mono fun _ h ↦ h.2.1, ?_⟩
  exact hlog_int.congr (hae_lim_nz.mono fun _ h ↦ h.2.2.symm)

/-! ### Herglotz and Poisson Transforms for Functions on `FourierCircle` -/

/-- Rudin's Herglotz operator `ψh(z) = ∫_T ((ζ + z) / (ζ - z)) h(ζ) dσ(ζ)`. -/
def herglotzTransform (h : FourierCircle → ℂ) (z : ℂ) : ℂ :=
  ∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) * h ζ ∂circleMeasure

/-- Poisson integral on `FourierCircle` against normalized Haar measure `σ`. -/
def circlePoissonIntegral {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (h : FourierCircle → E) (z : ℂ) : E :=
  ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • h ζ ∂circleMeasure

theorem norm_circlePoint_sub_ge (z : ℂ) (ζ : FourierCircle) :
    |1 - ‖z‖| ≤ ‖circlePoint ζ - z‖ := by
  have h := abs_norm_sub_norm_le (circlePoint ζ) z
  rwa [norm_circlePoint] at h

theorem integrable_herglotzIntegrand {h : FourierCircle → ℂ}
    (hh : Integrable h circleMeasure) {z : ℂ} (hz : ‖z‖ ≠ 1) :
    Integrable (fun ζ ↦ ((circlePoint ζ + z) / (circlePoint ζ - z)) * h ζ) circleMeasure := by
  have hcont : Continuous (fun ζ : FourierCircle ↦ (circlePoint ζ + z) / (circlePoint ζ - z)) := by
    refine Continuous.div (continuous_circlePoint.add continuous_const)
      (continuous_circlePoint.sub continuous_const) fun ζ h0 ↦ hz ?_
    have heq : circlePoint ζ = z := sub_eq_zero.mp h0
    rw [← heq, norm_circlePoint]
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hcont.continuousOn
  exact hh.bdd_mul hcont.aestronglyMeasurable (Eventually.of_forall fun ζ ↦ hC ζ (Set.mem_univ ζ))

theorem hasDerivAt_herglotzTransform {h : FourierCircle → ℂ}
    (hh : Integrable h circleMeasure) {z : ℂ} (hz : ‖z‖ ≠ 1) :
    HasDerivAt (herglotzTransform h)
      (∫ ζ, (2 * circlePoint ζ / (circlePoint ζ - z) ^ 2) * h ζ ∂circleMeasure) z := by
  let d : ℝ := |1 - ‖z‖| / 2
  have hd_pos : 0 < d := half_pos (abs_pos.mpr (sub_ne_zero.mpr hz.symm))
  have hdist : ∀ x ∈ Metric.ball z d, ∀ ζ : FourierCircle, d ≤ ‖circlePoint ζ - x‖ := by
    intro x hx ζ
    have hxz : ‖x - z‖ < d := by simpa [Metric.mem_ball, dist_eq_norm] using hx
    have h1 : |1 - ‖z‖| ≤ ‖circlePoint ζ - z‖ := norm_circlePoint_sub_ge z ζ
    have h2 : ‖circlePoint ζ - z‖ ≤ ‖circlePoint ζ - x‖ + ‖x - z‖ :=
      norm_sub_le_norm_sub_add_norm_sub (circlePoint ζ) x z
    dsimp [d] at hxz ⊢
    linarith
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (F := fun x ζ ↦ ((circlePoint ζ + x) / (circlePoint ζ - x)) * h ζ)
    (F' := fun x ζ ↦ (2 * circlePoint ζ / (circlePoint ζ - x) ^ 2) * h ζ)
    (bound := fun ζ ↦ (2 / d ^ 2) * ‖h ζ‖)
    (Metric.ball_mem_nhds z hd_pos) ?_ (integrable_herglotzIntegrand hh hz) ?_ ?_ ?_ ?_).2
  · exact Eventually.of_forall fun x ↦
      (Measurable.aestronglyMeasurable (by fun_prop)).mul hh.aestronglyMeasurable
  · exact (Measurable.aestronglyMeasurable (by fun_prop)).mul hh.aestronglyMeasurable
  · refine Eventually.of_forall fun ζ x hx ↦ ?_
    have hdx : d ≤ ‖circlePoint ζ - x‖ := hdist x hx ζ
    rw [norm_mul, norm_div, norm_mul, norm_pow, norm_circlePoint, mul_one]
    have h2 : ‖(2 : ℂ)‖ = 2 := by norm_num
    rw [h2]
    refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
    exact div_le_div_of_nonneg_left zero_le_two (pow_pos hd_pos 2)
      (pow_le_pow_left₀ hd_pos.le hdx 2)
  · exact hh.norm.const_mul (2 / d ^ 2)
  · refine Eventually.of_forall fun ζ x hx ↦ ?_
    have hne : circlePoint ζ - x ≠ 0 :=
      norm_pos_iff.mp (lt_of_lt_of_le hd_pos (hdist x hx ζ))
    have hd_quot : HasDerivAt (fun w ↦ (circlePoint ζ + w) / (circlePoint ζ - w))
        (2 * circlePoint ζ / (circlePoint ζ - x) ^ 2) x := by
      have h3 := ((hasDerivAt_id' x).const_add (circlePoint ζ)).div
        ((hasDerivAt_id' x).const_sub (circlePoint ζ)) hne
      exact h3.congr_deriv (by ring)
    exact hd_quot.mul_const (h ζ)

theorem holomorphicOn_herglotzTransform {h : FourierCircle → ℂ}
    (hh : Integrable h circleMeasure) :
    HolomorphicOn (herglotzTransform h) (Metric.ball (0 : ℂ) 1) :=
  fun _ hz ↦ (hasDerivAt_herglotzTransform hh (mem_ball_zero_iff.mp hz).ne).differentiableAt

@[simp]
theorem herglotzTransform_zero_eval (h : FourierCircle → ℂ) :
    herglotzTransform h 0 = ∫ ζ, h ζ ∂circleMeasure := by
  unfold herglotzTransform
  refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
  dsimp only
  rw [add_zero, sub_zero, div_self (circlePoint_ne_zero ζ), one_mul]

theorem poissonKernel_eq_re_herglotz (z : ℂ) (ζ : FourierCircle) :
    _root_.poissonKernel 0 z (circlePoint ζ) =
      ((circlePoint ζ + z) / (circlePoint ζ - z)).re := by
  have h1 := congr_fun (poissonKernel_eq_re_herglotzRieszKernel (c := 0) (w := z)) (circlePoint ζ)
  simpa [herglotzRieszKernel_def] using h1

theorem poissonKernel_circlePoint_formula (z : ℂ) (ζ : FourierCircle) :
    _root_.poissonKernel 0 z (circlePoint ζ) =
      (1 - ‖z‖ ^ 2) / ‖circlePoint ζ - z‖ ^ 2 := by
  rw [poissonKernel_eq_re_herglotz]
  let u : ℂ := circlePoint ζ
  have hu : ‖u‖ = 1 := norm_circlePoint ζ
  by_cases hsub : u - z = 0
  · have huz : u = z := sub_eq_zero.mp hsub
    simp [u, ← huz, hu]
  · rw [Complex.div_re]
    have hns : Complex.normSq (u - z) = ‖u - z‖ ^ 2 := Complex.normSq_eq_norm_sq (u - z)
    have hnum : (u + z).re * (u - z).re + (u + z).im * (u - z).im = 1 - ‖z‖ ^ 2 := by
      have h1 : u.re ^ 2 + u.im ^ 2 = 1 := by
        have := Complex.normSq_eq_norm_sq u
        rw [hu, one_pow] at this
        simpa [Complex.normSq_apply, sq] using this
      have h2 : z.re ^ 2 + z.im ^ 2 = ‖z‖ ^ 2 := by
        simpa [Complex.normSq_apply, sq] using Complex.normSq_eq_norm_sq z
      simp only [Complex.add_re, Complex.sub_re, Complex.add_im, Complex.sub_im]
      linarith
    rw [hns]
    calc (u + z).re * (u - z).re / ‖u - z‖ ^ 2 + (u + z).im * (u - z).im / ‖u - z‖ ^ 2
        = ((u + z).re * (u - z).re + (u + z).im * (u - z).im) / ‖u - z‖ ^ 2 := (add_div _ _ _).symm
      _ = (1 - ‖z‖ ^ 2) / ‖u - z‖ ^ 2 := by rw [hnum]

theorem poissonKernel_circlePoint_nonneg {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1)
    (ζ : FourierCircle) :
    0 ≤ _root_.poissonKernel 0 z (circlePoint ζ) := by
  have hz_lt : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
  rw [poissonKernel_circlePoint_formula]
  exact div_nonneg (by nlinarith [norm_nonneg z]) (sq_nonneg _)

theorem poissonKernel_circlePoint_symm (r : ℝ) (ζ η : FourierCircle) :
    _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) =
      _root_.poissonKernel 0 ((r : ℂ) * circlePoint η) (circlePoint ζ) := by
  rw [poissonKernel_circlePoint_formula, poissonKernel_circlePoint_formula]
  simp only [norm_mul, norm_circlePoint, mul_one]
  congr 2
  let u : ℂ := circlePoint ζ
  let v : ℂ := circlePoint η
  have hu : ‖u‖ = 1 := norm_circlePoint ζ
  have hv : ‖v‖ = 1 := norm_circlePoint η
  have huv : u * conj u = 1 := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hu, one_pow, Complex.ofReal_one]
  have hvv : v * conj v = 1 := by
    rw [Complex.mul_conj, Complex.normSq_eq_norm_sq, hv, one_pow, Complex.ofReal_one]
  have hid : u - (r : ℂ) * v = u * v * conj (v - (r : ℂ) * u) := by
    simp only [map_sub, map_mul, Complex.conj_ofReal]
    calc u - (r : ℂ) * v
        = u * (v * conj v) - (r : ℂ) * v * (u * conj u) := by rw [huv, hvv, mul_one, mul_one]
      _ = u * v * (conj v - (r : ℂ) * conj u) := by ring
  change ‖v - (r : ℂ) * u‖ = ‖u - (r : ℂ) * v‖
  rw [hid, norm_mul, norm_mul, hu, hv, Complex.norm_conj, one_mul, one_mul]

theorem continuous_poissonKernel_circlePoint {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    Continuous (fun ζ : FourierCircle ↦ _root_.poissonKernel 0 z (circlePoint ζ)) := by
  have hz_ne : ‖z‖ ≠ 1 := (mem_ball_zero_iff.mp hz).ne
  simp_rw [poissonKernel_eq_re_herglotz z]
  refine Complex.continuous_re.comp (Continuous.div (continuous_circlePoint.add continuous_const)
    (continuous_circlePoint.sub continuous_const) fun ζ h0 ↦ hz_ne ?_)
  have heq : circlePoint ζ = z := sub_eq_zero.mp h0
  rw [← heq, norm_circlePoint]

theorem re_herglotzTransform_ofReal {g : FourierCircle → ℝ}
    (hg : Integrable g circleMeasure) {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    (herglotzTransform (fun ζ ↦ (g ζ : ℂ)) z).re = circlePoissonIntegral g z := by
  have hz_ne : ‖z‖ ≠ 1 := (mem_ball_zero_iff.mp hz).ne
  have hint := integrable_herglotzIntegrand (Complex.ofRealCLM.integrable_comp hg) hz_ne
  have hcomm := (Complex.reCLM.integral_comp_comm hint).symm
  change (herglotzTransform (fun ζ ↦ (g ζ : ℂ)) z).re = _ at hcomm
  rw [hcomm]
  unfold circlePoissonIntegral
  refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
  simp [Complex.mul_re, poissonKernel_eq_re_herglotz]

theorem integral_poissonKernel_circlePoint_eq_one {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂circleMeasure = 1 := by
  have hz_lt : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
  have hca : (∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂circleMeasure) =
      Real.circleAverage (fun ξ : ℂ ↦ ((ξ + z) / (ξ - z)).re • (1 : ℝ)) 0 1 := by
    simp_rw [poissonKernel_eq_re_herglotz z]
    simpa [one_mul, smul_eq_mul] using
      integral_radialSlice_eq_circleAverage (fun ξ : ℂ ↦ ((ξ + z) / (ξ - z)).re) 1
  have hdcc : DiffContOnCl ℂ (fun _ : ℂ ↦ (1 : ℂ)) (Metric.ball (0 : ℂ) 1) :=
    ⟨differentiableOn_const 1, continuousOn_const⟩
  have hpif := congr_arg Complex.re (hdcc.circleAverage_re_herglotzRieszKernel_smul' hz)
  have hci : CircleIntegrable (fun ξ : ℂ ↦ ((ξ + z) / (ξ - z)).re • (1 : ℂ)) 0 1 := by
    have hz_not : z ∉ Metric.sphere (0 : ℂ) |(1 : ℝ)| := by
      rw [abs_of_pos zero_lt_one, Metric.mem_sphere, dist_zero_right]
      exact hz_lt.ne
    have hck := Complex.continuous_re.comp_continuousOn
      (continuousOn_herglotzRieszKernel_sphere hz_not)
    rw [abs_of_pos zero_lt_one] at hck
    have hck' : ContinuousOn (fun ξ : ℂ ↦ ((ξ + z) / (ξ - z)).re) (Metric.sphere 0 1) := by
      simpa [Function.comp_def, herglotzRieszKernel_def] using hck
    exact (hck'.smul continuousOn_const).circleIntegrable zero_le_one
  have hcomm := (Complex.reCLM.circleAverage_comp_comm hci).trans
    (by simpa [sub_zero] using hpif)
  rw [hca]
  exact (Real.circleAverage_congr_sphere fun ξ _ ↦ by simp [Complex.real_smul]).trans hcomm

/-- Radial convergence a.e. on `FourierCircle` of `circlePoissonIntegral G` for `G ∈ L¹(T)`. -/
theorem ae_tendsto_circlePoissonIntegral {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    {G : FourierCircle → E} (hG : Integrable G circleMeasure) :
    ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ circlePoissonIntegral G ((r : ℂ) * circlePoint ζ))
        (𝓝[<] 1) (𝓝 (G ζ)) := by
  filter_upwards [RudinRCA.Chapter15.ae_poisson_nontangential_tendsto_circle.{_, 0} hG] with ζ hζ
  obtain ⟨θ₀, hθ₀⟩ := QuotientAddGroup.mk_surjective ζ
  have hrad := (hζ θ₀ hθ₀).2
  refine hrad.congr' ?_
  filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
  have h1 : circlePoissonIntegral G ((r : ℂ) * circlePoint ζ) =
      (2 * Real.pi)⁻¹ • ∫ t in (-Real.pi)..Real.pi,
        _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ)
          (circlePoint (t : FourierCircle)) • G (t : FourierCircle) := by
    unfold circlePoissonIntegral
    rw [RudinRCA.Chapter04.circleIntegral_interval, one_div]
  rw [h1]
  congr 1
  refine intervalIntegral.integral_congr fun t _ ↦ ?_
  congr 1
  rw [poissonKernel_circlePoint_formula, ← hθ₀, circlePoint_coe, circlePoint_coe]
  simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr.1,
    Complex.norm_exp_ofReal_mul_I, mul_one]
  congr 1
  have hexp_eq : Complex.exp ((t : ℂ) * Complex.I) -
      (r : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I) =
      Complex.exp ((t : ℂ) * Complex.I) *
        (1 - (r : ℂ) * Complex.exp (((θ₀ - t : ℝ) : ℂ) * Complex.I)) := by
    push_cast
    rw [mul_sub, mul_one, ← mul_assoc, mul_comm (Complex.exp _) (r : ℂ), mul_assoc,
      ← Complex.exp_add]
    congr 3
    ring
  rw [hexp_eq, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul]

/-! ### Section 17.14: Inner and Outer Functions (RCA p. 342) -/

/-- **17.14 (Inner function, RCA p. 342):**
`M` is holomorphic on `U = Metric.ball 0 1`, satisfies `‖M z‖ ≤ 1` on `U`, and has radial boundary
modulus `‖M*(ζ)‖ = 1` for `circleMeasure`-almost every `ζ ∈ T`. -/
def IsInnerFunction (M : ℂ → ℂ) : Prop :=
  HolomorphicOn M (Metric.ball (0 : ℂ) 1) ∧
  (∀ z ∈ Metric.ball (0 : ℂ) 1, ‖M z‖ ≤ 1) ∧
  (∀ᵐ ζ ∂circleMeasure, ‖radialBoundaryLimit M ζ‖ = 1)

/-- **17.14 (Outer function constructor, RCA p. 342):**
`Q(z) = c * exp (∫_T ((ζ + z)/(ζ - z)) log φ(ζ) dσ(ζ))` for `z ∈ U = Metric.ball 0 1`
(extended by `0` outside `U`). -/
def outerFunction (c : ℂ) (φ : FourierCircle → ℝ) (z : ℂ) : ℂ :=
  (Metric.ball (0 : ℂ) 1).indicator
    (fun w ↦ c * Complex.exp (∫ ζ, ((circlePoint ζ + w) / (circlePoint ζ - w)) *
      (Real.log (φ ζ) : ℂ) ∂circleMeasure)) z

@[simp]
theorem outerFunction_apply_of_mem (c : ℂ) (φ : FourierCircle → ℝ)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    outerFunction c φ z =
      c * Complex.exp (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) *
        (Real.log (φ ζ) : ℂ) ∂circleMeasure) :=
  Set.indicator_of_mem hz _

@[simp]
theorem outerFunction_apply_of_notMem (c : ℂ) (φ : FourierCircle → ℝ)
    {z : ℂ} (hz : z ∉ Metric.ball (0 : ℂ) 1) :
    outerFunction c φ z = 0 :=
  Set.indicator_of_notMem hz _

/-- **17.14 (Outer function predicate, RCA p. 342):**
`Q` agrees on `U = Metric.ball 0 1` with `outerFunction c φ` for some `c ∈ ℂ` (`‖c‖ = 1`) and
positive measurable `φ : T → ℝ` with `log φ ∈ L¹(T)`. -/
def IsOuterFunction (Q : ℂ → ℂ) : Prop :=
  ∃ (c : ℂ) (φ : FourierCircle → ℝ),
    ‖c‖ = 1 ∧
    AEMeasurable φ circleMeasure ∧
    (∀ᵐ ζ ∂circleMeasure, 0 < φ ζ) ∧
    Integrable (fun ζ ↦ Real.log (φ ζ)) circleMeasure ∧
    Set.EqOn Q (outerFunction c φ) (Metric.ball (0 : ℂ) 1)

theorem IsInnerFunction.congr_ball {M₁ M₂ : ℂ → ℂ}
    (h : Set.EqOn M₁ M₂ (Metric.ball (0 : ℂ) 1)) (hM₁ : IsInnerFunction M₁) :
    IsInnerFunction M₂ := by
  refine ⟨fun z hz ↦ (hM₁.1 z hz).congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz) fun w hw ↦ (h hw).symm),
    fun z hz ↦ h hz ▸ hM₁.2.1 z hz, ?_⟩
  filter_upwards [hM₁.2.2] with ζ hζ
  rwa [← radialBoundaryLimit_congr_ball h ζ]

theorem IsInnerFunction.ae_tendsto {M : ℂ → ℂ} (hM : IsInnerFunction M) :
    ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice M r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit M ζ)) :=
  (bounded_holomorphic_radialBoundaryLimit hM.1 hM.2.1).1

theorem IsInnerFunction.isInHardySpace_top {M : ℂ → ℂ} (hM : IsInnerFunction M) :
    IsInHardySpace ⊤ M :=
  (isInHardySpace_top_iff M).mpr ⟨hM.1, 1, by rintro _ ⟨z, hz, rfl⟩; exact hM.2.1 z hz⟩

theorem IsInnerFunction.nonzero_on_ball {M : ℂ → ℂ} (hM : IsInnerFunction M) :
    ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, M z₀ ≠ 0 := by
  by_contra hzero
  have hzero' : ∀ z ∈ Metric.ball (0 : ℂ) 1, M z = 0 := by
    intro z hz
    by_contra hne
    exact hzero ⟨z, hz, hne⟩
  have hlim0 : ∀ ζ : FourierCircle, radialBoundaryLimit M ζ = 0 := by
    intro ζ
    refine radialBoundaryLimit_eq_of_tendsto ?_
    refine tendsto_const_nhds.congr' ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    refine (hzero' _ ?_).symm
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr.1] using hr.2
  have h1 : ∀ᵐ ζ ∂circleMeasure, (0 : ℝ) = 1 := by
    filter_upwards [hM.2.2] with ζ hζ
    rw [hlim0 ζ, norm_zero] at hζ
    exact hζ
  have hfalse : (0 : ℝ) = 1 := h1.exists.choose_spec
  norm_num at hfalse

theorem isInnerFunction_const {c : ℂ} (hc : ‖c‖ = 1) :
    IsInnerFunction (fun _ ↦ c) := by
  refine ⟨fun _ _ ↦ differentiableAt_const c, fun _ _ ↦ hc.le, ?_⟩
  refine Eventually.of_forall fun ζ ↦ ?_
  have hlim : radialBoundaryLimit (fun _ ↦ c) ζ = c :=
    radialBoundaryLimit_eq_of_tendsto tendsto_const_nhds
  rw [hlim, hc]

theorem IsInnerFunction.mul {M₁ M₂ : ℂ → ℂ}
    (hM₁ : IsInnerFunction M₁) (hM₂ : IsInnerFunction M₂) :
    IsInnerFunction (fun z ↦ M₁ z * M₂ z) := by
  refine ⟨fun z hz ↦ (hM₁.1 z hz).mul (hM₂.1 z hz), fun z hz ↦ ?_, ?_⟩
  · rw [norm_mul]
    calc ‖M₁ z‖ * ‖M₂ z‖
        ≤ 1 * ‖M₂ z‖ := mul_le_mul_of_nonneg_right (hM₁.2.1 z hz) (norm_nonneg _)
      _ ≤ 1 := by rw [one_mul]; exact hM₂.2.1 z hz
  · filter_upwards [hM₁.ae_tendsto, hM₂.ae_tendsto, hM₁.2.2, hM₂.2.2] with ζ ht₁ ht₂ hn₁ hn₂
    have ht : Tendsto (fun r : ℝ ↦ radialSlice (fun z ↦ M₁ z * M₂ z) r ζ)
        (𝓝[<] 1) (𝓝 (radialBoundaryLimit M₁ ζ * radialBoundaryLimit M₂ ζ)) :=
      ht₁.mul ht₂
    rw [radialBoundaryLimit_eq_of_tendsto ht, norm_mul, hn₁, hn₂, mul_one]

/-- Every Blaschke product (`Chapter15.IsBlaschkeProduct`) is an inner function (`17.14`). -/
theorem isInnerFunction_of_isBlaschkeProduct {B : ℂ → ℂ}
    (hB : RudinRCA.Chapter15.IsBlaschkeProduct B) :
    IsInnerFunction B := by
  have hB_holo_bdd : HolomorphicOn B (Metric.ball (0 : ℂ) 1) ∧
      ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖B z‖ ≤ 1 := by
    rcases hB with ⟨k, N, a, ha, hBeq⟩ | ⟨k, a, ha, hsum, hBeq⟩
    · have hfin := RudinRCA.Chapter15.finite_blaschke_product k N a ha
      have hB0_holo : HolomorphicOn (fun z ↦ z ^ k * ∏ i : Fin N,
          RudinRCA.Chapter15.blaschkeFactor (a i) z) (Metric.ball (0 : ℂ) 1) :=
        (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hfin.2.2.1
      refine ⟨fun z hz ↦ (hB0_holo z hz).congr_of_eventuallyEq
          (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz) fun w hw ↦ hBeq w hw),
        fun z hz ↦ ?_⟩
      rw [hBeq z hz]
      exact hfin.2.2.2.1 z hz
    · have hinf := RudinRCA.Chapter15.theorem15_21 k ha hsum
      have hB0_holo : HolomorphicOn (fun z ↦ z ^ k * ∏' n,
          RudinRCA.Chapter15.blaschkeFactor (a n) z) (Metric.ball (0 : ℂ) 1) :=
        (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hinf.2.2.2.2.1
      refine ⟨fun z hz ↦ (hB0_holo z hz).congr_of_eventuallyEq
          (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz) fun w hw ↦ hBeq w hw),
        fun z hz ↦ ?_⟩
      rw [hBeq z hz]
      exact (hinf.2.2.2.2.2.1 z hz).2
  refine ⟨hB_holo_bdd.1, hB_holo_bdd.2, ?_⟩
  obtain ⟨_, ⟨BStar, _, _, _, hae_vol⟩, _⟩ := RudinRCA.Chapter15.theorem15_24 hB
  refine ae_circleMeasure_of_ae_volume ?_
  filter_upwards [hae_vol] with θ ⟨hnorm, hlim⟩
  have hlim' : Tendsto (fun r : ℝ ↦ radialSlice B r (θ : FourierCircle))
      (𝓝[<] 1) (𝓝 (BStar θ)) := hlim
  rw [radialBoundaryLimit_eq_of_tendsto hlim']
  exact hnorm

theorem holomorphicOn_outerFunction {c : ℂ} {φ : FourierCircle → ℝ}
    (hlog : Integrable (fun ζ ↦ Real.log (φ ζ)) circleMeasure) :
    HolomorphicOn (outerFunction c φ) (Metric.ball (0 : ℂ) 1) := by
  have hlogC : Integrable (fun ζ ↦ (Real.log (φ ζ) : ℂ)) circleMeasure :=
    Complex.ofRealCLM.integrable_comp hlog
  have hh := holomorphicOn_herglotzTransform hlogC
  intro z hz
  have hd : DifferentiableAt ℂ (fun w ↦ c * Complex.exp (herglotzTransform
      (fun ζ ↦ (Real.log (φ ζ) : ℂ)) w)) z :=
    (differentiableAt_const c).mul (hh z hz).cexp
  refine hd.congr_of_eventuallyEq ?_
  filter_upwards [Metric.isOpen_ball.mem_nhds hz] with w hw
  exact outerFunction_apply_of_mem c φ hw

theorem outerFunction_ne_zero {c : ℂ} (hc : c ≠ 0) (φ : FourierCircle → ℝ)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    outerFunction c φ z ≠ 0 := by
  rw [outerFunction_apply_of_mem c φ hz]
  exact mul_ne_zero hc (Complex.exp_ne_zero _)

/-- **Theorem 17.14 (Basic Properties of Inner and Outer Functions, RCA p. 342):**
1. Unit-modulus constants and Blaschke products are inner functions, and inner functions are
   closed under pointwise multiplication;
2. Every outer function is holomorphic and zero-free throughout `U = Metric.ball 0 1`. -/
theorem theorem17_14 :
    (∀ c : ℂ, ‖c‖ = 1 → IsInnerFunction (fun _ ↦ c)) ∧
    (∀ {B : ℂ → ℂ}, RudinRCA.Chapter15.IsBlaschkeProduct B → IsInnerFunction B) ∧
    (∀ {M₁ M₂ : ℂ → ℂ}, IsInnerFunction M₁ → IsInnerFunction M₂ →
      IsInnerFunction (fun z ↦ M₁ z * M₂ z)) ∧
    (∀ {Q : ℂ → ℂ}, IsOuterFunction Q →
      HolomorphicOn Q (Metric.ball (0 : ℂ) 1) ∧ ∀ z ∈ Metric.ball (0 : ℂ) 1, Q z ≠ 0) := by
  refine ⟨fun c hc ↦ isInnerFunction_const hc,
    fun hB ↦ isInnerFunction_of_isBlaschkeProduct hB,
    fun hM₁ hM₂ ↦ hM₁.mul hM₂, ?_⟩
  rintro Q ⟨c, φ, hc, _, _, hlog, heq⟩
  have hc_ne : c ≠ 0 := norm_ne_zero_iff.mp (hc ▸ one_ne_zero)
  have hholo := holomorphicOn_outerFunction (c := c) hlog
  refine ⟨fun z hz ↦ (hholo z hz).congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz) fun w hw ↦ heq hw),
    fun z hz ↦ heq hz ▸ outerFunction_ne_zero hc_ne φ hz⟩

/-! ### Section 17.16: Properties of Outer Functions for `0 < p ≤ ∞` (RCA p. 343) -/

/-- **17.16(a) (Poisson representation of `log ‖Q z‖` for outer functions, RCA p. 343).** -/
theorem outerFunction_log_norm {c : ℂ} (hc : ‖c‖ = 1) {φ : FourierCircle → ℝ}
    (hlog : Integrable (fun ζ ↦ Real.log (φ ζ)) circleMeasure)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    Real.log ‖outerFunction c φ z‖ =
      ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) * Real.log (φ ζ) ∂circleMeasure := by
  rw [outerFunction_apply_of_mem c φ hz, norm_mul, hc, one_mul, Complex.norm_exp, Real.log_exp]
  have hre := re_herglotzTransform_ofReal hlog hz
  simpa [herglotzTransform, circlePoissonIntegral, smul_eq_mul] using hre

/-- **17.16(b) (Radial boundary modulus of `outerFunction c φ` equals `φ` a.e., RCA p. 343).** -/
theorem outerFunction_ae_tendsto_norm {c : ℂ} (hc : ‖c‖ = 1) {φ : FourierCircle → ℝ}
    (hφ_pos : ∀ᵐ ζ ∂circleMeasure, 0 < φ ζ)
    (hlog : Integrable (fun ζ ↦ Real.log (φ ζ)) circleMeasure) :
    ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ ‖radialSlice (outerFunction c φ) r ζ‖) (𝓝[<] 1) (𝓝 (φ ζ)) := by
  filter_upwards [hφ_pos, ae_tendsto_circlePoissonIntegral hlog] with ζ hpos hlim
  have hexp_lim : Tendsto
      (fun r : ℝ ↦ Real.exp (circlePoissonIntegral (fun η ↦ Real.log (φ η))
        ((r : ℂ) * circlePoint ζ)))
      (𝓝[<] 1) (𝓝 (φ ζ)) := by
    simpa only [Function.comp_def, Real.exp_log hpos] using
      (Real.continuous_exp.tendsto (Real.log (φ ζ))).comp hlim
  refine hexp_lim.congr' ?_
  filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
  have hz : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr.1] using hr.2
  have hc_ne : c ≠ 0 := norm_ne_zero_iff.mp (hc ▸ one_ne_zero)
  have hQ_pos : 0 < ‖outerFunction c φ ((r : ℂ) * circlePoint ζ)‖ :=
    norm_pos_iff.mpr (outerFunction_ne_zero hc_ne φ hz)
  have hlog_eq := outerFunction_log_norm hc hlog hz
  simpa [circlePoissonIntegral, smul_eq_mul, radialSlice, Real.exp_log hQ_pos] using
    congr_arg Real.exp hlog_eq.symm

/-- **17.16(c) (`hardySizeENNReal p (outerFunction c φ) = eLpNorm φ p circleMeasure` and
`IsInHardySpace p Q ↔ MemLp φ p circleMeasure` for ALL `0 < p ≤ ∞`, RCA p. 343).** -/
theorem outerFunction_hardySizeENNReal_eq {c : ℂ} (hc : ‖c‖ = 1) {φ : FourierCircle → ℝ}
    (hφ_meas : AEMeasurable φ circleMeasure)
    (hφ_pos : ∀ᵐ ζ ∂circleMeasure, 0 < φ ζ)
    (hlog : Integrable (fun ζ ↦ Real.log (φ ζ)) circleMeasure)
    {p : ℝ≥0∞} (hp0 : p ≠ 0) :
    hardySizeENNReal p (outerFunction c φ) = MeasureTheory.eLpNorm φ p circleMeasure := by
  let Q := outerFunction c φ
  have hQ_holo : HolomorphicOn Q (Metric.ball (0 : ℂ) 1) := holomorphicOn_outerFunction hlog
  have hrad_lim := outerFunction_ae_tendsto_norm hc hφ_pos hlog
  refine le_antisymm ?_ ?_
  · -- Upper bound: `hardySizeENNReal p Q ≤ eLpNorm φ p circleMeasure`
    by_cases hfin : MeasureTheory.eLpNorm φ p circleMeasure = ⊤
    · rw [hfin]; exact le_top
    have hMemLp : MemLp φ p circleMeasure := lt_top_iff_ne_top.mpr hfin
    rcases eq_or_ne p ⊤ with rfl | hptop
    · -- `p = ⊤`
      let C : ℝ := (MeasureTheory.eLpNorm φ ⊤ circleMeasure).toReal
      have hae_le : ∀ᵐ ζ ∂circleMeasure, φ ζ ≤ C := by
        filter_upwards [ae_le_eLpNormEssSup (f := φ) (μ := circleMeasure)] with ζ hζ
        have h1 : ‖φ ζ‖ₑ ≤ MeasureTheory.eLpNorm φ ⊤ circleMeasure := by
          rwa [eLpNorm_exponent_top hφ_meas.aestronglyMeasurable]
        rw [← ofReal_norm] at h1
        exact (le_abs_self (φ ζ)).trans
          ((ENNReal.ofReal_le_iff_le_toReal hfin).mp h1)
      have hC_pos : 0 < C := by
        obtain ⟨ζ₀, hpos₀, hle₀⟩ := (hφ_pos.and hae_le).exists
        exact hpos₀.trans_le hle₀
      rw [hardySizeENNReal_top_eq_biSup hQ_holo]
      refine iSup₂_le fun z hz ↦ ?_
      have hlog_le : Real.log ‖Q z‖ ≤ Real.log C := by
        rw [outerFunction_log_norm hc hlog hz]
        have hcontP := continuous_poissonKernel_circlePoint hz
        obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn hcontP.continuousOn
        have hint1 : Integrable (fun ζ ↦ _root_.poissonKernel 0 z (circlePoint ζ) *
            Real.log (φ ζ)) circleMeasure := by
          simpa only [mul_comm] using hlog.bdd_mul hcontP.aestronglyMeasurable
            (Eventually.of_forall fun ζ ↦ hB ζ (mem_univ ζ))
        have hint2 : Integrable (fun ζ ↦ _root_.poissonKernel 0 z (circlePoint ζ) *
            Real.log C) circleMeasure := by
          obtain ⟨M, hM⟩ := isCompact_univ.exists_bound_of_continuousOn
            (hcontP.mul continuous_const).continuousOn
          exact Integrable.of_bound (hcontP.mul continuous_const).aestronglyMeasurable M
            (Eventually.of_forall fun ζ ↦ hM ζ (mem_univ ζ))
        have hmono : ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) * Real.log (φ ζ) ∂circleMeasure ≤
            ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) * Real.log C ∂circleMeasure := by
          refine integral_mono_ae hint1 hint2 ?_
          filter_upwards [hφ_pos, hae_le] with ζ hp hl
          exact mul_le_mul_of_nonneg_left (Real.log_le_log hp hl)
            (poissonKernel_circlePoint_nonneg hz ζ)
        have hrhs : ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) * Real.log C ∂circleMeasure =
            Real.log C := by
          rw [integral_mul_const, integral_poissonKernel_circlePoint_eq_one hz, one_mul]
        exact hmono.trans_eq hrhs
      have hc_ne : c ≠ 0 := norm_ne_zero_iff.mp (hc ▸ one_ne_zero)
      have hQ_pos : 0 < ‖Q z‖ := norm_pos_iff.mpr (outerFunction_ne_zero hc_ne φ hz)
      have hnorm_le : ‖Q z‖ ≤ C := by
        rw [← Real.exp_log hQ_pos, ← Real.exp_log hC_pos]
        exact Real.exp_le_exp.mpr hlog_le
      rw [← ofReal_norm]
      exact (ENNReal.ofReal_le_ofReal hnorm_le).trans_eq (ENNReal.ofReal_toReal hfin)
    · -- `0 < p < ∞`: Jensen with probability measure `P_z(η) dσ(η)` + Tonelli symmetry
      have hq_pos : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
      have hφq_int : Integrable (fun η ↦ ‖φ η‖ ^ p.toReal) circleMeasure :=
        hMemLp.integrable_norm_rpow hp0 hptop
      refine iSup₂_le fun r hr ↦ ?_
      have hcontQ := continuous_radialSlice_of_holomorphicOn hQ_holo hr.1 hr.2
      change radialSizeENNReal p Q r ≤ MeasureTheory.eLpNorm φ p circleMeasure
      rw [radialSizeENNReal, ite_eq_right_iff.mpr fun h ↦ (hp0 h).elim,
        (memLp_circleMeasure_of_continuous hcontQ p).eLpNorm_eq_integral_rpow_norm hp0 hptop,
        hMemLp.eLpNorm_eq_integral_rpow_norm hp0 hptop]
      refine ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow
        (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _) ?_ (inv_nonneg.mpr hq_pos.le))
      -- Pointwise Jensen bound for each `ζ : FourierCircle`
      have hpt_jensen : ∀ ζ : FourierCircle,
          ‖radialSlice Q r ζ‖ ^ p.toReal ≤
            ∫ η, _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) *
              ‖φ η‖ ^ p.toReal ∂circleMeasure := by
        intro ζ
        let z : ℂ := (r : ℂ) * circlePoint ζ
        have hz : z ∈ Metric.ball (0 : ℂ) 1 := by
          simpa [z, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_nonneg hr.1] using hr.2
        let w : FourierCircle → ℝ≥0∞ :=
          fun η ↦ ENNReal.ofReal (_root_.poissonKernel 0 z (circlePoint η))
        have hcontP := continuous_poissonKernel_circlePoint hz
        have hw_meas : Measurable w := ENNReal.measurable_ofReal.comp hcontP.measurable
        let ν : Measure FourierCircle := circleMeasure.withDensity w
        have hν_prob : IsProbabilityMeasure ν := by
          refine ⟨?_⟩
          rw [withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ,
            ← ofReal_integral_eq_lintegral_ofReal]
          · rw [integral_poissonKernel_circlePoint_eq_one hz, ENNReal.ofReal_one]
          · obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn hcontP.continuousOn
            exact Integrable.of_bound hcontP.aestronglyMeasurable B
              (Eventually.of_forall fun η ↦ hB η (mem_univ η))
          · exact Eventually.of_forall fun η ↦ poissonKernel_circlePoint_nonneg hz η
        obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn hcontP.continuousOn
        let u : FourierCircle → ℝ := fun η ↦ p.toReal * Real.log (φ η)
        have hu_int_σ : Integrable (fun η ↦ _root_.poissonKernel 0 z (circlePoint η) * u η)
            circleMeasure := by
          simpa only [mul_comm] using (hlog.const_mul p.toReal).bdd_mul hcontP.aestronglyMeasurable
            (Eventually.of_forall fun η ↦ hB η (mem_univ η))
        have hu_int_ν : Integrable u ν := by
          rw [integrable_withDensity_iff hw_meas
            (Eventually.of_forall fun _ ↦ ENNReal.ofReal_lt_top)]
          refine hu_int_σ.congr (Eventually.of_forall fun η ↦ ?_)
          dsimp only [w]
          rw [ENNReal.toReal_ofReal (poissonKernel_circlePoint_nonneg hz η), mul_comm]
        have hexp_ae_σ : (fun η ↦ Real.exp (u η)) =ᵐ[circleMeasure]
            (fun η ↦ ‖φ η‖ ^ p.toReal) := by
          filter_upwards [hφ_pos] with η hpos
          dsimp only [u]
          rw [Real.norm_of_nonneg hpos.le, Real.rpow_def_of_pos hpos, mul_comm]
        have hexp_int_σ : Integrable
            (fun η ↦ _root_.poissonKernel 0 z (circlePoint η) * Real.exp (u η)) circleMeasure := by
          have hi : Integrable
              (fun η ↦ _root_.poissonKernel 0 z (circlePoint η) * ‖φ η‖ ^ p.toReal)
              circleMeasure := by
            simpa only [mul_comm] using hφq_int.bdd_mul hcontP.aestronglyMeasurable
              (Eventually.of_forall fun η ↦ hB η (mem_univ η))
          exact hi.congr (hexp_ae_σ.symm.mono fun η hη ↦ congr_arg (_ * ·) hη)
        have hexp_int_ν : Integrable (fun η ↦ Real.exp (u η)) ν := by
          rw [integrable_withDensity_iff hw_meas
            (Eventually.of_forall fun _ ↦ ENNReal.ofReal_lt_top)]
          refine hexp_int_σ.congr (Eventually.of_forall fun η ↦ ?_)
          dsimp only [w]
          rw [ENNReal.toReal_ofReal (poissonKernel_circlePoint_nonneg hz η), mul_comm]
        have hjensen := convexOn_exp.map_integral_le Real.continuous_exp.continuousOn
          isClosed_univ (Eventually.of_forall fun _ ↦ mem_univ _) hu_int_ν hexp_int_ν
        have hlhs_eq : Real.exp (∫ η, u η ∂ν) = ‖radialSlice Q r ζ‖ ^ p.toReal := by
          rw [integral_withDensity_eq_integral_toReal_smul hw_meas
            (Eventually.of_forall fun _ ↦ ENNReal.ofReal_lt_top)]
          have h1 : (∫ η, (w η).toReal • u η ∂circleMeasure) =
              p.toReal * Real.log ‖Q z‖ := by
            rw [outerFunction_log_norm hc hlog hz, ← integral_const_mul]
            refine integral_congr_ae (Eventually.of_forall fun η ↦ ?_)
            dsimp only [w, u]
            rw [ENNReal.toReal_ofReal (poissonKernel_circlePoint_nonneg hz η), smul_eq_mul]
            ring
          have hc_ne : c ≠ 0 := norm_ne_zero_iff.mp (hc ▸ one_ne_zero)
          have hQz_pos : 0 < ‖Q z‖ := norm_pos_iff.mpr (outerFunction_ne_zero hc_ne φ hz)
          rw [h1, mul_comm, ← Real.rpow_def_of_pos hQz_pos]
          rfl
        have hrhs_eq : (∫ η, Real.exp (u η) ∂ν) =
            ∫ η, _root_.poissonKernel 0 z (circlePoint η) * ‖φ η‖ ^ p.toReal ∂circleMeasure := by
          rw [integral_withDensity_eq_integral_toReal_smul hw_meas
            (Eventually.of_forall fun _ ↦ ENNReal.ofReal_lt_top)]
          refine integral_congr_ae (hexp_ae_σ.mono fun η hη ↦ ?_)
          dsimp only [w]
          rw [ENNReal.toReal_ofReal (poissonKernel_circlePoint_nonneg hz η), smul_eq_mul]
          exact congr_arg (_ * ·) hη
        rwa [hlhs_eq, hrhs_eq] at hjensen
      -- Integrate `hpt_jensen` over `ζ : FourierCircle` and swap integrals
      have hQr_int : Integrable (fun ζ ↦ ‖radialSlice Q r ζ‖ ^ p.toReal) circleMeasure := by
        have hc_rpow : Continuous (fun ζ ↦ ‖radialSlice Q r ζ‖ ^ p.toReal) :=
          hcontQ.norm.rpow_const fun _ ↦ Or.inr hq_pos.le
        obtain ⟨M, hM⟩ := isCompact_univ.exists_bound_of_continuousOn hc_rpow.continuousOn
        exact Integrable.of_bound hc_rpow.aestronglyMeasurable M
          (Eventually.of_forall fun ζ ↦ hM ζ (mem_univ ζ))
      have hker_joint_cont : Continuous (fun p_pair : FourierCircle × FourierCircle ↦
          _root_.poissonKernel 0 ((r : ℂ) * circlePoint p_pair.1) (circlePoint p_pair.2)) := by
        simp_rw [poissonKernel_circlePoint_formula]
        refine Continuous.div (by fun_prop) (by fun_prop) fun p_pair ↦ ?_
        have hlt : ‖(r : ℂ) * circlePoint p_pair.1‖ < 1 := by
          simpa [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr.1] using hr.2
        have hne : circlePoint p_pair.2 - (r : ℂ) * circlePoint p_pair.1 ≠ 0 := by
          intro h0
          have heq := sub_eq_zero.mp h0
          rw [← heq, norm_circlePoint] at hlt
          exact lt_irrefl 1 hlt
        exact pow_ne_zero 2 (norm_ne_zero_iff.mpr hne)
      obtain ⟨K_r, hK_r⟩ := isCompact_univ.exists_bound_of_continuousOn hker_joint_cont.continuousOn
      have hprod_int : Integrable (Function.uncurry fun ζ η : FourierCircle ↦
          _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) * ‖φ η‖ ^ p.toReal)
          (circleMeasure.prod circleMeasure) := by
        have hsnd : Integrable (fun p_pair : FourierCircle × FourierCircle ↦ ‖φ p_pair.2‖ ^ p.toReal)
            (circleMeasure.prod circleMeasure) :=
          hφq_int.comp_snd circleMeasure
        exact hsnd.bdd_mul hker_joint_cont.aestronglyMeasurable
          (Eventually.of_forall fun p_pair ↦ hK_r p_pair (mem_univ p_pair))
      have hrhs_int : Integrable (fun ζ ↦ ∫ η,
          _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) *
            ‖φ η‖ ^ p.toReal ∂circleMeasure) circleMeasure :=
        hprod_int.integral_prod_left
      calc ∫ ζ, ‖radialSlice Q r ζ‖ ^ p.toReal ∂circleMeasure
          ≤ ∫ ζ, (∫ η, _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) *
              ‖φ η‖ ^ p.toReal ∂circleMeasure) ∂circleMeasure :=
            integral_mono hQr_int hrhs_int hpt_jensen
        _ = ∫ η, (∫ ζ, _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) *
              ‖φ η‖ ^ p.toReal ∂circleMeasure) ∂circleMeasure :=
            integral_integral_swap hprod_int
        _ = ∫ η, ‖φ η‖ ^ p.toReal ∂circleMeasure := by
            refine integral_congr_ae (Eventually.of_forall fun η ↦ ?_)
            dsimp only
            have hsym : (∫ ζ, _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) *
                ‖φ η‖ ^ p.toReal ∂circleMeasure) =
                (∫ ζ, _root_.poissonKernel 0 ((r : ℂ) * circlePoint η) (circlePoint ζ)
                  ∂circleMeasure) * ‖φ η‖ ^ p.toReal := by
              rw [← integral_mul_const]
              refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
              dsimp only
              rw [poissonKernel_circlePoint_symm]
            have hz_η : (r : ℂ) * circlePoint η ∈ Metric.ball (0 : ℂ) 1 := by
              simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
                abs_of_nonneg hr.1] using hr.2
            rw [hsym, integral_poissonKernel_circlePoint_eq_one hz_η, one_mul]
  · -- Lower bound: `eLpNorm φ p circleMeasure ≤ hardySizeENNReal p Q`
    by_cases hMtop : hardySizeENNReal p Q = ⊤
    · rw [hMtop]; exact le_top
    rcases eq_or_ne p ⊤ with rfl | hptop
    · -- `p = ⊤`
      let M : ℝ := (hardySizeENNReal ⊤ Q).toReal
      have hQz_le : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖Q z‖ ≤ M := by
        intro z hz
        have hle : ‖Q z‖ₑ ≤ hardySizeENNReal ⊤ Q := by
          rw [hardySizeENNReal_top_eq_biSup hQ_holo]
          exact le_biSup (fun w ↦ ‖Q w‖ₑ) hz
        rw [← ofReal_norm] at hle
        exact (ENNReal.ofReal_le_iff_le_toReal hMtop).mp hle
      have hae_le : ∀ᵐ ζ ∂circleMeasure, ‖φ ζ‖ ≤ M := by
        filter_upwards [hφ_pos, hrad_lim] with ζ hpos hlim
        rw [Real.norm_of_nonneg hpos.le]
        refine le_of_tendsto hlim ?_
        filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
        refine hQz_le _ ?_
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hr.1] using hr.2
      have hle := eLpNorm_le_of_ae_bound (p := ⊤) (μ := circleMeasure)
        hφ_meas.aestronglyMeasurable hae_le
      simpa [M, ENNReal.ofReal_toReal hMtop] using hle
    · -- `0 < p < ∞`: Fatou's lemma along `r_n = 1 - 1 / (n + 2)`
      have hq_pos : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
      let r_seq : ℕ → ℝ := fun n ↦ 1 - 1 / ((n : ℝ) + 2)
      have hr_mem : ∀ n : ℕ, r_seq n ∈ Set.Ioo (0 : ℝ) 1 := fun n ↦ by
        dsimp [r_seq]
        have hn : (1 : ℝ) < (n : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) n]
        refine ⟨by linarith [div_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2) |>.mpr hn],
          by linarith [div_pos zero_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2)]⟩
      have hr_tendsto : Tendsto r_seq atTop (𝓝[<] 1) := by
        refine tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ ?_
          (Eventually.of_forall fun n ↦ (hr_mem n).2)
        have hdiv : Tendsto (fun n : ℕ ↦ (1 : ℝ) / ((n : ℝ) + 2)) atTop (𝓝 0) :=
          tendsto_const_nhds.div_atTop
            ((tendsto_natCast_atTop_atTop (R := ℝ)).atTop_add tendsto_const_nhds)
        simpa [r_seq] using (tendsto_const_nhds (x := (1 : ℝ))).sub hdiv
      have hmeas_n : ∀ n : ℕ, AEMeasurable
          (fun ζ ↦ ‖radialSlice Q (r_seq n) ζ‖ₑ ^ p.toReal) circleMeasure := fun n ↦ by
        have hcont := continuous_radialSlice_of_holomorphicOn hQ_holo
          (hr_mem n).1.le (hr_mem n).2
        exact (ENNReal.continuous_rpow_const.comp
          (ENNReal.continuous_coe.comp hcont.nnnorm)).measurable.aemeasurable
      have hfatou := lintegral_liminf_le' (u := atTop) hmeas_n
      have hae_liminf : ∀ᵐ ζ ∂circleMeasure,
          ‖φ ζ‖ₑ ^ p.toReal ≤
            Filter.liminf (fun n : ℕ ↦ ‖radialSlice Q (r_seq n) ζ‖ₑ ^ p.toReal) atTop := by
        filter_upwards [hφ_pos, hrad_lim] with ζ hpos hlim
        have hnorm_φ : ENNReal.ofReal (φ ζ) = ‖φ ζ‖ₑ := by
          rw [← ofReal_norm, Real.norm_of_nonneg hpos.le]
        have hseq : Tendsto (fun n : ℕ ↦ ‖radialSlice Q (r_seq n) ζ‖ₑ ^ p.toReal)
            atTop (𝓝 (‖φ ζ‖ₑ ^ p.toReal)) := by
          have h1 : Tendsto (fun n : ℕ ↦ ENNReal.ofReal ‖radialSlice Q (r_seq n) ζ‖)
              atTop (𝓝 (ENNReal.ofReal (φ ζ))) :=
            ENNReal.continuous_ofReal.continuousAt.tendsto.comp (hlim.comp hr_tendsto)
          have h2 := (ENNReal.continuous_rpow_const (y := p.toReal)).continuousAt.tendsto.comp h1
          rw [hnorm_φ] at h2
          exact h2.congr' (Eventually.of_forall fun n ↦ by simp [ofReal_norm])
        rw [← hseq.liminf_eq]
      have hlint_le : (∫⁻ ζ, ‖φ ζ‖ₑ ^ p.toReal ∂circleMeasure) ≤
          (hardySizeENNReal p Q) ^ p.toReal := by
        calc (∫⁻ ζ, ‖φ ζ‖ₑ ^ p.toReal ∂circleMeasure)
            ≤ ∫⁻ ζ, Filter.liminf (fun n : ℕ ↦ ‖radialSlice Q (r_seq n) ζ‖ₑ ^ p.toReal) atTop
                ∂circleMeasure := lintegral_mono_ae hae_liminf
          _ ≤ Filter.liminf (fun n : ℕ ↦ ∫⁻ ζ, ‖radialSlice Q (r_seq n) ζ‖ₑ ^ p.toReal
                ∂circleMeasure) atTop := hfatou
          _ ≤ (hardySizeENNReal p Q) ^ p.toReal := by
              refine liminf_le_of_frequently_le' (Frequently.of_forall fun n ↦ ?_)
              have hle_n : MeasureTheory.eLpNorm (radialSlice Q (r_seq n)) p circleMeasure ≤
                  hardySizeENNReal p Q := by
                have hmem : r_seq n ∈ Set.Ico (0 : ℝ) 1 := ⟨(hr_mem n).1.le, (hr_mem n).2⟩
                have hbi : radialSizeENNReal p Q (r_seq n) ≤ hardySizeENNReal p Q :=
                  le_biSup (radialSizeENNReal p Q) hmem
                rwa [radialSizeENNReal, ite_eq_right_iff.mpr fun h ↦ (hp0 h).elim] at hbi
              have heq_n := eLpNorm_eq_lintegral_rpow_enorm_toReal (μ := circleMeasure)
                (f := radialSlice Q (r_seq n)) hp0 hptop
                (continuous_radialSlice_of_holomorphicOn hQ_holo
                  (hr_mem n).1.le (hr_mem n).2).aestronglyMeasurable
              have hrpow := ENNReal.rpow_le_rpow hle_n hq_pos.le
              rw [heq_n, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq_pos.ne',
                ENNReal.rpow_one] at hrpow
              exact hrpow
      rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop hφ_meas.aestronglyMeasurable, one_div]
      have hrpow := ENNReal.rpow_le_rpow hlint_le (inv_nonneg.mpr hq_pos.le)
      rwa [← ENNReal.rpow_mul, mul_inv_cancel₀ hq_pos.ne', ENNReal.rpow_one] at hrpow

/-- **Theorem 17.16 (Properties of Outer Functions for `0 < p ≤ ∞`, RCA p. 343):**
Let `‖c‖ = 1`, `φ : T → ℝ` be `circleMeasure`-a.e. measurable and `> 0` a.e. with
`log ∘ φ ∈ L¹(T)`, and `Q = outerFunction c φ`. Then:
- `(a)` `log ‖Q z‖` is the Poisson integral of `log ∘ φ` for every `z ∈ U = Metric.ball 0 1`;
- `(b)` `‖Q(r ζ)‖ → φ(ζ)` as `r → 1⁻` for `circleMeasure`-almost every `ζ ∈ T`;
- `(c)` For EVERY `0 < p ≤ ∞` (`p : ℝ≥0∞`, `p ≠ 0`, `∞` explicitly included per `SCOPING-G.md`
  Caution 7), `Q ∈ H^p ↔ φ ∈ L^p(T)`, and `‖Q‖_p = ‖φ‖_{L^p(T)}`. -/
theorem theorem17_16 {c : ℂ} (hc : ‖c‖ = 1) {φ : FourierCircle → ℝ}
    (hφ_meas : AEMeasurable φ circleMeasure)
    (hφ_pos : ∀ᵐ ζ ∂circleMeasure, 0 < φ ζ)
    (hlog : Integrable (fun ζ ↦ Real.log (φ ζ)) circleMeasure) :
    let Q := outerFunction c φ
    (∀ z ∈ Metric.ball (0 : ℂ) 1,
      Real.log ‖Q z‖ =
        ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) * Real.log (φ ζ) ∂circleMeasure) ∧
    (∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ ‖radialSlice Q r ζ‖) (𝓝[<] 1) (𝓝 (φ ζ))) ∧
    (∀ p : ℝ≥0∞, p ≠ 0 →
      (IsInHardySpace p Q ↔ MemLp φ p circleMeasure) ∧
      hardySizeENNReal p Q = MeasureTheory.eLpNorm φ p circleMeasure ∧
      hardySize p Q = (MeasureTheory.eLpNorm φ p circleMeasure).toReal) := by
  refine ⟨fun z hz ↦ outerFunction_log_norm hc hlog hz,
    outerFunction_ae_tendsto_norm hc hφ_pos hlog, ?_⟩
  intro p hp0
  have heq := outerFunction_hardySizeENNReal_eq hc hφ_meas hφ_pos hlog hp0
  refine ⟨?_, heq, congr_arg ENNReal.toReal heq⟩
  constructor
  · rintro ⟨_, _, hlt⟩
    rwa [memLp_iff, ← heq]
  · intro hmem
    exact ⟨hp0, holomorphicOn_outerFunction hlog, heq.symm ▸ hmem⟩

/-! ### Section 17.15: Holomorphic Logarithm, Positive Measure Herglotz, Singular Measures,
and Characterization of Inner Functions (RCA pp. 342–343) -/

private theorem holomorphic_re_zero_is_const_ball {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1))
    (hre : ∀ z ∈ Metric.ball (0 : ℂ) 1, (f z).re = 0)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    f z = f 0 := by
  have hdiff : DifferentiableOn ℂ f (Metric.ball (0 : ℂ) 1) :=
    (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hf
  refine Metric.isOpen_ball.is_const_of_deriv_eq_zero (convex_ball (0 : ℂ) 1).isPreconnected
    hdiff (fun a ha ↦ ?_) hz (Metric.mem_ball_self zero_lt_one)
  obtain ⟨hdr, hcr⟩ := differentiableAt_complex_iff_differentiableAt_real.mp (hf a ha)
  rw [complexOfReal_deriv hdr hcr]
  have hre_fderiv : HasFDerivAt (fun x : ℂ ↦ (f x).re)
      (Complex.reCLM.comp (fderiv ℝ f a)) a :=
    Complex.reCLM.hasFDerivAt.comp a hdr.hasFDerivAt
  have hre_zero : HasFDerivAt (fun x : ℂ ↦ (f x).re) (0 : ℂ →L[ℝ] ℝ) a := by
    refine (hasFDerivAt_const (0 : ℝ) a).congr_of_eventuallyEq ?_
    filter_upwards [Metric.isOpen_ball.mem_nhds ha] with x hx
    exact hre x hx
  have hclm_eq : Complex.reCLM.comp (fderiv ℝ f a) = 0 := hre_fderiv.unique hre_zero
  have h1_re : (fderiv ℝ f a 1).re = 0 := by
    simpa using ContinuousLinearMap.ext_iff.mp hclm_eq 1
  have hI_re : (fderiv ℝ f a Complex.I).re = 0 := by
    simpa using ContinuousLinearMap.ext_iff.mp hclm_eq Complex.I
  rw [hcr] at hI_re
  have h1_im : (fderiv ℝ f a 1).im = 0 := by
    have : -(fderiv ℝ f a 1).im = 0 := by simpa [smul_eq_mul, Complex.mul_re] using hI_re
    linarith
  exact Complex.ext h1_re h1_im

/-- Holomorphic logarithm on `Metric.ball 0 1` for any zero-free holomorphic function `g`. -/
theorem exists_holomorphic_log_ball {g : ℂ → ℂ}
    (hg : HolomorphicOn g (Metric.ball (0 : ℂ) 1))
    (hne : ∀ z ∈ Metric.ball (0 : ℂ) 1, g z ≠ 0) :
    ∃ L : ℂ → ℂ, HolomorphicOn L (Metric.ball (0 : ℂ) 1) ∧
      ∀ z ∈ Metric.ball (0 : ℂ) 1, g z = Complex.exp (L z) := by
  have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
  have hderiv_holo : HolomorphicOn (deriv g) (Metric.ball (0 : ℂ) 1) :=
    RudinRCA.Chapter10.holomorphicOn_deriv Metric.isOpen_ball hg
  have hquot_holo : HolomorphicOn (fun z ↦ deriv g z / g z) (Metric.ball (0 : ℂ) 1) :=
    fun z hz ↦ (hderiv_holo z hz).div (hg z hz) (hne z hz)
  obtain ⟨⟨F, hF_holo, hF_deriv⟩, _⟩ := RudinRCA.Chapter10.theorem10_14
    Metric.isOpen_ball (convex_ball (0 : ℂ) 1) 0
    (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hquot_holo)
    (fun z hz ↦ hquot_holo z hz.1)
  let c : ℂ := Complex.log (g 0) - F 0
  let L : ℂ → ℂ := fun z ↦ F z + c
  have hL_holo : HolomorphicOn L (Metric.ball (0 : ℂ) 1) :=
    fun z hz ↦ (hF_holo z hz).add (differentiableAt_const c)
  refine ⟨L, hL_holo, ?_⟩
  let q : ℂ → ℂ := fun z ↦ g z * Complex.exp (-L z)
  have hq_diff : DifferentiableOn ℂ q (Metric.ball (0 : ℂ) 1) := by
    refine (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp fun z hz ↦ ?_
    exact (hg z hz).mul (hL_holo z hz).neg.cexp
  have hq_deriv_zero : ∀ z ∈ Metric.ball (0 : ℂ) 1, deriv q z = 0 := by
    intro z hz
    have hdL : HasDerivAt L (deriv g z / g z) z := by
      simpa [L] using (hF_holo z hz).hasDerivAt.add_const c |>.congr_deriv (by simp [hF_deriv z hz])
    have hdexp : HasDerivAt (fun w ↦ Complex.exp (-L w))
        (-(deriv g z / g z) * Complex.exp (-L z)) z := by
      simpa [mul_comm] using hdL.neg.cexp
    have hdq : HasDerivAt q
        (deriv g z * Complex.exp (-L z) + g z * (-(deriv g z / g z) * Complex.exp (-L z))) z :=
      (hg z hz).hasDerivAt.mul hdexp
    rw [hdq.deriv]
    have hgz := hne z hz
    field_simp [hgz]
    ring
  have hq_const : ∀ z ∈ Metric.ball (0 : ℂ) 1, q z = q 0 := fun z hz ↦
    Metric.isOpen_ball.is_const_of_deriv_eq_zero (convex_ball (0 : ℂ) 1).isPreconnected
      hq_diff hq_deriv_zero hz h0_mem
  have hq0 : q 0 = 1 := by
    dsimp [q, L, c]
    have hsimp : -(F 0 + (Complex.log (g 0) - F 0)) = -Complex.log (g 0) := by ring
    rw [hsimp, Complex.exp_neg, Complex.exp_log (hne 0 h0_mem), mul_inv_cancel₀ (hne 0 h0_mem)]
  intro z hz
  have hz1 : g z * Complex.exp (-L z) = 1 := (hq_const z hz).trans hq0
  calc g z = (g z * Complex.exp (-L z)) * Complex.exp (L z) := by
        rw [mul_assoc, ← Complex.exp_add, neg_add_cancel, Complex.exp_zero, mul_one]
    _ = Complex.exp (L z) := by rw [hz1, one_mul]

/-- Herglotz formula on `Metric.ball 0 1` for radial dilations `z ↦ L ((r : ℂ) * z)` (`0 ≤ r < 1`)
of any holomorphic function `L` on `Metric.ball 0 1`. -/
theorem holomorphic_herglotz_radial {L : ℂ → ℂ}
    (hL : HolomorphicOn L (Metric.ball (0 : ℂ) 1))
    {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    L ((r : ℂ) * z) = ((L 0).im : ℂ) * Complex.I +
      herglotzTransform (fun ζ ↦ ((L ((r : ℂ) * circlePoint ζ)).re : ℂ)) z := by
  have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
  let u_r : FourierCircle → ℝ := fun ζ ↦ (L ((r : ℂ) * circlePoint ζ)).re
  have hL_cont : ContinuousOn L (Metric.ball (0 : ℂ) 1) :=
    RudinRCA.Chapter10.continuousOn_of_holomorphicOn hL
  have hu_cont : Continuous u_r := by
    refine Complex.continuous_re.comp (hL_cont.comp_continuous
      (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_)
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0]
      using hr1
  have hu_int : Integrable u_r circleMeasure :=
    (memLp_circleMeasure_of_continuous hu_cont 1).integrable le_rfl
  have huC_int : Integrable (fun ζ ↦ (u_r ζ : ℂ)) circleMeasure :=
    Complex.ofRealCLM.integrable_comp hu_int
  let LHS : ℂ → ℂ := fun w ↦ L ((r : ℂ) * w)
  let RHS : ℂ → ℂ := fun w ↦ ((L 0).im : ℂ) * Complex.I +
    herglotzTransform (fun ζ ↦ (u_r ζ : ℂ)) w
  have hLHS_holo : HolomorphicOn LHS (Metric.ball (0 : ℂ) 1) := by
    intro w hw
    have hrw : (r : ℂ) * w ∈ Metric.ball (0 : ℂ) 1 := by
      have hw1 : ‖w‖ < 1 := by simpa [Metric.mem_ball] using hw
      have hlt : r * ‖w‖ < 1 := by nlinarith [norm_nonneg w]
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0]
        using hlt
    exact (hL _ hrw).comp w ((differentiableAt_id).const_mul (r : ℂ))
  have hLHS_dcc : DiffContOnCl ℂ LHS (Metric.ball (0 : ℂ) 1) := by
    refine ⟨fun w hw ↦ (hLHS_holo w hw).differentiableWithinAt, ?_⟩
    rw [closure_ball 0 one_ne_zero]
    refine hL_cont.comp (continuous_const.mul continuous_id).continuousOn fun w hw ↦ ?_
    have hw1 : ‖w‖ ≤ 1 := by simpa [Metric.mem_closedBall] using hw
    have hlt : r * ‖w‖ < 1 := by nlinarith [norm_nonneg w]
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0]
      using hlt
  have hRHS_holo : HolomorphicOn RHS (Metric.ball (0 : ℂ) 1) :=
    fun w hw ↦ (differentiableAt_const _).add (holomorphicOn_herglotzTransform huC_int w hw)
  have hre_eq : ∀ w ∈ Metric.ball (0 : ℂ) 1, (LHS w - RHS w).re = 0 := by
    intro w hw
    have hw_lt : ‖w‖ < 1 := mem_ball_zero_iff.mp hw
    have hrhs_re : (RHS w).re = circlePoissonIntegral u_r w := by
      change (((L 0).im : ℂ) * Complex.I + herglotzTransform (fun ζ ↦ (u_r ζ : ℂ)) w).re = _
      rw [Complex.add_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re,
        Complex.I_im, mul_zero, zero_mul, sub_self, zero_add]
      exact re_herglotzTransform_ofReal hu_int hw
    have hpif := congr_arg Complex.re (hLHS_dcc.circleAverage_re_herglotzRieszKernel_smul' hw)
    have hci : CircleIntegrable (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re • LHS ξ) 0 1 := by
      have hw_not : w ∉ Metric.sphere (0 : ℂ) |(1 : ℝ)| := by
        rw [abs_of_pos zero_lt_one, Metric.mem_sphere, dist_zero_right]
        exact hw_lt.ne
      have hck := Complex.continuous_re.comp_continuousOn
        (continuousOn_herglotzRieszKernel_sphere hw_not)
      rw [abs_of_pos zero_lt_one] at hck
      have hck' : ContinuousOn (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re) (Metric.sphere 0 1) := by
        simpa [Function.comp_def, herglotzRieszKernel_def] using hck
      have hLHS_sph : ContinuousOn LHS (Metric.sphere 0 1) :=
        hLHS_dcc.2.mono (by rw [closure_ball 0 one_ne_zero]; exact Metric.sphere_subset_closedBall)
      exact (hck'.smul hLHS_sph).circleIntegrable zero_le_one
    have hcomm := (Complex.reCLM.circleAverage_comp_comm hci).trans
      (by simpa [sub_zero] using hpif)
    have hca : circlePoissonIntegral u_r w =
        Real.circleAverage (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re • (LHS ξ).re) 0 1 := by
      unfold circlePoissonIntegral
      simp_rw [poissonKernel_eq_re_herglotz w]
      simpa [u_r, LHS, radialSlice] using
        integral_radialSlice_eq_circleAverage
          (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re • (LHS ξ).re) 1
    have hca2 : Real.circleAverage (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re • (LHS ξ).re) 0 1 =
        (LHS w).re :=
      (Real.circleAverage_congr_sphere fun ξ _ ↦ by simp [Complex.real_smul]).trans hcomm
    rw [Complex.sub_re, hrhs_re, hca, hca2, sub_self]
  have hconst := holomorphic_re_zero_is_const_ball
    (fun w hw ↦ (hLHS_holo w hw).sub (hRHS_holo w hw)) hre_eq hz
  have h0_eq : LHS 0 - RHS 0 = 0 := by
    have hre0 : (LHS 0 - RHS 0).re = 0 := hre_eq 0 h0_mem
    have him0 : (LHS 0 - RHS 0).im = 0 := by
      have hint_im : (herglotzTransform (fun ζ ↦ (u_r ζ : ℂ)) 0).im = 0 := by
        unfold herglotzTransform
        have hker0 : (fun ζ : FourierCircle ↦
            ((circlePoint ζ + 0) / (circlePoint ζ - 0)) * (u_r ζ : ℂ)) =
            fun ζ ↦ (u_r ζ : ℂ) := by
          ext ζ
          rw [add_zero, sub_zero, div_self (circlePoint_ne_zero ζ), one_mul]
        have hof : (∫ ζ, (u_r ζ : ℂ) ∂circleMeasure) = ((∫ ζ, u_r ζ ∂circleMeasure : ℝ) : ℂ) :=
          Complex.ofRealCLM.integral_comp_comm hu_int
        rw [hker0, hof]
        exact Complex.ofReal_im _
      change (L ((r : ℂ) * 0) -
        (((L 0).im : ℂ) * Complex.I + herglotzTransform (fun ζ ↦ (u_r ζ : ℂ)) 0)).im = 0
      rw [Complex.sub_im, Complex.add_im, hint_im]
      simp
    exact Complex.ext hre0 him0
  exact sub_eq_zero.mp (hconst.trans h0_eq)

/-- Sequential Banach–Alaoglu + Positive Riesz–Markov–Kakutani extraction on `FourierCircle`:
from any `L¹`-bounded sequence of nonnegative integrable functions `v_n ≥ 0` on `T`, we extract a
strictly increasing subsequence `φ : ℕ → ℕ` and a finite regular Borel measure `μ` on `T` such that
`∫ h * v_{φ k} dσ → ∫ h dμ` for all continuous `h : T → ℝ` (and `H : T → ℂ`). -/
theorem exists_subseq_measure_of_nonneg_l1_bounded {v : ℕ → FourierCircle → ℝ}
    (hv_int : ∀ n, Integrable (v n) circleMeasure)
    (hv_nn : ∀ n ζ, 0 ≤ v n ζ) {M : ℝ}
    (hv_bdd : ∀ n, ∫ ζ, v n ζ ∂circleMeasure ≤ M) :
    ∃ (φ : ℕ → ℕ) (μ : Measure FourierCircle),
      StrictMono φ ∧ IsFiniteMeasure μ ∧ μ.Regular ∧
      (∀ h : C(FourierCircle, ℝ),
        Tendsto (fun k ↦ ∫ ζ, h ζ * v (φ k) ζ ∂circleMeasure) atTop (𝓝 (∫ ζ, h ζ ∂μ))) ∧
      (∀ H : FourierCircle → ℂ, Continuous H →
        Tendsto (fun k ↦ ∫ ζ, H ζ * (v (φ k) ζ : ℂ) ∂circleMeasure) atTop (𝓝 (∫ ζ, H ζ ∂μ))) := by
  let M' : ℝ := max 0 M
  have hM'_nn : 0 ≤ M' := le_max_left 0 M
  let Λ : ℕ → StrongDual ℝ C(FourierCircle, ℝ) := fun n ↦
    LinearMap.mkContinuous
      { toFun := fun h ↦ ∫ ζ, h ζ * v n ζ ∂circleMeasure
        map_add' := fun h₁ h₂ ↦ by
          have hi₁ : Integrable (fun ζ ↦ h₁ ζ * v n ζ) circleMeasure :=
            (hv_int n).bdd_mul h₁.continuous.aestronglyMeasurable
              (Eventually.of_forall fun ζ ↦ h₁.norm_coe_le_norm ζ)
          have hi₂ : Integrable (fun ζ ↦ h₂ ζ * v n ζ) circleMeasure :=
            (hv_int n).bdd_mul h₂.continuous.aestronglyMeasurable
              (Eventually.of_forall fun ζ ↦ h₂.norm_coe_le_norm ζ)
          simp_rw [ContinuousMap.add_apply, add_mul]
          exact integral_add hi₁ hi₂
        map_smul' := fun c h ↦ by
          simp_rw [ContinuousMap.smul_apply, smul_eq_mul, mul_assoc, RingHom.id_apply]
          exact integral_const_mul c _ }
      M'
      (fun h ↦ by
        have hi : Integrable (fun ζ ↦ ‖h ζ * v n ζ‖) circleMeasure :=
          ((hv_int n).bdd_mul h.continuous.aestronglyMeasurable
            (Eventually.of_forall fun ζ ↦ h.norm_coe_le_norm ζ)).norm
        calc ‖∫ ζ, h ζ * v n ζ ∂circleMeasure‖
            ≤ ∫ ζ, ‖h ζ * v n ζ‖ ∂circleMeasure := norm_integral_le_integral_norm _
          _ ≤ ∫ ζ, ‖h‖ * v n ζ ∂circleMeasure := by
              refine integral_mono hi ((hv_int n).const_mul ‖h‖) fun ζ ↦ ?_
              rw [norm_mul, Real.norm_of_nonneg (hv_nn n ζ)]
              exact mul_le_mul_of_nonneg_right (h.norm_coe_le_norm ζ) (hv_nn n ζ)
          _ = ‖h‖ * ∫ ζ, v n ζ ∂circleMeasure := integral_const_mul ‖h‖ _
          _ ≤ ‖h‖ * M' := mul_le_mul_of_nonneg_left ((hv_bdd n).trans (le_max_right 0 M))
              (norm_nonneg h)
          _ = M' * ‖h‖ := mul_comm _ _)
  have hΛ_norm : ∀ n, ‖Λ n‖ ≤ M' := fun n ↦
    LinearMap.mkContinuous_norm_le _ hM'_nn _
  obtain ⟨φ, Λ_lim, hφ_mono, hΛ_lim, _, _⟩ :=
    RudinRCA.Chapter11.theorem11_29_general (𝕜 := ℝ) (E := C(FourierCircle, ℝ)) hΛ_norm
  have hΛ_mono : ∀ h₁ h₂ : C(FourierCircle, ℝ), h₁ ≤ h₂ → Λ_lim h₁ ≤ Λ_lim h₂ := by
    intro h₁ h₂ hle
    refine le_of_tendsto_of_tendsto (hΛ_lim h₁) (hΛ_lim h₂) (Eventually.of_forall fun k ↦ ?_)
    dsimp [Λ]
    have hi₁ : Integrable (fun ζ ↦ h₁ ζ * v (φ k) ζ) circleMeasure :=
      (hv_int (φ k)).bdd_mul h₁.continuous.aestronglyMeasurable
        (Eventually.of_forall fun ζ ↦ h₁.norm_coe_le_norm ζ)
    have hi₂ : Integrable (fun ζ ↦ h₂ ζ * v (φ k) ζ) circleMeasure :=
      (hv_int (φ k)).bdd_mul h₂.continuous.aestronglyMeasurable
        (Eventually.of_forall fun ζ ↦ h₂.norm_coe_le_norm ζ)
    exact integral_mono hi₁ hi₂ fun ζ ↦ mul_le_mul_of_nonneg_right (hle ζ) (hv_nn (φ k) ζ)
  let Λ_cc : C_c(FourierCircle, ℝ) →ₚ[ℝ] ℝ :=
    { toFun := fun g ↦ Λ_lim g.toContinuousMap
      map_add' := fun g₁ g₂ ↦ Λ_lim.map_add g₁.toContinuousMap g₂.toContinuousMap
      map_smul' := fun c g ↦ Λ_lim.map_smul c g.toContinuousMap
      monotone' := fun g₁ g₂ hle ↦ hΛ_mono g₁.toContinuousMap g₂.toContinuousMap hle }
  let μ : Measure FourierCircle := RealRMK.rieszMeasure Λ_cc
  have hreal : ∀ h : C(FourierCircle, ℝ),
      Tendsto (fun k ↦ ∫ ζ, h ζ * v (φ k) ζ ∂circleMeasure) atTop (𝓝 (∫ ζ, h ζ ∂μ)) := by
    intro h
    let h_cc : C_c(FourierCircle, ℝ) := ⟨h, HasCompactSupport.of_compactSpace h⟩
    have hrmk : ∫ ζ, h ζ ∂μ = Λ_lim h := RealRMK.integral_rieszMeasure Λ_cc h_cc
    rw [hrmk]
    exact hΛ_lim h
  refine ⟨φ, μ, hφ_mono, inferInstance, inferInstance, hreal, fun H hH ↦ ?_⟩
  let H_re : C(FourierCircle, ℝ) := ⟨fun ζ ↦ (H ζ).re, Complex.continuous_re.comp hH⟩
  let H_im : C(FourierCircle, ℝ) := ⟨fun ζ ↦ (H ζ).im, Complex.continuous_im.comp hH⟩
  have hlim_re : Tendsto (fun k ↦ ((∫ ζ, H_re ζ * v (φ k) ζ ∂circleMeasure : ℝ) : ℂ))
      atTop (𝓝 ((∫ ζ, H_re ζ ∂μ : ℝ) : ℂ)) :=
    (Complex.continuous_ofReal.tendsto _).comp (hreal H_re)
  have hlim_im : Tendsto (fun k ↦ ((∫ ζ, H_im ζ * v (φ k) ζ ∂circleMeasure : ℝ) : ℂ) * Complex.I)
      atTop (𝓝 (((∫ ζ, H_im ζ ∂μ : ℝ) : ℂ) * Complex.I)) :=
    ((Complex.continuous_ofReal.tendsto _).comp (hreal H_im)).mul_const Complex.I
  have hsum_lim := hlim_re.add hlim_im
  have hrhs_eq : ((∫ ζ, H_re ζ ∂μ : ℝ) : ℂ) + ((∫ ζ, H_im ζ ∂μ : ℝ) : ℂ) * Complex.I =
      ∫ ζ, H ζ ∂μ := by
    obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn hH.continuousOn
    have hH_int : Integrable H μ :=
      Integrable.of_bound hH.aestronglyMeasurable B
        (Eventually.of_forall fun ζ ↦ hB ζ (mem_univ ζ))
    have hre_int : Integrable (fun ζ ↦ H_re ζ) μ :=
      Complex.reCLM.integrable_comp hH_int
    have him_int : Integrable (fun ζ ↦ H_im ζ) μ :=
      Complex.imCLM.integrable_comp hH_int
    have h1 : ((∫ ζ, H_re ζ ∂μ : ℝ) : ℂ) = ∫ ζ, (H_re ζ : ℂ) ∂μ :=
      (Complex.ofRealCLM.integral_comp_comm hre_int).symm
    have h2 : ((∫ ζ, H_im ζ ∂μ : ℝ) : ℂ) = ∫ ζ, (H_im ζ : ℂ) ∂μ :=
      (Complex.ofRealCLM.integral_comp_comm him_int).symm
    have hreC : Integrable (fun ζ ↦ (H_re ζ : ℂ)) μ := Complex.ofRealCLM.integrable_comp hre_int
    have himC : Integrable (fun ζ ↦ (H_im ζ : ℂ) * Complex.I) μ :=
      (Complex.ofRealCLM.integrable_comp him_int).mul_const Complex.I
    rw [h1, h2, ← integral_mul_const, ← integral_add hreC himC]
    refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
    exact Complex.re_add_im (H ζ)
  rw [hrhs_eq] at hsum_lim
  refine hsum_lim.congr' (Eventually.of_forall fun k ↦ ?_)
  dsimp only
  have hi_re : Integrable (fun ζ ↦ H_re ζ * v (φ k) ζ) circleMeasure :=
    (hv_int (φ k)).bdd_mul H_re.continuous.aestronglyMeasurable
      (Eventually.of_forall fun ζ ↦ H_re.norm_coe_le_norm ζ)
  have hi_im : Integrable (fun ζ ↦ H_im ζ * v (φ k) ζ) circleMeasure :=
    (hv_int (φ k)).bdd_mul H_im.continuous.aestronglyMeasurable
      (Eventually.of_forall fun ζ ↦ H_im.norm_coe_le_norm ζ)
  have h1 : ((∫ ζ, H_re ζ * v (φ k) ζ ∂circleMeasure : ℝ) : ℂ) =
      ∫ ζ, ((H_re ζ * v (φ k) ζ : ℝ) : ℂ) ∂circleMeasure :=
    (Complex.ofRealCLM.integral_comp_comm hi_re).symm
  have h2 : ((∫ ζ, H_im ζ * v (φ k) ζ ∂circleMeasure : ℝ) : ℂ) =
      ∫ ζ, ((H_im ζ * v (φ k) ζ : ℝ) : ℂ) ∂circleMeasure :=
    (Complex.ofRealCLM.integral_comp_comm hi_im).symm
  have hireC : Integrable (fun ζ ↦ ((H_re ζ * v (φ k) ζ : ℝ) : ℂ)) circleMeasure :=
    Complex.ofRealCLM.integrable_comp hi_re
  have hiimC : Integrable (fun ζ ↦ ((H_im ζ * v (φ k) ζ : ℝ) : ℂ) * Complex.I) circleMeasure :=
    (Complex.ofRealCLM.integrable_comp hi_im).mul_const Complex.I
  rw [h1, h2, ← integral_mul_const, ← integral_add hireC hiimC]
  refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
  dsimp [H_re, H_im]
  push_cast
  calc ((H ζ).re * v (φ k) ζ : ℂ) + (H ζ).im * v (φ k) ζ * Complex.I
      = ((H ζ).re + (H ζ).im * Complex.I) * (v (φ k) ζ : ℂ) := by ring
    _ = H ζ * (v (φ k) ζ : ℂ) := by rw [Complex.re_add_im]

/-- **17.15 (Singular inner factor, RCA p. 342):**
`S_μ(z) = exp(- ∫_T ((ζ + z) / (ζ - z)) dμ(ζ))` for a positive Borel measure `μ` on `T`. -/
def singularInnerFactor (μ : Measure RudinRCA.Chapter04.FourierCircle) (z : ℂ) : ℂ :=
  Complex.exp (- ∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ)

theorem holomorphicOn_measureHerglotz (μ : Measure FourierCircle) [IsFiniteMeasure μ] :
    HolomorphicOn (fun z ↦ ∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ)
      (Metric.ball (0 : ℂ) 1) := by
  intro z₀ hz₀
  have hz₀_lt : ‖z₀‖ < 1 := by simpa [Metric.mem_ball] using hz₀
  let ε : ℝ := (1 - ‖z₀‖) / 2
  have hε_pos : 0 < ε := by dsimp [ε]; linarith
  let F : FourierCircle → ℂ → ℂ := fun ζ z ↦ (circlePoint ζ + z) / (circlePoint ζ - z)
  let F' : FourierCircle → ℂ → ℂ := fun ζ z ↦ (2 * circlePoint ζ) / (circlePoint ζ - z) ^ 2
  let bound : FourierCircle → ℝ := fun _ ↦ 2 / ε ^ 2
  have h_ball_sub : ∀ z ∈ Metric.ball z₀ ε, ∀ ζ : FourierCircle,
      ε ≤ ‖circlePoint ζ - z‖ := by
    intro z hz ζ
    have hdist : ‖z - z₀‖ < ε := by simpa [Metric.mem_ball, dist_eq_norm] using hz
    have htri : ‖circlePoint ζ‖ ≤ ‖circlePoint ζ - z‖ + ‖z - z₀‖ + ‖z₀‖ := by
      calc ‖circlePoint ζ‖ = ‖(circlePoint ζ - z) + (z - z₀) + z₀‖ := by ring_nf
        _ ≤ ‖(circlePoint ζ - z) + (z - z₀)‖ + ‖z₀‖ := norm_add_le _ _
        _ ≤ ‖circlePoint ζ - z‖ + ‖z - z₀‖ + ‖z₀‖ := by linarith [norm_add_le (circlePoint ζ - z) (z - z₀)]
    rw [norm_circlePoint] at htri
    dsimp [ε] at hdist ⊢
    linarith
  have hF_meas : ∀ᶠ z in 𝓝 z₀, AEStronglyMeasurable (F · z) μ := by
    filter_upwards [Metric.ball_mem_nhds z₀ hε_pos] with z hz
    refine (Continuous.div (by fun_prop) (by fun_prop) fun ζ ↦ ?_).aestronglyMeasurable
    exact norm_ne_zero_iff.mp (lt_of_lt_of_le hε_pos (h_ball_sub z hz ζ)).ne'
  have hF_int : Integrable (F · z₀) μ := by
    have hz₀_mem : z₀ ∈ Metric.ball z₀ ε := Metric.mem_ball_self hε_pos
    have hcont : Continuous (F · z₀) := Continuous.div (by fun_prop) (by fun_prop) fun ζ ↦
      norm_ne_zero_iff.mp (lt_of_lt_of_le hε_pos (h_ball_sub z₀ hz₀_mem ζ)).ne'
    obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn hcont.continuousOn
    exact Integrable.of_bound hcont.aestronglyMeasurable B
      (Eventually.of_forall fun ζ ↦ hB ζ (mem_univ ζ))
  have hF'_meas : AEStronglyMeasurable (F' · z₀) μ := by
    have hz₀_mem : z₀ ∈ Metric.ball z₀ ε := Metric.mem_ball_self hε_pos
    refine (Continuous.div (by fun_prop) (by fun_prop) fun ζ ↦ ?_).aestronglyMeasurable
    exact pow_ne_zero 2 (norm_ne_zero_iff.mp (lt_of_lt_of_le hε_pos (h_ball_sub z₀ hz₀_mem ζ)).ne')
  have h_bound : ∀ᵐ ζ ∂μ, ∀ z ∈ Metric.ball z₀ ε, ‖F' ζ z‖ ≤ bound ζ := by
    refine Eventually.of_forall fun ζ z hz ↦ ?_
    dsimp [F', bound]
    rw [norm_div, norm_mul, Complex.norm_ofNat, norm_circlePoint, mul_one, norm_pow]
    exact div_le_div_of_nonneg_left (by norm_num) (pow_pos hε_pos 2)
      (pow_le_pow_left₀ hε_pos.le (h_ball_sub z hz ζ) 2)
  have h_bound_int : Integrable bound μ := integrable_const _
  have h_diff : ∀ᵐ ζ ∂μ, ∀ z ∈ Metric.ball z₀ ε, HasDerivAt (F ζ) (F' ζ z) z := by
    refine Eventually.of_forall fun ζ z hz ↦ ?_
    have hne : circlePoint ζ - z ≠ 0 :=
      norm_ne_zero_iff.mp (lt_of_lt_of_le hε_pos (h_ball_sub z hz ζ)).ne'
    have hd1 : HasDerivAt (fun w ↦ circlePoint ζ + w) 1 z :=
      (hasDerivAt_id z).const_add (circlePoint ζ)
    have hd2 : HasDerivAt (fun w ↦ circlePoint ζ - w) (-1) z := by
      simpa using (hasDerivAt_id z).const_sub (circlePoint ζ)
    have hq := hd1.div hd2 hne
    refine hq.congr_deriv ?_
    dsimp [F']
    ring
  exact (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (Metric.ball_mem_nhds z₀ hε_pos) hF_meas hF_int hF'_meas h_bound h_bound_int h_diff).2.differentiableAt

theorem re_measureHerglotz_eq_poissonIntegral (μ : Measure FourierCircle) [IsFiniteMeasure μ]
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ).re =
      ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂μ := by
  have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
  have hcont : Continuous (fun ζ : FourierCircle ↦ (circlePoint ζ + z) / (circlePoint ζ - z)) := by
    refine Continuous.div (by fun_prop) (by fun_prop) fun ζ ↦ ?_
    intro h0
    have heq := sub_eq_zero.mp h0
    rw [← heq, norm_circlePoint] at hz_lt
    exact lt_irrefl 1 hz_lt
  obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn hcont.continuousOn
  have hint : Integrable (fun ζ : FourierCircle ↦ (circlePoint ζ + z) / (circlePoint ζ - z)) μ :=
    Integrable.of_bound hcont.aestronglyMeasurable B
      (Eventually.of_forall fun ζ ↦ hB ζ (mem_univ ζ))
  have hre_eq := (Complex.reCLM.integral_comp_comm hint).symm
  rw [show (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ).re =
      Complex.reCLM (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ) from rfl, hre_eq]
  refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
  exact (poissonKernel_eq_re_herglotz z ζ).symm

theorem holomorphicOn_singularInnerFactor (μ : Measure FourierCircle) [IsFiniteMeasure μ] :
    HolomorphicOn (singularInnerFactor μ) (Metric.ball (0 : ℂ) 1) :=
  fun z hz ↦ (holomorphicOn_measureHerglotz μ z hz).neg.cexp

theorem singularInnerFactor_ne_zero (μ : Measure FourierCircle) (z : ℂ) :
    singularInnerFactor μ z ≠ 0 :=
  Complex.exp_ne_zero _

theorem norm_singularInnerFactor (μ : Measure FourierCircle) [IsFiniteMeasure μ]
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    ‖singularInnerFactor μ z‖ =
      Real.exp (- ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂μ) := by
  rw [singularInnerFactor, Complex.norm_exp, Complex.neg_re,
    re_measureHerglotz_eq_poissonIntegral μ hz]

theorem norm_singularInnerFactor_le_one (μ : Measure FourierCircle) [IsFiniteMeasure μ]
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    ‖singularInnerFactor μ z‖ ≤ 1 := by
  rw [norm_singularInnerFactor μ hz, Real.exp_le_one_iff, neg_nonpos]
  exact integral_nonneg fun ζ ↦ poissonKernel_circlePoint_nonneg hz ζ

/-! #### Poisson kernel derivative helpers for singular-measure radial limit -/

private def poissonKernelNegDerivC (r u : ℝ) : ℝ :=
  (1 - r ^ 2) * (2 * r * Real.sin u) / (1 - 2 * r * Real.cos u + r ^ 2) ^ 2

private lemma hasDerivAt_poissonKernelC {r : ℝ} (_hr0 : 0 ≤ r) (hr1 : r < 1) (u : ℝ) :
    HasDerivAt (RudinRCA.Chapter11.poissonKernel r) (-poissonKernelNegDerivC r u) u := by
  have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
    nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
  have hden_deriv : HasDerivAt (fun x : ℝ ↦ 1 - 2 * r * Real.cos x + r ^ 2)
      (2 * r * Real.sin u) u := by
    have hcos := (Real.hasDerivAt_cos u).const_mul (2 * r)
    have hsub := (hasDerivAt_const u (1 : ℝ)).sub hcos
    have hadd := hsub.add (hasDerivAt_const u (r ^ 2))
    convert hadd using 1
    ring
  have hquot := (hasDerivAt_const u (1 - r ^ 2)).div hden_deriv hden_pos.ne'
  refine hquot.congr_deriv ?_
  unfold poissonKernelNegDerivC
  ring

private lemma poissonKernel_eq_pi_add_integralC {r s : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    RudinRCA.Chapter11.poissonKernel r s =
      RudinRCA.Chapter11.poissonKernel r Real.pi +
        ∫ u in s..Real.pi, poissonKernelNegDerivC r u := by
  have hcont : Continuous (fun u : ℝ ↦ -poissonKernelNegDerivC r u) := by
    unfold poissonKernelNegDerivC
    refine Continuous.neg (Continuous.div (by fun_prop) (by fun_prop) fun u ↦ ?_)
    have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
      nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
    exact (sq_pos_of_pos hden_pos).ne'
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun u _ ↦ hasDerivAt_poissonKernelC hr0 hr1 u) (hcont.intervalIntegrable s Real.pi)
  rw [intervalIntegral.integral_neg] at hftc
  linarith

private lemma poissonKernel_half_integralC {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    ∫ u in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r u = Real.pi := by
  have hint_full := (RudinRCA.Chapter11.node11_5_integral_eq_one hr0 hr1).1
  have hcont := RudinRCA.Chapter11.continuous_poissonKernel hr0 hr1
  have hsplit := intervalIntegral.integral_add_adjacent_intervals
    (hcont.intervalIntegrable (μ := MeasureTheory.volume) (-Real.pi) 0)
    (hcont.intervalIntegrable (μ := MeasureTheory.volume) 0 Real.pi)
  have hneg : (∫ u in (-Real.pi)..(0 : ℝ), RudinRCA.Chapter11.poissonKernel r u) =
      ∫ u in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r u := by
    have hc := intervalIntegral.integral_comp_neg (RudinRCA.Chapter11.poissonKernel r)
      (a := (0 : ℝ)) (b := Real.pi)
    simp only [neg_zero, RudinRCA.Chapter11.node11_5_even] at hc
    exact hc.symm
  rw [← hsplit, hneg] at hint_full
  have h2pi : 0 < 2 * Real.pi := Real.two_pi_pos
  have hsum : (∫ u in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r u) +
      (∫ u in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r u) = 2 * Real.pi :=
    ((inv_mul_eq_one₀ h2pi.ne').mp hint_full).symm
  linarith

/-- **17.15 Key Measure Lemma (`μ ⟂ₘ σ ↔ P[μ](r ζ) → 0` a.e., RCA pp. 342–343):**
A finite positive Borel measure `μ` on `FourierCircle` is mutually singular with respect to
normalized Lebesgue measure `circleMeasure` if and only if its Poisson integral tends radially to
`0` at `circleMeasure`-almost every boundary point `ζ ∈ T`. -/
theorem singular_iff_ae_tendsto_measurePoissonIntegral_zero
    (μ : Measure FourierCircle) [IsFiniteMeasure μ] :
    (μ ⟂ₘ circleMeasure) ↔
      ∀ᵐ ζ ∂circleMeasure,
        Tendsto (fun r : ℝ ↦ ∫ η, _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ) (circlePoint η) ∂μ)
          (𝓝[<] 1) (𝓝 0) := by
  constructor
  · -- `(→)` Singular measure differentiation on `ℝ` via Vitali family + Tonelli layer-cake
    intro hsing
    have : Fact (0 < 2 * Real.pi) := ⟨Real.two_pi_pos⟩
    let I₀ : Set ℝ := Set.Ioc (-Real.pi) (-Real.pi + 2 * Real.pi)
    have hI₀_eq : I₀ = Set.Ioc (-Real.pi) Real.pi := by
      dsimp [I₀]
      rw [show -Real.pi + 2 * Real.pi = Real.pi by ring]
    let e : FourierCircle ≃ᵐ ↑I₀ :=
      AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
    have he_coe : ∀ ζ : FourierCircle, (((e ζ : ℝ)) : FourierCircle) = ζ := fun ζ ↦ by
      have h := e.symm_apply_apply ζ
      simpa [e, AddCircle.measurableEquivIoc, AddCircle.equivIoc,
        QuotientAddGroup.equivIocMod] using h
    let μ₁ : Measure ℝ := (μ.map e).map Subtype.val
    have hμ₁_fin : IsFiniteMeasure μ₁ := by
      dsimp [μ₁]
      infer_instance
    let shL : ℝ → ℝ := fun x ↦ x - 2 * Real.pi
    let shR : ℝ → ℝ := fun x ↦ x + 2 * Real.pi
    let ν : Measure ℝ := μ₁.map shL + μ₁ + μ₁.map shR
    have hν_fin : IsFiniteMeasure ν := by
      dsimp [ν]
      infer_instance
    -- Show `ν ⟂ₘ volume`
    have hν_sing : ν ⟂ₘ (MeasureTheory.volume : Measure ℝ) := by
      obtain ⟨S, hS_meas, hμS, hσSc⟩ := hsing
      let A : Set ℝ := (QuotientAddGroup.mk : ℝ → FourierCircle) ⁻¹' S
      have hA_meas : MeasurableSet A := AddCircle.measurable_mk' hS_meas
      have hμ₁_pre : ∀ g : ℝ → ℝ, Measurable g →
          (∀ x : ℝ, ((g x : ℝ) : FourierCircle) = (x : FourierCircle)) →
          (μ₁.map g) A = 0 := by
        intro g hg hg_per
        rw [Measure.map_apply hg hA_meas]
        dsimp [μ₁]
        rw [Measure.map_apply measurable_subtype_coe (hg hA_meas),
          Measure.map_apply e.measurable (measurable_subtype_coe (hg hA_meas))]
        have hsub : e ⁻¹' (Subtype.val ⁻¹' (g ⁻¹' A)) = S := by
          ext ζ
          simp only [mem_preimage, A]
          rw [hg_per (e ζ : ℝ), he_coe ζ]
        rw [hsub]
        exact hμS
      have hνA : ν A = 0 := by
        dsimp [ν]
        have hL : (μ₁.map shL) A = 0 := hμ₁_pre shL (by fun_prop) fun x ↦ by
          dsimp [shL]
          have h := AddCircle.coe_add_period (2 * Real.pi) (x - 2 * Real.pi)
          rw [sub_add_cancel] at h
          exact h.symm
        have hM : μ₁ A = 0 := by
          have := hμ₁_pre id measurable_id fun _ ↦ rfl
          rwa [Measure.map_id] at this
        have hR : (μ₁.map shR) A = 0 := hμ₁_pre shR (by fun_prop) fun x ↦ by
          dsimp [shR]
          exact AddCircle.coe_add_period (2 * Real.pi) x
        rw [hL, hM, hR, add_zero, add_zero]
      have hvol_Sc : (MeasureTheory.volume : Measure FourierCircle) Sᶜ = 0 := by
        rw [AddCircle.volume_eq_smul_haarAddCircle, Measure.smul_apply, hσSc, smul_zero]
      have hvolAc : (MeasureTheory.volume : Measure ℝ) Aᶜ = 0 := by
        have hcov : Aᶜ ⊆ ⋃ k : ℤ, Aᶜ ∩ Set.Ioc ((k : ℝ) * (2 * Real.pi))
            ((k : ℝ) * (2 * Real.pi) + 2 * Real.pi) := by
          intro x hx
          refine mem_iUnion.mpr ?_
          obtain ⟨m, hm⟩ := existsUnique_add_zsmul_mem_Ioc Real.two_pi_pos x 0
          refine ⟨-m, hx, ?_⟩
          rcases hm.1 with ⟨h1, h2⟩
          rw [zero_add] at h2
          simp only [zsmul_eq_mul] at h1 h2
          push_cast
          exact ⟨by linarith, by linarith⟩
        refine measure_mono_null hcov (measure_iUnion_null fun k ↦ ?_)
        have hmp := AddCircle.measurePreserving_mk (2 * Real.pi) ((k : ℝ) * (2 * Real.pi))
        have hres := hmp.measure_preimage (hS_meas.compl.nullMeasurableSet)
        rw [Measure.restrict_apply' measurableSet_Ioc] at hres
        exact hres.trans hvol_Sc
      exact ⟨A, hA_meas, hνA, hvolAc⟩
    -- Apply Vitali differentiation on `ℝ` to `ν ⟂ₘ volume`
    let vf := IsUnifLocDoublingMeasure.vitaliFamily (MeasureTheory.volume : Measure ℝ) 0
    have hae_vit : ∀ᵐ θ₀ ∂(MeasureTheory.volume : Measure ℝ),
        Tendsto (fun u : ℝ ↦ ν (Metric.closedBall θ₀ u) /
          MeasureTheory.volume (Metric.closedBall θ₀ u)) (𝓝[>] 0) (𝓝 0) := by
      filter_upwards [vf.ae_eventually_measure_zero_of_singular hν_sing] with θ₀ hθ₀
      have hfilter : Tendsto (fun u : ℝ ↦ Metric.closedBall θ₀ u) (𝓝[>] 0) (vf.filterAt θ₀) :=
        IsUnifLocDoublingMeasure.tendsto_closedBall_filterAt (MeasureTheory.volume : Measure ℝ)
          (fun _ : ℝ ↦ θ₀) id tendsto_id
          (Eventually.of_forall fun u ↦ by simp)
      exact hθ₀.comp hfilter
    -- Pull `hae_vit` back along `ζ ↦ (e ζ : ℝ) ∈ I₀`
    have hae_circle_vit : ∀ᵐ ζ ∂circleMeasure,
        Tendsto (fun u : ℝ ↦ ν (Metric.closedBall (e ζ : ℝ) u) /
          MeasureTheory.volume (Metric.closedBall (e ζ : ℝ) u)) (𝓝[>] 0) (𝓝 0) := by
      let bad : Set ℝ := {θ₀ : ℝ | ¬ Tendsto (fun u : ℝ ↦ ν (Metric.closedBall θ₀ u) /
        MeasureTheory.volume (Metric.closedBall θ₀ u)) (𝓝[>] 0) (𝓝 0)}
      have hbad0 : MeasureTheory.volume bad = 0 := hae_vit
      let T_null : Set ℝ := toMeasurable MeasureTheory.volume bad
      have hT_meas : MeasurableSet T_null := measurableSet_toMeasurable _ _
      have hT0 : MeasureTheory.volume T_null = 0 := by rw [measure_toMeasurable]; exact hbad0
      let B_circ : Set FourierCircle := (fun ζ ↦ (e ζ : ℝ)) ⁻¹' T_null
      have hB_meas : MeasurableSet B_circ :=
        (measurable_subtype_coe.comp e.measurable) hT_meas
      have hvol_B : (MeasureTheory.volume : Measure FourierCircle) B_circ = 0 := by
        have hmp := AddCircle.measurePreserving_mk (2 * Real.pi) (-Real.pi)
        have hres := hmp.measure_preimage hB_meas.nullMeasurableSet
        rw [← hres, Measure.restrict_apply' measurableSet_Ioc]
        refine measure_mono_null (fun θ hθ ↦ ?_) hT0
        rcases hθ with ⟨hpre, hIoc⟩
        have he_θ : e (θ : FourierCircle) = ⟨θ, hIoc⟩ := by
          have hsymm : e.symm ⟨θ, hIoc⟩ = (θ : FourierCircle) := by
            simp [e, AddCircle.measurableEquivIoc, AddCircle.equivIoc,
              QuotientAddGroup.equivIocMod]
          rw [← hsymm, e.apply_symm_apply]
        simpa [B_circ, he_θ] using hpre
      have hσ_B : circleMeasure B_circ = 0 := by
        rw [AddCircle.volume_eq_smul_haarAddCircle, Measure.smul_apply, smul_eq_mul,
          mul_eq_zero] at hvol_B
        exact hvol_B.resolve_left (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne'
      filter_upwards [compl_mem_ae_iff.mpr hσ_B] with ζ hζ
      by_contra hnot
      exact hζ (subset_toMeasurable MeasureTheory.volume bad hnot)
    -- Now prove radial Poisson limit `= 0` at every `ζ` satisfying `hae_circle_vit`
    filter_upwards [hae_circle_vit] with ζ hζ_vit
    let θ₀ : ℝ := (e ζ : ℝ)
    have hθ₀_Ioc : θ₀ ∈ Set.Ioc (-Real.pi) Real.pi := by
      have hmem : θ₀ ∈ I₀ := (e ζ).2
      rwa [hI₀_eq] at hmem
    have hθ₀_coe : (θ₀ : FourierCircle) = ζ := he_coe ζ
    rw [Metric.tendsto_nhds]
    intro ε hε
    let η : ℝ := ε / (4 * Real.pi)
    have hη_pos : 0 < η := by dsimp [η]; positivity
    -- Extract `δ > 0` such that `ν(closedBall θ₀ u) ≤ ofReal (2 * η * u)` for `u ∈ [0, δ]`
    have hev_ratio : ∀ᶠ u in 𝓝[>] (0 : ℝ),
        ν (Metric.closedBall θ₀ u) / MeasureTheory.volume (Metric.closedBall θ₀ u) <
          ENNReal.ofReal η :=
      (tendsto_order.mp hζ_vit).2 _ (ENNReal.ofReal_pos.mpr hη_pos)
    rw [eventually_nhdsWithin_iff, Metric.eventually_nhds_iff] at hev_ratio
    obtain ⟨δ₀, hδ₀_pos, hδ₀⟩ := hev_ratio
    let δ : ℝ := min (δ₀ / 2) (Real.pi / 2)
    have hδ_pos : 0 < δ := lt_min (half_pos hδ₀_pos) (half_pos Real.pi_pos)
    have hδ_le_pi : δ ≤ Real.pi := (min_le_right _ _).trans (by linarith [Real.pi_pos])
    have hball_small : ∀ u ∈ Set.Icc 0 δ,
        ν (Metric.closedBall θ₀ u) ≤ ENNReal.ofReal (2 * η * u) := by
      intro u hu
      rcases hu.1.eq_or_lt with rfl | hu_pos
      · refine ENNReal.le_of_forall_pos_le_add fun γ hγ _ ↦ ?_
        simp only [mul_zero, ENNReal.ofReal_zero, zero_add]
        let u₂ : ℝ := min δ ((γ : ℝ) / (2 * η + 1))
        have hu₂ : 0 < u₂ := lt_min hδ_pos (div_pos (NNReal.coe_pos.mpr hγ) (by positivity))
        have hu₂_dist : dist u₂ 0 < δ₀ := by
          rw [Real.dist_eq, sub_zero, abs_of_pos hu₂]
          exact lt_of_le_of_lt ((min_le_left _ _).trans (min_le_left _ _)) (half_lt_self hδ₀_pos)
        have hlt := hδ₀ hu₂_dist hu₂
        have hvol_u₂ : MeasureTheory.volume (Metric.closedBall θ₀ u₂) = ENNReal.ofReal (2 * u₂) := by
          rw [Real.closedBall_eq_Icc, Real.volume_Icc]
          congr 1; ring
        rw [hvol_u₂, ENNReal.div_lt_iff (Or.inl (ENNReal.ofReal_pos.mpr (by positivity)).ne')
          (Or.inl ENNReal.ofReal_ne_top), ← ENNReal.ofReal_mul hη_pos.le] at hlt
        calc ν (Metric.closedBall θ₀ 0)
            ≤ ν (Metric.closedBall θ₀ u₂) :=
              measure_mono (Metric.closedBall_subset_closedBall hu₂.le)
          _ ≤ ENNReal.ofReal (η * (2 * u₂)) := hlt.le
          _ ≤ ENNReal.ofReal (γ : ℝ) := by
              refine ENNReal.ofReal_le_ofReal ?_
              have hle : u₂ ≤ (γ : ℝ) / (2 * η + 1) := min_le_right _ _
              have hcalc : η * (2 * ((γ : ℝ) / (2 * η + 1))) ≤ (γ : ℝ) := by
                rw [show η * (2 * ((γ : ℝ) / (2 * η + 1))) = (2 * η / (2 * η + 1)) * (γ : ℝ) by ring]
                exact mul_le_of_le_one_left (NNReal.coe_nonneg γ)
                  ((div_le_one (by positivity)).mpr (by linarith))
              exact (mul_le_mul_of_nonneg_left (by linarith) hη_pos.le).trans hcalc
          _ = (γ : ℝ≥0∞) := ENNReal.ofReal_coe_nnreal
      · have hu_dist : dist u 0 < δ₀ := by
          rw [Real.dist_eq, sub_zero, abs_of_pos hu_pos]
          exact lt_of_le_of_lt (hu.2.trans (min_le_left _ _)) (half_lt_self hδ₀_pos)
        have hlt := hδ₀ hu_dist hu_pos
        have hvol_u : MeasureTheory.volume (Metric.closedBall θ₀ u) = ENNReal.ofReal (2 * u) := by
          rw [Real.closedBall_eq_Icc, Real.volume_Icc]
          congr 1; ring
        rw [hvol_u, ENNReal.div_lt_iff (Or.inl (ENNReal.ofReal_pos.mpr (by positivity)).ne')
          (Or.inl ENNReal.ofReal_ne_top), ← ENNReal.ofReal_mul hη_pos.le] at hlt
        simpa [mul_assoc, mul_left_comm] using hlt.le
    -- Tail `P_r(δ) * ν.real(closedBall θ₀ π) → 0` as `r → 1⁻`
    have htail_tendsto : Tendsto
        (fun r : ℝ ↦
          RudinRCA.Chapter11.poissonKernel r δ * ν.real (Metric.closedBall θ₀ Real.pi))
        (𝓝[<] 1) (𝓝 0) := by
      have h0 := (RudinRCA.Chapter11.node11_5_tail_tendsto_zero hδ_pos hδ_le_pi).1
      simpa using h0.mul_const (ν.real (Metric.closedBall θ₀ Real.pi))
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one,
      (Metric.tendsto_nhds.mp htail_tendsto (ε / 2) (half_pos hε))] with r hr htail_r
    have hr0 : 0 ≤ r := hr.1.le
    have hr1 : r < 1 := hr.2
    let z : ℂ := (r : ℂ) * circlePoint ζ
    have hz : z ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [z, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hr.1] using hr.2
    have hcontP := continuous_poissonKernel_circlePoint hz
    obtain ⟨B_P, hB_P⟩ := isCompact_univ.exists_bound_of_continuousOn hcontP.continuousOn
    have hintP_μ : Integrable (fun η ↦ _root_.poissonKernel 0 z (circlePoint η)) μ :=
      Integrable.of_bound hcontP.aestronglyMeasurable B_P
        (Eventually.of_forall fun η ↦ hB_P η (mem_univ η))
    have hintP_nn : 0 ≤ ∫ η, _root_.poissonKernel 0 z (circlePoint η) ∂μ :=
      integral_nonneg fun η ↦ poissonKernel_circlePoint_nonneg hz η
    -- Step 1: Identify `_root_.poissonKernel 0 z (circlePoint (t : FourierCircle))` with `P_r(θ₀ - t)`
    let P := RudinRCA.Chapter11.poissonKernel r
    let Q := poissonKernelNegDerivC r
    have hker_real : ∀ t : ℝ,
        _root_.poissonKernel 0 z (circlePoint (t : FourierCircle)) = P (θ₀ - t) := by
      intro t
      dsimp [z, P]
      rw [poissonKernel_circlePoint_formula, ← hθ₀_coe, circlePoint_coe, circlePoint_coe]
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr.1,
        Complex.norm_exp_ofReal_mul_I, mul_one]
      have hexp_eq : Complex.exp ((t : ℂ) * Complex.I) -
          (r : ℂ) * Complex.exp ((θ₀ : ℂ) * Complex.I) =
          Complex.exp ((t : ℂ) * Complex.I) *
            (1 - (r : ℂ) * Complex.exp (((θ₀ - t : ℝ) : ℂ) * Complex.I)) := by
        push_cast
        rw [mul_sub, mul_one, ← mul_assoc, mul_comm (Complex.exp _) (r : ℂ), mul_assoc,
          ← Complex.exp_add]
        congr 3; ring
      rw [hexp_eq, norm_mul, Complex.norm_exp_ofReal_mul_I, one_mul,
        RudinRCA.Chapter11.norm_sq_one_sub_polar]
      rfl
    -- Step 2: Bound `ENNReal.ofReal (∫ η, P_z(η) ∂μ)` by `∫⁻ t in closedBall θ₀ π, ofReal (P (θ₀ - t)) ∂ν`
    let gP : ℝ → ℝ≥0∞ := fun t ↦ ENNReal.ofReal (P (θ₀ - t))
    have hgP_meas : Measurable gP :=
      ENNReal.measurable_ofReal.comp
        ((RudinRCA.Chapter11.continuous_poissonKernel hr0 hr1).comp
          (continuous_const.sub continuous_id)).measurable
    have hgP_per : Function.Periodic gP (2 * Real.pi) := by
      intro t
      dsimp [gP, P]
      rw [← RudinRCA.Chapter11.node11_5_even r (θ₀ - (t + 2 * Real.pi)),
        ← RudinRCA.Chapter11.node11_5_even r (θ₀ - t)]
      have h : -(θ₀ - (t + 2 * Real.pi)) = -(θ₀ - t) + 2 * Real.pi := by ring
      rw [h, RudinRCA.Chapter11.node11_5_periodic]
    have hlint_le_cb : ENNReal.ofReal (∫ η, _root_.poissonKernel 0 z (circlePoint η) ∂μ) ≤
        ∫⁻ t in Metric.closedBall θ₀ Real.pi, gP t ∂ν := by
      rw [ofReal_integral_eq_lintegral_ofReal hintP_μ
        (Eventually.of_forall fun η ↦ poissonKernel_circlePoint_nonneg hz η)]
      have hμ_to_μ₁ : (∫⁻ η, ENNReal.ofReal (_root_.poissonKernel 0 z (circlePoint η)) ∂μ) =
          ∫⁻ x, gP x ∂μ₁ := by
        have hmap1 : ∫⁻ x, gP x ∂μ₁ = ∫⁻ y, gP (y : ℝ) ∂(μ.map e) :=
          lintegral_map hgP_meas measurable_subtype_coe
        have hmap2 : ∫⁻ y, gP (y : ℝ) ∂(μ.map e) = ∫⁻ η, gP (e η : ℝ) ∂μ :=
          lintegral_map (f := fun y : ↑I₀ ↦ gP (y : ℝ))
            (hgP_meas.comp measurable_subtype_coe) e.measurable
        rw [hmap1, hmap2]
        refine lintegral_congr fun η ↦ ?_
        dsimp [gP]
        rw [← hker_real (e η : ℝ), he_coe η]
      -- Use the 3-shift partition on `Ioc (-π) π`
      let I_θ : Set ℝ := Set.Ioc (θ₀ - Real.pi) (θ₀ + Real.pi)
      have hμ₁_supp : μ₁ (Set.Ioc (-Real.pi) Real.pi)ᶜ = 0 := by
        rw [← hI₀_eq]
        dsimp [μ₁]
        rw [Measure.map_apply measurable_subtype_coe measurableSet_Ioc.compl]
        have hpre : Subtype.val ⁻¹' I₀ᶜ = (∅ : Set ↑I₀) := by
          ext ⟨x, hx⟩
          simp
        rw [hpre, measure_empty]
      have hμ₁_eq_ν : (∫⁻ x, gP x ∂μ₁) = ∫⁻ t in I_θ, gP t ∂ν := by
        let indP : ℝ → ℝ≥0∞ := I_θ.indicator gP
        have hindP : Measurable indP := hgP_meas.indicator measurableSet_Ioc
        change (∫⁻ x, gP x ∂μ₁) = ∫⁻ t in I_θ, gP t ∂ν
        rw [← lintegral_indicator measurableSet_Ioc]
        change (∫⁻ x, gP x ∂μ₁) = ∫⁻ t, indP t ∂ν
        dsimp [ν]
        have hmL_eq : (∫⁻ t, indP t ∂(μ₁.map shL)) = ∫⁻ x, indP (shL x) ∂μ₁ :=
          lintegral_map hindP (by fun_prop : Measurable shL)
        have hmR_eq : (∫⁻ t, indP t ∂(μ₁.map shR)) = ∫⁻ x, indP (shR x) ∂μ₁ :=
          lintegral_map hindP (by fun_prop : Measurable shR)
        rw [lintegral_add_measure, lintegral_add_measure, hmL_eq, hmR_eq,
          ← lintegral_add_left (f := fun x ↦ indP (shL x)) (hindP.comp (by fun_prop)),
          ← lintegral_add_left (f := fun x ↦ indP (shL x) + indP x)
            ((hindP.comp (by fun_prop)).add hindP)]
        refine lintegral_congr_ae ?_
        filter_upwards [compl_mem_ae_iff.mpr hμ₁_supp] with x hx
        have hx_mem : x ∈ Set.Ioc (-Real.pi) Real.pi := by
          simpa using hx
        rcases hx_mem with ⟨hx_lo, hx_hi⟩
        rcases hθ₀_Ioc with ⟨hθ_lo, hθ_hi⟩
        have hperL : gP (shL x) = gP x := by
          dsimp [shL]
          have h := hgP_per (x - 2 * Real.pi)
          simpa [sub_add_cancel] using h.symm
        have hperR : gP (shR x) = gP x := hgP_per x
        dsimp [indP]
        rcases lt_or_ge (θ₀ + Real.pi) x with hcase1 | hle1
        · have hmL : shL x ∈ I_θ := ⟨by dsimp [shL]; linarith, by dsimp [shL]; linarith⟩
          have hmM : x ∉ I_θ := fun h ↦ hcase1.not_ge h.2
          have hmR : shR x ∉ I_θ := fun h ↦ by dsimp [shR] at h; linarith [h.2]
          simp [Set.indicator_of_mem hmL, Set.indicator_of_notMem hmM,
            Set.indicator_of_notMem hmR, hperL]
        · rcases lt_or_ge (θ₀ - Real.pi) x with hcase2 | hcase3
          · have hmL : shL x ∉ I_θ := fun h ↦ by dsimp [shL] at h; linarith [h.1]
            have hmM : x ∈ I_θ := ⟨hcase2, hle1⟩
            have hmR : shR x ∉ I_θ := fun h ↦ by dsimp [shR] at h; linarith [h.2]
            simp [Set.indicator_of_notMem hmL, Set.indicator_of_mem hmM,
              Set.indicator_of_notMem hmR]
          · have hmL : shL x ∉ I_θ := fun h ↦ by dsimp [shL] at h; linarith [h.1]
            have hmM : x ∉ I_θ := fun h ↦ hcase3.not_gt h.1
            have hmR : shR x ∈ I_θ := ⟨by dsimp [shR]; linarith, by dsimp [shR]; linarith⟩
            simp [Set.indicator_of_notMem hmL, Set.indicator_of_notMem hmM,
              Set.indicator_of_mem hmR, hperR]
      rw [hμ_to_μ₁, hμ₁_eq_ν]
      refine lintegral_mono_set fun t ht ↦ ?_
      rw [Real.closedBall_eq_Icc]
      exact ⟨ht.1.le, ht.2⟩
    -- Step 3: Tonelli layer-cake on `ν₀ = ν.restrict (closedBall θ₀ π)` and `μ₀ = volume.restrict (Icc 0 π)`
    let ν₀ : Measure ℝ := ν.restrict (Metric.closedBall θ₀ Real.pi)
    let μ₀ : Measure ℝ := MeasureTheory.volume.restrict (Set.Icc 0 Real.pi)
    have hQ_cont : Continuous Q := by
      unfold Q poissonKernelNegDerivC
      refine Continuous.div (by fun_prop) (by fun_prop) fun u ↦ ?_
      have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
        nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
      exact (sq_pos_of_pos hden_pos).ne'
    have hQ_nn : ∀ u ∈ Set.Icc (0 : ℝ) Real.pi, 0 ≤ Q u := by
      intro u hu
      unfold Q poissonKernelNegDerivC
      have hsin : 0 ≤ Real.sin u := Real.sin_nonneg_of_nonneg_of_le_pi hu.1 hu.2
      have h1mr2 : 0 ≤ 1 - r ^ 2 := by nlinarith
      have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
        nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
      positivity
    have hP_layer : ∀ t ∈ Metric.closedBall θ₀ Real.pi,
        gP t = ENNReal.ofReal (P Real.pi) +
          ∫⁻ u, Set.indicator {u : ℝ | |t - θ₀| ≤ u} (fun u ↦ ENNReal.ofReal (Q u)) u ∂μ₀ := by
      intro t ht
      let s : ℝ := |t - θ₀|
      have hs : s ∈ Set.Icc (0 : ℝ) Real.pi :=
        ⟨abs_nonneg _, by simpa [s, Metric.mem_closedBall, Real.dist_eq] using ht⟩
      have hgP_s : gP t = ENNReal.ofReal (P s) := by
        dsimp [gP, P, s]
        rw [← RudinRCA.Chapter11.node11_5_even r (θ₀ - t), abs_sub_comm]
        rcases le_or_gt 0 (θ₀ - t) with h | h
        · rw [abs_of_nonneg h, RudinRCA.Chapter11.node11_5_even]
        · rw [abs_of_neg h]
      have hQ_int_s : IntegrableOn Q (Set.Icc s Real.pi) MeasureTheory.volume :=
        hQ_cont.integrableOn_Icc
      have hQ_nn_s : 0 ≤ᵐ[MeasureTheory.volume.restrict (Set.Icc s Real.pi)] Q :=
        ae_restrict_of_forall_mem measurableSet_Icc fun u hu ↦ hQ_nn u ⟨hs.1.trans hu.1, hu.2⟩
      have hinter : Set.Icc (0 : ℝ) Real.pi ∩ Set.Ici s = Set.Icc s Real.pi := by
        ext u; simp only [mem_inter_iff, mem_Icc, mem_Ici]
        exact ⟨fun ⟨⟨_, h2⟩, h3⟩ ↦ ⟨h3, h2⟩, fun ⟨h1, h2⟩ ↦ ⟨⟨hs.1.trans h1, h2⟩, h1⟩⟩
      have hlint_s :
          (∫⁻ u, Set.indicator (Set.Ici s) (fun u ↦ ENNReal.ofReal (Q u)) u ∂μ₀) =
            ENNReal.ofReal (∫ u in s..Real.pi, Q u) := by
        rw [lintegral_indicator measurableSet_Ici, Measure.restrict_restrict measurableSet_Ici,
          Set.inter_comm, hinter, ← ofReal_integral_eq_lintegral_ofReal hQ_int_s hQ_nn_s,
          intervalIntegral.integral_of_le hs.2, integral_Icc_eq_integral_Ioc]
      have hP_pi_nn : 0 ≤ P Real.pi := (RudinRCA.Chapter11.node11_5_pos hr0 hr1 Real.pi).le
      have hint_nn : 0 ≤ ∫ u in s..Real.pi, Q u :=
        intervalIntegral.integral_nonneg hs.2 fun u hu ↦ hQ_nn u ⟨hs.1.trans hu.1, hu.2⟩
      rw [hgP_s, show {u : ℝ | |t - θ₀| ≤ u} = Set.Ici s from rfl, hlint_s,
        ← ENNReal.ofReal_add hP_pi_nn hint_nn]
      dsimp [P, Q]
      rw [← poissonKernel_eq_pi_add_integralC hr0 hr1]
    have htonelli : (∫⁻ t, gP t ∂ν₀) =
        ENNReal.ofReal (P Real.pi) * ν (Metric.closedBall θ₀ Real.pi) +
          ∫⁻ u, ENNReal.ofReal (Q u) * ν (Metric.closedBall θ₀ u) ∂μ₀ := by
      have hae_layer : gP =ᵐ[ν₀] fun t ↦ ENNReal.ofReal (P Real.pi) +
          ∫⁻ u, Set.indicator {u : ℝ | |t - θ₀| ≤ u} (fun u ↦ ENNReal.ofReal (Q u)) u ∂μ₀ :=
        ae_restrict_of_forall_mem Metric.isClosed_closedBall.measurableSet hP_layer
      rw [lintegral_congr_ae hae_layer, lintegral_add_left measurable_const]
      have hterm1 : (∫⁻ _, ENNReal.ofReal (P Real.pi) ∂ν₀) =
          ENNReal.ofReal (P Real.pi) * ν (Metric.closedBall θ₀ Real.pi) := by
        simp [ν₀]
      rw [hterm1]
      congr 1
      let K_ind : ℝ × ℝ → ℝ≥0∞ :=
        Set.indicator {p : ℝ × ℝ | |p.1 - θ₀| ≤ p.2}
          (fun p ↦ ENNReal.ofReal (Q p.2))
      have hK_meas : Measurable K_ind := by
        refine (ENNReal.measurable_ofReal.comp (hQ_cont.measurable.comp measurable_snd)).indicator ?_
        exact (isClosed_le ((continuous_fst.sub continuous_const).abs) continuous_snd).measurableSet
      have hswap := lintegral_lintegral_swap (μ := ν₀) (ν := μ₀)
        (f := fun t u ↦ K_ind (t, u)) hK_meas.aemeasurable
      have hlhs_k : (∫⁻ t, ∫⁻ u, Set.indicator {u : ℝ | |t - θ₀| ≤ u}
            (fun u ↦ ENNReal.ofReal (Q u)) u ∂μ₀ ∂ν₀) =
          ∫⁻ t, ∫⁻ u, K_ind (t, u) ∂μ₀ ∂ν₀ := by
        refine lintegral_congr fun t ↦ lintegral_congr fun u ↦ ?_
        simp [K_ind, Set.indicator]
      rw [hlhs_k, hswap]
      refine lintegral_congr_ae ?_
      filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
      have hind_u : (fun t ↦ K_ind (t, u)) =
          Set.indicator (Metric.closedBall θ₀ u) (fun _ ↦ ENNReal.ofReal (Q u)) := by
        ext t
        by_cases ht : t ∈ Metric.closedBall θ₀ u
        · have hle : |t - θ₀| ≤ u := by simpa [Metric.mem_closedBall, Real.dist_eq] using ht
          simp [K_ind, ht, hle]
        · have hgt : ¬ |t - θ₀| ≤ u := by simpa [Metric.mem_closedBall, Real.dist_eq] using ht
          simp [K_ind, ht, hgt]
      rw [hind_u, lintegral_indicator Metric.isClosed_closedBall.measurableSet, lintegral_const,
        Measure.restrict_apply_univ,
        Measure.restrict_apply Metric.isClosed_closedBall.measurableSet,
        Set.inter_eq_self_of_subset_left (Metric.closedBall_subset_closedBall hu.2)]
    -- Step 4: Bound the `[0, δ]` and `[δ, π]` parts of `∫⁻ u, ofReal (Q u) * ν(closedBall θ₀ u) ∂μ₀`
    have hsplit_u :
        (∫⁻ u, ENNReal.ofReal (Q u) * ν (Metric.closedBall θ₀ u) ∂μ₀) ≤
          ENNReal.ofReal (2 * η * ∫ u in (0 : ℝ)..δ, Q u * u) +
            ENNReal.ofReal (∫ u in δ..Real.pi, Q u) * ν (Metric.closedBall θ₀ Real.pi) := by
      have h1 : (∫⁻ u, ENNReal.ofReal (Q u) * ν (Metric.closedBall θ₀ u) ∂μ₀) ≤
          ∫⁻ u, (Set.indicator (Set.Icc 0 δ)
              (fun u ↦ ENNReal.ofReal (Q u * (2 * η * u))) u +
            Set.indicator (Set.Ioc δ Real.pi)
              (fun u ↦ ENNReal.ofReal (Q u) * ν (Metric.closedBall θ₀ Real.pi)) u) ∂μ₀ := by
        refine lintegral_mono_ae ?_
        filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
        rcases le_or_gt u δ with hle | hgt
        · have hm1 : u ∈ Set.Icc 0 δ := ⟨hu.1, hle⟩
          have hm2 : u ∉ Set.Ioc δ Real.pi := fun h ↦ hle.not_gt h.1
          rw [Set.indicator_of_mem hm1, Set.indicator_of_notMem hm2, add_zero,
            ENNReal.ofReal_mul (hQ_nn u hu)]
          gcongr
          exact hball_small u hm1
        · have hm1 : u ∉ Set.Icc 0 δ := fun h ↦ hgt.not_ge h.2
          have hm2 : u ∈ Set.Ioc δ Real.pi := ⟨hgt, hu.2⟩
          rw [Set.indicator_of_notMem hm1, Set.indicator_of_mem hm2, zero_add]
          exact mul_le_mul_of_nonneg_left
            (measure_mono (Metric.closedBall_subset_closedBall hu.2)) zero_le
      have hm_near : Measurable (Set.indicator (Set.Icc 0 δ)
          (fun u ↦ ENNReal.ofReal (Q u * (2 * η * u)))) :=
        (ENNReal.measurable_ofReal.comp (hQ_cont.mul (continuous_const.mul continuous_id)).measurable).indicator
          measurableSet_Icc
      rw [lintegral_add_left hm_near] at h1
      have hnear_eq :
          (∫⁻ u, Set.indicator (Set.Icc 0 δ)
              (fun u ↦ ENNReal.ofReal (Q u * (2 * η * u))) u ∂μ₀) =
            ENNReal.ofReal (2 * η * ∫ u in (0 : ℝ)..δ, Q u * u) := by
        have hinter : Set.Icc 0 Real.pi ∩ Set.Icc 0 δ = Set.Icc 0 δ :=
          Set.inter_eq_self_of_subset_right (Set.Icc_subset_Icc_right hδ_le_pi)
        have hint_qu : IntegrableOn (fun u ↦ 2 * η * (Q u * u)) (Set.Icc 0 δ) MeasureTheory.volume :=
          ((hQ_cont.mul continuous_id).const_mul (2 * η)).integrableOn_Icc
        have hnn_qu : 0 ≤ᵐ[MeasureTheory.volume.restrict (Set.Icc 0 δ)]
            fun u ↦ 2 * η * (Q u * u) :=
          ae_restrict_of_forall_mem measurableSet_Icc fun u hu ↦
            mul_nonneg (by positivity)
              (mul_nonneg (hQ_nn u ⟨hu.1, hu.2.trans hδ_le_pi⟩) hu.1)
        rw [lintegral_indicator measurableSet_Icc, Measure.restrict_restrict measurableSet_Icc,
          Set.inter_comm, hinter]
        have hmul_eq : (fun u ↦ ENNReal.ofReal (Q u * (2 * η * u))) =
            fun u ↦ ENNReal.ofReal (2 * η * (Q u * u)) := by
          ext u; congr 1; ring
        rw [hmul_eq, ← ofReal_integral_eq_lintegral_ofReal hint_qu hnn_qu,
          integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hδ_pos.le,
          intervalIntegral.integral_const_mul]
      have hfar_eq :
          (∫⁻ u, Set.indicator (Set.Ioc δ Real.pi)
              (fun u ↦ ENNReal.ofReal (Q u) * ν (Metric.closedBall θ₀ Real.pi)) u ∂μ₀) =
            ENNReal.ofReal (∫ u in δ..Real.pi, Q u) * ν (Metric.closedBall θ₀ Real.pi) := by
        have hinter : Set.Icc 0 Real.pi ∩ Set.Ioc δ Real.pi = Set.Ioc δ Real.pi :=
          Set.inter_eq_self_of_subset_right (fun u hu ↦ ⟨hδ_pos.le.trans hu.1.le, hu.2⟩)
        have hint_q : IntegrableOn Q (Set.Ioc δ Real.pi) MeasureTheory.volume :=
          hQ_cont.integrableOn_Icc.mono_set Set.Ioc_subset_Icc_self
        have hnn_q : 0 ≤ᵐ[MeasureTheory.volume.restrict (Set.Ioc δ Real.pi)] Q :=
          ae_restrict_of_forall_mem measurableSet_Ioc fun u hu ↦
            hQ_nn u ⟨hδ_pos.le.trans hu.1.le, hu.2⟩
        rw [lintegral_indicator measurableSet_Ioc, Measure.restrict_restrict measurableSet_Ioc,
          Set.inter_comm, hinter,
          lintegral_mul_const _ hQ_cont.measurable.ennreal_ofReal,
          ← ofReal_integral_eq_lintegral_ofReal hint_q hnn_q,
          ← intervalIntegral.integral_of_le hδ_le_pi]
      rwa [hnear_eq, hfar_eq] at h1
    -- Step 5: Combine `P(π) + ∫_δ^π Q = P(δ)` and `∫_0^δ Q(u) * u ≤ π`
    have hQu_le_pi : (∫ u in (0 : ℝ)..δ, Q u * u) ≤ Real.pi := by
      have hprod_deriv : ∀ u : ℝ,
          HasDerivAt (fun x ↦ P x * x) (-Q u * u + P u) u := by
        intro u
        refine ((hasDerivAt_poissonKernelC hr0 hr1 u).mul (hasDerivAt_id' u)).congr_deriv ?_
        dsimp [P, Q]; ring
      have hcont_f1 : Continuous (fun u ↦ -Q u * u) := hQ_cont.neg.mul continuous_id
      have hcont_f2 : Continuous P := RudinRCA.Chapter11.continuous_poissonKernel hr0 hr1
      have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt
        (fun u _ ↦ hprod_deriv u) ((hcont_f1.add hcont_f2).intervalIntegrable 0 δ)
      rw [intervalIntegral.integral_add
        (hcont_f1.intervalIntegrable 0 δ) (hcont_f2.intervalIntegrable 0 δ)] at hftc
      have hneg_mul : (∫ u in (0 : ℝ)..δ, -Q u * u) = -∫ u in (0 : ℝ)..δ, Q u * u := by
        simp_rw [neg_mul]; exact intervalIntegral.integral_neg
      rw [hneg_mul, mul_zero, sub_zero] at hftc
      have hPδ_nn : 0 ≤ P δ * δ :=
        mul_nonneg (RudinRCA.Chapter11.node11_5_pos hr0 hr1 δ).le hδ_pos.le
      have hP_le_pi : (∫ u in (0 : ℝ)..δ, P u) ≤ Real.pi := by
        rw [← poissonKernel_half_integralC hr0 hr1,
          ← intervalIntegral.integral_add_adjacent_intervals
            (hcont_f2.intervalIntegrable 0 δ) (hcont_f2.intervalIntegrable δ Real.pi)]
        have hrest : 0 ≤ ∫ u in δ..Real.pi, P u :=
          intervalIntegral.integral_nonneg hδ_le_pi fun u _ ↦
            (RudinRCA.Chapter11.node11_5_pos hr0 hr1 u).le
        linarith
      linarith
    have hPδ_eq : ENNReal.ofReal (P Real.pi) * ν (Metric.closedBall θ₀ Real.pi) +
        ENNReal.ofReal (∫ u in δ..Real.pi, Q u) * ν (Metric.closedBall θ₀ Real.pi) =
        ENNReal.ofReal (P δ * ν.real (Metric.closedBall θ₀ Real.pi)) := by
      have h1 : 0 ≤ P Real.pi := (RudinRCA.Chapter11.node11_5_pos hr0 hr1 Real.pi).le
      have h2 : 0 ≤ ∫ u in δ..Real.pi, Q u :=
        intervalIntegral.integral_nonneg hδ_le_pi fun u hu ↦
          hQ_nn u ⟨hδ_pos.le.trans hu.1, hu.2⟩
      rw [← add_mul, ← ENNReal.ofReal_add h1 h2,
        ← poissonKernel_eq_pi_add_integralC hr0 hr1,
        ← ENNReal.ofReal_toReal (measure_ne_top ν (Metric.closedBall θ₀ Real.pi)),
        ← ENNReal.ofReal_mul (RudinRCA.Chapter11.node11_5_pos hr0 hr1 δ).le]
      rfl
    have htot_ennreal : ENNReal.ofReal (∫ η, _root_.poissonKernel 0 z (circlePoint η) ∂μ) ≤
        ENNReal.ofReal (2 * η * Real.pi + P δ * ν.real (Metric.closedBall θ₀ Real.pi)) := by
      calc ENNReal.ofReal (∫ η, _root_.poissonKernel 0 z (circlePoint η) ∂μ)
          ≤ ∫⁻ t, gP t ∂ν₀ := hlint_le_cb
        _ = ENNReal.ofReal (P Real.pi) * ν (Metric.closedBall θ₀ Real.pi) +
              ∫⁻ u, ENNReal.ofReal (Q u) * ν (Metric.closedBall θ₀ u) ∂μ₀ := htonelli
        _ ≤ ENNReal.ofReal (P Real.pi) * ν (Metric.closedBall θ₀ Real.pi) +
              (ENNReal.ofReal (2 * η * ∫ u in (0 : ℝ)..δ, Q u * u) +
                ENNReal.ofReal (∫ u in δ..Real.pi, Q u) * ν (Metric.closedBall θ₀ Real.pi)) :=
            add_le_add_right hsplit_u _
        _ = ENNReal.ofReal (2 * η * ∫ u in (0 : ℝ)..δ, Q u * u) +
              (ENNReal.ofReal (P Real.pi) * ν (Metric.closedBall θ₀ Real.pi) +
                ENNReal.ofReal (∫ u in δ..Real.pi, Q u) * ν (Metric.closedBall θ₀ Real.pi)) := by
            ac_rfl
        _ = ENNReal.ofReal (2 * η * ∫ u in (0 : ℝ)..δ, Q u * u) +
              ENNReal.ofReal (P δ * ν.real (Metric.closedBall θ₀ Real.pi)) := by
            rw [hPδ_eq]
        _ ≤ ENNReal.ofReal (2 * η * Real.pi) +
              ENNReal.ofReal (P δ * ν.real (Metric.closedBall θ₀ Real.pi)) :=
            add_le_add_left (ENNReal.ofReal_le_ofReal
              (mul_le_mul_of_nonneg_left hQu_le_pi (by positivity))) _
        _ = ENNReal.ofReal (2 * η * Real.pi + P δ * ν.real (Metric.closedBall θ₀ Real.pi)) := by
            rw [← ENNReal.ofReal_add (by positivity)
              (mul_nonneg (RudinRCA.Chapter11.node11_5_pos hr0 hr1 δ).le measureReal_nonneg)]
    have htot_real : ∫ η, _root_.poissonKernel 0 z (circlePoint η) ∂μ ≤
        2 * η * Real.pi + P δ * ν.real (Metric.closedBall θ₀ Real.pi) :=
      (ENNReal.ofReal_le_ofReal_iff
        (add_nonneg (by positivity)
          (mul_nonneg (RudinRCA.Chapter11.node11_5_pos hr0 hr1 δ).le measureReal_nonneg))).mp
        htot_ennreal
    have htail_lt : P δ * ν.real (Metric.closedBall θ₀ Real.pi) < ε / 2 := by
      rw [Real.dist_eq, sub_zero] at htail_r
      exact (le_abs_self _).trans_lt htail_r
    have hnear_half : 2 * η * Real.pi = ε / 2 := by
      dsimp [η]; field_simp; ring
    rw [Real.dist_eq, sub_zero, abs_of_nonneg hintP_nn]
    linarith
  · -- `(←)` Lebesgue decomposition `circleMeasure.withDensity (μ.rnDeriv circleMeasure) ≤ μ`
    intro hlim
    have hle_meas : circleMeasure.withDensity (μ.rnDeriv circleMeasure) ≤ μ :=
      Measure.withDensity_rnDeriv_le μ circleMeasure
    have hrn_int : Integrable (fun η ↦ (μ.rnDeriv circleMeasure η).toReal) circleMeasure :=
      Measure.integrable_toReal_rnDeriv
    have hrn_rad := ae_tendsto_circlePoissonIntegral hrn_int
    have hae_zero : μ.rnDeriv circleMeasure =ᵐ[circleMeasure] 0 := by
      filter_upwards [hlim, hrn_rad, Measure.rnDeriv_lt_top μ circleMeasure] with ζ hμ0 hrad htop
      have hle0 : (μ.rnDeriv circleMeasure ζ).toReal ≤ 0 := by
        refine le_of_tendsto_of_tendsto hrad hμ0 ?_
        filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
        let z : ℂ := (r : ℂ) * circlePoint ζ
        have hz : z ∈ Metric.ball (0 : ℂ) 1 := by
          simpa [z, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos hr.1] using hr.2
        have hcontP := continuous_poissonKernel_circlePoint hz
        obtain ⟨B, hB⟩ := isCompact_univ.exists_bound_of_continuousOn hcontP.continuousOn
        have hint_μ : Integrable (fun η ↦ _root_.poissonKernel 0 z (circlePoint η)) μ :=
          Integrable.of_bound hcontP.aestronglyMeasurable B
            (Eventually.of_forall fun η ↦ hB η (mem_univ η))
        have hwd_eq : circlePoissonIntegral (fun η ↦ (μ.rnDeriv circleMeasure η).toReal) z =
            ∫ η, _root_.poissonKernel 0 z (circlePoint η)
              ∂(circleMeasure.withDensity (μ.rnDeriv circleMeasure)) := by
          rw [integral_withDensity_eq_integral_toReal_smul
            (Measure.measurable_rnDeriv μ circleMeasure)
            (Measure.rnDeriv_lt_top μ circleMeasure)]
          refine integral_congr_ae (Eventually.of_forall fun η ↦ ?_)
          simp only [smul_eq_mul, mul_comm]
        rw [hwd_eq]
        exact integral_mono_measure hle_meas
          (Eventually.of_forall fun η ↦ poissonKernel_circlePoint_nonneg hz η) hint_μ
      have hge0 : 0 ≤ (μ.rnDeriv circleMeasure ζ).toReal := ENNReal.toReal_nonneg
      have heq0 : (μ.rnDeriv circleMeasure ζ).toReal = 0 := le_antisymm hle0 hge0
      exact (ENNReal.toReal_eq_zero_iff _).mp heq0 |>.resolve_right htop.ne
    exact (Measure.rnDeriv_eq_zero μ circleMeasure).mp hae_zero

/-- `singularInnerFactor μ` is an inner function iff `μ ⟂ₘ circleMeasure` (RCA p. 343). -/
theorem isInnerFunction_singularInnerFactor_iff (μ : Measure FourierCircle) [IsFiniteMeasure μ] :
    IsInnerFunction (singularInnerFactor μ) ↔ (μ ⟂ₘ circleMeasure) := by
  have hholo := holomorphicOn_singularInnerFactor μ
  have hbdd : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖singularInnerFactor μ z‖ ≤ 1 :=
    fun z hz ↦ norm_singularInnerFactor_le_one μ hz
  obtain ⟨hae_lim, _⟩ := bounded_holomorphic_radialBoundaryLimit hholo hbdd
  rw [singular_iff_ae_tendsto_measurePoissonIntegral_zero μ]
  constructor
  · intro ⟨_, _, hae_norm1⟩
    filter_upwards [hae_lim, hae_norm1] with ζ hlim hnorm1
    have hnorm_lim : Tendsto (fun r : ℝ ↦ ‖radialSlice (singularInnerFactor μ) r ζ‖)
        (𝓝[<] 1) (𝓝 1) := by
      simpa [hnorm1] using hlim.norm
    have hlog_lim : Tendsto (fun r : ℝ ↦ -Real.log ‖radialSlice (singularInnerFactor μ) r ζ‖)
        (𝓝[<] 1) (𝓝 0) := by
      simpa using ((Real.continuousAt_log one_ne_zero).tendsto.comp hnorm_lim).neg
    refine hlog_lim.congr' ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    have hz : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hr.1] using hr.2
    simp [radialSlice, norm_singularInnerFactor μ hz, Real.log_exp]
  · intro hae_p0
    refine ⟨hholo, hbdd, ?_⟩
    filter_upwards [hae_lim, hae_p0] with ζ hlim hp0
    have hexp_lim : Tendsto (fun r : ℝ ↦ ‖radialSlice (singularInnerFactor μ) r ζ‖)
        (𝓝[<] 1) (𝓝 1) := by
      have hp0_neg : Tendsto
          (fun r : ℝ ↦ -∫ η, _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ)
            (circlePoint η) ∂μ)
          (𝓝[<] 1) (𝓝 0) := by
        simpa using hp0.neg
      have h1 : Tendsto
          (fun r : ℝ ↦ Real.exp (-∫ η, _root_.poissonKernel 0 ((r : ℂ) * circlePoint ζ)
            (circlePoint η) ∂μ))
          (𝓝[<] 1) (𝓝 1) := by
        simpa only [Function.comp_def, Real.exp_zero] using
          (Real.continuous_exp.tendsto 0).comp hp0_neg
      refine h1.congr' ?_
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
      have hz : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hr.1] using hr.2
      exact (norm_singularInnerFactor μ hz).symm
    exact tendsto_nhds_unique hlim.norm hexp_lim

theorem isInNevanlinnaClassCh17_of_bounded_holomorphic {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {C : ℝ}
    (hbdd : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ ≤ C) :
    IsInNevanlinnaClassCh17 f := by
  refine ⟨hf, ?_⟩
  let M : ℝ := max 1 C
  have hle : hardySizeENNReal 0 f ≤ ENNReal.ofReal M := by
    refine iSup₂_le fun r hr ↦ ?_
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize]
    refine ENNReal.ofReal_le_ofReal ?_
    have hM_pos : 0 < M := lt_of_lt_of_le zero_lt_one (le_max_left 1 C)
    rw [← Real.exp_log hM_pos, Real.exp_le_exp]
    have hcont := continuous_radialSlice_of_holomorphicOn hf hr.1 hr.2
    have hcont_pl : Continuous (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) :=
      Real.continuous_posLog.comp hcont.norm
    have hint : Integrable (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) circleMeasure :=
      (memLp_circleMeasure_of_continuous hcont_pl 1).integrable le_rfl
    calc (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure)
        ≤ ∫ _, Real.log M ∂circleMeasure := by
          refine integral_mono hint (integrable_const (Real.log M)) fun ζ ↦ ?_
          have hz : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
            simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hr.1] using hr.2
          have h1 : ‖radialSlice f r ζ‖ ≤ M := (hbdd _ hz).trans (le_max_right 1 C)
          rcases le_or_gt ‖radialSlice f r ζ‖ 1 with hle1 | hgt1
          · rw [(Real.posLog_eq_zero_iff _).mpr (by rwa [abs_of_nonneg (norm_nonneg _)])]
            exact Real.log_nonneg (le_max_left 1 C)
          · rw [Real.posLog_eq_log (by rw [abs_of_nonneg (norm_nonneg _)]; exact hgt1.le)]
            exact Real.log_le_log (zero_lt_one.trans hgt1) h1
      _ = Real.log M := by simp
  exact hle.trans_lt ENNReal.ofReal_lt_top

/-- **Theorem 17.15 (Characterization of Inner Functions, RCA pp. 342–343):**
A function `M : ℂ → ℂ` is an inner function (`IsInnerFunction M`) if and only if there exist a
constant `c : ℂ` with `‖c‖ = 1`, a Blaschke product `B`, and a finite Borel measure `μ` on `T`
mutually singular with respect to `circleMeasure` (`μ ⟂ₘ circleMeasure`) such that
`M z = c * B z * singularInnerFactor μ z` for every `z ∈ U = Metric.ball 0 1`. -/
theorem theorem17_15 (hPartB : HardyPartBInterface) {M : ℂ → ℂ} :
    IsInnerFunction M ↔
      ∃ (c : ℂ) (B : ℂ → ℂ) (μ : Measure FourierCircle),
        ‖c‖ = 1 ∧
        RudinRCA.Chapter15.IsBlaschkeProduct B ∧
        IsFiniteMeasure μ ∧
        (μ ⟂ₘ circleMeasure) ∧
        ∀ z ∈ Metric.ball (0 : ℂ) 1, M z = c * B z * singularInnerFactor μ z := by
  constructor
  · intro hM
    have hex_nz : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, M z₀ ≠ 0 := hM.nonzero_on_ball
    -- Divide out the Blaschke product `B` via `hPartB.blaschke_div`
    have hM_nev := isInNevanlinnaClassCh17_of_bounded_holomorphic hM.1 hM.2.1
    obtain ⟨B, g, hB, hg_nev, hg_nz, hMBg, _, hHp_iff⟩ := hPartB.blaschke_div hM_nev hex_nz
    -- Show `g` is bounded by `1` on `ball 0 1` (`hardySizeENNReal ⊤ g = hardySizeENNReal ⊤ M ≤ 1`)
    have hg_le1 : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖g z‖ ≤ 1 := by
      have htop_eq := (hHp_iff ⊤ ENNReal.top_ne_zero).2
      rw [hardySizeENNReal_top_eq_biSup hg_nev.1] at htop_eq
      have hM_le1 : hardySizeENNReal ⊤ M ≤ 1 := by
        rw [hardySizeENNReal_top_eq_biSup hM.1]
        refine iSup₂_le fun z hz ↦ ?_
        rw [← ofReal_norm]
        exact (ENNReal.ofReal_le_ofReal (hM.2.1 z hz)).trans_eq ENNReal.ofReal_one
      intro z hz
      have hle : ‖g z‖ₑ ≤ 1 := (le_biSup (fun w ↦ ‖g w‖ₑ) hz).trans (htop_eq.le.trans hM_le1)
      rw [← ofReal_norm, ← ENNReal.ofReal_one] at hle
      exact (ENNReal.ofReal_le_ofReal_iff zero_le_one).mp hle
    -- Show `‖radialBoundaryLimit g ζ‖ = 1` a.e. (`IsInnerFunction g`)
    have hB_inner := isInnerFunction_of_isBlaschkeProduct hB
    obtain ⟨hM_rad, _⟩ := bounded_holomorphic_radialBoundaryLimit hM.1 hM.2.1
    obtain ⟨hB_rad, _⟩ := bounded_holomorphic_radialBoundaryLimit hB_inner.1 hB_inner.2.1
    obtain ⟨hg_rad, _⟩ := bounded_holomorphic_radialBoundaryLimit hg_nev.1 hg_le1
    have hg_norm1 : ∀ᵐ ζ ∂circleMeasure, ‖radialBoundaryLimit g ζ‖ = 1 := by
      filter_upwards [hM_rad, hB_rad, hg_rad, hM.2.2, hB_inner.2.2] with ζ hm hb hg hm1 hb1
      have hprod : Tendsto (fun r : ℝ ↦ radialSlice M r ζ) (𝓝[<] 1)
          (𝓝 (radialBoundaryLimit B ζ * radialBoundaryLimit g ζ)) := by
        refine (hb.mul hg).congr' ?_
        filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
        have hz : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
          simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos hr.1] using hr.2
        exact (hMBg _ hz).symm
      have heq := tendsto_nhds_unique hm hprod
      have hn := congr_arg norm heq
      rw [hm1, norm_mul, hb1, one_mul] at hn
      exact hn.symm
    -- Take holomorphic logarithm `g = exp ∘ L` on `ball 0 1`
    obtain ⟨L, hL_holo, hg_exp⟩ := exists_holomorphic_log_ball hg_nev.1 hg_nz
    have hL_re : ∀ z ∈ Metric.ball (0 : ℂ) 1, (L z).re = Real.log ‖g z‖ := by
      intro z hz
      rw [hg_exp z hz, Complex.norm_exp, Real.log_exp]
    -- Sequence `r_n = 1 - 1 / (n + 2)` and nonnegative `v_n(ζ) = -(L(r_n ζ)).re ≥ 0`
    let r_seq : ℕ → ℝ := fun n ↦ 1 - 1 / ((n : ℝ) + 2)
    have hr_mem : ∀ n : ℕ, r_seq n ∈ Set.Ioo (0 : ℝ) 1 := fun n ↦ by
      dsimp [r_seq]
      have hn : (1 : ℝ) < (n : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) n]
      refine ⟨by linarith [div_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2) |>.mpr hn],
        by linarith [div_pos zero_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2)]⟩
    have hr_tendsto1 : Tendsto r_seq atTop (𝓝 1) := by
      have hdiv : Tendsto (fun n : ℕ ↦ (1 : ℝ) / ((n : ℝ) + 2)) atTop (𝓝 0) :=
        tendsto_const_nhds.div_atTop
          ((tendsto_natCast_atTop_atTop (R := ℝ)).atTop_add tendsto_const_nhds)
      simpa [r_seq] using (tendsto_const_nhds (x := (1 : ℝ))).sub hdiv
    let v : ℕ → FourierCircle → ℝ := fun n ζ ↦ -(L ((r_seq n : ℂ) * circlePoint ζ)).re
    have hv_cont : ∀ n, Continuous (v n) := fun n ↦ by
      refine (Complex.continuous_re.comp
        ((RudinRCA.Chapter10.continuousOn_of_holomorphicOn hL_holo).comp_continuous
          (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_)).neg
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (hr_mem n).1] using (hr_mem n).2
    have hv_int : ∀ n, Integrable (v n) circleMeasure := fun n ↦
      (memLp_circleMeasure_of_continuous (hv_cont n) 1).integrable le_rfl
    have hv_nn : ∀ n ζ, 0 ≤ v n ζ := fun n ζ ↦ by
      have hz : (r_seq n : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (hr_mem n).1] using (hr_mem n).2
      dsimp [v]
      rw [hL_re _ hz, neg_nonneg]
      exact Real.log_nonpos (norm_nonneg _) (hg_le1 _ hz)
    have hv_bdd : ∀ n, ∫ ζ, v n ζ ∂circleMeasure ≤ -(L 0).re := fun n ↦ by
      have h0 := holomorphic_herglotz_radial hL_holo (hr_mem n).1.le (hr_mem n).2
        (Metric.mem_ball_self zero_lt_one)
      have hre0 := congr_arg Complex.re h0
      have hherg0 : (herglotzTransform
          (fun ζ ↦ ((L ((r_seq n : ℂ) * circlePoint ζ)).re : ℂ)) 0).re =
          ∫ ζ, (L ((r_seq n : ℂ) * circlePoint ζ)).re ∂circleMeasure := by
        unfold herglotzTransform
        have hker1 : (fun ζ : FourierCircle ↦
            ((circlePoint ζ + 0) / (circlePoint ζ - 0)) *
              ((L ((r_seq n : ℂ) * circlePoint ζ)).re : ℂ)) =
            fun ζ ↦ ((L ((r_seq n : ℂ) * circlePoint ζ)).re : ℂ) := by
          ext ζ
          rw [add_zero, sub_zero, div_self (circlePoint_ne_zero ζ), one_mul]
        have hint_rn : Integrable (fun ζ ↦ (L ((r_seq n : ℂ) * circlePoint ζ)).re) circleMeasure := by
          simpa [v] using (hv_int n).neg
        have hof : (∫ ζ, ((L ((r_seq n : ℂ) * circlePoint ζ)).re : ℂ) ∂circleMeasure) =
            ((∫ ζ, (L ((r_seq n : ℂ) * circlePoint ζ)).re ∂circleMeasure : ℝ) : ℂ) :=
          Complex.ofRealCLM.integral_comp_comm hint_rn
        rw [hker1, hof]
        exact Complex.ofReal_re _
      simp only [mul_zero, Complex.add_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
        Complex.I_re, Complex.I_im, hherg0] at hre0
      dsimp [v]
      rw [integral_neg]
      linarith
    obtain ⟨φ, μ, hφ_mono, hμ_fin, _, _, hμ_limC⟩ :=
      exists_subseq_measure_of_nonneg_l1_bounded hv_int hv_nn hv_bdd
    let c : ℂ := Complex.exp (((L 0).im : ℂ) * Complex.I)
    have hc_norm : ‖c‖ = 1 := Complex.norm_exp_ofReal_mul_I (L 0).im
    have hg_eq : ∀ z ∈ Metric.ball (0 : ℂ) 1, g z = c * singularInnerFactor μ z := by
      intro z hz
      have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
      let H_z : FourierCircle → ℂ := fun ζ ↦ (circlePoint ζ + z) / (circlePoint ζ - z)
      have hHz_cont : Continuous H_z := by
        refine Continuous.div (by fun_prop) (by fun_prop) fun ζ ↦ ?_
        intro h0
        have heq := sub_eq_zero.mp h0
        rw [← heq, norm_circlePoint] at hz_lt
        exact lt_irrefl 1 hz_lt
      have hLHS_lim : Tendsto (fun k ↦ L ((r_seq (φ k) : ℂ) * z)) atTop (𝓝 (L z)) := by
        have hrz : Tendsto (fun k ↦ (r_seq (φ k) : ℂ) * z) atTop (𝓝 z) := by
          simpa using ((Complex.continuous_ofReal.tendsto 1).comp
            (hr_tendsto1.comp hφ_mono.tendsto_atTop)).mul_const z
        exact (hL_holo z hz).continuousAt.tendsto.comp hrz
      have hRHS_lim : Tendsto
          (fun k ↦ ((L 0).im : ℂ) * Complex.I -
            ∫ ζ, H_z ζ * (v (φ k) ζ : ℂ) ∂circleMeasure)
          atTop (𝓝 (((L 0).im : ℂ) * Complex.I - ∫ ζ, H_z ζ ∂μ)) :=
        tendsto_const_nhds.sub (hμ_limC H_z hHz_cont)
      have heq_seq : ∀ k, L ((r_seq (φ k) : ℂ) * z) =
          ((L 0).im : ℂ) * Complex.I - ∫ ζ, H_z ζ * (v (φ k) ζ : ℂ) ∂circleMeasure := by
        intro k
        rw [holomorphic_herglotz_radial hL_holo (hr_mem (φ k)).1.le (hr_mem (φ k)).2 hz]
        dsimp [herglotzTransform, H_z, v]
        rw [sub_eq_add_neg, ← integral_neg]
        congr 1
        refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
        push_cast; ring
      have hLz : L z = ((L 0).im : ℂ) * Complex.I - ∫ ζ, H_z ζ ∂μ :=
        tendsto_nhds_unique hLHS_lim (hRHS_lim.congr' (Eventually.of_forall fun k ↦ (heq_seq k).symm))
      rw [hg_exp z hz, hLz, sub_eq_add_neg, Complex.exp_add]
      rfl
    -- Show `μ ⟂ₘ circleMeasure` since `g = c * singularInnerFactor μ` is inner (`‖c‖ = 1`)
    have hS_inner : IsInnerFunction (singularInnerFactor μ) := by
      have hg_inner : IsInnerFunction g := ⟨hg_nev.1, hg_le1, hg_norm1⟩
      have hc_inv_inner : IsInnerFunction (fun _ ↦ c⁻¹) :=
        isInnerFunction_const (by rw [norm_inv, hc_norm, inv_one])
      refine IsInnerFunction.congr_ball (fun z hz ↦ ?_) (hc_inv_inner.mul hg_inner)
      have hc_ne : c ≠ 0 := norm_ne_zero_iff.mp (hc_norm ▸ one_ne_zero)
      rw [hg_eq z hz, ← mul_assoc, inv_mul_cancel₀ hc_ne, one_mul]
    have hμ_sing : μ ⟂ₘ circleMeasure :=
      (isInnerFunction_singularInnerFactor_iff μ).mp hS_inner
    refine ⟨c, B, μ, hc_norm, hB, hμ_fin, hμ_sing, fun z hz ↦ ?_⟩
    rw [hMBg z hz, hg_eq z hz]
    ring
  · rintro ⟨c, B, μ, hc, hB, hμ_fin, hμ_sing, hM_eq⟩
    have h1 := isInnerFunction_const hc
    have h2 := isInnerFunction_of_isBlaschkeProduct hB
    have h3 := (isInnerFunction_singularInnerFactor_iff μ).mpr hμ_sing
    exact IsInnerFunction.congr_ball (fun z hz ↦ (hM_eq z hz).symm) ((h1.mul h2).mul h3)

/-! ### `Real.posLog` Estimates, `H^p ⊆ N` (`0 < p ≤ ∞`), and Section 17.19 (RCA pp. 345–346) -/

theorem posLog_eq_max_zero_log {x : ℝ} (hx : 0 ≤ x) :
    Real.posLog x = max 0 (Real.log x) := by
  rcases le_or_gt x 1 with hx1 | hx1
  · rw [(Real.posLog_eq_zero_iff x).mpr (by rwa [abs_of_nonneg hx]),
      max_eq_left (Real.log_nonpos hx hx1)]
  · rw [Real.posLog_eq_log (by rw [abs_of_nonneg hx]; exact hx1.le),
      max_eq_right (Real.log_pos hx1).le]

theorem posLog_mono_nonneg {x y : ℝ} (hx : 0 ≤ x) (hxy : x ≤ y) :
    Real.posLog x ≤ Real.posLog y := by
  rw [posLog_eq_max_zero_log hx, posLog_eq_max_zero_log (hx.trans hxy)]
  rcases le_or_gt x 1 with hx1 | hx1
  · rw [max_eq_left (Real.log_nonpos hx hx1)]
    exact le_max_left 0 _
  · exact max_le_max_left 0 (Real.log_le_log (zero_lt_one.trans hx1) hxy)

theorem posLog_sub_posLog_abs_le {x y : ℝ} (hx : 0 ≤ x) (hy : 0 ≤ y) :
    |Real.posLog x - Real.posLog y| ≤ |x - y| := by
  wlog hxy : x ≤ y generalizing x y
  · rw [abs_sub_comm, abs_sub_comm x y]
    exact this hy hx (le_of_not_ge hxy)
  have hdiff_nn : 0 ≤ Real.posLog y - Real.posLog x :=
    sub_nonneg.mpr (posLog_mono_nonneg hx hxy)
  rw [abs_sub_comm, abs_of_nonneg hdiff_nn, abs_sub_comm x y, abs_of_nonneg (sub_nonneg.mpr hxy)]
  rcases le_or_gt y 1 with hy1 | hy1
  · rw [(Real.posLog_eq_zero_iff y).mpr (by rwa [abs_of_nonneg hy]),
      (Real.posLog_eq_zero_iff x).mpr (by rw [abs_of_nonneg hx]; exact hxy.trans hy1), sub_zero]
    linarith
  · rcases le_or_gt x 1 with hx1 | hx1
    · rw [(Real.posLog_eq_zero_iff x).mpr (by rwa [abs_of_nonneg hx]), sub_zero,
        Real.posLog_eq_log (by rw [abs_of_nonneg hy]; exact hy1.le)]
      exact (Real.log_le_sub_one_of_pos (zero_lt_one.trans hy1)).trans (by linarith)
    · have hx_pos : 0 < x := zero_lt_one.trans hx1
      have hy_pos : 0 < y := zero_lt_one.trans hy1
      rw [Real.posLog_eq_log (by rw [abs_of_nonneg hy]; exact hy1.le),
        Real.posLog_eq_log (by rw [abs_of_nonneg hx]; exact hx1.le),
        ← Real.log_div hy_pos.ne' hx_pos.ne']
      calc Real.log (y / x)
          ≤ y / x - 1 := Real.log_le_sub_one_of_pos (div_pos hy_pos hx_pos)
        _ = (y - x) / x := by field_simp [hx_pos.ne']
        _ ≤ (y - x) / 1 := div_le_div_of_nonneg_left (sub_nonneg.mpr hxy) zero_lt_one hx1.le
        _ = y - x := div_one _

theorem posLog_le_rpow_div {q : ℝ} (hq : 0 < q) {x : ℝ} (hx : 0 ≤ x) :
    Real.posLog x ≤ x ^ q / q := by
  rcases le_or_gt x 1 with hx1 | hx1
  · rw [(Real.posLog_eq_zero_iff x).mpr (by rwa [abs_of_nonneg hx])]
    exact div_nonneg (Real.rpow_nonneg hx q) hq.le
  · have hx_pos : 0 < x := zero_lt_one.trans hx1
    rw [Real.posLog_eq_log (by rw [abs_of_nonneg hx]; exact hx1.le)]
    have hlog_pow : Real.log (x ^ q) = q * Real.log x := Real.log_rpow hx_pos q
    have hle1 : q * Real.log x ≤ x ^ q - 1 := by
      rw [← hlog_pow]
      exact Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos hx_pos q)
    exact (le_div_iff₀' hq).mpr (hle1.trans (by linarith))

/-- Every Hardy space `H^p` (`0 < p ≤ ∞`) is contained in the Nevanlinna class `N`. -/
theorem IsInHardySpace.toNevanlinna {p : ℝ≥0∞} {f : ℂ → ℂ} (hf : IsInHardySpace p f) :
    IsInNevanlinnaClassCh17 f := by
  rcases eq_or_ne p ⊤ with rfl | hptop
  · obtain ⟨hholo, M, hM⟩ := (isInHardySpace_top_iff f).mp hf
    exact isInNevanlinnaClassCh17_of_bounded_holomorphic hholo fun z hz ↦ hM ⟨z, hz, rfl⟩
  · refine ⟨hf.2.1, ?_⟩
    have hq_pos : 0 < p.toReal := ENNReal.toReal_pos hf.1 hptop
    let C : ℝ := Real.exp ((hardySize p f) ^ p.toReal / p.toReal)
    have hle : hardySizeENNReal 0 f ≤ ENNReal.ofReal C := by
      refine iSup₂_le fun r hr ↦ ?_
      simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize]
      refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
      have hcont := continuous_radialSlice_of_holomorphicOn hf.2.1 hr.1 hr.2
      have hcont_pl : Continuous (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) :=
        Real.continuous_posLog.comp hcont.norm
      have hint_pl : Integrable (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) circleMeasure :=
        (memLp_circleMeasure_of_continuous hcont_pl 1).integrable le_rfl
      have hmem_r : MemLp (radialSlice f r) p circleMeasure :=
        memLp_circleMeasure_of_continuous hcont p
      have hint_rpow : Integrable (fun ζ ↦ ‖radialSlice f r ζ‖ ^ p.toReal) circleMeasure :=
        hmem_r.integrable_norm_rpow hf.1 hptop
      have hint_le : (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) ≤
          (∫ ζ, ‖radialSlice f r ζ‖ ^ p.toReal ∂circleMeasure) / p.toReal := by
        rw [← integral_div]
        exact integral_mono hint_pl (hint_rpow.div_const p.toReal) fun ζ ↦
          posLog_le_rpow_div hq_pos (norm_nonneg _)
      have hrad_le : radialSize p f r ≤ hardySize p f :=
        ENNReal.toReal_mono hf.2.2.ne (le_biSup (radialSizeENNReal p f) hr)
      have hrad_eq : ∫ ζ, ‖radialSlice f r ζ‖ ^ p.toReal ∂circleMeasure =
          (radialSize p f r) ^ p.toReal := by
        unfold radialSize radialSizeENNReal
        rw [ite_eq_right_iff.mpr fun h ↦ (hf.1 h).elim,
          hmem_r.eLpNorm_eq_integral_rpow_norm hf.1 hptop]
        have hint_nn : 0 ≤ ∫ ζ, ‖radialSlice f r ζ‖ ^ p.toReal ∂circleMeasure :=
          integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _
        rw [ENNReal.toReal_ofReal (Real.rpow_nonneg hint_nn _),
          ← Real.rpow_mul hint_nn, inv_mul_cancel₀ hq_pos.ne', Real.rpow_one]
      calc (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure)
          ≤ (radialSize p f r) ^ p.toReal / p.toReal := by rwa [hrad_eq] at hint_le
        _ ≤ (hardySize p f) ^ p.toReal / p.toReal :=
            div_le_div_of_nonneg_right
              (Real.rpow_le_rpow ENNReal.toReal_nonneg hrad_le hq_pos.le) hq_pos.le
    exact hle.trans_lt ENNReal.ofReal_lt_top

theorem posLog_norm_sub_le (a b : ℂ) :
    Real.posLog ‖a - b‖ ≤ Real.log 2 + Real.posLog ‖a‖ + Real.posLog ‖b‖ := by
  let M : ℝ := max 1 (max ‖a‖ ‖b‖)
  have hM_ge1 : 1 ≤ M := le_max_left 1 _
  have hsub_le : ‖a - b‖ ≤ 2 * M := by
    calc ‖a - b‖
        ≤ ‖a‖ + ‖b‖ := norm_sub_le a b
      _ ≤ M + M := add_le_add
          ((le_max_left ‖a‖ ‖b‖).trans (le_max_right 1 _))
          ((le_max_right ‖a‖ ‖b‖).trans (le_max_right 1 _))
      _ = 2 * M := (two_mul M).symm
  have hpl_le : Real.posLog ‖a - b‖ ≤ Real.log 2 + Real.log M := by
    calc Real.posLog ‖a - b‖
        ≤ Real.posLog (2 * M) := posLog_mono_nonneg (norm_nonneg _) hsub_le
      _ = Real.log (2 * M) := by
          refine Real.posLog_eq_log ?_
          rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ 2 * M)]
          linarith
      _ = Real.log 2 + Real.log M := Real.log_mul two_ne_zero (zero_lt_one.trans_le hM_ge1).ne'
  have hlogM_le : Real.log M ≤ Real.posLog ‖a‖ + Real.posLog ‖b‖ := by
    rcases le_or_gt (max ‖a‖ ‖b‖) 1 with hle1 | hgt1
    · have hM1 : M = 1 := max_eq_left hle1
      rw [hM1, Real.log_one]
      exact add_nonneg Real.posLog_nonneg Real.posLog_nonneg
    · have hM_eq : M = max ‖a‖ ‖b‖ := max_eq_right hgt1.le
      rw [hM_eq]
      rcases le_total ‖a‖ ‖b‖ with hab | hba
      · have hb1 : 1 < ‖b‖ := by rwa [max_eq_right hab] at hgt1
        rw [max_eq_right hab,
          ← Real.posLog_eq_log (by rw [abs_of_nonneg (norm_nonneg _)]; exact hb1.le)]
        linarith [Real.posLog_nonneg (x := ‖a‖)]
      · have ha1 : 1 < ‖a‖ := by rwa [max_eq_left hba] at hgt1
        rw [max_eq_left hba,
          ← Real.posLog_eq_log (by rw [abs_of_nonneg (norm_nonneg _)]; exact ha1.le)]
        linarith [Real.posLog_nonneg (x := ‖b‖)]
  linarith

theorem IsInNevanlinnaClassCh17.sub {f g : ℂ → ℂ}
    (hf : IsInNevanlinnaClassCh17 f) (hg : IsInNevanlinnaClassCh17 g) :
    IsInNevanlinnaClassCh17 (f - g) := by
  refine ⟨fun z hz ↦ (hf.1 z hz).sub (hg.1 z hz), ?_⟩
  let C : ℝ := 2 * max 1 (hardySize 0 f) * max 1 (hardySize 0 g)
  have hle : hardySizeENNReal 0 (f - g) ≤ ENNReal.ofReal C := by
    refine iSup₂_le fun r hr ↦ ?_
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize]
    refine ENNReal.ofReal_le_ofReal ?_
    have hCf_pos : 0 < max 1 (hardySize 0 f) := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
    have hCg_pos : 0 < max 1 (hardySize 0 g) := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
    have hC_pos : 0 < C := by positivity
    rw [← Real.exp_log hC_pos, Real.exp_le_exp]
    have hlogC : Real.log C = Real.log 2 +
        Real.log (max 1 (hardySize 0 f)) + Real.log (max 1 (hardySize 0 g)) := by
      dsimp [C]
      rw [Real.log_mul (mul_pos zero_lt_two hCf_pos).ne' hCg_pos.ne',
        Real.log_mul two_ne_zero hCf_pos.ne']
    rw [hlogC]
    have hcont_fg := continuous_radialSlice_of_holomorphicOn
      (fun z hz ↦ (hf.1 z hz).sub (hg.1 z hz)) hr.1 hr.2
    have hcont_f := continuous_radialSlice_of_holomorphicOn hf.1 hr.1 hr.2
    have hcont_g := continuous_radialSlice_of_holomorphicOn hg.1 hr.1 hr.2
    have hint_fg : Integrable (fun ζ ↦ Real.posLog ‖radialSlice (f - g) r ζ‖) circleMeasure :=
      (memLp_circleMeasure_of_continuous (Real.continuous_posLog.comp hcont_fg.norm) 1).integrable le_rfl
    have hint_f : Integrable (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) circleMeasure :=
      (memLp_circleMeasure_of_continuous (Real.continuous_posLog.comp hcont_f.norm) 1).integrable le_rfl
    have hint_g : Integrable (fun ζ ↦ Real.posLog ‖radialSlice g r ζ‖) circleMeasure :=
      (memLp_circleMeasure_of_continuous (Real.continuous_posLog.comp hcont_g.norm) 1).integrable le_rfl
    have hfg_le : (∫ ζ, Real.posLog ‖radialSlice (f - g) r ζ‖ ∂circleMeasure) ≤
        Real.log 2 + (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) +
          (∫ ζ, Real.posLog ‖radialSlice g r ζ‖ ∂circleMeasure) := by
      have h12 : Integrable (fun ζ ↦ Real.log 2 + Real.posLog ‖radialSlice f r ζ‖) circleMeasure :=
        (integrable_const (Real.log 2)).add hint_f
      have hsum_int : Integrable
          (fun ζ ↦ (Real.log 2 + Real.posLog ‖radialSlice f r ζ‖) +
            Real.posLog ‖radialSlice g r ζ‖) circleMeasure :=
        h12.add hint_g
      have h1 := integral_mono hint_fg hsum_int
        fun ζ ↦ posLog_norm_sub_le (radialSlice f r ζ) (radialSlice g r ζ)
      have h2 : (∫ ζ, ((Real.log 2 + Real.posLog ‖radialSlice f r ζ‖) +
            Real.posLog ‖radialSlice g r ζ‖) ∂circleMeasure) =
          Real.log 2 + (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) +
            (∫ ζ, Real.posLog ‖radialSlice g r ζ‖ ∂circleMeasure) := by
        rw [integral_add h12 hint_g,
          integral_add (integrable_const (Real.log 2)) hint_f,
          integral_const, probReal_univ, one_smul]
      exact h1.trans_eq h2
    have hf_le : (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) ≤
        Real.log (max 1 (hardySize 0 f)) := by
      have hrad : radialZeroSize f r ≤ max 1 (hardySize 0 f) := by
        have hENN : ENNReal.ofReal (radialZeroSize f r) ≤ hardySizeENNReal 0 f := by
          have h0 : radialSizeENNReal 0 f r = ENNReal.ofReal (radialZeroSize f r) := by
            simp [radialSizeENNReal]
          exact h0 ▸ le_biSup (radialSizeENNReal 0 f) hr
        exact ((ENNReal.ofReal_le_iff_le_toReal hf.2.ne).mp hENN).trans (le_max_right 1 _)
      have hlog := Real.log_le_log (Real.exp_pos _) hrad
      rwa [Real.log_exp] at hlog
    have hg_le : (∫ ζ, Real.posLog ‖radialSlice g r ζ‖ ∂circleMeasure) ≤
        Real.log (max 1 (hardySize 0 g)) := by
      have hrad : radialZeroSize g r ≤ max 1 (hardySize 0 g) := by
        have hENN : ENNReal.ofReal (radialZeroSize g r) ≤ hardySizeENNReal 0 g := by
          have h0 : radialSizeENNReal 0 g r = ENNReal.ofReal (radialZeroSize g r) := by
            simp [radialSizeENNReal]
          exact h0 ▸ le_biSup (radialSizeENNReal 0 g) hr
        exact ((ENNReal.ofReal_le_iff_le_toReal hg.2.ne).mp hENN).trans (le_max_right 1 _)
      have hlog := Real.log_le_log (Real.exp_pos _) hrad
      rwa [Real.log_exp] at hlog
    linarith
  exact hle.trans_lt ENNReal.ofReal_lt_top

/-- **17.19(a) (Nevanlinna Herglotz Representation & Bounded Quotient `f = b₁ / b₂`, RCA p. 345):**
Every nonzero function `f` in the Nevanlinna class `N` (`IsInNevanlinnaClassCh17 f`) admits:
1. A Blaschke–Herglotz representation
   `f z = c * B z * exp (∫ ((ζ + z)/(ζ - z)) dμ₁(ζ) - ∫ ((ζ + z)/(ζ - z)) dμ₂(ζ))`
   with `‖c‖ = 1`, `IsBlaschkeProduct B`, and finite positive Borel measures `μ₁, μ₂` on `T`;
2. A quotient representation `f z = b₁ z / b₂ z` on `U = Metric.ball 0 1` where `b₁, b₂` are
   holomorphic and bounded by `1` on `U` and `b₂` is zero-free on `U`;
3. Radial boundary limits `radialBoundaryLimit f ζ ≠ 0` `circleMeasure`-a.e. with
   `Integrable (fun ζ ↦ Real.log ‖radialBoundaryLimit f ζ‖) circleMeasure`. -/
theorem nevanlinna_quotient_and_boundary (hPartB : HardyPartBInterface) {f : ℂ → ℂ}
    (hf : IsInNevanlinnaClassCh17 f)
    (hex_nz : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) :
    (∃ (c : ℂ) (B : ℂ → ℂ) (μ₁ μ₂ : Measure FourierCircle),
      ‖c‖ = 1 ∧
      RudinRCA.Chapter15.IsBlaschkeProduct B ∧
      IsFiniteMeasure μ₁ ∧ IsFiniteMeasure μ₂ ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1,
        f z = c * B z * Complex.exp
          ((∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ₁) -
            (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ₂)))) ∧
    (∃ b₁ b₂ : ℂ → ℂ,
      HolomorphicOn b₁ (Metric.ball (0 : ℂ) 1) ∧
      HolomorphicOn b₂ (Metric.ball (0 : ℂ) 1) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, ‖b₁ z‖ ≤ 1) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, ‖b₂ z‖ ≤ 1) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, b₂ z ≠ 0) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, f z = b₁ z / b₂ z)) ∧
    (∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
    (∀ᵐ ζ ∂circleMeasure, radialBoundaryLimit f ζ ≠ 0) ∧
    Integrable (fun ζ ↦ Real.log ‖radialBoundaryLimit f ζ‖) circleMeasure := by
  obtain ⟨B, g, hB, hg_nev, hg_nz, hfBg, _, _⟩ := hPartB.blaschke_div hf hex_nz
  obtain ⟨L, hL_holo, hg_exp⟩ := exists_holomorphic_log_ball hg_nev.1 hg_nz
  have hL_re : ∀ z ∈ Metric.ball (0 : ℂ) 1, (L z).re = Real.log ‖g z‖ := by
    intro z hz
    rw [hg_exp z hz, Complex.norm_exp, Real.log_exp]
  let r_seq : ℕ → ℝ := fun n ↦ 1 - 1 / ((n : ℝ) + 2)
  have hr_mem : ∀ n : ℕ, r_seq n ∈ Set.Ioo (0 : ℝ) 1 := fun n ↦ by
    dsimp [r_seq]
    have hn : (1 : ℝ) < (n : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) n]
    refine ⟨by linarith [div_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2) |>.mpr hn],
      by linarith [div_pos zero_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2)]⟩
  have hr_tendsto1 : Tendsto r_seq atTop (𝓝 1) := by
    have hdiv : Tendsto (fun n : ℕ ↦ (1 : ℝ) / ((n : ℝ) + 2)) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop
        ((tendsto_natCast_atTop_atTop (R := ℝ)).atTop_add tendsto_const_nhds)
    simpa [r_seq] using (tendsto_const_nhds (x := (1 : ℝ))).sub hdiv
  let v₁ : ℕ → FourierCircle → ℝ := fun n ζ ↦ Real.posLog ‖radialSlice g (r_seq n) ζ‖
  let v₂ : ℕ → FourierCircle → ℝ := fun n ζ ↦
    Real.posLog ‖radialSlice g (r_seq n) ζ‖ - (L ((r_seq n : ℂ) * circlePoint ζ)).re
  have hv₁_cont : ∀ n, Continuous (v₁ n) := fun n ↦
    Real.continuous_posLog.comp
      (continuous_radialSlice_of_holomorphicOn hg_nev.1 (hr_mem n).1.le (hr_mem n).2).norm
  have hLre_cont : ∀ n, Continuous (fun ζ ↦ (L ((r_seq n : ℂ) * circlePoint ζ)).re) := fun n ↦ by
    refine Complex.continuous_re.comp
      ((RudinRCA.Chapter10.continuousOn_of_holomorphicOn hL_holo).comp_continuous
        (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_)
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (hr_mem n).1] using (hr_mem n).2
  have hv₂_cont : ∀ n, Continuous (v₂ n) := fun n ↦ (hv₁_cont n).sub (hLre_cont n)
  have hv₁_int : ∀ n, Integrable (v₁ n) circleMeasure := fun n ↦
    (memLp_circleMeasure_of_continuous (hv₁_cont n) 1).integrable le_rfl
  have hv₂_int : ∀ n, Integrable (v₂ n) circleMeasure := fun n ↦
    (memLp_circleMeasure_of_continuous (hv₂_cont n) 1).integrable le_rfl
  have hv₁_nn : ∀ n ζ, 0 ≤ v₁ n ζ := fun _ _ ↦ Real.posLog_nonneg
  have hv₂_nn : ∀ n ζ, 0 ≤ v₂ n ζ := fun n ζ ↦ by
    have hz : (r_seq n : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (hr_mem n).1] using (hr_mem n).2
    dsimp [v₂]
    rw [hL_re _ hz, posLog_eq_max_zero_log (norm_nonneg _), sub_nonneg]
    exact le_max_right 0 _
  let C₁ : ℝ := Real.log (max 1 (hardySize 0 g))
  have hv₁_bdd : ∀ n, ∫ ζ, v₁ n ζ ∂circleMeasure ≤ C₁ := fun n ↦ by
    have hr_ico : r_seq n ∈ Set.Ico (0 : ℝ) 1 := ⟨(hr_mem n).1.le, (hr_mem n).2⟩
    have hrad : radialZeroSize g (r_seq n) ≤ max 1 (hardySize 0 g) := by
      have hENN : ENNReal.ofReal (radialZeroSize g (r_seq n)) ≤ hardySizeENNReal 0 g := by
        have h0 : radialSizeENNReal 0 g (r_seq n) =
            ENNReal.ofReal (radialZeroSize g (r_seq n)) := by
          simp [radialSizeENNReal]
        exact h0 ▸ le_biSup (radialSizeENNReal 0 g) hr_ico
      exact ((ENNReal.ofReal_le_iff_le_toReal hg_nev.2.ne).mp hENN).trans (le_max_right 1 _)
    have hlog := Real.log_le_log (Real.exp_pos _) hrad
    rwa [Real.log_exp] at hlog
  have hv₂_bdd : ∀ n, ∫ ζ, v₂ n ζ ∂circleMeasure ≤ C₁ - (L 0).re := fun n ↦ by
    have hint_Lre : Integrable (fun ζ ↦ (L ((r_seq n : ℂ) * circlePoint ζ)).re) circleMeasure :=
      (memLp_circleMeasure_of_continuous (hLre_cont n) 1).integrable le_rfl
    have h0 := holomorphic_herglotz_radial hL_holo (hr_mem n).1.le (hr_mem n).2
      (Metric.mem_ball_self zero_lt_one)
    have hre0 := congr_arg Complex.re h0
    have hherg0 : (herglotzTransform
        (fun ζ ↦ ((L ((r_seq n : ℂ) * circlePoint ζ)).re : ℂ)) 0).re =
        ∫ ζ, (L ((r_seq n : ℂ) * circlePoint ζ)).re ∂circleMeasure := by
      unfold herglotzTransform
      have hker1 : (fun ζ : FourierCircle ↦
          ((circlePoint ζ + 0) / (circlePoint ζ - 0)) *
            ((L ((r_seq n : ℂ) * circlePoint ζ)).re : ℂ)) =
          fun ζ ↦ ((L ((r_seq n : ℂ) * circlePoint ζ)).re : ℂ) := by
        ext ζ
        rw [add_zero, sub_zero, div_self (circlePoint_ne_zero ζ), one_mul]
      have hof : (∫ ζ, ((L ((r_seq n : ℂ) * circlePoint ζ)).re : ℂ) ∂circleMeasure) =
          ((∫ ζ, (L ((r_seq n : ℂ) * circlePoint ζ)).re ∂circleMeasure : ℝ) : ℂ) :=
        Complex.ofRealCLM.integral_comp_comm hint_Lre
      rw [hker1, hof]
      exact Complex.ofReal_re _
    simp only [mul_zero, Complex.add_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, hherg0] at hre0
    dsimp [v₂]
    rw [integral_sub (hv₁_int n) hint_Lre]
    linarith [hv₁_bdd n]
  obtain ⟨φ₁, μ₁, hφ₁_mono, hμ₁_fin, _, _, hμ₁_limC⟩ :=
    exists_subseq_measure_of_nonneg_l1_bounded hv₁_int hv₁_nn hv₁_bdd
  obtain ⟨φ₂, μ₂, hφ₂_mono, hμ₂_fin, _, _, hμ₂_limC⟩ :=
    exists_subseq_measure_of_nonneg_l1_bounded
      (fun k ↦ hv₂_int (φ₁ k)) (fun k ↦ hv₂_nn (φ₁ k)) (fun k ↦ hv₂_bdd (φ₁ k))
  let ψ : ℕ → ℕ := fun k ↦ φ₁ (φ₂ k)
  have hψ_mono : StrictMono ψ := hφ₁_mono.comp hφ₂_mono
  let c : ℂ := Complex.exp (((L 0).im : ℂ) * Complex.I)
  have hc_norm : ‖c‖ = 1 := Complex.norm_exp_ofReal_mul_I (L 0).im
  have hg_herg : ∀ z ∈ Metric.ball (0 : ℂ) 1,
      g z = c * Complex.exp
        ((∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ₁) -
          (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ₂)) := by
    intro z hz
    have hz_lt : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
    let H_z : FourierCircle → ℂ := fun ζ ↦ (circlePoint ζ + z) / (circlePoint ζ - z)
    have hHz_cont : Continuous H_z := by
      refine Continuous.div (by fun_prop) (by fun_prop) fun ζ h0 ↦ ?_
      have heq := sub_eq_zero.mp h0
      rw [← heq, norm_circlePoint] at hz_lt
      exact lt_irrefl 1 hz_lt
    have hLHS_lim : Tendsto (fun k ↦ L ((r_seq (ψ k) : ℂ) * z)) atTop (𝓝 (L z)) := by
      have hrz : Tendsto (fun k ↦ (r_seq (ψ k) : ℂ) * z) atTop (𝓝 z) := by
        simpa using ((Complex.continuous_ofReal.tendsto 1).comp
          (hr_tendsto1.comp hψ_mono.tendsto_atTop)).mul_const z
      exact (hL_holo z hz).continuousAt.tendsto.comp hrz
    have hμ₁_sub : Tendsto (fun k ↦ ∫ ζ, H_z ζ * (v₁ (ψ k) ζ : ℂ) ∂circleMeasure)
        atTop (𝓝 (∫ ζ, H_z ζ ∂μ₁)) :=
      (hμ₁_limC H_z hHz_cont).comp hφ₂_mono.tendsto_atTop
    have hμ₂_sub : Tendsto (fun k ↦ ∫ ζ, H_z ζ * (v₂ (ψ k) ζ : ℂ) ∂circleMeasure)
        atTop (𝓝 (∫ ζ, H_z ζ ∂μ₂)) :=
      hμ₂_limC H_z hHz_cont
    have hRHS_lim : Tendsto
        (fun k ↦ ((L 0).im : ℂ) * Complex.I +
          ((∫ ζ, H_z ζ * (v₁ (ψ k) ζ : ℂ) ∂circleMeasure) -
            (∫ ζ, H_z ζ * (v₂ (ψ k) ζ : ℂ) ∂circleMeasure)))
        atTop (𝓝 (((L 0).im : ℂ) * Complex.I + ((∫ ζ, H_z ζ ∂μ₁) - (∫ ζ, H_z ζ ∂μ₂)))) :=
      tendsto_const_nhds.add (hμ₁_sub.sub hμ₂_sub)
    have heq_seq : ∀ k, L ((r_seq (ψ k) : ℂ) * z) =
        ((L 0).im : ℂ) * Complex.I +
          ((∫ ζ, H_z ζ * (v₁ (ψ k) ζ : ℂ) ∂circleMeasure) -
            (∫ ζ, H_z ζ * (v₂ (ψ k) ζ : ℂ) ∂circleMeasure)) := by
      intro k
      rw [holomorphic_herglotz_radial hL_holo (hr_mem (ψ k)).1.le (hr_mem (ψ k)).2 hz]
      congr 1
      have hi₁ := integrable_herglotzIntegrand (Complex.ofRealCLM.integrable_comp (hv₁_int (ψ k))) hz_lt.ne
      have hi₂ := integrable_herglotzIntegrand (Complex.ofRealCLM.integrable_comp (hv₂_int (ψ k))) hz_lt.ne
      dsimp [herglotzTransform, H_z] at hi₁ hi₂ ⊢
      rw [← integral_sub hi₁ hi₂]
      refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
      dsimp [v₁, v₂]
      push_cast
      ring
    have hLz : L z = ((L 0).im : ℂ) * Complex.I + ((∫ ζ, H_z ζ ∂μ₁) - (∫ ζ, H_z ζ ∂μ₂)) :=
      tendsto_nhds_unique hLHS_lim
        (hRHS_lim.congr' (Eventually.of_forall fun k ↦ (heq_seq k).symm))
    rw [hg_exp z hz, hLz, Complex.exp_add]
  -- Define `b₁ = c * B * singularInnerFactor μ₂` and `b₂ = singularInnerFactor μ₁`
  let b₁ : ℂ → ℂ := fun z ↦ c * B z * singularInnerFactor μ₂ z
  let b₂ : ℂ → ℂ := singularInnerFactor μ₁
  have hB_inner := isInnerFunction_of_isBlaschkeProduct hB
  have hb₁_holo : HolomorphicOn b₁ (Metric.ball (0 : ℂ) 1) :=
    fun z hz ↦ ((differentiableAt_const c).mul (hB_inner.1 z hz)).mul
      (holomorphicOn_singularInnerFactor μ₂ z hz)
  have hb₂_holo : HolomorphicOn b₂ (Metric.ball (0 : ℂ) 1) :=
    holomorphicOn_singularInnerFactor μ₁
  have hb₁_le1 : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖b₁ z‖ ≤ 1 := by
    intro z hz
    dsimp [b₁]
    rw [norm_mul, norm_mul, hc_norm, one_mul]
    calc ‖B z‖ * ‖singularInnerFactor μ₂ z‖
        ≤ 1 * ‖singularInnerFactor μ₂ z‖ :=
          mul_le_mul_of_nonneg_right (hB_inner.2.1 z hz) (norm_nonneg _)
      _ ≤ 1 := by rw [one_mul]; exact norm_singularInnerFactor_le_one μ₂ hz
  have hb₂_le1 : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖b₂ z‖ ≤ 1 :=
    fun _ hz ↦ norm_singularInnerFactor_le_one μ₁ hz
  have hb₂_nz : ∀ z ∈ Metric.ball (0 : ℂ) 1, b₂ z ≠ 0 :=
    fun _ _ ↦ Complex.exp_ne_zero _
  have hf_quot : ∀ z ∈ Metric.ball (0 : ℂ) 1, f z = b₁ z / b₂ z := by
    intro z hz
    rw [hfBg z hz, hg_herg z hz]
    dsimp [b₁, b₂, singularInnerFactor]
    simp only [sub_eq_add_neg, Complex.exp_add, Complex.exp_neg, div_eq_mul_inv, inv_inv]
    ring
  have hb₁_nz_ex : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, b₁ z₀ ≠ 0 := by
    obtain ⟨z₀, hz₀, hfz₀⟩ := hex_nz
    refine ⟨z₀, hz₀, fun hb0 ↦ hfz₀ ?_⟩
    rw [hf_quot z₀ hz₀, hb0, zero_div]
  obtain ⟨hb₁_rad, hb₁_ae_nz, hb₁_log⟩ :=
    bounded_nonzero_holomorphic_boundary_log hb₁_holo ⟨1, hb₁_le1⟩ hb₁_nz_ex
  obtain ⟨hb₂_rad, hb₂_ae_nz, hb₂_log⟩ :=
    bounded_nonzero_holomorphic_boundary_log hb₂_holo ⟨1, hb₂_le1⟩
      ⟨0, Metric.mem_ball_self zero_lt_one, hb₂_nz 0 (Metric.mem_ball_self zero_lt_one)⟩
  have hf_rad_div : ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1)
        (𝓝 (radialBoundaryLimit b₁ ζ / radialBoundaryLimit b₂ ζ)) := by
    filter_upwards [hb₁_rad, hb₂_rad, hb₂_ae_nz] with ζ ht₁ ht₂ hnz₂
    refine (ht₁.div ht₂ hnz₂).congr' ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    refine (hf_quot _ ?_).symm
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr.1] using hr.2
  have hf_rad : ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ)) := by
    filter_upwards [hf_rad_div] with ζ hζ
    rwa [radialBoundaryLimit_eq_of_tendsto hζ]
  have hf_ae_nz : ∀ᵐ ζ ∂circleMeasure, radialBoundaryLimit f ζ ≠ 0 := by
    filter_upwards [hf_rad_div, hb₁_ae_nz, hb₂_ae_nz] with ζ hζ hnz₁ hnz₂
    rw [radialBoundaryLimit_eq_of_tendsto hζ]
    exact div_ne_zero hnz₁ hnz₂
  have hf_log : Integrable (fun ζ ↦ Real.log ‖radialBoundaryLimit f ζ‖) circleMeasure := by
    refine (hb₁_log.sub hb₂_log).congr ?_
    filter_upwards [hf_rad_div, hb₁_ae_nz, hb₂_ae_nz] with ζ hζ hnz₁ hnz₂
    rw [radialBoundaryLimit_eq_of_tendsto hζ, norm_div,
      Real.log_div (norm_pos_iff.mpr hnz₁).ne' (norm_pos_iff.mpr hnz₂).ne']
    rfl
  refine ⟨⟨c, B, μ₁, μ₂, hc_norm, hB, hμ₁_fin, hμ₂_fin, fun z hz ↦ ?_⟩,
    ⟨b₁, b₂, hb₁_holo, hb₂_holo, hb₁_le1, hb₂_le1, hb₂_nz, hf_quot⟩,
    hf_rad, hf_ae_nz, hf_log⟩
  rw [hfBg z hz, hg_herg z hz]
  ring

/-- **17.19(b) (Explicit Nevanlinna Counterexample `exp ((1 + z) / (1 - z))`, RCA p. 346).** -/
def nevanlinnaCounterexample (z : ℂ) : ℂ :=
  Complex.exp ((1 + z) / (1 - z))

theorem ae_circleMeasure_ne_zero : ∀ᵐ ζ ∂circleMeasure, ζ ≠ (0 : FourierCircle) := by
  refine ae_circleMeasure_of_ae_volume ?_
  rw [ae_iff]
  have hsub : {θ : ℝ | ¬ ((θ : FourierCircle) ≠ 0)} ⊆
      Set.range (fun k : ℤ ↦ (k : ℝ) * (2 * Real.pi)) := by
    intro θ hθ
    have h0 : (θ : FourierCircle) = 0 := of_not_not hθ
    have hexp1 : Complex.exp ((θ : ℂ) * Complex.I) = 1 := by
      rw [← circlePoint_coe, h0, circlePoint_zero]
    obtain ⟨k, hk⟩ := Complex.exp_eq_one_iff.mp hexp1
    have him := congr_arg Complex.im hk
    have hrhs : (((k : ℂ) * (2 * Real.pi * Complex.I))).im = (k : ℝ) * (2 * Real.pi) := by
      have : (k : ℂ) * (2 * Real.pi * Complex.I) =
          (((k : ℝ) * (2 * Real.pi) : ℝ) : ℂ) * Complex.I := by push_cast; ring
      rw [this]
      simp
    simp only [Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im, Complex.I_re, Complex.I_im,
      mul_one, mul_zero, add_zero, hrhs] at him
    exact ⟨k, him.symm⟩
  exact measure_mono_null hsub ((Set.countable_range _).measure_zero _)

/-- **Theorem 17.19 (Nevanlinna Class Representations & Counterexample, RCA pp. 345–346):**
1. Every nonzero `f ∈ N` admits the signed-measure Blaschke–Herglotz representation and the bounded
   quotient representation `f = b₁ / b₂` (`‖b₁‖ ≤ 1`, `‖b₂‖ ≤ 1`, `b₂` zero-free on `U`), has
   finite nonzero radial limits `circleMeasure`-a.e., and satisfies `log ‖f*‖ ∈ L¹(T)`.
2. For `f(z) = exp ((1 + z) / (1 - z))`, `f ∈ N` with `‖f‖_0 = e`, `‖f*(ζ)‖ = 1` for
   `circleMeasure`-a.e. `ζ ∈ T`, and `∫_T log ‖f*‖ dσ = 0 < 1 = log ‖f(0)‖`. -/
theorem theorem17_19 (hPartB : HardyPartBInterface) :
    (∀ {f : ℂ → ℂ}, IsInNevanlinnaClassCh17 f → (∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) →
      (∃ (c : ℂ) (B : ℂ → ℂ) (μ₁ μ₂ : Measure FourierCircle),
        ‖c‖ = 1 ∧
        RudinRCA.Chapter15.IsBlaschkeProduct B ∧
        IsFiniteMeasure μ₁ ∧ IsFiniteMeasure μ₂ ∧
        (∀ z ∈ Metric.ball (0 : ℂ) 1,
          f z = c * B z * Complex.exp
            ((∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ₁) -
              (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) ∂μ₂)))) ∧
      (∃ b₁ b₂ : ℂ → ℂ,
        HolomorphicOn b₁ (Metric.ball (0 : ℂ) 1) ∧
        HolomorphicOn b₂ (Metric.ball (0 : ℂ) 1) ∧
        (∀ z ∈ Metric.ball (0 : ℂ) 1, ‖b₁ z‖ ≤ 1) ∧
        (∀ z ∈ Metric.ball (0 : ℂ) 1, ‖b₂ z‖ ≤ 1) ∧
        (∀ z ∈ Metric.ball (0 : ℂ) 1, b₂ z ≠ 0) ∧
        (∀ z ∈ Metric.ball (0 : ℂ) 1, f z = b₁ z / b₂ z)) ∧
      (∀ᵐ ζ ∂circleMeasure,
        Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
      (∀ᵐ ζ ∂circleMeasure, radialBoundaryLimit f ζ ≠ 0) ∧
      Integrable (fun ζ ↦ Real.log ‖radialBoundaryLimit f ζ‖) circleMeasure) ∧
    (IsInNevanlinnaClassCh17 nevanlinnaCounterexample ∧
      hardySize 0 nevanlinnaCounterexample = Real.exp 1 ∧
      (∀ᵐ ζ ∂circleMeasure,
        Tendsto (fun r : ℝ ↦ radialSlice nevanlinnaCounterexample r ζ) (𝓝[<] 1)
          (𝓝 (radialBoundaryLimit nevanlinnaCounterexample ζ))) ∧
      (∀ᵐ ζ ∂circleMeasure, ‖radialBoundaryLimit nevanlinnaCounterexample ζ‖ = 1) ∧
      (∫ ζ, Real.log ‖radialBoundaryLimit nevanlinnaCounterexample ζ‖ ∂circleMeasure) = 0 ∧
      Real.log ‖nevanlinnaCounterexample 0‖ = 1 ∧
      ∫ ζ, Real.log ‖radialBoundaryLimit nevanlinnaCounterexample ζ‖ ∂circleMeasure <
        Real.log ‖nevanlinnaCounterexample 0‖) := by
  refine ⟨fun hf hex ↦ nevanlinna_quotient_and_boundary hPartB hf hex, ?_⟩
  have hholo : HolomorphicOn nevanlinnaCounterexample (Metric.ball (0 : ℂ) 1) := by
    intro z hz
    have hne : (1 : ℂ) - z ≠ 0 := by
      intro h0
      have hz1 : z = 1 := (sub_eq_zero.mp h0).symm
      have hlt : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
      rw [hz1, norm_one] at hlt
      exact lt_irrefl 1 hlt
    exact (((differentiableAt_id.const_add 1).div (differentiableAt_id.const_sub 1) hne).cexp)
  have hrad_zero_eq : ∀ r ∈ Set.Ico (0 : ℝ) 1,
      radialZeroSize nevanlinnaCounterexample r = Real.exp 1 := by
    intro r hr
    unfold radialZeroSize
    congr 1
    have hpt : ∀ ζ : FourierCircle,
        Real.posLog ‖radialSlice nevanlinnaCounterexample r ζ‖ =
          _root_.poissonKernel 0 ((r : ℂ) * circlePoint 0) (circlePoint ζ) := by
      intro ζ
      let z : ℂ := (r : ℂ) * circlePoint ζ
      have hz : z ∈ Metric.ball (0 : ℂ) 1 := by
        simpa [z, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg hr.1] using hr.2
      have hre : ((1 + z) / (1 - z)).re = _root_.poissonKernel 0 z (circlePoint 0) := by
        simpa [circlePoint_zero] using (poissonKernel_eq_re_herglotz z 0).symm
      have hnn : 0 ≤ ((1 + z) / (1 - z)).re := hre ▸ poissonKernel_circlePoint_nonneg hz 0
      change Real.posLog ‖Complex.exp ((1 + z) / (1 - z))‖ = _
      rw [Complex.norm_exp,
        Real.posLog_eq_log (by rw [abs_of_pos (Real.exp_pos _)]; exact Real.one_le_exp hnn),
        Real.log_exp, hre, poissonKernel_circlePoint_symm r ζ 0]
    simp_rw [hpt]
    refine integral_poissonKernel_circlePoint_eq_one ?_
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hr.1] using hr.2
  have hENN_eq : hardySizeENNReal 0 nevanlinnaCounterexample = ENNReal.ofReal (Real.exp 1) := by
    unfold hardySizeENNReal
    refine le_antisymm (iSup₂_le fun r hr ↦ ?_) ?_
    · simp [radialSizeENNReal, hrad_zero_eq r hr]
    · have h0_mem : (0 : ℝ) ∈ Set.Ico (0 : ℝ) 1 := ⟨le_rfl, zero_lt_one⟩
      calc ENNReal.ofReal (Real.exp 1)
          = radialSizeENNReal 0 nevanlinnaCounterexample 0 := by
              simp [radialSizeENNReal, hrad_zero_eq 0 h0_mem]
        _ ≤ ⨆ r ∈ Set.Ico (0 : ℝ) 1, radialSizeENNReal 0 nevanlinnaCounterexample r :=
            le_biSup (radialSizeENNReal 0 nevanlinnaCounterexample) h0_mem
  have hnev : IsInNevanlinnaClassCh17 nevanlinnaCounterexample :=
    ⟨hholo, hENN_eq ▸ ENNReal.ofReal_lt_top⟩
  have hsize0 : hardySize 0 nevanlinnaCounterexample = Real.exp 1 := by
    unfold hardySize
    rw [hENN_eq, ENNReal.toReal_ofReal (Real.exp_pos 1).le]
  have hae_lim_norm : ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun r : ℝ ↦ radialSlice nevanlinnaCounterexample r ζ) (𝓝[<] 1)
        (𝓝 (radialBoundaryLimit nevanlinnaCounterexample ζ)) ∧
      ‖radialBoundaryLimit nevanlinnaCounterexample ζ‖ = 1 := by
    filter_upwards [ae_circleMeasure_ne_zero] with ζ hζ0
    have hcp_ne1 : circlePoint ζ ≠ 1 := by
      intro h1
      rw [← circlePoint_zero] at h1
      exact hζ0 (fourierCircleHomeomorphism.injective (Subtype.ext h1))
    have hsub_ne : (1 : ℂ) - circlePoint ζ ≠ 0 := sub_ne_zero.mpr hcp_ne1.symm
    have hcont_at : ContinuousAt
        (fun r : ℝ ↦ Complex.exp ((1 + (r : ℂ) * circlePoint ζ) / (1 - (r : ℂ) * circlePoint ζ)))
        1 := by
      refine ContinuousAt.cexp (ContinuousAt.div ?_ ?_ (by simpa using hsub_ne))
      · exact continuousAt_const.add (Complex.continuous_ofReal.continuousAt.mul continuousAt_const)
      · exact continuousAt_const.sub (Complex.continuous_ofReal.continuousAt.mul continuousAt_const)
    have htend : Tendsto (fun r : ℝ ↦ radialSlice nevanlinnaCounterexample r ζ) (𝓝[<] 1)
        (𝓝 (Complex.exp ((1 + circlePoint ζ) / (1 - circlePoint ζ)))) := by
      simpa [radialSlice, nevanlinnaCounterexample] using
        hcont_at.tendsto.mono_left nhdsWithin_le_nhds
    have hlim_eq := radialBoundaryLimit_eq_of_tendsto htend
    refine ⟨hlim_eq ▸ htend, ?_⟩
    rw [hlim_eq, Complex.norm_exp]
    have hre0 : ((1 + circlePoint ζ) / (1 - circlePoint ζ)).re = 0 := by
      have hp : ((1 + circlePoint ζ) / (1 - circlePoint ζ)).re =
          _root_.poissonKernel 0 (circlePoint ζ) (circlePoint 0) := by
        simpa [circlePoint_zero] using (poissonKernel_eq_re_herglotz (circlePoint ζ) 0).symm
      rw [hp, poissonKernel_circlePoint_formula, norm_circlePoint, one_pow, sub_self, zero_div]
    rw [hre0, Real.exp_zero]
  have hint_zero : (∫ ζ, Real.log ‖radialBoundaryLimit nevanlinnaCounterexample ζ‖ ∂circleMeasure) = 0 := by
    calc (∫ ζ, Real.log ‖radialBoundaryLimit nevanlinnaCounterexample ζ‖ ∂circleMeasure)
        = ∫ _, (0 : ℝ) ∂circleMeasure := by
            refine integral_congr_ae ?_
            filter_upwards [hae_lim_norm] with ζ hζ
            rw [hζ.2, Real.log_one]
      _ = 0 := by simp
  have hlog0 : Real.log ‖nevanlinnaCounterexample 0‖ = 1 := by
    simp [nevanlinnaCounterexample, Complex.norm_exp]
  exact ⟨hnev, hsize0, hae_lim_norm.mono fun _ h ↦ h.1, hae_lim_norm.mono fun _ h ↦ h.2,
    hint_zero, hlog0, by linarith⟩

/-! ### Section 17.17: Canonical Inner–Outer Factorization `f = M_f · Q_f` for `0 < p ≤ ∞` (RCA pp. 344–345) -/

/-- **17.17 (Canonical Outer Factor `Q_f`, RCA p. 344):**
`Q_f(z) = exp (∫_T ((ζ + z)/(ζ - z)) log ‖f*(ζ)‖ dσ(ζ))` on `U = Metric.ball 0 1` (`0` outside). -/
def canonicalOuterFactor (f : ℂ → ℂ) : ℂ → ℂ :=
  outerFunction 1 (fun ζ ↦ ‖radialBoundaryLimit f ζ‖)

/-- **17.17 (Canonical Inner Factor `M_f = f / Q_f`, RCA p. 344):**
`M_f(z) = f(z) / Q_f(z)` on `U = Metric.ball 0 1` (`0` outside). -/
def canonicalInnerFactor (f : ℂ → ℂ) : ℂ → ℂ :=
  (Metric.ball (0 : ℂ) 1).indicator (fun z ↦ f z / canonicalOuterFactor f z)

/-- Maximum Modulus Corollary on `Metric.ball 0 1`: if `M` is holomorphic on `ball 0 1` with
`‖M z‖ ≤ 1` for all `z ∈ ball 0 1` and `‖M 0‖ = 1`, then `M` is constant on `ball 0 1`. -/
theorem eq_const_on_ball_of_norm_le_one_of_norm_zero_eq_one {M : ℂ → ℂ}
    (hM_holo : HolomorphicOn M (Metric.ball (0 : ℂ) 1))
    (hM_le : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖M z‖ ≤ 1)
    (hM0 : ‖M 0‖ = 1) :
    ∀ z ∈ Metric.ball (0 : ℂ) 1, M z = M 0 := by
  by_contra hnot
  have hnonconst : ¬ ∃ w : ℂ, ∀ z ∈ Metric.ball (0 : ℂ) 1, M z = w := by
    rintro ⟨w, hw⟩
    apply hnot
    intro z hz
    rw [hw z hz, hw 0 (Metric.mem_ball_self zero_lt_one)]
  have hopen : IsOpen (M '' Metric.ball (0 : ℂ) 1) :=
    (RudinRCA.Chapter10.theorem10_32
      (RudinRCA.Chapter10.disc_isRegion 0 zero_lt_one) hM_holo hnonconst).1.1
      (Metric.ball (0 : ℂ) 1) Subset.rfl Metric.isOpen_ball
  obtain ⟨ε, hε, hball_sub⟩ :=
    Metric.isOpen_iff.mp hopen (M 0) ⟨0, Metric.mem_ball_self zero_lt_one, rfl⟩
  let w : ℂ := ((1 + ε / 2 : ℝ) : ℂ) * M 0
  have hw_mem : w ∈ Metric.ball (M 0) ε := by
    rw [Metric.mem_ball, dist_eq_norm]
    have hdiff : w - M 0 = ((ε / 2 : ℝ) : ℂ) * M 0 := by dsimp [w]; push_cast; ring
    rw [hdiff, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (half_pos hε), hM0,
      mul_one]
    linarith
  obtain ⟨z, hz, hMz⟩ := hball_sub hw_mem
  have h1 : ‖w‖ ≤ 1 := hMz ▸ hM_le z hz
  have h2 : ‖w‖ = 1 + ε / 2 := by
    dsimp [w]
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (by linarith), hM0, mul_one]
  linarith

/-- Key `H²` Jensen–Fatou inequality for zero-free `h ∈ H²`:
`Real.log ‖h z‖ ≤ ∫ ζ, P_z(ζ) * Real.log ‖h*(ζ)‖ dσ(ζ)` for every `z ∈ ball 0 1`. -/
theorem zero_free_h2_log_le_poisson (hPartB : HardyPartBInterface) {h : ℂ → ℂ}
    (hh : IsInHardySpace 2 h) (hh_nz : ∀ z ∈ Metric.ball (0 : ℂ) 1, h z ≠ 0)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    Real.log ‖h z‖ ≤
      ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) *
        Real.log ‖radialBoundaryLimit h ζ‖ ∂circleMeasure := by
  have hex_nz : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, h z₀ ≠ 0 :=
    ⟨0, Metric.mem_ball_self zero_lt_one, hh_nz 0 (Metric.mem_ball_self zero_lt_one)⟩
  obtain ⟨_, _, hh_rad, hh_ae_nz, hh_log_int⟩ :=
    nevanlinna_quotient_and_boundary hPartB hh.toNevanlinna hex_nz
  obtain ⟨_, hh_memLp, _, hh_L2_conv, _⟩ := hPartB.hardy_boundary (by norm_num) hh
  obtain ⟨L, hL_holo, hh_exp⟩ := exists_holomorphic_log_ball hh.2.1 hh_nz
  have hL_re : ∀ w ∈ Metric.ball (0 : ℂ) 1, (L w).re = Real.log ‖h w‖ := by
    intro w hw
    rw [hh_exp w hw, Complex.norm_exp, Real.log_exp]
  let P_z : FourierCircle → ℝ := fun ζ ↦ _root_.poissonKernel 0 z (circlePoint ζ)
  have hPz_cont : Continuous P_z := continuous_poissonKernel_circlePoint hz
  have hPz_nn : ∀ ζ, 0 ≤ P_z ζ := poissonKernel_circlePoint_nonneg hz
  obtain ⟨K, hK⟩ := isCompact_univ.exists_bound_of_continuousOn hPz_cont.continuousOn
  have hK_nn : 0 ≤ K := (norm_nonneg (P_z 0)).trans (hK 0 (mem_univ 0))
  let r_seq : ℕ → ℝ := fun n ↦ 1 - 1 / ((n : ℝ) + 2)
  have hr_mem : ∀ n : ℕ, r_seq n ∈ Set.Ioo (0 : ℝ) 1 := fun n ↦ by
    dsimp [r_seq]
    have hn : (1 : ℝ) < (n : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) n]
    refine ⟨by linarith [div_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2) |>.mpr hn],
      by linarith [div_pos zero_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2)]⟩
  have hr_tendsto1 : Tendsto r_seq atTop (𝓝 1) := by
    have hdiv : Tendsto (fun n : ℕ ↦ (1 : ℝ) / ((n : ℝ) + 2)) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop
        ((tendsto_natCast_atTop_atTop (R := ℝ)).atTop_add tendsto_const_nhds)
    simpa [r_seq] using (tendsto_const_nhds (x := (1 : ℝ))).sub hdiv
  have hr_nhdsLT : Tendsto r_seq atTop (𝓝[<] 1) :=
    tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within _ hr_tendsto1
      (Eventually.of_forall fun n ↦ (hr_mem n).2)
  -- `L¹` convergence `radialSlice h (r_seq n) → radialBoundaryLimit h` from `L²` convergence
  have hL1_conv : Tendsto
      (fun n ↦ ∫ ζ, ‖radialSlice h (r_seq n) ζ - radialBoundaryLimit h ζ‖ ∂circleMeasure)
      atTop (𝓝 0) := by
    have heLp2 : Tendsto
        (fun n ↦ eLpNorm (radialSlice h (r_seq n) - radialBoundaryLimit h) 2 circleMeasure)
        atTop (𝓝 0) :=
      (hh_L2_conv (by norm_num)).comp hr_nhdsLT
    have heLp1 : Tendsto
        (fun n ↦ eLpNorm (radialSlice h (r_seq n) - radialBoundaryLimit h) 1 circleMeasure)
        atTop (𝓝 0) := by
      refine tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds heLp2
        (fun _ ↦ by positivity) fun n ↦ ?_
      exact eLpNorm_le_eLpNorm_of_exponent_le (by norm_num : (1 : ℝ≥0∞) ≤ 2)
    have htoReal := (ENNReal.continuousAt_toReal ENNReal.zero_ne_top).tendsto.comp heLp1
    rw [ENNReal.toReal_zero] at htoReal
    refine htoReal.congr' (Eventually.of_forall fun n ↦ ?_)
    have hdiff_mem1 : MemLp (radialSlice h (r_seq n) - radialBoundaryLimit h) 1 circleMeasure :=
      ((memLp_circleMeasure_of_continuous
        (continuous_radialSlice_of_holomorphicOn hh.2.1 (hr_mem n).1.le (hr_mem n).2) 2).sub
        hh_memLp).mono_exponent (by norm_num)
    rw [Function.comp_apply,
      hdiff_mem1.eLpNorm_eq_integral_rpow_norm one_ne_zero ENNReal.one_ne_top]
    simp [ENNReal.toReal_ofReal (integral_nonneg fun _ ↦ norm_nonneg _)]
  -- `posLog` integrals converge: `∫ P_z * posLog ‖h_{r_n}‖ → ∫ P_z * posLog ‖h*‖`
  have hint_posLog_lim : Integrable
      (fun ζ ↦ P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖) circleMeasure := by
    have hmem1 : MemLp (radialBoundaryLimit h) 1 circleMeasure :=
      hh_memLp.mono_exponent (by norm_num)
    have hpl_int : Integrable (fun ζ ↦ Real.posLog ‖radialBoundaryLimit h ζ‖) circleMeasure := by
      refine (hmem1.integrable le_rfl).norm.mono'
        ((Real.continuous_posLog.comp continuous_norm).measurable.comp_aemeasurable
          hh_memLp.aestronglyMeasurable.aemeasurable).aestronglyMeasurable ?_
      refine Eventually.of_forall fun ζ ↦ ?_
      rw [Real.norm_of_nonneg Real.posLog_nonneg]
      simpa using posLog_le_rpow_div zero_lt_one (norm_nonneg (radialBoundaryLimit h ζ))
    simpa only [mul_comm] using hpl_int.bdd_mul hPz_cont.aestronglyMeasurable
      (Eventually.of_forall fun ζ ↦ hK ζ (mem_univ ζ))
  have hint_log_Pz : Integrable
      (fun ζ ↦ P_z ζ * Real.log ‖radialBoundaryLimit h ζ‖) circleMeasure := by
    simpa only [mul_comm] using hh_log_int.bdd_mul hPz_cont.aestronglyMeasurable
      (Eventually.of_forall fun ζ ↦ hK ζ (mem_univ ζ))
  have hposLog_tendsto : Tendsto
      (fun n ↦ ∫ ζ, P_z ζ * Real.posLog ‖radialSlice h (r_seq n) ζ‖ ∂circleMeasure)
      atTop (𝓝 (∫ ζ, P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure)) := by
    rw [Metric.tendsto_nhds]
    intro ε hε
    have hK1_pos : 0 < K + 1 := by linarith
    filter_upwards [(Metric.tendsto_nhds.mp hL1_conv) (ε / (K + 1))
      (div_pos hε hK1_pos)] with n hn
    rw [Real.dist_eq] at hn ⊢
    have hcont_n := continuous_radialSlice_of_holomorphicOn hh.2.1 (hr_mem n).1.le (hr_mem n).2
    have hint_n : Integrable
        (fun ζ ↦ P_z ζ * Real.posLog ‖radialSlice h (r_seq n) ζ‖) circleMeasure :=
      (memLp_circleMeasure_of_continuous
        (hPz_cont.mul (Real.continuous_posLog.comp hcont_n.norm)) 1).integrable le_rfl
    have hint_diff : Integrable
        (fun ζ ↦ ‖radialSlice h (r_seq n) ζ - radialBoundaryLimit h ζ‖) circleMeasure :=
      ((((memLp_circleMeasure_of_continuous hcont_n 2).sub hh_memLp).mono_exponent
        (by norm_num : (1 : ℝ≥0∞) ≤ 2)).integrable le_rfl).norm
    rw [← integral_sub hint_n hint_posLog_lim]
    calc |∫ ζ, (P_z ζ * Real.posLog ‖radialSlice h (r_seq n) ζ‖ -
            P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖) ∂circleMeasure|
        ≤ ∫ ζ, |P_z ζ * Real.posLog ‖radialSlice h (r_seq n) ζ‖ -
            P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖| ∂circleMeasure :=
          abs_integral_le_integral_abs
      _ ≤ ∫ ζ, (K + 1) * ‖radialSlice h (r_seq n) ζ - radialBoundaryLimit h ζ‖ ∂circleMeasure := by
          refine integral_mono (hint_n.sub hint_posLog_lim).abs
            (hint_diff.const_mul (K + 1)) fun ζ ↦ ?_
          rw [← mul_sub, abs_mul, abs_of_nonneg (hPz_nn ζ)]
          have h1 : |Real.posLog ‖radialSlice h (r_seq n) ζ‖ -
              Real.posLog ‖radialBoundaryLimit h ζ‖| ≤
              ‖radialSlice h (r_seq n) ζ - radialBoundaryLimit h ζ‖ :=
            (posLog_sub_posLog_abs_le (norm_nonneg _) (norm_nonneg _)).trans
              (abs_norm_sub_norm_le _ _)
          have h2 : P_z ζ ≤ K + 1 := by
            have := hK ζ (mem_univ ζ)
            rw [Real.norm_of_nonneg (hPz_nn ζ)] at this
            linarith
          exact mul_le_mul h2 h1 (abs_nonneg _) hK1_pos.le
      _ = (K + 1) * ∫ ζ, ‖radialSlice h (r_seq n) ζ - radialBoundaryLimit h ζ‖ ∂circleMeasure :=
          integral_const_mul _ _
      _ < (K + 1) * (ε / (K + 1)) := by
          refine mul_lt_mul_of_pos_left ?_ hK1_pos
          rw [sub_zero, abs_of_nonneg (integral_nonneg fun _ ↦ norm_nonneg _)] at hn
          exact hn
      _ = ε := mul_div_cancel₀ ε hK1_pos.ne'
  -- Fatou's lemma on `P_z(ζ) * (posLog ‖h_{r_n}(ζ)‖ - log ‖h_{r_n}(ζ)‖) ≥ 0`
  let negLog : ℝ → ℝ := fun x ↦ Real.posLog x - Real.log x
  have hnegLog_nn : ∀ {x : ℝ}, 0 ≤ x → 0 ≤ negLog x := fun {x} hx ↦ by
    dsimp [negLog]
    rw [posLog_eq_max_zero_log hx, sub_nonneg]
    exact le_max_right 0 _
  have hlog_rz_tendsto : Tendsto (fun n ↦ Real.log ‖h ((r_seq n : ℂ) * z)‖)
      atTop (𝓝 (Real.log ‖h z‖)) := by
    have hrz : Tendsto (fun n ↦ (r_seq n : ℂ) * z) atTop (𝓝 z) := by
      simpa using ((Complex.continuous_ofReal.tendsto 1).comp hr_tendsto1).mul_const z
    exact ((Real.continuousAt_log (norm_pos_iff.mpr (hh_nz z hz)).ne').tendsto.comp
      ((hh.2.1 z hz).continuousAt.norm.tendsto)).comp hrz
  have hneg_id : ∀ n,
      (∫ ζ, P_z ζ * negLog ‖radialSlice h (r_seq n) ζ‖ ∂circleMeasure) =
        (∫ ζ, P_z ζ * Real.posLog ‖radialSlice h (r_seq n) ζ‖ ∂circleMeasure) -
          Real.log ‖h ((r_seq n : ℂ) * z)‖ := by
    intro n
    have hr_z_mem : (r_seq n : ℂ) * z ∈ Metric.ball (0 : ℂ) 1 := by
      rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (hr_mem n).1]
      calc r_seq n * ‖z‖
          ≤ r_seq n * 1 := mul_le_mul_of_nonneg_left (mem_ball_zero_iff.mp hz).le (hr_mem n).1.le
        _ = r_seq n := mul_one _
        _ < 1 := (hr_mem n).2
    have hherg := congr_arg Complex.re
      (holomorphic_herglotz_radial hL_holo (hr_mem n).1.le (hr_mem n).2 hz)
    have hcont_Lre : Continuous (fun ζ ↦ (L ((r_seq n : ℂ) * circlePoint ζ)).re) := by
      refine Complex.continuous_re.comp
        ((RudinRCA.Chapter10.continuousOn_of_holomorphicOn hL_holo).comp_continuous
          (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_)
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos (hr_mem n).1] using (hr_mem n).2
    have hint_Lre : Integrable (fun ζ ↦ (L ((r_seq n : ℂ) * circlePoint ζ)).re) circleMeasure :=
      (memLp_circleMeasure_of_continuous hcont_Lre 1).integrable le_rfl
    have hre_eq := re_herglotzTransform_ofReal hint_Lre hz
    simp only [Complex.add_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
      Complex.I_re, Complex.I_im, mul_zero, mul_one, sub_self, zero_add, hre_eq,
      hL_re _ hr_z_mem] at hherg
    have hlog_eq : Real.log ‖h ((r_seq n : ℂ) * z)‖ =
        ∫ ζ, P_z ζ * Real.log ‖radialSlice h (r_seq n) ζ‖ ∂circleMeasure := by
      rw [hherg]
      unfold circlePoissonIntegral
      refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
      have hw : (r_seq n : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (hr_mem n).1] using (hr_mem n).2
      simp [P_z, radialSlice, smul_eq_mul, hL_re _ hw]
    have hcont_n := continuous_radialSlice_of_holomorphicOn hh.2.1 (hr_mem n).1.le (hr_mem n).2
    have hint_pl_n : Integrable
        (fun ζ ↦ P_z ζ * Real.posLog ‖radialSlice h (r_seq n) ζ‖) circleMeasure :=
      (memLp_circleMeasure_of_continuous
        (hPz_cont.mul (Real.continuous_posLog.comp hcont_n.norm)) 1).integrable le_rfl
    have hint_lg_n : Integrable
        (fun ζ ↦ P_z ζ * Real.log ‖radialSlice h (r_seq n) ζ‖) circleMeasure := by
      refine (memLp_circleMeasure_of_continuous (hPz_cont.mul hcont_Lre) 1).integrable le_rfl |>.congr
        (Eventually.of_forall fun ζ ↦ ?_)
      have hw : (r_seq n : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos (hr_mem n).1] using (hr_mem n).2
      dsimp
      rw [hL_re _ hw]; rfl
    dsimp [negLog]
    simp_rw [mul_sub]
    rw [integral_sub hint_pl_n hint_lg_n, ← hlog_eq]
  have hneg_tendsto : Tendsto
      (fun n ↦ ENNReal.ofReal (∫ ζ, P_z ζ * negLog ‖radialSlice h (r_seq n) ζ‖ ∂circleMeasure))
      atTop
      (𝓝 (ENNReal.ofReal
        ((∫ ζ, P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) -
          Real.log ‖h z‖))) := by
    refine (ENNReal.continuous_ofReal.tendsto _).comp ?_
    simpa only [hneg_id] using hposLog_tendsto.sub hlog_rz_tendsto
  have hae_neg_lim : ∀ᵐ ζ ∂circleMeasure,
      Tendsto (fun n ↦ ENNReal.ofReal (P_z ζ * negLog ‖radialSlice h (r_seq n) ζ‖))
        atTop (𝓝 (ENNReal.ofReal (P_z ζ * negLog ‖radialBoundaryLimit h ζ‖))) := by
    filter_upwards [hh_rad, hh_ae_nz] with ζ hrad hnz
    refine (ENNReal.continuous_ofReal.tendsto _).comp (tendsto_const_nhds.mul ?_)
    have hnorm_lim : Tendsto (fun n ↦ ‖radialSlice h (r_seq n) ζ‖)
        atTop (𝓝 ‖radialBoundaryLimit h ζ‖) :=
      (hrad.comp hr_nhdsLT).norm
    exact ((Real.continuous_posLog.tendsto _).comp hnorm_lim).sub
      ((Real.continuousAt_log (norm_pos_iff.mpr hnz).ne').tendsto.comp hnorm_lim)
  have hfatou : (∫⁻ ζ, ENNReal.ofReal (P_z ζ * negLog ‖radialBoundaryLimit h ζ‖) ∂circleMeasure) ≤
      ENNReal.ofReal
        ((∫ ζ, P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) -
          Real.log ‖h z‖) := by
    calc (∫⁻ ζ, ENNReal.ofReal (P_z ζ * negLog ‖radialBoundaryLimit h ζ‖) ∂circleMeasure)
        = ∫⁻ ζ, liminf (fun n ↦ ENNReal.ofReal (P_z ζ * negLog ‖radialSlice h (r_seq n) ζ‖))
            atTop ∂circleMeasure := by
            refine lintegral_congr_ae ?_
            filter_upwards [hae_neg_lim] with ζ hζ
            exact hζ.liminf_eq.symm
      _ ≤ liminf (fun n ↦ ∫⁻ ζ, ENNReal.ofReal
            (P_z ζ * negLog ‖radialSlice h (r_seq n) ζ‖) ∂circleMeasure) atTop := by
          refine lintegral_liminf_le' fun n ↦ ?_
          have hcont_n := continuous_radialSlice_of_holomorphicOn hh.2.1 (hr_mem n).1.le (hr_mem n).2
          have hc_neg : Continuous (fun ζ ↦ P_z ζ * negLog ‖radialSlice h (r_seq n) ζ‖) := by
            refine hPz_cont.mul ((Real.continuous_posLog.comp hcont_n.norm).sub ?_)
            refine Continuous.log hcont_n.norm fun ζ ↦ (norm_pos_iff.mpr (hh_nz _ ?_)).ne'
            simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_pos (hr_mem n).1] using (hr_mem n).2
          exact (ENNReal.measurable_ofReal.comp hc_neg.measurable).aemeasurable
      _ = ENNReal.ofReal
            ((∫ ζ, P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) -
              Real.log ‖h z‖) := by
          refine (hneg_tendsto.congr' (Eventually.of_forall fun n ↦ ?_)).liminf_eq
          have hcont_n := continuous_radialSlice_of_holomorphicOn hh.2.1 (hr_mem n).1.le (hr_mem n).2
          have hc_neg : Continuous (fun ζ ↦ P_z ζ * negLog ‖radialSlice h (r_seq n) ζ‖) := by
            refine hPz_cont.mul ((Real.continuous_posLog.comp hcont_n.norm).sub ?_)
            refine Continuous.log hcont_n.norm fun ζ ↦ (norm_pos_iff.mpr (hh_nz _ ?_)).ne'
            simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_pos (hr_mem n).1] using (hr_mem n).2
          exact ofReal_integral_eq_lintegral_ofReal
            ((memLp_circleMeasure_of_continuous hc_neg 1).integrable le_rfl)
            (Eventually.of_forall fun ζ ↦
              mul_nonneg (hPz_nn ζ) (hnegLog_nn (norm_nonneg _)))
  have hint_neg_lim : Integrable
      (fun ζ ↦ P_z ζ * negLog ‖radialBoundaryLimit h ζ‖) circleMeasure :=
    (hint_posLog_lim.sub hint_log_Pz).congr
      (Eventually.of_forall fun ζ ↦ (mul_sub _ _ _).symm)
  have hlhs_eq : (∫⁻ ζ, ENNReal.ofReal (P_z ζ * negLog ‖radialBoundaryLimit h ζ‖) ∂circleMeasure) =
      ENNReal.ofReal (∫ ζ, P_z ζ * negLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) :=
    (ofReal_integral_eq_lintegral_ofReal hint_neg_lim
      (Eventually.of_forall fun ζ ↦ mul_nonneg (hPz_nn ζ) (hnegLog_nn (norm_nonneg _)))).symm
  rw [hlhs_eq] at hfatou
  have hrhs_nn' : 0 ≤ (∫ ζ, P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) -
      Real.log ‖h z‖ :=
    ge_of_tendsto (hposLog_tendsto.sub hlog_rz_tendsto) (Eventually.of_forall fun n ↦ by
      rw [← hneg_id n]
      exact integral_nonneg fun ζ ↦ mul_nonneg (hPz_nn ζ) (hnegLog_nn (norm_nonneg _)))
  have hreal_le : (∫ ζ, P_z ζ * negLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) ≤
      (∫ ζ, P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) -
        Real.log ‖h z‖ :=
    (ENNReal.ofReal_le_ofReal_iff hrhs_nn').mp hfatou
  have hsplit : (∫ ζ, P_z ζ * negLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) =
      (∫ ζ, P_z ζ * Real.posLog ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) -
        (∫ ζ, P_z ζ * Real.log ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) := by
    simp_rw [negLog, mul_sub]
    exact integral_sub hint_posLog_lim hint_log_Pz
  rw [hsplit] at hreal_le
  linarith

/-- Extension of `zero_free_h2_log_le_poisson` to EVERY `0 < p ≤ ∞` (`p ≠ 0`):
for zero-free `g ∈ H^p`, `Real.log ‖g z‖ ≤ ∫ ζ, P_z(ζ) * Real.log ‖g*(ζ)‖ dσ(ζ)` on `ball 0 1`. -/
theorem zero_free_hp_log_le_poisson (hPartB : HardyPartBInterface) {p : ℝ≥0∞} (hp0 : p ≠ 0)
    {g : ℂ → ℂ} (hg : IsInHardySpace p g) (hg_nz : ∀ z ∈ Metric.ball (0 : ℂ) 1, g z ≠ 0)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    Real.log ‖g z‖ ≤
      ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) *
        Real.log ‖radialBoundaryLimit g ζ‖ ∂circleMeasure := by
  rcases eq_or_ne p ⊤ with rfl | hptop
  · -- `p = ⊤`: bounded holomorphic `g` belongs to `H^2`
    have hg_h2 : IsInHardySpace 2 g := by
      refine ⟨by norm_num, hg.2.1, ?_⟩
      refine (iSup₂_le fun r hr ↦ ?_).trans_lt hg.2.2
      simp only [radialSizeENNReal, show (2 : ℝ≥0∞) ≠ 0 by norm_num, ↓reduceIte]
      exact (eLpNorm_le_eLpNorm_of_exponent_le (by norm_num : (2 : ℝ≥0∞) ≤ ⊤)).trans
        (by
          have h := le_biSup (radialSizeENNReal ⊤ g) hr
          rwa [radialSizeENNReal, ite_eq_right_iff.mpr fun h0 ↦ (ENNReal.top_ne_zero h0).elim] at h)
    exact zero_free_h2_log_le_poisson hPartB hg_h2 hg_nz hz
  · -- `0 < p < ∞`: reduce to `h(w) = exp ((p.toReal / 2) * L w) ∈ H^2`
    have hq_pos : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
    have hq2_pos : 0 < p.toReal / 2 := half_pos hq_pos
    obtain ⟨L, hL_holo, hg_exp⟩ := exists_holomorphic_log_ball hg.2.1 hg_nz
    have hL_re : ∀ w ∈ Metric.ball (0 : ℂ) 1, (L w).re = Real.log ‖g w‖ := by
      intro w hw
      rw [hg_exp w hw, Complex.norm_exp, Real.log_exp]
    let h : ℂ → ℂ := fun w ↦ Complex.exp (((p.toReal / 2 : ℝ) : ℂ) * L w)
    have hh_holo : HolomorphicOn h (Metric.ball (0 : ℂ) 1) :=
      fun w hw ↦ ((differentiableAt_const _).mul (hL_holo w hw)).cexp
    have hh_nz : ∀ w ∈ Metric.ball (0 : ℂ) 1, h w ≠ 0 :=
      fun _ _ ↦ Complex.exp_ne_zero _
    have hh_norm : ∀ w ∈ Metric.ball (0 : ℂ) 1, ‖h w‖ = ‖g w‖ ^ (p.toReal / 2) := by
      intro w hw
      have hg_pos : 0 < ‖g w‖ := norm_pos_iff.mpr (hg_nz w hw)
      dsimp [h]
      rw [Complex.norm_exp, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul,
        sub_zero, hL_re w hw, mul_comm (p.toReal / 2), ← Real.rpow_def_of_pos hg_pos]
    have hh_h2 : IsInHardySpace 2 h := by
      refine ⟨by norm_num, hh_holo, ?_⟩
      let B : ℝ := (hardySize p g) ^ (p.toReal / 2)
      have hle : hardySizeENNReal 2 h ≤ ENNReal.ofReal B := by
        refine iSup₂_le fun r hr ↦ ?_
        have hcont_h := continuous_radialSlice_of_holomorphicOn hh_holo hr.1 hr.2
        have hcont_g := continuous_radialSlice_of_holomorphicOn hg.2.1 hr.1 hr.2
        have hmem_h := memLp_circleMeasure_of_continuous hcont_h 2
        have hmem_g := memLp_circleMeasure_of_continuous hcont_g p
        simp only [radialSizeENNReal, show (2 : ℝ≥0∞) ≠ 0 by norm_num, ↓reduceIte]
        rw [hmem_h.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
        refine ENNReal.ofReal_le_ofReal ?_
        have hsq_eq : (∫ ζ, ‖radialSlice h r ζ‖ ^ (2 : ℝ) ∂circleMeasure) =
            ∫ ζ, ‖radialSlice g r ζ‖ ^ p.toReal ∂circleMeasure := by
          refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
          have hw : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
            simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hr.1] using hr.2
          dsimp [radialSlice]
          rw [hh_norm _ hw, ← Real.rpow_mul (norm_nonneg _), div_mul_cancel₀ _ two_ne_zero]
        have hg_int_eq : ∫ ζ, ‖radialSlice g r ζ‖ ^ p.toReal ∂circleMeasure =
            (radialSize p g r) ^ p.toReal := by
          unfold radialSize radialSizeENNReal
          rw [ite_eq_right_iff.mpr fun h0 ↦ (hp0 h0).elim,
            hmem_g.eLpNorm_eq_integral_rpow_norm hp0 hptop]
          have hint_nn : 0 ≤ ∫ ζ, ‖radialSlice g r ζ‖ ^ p.toReal ∂circleMeasure :=
            integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _
          rw [ENNReal.toReal_ofReal (Real.rpow_nonneg hint_nn _),
            ← Real.rpow_mul hint_nn, inv_mul_cancel₀ hq_pos.ne', Real.rpow_one]
        have hrad_le : radialSize p g r ≤ hardySize p g :=
          ENNReal.toReal_mono hg.2.2.ne (le_biSup (radialSizeENNReal p g) hr)
        have h2_toReal : (2 : ℝ≥0∞).toReal = 2 := by norm_num
        rw [h2_toReal, hsq_eq, hg_int_eq,
          ← Real.rpow_mul (show 0 ≤ radialSize p g r from ENNReal.toReal_nonneg),
          ← div_eq_mul_inv]
        exact Real.rpow_le_rpow ENNReal.toReal_nonneg hrad_le hq2_pos.le
      exact hle.trans_lt ENNReal.ofReal_lt_top
    have hh_ineq := zero_free_h2_log_le_poisson hPartB hh_h2 hh_nz hz
    obtain ⟨_, _, hg_rad, hg_ae_nz, hg_log_int⟩ :=
      nevanlinna_quotient_and_boundary hPartB hg.toNevanlinna
        ⟨0, Metric.mem_ball_self zero_lt_one, hg_nz 0 (Metric.mem_ball_self zero_lt_one)⟩
    obtain ⟨hh_rad, _, _, _, _⟩ := hPartB.hardy_boundary (by norm_num) hh_h2
    have hae_log_h : ∀ᵐ ζ ∂circleMeasure,
        Real.log ‖radialBoundaryLimit h ζ‖ =
          (p.toReal / 2) * Real.log ‖radialBoundaryLimit g ζ‖ := by
      filter_upwards [hg_rad, hg_ae_nz, hh_rad] with ζ hgrad hgnz hhrad
      have hnorm_h_lim1 : Tendsto (fun r : ℝ ↦ ‖radialSlice h r ζ‖) (𝓝[<] 1)
          (𝓝 ‖radialBoundaryLimit h ζ‖) :=
        hhrad.norm
      have hnorm_h_lim2 : Tendsto (fun r : ℝ ↦ ‖radialSlice h r ζ‖) (𝓝[<] 1)
          (𝓝 (‖radialBoundaryLimit g ζ‖ ^ (p.toReal / 2))) := by
        have hrpow_cont : ContinuousAt (fun x : ℝ ↦ x ^ (p.toReal / 2))
            ‖radialBoundaryLimit g ζ‖ :=
          Real.continuousAt_rpow_const _ _ (Or.inl (norm_pos_iff.mpr hgnz).ne')
        refine (hrpow_cont.tendsto.comp hgrad.norm).congr' ?_
        filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
        refine (hh_norm _ ?_).symm
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hr.1] using hr.2
      have hnorm_eq := tendsto_nhds_unique hnorm_h_lim1 hnorm_h_lim2
      rw [hnorm_eq, Real.log_rpow (norm_pos_iff.mpr hgnz)]
    have hlhs : Real.log ‖h z‖ = (p.toReal / 2) * Real.log ‖g z‖ := by
      rw [hh_norm z hz, Real.log_rpow (norm_pos_iff.mpr (hg_nz z hz))]
    have hrhs : (∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) *
          Real.log ‖radialBoundaryLimit h ζ‖ ∂circleMeasure) =
        (p.toReal / 2) * ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) *
          Real.log ‖radialBoundaryLimit g ζ‖ ∂circleMeasure := by
      rw [← integral_const_mul]
      refine integral_congr_ae ?_
      filter_upwards [hae_log_h] with ζ hζ
      rw [hζ]
      ring
    rw [hlhs, hrhs] at hh_ineq
    exact le_of_mul_le_mul_left hh_ineq hq2_pos

/-- **Theorem 17.17 (Canonical Inner–Outer Factorization `f = M_f · Q_f` for `0 < p ≤ ∞`,
RCA pp. 344–345):**
Let `0 < p ≤ ∞` (`p ≠ 0`) and let `f ∈ H^p` be not identically `0` on `U = Metric.ball 0 1`. Then:
1. `log ‖f*‖ ∈ L¹(T)` and `0 < ‖f*(ζ)‖` `circleMeasure`-a.e.;
2. The canonical outer factor `Q_f = canonicalOuterFactor f` satisfies `IsOuterFunction Q_f`,
   `IsInHardySpace p Q_f`, and `hardySizeENNReal p Q_f = hardySizeENNReal p f`;
3. The canonical inner factor `M_f = canonicalInnerFactor f` satisfies `IsInnerFunction M_f` and
   `f z = M_f z * Q_f z` for all `z ∈ U`;
4. `‖f z‖ ≤ ‖Q_f z‖` on `U`, and at `z = 0`,
   `‖f 0‖ ≤ exp (∫_T log ‖f*‖ dσ)` (so if `f 0 ≠ 0`, `log ‖f 0‖ ≤ ∫_T log ‖f*‖ dσ`);
5. Equality `(f 0 ≠ 0 ∧ Real.log ‖f 0‖ = ∫_T Real.log ‖f*‖ dσ)` holds if and only if `M_f` is a
   unit-modulus constant on `U`, if and only if `IsOuterFunction f`. -/
theorem theorem17_17 (hPartB : HardyPartBInterface) {p : ℝ≥0∞} (hp0 : p ≠ 0) {f : ℂ → ℂ}
    (hf : IsInHardySpace p f) (hex_nz : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) :
    Integrable (fun ζ ↦ Real.log ‖radialBoundaryLimit f ζ‖) circleMeasure ∧
    (∀ᵐ ζ ∂circleMeasure, 0 < ‖radialBoundaryLimit f ζ‖) ∧
    IsOuterFunction (canonicalOuterFactor f) ∧
    IsInHardySpace p (canonicalOuterFactor f) ∧
    hardySizeENNReal p (canonicalOuterFactor f) = hardySizeENNReal p f ∧
    IsInnerFunction (canonicalInnerFactor f) ∧
    (∀ z ∈ Metric.ball (0 : ℂ) 1, f z = canonicalInnerFactor f z * canonicalOuterFactor f z) ∧
    (∀ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ ≤ ‖canonicalOuterFactor f z‖) ∧
    ‖f 0‖ ≤ Real.exp (∫ ζ, Real.log ‖radialBoundaryLimit f ζ‖ ∂circleMeasure) ∧
    (f 0 ≠ 0 → Real.log ‖f 0‖ ≤ ∫ ζ, Real.log ‖radialBoundaryLimit f ζ‖ ∂circleMeasure) ∧
    (((f 0 ≠ 0 ∧ Real.log ‖f 0‖ = ∫ ζ, Real.log ‖radialBoundaryLimit f ζ‖ ∂circleMeasure) ↔
      ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ z ∈ Metric.ball (0 : ℂ) 1, canonicalInnerFactor f z = c) ∧
     ((f 0 ≠ 0 ∧ Real.log ‖f 0‖ = ∫ ζ, Real.log ‖radialBoundaryLimit f ζ‖ ∂circleMeasure) ↔
      IsOuterFunction f)) := by
  obtain ⟨_, _, hf_rad, hf_ae_nz, hf_log_int⟩ :=
    nevanlinna_quotient_and_boundary hPartB hf.toNevanlinna hex_nz
  obtain ⟨_, hf_memLp, hf_eLp, _, _⟩ := hPartB.hardy_boundary hp0 hf
  have hf_ae_pos : ∀ᵐ ζ ∂circleMeasure, 0 < ‖radialBoundaryLimit f ζ‖ :=
    hf_ae_nz.mono fun _ h ↦ norm_pos_iff.mpr h
  let φ : FourierCircle → ℝ := fun ζ ↦ ‖radialBoundaryLimit f ζ‖
  have hφ_meas : AEMeasurable φ circleMeasure := hf_memLp.aestronglyMeasurable.aemeasurable.norm
  have hφ_memLp : MemLp φ p circleMeasure := hf_memLp.norm
  -- Properties of `Q_f = canonicalOuterFactor f = outerFunction 1 φ`
  have hQf_outer : IsOuterFunction (canonicalOuterFactor f) :=
    ⟨1, φ, norm_one, hφ_meas, hf_ae_pos, hf_log_int, fun _ _ ↦ rfl⟩
  obtain ⟨hQf_log, hQf_rad_norm, hQf_p⟩ :=
    theorem17_16 (c := 1) norm_one hφ_meas hf_ae_pos hf_log_int
  obtain ⟨hQf_hp_iff, hQf_size_eq, _⟩ := hQf_p p hp0
  have hQf_hp : IsInHardySpace p (canonicalOuterFactor f) :=
    hQf_hp_iff.mpr hφ_memLp
  have hQf_size : hardySizeENNReal p (canonicalOuterFactor f) = hardySizeENNReal p f := by
    calc hardySizeENNReal p (canonicalOuterFactor f)
        = eLpNorm φ p circleMeasure := hQf_size_eq
      _ = eLpNorm (radialBoundaryLimit f) p circleMeasure :=
          eLpNorm_norm (radialBoundaryLimit f) hf_memLp.aestronglyMeasurable
      _ = hardySizeENNReal p f := hf_eLp
  have hQf_holo : HolomorphicOn (canonicalOuterFactor f) (Metric.ball (0 : ℂ) 1) :=
    holomorphicOn_outerFunction hf_log_int
  have hQf_nz : ∀ z ∈ Metric.ball (0 : ℂ) 1, canonicalOuterFactor f z ≠ 0 :=
    fun _ hz ↦ outerFunction_ne_zero one_ne_zero φ hz
  -- Divide `f = B * g` via `hPartB.blaschke_div` to get `‖f z‖ ≤ ‖Q_f z‖` on `ball 0 1`
  obtain ⟨B, g, hB, hg_nev, hg_nz, hfBg, _, hHp_iff⟩ := hPartB.blaschke_div hf.toNevanlinna hex_nz
  have hg_hp : IsInHardySpace p g := ((hHp_iff p hp0).1).mp hf
  have hB_inner := isInnerFunction_of_isBlaschkeProduct hB
  obtain ⟨hg_rad, _, _, _, _⟩ := hPartB.hardy_boundary hp0 hg_hp
  have hae_g_eq_f : ∀ᵐ ζ ∂circleMeasure,
      ‖radialBoundaryLimit g ζ‖ = ‖radialBoundaryLimit f ζ‖ := by
    filter_upwards [hf_rad, hB_inner.ae_tendsto, hB_inner.2.2, hg_rad] with ζ hfr hBr hB1 hgr
    have hprod : Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1)
        (𝓝 (radialBoundaryLimit B ζ * radialBoundaryLimit g ζ)) := by
      refine (hBr.mul hgr).congr' ?_
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
      refine (hfBg _ ?_).symm
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hr.1] using hr.2
    have heq := tendsto_nhds_unique hfr hprod
    have hn := congr_arg norm heq
    rw [norm_mul, hB1, one_mul] at hn
    exact hn.symm
  have hf_le_Qf : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ ≤ ‖canonicalOuterFactor f z‖ := by
    intro z hz
    have hg_log_le := zero_free_hp_log_le_poisson hPartB hp0 hg_hp hg_nz hz
    have hint_eq : (∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) *
          Real.log ‖radialBoundaryLimit g ζ‖ ∂circleMeasure) =
        Real.log ‖canonicalOuterFactor f z‖ := by
      unfold canonicalOuterFactor
      rw [hQf_log z hz]
      refine integral_congr_ae ?_
      filter_upwards [hae_g_eq_f] with ζ hζ
      dsimp [φ]
      rw [hζ]
    rw [hint_eq] at hg_log_le
    have hg_le_Qf : ‖g z‖ ≤ ‖canonicalOuterFactor f z‖ := by
      rw [← Real.exp_log (norm_pos_iff.mpr (hg_nz z hz)),
        ← Real.exp_log (norm_pos_iff.mpr (hQf_nz z hz))]
      exact Real.exp_le_exp.mpr hg_log_le
    rw [hfBg z hz, norm_mul]
    calc ‖B z‖ * ‖g z‖
        ≤ 1 * ‖g z‖ := mul_le_mul_of_nonneg_right (hB_inner.2.1 z hz) (norm_nonneg _)
      _ = ‖g z‖ := one_mul _
      _ ≤ ‖canonicalOuterFactor f z‖ := hg_le_Qf
  -- Properties of `M_f = canonicalInnerFactor f`
  have hMf_holo : HolomorphicOn (canonicalInnerFactor f) (Metric.ball (0 : ℂ) 1) := by
    intro z hz
    have hd : DifferentiableAt ℂ (fun w ↦ f w / canonicalOuterFactor f w) z :=
      (hf.2.1 z hz).div (hQf_holo z hz) (hQf_nz z hz)
    exact hd.congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz) fun _ hw ↦
        Set.indicator_of_mem hw _)
  have hMf_le1 : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖canonicalInnerFactor f z‖ ≤ 1 := by
    intro z hz
    rw [canonicalInnerFactor, Set.indicator_of_mem hz, norm_div]
    exact (div_le_one (norm_pos_iff.mpr (hQf_nz z hz))).mpr (hf_le_Qf z hz)
  have hf_fac : ∀ z ∈ Metric.ball (0 : ℂ) 1,
      f z = canonicalInnerFactor f z * canonicalOuterFactor f z := by
    intro z hz
    rw [canonicalInnerFactor, Set.indicator_of_mem hz, div_mul_cancel₀ _ (hQf_nz z hz)]
  obtain ⟨hQf_rad, _, _, _, _⟩ := hPartB.hardy_boundary hp0 hQf_hp
  have hMf_inner : IsInnerFunction (canonicalInnerFactor f) := by
    refine ⟨hMf_holo, hMf_le1, ?_⟩
    filter_upwards [hf_rad, hf_ae_nz, hQf_rad, hQf_rad_norm] with ζ hfr hfnz hQfr hQfn
    have hQf_norm_eq : ‖radialBoundaryLimit (canonicalOuterFactor f) ζ‖ =
        ‖radialBoundaryLimit f ζ‖ :=
      tendsto_nhds_unique hQfr.norm hQfn
    have hQf_lim_nz : radialBoundaryLimit (canonicalOuterFactor f) ζ ≠ 0 :=
      norm_ne_zero_iff.mp (hQf_norm_eq ▸ norm_ne_zero_iff.mpr hfnz)
    have hMf_lim : Tendsto (fun r : ℝ ↦ radialSlice (canonicalInnerFactor f) r ζ) (𝓝[<] 1)
        (𝓝 (radialBoundaryLimit f ζ / radialBoundaryLimit (canonicalOuterFactor f) ζ)) := by
      refine (hfr.div hQfr hQf_lim_nz).congr' ?_
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
      have hw : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hr.1] using hr.2
      exact (Set.indicator_of_mem hw (fun w ↦ f w / canonicalOuterFactor f w)).symm
    rw [radialBoundaryLimit_eq_of_tendsto hMf_lim, norm_div, hQf_norm_eq,
      div_self (norm_pos_iff.mpr hfnz).ne']
  -- Evaluation at `z = 0` and equality characterization
  have hz0_ball : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
  have hQf0_norm : ‖canonicalOuterFactor f 0‖ =
      Real.exp (∫ ζ, Real.log ‖radialBoundaryLimit f ζ‖ ∂circleMeasure) := by
    have hlog0 := hQf_log 0 hz0_ball
    have hP0 : ∀ ζ : FourierCircle, _root_.poissonKernel 0 0 (circlePoint ζ) = 1 := by
      intro ζ
      rw [poissonKernel_circlePoint_formula]
      simp
    simp_rw [hP0, one_mul] at hlog0
    rw [← Real.exp_log (norm_pos_iff.mpr (hQf_nz 0 hz0_ball))]
    unfold canonicalOuterFactor
    rw [hlog0]
  have hf0_le : ‖f 0‖ ≤ Real.exp (∫ ζ, Real.log ‖radialBoundaryLimit f ζ‖ ∂circleMeasure) :=
    hQf0_norm ▸ hf_le_Qf 0 hz0_ball
  have hf0_log_le : f 0 ≠ 0 →
      Real.log ‖f 0‖ ≤ ∫ ζ, Real.log ‖radialBoundaryLimit f ζ‖ ∂circleMeasure := by
    intro hne0
    have h1 := Real.log_le_log (norm_pos_iff.mpr hne0) hf0_le
    rwa [Real.log_exp] at h1
  have heq_iff_const :
      (f 0 ≠ 0 ∧ Real.log ‖f 0‖ = ∫ ζ, Real.log ‖radialBoundaryLimit f ζ‖ ∂circleMeasure) ↔
        ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ z ∈ Metric.ball (0 : ℂ) 1, canonicalInnerFactor f z = c := by
    constructor
    · rintro ⟨hne0, hlog_eq⟩
      have hnorm0_eq : ‖f 0‖ = ‖canonicalOuterFactor f 0‖ := by
        rw [hQf0_norm, ← hlog_eq, Real.exp_log (norm_pos_iff.mpr hne0)]
      have hMf0_norm : ‖canonicalInnerFactor f 0‖ = 1 := by
        rw [canonicalInnerFactor, Set.indicator_of_mem hz0_ball, norm_div, hnorm0_eq,
          div_self (norm_pos_iff.mpr (hQf_nz 0 hz0_ball)).ne']
      refine ⟨canonicalInnerFactor f 0, hMf0_norm,
        eq_const_on_ball_of_norm_le_one_of_norm_zero_eq_one hMf_holo hMf_le1 hMf0_norm⟩
    · rintro ⟨c, hc, hMf_eq⟩
      have hc_ne : c ≠ 0 := norm_ne_zero_iff.mp (hc ▸ one_ne_zero)
      have hf0_eq : f 0 = c * canonicalOuterFactor f 0 := by
        rw [hf_fac 0 hz0_ball, hMf_eq 0 hz0_ball]
      have hne0 : f 0 ≠ 0 := hf0_eq ▸ mul_ne_zero hc_ne (hQf_nz 0 hz0_ball)
      refine ⟨hne0, ?_⟩
      rw [hf0_eq, norm_mul, hc, one_mul, hQf0_norm, Real.log_exp]
  have heq_iff_outer :
      (∃ c : ℂ, ‖c‖ = 1 ∧ ∀ z ∈ Metric.ball (0 : ℂ) 1, canonicalInnerFactor f z = c) ↔
        IsOuterFunction f := by
    constructor
    · rintro ⟨c, hc, hMf_eq⟩
      refine ⟨c, φ, hc, hφ_meas, hf_ae_pos, hf_log_int, fun z hz ↦ ?_⟩
      rw [hf_fac z hz, hMf_eq z hz, canonicalOuterFactor,
        outerFunction_apply_of_mem 1 φ hz, outerFunction_apply_of_mem c φ hz, one_mul]
    · rintro ⟨c, ψ, hc, _, hψ_pos, hψ_log, hf_eq⟩
      have hψ_rad := outerFunction_ae_tendsto_norm hc hψ_pos hψ_log
      have hae_ψ_eq_φ : ψ =ᵐ[circleMeasure] φ := by
        filter_upwards [hf_rad, hψ_rad] with ζ hfr hψr
        have hfr' : Tendsto (fun r : ℝ ↦ ‖radialSlice (outerFunction c ψ) r ζ‖) (𝓝[<] 1)
            (𝓝 (φ ζ)) := by
          refine hfr.norm.congr' ?_
          filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
          exact congr_arg norm (hf_eq (by
            simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_pos hr.1] using hr.2))
        exact tendsto_nhds_unique hψr hfr'
      refine ⟨c, hc, fun z hz ↦ ?_⟩
      have hint_eq : (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) *
            (Real.log (ψ ζ) : ℂ) ∂circleMeasure) =
          ∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) *
            (Real.log (φ ζ) : ℂ) ∂circleMeasure := by
        refine integral_congr_ae ?_
        filter_upwards [hae_ψ_eq_φ] with ζ hζ
        rw [hζ]
      rw [canonicalInnerFactor, Set.indicator_of_mem hz, hf_eq hz, canonicalOuterFactor,
        outerFunction_apply_of_mem c ψ hz, outerFunction_apply_of_mem 1 φ hz, one_mul, hint_eq,
        mul_div_cancel_right₀ c (Complex.exp_ne_zero _)]
  exact ⟨hf_log_int, hf_ae_pos, hQf_outer, hQf_hp, hQf_size, hMf_inner, hf_fac, hf_le_Qf,
    hf0_le, hf0_log_le, heq_iff_const, heq_iff_const.trans heq_iff_outer⟩

/-! ### Section 17.18: Boundary Nonvanishing & Uniqueness for `0 < p ≤ ∞` (RCA p. 345) -/

/-- **Theorem 17.18 (Boundary Nonvanishing & Positive-Measure Uniqueness for `0 < p ≤ ∞`,
RCA p. 345):**
1. If `0 < p ≤ ∞` (`p ≠ 0`) and `f ∈ H^p` is not identically `0` on `U = Metric.ball 0 1`, then
   `radialBoundaryLimit f ζ ≠ 0` for `circleMeasure`-almost every `ζ ∈ T`.
2. If `0 < p ≤ ∞` (`p ≠ 0`), `f₁, f₂ ∈ H^p`, and `radialBoundaryLimit f₁` agrees with
   `radialBoundaryLimit f₂` on a set `E ⊆ T` of positive measure (`0 < circleMeasure E`), then
   `f₁ z = f₂ z` for all `z ∈ U = Metric.ball 0 1`. -/
theorem theorem17_18 (hPartB : HardyPartBInterface) {p : ℝ≥0∞} (hp0 : p ≠ 0) :
    (∀ {f : ℂ → ℂ}, IsInHardySpace p f → (∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) →
      ∀ᵐ ζ ∂circleMeasure, radialBoundaryLimit f ζ ≠ 0) ∧
    (∀ {f₁ f₂ : ℂ → ℂ} {E : Set FourierCircle},
      IsInHardySpace p f₁ → IsInHardySpace p f₂ →
      0 < circleMeasure E →
      (∀ ζ ∈ E, radialBoundaryLimit f₁ ζ = radialBoundaryLimit f₂ ζ) →
      ∀ z ∈ Metric.ball (0 : ℂ) 1, f₁ z = f₂ z) := by
  refine ⟨fun hf hex ↦ (nevanlinna_quotient_and_boundary hPartB hf.toNevanlinna hex).2.2.2.1, ?_⟩
  intro f₁ f₂ E hf₁ hf₂ hE_pos hE_eq z hz
  by_contra hne
  have hdiff_nev : IsInNevanlinnaClassCh17 (f₁ - f₂) :=
    IsInNevanlinnaClassCh17.sub hf₁.toNevanlinna hf₂.toNevanlinna
  have hex_diff : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, (f₁ - f₂) z₀ ≠ 0 :=
    ⟨z, hz, sub_ne_zero.mpr hne⟩
  have hae_diff_nz :=
    (nevanlinna_quotient_and_boundary hPartB hdiff_nev hex_diff).2.2.2.1
  obtain ⟨hf₁_rad, _, _, _, _⟩ := hPartB.hardy_boundary hp0 hf₁
  obtain ⟨hf₂_rad, _, _, _, _⟩ := hPartB.hardy_boundary hp0 hf₂
  have hae_not_E : ∀ᵐ ζ ∂circleMeasure, ζ ∉ E := by
    filter_upwards [hae_diff_nz, hf₁_rad, hf₂_rad] with ζ hnz hr₁ hr₂ hζE
    have hlim_sub : radialBoundaryLimit (f₁ - f₂) ζ =
        radialBoundaryLimit f₁ ζ - radialBoundaryLimit f₂ ζ :=
      radialBoundaryLimit_eq_of_tendsto (hr₁.sub hr₂)
    rw [hlim_sub, hE_eq ζ hζE, sub_self] at hnz
    exact hnz rfl
  have hE_zero : circleMeasure E = 0 := by
    simpa [ae_iff] using hae_not_E
  exact hE_pos.ne' hE_zero


/-! #### Unconditional `H²` Taylor/Parseval theory and `HardyElem 2` Hilbert space structure -/

/-- The `n`-th Maclaurin coefficient `f^{(n)}(0) / n!` of `f : ℂ → ℂ`. -/
def taylorCoeff (f : ℂ → ℂ) (n : ℕ) : ℂ :=
  iteratedDeriv n f 0 / (Nat.factorial n : ℂ)

theorem hasSum_taylorCoeff_ball {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    HasSum (fun n : ℕ ↦ taylorCoeff f n * z ^ n) (f z) := by
  have hd : DifferentiableOn ℂ f (Metric.ball (0 : ℂ) 1) :=
    fun w hw ↦ (hf w hw).differentiableWithinAt
  convert Complex.hasSum_taylorSeries_on_ball hd hz using 1
  funext n
  simp only [taylorCoeff, sub_zero, smul_eq_mul, div_eq_mul_inv]
  ring

theorem radialSize_two_sq_hasSum {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    HasSum (fun n : ℕ ↦ ‖taylorCoeff f n‖ ^ 2 * r ^ (2 * n)) ((radialSize 2 f r) ^ 2) := by
  have hcont := continuous_radialSlice_of_holomorphicOn hf hr0 hr1
  have hmem := memLp_circleMeasure_of_continuous hcont 2
  have hrad_sq : (radialSize 2 f r) ^ 2 = ∫ ζ, ‖radialSlice f r ζ‖ ^ 2 ∂circleMeasure := by
    unfold radialSize radialSizeENNReal
    rw [ite_eq_right_iff.mpr fun h ↦ absurd h (by norm_num),
      hmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    have h2 : (2 : ℝ≥0∞).toReal = 2 := by norm_num
    rw [h2]
    have hint_nn : 0 ≤ ∫ ζ, ‖radialSlice f r ζ‖ ^ (2 : ℝ) ∂circleMeasure :=
      integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _
    rw [ENNReal.toReal_ofReal (Real.rpow_nonneg hint_nn _), ← Real.rpow_two,
      ← Real.rpow_mul hint_nn, inv_mul_cancel₀ two_ne_zero, Real.rpow_one]
    exact integral_congr_ae (Eventually.of_forall fun _ ↦ Real.rpow_two _)
  rw [hrad_sq]
  rcases eq_or_lt_of_le hr0 with rfl | hr_pos
  · have hslice0 : (∫ ζ, ‖radialSlice f 0 ζ‖ ^ 2 ∂circleMeasure) = ‖f 0‖ ^ 2 := by
      simp [radialSlice]
    have hc0 : taylorCoeff f 0 = f 0 := by simp [taylorCoeff]
    rw [hslice0, ← hc0]
    convert hasSum_single (f := fun n : ℕ ↦ ‖taylorCoeff f n‖ ^ 2 * (0 : ℝ) ^ (2 * n)) 0
      (fun n hn ↦ ?_) using 1
    · simp
    · obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hn
      simp
  · have hca : (∫ ζ, ‖radialSlice f r ζ‖ ^ 2 ∂circleMeasure) =
        (2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..2 * Real.pi, ‖f (circleMap 0 r θ)‖ ^ 2 := by
      have h1 := integral_radialSlice_eq_circleAverage (fun w : ℂ ↦ ‖f w‖ ^ 2) r
      simpa [radialSlice, Real.circleAverage_def, smul_eq_mul] using h1
    rw [hca]
    exact (RudinRCA.Chapter10.theorem10_22 (a := 0) (R := 1) hr_pos hr1
      (fun z hz ↦ by simpa [RudinRCA.Chapter10.disc] using hasSum_taylorCoeff_ball hf hz)).1

theorem isInHardySpace_two_iff_summable_taylorCoeff {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    (IsInHardySpace 2 f ↔ Summable (fun n : ℕ ↦ ‖taylorCoeff f n‖ ^ 2)) ∧
    (IsInHardySpace 2 f → (hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖taylorCoeff f n‖ ^ 2) := by
  have h_from_sum : Summable (fun n : ℕ ↦ ‖taylorCoeff f n‖ ^ 2) →
      IsInHardySpace 2 f ∧ (hardySize 2 f) ^ 2 ≤ ∑' n : ℕ, ‖taylorCoeff f n‖ ^ 2 := by
    intro hsum
    let S : ℝ := ∑' n : ℕ, ‖taylorCoeff f n‖ ^ 2
    have hS_nn : 0 ≤ S := tsum_nonneg fun _ ↦ sq_nonneg _
    have hrad_le : ∀ r ∈ Set.Ico (0 : ℝ) 1, radialSize 2 f r ≤ Real.sqrt S := by
      intro r hr
      have hhas := radialSize_two_sq_hasSum hf hr.1 hr.2
      have hsq_le : (radialSize 2 f r) ^ 2 ≤ S := by
        rw [← hhas.tsum_eq]
        refine hhas.summable.tsum_le_tsum (fun n ↦ ?_) hsum
        have hr_pow : r ^ (2 * n) ≤ 1 := pow_le_one₀ hr.1 hr.2.le
        exact (mul_le_mul_of_nonneg_left hr_pow (sq_nonneg _)).trans_eq (mul_one _)
      exact (Real.le_sqrt (ENNReal.toReal_nonneg) hS_nn).mpr hsq_le
    have hENN_le : hardySizeENNReal 2 f ≤ ENNReal.ofReal (Real.sqrt S) := by
      refine iSup₂_le fun r hr ↦ ?_
      have hcont := continuous_radialSlice_of_holomorphicOn hf hr.1 hr.2
      have hfin : radialSizeENNReal 2 f r ≠ ⊤ := by
        simp only [radialSizeENNReal, show (2 : ℝ≥0∞) ≠ 0 by norm_num, ↓reduceIte]
        exact (memLp_circleMeasure_of_continuous hcont 2).eLpNorm_lt_top.ne
      rw [← ENNReal.ofReal_toReal hfin]
      exact ENNReal.ofReal_le_ofReal (hrad_le r hr)
    have hhp : IsInHardySpace 2 f :=
      ⟨by norm_num, hf, hENN_le.trans_lt ENNReal.ofReal_lt_top⟩
    have hsize_le : hardySize 2 f ≤ Real.sqrt S := by
      have h := ENNReal.toReal_mono ENNReal.ofReal_ne_top hENN_le
      rwa [ENNReal.toReal_ofReal (Real.sqrt_nonneg S)] at h
    refine ⟨hhp, ?_⟩
    calc (hardySize 2 f) ^ 2
        ≤ (Real.sqrt S) ^ 2 := pow_le_pow_left₀ ENNReal.toReal_nonneg hsize_le 2
      _ = S := Real.sq_sqrt hS_nn
  have h_to_sum : IsInHardySpace 2 f →
      Summable (fun n : ℕ ↦ ‖taylorCoeff f n‖ ^ 2) ∧
        (∑' n : ℕ, ‖taylorCoeff f n‖ ^ 2) ≤ (hardySize 2 f) ^ 2 := by
    intro hhp
    have hfin_le : ∀ N : ℕ, ∑ n ∈ Finset.range N, ‖taylorCoeff f n‖ ^ 2 ≤ (hardySize 2 f) ^ 2 := by
      intro N
      have htend : Tendsto
          (fun r : ℝ ↦ ∑ n ∈ Finset.range N, ‖taylorCoeff f n‖ ^ 2 * r ^ (2 * n))
          (𝓝[<] (1 : ℝ)) (𝓝 (∑ n ∈ Finset.range N, ‖taylorCoeff f n‖ ^ 2)) := by
        have hcont_sum : Continuous
            (fun r : ℝ ↦ ∑ n ∈ Finset.range N, ‖taylorCoeff f n‖ ^ 2 * r ^ (2 * n)) :=
          continuous_finsetSum _ fun n _ ↦ continuous_const.mul (continuous_pow (2 * n))
        simpa using (hcont_sum.continuousAt (x := (1 : ℝ))).tendsto.mono_left nhdsWithin_le_nhds
      refine le_of_tendsto htend ?_
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
      have hhas := radialSize_two_sq_hasSum hf hr.1.le hr.2
      have hpart_le : ∑ n ∈ Finset.range N, ‖taylorCoeff f n‖ ^ 2 * r ^ (2 * n) ≤
          (radialSize 2 f r) ^ 2 :=
        sum_le_hasSum (Finset.range N) (fun n _ ↦ mul_nonneg (sq_nonneg _) (pow_nonneg hr.1.le _)) hhas
      have hrad_le : radialSize 2 f r ≤ hardySize 2 f :=
        ENNReal.toReal_mono hhp.2.2.ne (le_biSup (radialSizeENNReal 2 f) ⟨hr.1.le, hr.2⟩)
      exact hpart_le.trans (pow_le_pow_left₀ ENNReal.toReal_nonneg hrad_le 2)
    have hsum : Summable (fun n : ℕ ↦ ‖taylorCoeff f n‖ ^ 2) :=
      summable_of_sum_range_le (fun _ ↦ sq_nonneg _) hfin_le
    exact ⟨hsum, hsum.tsum_le_of_sum_range_le hfin_le⟩
  refine ⟨⟨fun h ↦ (h_to_sum h).1, fun h ↦ (h_from_sum h).1⟩, fun h ↦ ?_⟩
  exact le_antisymm (h_from_sum (h_to_sum h).1).2 (h_to_sum h).2

/-- Synthesis of a power series on `U = Metric.ball 0 1` from an `ℓ²(ℕ)` coefficient sequence
(extended by `0` outside `U`). -/
def lpSeriesFun (a : lp (fun _ : ℕ ↦ ℂ) 2) (z : ℂ) : ℂ :=
  (Metric.ball (0 : ℂ) 1).indicator (fun w ↦ ∑' n : ℕ, a n * w ^ n) z

theorem norm_lp_apply_le (a : lp (fun _ : ℕ ↦ ℂ) 2) (n : ℕ) : ‖a n‖ ≤ ‖a‖ := by
  have hhas : HasSum (fun k : ℕ ↦ ‖a k‖ ^ 2) (‖a‖ ^ 2) := by
    simpa using lp.hasSum_norm (p := 2) (by norm_num) a
  have hsq : ‖a n‖ ^ 2 ≤ ‖a‖ ^ 2 :=
    le_hasSum hhas n fun k _ ↦ sq_nonneg ‖a k‖
  exact (abs_le_of_sq_le_sq' hsq (norm_nonneg a)).2

theorem lpSeriesFun_holomorphic_and_hasSum (a : lp (fun _ : ℕ ↦ ℂ) 2) :
    HolomorphicOn (lpSeriesFun a) (Metric.ball (0 : ℂ) 1) ∧
    (∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ a n * z ^ n) (lpSeriesFun a z)) ∧
    taylorCoeff (lpSeriesFun a) = fun n : ℕ ↦ a n := by
  have hsum_ball : ∀ r : ℝ, 0 ≤ r → r < 1 →
      Summable (fun n : ℕ ↦ ‖a‖ * r ^ n) := fun r hr0 hr1 ↦
    (summable_geometric_of_lt_one hr0 hr1).mul_left ‖a‖
  have hhas : ∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ a n * z ^ n) (lpSeriesFun a z) := by
    intro z hz
    have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
    have hsummable : Summable (fun n : ℕ ↦ a n * z ^ n) := by
      refine Summable.of_norm_bounded (hsum_ball ‖z‖ (norm_nonneg z) hz_lt) fun n ↦ ?_
      rw [norm_mul, norm_pow]
      exact mul_le_mul_of_nonneg_right (norm_lp_apply_le a n) (pow_nonneg (norm_nonneg z) n)
    simpa [lpSeriesFun, Set.indicator_of_mem hz] using hsummable.hasSum
  let S : ℕ → ℂ → ℂ := fun N z ↦ ∑ n ∈ Finset.range N, a n * z ^ n
  have hS_holo : ∀ N : ℕ, HolomorphicOn (S N) (Metric.ball (0 : ℂ) 1) := by
    intro N
    induction N with
    | zero =>
      simp only [S, Finset.range_zero, Finset.sum_empty]
      exact fun _ _ ↦ differentiableAt_const 0
    | succ N ih =>
      intro z hz
      simp only [S, Finset.sum_range_succ]
      exact (ih z hz).add ((differentiableAt_const (a N)).mul (differentiableAt_id.pow N))
  have hconv : RudinRCA.Chapter10.ConvergesOnCompactSubsets S (lpSeriesFun a) (Metric.ball (0 : ℂ) 1) := by
    intro K hK hK_comp
    rcases K.eq_empty_or_nonempty with rfl | hKne
    · exact tendstoUniformlyOn_empty
    · obtain ⟨w₀, hw₀, hmax⟩ := hK_comp.exists_isMaxOn hKne continuous_norm.continuousOn
      have hw₀_lt : ‖w₀‖ < 1 := by simpa [Metric.mem_ball] using hK hw₀
      have hunif := tendstoUniformlyOn_tsum_nat (f := fun n (z : ℂ) ↦ (a n : ℂ) * z ^ n)
        (hsum_ball ‖w₀‖ (norm_nonneg w₀) hw₀_lt) (s := K) fun n z hz ↦ by
          rw [norm_mul, norm_pow]
          exact mul_le_mul (norm_lp_apply_le a n)
            (pow_le_pow_left₀ (norm_nonneg z) (hmax hz) n)
            (pow_nonneg (norm_nonneg z) n) (norm_nonneg a)
      exact hunif.congr_right fun z hz ↦ by simp [lpSeriesFun, Set.indicator_of_mem (hK hz)]
  have hholo : HolomorphicOn (lpSeriesFun a) (Metric.ball (0 : ℂ) 1) :=
    (RudinRCA.Chapter10.holomorphicOn_limit_and_deriv Metric.isOpen_ball hS_holo hconv).1
  have hcoeff : taylorCoeff (lpSeriesFun a) = fun n : ℕ ↦ a n := by
    refine RudinRCA.Chapter10.powerSeries_coefficients_unique (f := lpSeriesFun a)
      (a := 0) (r := 1) zero_lt_one (fun z hz ↦ ?_) (fun z hz ↦ ?_)
    · simpa [RudinRCA.Chapter10.disc] using hasSum_taylorCoeff_ball hholo hz
    · simpa [RudinRCA.Chapter10.disc] using hhas z hz
  exact ⟨hholo, hhas, hcoeff⟩

/-- Synthesis map `ℓ²(ℕ) → H²` sending `(a_n)` to `∑_{n=0}^∞ a_n z^n`. -/
def lpToH2 (a : lp (fun _ : ℕ ↦ ℂ) 2) : HardyElem 2 where
  toFun := lpSeriesFun a
  mem_hardy := by
    obtain ⟨hholo, _, hcoeff⟩ := lpSeriesFun_holomorphic_and_hasSum a
    refine (isInHardySpace_two_iff_summable_taylorCoeff hholo).1.mpr ?_
    rw [hcoeff]
    have hhas : HasSum (fun n : ℕ ↦ ‖a n‖ ^ 2) (‖a‖ ^ 2) := by
      simpa using lp.hasSum_norm (p := 2) (by norm_num) a
    exact hhas.summable
  eq_zero_outside z hz := Set.indicator_of_notMem hz _

/-- Coefficient map `H² → ℓ²(ℕ)` sending `F` to its Maclaurin sequence `(taylorCoeff F.toFun n)`. -/
def h2ToLp (F : HardyElem 2) : lp (fun _ : ℕ ↦ ℂ) 2 :=
  ⟨taylorCoeff F.toFun, memℓp_gen (by
    simpa using (isInHardySpace_two_iff_summable_taylorCoeff F.mem_hardy.2.1).1.mp F.mem_hardy)⟩

@[simp]
theorem h2ToLp_apply (F : HardyElem 2) (n : ℕ) : h2ToLp F n = taylorCoeff F.toFun n := rfl

theorem taylorCoeff_add {f g : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1))
    (hg : HolomorphicOn g (Metric.ball (0 : ℂ) 1)) :
    taylorCoeff (f + g) = taylorCoeff f + taylorCoeff g := by
  refine RudinRCA.Chapter10.powerSeries_coefficients_unique (f := f + g)
    (a := 0) (r := 1) zero_lt_one (fun z hz ↦ ?_) (fun z hz ↦ ?_)
  · simpa [RudinRCA.Chapter10.disc] using
      hasSum_taylorCoeff_ball (fun w hw ↦ (hf w hw).add (hg w hw)) hz
  · have h := (hasSum_taylorCoeff_ball hf hz).add (hasSum_taylorCoeff_ball hg hz)
    simpa [RudinRCA.Chapter10.disc, add_mul] using h

theorem taylorCoeff_smul (c : ℂ) {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    taylorCoeff (c • f) = c • taylorCoeff f := by
  refine RudinRCA.Chapter10.powerSeries_coefficients_unique (f := c • f)
    (a := 0) (r := 1) zero_lt_one (fun z hz ↦ ?_) (fun z hz ↦ ?_)
  · simpa [RudinRCA.Chapter10.disc] using
      hasSum_taylorCoeff_ball (fun w hw ↦ (hf w hw).const_smul c) hz
  · have h := (hasSum_taylorCoeff_ball hf hz).const_smul c
    simpa [RudinRCA.Chapter10.disc, mul_assoc] using h

theorem h2ToLp_lpToH2 (a : lp (fun _ : ℕ ↦ ℂ) 2) : h2ToLp (lpToH2 a) = a := by
  ext n
  have h := congr_fun (lpSeriesFun_holomorphic_and_hasSum a).2.2 n
  exact h

theorem lpToH2_h2ToLp (F : HardyElem 2) : lpToH2 (h2ToLp F) = F := by
  apply HardyElem.ext_ball
  intro z hz
  have h1 := (lpSeriesFun_holomorphic_and_hasSum (h2ToLp F)).2.1 z hz
  have h2 := hasSum_taylorCoeff_ball F.mem_hardy.2.1 hz
  exact h1.unique h2

theorem norm_lpToH2 (a : lp (fun _ : ℕ ↦ ℂ) 2) : ‖lpToH2 a‖ = ‖a‖ := by
  obtain ⟨hholo, _, hcoeff⟩ := lpSeriesFun_holomorphic_and_hasSum a
  have hsq1 := (isInHardySpace_two_iff_summable_taylorCoeff hholo).2 (lpToH2 a).mem_hardy
  have hhas : HasSum (fun n : ℕ ↦ ‖a n‖ ^ 2) (‖a‖ ^ 2) := by
    simpa using lp.hasSum_norm (p := 2) (by norm_num) a
  have hsq : ‖lpToH2 a‖ ^ 2 = ‖a‖ ^ 2 := by
    rw [HardyElem.norm_def]
    calc (hardySize 2 (lpToH2 a).toFun) ^ 2
        = ∑' n : ℕ, ‖taylorCoeff (lpSeriesFun a) n‖ ^ 2 := hsq1
      _ = ∑' n : ℕ, ‖a n‖ ^ 2 := by rw [hcoeff]
      _ = ‖a‖ ^ 2 := hhas.tsum_eq
  nlinarith [norm_nonneg (lpToH2 a), norm_nonneg a]

/-- **17.20 (Hilbert-Space Isomorphism `ℓ²(ℕ) ≃ₗᵢ[ℂ] H²`, RCA p. 347):**
The Maclaurin synthesis map `(a_n) ↦ ∑_{n=0}^∞ a_n z^n` is a surjective linear isometry from
`ℓ²(ℕ, ℂ)` onto `HardyElem 2`, whose inverse sends `F ∈ H²` to its Taylor coefficients at `0`. -/
def coeffEquivH2 : lp (fun _ : ℕ ↦ ℂ) 2 ≃ₗᵢ[ℂ] HardyElem 2 :=
  { LinearEquiv.symm
      { toFun := h2ToLp
        invFun := lpToH2
        left_inv := lpToH2_h2ToLp
        right_inv := h2ToLp_lpToH2
        map_add' := fun F G ↦ by
          ext n
          exact congr_fun (taylorCoeff_add F.mem_hardy.2.1 G.mem_hardy.2.1) n
        map_smul' := fun c F ↦ by
          ext n
          exact congr_fun (taylorCoeff_smul c F.mem_hardy.2.1) n } with
    norm_map' := norm_lpToH2 }

@[simp]
theorem coeffEquivH2_apply_ball (a : lp (fun _ : ℕ ↦ ℂ) 2) {z : ℂ}
    (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    coeffEquivH2 a z = ∑' n : ℕ, a n * z ^ n := by
  change lpSeriesFun a z = _
  exact Set.indicator_of_mem hz _

@[simp]
theorem coeffEquivH2_symm_apply (F : HardyElem 2) (n : ℕ) :
    coeffEquivH2.symm F n = taylorCoeff F.toFun n := rfl

instance instInnerComplexHardyElemTwo : Inner ℂ (HardyElem 2) where
  inner F G := inner ℂ (coeffEquivH2.symm F) (coeffEquivH2.symm G)

instance instInnerProductSpaceComplexHardyElemTwo : InnerProductSpace ℂ (HardyElem 2) where
  norm_sq_eq_re_inner F := by
    change ‖F‖ ^ 2 = RCLike.re (inner ℂ (coeffEquivH2.symm F) (coeffEquivH2.symm F))
    rw [← norm_sq_eq_re_inner (𝕜 := ℂ), coeffEquivH2.symm.norm_map]
  conj_inner_symm F G := by
    change starRingEnd ℂ (inner ℂ (coeffEquivH2.symm G) (coeffEquivH2.symm F)) =
      inner ℂ (coeffEquivH2.symm F) (coeffEquivH2.symm G)
    exact inner_conj_symm _ _
  add_left F G H := by
    change inner ℂ (coeffEquivH2.symm (F + G)) (coeffEquivH2.symm H) = _
    rw [map_add, inner_add_left]
    rfl
  smul_left F G c := by
    change inner ℂ (coeffEquivH2.symm (c • F)) (coeffEquivH2.symm G) = _
    rw [map_smul, inner_smul_left]
    rfl


theorem hasSum_inner_hardyElem_two (F G : HardyElem 2) :
    HasSum (fun n : ℕ ↦ star (taylorCoeff F.toFun n) * taylorCoeff G.toFun n) (inner ℂ F G) := by
  have h := lp.hasSum_inner (𝕜 := ℂ) (coeffEquivH2.symm F) (coeffEquivH2.symm G)
  change HasSum _ (inner ℂ (coeffEquivH2.symm F) (coeffEquivH2.symm G))
  convert h using 1
  funext n
  simp [mul_comm]

/-- Boundary-value linear isometry `H² →ₗᵢ[ℂ] L²(T)` via `hPartB.hardy_boundary`. -/
def boundaryToL2 (hPartB : HardyPartBInterface) :
    HardyElem 2 →ₗᵢ[ℂ] RudinRCA.Chapter04.CircleL2 where
  toFun F := (hPartB.hardy_boundary (by norm_num) F.mem_hardy).2.1.toLp (radialBoundaryLimit F.toFun)
  map_add' F G := by
    have hFG := (hPartB.hardy_boundary (by norm_num) (F + G).mem_hardy)
    have hF := (hPartB.hardy_boundary (by norm_num) F.mem_hardy)
    have hG := (hPartB.hardy_boundary (by norm_num) G.mem_hardy)
    refine Lp.ext ?_
    filter_upwards [MemLp.coeFn_toLp hFG.2.1,
      Lp.coeFn_add (hF.2.1.toLp (radialBoundaryLimit F.toFun))
        (hG.2.1.toLp (radialBoundaryLimit G.toFun)),
      MemLp.coeFn_toLp hF.2.1, MemLp.coeFn_toLp hG.2.1, hF.1, hG.1] with ζ h1 h2 h3 h4 hrF hrG
    rw [h1, h2, Pi.add_apply, h3, h4]
    exact radialBoundaryLimit_eq_of_tendsto (hrF.add hrG)
  map_smul' c F := by
    dsimp only [RingHom.id_apply]
    have hcF := (hPartB.hardy_boundary (by norm_num) (c • F).mem_hardy)
    have hF := (hPartB.hardy_boundary (by norm_num) F.mem_hardy)
    refine Lp.ext ?_
    filter_upwards [MemLp.coeFn_toLp hcF.2.1,
      Lp.coeFn_smul c (hF.2.1.toLp (radialBoundaryLimit F.toFun)),
      MemLp.coeFn_toLp hF.2.1, hF.1] with ζ h1 h2 h3 hrF
    rw [h1, h2, Pi.smul_apply, h3, smul_eq_mul]
    exact radialBoundaryLimit_eq_of_tendsto (hrF.const_smul c)
  norm_map' F := by
    have hF := (hPartB.hardy_boundary (by norm_num) F.mem_hardy)
    change ‖hF.2.1.toLp (radialBoundaryLimit F.toFun)‖ = ‖F‖
    rw [Lp.norm_def, eLpNorm_congr_ae (MemLp.coeFn_toLp hF.2.1), hF.2.2.1]
    rfl

theorem inner_eq_boundary_integral (hPartB : HardyPartBInterface) (F G : HardyElem 2) :
    inner ℂ F G =
      ∫ ζ, star (radialBoundaryLimit F.toFun ζ) * radialBoundaryLimit G.toFun ζ ∂circleMeasure := by
  have hF := (hPartB.hardy_boundary (by norm_num) F.mem_hardy).2.1
  have hG := (hPartB.hardy_boundary (by norm_num) G.mem_hardy).2.1
  calc inner ℂ F G
      = inner ℂ (boundaryToL2 hPartB F) (boundaryToL2 hPartB G) :=
        ((boundaryToL2 hPartB).inner_map_map F G).symm
    _ = ∫ ζ, (boundaryToL2 hPartB G) ζ * conj ((boundaryToL2 hPartB F) ζ) ∂circleMeasure :=
        RudinRCA.Chapter04.circleL2_inner _ _
    _ = ∫ ζ, star (radialBoundaryLimit F.toFun ζ) * radialBoundaryLimit G.toFun ζ ∂circleMeasure := by
        refine integral_congr_ae ?_
        filter_upwards [MemLp.coeFn_toLp hF, MemLp.coeFn_toLp hG] with ζ hζF hζG
        change (hG.toLp (radialBoundaryLimit G.toFun)) ζ *
            star ((hF.toLp (radialBoundaryLimit F.toFun)) ζ) = _
        rw [hζF, hζG, mul_comm]

theorem trigMonomial_eq_circlePoint_zpow (n : ℤ) (ζ : FourierCircle) :
    RudinRCA.Chapter04.trigMonomial n ζ = (circlePoint ζ) ^ n := by
  refine QuotientAddGroup.induction_on ζ fun t ↦ ?_
  rw [RudinRCA.Chapter04.trigMonomial_apply_real, circlePoint_coe]
  rw [← Complex.exp_int_mul]
  congr 1
  ring

theorem integrable_mul_continuous_circleMeasure {f g : FourierCircle → ℂ}
    (hf : Integrable f circleMeasure) (hg : Continuous g) :
    Integrable (fun ζ ↦ f ζ * g ζ) circleMeasure := by
  obtain ⟨ζ₀, _, hmax⟩ := isCompact_univ.exists_isMaxOn univ_nonempty hg.norm.continuousOn
  refine (hf.norm.mul_const ‖g ζ₀‖).mono' (hf.aestronglyMeasurable.mul hg.aestronglyMeasurable)
    (Eventually.of_forall fun ζ ↦ ?_)
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left (hmax (mem_univ ζ)) (norm_nonneg _)

/-- `L¹(T)` Fourier uniqueness via uniform trigonometric approximation (`Chapter04`) and radial
Poisson convergence (`ae_tendsto_circlePoissonIntegral`): if `f ∈ L¹(T)` has all Fourier
coefficients zero, then `f = 0` `circleMeasure`-a.e. -/
theorem ae_eq_zero_of_forall_integral_trigMonomial_eq_zero {f : FourierCircle → ℂ}
    (hf : Integrable f circleMeasure)
    (h0 : ∀ n : ℤ, ∫ ζ, f ζ * star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure = 0) :
    f =ᵐ[circleMeasure] 0 := by
  have hmono : ∀ m : ℤ, ∫ ζ, f ζ * RudinRCA.Chapter04.trigMonomial m ζ ∂circleMeasure = 0 := by
    intro m
    have hstar : ∀ ζ : FourierCircle,
        star (RudinRCA.Chapter04.trigMonomial (-m) ζ) = RudinRCA.Chapter04.trigMonomial m ζ := by
      intro ζ
      simp [RudinRCA.Chapter04.trigMonomial]
    simpa [hstar] using h0 (-m)
  have hpoly : ∀ c : ℤ →₀ ℂ,
      ∫ ζ, f ζ * RudinRCA.Chapter04.trigPolynomial c ζ ∂circleMeasure = 0 := by
    intro c
    have heq : (fun ζ ↦ f ζ * RudinRCA.Chapter04.trigPolynomial c ζ) =
        fun ζ ↦ ∑ n ∈ c.support, c n * (f ζ * RudinRCA.Chapter04.trigMonomial n ζ) := by
      funext ζ
      simp only [RudinRCA.Chapter04.trigPolynomial, Finsupp.sum, ContinuousMap.sum_apply,
        ContinuousMap.smul_apply, smul_eq_mul, Finset.mul_sum]
      exact Finset.sum_congr rfl fun n _ ↦ by ring
    rw [heq, integral_finsetSum]
    · refine Finset.sum_eq_zero fun n _ ↦ ?_
      rw [integral_const_mul, hmono n, mul_zero]
    · intro n _
      exact (integrable_mul_continuous_circleMeasure hf
        (RudinRCA.Chapter04.trigMonomial n).continuous).const_mul (c n)
  have hcont_zero : ∀ h : C(FourierCircle, ℂ), ∫ ζ, f ζ * h ζ ∂circleMeasure = 0 := by
    intro h
    rw [← norm_le_zero_iff]
    refine le_of_forall_pos_le_add fun δ hδ ↦ ?_
    rw [zero_add]
    let M : ℝ := (∫ ζ, ‖f ζ‖ ∂circleMeasure) + 1
    have hint_nn : 0 ≤ ∫ ζ, ‖f ζ‖ ∂circleMeasure := integral_nonneg fun _ ↦ norm_nonneg _
    have hM_pos : 0 < M := by dsimp [M]; linarith
    obtain ⟨c, hc⟩ := RudinRCA.Chapter04.uniform_trigonometric_approximation h (δ / M)
      (div_pos hδ hM_pos)
    have hint_h : Integrable (fun ζ ↦ f ζ * h ζ) circleMeasure :=
      integrable_mul_continuous_circleMeasure hf h.continuous
    have hint_p : Integrable (fun ζ ↦ f ζ * RudinRCA.Chapter04.trigPolynomial c ζ) circleMeasure :=
      integrable_mul_continuous_circleMeasure hf (RudinRCA.Chapter04.trigPolynomial c).continuous
    have hsub : ∫ ζ, f ζ * h ζ ∂circleMeasure =
        ∫ ζ, f ζ * (h ζ - RudinRCA.Chapter04.trigPolynomial c ζ) ∂circleMeasure := by
      have heq : (fun ζ ↦ f ζ * (h ζ - RudinRCA.Chapter04.trigPolynomial c ζ)) =
          fun ζ ↦ f ζ * h ζ - f ζ * RudinRCA.Chapter04.trigPolynomial c ζ := by
        funext ζ; ring
      rw [heq, integral_sub hint_h hint_p, hpoly c, sub_zero]
    rw [hsub]
    calc ‖∫ ζ, f ζ * (h ζ - RudinRCA.Chapter04.trigPolynomial c ζ) ∂circleMeasure‖
        ≤ ∫ ζ, ‖f ζ * (h ζ - RudinRCA.Chapter04.trigPolynomial c ζ)‖ ∂circleMeasure :=
          norm_integral_le_integral_norm _
      _ ≤ ∫ ζ, ‖f ζ‖ * (δ / M) ∂circleMeasure := by
          refine integral_mono (hint_h.sub hint_p |>.congr (Eventually.of_forall fun ζ ↦ by simp; ring)).norm
            (hf.norm.mul_const _) fun ζ ↦ ?_
          rw [norm_mul]
          have hpt : ‖h ζ - RudinRCA.Chapter04.trigPolynomial c ζ‖ ≤ δ / M :=
            (ContinuousMap.norm_coe_le_norm (h - RudinRCA.Chapter04.trigPolynomial c) ζ).trans hc.le
          exact mul_le_mul_of_nonneg_left hpt (norm_nonneg _)
      _ = (∫ ζ, ‖f ζ‖ ∂circleMeasure) * (δ / M) := integral_mul_const _ _
      _ ≤ M * (δ / M) := by
          refine mul_le_mul_of_nonneg_right ?_ (div_pos hδ hM_pos).le
          dsimp [M]; linarith
      _ = δ := mul_div_cancel₀ δ hM_pos.ne'
  have hP_zero : ∀ z ∈ Metric.ball (0 : ℂ) 1, circlePoissonIntegral f z = 0 := by
    intro z hz
    let hz_cont : C(FourierCircle, ℂ) :=
      ⟨fun ζ ↦ (_root_.poissonKernel 0 z (circlePoint ζ) : ℂ),
        Complex.continuous_ofReal.comp (continuous_poissonKernel_circlePoint hz)⟩
    have heq : circlePoissonIntegral f z = ∫ ζ, f ζ * hz_cont ζ ∂circleMeasure := by
      unfold circlePoissonIntegral
      refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
      simp [hz_cont, Complex.real_smul, mul_comm]
    rw [heq, hcont_zero hz_cont]
  filter_upwards [ae_tendsto_circlePoissonIntegral hf] with ζ hζ
  have hev : (fun r : ℝ ↦ circlePoissonIntegral f ((r : ℂ) * circlePoint ζ)) =ᶠ[𝓝[<] (1 : ℝ)]
      fun _ ↦ (0 : ℂ) := by
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    refine hP_zero _ ?_
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr.1] using hr.2
  exact tendsto_nhds_unique hζ (tendsto_const_nhds.congr' hev.symm)

/-! #### 17.20: Unilateral Shift on `ℓ²`, Multiplication by `z` on `H²`, and Invariant Subspaces -/

/-- Closed `T`-invariant subspace of a complex Hilbert (or normed) space `E` (RCA p. 346). -/
def IsClosedOperatorInvariantSubspace {E : Type*} [NormedAddCommGroup E] [NormedSpace ℂ E]
    (T : E →L[ℂ] E) (Y : Submodule ℂ E) : Prop :=
  IsClosed (Y : Set E) ∧ ∀ x ∈ Y, T x ∈ Y

/-- Raw sequence shift `(a₀, a₁, a₂, …) ↦ (0, a₀, a₁, …)` on `ℕ → ℂ`. -/
def shiftSeq (a : ℕ → ℂ) : ℕ → ℂ
  | 0 => 0
  | n + 1 => a n

/-- **17.20 (Unilateral Shift on `ℓ²(ℕ)`, RCA p. 346):**
`S(a₀, a₁, a₂, …) = (0, a₀, a₁, …)` as a linear isometry on `ℓ²(ℕ, ℂ)`. -/
def unilateralShiftLI : lp (fun _ : ℕ ↦ ℂ) 2 →ₗᵢ[ℂ] lp (fun _ : ℕ ↦ ℂ) 2 where
  toFun a :=
    ⟨shiftSeq a, memℓp_gen (by
      have hhas : HasSum (fun n : ℕ ↦ ‖a n‖ ^ 2) (‖a‖ ^ 2) := by
        simpa using lp.hasSum_norm (p := 2) (by norm_num) a
      have hshift : HasSum (fun n : ℕ ↦ ‖shiftSeq a n‖ ^ 2) (‖a‖ ^ 2) := by
        rw [← hasSum_nat_add_iff' 1]
        simpa [shiftSeq] using hhas
      simpa using hshift.summable)⟩
  map_add' a b := by
    ext n
    change shiftSeq (a + b) n = shiftSeq a n + shiftSeq b n
    cases n <;> simp [shiftSeq]
  map_smul' c a := by
    ext n
    change shiftSeq (c • a) n = c * shiftSeq a n
    cases n <;> simp [shiftSeq]
  norm_map' a := by
    have hhas : HasSum (fun n : ℕ ↦ ‖a n‖ ^ 2) (‖a‖ ^ 2) := by
      simpa using lp.hasSum_norm (p := 2) (by norm_num) a
    have hshift : HasSum (fun n : ℕ ↦ ‖shiftSeq a n‖ ^ 2) (‖a‖ ^ 2) := by
      rw [← hasSum_nat_add_iff' 1]
      simpa [shiftSeq] using hhas
    let sa : lp (fun _ : ℕ ↦ ℂ) 2 := ⟨shiftSeq a, memℓp_gen (by simpa using hshift.summable)⟩
    have hhas_sa : HasSum (fun n : ℕ ↦ ‖sa n‖ ^ 2) (‖sa‖ ^ 2) := by
      simpa using lp.hasSum_norm (p := 2) (by norm_num) sa
    have hsq : ‖sa‖ ^ 2 = ‖a‖ ^ 2 := hhas_sa.unique hshift
    change ‖sa‖ = ‖a‖
    nlinarith [norm_nonneg sa, norm_nonneg a]

/-- Continuous linear operator form of the unilateral shift `S` on `ℓ²(ℕ, ℂ)` (RCA p. 346). -/
def unilateralShift : lp (fun _ : ℕ ↦ ℂ) 2 →L[ℂ] lp (fun _ : ℕ ↦ ℂ) 2 :=
  unilateralShiftLI.toContinuousLinearMap

@[simp]
theorem unilateralShift_apply_zero (a : lp (fun _ : ℕ ↦ ℂ) 2) :
    unilateralShift a 0 = 0 := rfl

@[simp]
theorem unilateralShift_apply_succ (a : lp (fun _ : ℕ ↦ ℂ) 2) (n : ℕ) :
    unilateralShift a (n + 1) = a n := rfl

theorem unilateralShift_isometry : Isometry unilateralShift :=
  unilateralShiftLI.isometry

theorem norm_unilateralShift : ‖unilateralShift‖ = 1 := by
  refine le_antisymm ?_ ?_
  · refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun a ↦ ?_
    rw [one_mul]
    exact (unilateralShiftLI.norm_map a).le
  · let e₀ : lp (fun _ : ℕ ↦ ℂ) 2 := lp.single 2 0 (1 : ℂ)
    have he₀ : ‖e₀‖ = 1 := by simp [e₀]
    have hle := unilateralShift.le_opNorm e₀
    change ‖unilateralShiftLI e₀‖ ≤ ‖unilateralShift‖ * ‖e₀‖ at hle
    rwa [unilateralShiftLI.norm_map, he₀, mul_one] at hle

/-- **17.20 (Multiplication-by-`z` Operator `M_z` on `H²`, RCA p. 347):**
Conjugate of `unilateralShift` under `coeffEquivH2`, acting on `U = Metric.ball 0 1` by
`(mulZ F) z = z * F z`. -/
def mulZLI : HardyElem 2 →ₗᵢ[ℂ] HardyElem 2 :=
  (coeffEquivH2.toLinearIsometry.comp unilateralShiftLI).comp coeffEquivH2.symm.toLinearIsometry

def mulZ : HardyElem 2 →L[ℂ] HardyElem 2 :=
  mulZLI.toContinuousLinearMap

theorem coeffEquivH2_unilateralShift (a : lp (fun _ : ℕ ↦ ℂ) 2) :
    coeffEquivH2 (unilateralShift a) = mulZ (coeffEquivH2 a) := by
  change coeffEquivH2 (unilateralShiftLI a) =
    coeffEquivH2 (unilateralShiftLI (coeffEquivH2.symm (coeffEquivH2 a)))
  rw [coeffEquivH2.symm_apply_apply]

@[simp]
theorem mulZ_apply_ball (F : HardyElem 2) {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    mulZ F z = z * F z := by
  let a := coeffEquivH2.symm F
  have hFa : coeffEquivH2 a = F := coeffEquivH2.apply_symm_apply F
  have h1 : HasSum (fun n : ℕ ↦ a n * z ^ n) (F z) := by
    rw [← hFa]
    exact (lpSeriesFun_holomorphic_and_hasSum a).2.1 z hz
  have h2 : HasSum (fun n : ℕ ↦ unilateralShift a n * z ^ n) (mulZ F z) := by
    have hm : mulZ F = coeffEquivH2 (unilateralShift a) := by
      rw [coeffEquivH2_unilateralShift, hFa]
    rw [hm]
    exact (lpSeriesFun_holomorphic_and_hasSum (unilateralShift a)).2.1 z hz
  have h3 : HasSum (fun n : ℕ ↦ unilateralShift a n * z ^ n) (z * F z) := by
    rw [← hasSum_nat_add_iff' 1]
    convert h1.mul_left z using 1
    · funext n
      simp only [unilateralShift_apply_succ, pow_succ]
      ring
    · simp
  exact h2.unique h3

@[simp]
theorem mulZ_iterate_apply_ball (k : ℕ) (F : HardyElem 2) {z : ℂ}
    (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    ((mulZ^[k]) F) z = z ^ k * F z := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [Function.iterate_succ_apply', mulZ_apply_ball _ hz, ih, pow_succ', mul_assoc]

theorem mulZ_isometry : Isometry mulZ :=
  mulZLI.isometry

theorem norm_mulZ : ‖mulZ‖ = 1 := by
  refine le_antisymm ?_ ?_
  · refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun F ↦ ?_
    rw [one_mul]
    exact (mulZLI.norm_map F).le
  · let u₀ : HardyElem 2 := coeffEquivH2 (lp.single 2 0 (1 : ℂ))
    have hu₀ : ‖u₀‖ = 1 := by simp [u₀]
    have hle := mulZ.le_opNorm u₀
    change ‖mulZLI u₀‖ ≤ ‖mulZ‖ * ‖u₀‖ at hle
    rwa [mulZLI.norm_map, hu₀, mul_one] at hle

/-- Closed `mulZ`-invariant subspace of `H²` (`HardyElem 2`, RCA p. 347). -/
def IsClosedInvariantSubspace (Y : Submodule ℂ (HardyElem 2)) : Prop :=
  IsClosed (Y : Set (HardyElem 2)) ∧ ∀ F ∈ Y, mulZ F ∈ Y

theorem mulZ_iterate_mem_of_invariant {Y : Submodule ℂ (HardyElem 2)}
    (hY : ∀ F ∈ Y, mulZ F ∈ Y) (k : ℕ) {F : HardyElem 2} (hF : F ∈ Y) :
    (mulZ^[k]) F ∈ Y := by
  induction k with
  | zero => simpa using hF
  | succ k ih =>
    rw [Function.iterate_succ_apply']
    exact hY _ ih

/-- Zero-multiplicity subspace of `H²` prescribed by `k : ℂ → ℕ` on `U = Metric.ball 0 1`:
all `F ∈ H²` vanishing at each `z ∈ U` to order at least `k z` (RCA pp. 347–348). -/
def zeroOrderSubspace (k : ℂ → ℕ) : Submodule ℂ (HardyElem 2) where
  carrier := {F : HardyElem 2 | ∀ z ∈ Metric.ball (0 : ℂ) 1, ∀ j < k z, iteratedDeriv j F.toFun z = 0}
  zero_mem' _ _ j _ := by simp
  add_mem' {F G} hF hG z hz j hj := by
    have hdF : ContDiffAt ℂ j F.toFun z :=
      (((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp F.mem_hardy.2.1).analyticOnNhd
        Metric.isOpen_ball z hz).contDiffAt
    have hdG : ContDiffAt ℂ j G.toFun z :=
      (((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp G.mem_hardy.2.1).analyticOnNhd
        Metric.isOpen_ball z hz).contDiffAt
    rw [HardyElem.toFun_add, iteratedDeriv_add hdF hdG, hF z hz j hj, hG z hz j hj, add_zero]
  smul_mem' c {F} hF z hz j hj := by
    have hdF : ContDiffAt ℂ j F.toFun z :=
      (((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp F.mem_hardy.2.1).analyticOnNhd
        Metric.isOpen_ball z hz).contDiffAt
    rw [HardyElem.toFun_smul, iteratedDeriv_const_smul_field c F.toFun, hF z hz j hj, smul_zero]

theorem isClosedInvariantSubspace_zeroOrderSubspace (k : ℂ → ℕ) :
    IsClosedInvariantSubspace (zeroOrderSubspace k) := by
  constructor
  · -- Closedness via compact uniform convergence of iterated derivatives (`Chapter10`)
    rw [← isSeqClosed_iff_isClosed]
    intro u F hu hlim z hz j hj
    have hconv : RudinRCA.Chapter10.ConvergesOnCompactSubsets
        (fun n ↦ (u n).toFun) F.toFun (Metric.ball (0 : ℂ) 1) := by
      intro K hK hK_comp
      rcases K.eq_empty_or_nonempty with rfl | hKne
      · exact tendstoUniformlyOn_empty
      · obtain ⟨w₀, hw₀, hmax⟩ := hK_comp.exists_isMaxOn hKne continuous_norm.continuousOn
        have hw₀_lt : ‖w₀‖ < 1 := by simpa [Metric.mem_ball] using hK hw₀
        rw [Metric.tendstoUniformlyOn_iff]
        intro ε hε
        have hC_pos : 0 < 2 / (1 - ‖w₀‖) := div_pos two_pos (sub_pos.mpr hw₀_lt)
        have hnorm_lim : Tendsto (fun n ↦ ‖u n - F‖) atTop (𝓝 0) :=
          tendsto_iff_norm_sub_tendsto_zero.mp hlim
        filter_upwards [hnorm_lim.eventually (gt_mem_nhds (div_pos hε hC_pos))] with n hn w hw
        have hw_cb : w ∈ Metric.closedBall (0 : ℂ) ‖w₀‖ := by
          simpa [Metric.mem_closedBall] using hmax hw
        have hpt := norm_apply_le_of_isInHardySpace (by norm_num : (1 : ℝ≥0∞) ≤ 2)
          (u n - F).mem_hardy (norm_nonneg w₀) hw₀_lt hw_cb
        rw [dist_eq_norm, norm_sub_rev]
        exact hpt.trans_lt ((lt_div_iff₀' hC_pos).mp hn)
    have hderiv_conv := RudinRCA.Chapter10.convergesOnCompactSubsets_iteratedDeriv
      Metric.isOpen_ball (fun n ↦ (u n).mem_hardy.2.1) hconv j
    have hpt_tendsto : Tendsto (fun n ↦ iteratedDeriv j (u n).toFun z) atTop
        (𝓝 (iteratedDeriv j F.toFun z)) := by
      have hunif := hderiv_conv {z} (Set.singleton_subset_iff.mpr hz) isCompact_singleton
      exact hunif.tendsto_at (Set.mem_singleton z)
    have hev0 : (fun n ↦ iteratedDeriv j (u n).toFun z) = fun _ ↦ (0 : ℂ) :=
      funext fun n ↦ hu n z hz j hj
    exact tendsto_nhds_unique hpt_tendsto (hev0 ▸ tendsto_const_nhds)
  · -- `mulZ`-invariance via local power series at `z ∈ ball 0 1`
    intro F hF z hz j hj
    let r : ℝ := 1 - ‖z‖
    have hr_pos : 0 < r := sub_pos.mpr (by simpa [Metric.mem_ball] using hz)
    have hsub : Metric.ball z r ⊆ Metric.ball (0 : ℂ) 1 := by
      intro w hw
      have hwz : ‖w - z‖ < 1 - ‖z‖ := by simpa [Metric.mem_ball, dist_eq_norm, r] using hw
      have htri : ‖w‖ ≤ ‖w - z‖ + ‖z‖ := by simpa using norm_add_le (w - z) z
      rw [Metric.mem_ball, dist_zero_right]
      linarith
    let c : ℕ → ℂ := fun n ↦ iteratedDeriv n F.toFun z / (Nat.factorial n : ℂ)
    have hc_sum : ∀ w ∈ RudinRCA.Chapter10.disc z r,
        HasSum (fun n : ℕ ↦ c n * (w - z) ^ n) (F.toFun w) := by
      intro w hw
      have hd : DifferentiableOn ℂ F.toFun (Metric.ball z r) :=
        fun u hu ↦ (F.mem_hardy.2.1 u (hsub hu)).differentiableWithinAt
      convert Complex.hasSum_taylorSeries_on_ball hd hw using 1
      funext n
      simp only [c, smul_eq_mul, div_eq_mul_inv]
      ring
    let d : ℕ → ℂ := fun n ↦ match n with
      | 0 => z * c 0
      | m + 1 => z * c (m + 1) + c m
    have hd_sum : ∀ w ∈ RudinRCA.Chapter10.disc z r,
        HasSum (fun n : ℕ ↦ d n * (w - z) ^ n) ((mulZ F).toFun w) := by
      intro w hw
      have hw_ball : w ∈ Metric.ball (0 : ℂ) 1 := hsub hw
      change HasSum (fun n : ℕ ↦ d n * (w - z) ^ n) (mulZ F w)
      rw [mulZ_apply_ball F hw_ball]
      have h1 : HasSum (fun n : ℕ ↦ z * c n * (w - z) ^ n) (z * F w) := by
        simpa [mul_assoc] using (hc_sum w hw).mul_left z
      have hshift : HasSum (fun n : ℕ ↦ (match n with | 0 => (0 : ℂ) | m + 1 => c m) * (w - z) ^ n)
          ((w - z) * F w) := by
        rw [← hasSum_nat_add_iff' 1]
        convert (hc_sum w hw).mul_left (w - z) using 1
        · funext n
          simp only [pow_succ]
          ring
        · simp
      have hcomb := h1.add hshift
      convert hcomb using 1
      · funext n
        cases n <;> simp [d, add_mul]
      · ring
    have hcoeff := RudinRCA.Chapter10.powerSeries_coefficient hr_pos hd_sum j
    have hdj : d j = 0 := by
      cases j with
      | zero =>
        have hc0 : c 0 = 0 := by simp [c, hF z hz 0 hj]
        simp [d, hc0]
      | succ m =>
        have hcm1 : c (m + 1) = 0 := by simp [c, hF z hz (m + 1) hj]
        have hcm : c m = 0 := by simp [c, hF z hz m (Nat.lt_trans (Nat.lt_succ_self m) hj)]
        simp [d, hcm1, hcm]
    rw [← hcoeff, hdj, mul_zero]

/-- Constant unit function `1 ∈ H²` (`HardyElem 2`). -/
def hardyOne : HardyElem 2 :=
  coeffEquivH2 (lp.single 2 0 (1 : ℂ))

@[simp]
theorem norm_hardyOne : ‖hardyOne‖ = 1 := by
  simp [hardyOne]

@[simp]
theorem hardyOne_apply_ball {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    hardyOne z = 1 := by
  rw [hardyOne, coeffEquivH2_apply_ball _ hz, tsum_eq_single 0]
  · simp
  · intro n hn
    simp [lp.single_apply, hn]

theorem mulZ_iterate_hardyOne (n : ℕ) :
    (mulZ^[n]) hardyOne = coeffEquivH2 (lp.single 2 n (1 : ℂ)) := by
  induction n with
  | zero => simp [hardyOne]
  | succ n ih =>
    rw [Function.iterate_succ_apply', ih, ← coeffEquivH2_unilateralShift]
    congr 1
    ext m
    cases m with
    | zero => simp [lp.single_apply]
    | succ m =>
      rw [unilateralShift_apply_succ]
      change (Pi.single n (1 : ℂ) : ℕ → ℂ) m = (Pi.single (n + 1) (1 : ℂ) : ℕ → ℂ) (m + 1)
      by_cases hmn : m = n <;> simp [hmn]

theorem hasSum_taylorCoeff_mulZ_hardyOne (G : HardyElem 2) :
    HasSum (fun n : ℕ ↦ taylorCoeff G.toFun n • (mulZ^[n]) hardyOne) G := by
  let a : lp (fun _ : ℕ ↦ ℂ) 2 := coeffEquivH2.symm G
  have hsingle : HasSum (fun n : ℕ ↦ lp.single 2 n (a n)) a :=
    lp.hasSum_single (p := 2) (by norm_num) a
  have hmap := hsingle.map coeffEquivH2.toContinuousLinearEquiv.toContinuousLinearMap.toAddMonoidHom
    coeffEquivH2.continuous
  have hGa : coeffEquivH2 a = G := coeffEquivH2.apply_symm_apply G
  convert hmap using 1
  · funext n
    have hsmul : lp.single 2 n (a n) = a n • (lp.single 2 n (1 : ℂ) : lp (fun _ : ℕ ↦ ℂ) 2) := by
      ext m
      change (Pi.single n (a n) : ℕ → ℂ) m = a n * (Pi.single n (1 : ℂ) : ℕ → ℂ) m
      by_cases hmn : m = n <;> simp [hmn]
    change taylorCoeff G.toFun n • (mulZ^[n]) hardyOne = coeffEquivH2 (lp.single 2 n (a n))
    rw [hsmul, coeffEquivH2.map_smul, ← mulZ_iterate_hardyOne]
    rfl
  · exact hGa.symm

theorem tendsto_sum_taylorCoeff_mulZ_hardyOne (G : HardyElem 2) :
    Tendsto (fun N : ℕ ↦ ∑ n ∈ Finset.range N, taylorCoeff G.toFun n • (mulZ^[n]) hardyOne)
      atTop (𝓝 G) :=
  (hasSum_taylorCoeff_mulZ_hardyOne G).tendsto_sum_nat

theorem radialBoundaryLimit_mulZ_iterate_ae (hPartB : HardyPartBInterface)
    (k : ℕ) (F : HardyElem 2) :
    ∀ᵐ ζ ∂circleMeasure,
      radialBoundaryLimit ((mulZ^[k]) F).toFun ζ =
        (circlePoint ζ) ^ k * radialBoundaryLimit F.toFun ζ := by
  filter_upwards [(hPartB.hardy_boundary (by norm_num) F.mem_hardy).1] with ζ hF
  have hpow : Tendsto (fun r : ℝ ↦ ((r : ℂ) * circlePoint ζ) ^ k)
      (𝓝[<] (1 : ℝ)) (𝓝 ((circlePoint ζ) ^ k)) := by
    have hr : Tendsto (fun r : ℝ ↦ (r : ℂ) * circlePoint ζ) (𝓝[<] (1 : ℝ)) (𝓝 (circlePoint ζ)) := by
      simpa using ((Complex.continuous_ofReal.tendsto 1).mono_left nhdsWithin_le_nhds).mul_const
        (circlePoint ζ)
    exact hr.pow k
  have hprod : Tendsto (fun r : ℝ ↦ radialSlice ((mulZ^[k]) F).toFun r ζ)
      (𝓝[<] (1 : ℝ)) (𝓝 ((circlePoint ζ) ^ k * radialBoundaryLimit F.toFun ζ)) := by
    refine (hpow.mul hF).congr' ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    have hz : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hr.1] using hr.2
    exact (mulZ_iterate_apply_ball k F hz).symm
  exact radialBoundaryLimit_eq_of_tendsto hprod

private theorem mulByInner_raw_holo {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) (F : HardyElem 2) :
    HolomorphicOn ((Metric.ball (0 : ℂ) 1).indicator (fun z ↦ φ z * F z))
      (Metric.ball (0 : ℂ) 1) := by
  intro z hz
  refine ((hφ.1 z hz).mul (F.mem_hardy.2.1 z hz)).congr_of_eventuallyEq ?_
  filter_upwards [Metric.isOpen_ball.mem_nhds hz] with w hw
  exact Set.indicator_of_mem hw _

private theorem mulByInner_raw_hardySize_le {φ : ℂ → ℂ} (hφ : IsInnerFunction φ)
    (F : HardyElem 2) :
    hardySizeENNReal 2 ((Metric.ball (0 : ℂ) 1).indicator (fun z ↦ φ z * F z)) ≤
      hardySizeENNReal 2 F.toFun := by
  have hg_holo := mulByInner_raw_holo hφ F
  refine iSup₂_le fun r hr ↦ ?_
  have hslice : radialSizeENNReal 2 ((Metric.ball (0 : ℂ) 1).indicator (fun z ↦ φ z * F z)) r ≤
      radialSizeENNReal 2 F.toFun r := by
    simp only [radialSizeENNReal, show (2 : ℝ≥0∞) ≠ 0 by norm_num, ↓reduceIte]
    refine eLpNorm_mono
      (continuous_radialSlice_of_holomorphicOn hg_holo hr.1 hr.2).aestronglyMeasurable fun ζ ↦ ?_
    have hz : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hr.1] using hr.2
    dsimp [radialSlice]
    rw [Set.indicator_of_mem hz, norm_mul]
    exact (mul_le_mul_of_nonneg_right (hφ.2.1 _ hz) (norm_nonneg _)).trans_eq (one_mul _)
  exact hslice.trans (le_biSup (radialSizeENNReal 2 F.toFun) hr)

/-- Multiplication by an inner function `φ` on `H²` (`HardyElem 2`, RCA p. 348). -/
def mulByInner {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) : HardyElem 2 →L[ℂ] HardyElem 2 :=
  LinearMap.mkContinuous
    { toFun := fun F ↦
        ⟨(Metric.ball (0 : ℂ) 1).indicator (fun z ↦ φ z * F z),
          ⟨by norm_num, mulByInner_raw_holo hφ F,
            (mulByInner_raw_hardySize_le hφ F).trans_lt F.mem_hardy.2.2⟩,
          fun _ hz ↦ Set.indicator_of_notMem hz _⟩
      map_add' := fun F G ↦ by
        apply HardyElem.ext_ball
        intro z hz
        change (Metric.ball (0 : ℂ) 1).indicator (fun w ↦ φ w * (F w + G w)) z =
          (Metric.ball (0 : ℂ) 1).indicator (fun w ↦ φ w * F w) z +
            (Metric.ball (0 : ℂ) 1).indicator (fun w ↦ φ w * G w) z
        simp [Set.indicator_of_mem hz, mul_add]
      map_smul' := fun c F ↦ by
        apply HardyElem.ext_ball
        intro z hz
        change (Metric.ball (0 : ℂ) 1).indicator (fun w ↦ φ w * (c * F w)) z =
          c * (Metric.ball (0 : ℂ) 1).indicator (fun w ↦ φ w * F w) z
        simp [Set.indicator_of_mem hz, mul_left_comm] }
    1
    (fun F ↦ by
      rw [one_mul, HardyElem.norm_def, HardyElem.norm_def]
      exact ENNReal.toReal_mono F.mem_hardy.2.2.ne (mulByInner_raw_hardySize_le hφ F))

@[simp]
theorem mulByInner_apply_ball {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) (F : HardyElem 2)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    mulByInner hφ F z = φ z * F z := by
  change (Metric.ball (0 : ℂ) 1).indicator (fun w ↦ φ w * F w) z = φ z * F z
  exact Set.indicator_of_mem hz _

/-- The Beurling subspace `φ H² ⊆ H²` associated to an inner function `φ` (RCA p. 348). -/
def innerSubspace (φ : ℂ → ℂ) (hφ : IsInnerFunction φ) : Submodule ℂ (HardyElem 2) :=
  LinearMap.range (mulByInner hφ).toLinearMap

theorem mem_innerSubspace_iff {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) {F : HardyElem 2} :
    F ∈ innerSubspace φ hφ ↔ ∃ G : HardyElem 2, mulByInner hφ G = F :=
  Iff.rfl

theorem mulZ_mulByInner {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) (F : HardyElem 2) :
    mulZ (mulByInner hφ F) = mulByInner hφ (mulZ F) := by
  apply HardyElem.ext_ball
  intro z hz
  simp [hz, mul_left_comm]

theorem mulZ_iterate_mulByInner {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) (n : ℕ) (F : HardyElem 2) :
    (mulZ^[n]) (mulByInner hφ F) = mulByInner hφ ((mulZ^[n]) F) := by
  induction n with
  | zero => rfl
  | succ n ih =>
    rw [Function.iterate_succ_apply', ih, mulZ_mulByInner, Function.iterate_succ_apply' mulZ n F]

theorem radialBoundaryLimit_mulByInner_ae (hPartB : HardyPartBInterface)
    {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) (F : HardyElem 2) :
    ∀ᵐ ζ ∂circleMeasure,
      radialBoundaryLimit (mulByInner hφ F).toFun ζ =
        radialBoundaryLimit φ ζ * radialBoundaryLimit F.toFun ζ := by
  filter_upwards [hφ.ae_tendsto, (hPartB.hardy_boundary (by norm_num) F.mem_hardy).1]
    with ζ hφ_lim hF_lim
  have hprod : Tendsto (fun r : ℝ ↦ radialSlice (mulByInner hφ F).toFun r ζ)
      (𝓝[<] (1 : ℝ)) (𝓝 (radialBoundaryLimit φ ζ * radialBoundaryLimit F.toFun ζ)) := by
    refine (hφ_lim.mul hF_lim).congr' ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    have hz : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hr.1] using hr.2
    exact (mulByInner_apply_ball hφ F hz).symm
  exact radialBoundaryLimit_eq_of_tendsto hprod

theorem norm_mulByInner (hPartB : HardyPartBInterface) {φ : ℂ → ℂ} (hφ : IsInnerFunction φ)
    (F : HardyElem 2) :
    ‖mulByInner hφ F‖ = ‖F‖ := by
  have h1 := (hPartB.hardy_boundary (by norm_num) (mulByInner hφ F).mem_hardy)
  have h2 := (hPartB.hardy_boundary (by norm_num) F.mem_hardy)
  have heLp : eLpNorm (radialBoundaryLimit (mulByInner hφ F).toFun) 2 circleMeasure =
      eLpNorm (radialBoundaryLimit F.toFun) 2 circleMeasure := by
    rw [← eLpNorm_norm (radialBoundaryLimit (mulByInner hφ F).toFun) h1.2.1.aestronglyMeasurable,
      ← eLpNorm_norm (radialBoundaryLimit F.toFun) h2.2.1.aestronglyMeasurable]
    refine eLpNorm_congr_ae ?_
    filter_upwards [radialBoundaryLimit_mulByInner_ae hPartB hφ F, hφ.2.2] with ζ hmul hnorm1
    simp [hmul, hnorm1]
  have hENN : hardySizeENNReal 2 (mulByInner hφ F).toFun = hardySizeENNReal 2 F.toFun :=
    h1.2.2.1.symm.trans (heLp.trans h2.2.2.1)
  exact congr_arg ENNReal.toReal hENN

theorem mulByInner_isometry (hPartB : HardyPartBInterface) {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) :
    Isometry (mulByInner hφ) :=
  AddMonoidHomClass.isometry_of_norm (mulByInner hφ) (norm_mulByInner hPartB hφ)

theorem innerSubspace_one_eq_top :
    innerSubspace (fun _ ↦ (1 : ℂ)) (isInnerFunction_const norm_one) = ⊤ := by
  rw [eq_top_iff]
  intro F _
  refine ⟨F, ?_⟩
  apply HardyElem.ext_ball
  intro z hz
  simp [hz]

/-- Iterated `dslope` helper: if `f` is holomorphic on `ball 0 1` and its first `n` derivatives
vanish at `z₀ ∈ ball 0 1`, then `f w = (w - z₀) ^ n * r w` on `ball 0 1` for an explicit
holomorphic function `r` on `ball 0 1`. -/
private theorem exists_holomorphic_pow_mul_of_iteratedDeriv_eq_zero {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {z₀ : ℂ} (hz₀ : z₀ ∈ Metric.ball (0 : ℂ) 1) :
    ∀ (n : ℕ), (∀ j < n, iteratedDeriv j f z₀ = 0) →
      ∃ r : ℂ → ℂ, HolomorphicOn r (Metric.ball (0 : ℂ) 1) ∧
        ∀ w ∈ Metric.ball (0 : ℂ) 1, f w = (w - z₀) ^ n * r w
  | 0, _ => ⟨f, hf, fun w _ ↦ by simp⟩
  | n + 1, hvan => by
    obtain ⟨r₀, hr₀_holo, hr₀_eq⟩ :=
      exists_holomorphic_pow_mul_of_iteratedDeriv_eq_zero hf hz₀ n
        (fun j hj ↦ hvan j (Nat.lt_trans hj (Nat.lt_succ_self n)))
    -- Show `r₀ z₀ = 0` from `iteratedDeriv n f z₀ = 0` via Taylor expansion at `z₀`
    have hr₀_zero : r₀ z₀ = 0 := by
      let ρ : ℝ := 1 - ‖z₀‖
      have hρ_pos : 0 < ρ := sub_pos.mpr (mem_ball_zero_iff.mp hz₀)
      have hsub : Metric.ball z₀ ρ ⊆ Metric.ball (0 : ℂ) 1 := fun w hw ↦ by
        have hwz : ‖w - z₀‖ < 1 - ‖z₀‖ := by simpa [Metric.mem_ball, dist_eq_norm, ρ] using hw
        have htri : ‖w‖ ≤ ‖w - z₀‖ + ‖z₀‖ := by simpa using norm_add_le (w - z₀) z₀
        rw [mem_ball_zero_iff]
        linarith
      let c : ℕ → ℂ := fun m ↦ iteratedDeriv m r₀ z₀ / (Nat.factorial m : ℂ)
      have hc_sum : ∀ w ∈ RudinRCA.Chapter10.disc z₀ ρ,
          HasSum (fun m : ℕ ↦ c m * (w - z₀) ^ m) (r₀ w) := fun w hw ↦ by
        have hd : DifferentiableOn ℂ r₀ (Metric.ball z₀ ρ) :=
          fun u hu ↦ (hr₀_holo u (hsub hu)).differentiableWithinAt
        convert Complex.hasSum_taylorSeries_on_ball hd hw using 1
        funext m
        simp only [c, smul_eq_mul, div_eq_mul_inv]
        ring
      let d : ℕ → ℂ := fun m ↦ if m < n then 0 else c (m - n)
      have hd_sum : ∀ w ∈ RudinRCA.Chapter10.disc z₀ ρ,
          HasSum (fun m : ℕ ↦ d m * (w - z₀) ^ m) (f w) := fun w hw ↦ by
        rw [hr₀_eq w (hsub hw), ← hasSum_nat_add_iff' n]
        have hzero_fin : ∑ i ∈ Finset.range n, d i * (w - z₀) ^ i = 0 :=
          Finset.sum_eq_zero fun i hi ↦ by simp [d, Finset.mem_range.mp hi]
        rw [hzero_fin, sub_zero]
        convert (hc_sum w hw).mul_left ((w - z₀) ^ n) using 1
        funext m
        have hnot : ¬ (m + n < n) := by omega
        simp only [d, hnot, ↓reduceIte, Nat.add_sub_cancel, pow_add]
        ring
      have hcoeff := RudinRCA.Chapter10.powerSeries_coefficient hρ_pos hd_sum n
      have hdn : d n = r₀ z₀ := by simp [d, c]
      have hfn : iteratedDeriv n f z₀ = 0 := hvan n (Nat.lt_succ_self n)
      rw [hdn, hfn] at hcoeff
      exact (mul_eq_zero.mp hcoeff).resolve_left (Nat.cast_ne_zero.mpr (Nat.factorial_ne_zero n))
    let r : ℂ → ℂ := dslope r₀ z₀
    have hr_diff : DifferentiableOn ℂ r (Metric.ball (0 : ℂ) 1) :=
      (Complex.differentiableOn_dslope (Metric.isOpen_ball.mem_nhds hz₀)).mpr
        ((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hr₀_holo)
    refine ⟨r, (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hr_diff, fun w hw ↦ ?_⟩
    have hsmul : (w - z₀) * r w = r₀ w := by
      have h := sub_smul_dslope r₀ z₀ w
      rwa [smul_eq_mul, hr₀_zero, sub_zero] at h
    rw [hr₀_eq w hw, ← hsmul, pow_succ]
    ring

private theorem iteratedDeriv_eq_zero_of_pow_mul {f r : ℂ → ℂ} {z₀ : ℂ}
    (hz₀ : z₀ ∈ Metric.ball (0 : ℂ) 1)
    (hr_holo : HolomorphicOn r (Metric.ball (0 : ℂ) 1)) (n : ℕ)
    (h_eq : ∀ w ∈ Metric.ball (0 : ℂ) 1, f w = (w - z₀) ^ n * r w) :
    ∀ j < n, iteratedDeriv j f z₀ = 0 := by
  intro j hj
  let ρ : ℝ := 1 - ‖z₀‖
  have hρ_pos : 0 < ρ := sub_pos.mpr (mem_ball_zero_iff.mp hz₀)
  have hsub : Metric.ball z₀ ρ ⊆ Metric.ball (0 : ℂ) 1 := fun w hw ↦ by
    have hwz : ‖w - z₀‖ < 1 - ‖z₀‖ := by simpa [Metric.mem_ball, dist_eq_norm, ρ] using hw
    have htri : ‖w‖ ≤ ‖w - z₀‖ + ‖z₀‖ := by simpa using norm_add_le (w - z₀) z₀
    rw [mem_ball_zero_iff]
    linarith
  let c : ℕ → ℂ := fun m ↦ iteratedDeriv m r z₀ / (Nat.factorial m : ℂ)
  have hc_sum : ∀ w ∈ RudinRCA.Chapter10.disc z₀ ρ,
      HasSum (fun m : ℕ ↦ c m * (w - z₀) ^ m) (r w) := fun w hw ↦ by
    have hd : DifferentiableOn ℂ r (Metric.ball z₀ ρ) :=
      fun u hu ↦ (hr_holo u (hsub hu)).differentiableWithinAt
    convert Complex.hasSum_taylorSeries_on_ball hd hw using 1
    funext m
    simp only [c, smul_eq_mul, div_eq_mul_inv]
    ring
  let d : ℕ → ℂ := fun m ↦ if m < n then 0 else c (m - n)
  have hd_sum : ∀ w ∈ RudinRCA.Chapter10.disc z₀ ρ,
      HasSum (fun m : ℕ ↦ d m * (w - z₀) ^ m) (f w) := fun w hw ↦ by
    rw [h_eq w (hsub hw), ← hasSum_nat_add_iff' n]
    have hzero_fin : ∑ i ∈ Finset.range n, d i * (w - z₀) ^ i = 0 :=
      Finset.sum_eq_zero fun i hi ↦ by simp [d, Finset.mem_range.mp hi]
    rw [hzero_fin, sub_zero]
    convert (hc_sum w hw).mul_left ((w - z₀) ^ n) using 1
    funext m
    have hnot : ¬ (m + n < n) := by omega
    simp only [d, hnot, ↓reduceIte, Nat.add_sub_cancel, pow_add]
    ring
  have hcoeff := RudinRCA.Chapter10.powerSeries_coefficient hρ_pos hd_sum j
  have hdj : d j = 0 := by simp [d, hj]
  rw [← hcoeff, hdj, mul_zero]

/-- **17.20 Finite-Blaschke Zero-Subspace Identification (RCA p. 348):**
For every finite Blaschke product `B(z) = z ^ k * ∏ i : Fin N, b_{a_i}(z)`, the Beurling subspace
`B H²` (`innerSubspace B _`) coincides with the zero-multiplicity subspace of `H²` prescribed by
multiplicity `k` at `0` and `# {i | a_i = z}` at each `z ∈ U \ {0}`. -/
theorem innerSubspace_finiteBlaschke_eq_zeroOrderSubspace (k N : ℕ) (a : Fin N → ℂ)
    (ha : ∀ i, a i ∈ Metric.ball (0 : ℂ) 1 ∧ a i ≠ 0) :
    let B : ℂ → ℂ := fun z ↦ z ^ k * ∏ i : Fin N, RudinRCA.Chapter15.blaschkeFactor (a i) z
    let m : ℂ → ℕ := fun z ↦
      open Classical in if z = 0 then k else (Finset.univ.filter (fun i ↦ a i = z)).card
    innerSubspace B (isInnerFunction_of_isBlaschkeProduct
      (RudinRCA.Chapter15.finite_blaschke_product k N a ha).1) =
      zeroOrderSubspace m := by
  classical
  let B : ℂ → ℂ := fun z ↦ z ^ k * ∏ i : Fin N, RudinRCA.Chapter15.blaschkeFactor (a i) z
  let m : ℂ → ℕ := fun z ↦ if z = 0 then k else (Finset.univ.filter (fun i ↦ a i = z)).card
  have hfin := RudinRCA.Chapter15.finite_blaschke_product k N a ha
  let hB_inner := isInnerFunction_of_isBlaschkeProduct hfin.1
  -- Local non-vanishing factorization `B w = (w - z₀) ^ (m z₀) * u z₀ w` on `ball 0 1`
  have hB_factor : ∀ z₀ ∈ Metric.ball (0 : ℂ) 1,
      ∃ u : ℂ → ℂ, HolomorphicOn u (Metric.ball (0 : ℂ) 1) ∧ u z₀ ≠ 0 ∧
        ∀ w ∈ Metric.ball (0 : ℂ) 1, B w = (w - z₀) ^ (m z₀) * u w := by
    intro z₀ hz₀
    by_cases hz₀0 : z₀ = 0
    · subst hz₀0
      let u : ℂ → ℂ := fun w ↦ ∏ i : Fin N, RudinRCA.Chapter15.blaschkeFactor (a i) w
      have hfin0 := RudinRCA.Chapter15.finite_blaschke_product 0 N a ha
      have hu_holo : HolomorphicOn u (Metric.ball (0 : ℂ) 1) := by
        have hd : DifferentiableOn ℂ u (Metric.ball (0 : ℂ) 1) := by
          simpa only [pow_zero, one_mul] using hfin0.2.2.1
        exact (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hd
      have hu0 : u 0 ≠ 0 := by
        rw [Finset.prod_ne_zero_iff]
        intro i _
        rw [RudinRCA.Chapter15.blaschkeFactor_zero (ha i).2]
        exact Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr (ha i).2)
      refine ⟨u, hu_holo, hu0, fun w _ ↦ ?_⟩
      simp [B, u, m]
    · let S : Finset (Fin N) := Finset.univ.filter (fun i ↦ a i = z₀)
      let Sc : Finset (Fin N) := Finset.univ.filter (fun i ↦ ¬ a i = z₀)
      let q₀ : ℂ → ℂ := fun w ↦ -(((‖z₀‖ : ℂ) / z₀) / (1 - star z₀ * w))
      let u : ℂ → ℂ := fun w ↦
        w ^ k * q₀ w ^ S.card * ∏ i ∈ Sc, RudinRCA.Chapter15.blaschkeFactor (a i) w
      have hden : ∀ w ∈ Metric.ball (0 : ℂ) 1, 1 - star z₀ * w ≠ 0 :=
        fun w hw ↦ RudinRCA.Chapter12.phi_denom_ne_zero hz₀ (Metric.ball_subset_closedBall hw)
      have hq₀_holo : HolomorphicOn q₀ (Metric.ball (0 : ℂ) 1) := fun w hw ↦
        ((differentiableAt_const _).div
          ((differentiableAt_const (1 : ℂ)).sub ((differentiableAt_const _).mul differentiableAt_id))
          (hden w hw)).neg
      have hprod_holo : ∀ T : Finset (Fin N),
          HolomorphicOn (fun w ↦ ∏ i ∈ T, RudinRCA.Chapter15.blaschkeFactor (a i) w)
            (Metric.ball (0 : ℂ) 1) := by
        intro T
        induction T using Finset.induction_on with
        | empty =>
          intro w _
          simp only [Finset.prod_empty]
          exact differentiableAt_const (1 : ℂ)
        | insert j T hj ih =>
          intro w hw
          have hd_j : DifferentiableAt ℂ (RudinRCA.Chapter15.blaschkeFactor (a j)) w :=
            (RudinRCA.Chapter15.differentiableOn_blaschkeFactor_ball (ha j).1).differentiableAt
              (Metric.isOpen_ball.mem_nhds hw)
          have heq : (fun u ↦ ∏ i ∈ insert j T, RudinRCA.Chapter15.blaschkeFactor (a i) u) =
              fun u ↦ RudinRCA.Chapter15.blaschkeFactor (a j) u *
                ∏ i ∈ T, RudinRCA.Chapter15.blaschkeFactor (a i) u :=
            funext fun _ ↦ Finset.prod_insert hj
          rw [heq]
          exact hd_j.mul (ih w hw)
      have hu_holo : HolomorphicOn u (Metric.ball (0 : ℂ) 1) := fun w hw ↦
        (((differentiableAt_id.pow k).mul ((hq₀_holo w hw).pow S.card)).mul (hprod_holo Sc w hw))
      have hq₀_nz : q₀ z₀ ≠ 0 := by
        dsimp [q₀]
        refine neg_ne_zero.mpr (div_ne_zero ?_ (hden z₀ hz₀))
        exact div_ne_zero (Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr hz₀0)) hz₀0
      have hu_z₀ : u z₀ ≠ 0 := by
        dsimp [u]
        refine mul_ne_zero (mul_ne_zero (pow_ne_zero k hz₀0) (pow_ne_zero _ hq₀_nz)) ?_
        rw [Finset.prod_ne_zero_iff]
        intro i hi
        have hne : a i ≠ z₀ := (Finset.mem_filter.mp hi).2
        intro h0
        have heq := (RudinRCA.Chapter15.blaschkeFactor_eq_zero_iff (ha i).1 (ha i).2
          (Metric.ball_subset_closedBall hz₀)).mp h0
        exact hne heq.symm
      refine ⟨u, hu_holo, hu_z₀, fun w _ ↦ ?_⟩
      have hm_eq : m z₀ = S.card := by simp [m, hz₀0, S]
      have hbf_z₀ : RudinRCA.Chapter15.blaschkeFactor z₀ w = (w - z₀) * q₀ w := by
        dsimp [RudinRCA.Chapter15.blaschkeFactor, q₀]
        ring
      have hsplit := (Finset.prod_filter_mul_prod_filter_not Finset.univ (fun i ↦ a i = z₀)
        (fun i ↦ RudinRCA.Chapter15.blaschkeFactor (a i) w)).symm
      have hS_prod : (∏ i ∈ S, RudinRCA.Chapter15.blaschkeFactor (a i) w) =
          (w - z₀) ^ S.card * q₀ w ^ S.card := by
        have hcongr : (∏ i ∈ S, RudinRCA.Chapter15.blaschkeFactor (a i) w) =
            ∏ _ ∈ S, ((w - z₀) * q₀ w) := by
          refine Finset.prod_congr rfl fun i hi ↦ ?_
          rw [(Finset.mem_filter.mp hi).2, hbf_z₀]
        rw [hcongr, Finset.prod_const, mul_pow]
      dsimp [B, u]
      rw [hm_eq, hsplit]
      change w ^ k * ((∏ i ∈ S, RudinRCA.Chapter15.blaschkeFactor (a i) w) *
        ∏ i ∈ Sc, RudinRCA.Chapter15.blaschkeFactor (a i) w) = _
      rw [hS_prod]
      ring
  refine le_antisymm ?_ ?_
  · -- `innerSubspace B _ ≤ zeroOrderSubspace m`
    rintro _ ⟨G, rfl⟩ z₀ hz₀ j hj
    obtain ⟨u, hu_holo, _, hBu⟩ := hB_factor z₀ hz₀
    refine iteratedDeriv_eq_zero_of_pow_mul (r := fun w ↦ u w * G.toFun w) hz₀
      (fun w hw ↦ (hu_holo w hw).mul (G.mem_hardy.2.1 w hw)) (m z₀) (fun w hw ↦ ?_) j hj
    change mulByInner hB_inner G w = (w - z₀) ^ m z₀ * (u w * G w)
    rw [mulByInner_apply_ball hB_inner G hw]
    change B w * G w = (w - z₀) ^ m z₀ * (u w * G w)
    rw [hBu w hw, mul_assoc]
  · -- `zeroOrderSubspace m ≤ innerSubspace B _`
    intro F hF
    have hloc : ∀ z₀ ∈ Metric.ball (0 : ℂ) 1,
        ∃ g : ℂ → ℂ, DifferentiableAt ℂ g z₀ ∧
          (F.toFun z₀ = B z₀ * g z₀) ∧
          (∀ᶠ w in 𝓝 z₀, (w ≠ z₀ → B w ≠ 0) ∧ (B w ≠ 0 → F.toFun w / B w = g w)) := by
      intro z₀ hz₀
      obtain ⟨u, hu_holo, hu_nz, hBu⟩ := hB_factor z₀ hz₀
      obtain ⟨r, hr_holo, hFr⟩ :=
        exists_holomorphic_pow_mul_of_iteratedDeriv_eq_zero F.mem_hardy.2.1 hz₀ (m z₀) (hF z₀ hz₀)
      have hu_cont : ContinuousAt u z₀ := (hu_holo z₀ hz₀).continuousAt
      obtain ⟨δ₁, hδ₁, hu_ne⟩ := Metric.mem_nhds_iff.mp (hu_cont.eventually_ne hu_nz)
      let δ : ℝ := min (δ₁ / 2) ((1 - ‖z₀‖) / 2)
      have hδ_pos : 0 < δ :=
        lt_min (half_pos hδ₁) (half_pos (sub_pos.mpr (mem_ball_zero_iff.mp hz₀)))
      have hball_sub : Metric.ball z₀ δ ⊆ Metric.ball (0 : ℂ) 1 := fun w hw ↦ by
        have hwz : ‖w - z₀‖ < (1 - ‖z₀‖) / 2 := by
          have hd : dist w z₀ < δ := Metric.mem_ball.mp hw
          rw [dist_eq_norm] at hd
          exact hd.trans_le (min_le_right _ _)
        have htri : ‖w‖ ≤ ‖w - z₀‖ + ‖z₀‖ := by simpa using norm_add_le (w - z₀) z₀
        have hz₀_lt : ‖z₀‖ < 1 := mem_ball_zero_iff.mp hz₀
        rw [mem_ball_zero_iff]
        linarith
      let g : ℂ → ℂ := fun w ↦ r w / u w
      have hg_diff : DifferentiableAt ℂ g z₀ :=
        (hr_holo z₀ hz₀).div (hu_holo z₀ hz₀) hu_nz
      have hFz₀ : F.toFun z₀ = B z₀ * g z₀ := by
        dsimp [g]
        rw [hFr z₀ hz₀, hBu z₀ hz₀, mul_assoc, mul_div_cancel₀ _ hu_nz]
      refine ⟨g, hg_diff, hFz₀, ?_⟩
      filter_upwards [Metric.ball_mem_nhds z₀ hδ_pos] with w hw
      have hw_ball : w ∈ Metric.ball (0 : ℂ) 1 := hball_sub hw
      have hw_δ₁ : w ∈ Metric.ball z₀ δ₁ :=
        Metric.ball_subset_ball ((min_le_left _ _).trans (half_lt_self hδ₁).le) hw
      have huw_ne : u w ≠ 0 := hu_ne hw_δ₁
      refine ⟨fun hw_ne ↦ ?_, fun hBw_ne ↦ ?_⟩
      · rw [hBu w hw_ball]
        exact mul_ne_zero (pow_ne_zero _ (sub_ne_zero.mpr hw_ne)) huw_ne
      · have hpow_ne : (w - z₀) ^ m z₀ ≠ 0 := fun hp0 ↦ hBw_ne (by rw [hBu w hw_ball, hp0, zero_mul])
        rw [hFr w hw_ball, hBu w hw_ball, mul_div_mul_left _ _ hpow_ne]
    let q : ℂ → ℂ := fun z ↦
      if hz : z ∈ Metric.ball (0 : ℂ) 1 then
        if B z ≠ 0 then F.toFun z / B z else (hloc z hz).choose z
      else 0
    have hBq_eq : ∀ z ∈ Metric.ball (0 : ℂ) 1, F.toFun z = B z * q z := by
      intro z hz
      dsimp only [q]
      simp only [hz, ↓reduceDIte]
      split_ifs with hBz
      · exact (mul_div_cancel₀ _ hBz).symm
      · exact (hloc z hz).choose_spec.2.1
    have hq_holo : HolomorphicOn q (Metric.ball (0 : ℂ) 1) := by
      intro z₀ hz₀
      let g₀ := (hloc z₀ hz₀).choose
      obtain ⟨hg₀_diff, _, hev⟩ := (hloc z₀ hz₀).choose_spec
      refine hg₀_diff.congr_of_eventuallyEq ?_
      filter_upwards [Metric.isOpen_ball.mem_nhds hz₀, hev] with w hw ⟨hw_nz, hw_div⟩
      dsimp only [q]
      simp only [hw, ↓reduceDIte]
      split_ifs with hBw
      · exact hw_div hBw
      · have hw_eq : w = z₀ := by
          by_contra hne
          exact hBw (hw_nz hne)
        subst hw_eq
        rfl
    -- Lower bound `1 / 2 < ‖B z‖` near `Metric.sphere 0 1` by compactness
    let K : Set ℂ := {z ∈ Metric.closedBall (0 : ℂ) 1 | ‖B z‖ ≤ 1 / 2}
    have hK_closed : IsClosed K := by
      rw [← isSeqClosed_iff_isClosed]
      intro u z hu hlim
      have hz_cb : z ∈ Metric.closedBall (0 : ℂ) 1 :=
        IsClosed.mem_of_tendsto Metric.isClosed_closedBall hlim
          (Eventually.of_forall fun n ↦ (hu n).1)
      have hB_cont := hfin.2.1.continuousOn z hz_cb
      have hlim_cb : Tendsto u atTop (𝓝[Metric.closedBall (0 : ℂ) 1] z) :=
        tendsto_nhdsWithin_of_tendsto_nhds_of_eventually_within u hlim
          (Eventually.of_forall fun n ↦ (hu n).1)
      have hnorm_lim : Tendsto (fun n ↦ ‖B (u n)‖) atTop (𝓝 ‖B z‖) :=
        (hB_cont.tendsto.comp hlim_cb).norm
      exact ⟨hz_cb, le_of_tendsto hnorm_lim (Eventually.of_forall fun n ↦ (hu n).2)⟩
    have hK_comp : IsCompact K :=
      (isCompact_closedBall (0 : ℂ) 1).of_isClosed_subset hK_closed fun _ h ↦ h.1
    have hK_lt1 : ∀ z ∈ K, ‖z‖ < 1 := by
      rintro z ⟨hz_cb, hBz_le⟩
      have hz_le1 : ‖z‖ ≤ 1 := mem_closedBall_zero_iff.mp hz_cb
      refine lt_of_le_of_ne hz_le1 fun hnorm1 ↦ ?_
      have hsp : z ∈ Metric.sphere (0 : ℂ) 1 := mem_sphere_zero_iff_norm.mpr hnorm1
      have h1 : ‖B z‖ = 1 := hfin.2.2.2.2.1 z hsp
      linarith
    obtain ⟨r₁, hr₁_mem, hr₁_bound⟩ :
        ∃ r₁ ∈ Set.Ioo (0 : ℝ) 1, ∀ z ∈ Metric.closedBall (0 : ℂ) 1, r₁ ≤ ‖z‖ → 1 / 2 < ‖B z‖ := by
      rcases K.eq_empty_or_nonempty with hK_emp | hK_ne
      · refine ⟨1 / 2, ⟨by norm_num, by norm_num⟩, fun z hz_cb _ ↦ ?_⟩
        by_contra hle
        have hzK : z ∈ K := ⟨hz_cb, not_lt.mp hle⟩
        rw [hK_emp] at hzK
        exact hzK
      · obtain ⟨z_max, hz_max, hmax⟩ := hK_comp.exists_isMaxOn hK_ne continuous_norm.continuousOn
        have hz_lt1 : ‖z_max‖ < 1 := hK_lt1 z_max hz_max
        refine ⟨(‖z_max‖ + 1) / 2, ⟨by linarith [norm_nonneg z_max], by linarith⟩,
          fun z hz_cb hrz ↦ ?_⟩
        by_contra hle
        have hzK : z ∈ K := ⟨hz_cb, not_lt.mp hle⟩
        have hle_max : ‖z‖ ≤ ‖z_max‖ := hmax hzK
        linarith
    have hq_cont_cb : ContinuousOn q (Metric.closedBall (0 : ℂ) r₁) :=
      (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hq_holo).mono
        (Metric.closedBall_subset_ball hr₁_mem.2)
    obtain ⟨C₀, hC₀⟩ := (isCompact_closedBall (0 : ℂ) r₁).exists_bound_of_continuousOn hq_cont_cb
    let C : ℝ := max 0 C₀
    have hq_h2 : IsInHardySpace 2 q := by
      refine ⟨by norm_num, hq_holo, ?_⟩
      have hle : hardySizeENNReal 2 q ≤
          max (ENNReal.ofReal C) (‖(2 : ℂ)‖ₑ * hardySizeENNReal 2 F.toFun) := by
        refine iSup₂_le fun r hr ↦ ?_
        have hcont_q := continuous_radialSlice_of_holomorphicOn hq_holo hr.1 hr.2
        rcases le_or_gt r r₁ with hrr₁ | hrr₁
        · refine (?_ : radialSizeENNReal 2 q r ≤ ENNReal.ofReal C).trans (le_max_left _ _)
          simp only [radialSizeENNReal, show (2 : ℝ≥0∞) ≠ 0 by norm_num, ↓reduceIte]
          calc eLpNorm (radialSlice q r) 2 circleMeasure
              ≤ eLpNorm (fun _ : FourierCircle ↦ C) 2 circleMeasure := by
                refine eLpNorm_mono_real hcont_q.aestronglyMeasurable fun ζ ↦ ?_
                have hz_cb : (r : ℂ) * circlePoint ζ ∈ Metric.closedBall (0 : ℂ) r₁ := by
                  simpa [Metric.mem_closedBall, norm_mul, Complex.norm_real, Real.norm_eq_abs,
                    abs_of_nonneg hr.1] using hrr₁
                exact (hC₀ _ hz_cb).trans (le_max_right 0 C₀)
            _ = ENNReal.ofReal C := by
                rw [eLpNorm_const' C (by norm_num) (by norm_num)]
                simp only [measure_univ, ENNReal.one_rpow, mul_one]
                exact Real.enorm_eq_ofReal (le_max_left 0 C₀)
        · refine (?_ : radialSizeENNReal 2 q r ≤ ‖(2 : ℂ)‖ₑ * hardySizeENNReal 2 F.toFun).trans
              (le_max_right _ _)
          have hslice : radialSizeENNReal 2 q r ≤ ‖(2 : ℂ)‖ₑ * radialSizeENNReal 2 F.toFun r := by
            simp only [radialSizeENNReal, show (2 : ℝ≥0∞) ≠ 0 by norm_num, ↓reduceIte]
            calc eLpNorm (radialSlice q r) 2 circleMeasure
                ≤ eLpNorm ((2 : ℂ) • radialSlice F.toFun r) 2 circleMeasure := by
                  refine eLpNorm_mono hcont_q.aestronglyMeasurable fun ζ ↦ ?_
                  have hz_ball : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
                    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
                      abs_of_nonneg hr.1] using hr.2
                  have hz_norm : ‖(r : ℂ) * circlePoint ζ‖ = r := by
                    simp [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr.1]
                  have hB_gt : 1 / 2 < ‖B ((r : ℂ) * circlePoint ζ)‖ :=
                    hr₁_bound _ (Metric.ball_subset_closedBall hz_ball) (hrr₁.le.trans_eq hz_norm.symm)
                  have hF_eq := hBq_eq _ hz_ball
                  have hpt : ‖radialSlice q r ζ‖ ≤ 2 * ‖radialSlice F.toFun r ζ‖ := by
                    dsimp [radialSlice]
                    rw [hF_eq, norm_mul]
                    nlinarith [norm_nonneg (q ((r : ℂ) * circlePoint ζ))]
                  simpa [Pi.smul_apply, norm_mul] using hpt
              _ = ‖(2 : ℂ)‖ₑ * eLpNorm (radialSlice F.toFun r) 2 circleMeasure :=
                  eLpNorm_const_smul (2 : ℂ) (radialSlice F.toFun r) 2 circleMeasure
          exact hslice.trans
            (mul_le_mul_of_nonneg_left (le_biSup (radialSizeENNReal 2 F.toFun) hr) (by positivity))
      exact hle.trans_lt (max_lt ENNReal.ofReal_lt_top
        (ENNReal.mul_lt_top enorm_lt_top F.mem_hardy.2.2))
    refine ⟨HardyElem.ofIsInHardySpace q hq_h2, ?_⟩
    apply HardyElem.ext_ball
    intro z hz
    change mulByInner hB_inner (HardyElem.ofIsInHardySpace q hq_h2) z = F.toFun z
    rw [mulByInner_apply_ball hB_inner _ hz, HardyElem.ofIsInHardySpace_apply_of_mem q hq_h2 hz]
    exact (hBq_eq z hz).symm

/-- **17.20 (Unilateral Shift on `ℓ²`, `H²` Isomorphism, and Zero-Condition Invariant Subspaces,
RCA pp. 346–348):**
1. The unilateral shift `S = unilateralShift` on `ℓ²(ℕ, ℂ)` is an isometry of operator norm `1`.
2. The Maclaurin synthesis `coeffEquivH2 : ℓ²(ℕ, ℂ) ≃ₗᵢ[ℂ] HardyElem 2` is a Hilbert-space
   isomorphism conjugating `unilateralShift` to multiplication by `z` (`mulZ`), which is also an
   isometry of norm `1`, and identifying closed `unilateralShift`-invariant subspaces of `ℓ²`
   bijectively with closed `mulZ`-invariant subspaces of `H²`.
3. Every zero-multiplicity prescription `k : ℂ → ℕ` on `U` defines a closed `mulZ`-invariant
   subspace `zeroOrderSubspace k` of `H²`, and for every finite Blaschke product `B`, `B H²` is
   precisely the zero-multiplicity subspace determined by the zeros of `B`. -/
theorem theorem17_20 :
    (Isometry unilateralShift ∧ ‖unilateralShift‖ = 1) ∧
    (Isometry mulZ ∧ ‖mulZ‖ = 1 ∧
      ∀ a : lp (fun _ : ℕ ↦ ℂ) 2, coeffEquivH2 (unilateralShift a) = mulZ (coeffEquivH2 a)) ∧
    (∀ Y : Submodule ℂ (lp (fun _ : ℕ ↦ ℂ) 2),
      IsClosedOperatorInvariantSubspace unilateralShift Y ↔
        IsClosedInvariantSubspace (Y.map coeffEquivH2.toLinearEquiv.toLinearMap)) ∧
    (∀ k : ℂ → ℕ, IsClosedInvariantSubspace (zeroOrderSubspace k)) ∧
    (∀ (k N : ℕ) (a : Fin N → ℂ) (ha : ∀ i, a i ∈ Metric.ball (0 : ℂ) 1 ∧ a i ≠ 0),
      innerSubspace (fun z ↦ z ^ k * ∏ i : Fin N, RudinRCA.Chapter15.blaschkeFactor (a i) z)
        (isInnerFunction_of_isBlaschkeProduct
          (RudinRCA.Chapter15.finite_blaschke_product k N a ha).1) =
        zeroOrderSubspace (fun z ↦
          open Classical in if z = 0 then k else (Finset.univ.filter (fun i ↦ a i = z)).card)) := by
  refine ⟨⟨unilateralShift_isometry, norm_unilateralShift⟩,
    ⟨mulZ_isometry, norm_mulZ, coeffEquivH2_unilateralShift⟩, ?_,
    isClosedInvariantSubspace_zeroOrderSubspace,
    innerSubspace_finiteBlaschke_eq_zeroOrderSubspace⟩
  intro Y
  constructor
  · rintro ⟨hY_closed, hY_inv⟩
    refine ⟨?_, ?_⟩
    · have himg : (Y.map coeffEquivH2.toLinearEquiv.toLinearMap : Set (HardyElem 2)) =
          coeffEquivH2.toHomeomorph '' (Y : Set (lp (fun _ : ℕ ↦ ℂ) 2)) := rfl
      rw [himg]
      exact coeffEquivH2.toHomeomorph.isClosed_image.mpr hY_closed
    · rintro _ ⟨a, ha, rfl⟩
      refine ⟨unilateralShift a, hY_inv a ha, ?_⟩
      exact coeffEquivH2_unilateralShift a
  · rintro ⟨himg_closed, himg_inv⟩
    refine ⟨?_, ?_⟩
    · have himg : (Y.map coeffEquivH2.toLinearEquiv.toLinearMap : Set (HardyElem 2)) =
          coeffEquivH2.toHomeomorph '' (Y : Set (lp (fun _ : ℕ ↦ ℂ) 2)) := rfl
      rw [himg] at himg_closed
      exact coeffEquivH2.toHomeomorph.isClosed_image.mp himg_closed
    · intro a ha
      have hmem : mulZ (coeffEquivH2 a) ∈ Y.map coeffEquivH2.toLinearEquiv.toLinearMap :=
        himg_inv _ ⟨a, ha, rfl⟩
      rw [← coeffEquivH2_unilateralShift a] at hmem
      obtain ⟨b, hb, hba⟩ := hmem
      have heq : b = unilateralShift a := coeffEquivH2.injective hba
      exact heq ▸ hb

/-! ### Section 17.21: Beurling's Theorem (RCA pp. 348–349) -/

/-- **17.21(a) (Beurling Subspaces are Nonzero Closed `mulZ`-Invariant Subspaces, RCA p. 348).** -/
theorem isClosedInvariantSubspace_innerSubspace (hPartB : HardyPartBInterface)
    {φ : ℂ → ℂ} (hφ : IsInnerFunction φ) :
    IsClosedInvariantSubspace (innerSubspace φ hφ) ∧ innerSubspace φ hφ ≠ ⊥ := by
  refine ⟨⟨?_, ?_⟩, ?_⟩
  · have hrange : (innerSubspace φ hφ : Set (HardyElem 2)) = Set.range (mulByInner hφ) := rfl
    rw [hrange]
    exact (mulByInner_isometry hPartB hφ).isUniformInducing.isComplete_range.isClosed
  · rintro _ ⟨G, rfl⟩
    exact ⟨mulZ G, (mulZ_mulByInner hφ G).symm⟩
  · intro hbot
    have hmem : mulByInner hφ hardyOne ∈ innerSubspace φ hφ := ⟨hardyOne, rfl⟩
    rw [hbot, Submodule.mem_bot] at hmem
    have hnorm : ‖mulByInner hφ hardyOne‖ = 1 := by
      rw [norm_mulByInner hPartB hφ, norm_hardyOne]
    rw [hmem, norm_zero] at hnorm
    exact zero_ne_one hnorm

/-- **17.21(b) (Uniqueness of the Inner Generator up to Unit-Modulus Constant, RCA p. 348):**
For inner functions `φ₁, φ₂`, `φ₁ H² = φ₂ H²` if and only if `φ₁ = c φ₂` on `U = Metric.ball 0 1`
for a constant `c : ℂ` with `‖c‖ = 1`. -/
theorem innerSubspace_eq_iff (hPartB : HardyPartBInterface)
    {φ₁ φ₂ : ℂ → ℂ} (hφ₁ : IsInnerFunction φ₁) (hφ₂ : IsInnerFunction φ₂) :
    innerSubspace φ₁ hφ₁ = innerSubspace φ₂ hφ₂ ↔
      ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ z ∈ Metric.ball (0 : ℂ) 1, φ₁ z = c * φ₂ z := by
  constructor
  · intro heq
    have hm1 : mulByInner hφ₁ hardyOne ∈ innerSubspace φ₂ hφ₂ := heq ▸ ⟨hardyOne, rfl⟩
    have hm2 : mulByInner hφ₂ hardyOne ∈ innerSubspace φ₁ hφ₁ := heq.symm ▸ ⟨hardyOne, rfl⟩
    obtain ⟨G₁, hG₁⟩ := hm1
    obtain ⟨G₂, hG₂⟩ := hm2
    change mulByInner hφ₂ G₁ = mulByInner hφ₁ hardyOne at hG₁
    change mulByInner hφ₁ G₂ = mulByInner hφ₂ hardyOne at hG₂
    have hG₁_norm : ‖G₁‖ = 1 := by
      rw [← norm_mulByInner hPartB hφ₂ G₁, hG₁, norm_mulByInner hPartB hφ₁, norm_hardyOne]
    have hG₂_norm : ‖G₂‖ = 1 := by
      rw [← norm_mulByInner hPartB hφ₁ G₂, hG₂, norm_mulByInner hPartB hφ₂, norm_hardyOne]
    have hφ₁_eq : ∀ z ∈ Metric.ball (0 : ℂ) 1, φ₁ z = φ₂ z * G₁ z := by
      intro z hz
      have h := congr_arg (fun F : HardyElem 2 ↦ F z) hG₁.symm
      simpa [hz] using h
    have hφ₂_eq : ∀ z ∈ Metric.ball (0 : ℂ) 1, φ₂ z = φ₁ z * G₂ z := by
      intro z hz
      have h := congr_arg (fun F : HardyElem 2 ↦ F z) hG₂.symm
      simpa [hz] using h
    -- Identity theorem on `ball 0 1` shows `G₁ z * G₂ z = 1` on `ball 0 1`
    have hprod_one : ∀ z ∈ Metric.ball (0 : ℂ) 1, G₁ z * G₂ z = 1 := by
      let h : ℂ → ℂ := fun z ↦ 1 - G₁ z * G₂ z
      have hh_ana : AnalyticOnNhd ℂ h (Metric.ball (0 : ℂ) 1) := by
        have hd : DifferentiableOn ℂ h (Metric.ball (0 : ℂ) 1) := fun z hz ↦
          ((differentiableAt_const (1 : ℂ)).sub
            ((G₁.mem_hardy.2.1 z hz).mul (G₂.mem_hardy.2.1 z hz))).differentiableWithinAt
        exact hd.analyticOnNhd Metric.isOpen_ball
      have hmul_zero : ∀ z ∈ Metric.ball (0 : ℂ) 1, φ₁ z * h z = 0 := by
        intro z hz
        calc φ₁ z * h z
            = φ₁ z - (φ₁ z * G₂ z) * G₁ z := by dsimp [h]; ring
          _ = φ₁ z - φ₂ z * G₁ z := by rw [← hφ₂_eq z hz]
          _ = φ₁ z - φ₁ z := by rw [← hφ₁_eq z hz]
          _ = 0 := sub_self _
      intro w₀ hw₀
      by_contra hw₀_ne
      have hh_nz : h w₀ ≠ 0 := sub_ne_zero.mpr (Ne.symm hw₀_ne)
      have hh_cont : ContinuousAt h w₀ := (hh_ana w₀ hw₀).continuousAt
      have hev_nz : ∀ᶠ w in 𝓝 w₀, h w ≠ 0 := hh_cont.eventually_ne hh_nz
      have hφ₁_ev0 : φ₁ =ᶠ[𝓝 w₀] 0 := by
        filter_upwards [Metric.isOpen_ball.mem_nhds hw₀, hev_nz] with w hw hhw
        exact (mul_eq_zero.mp (hmul_zero w hw)).resolve_right hhw
      have hφ₁_ana : AnalyticOnNhd ℂ φ₁ (Metric.ball (0 : ℂ) 1) :=
        ((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hφ₁.1).analyticOnNhd
          Metric.isOpen_ball
      have hφ₁_zero := hφ₁_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        (convex_ball (0 : ℂ) 1).isPreconnected hw₀ hφ₁_ev0
      obtain ⟨z₁, hz₁, hφ₁_nz⟩ := hφ₁.nonzero_on_ball
      exact hφ₁_nz (hφ₁_zero hz₁)
    have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
    have hprod0 : G₁ 0 * G₂ 0 = 1 := hprod_one 0 h0_mem
    let a₁ := coeffEquivH2.symm G₁
    let a₂ := coeffEquivH2.symm G₂
    have ha₁0 : a₁ 0 = G₁ 0 := by simp [a₁, taylorCoeff]
    have ha₂0 : a₂ 0 = G₂ 0 := by simp [a₂, taylorCoeff]
    have hle₁ : ‖G₁ 0‖ ≤ 1 := by
      rw [← ha₁0]
      exact (lp.norm_apply_le_norm (by norm_num) a₁ 0).trans_eq
        ((coeffEquivH2.symm.norm_map G₁).trans hG₁_norm)
    have hle₂ : ‖G₂ 0‖ ≤ 1 := by
      rw [← ha₂0]
      exact (lp.norm_apply_le_norm (by norm_num) a₂ 0).trans_eq
        ((coeffEquivH2.symm.norm_map G₂).trans hG₂_norm)
    have hmul_norm : ‖G₁ 0‖ * ‖G₂ 0‖ = 1 := by rw [← norm_mul, hprod0, norm_one]
    have hG₁0_norm : ‖G₁ 0‖ = 1 := by
      nlinarith [norm_nonneg (G₁ 0), norm_nonneg (G₂ 0)]
    have hhas₁ : HasSum (fun n : ℕ ↦ ‖a₁ n‖ ^ 2) 1 := by
      have h := lp.hasSum_norm (p := 2) (by norm_num) a₁
      have ha₁_norm : ‖a₁‖ = 1 := (coeffEquivH2.symm.norm_map G₁).trans hG₁_norm
      simpa [ha₁_norm] using h
    have htail0 : HasSum (fun n : ℕ ↦ ‖a₁ (n + 1)‖ ^ 2) 0 := by
      have hshift := (hasSum_nat_add_iff' (f := fun n : ℕ ↦ ‖a₁ n‖ ^ 2) 1).mpr hhas₁
      simpa [ha₁0, hG₁0_norm] using hshift
    have ha₁_succ : ∀ n : ℕ, a₁ (n + 1) = 0 := by
      intro n
      have hle0 : ‖a₁ (n + 1)‖ ^ 2 ≤ 0 :=
        htail0.summable.le_tsum n (fun _ _ ↦ sq_nonneg _) |>.trans_eq htail0.tsum_eq
      have hsq0 : ‖a₁ (n + 1)‖ ^ 2 = 0 := le_antisymm hle0 (sq_nonneg _)
      exact norm_eq_zero.mp (sq_eq_zero_iff.mp hsq0)
    have ha₁_eq : a₁ = G₁ 0 • (lp.single 2 0 (1 : ℂ) : lp (fun _ : ℕ ↦ ℂ) 2) := by
      ext n
      cases n with
      | zero => simp [ha₁0, lp.single_apply]
      | succ n => simp [ha₁_succ n, lp.single_apply]
    have hG₁_const : G₁ = G₁ 0 • hardyOne := by
      have ha₁_img : coeffEquivH2 a₁ = G₁ 0 • hardyOne := by
        rw [ha₁_eq, coeffEquivH2.map_smul]
        rfl
      exact (coeffEquivH2.apply_symm_apply G₁).symm.trans ha₁_img
    refine ⟨G₁ 0, hG₁0_norm, fun z hz ↦ ?_⟩
    rw [hφ₁_eq z hz, hG₁_const]
    simp [HardyElem.toFun_smul, hz, mul_comm]
  · rintro ⟨c, hc, hφ_eq⟩
    have hc_ne : c ≠ 0 := norm_ne_zero_iff.mp (hc ▸ one_ne_zero)
    ext F
    constructor
    · rintro ⟨G, rfl⟩
      refine ⟨c • G, ?_⟩
      apply HardyElem.ext_ball
      intro z hz
      change mulByInner hφ₂ (c • G) z = mulByInner hφ₁ G z
      rw [mulByInner_apply_ball _ _ hz, mulByInner_apply_ball _ _ hz, hφ_eq z hz,
        HardyElem.toFun_smul, Pi.smul_apply, smul_eq_mul]
      ring
    · rintro ⟨G, rfl⟩
      refine ⟨c⁻¹ • G, ?_⟩
      apply HardyElem.ext_ball
      intro z hz
      change mulByInner hφ₁ (c⁻¹ • G) z = mulByInner hφ₂ G z
      rw [mulByInner_apply_ball _ _ hz, mulByInner_apply_ball _ _ hz, hφ_eq z hz,
        HardyElem.toFun_smul, Pi.smul_apply, smul_eq_mul]
      calc c * φ₂ z * (c⁻¹ * G z) = (c * c⁻¹) * (φ₂ z * G z) := by ring
        _ = φ₂ z * G z := by rw [mul_inv_cancel₀ hc_ne, one_mul]

private theorem taylorCoeff_mulZ (H : HardyElem 2) (n : ℕ) :
    taylorCoeff (mulZ H).toFun n = shiftSeq (taylorCoeff H.toFun) n := by
  have h : coeffEquivH2.symm (mulZ H) = unilateralShift (coeffEquivH2.symm H) := by
    apply coeffEquivH2.injective
    rw [coeffEquivH2.apply_symm_apply, coeffEquivH2_unilateralShift, coeffEquivH2.apply_symm_apply]
  exact congr_arg (fun a : lp (fun _ : ℕ ↦ ℂ) 2 ↦ a n) h

private theorem star_trigMonomial (m : ℤ) (ζ : FourierCircle) :
    star (RudinRCA.Chapter04.trigMonomial m ζ) = RudinRCA.Chapter04.trigMonomial (-m) ζ := by
  simp [RudinRCA.Chapter04.trigMonomial]

private theorem star_mul_self_eq_norm_sq (z : ℂ) :
    star z * z = ((‖z‖ ^ 2 : ℝ) : ℂ) := by
  calc star z * z = z * (starRingEnd ℂ) z := mul_comm _ _
    _ = ((‖z‖ ^ 2 : ℝ) : ℂ) := by rw [Complex.mul_conj, Complex.normSq_eq_norm_sq]

/-- **Theorem 17.21 (Beurling's Theorem, RCA pp. 348–349):**
- `(a)` For every inner function `φ`, `mulByInner hφ` is an isometry of `H²` onto a nonzero closed
  `mulZ`-invariant subspace `innerSubspace φ hφ = φ H²`.
- `(b)` Two inner functions `φ₁, φ₂` determine the same subspace `φ₁ H² = φ₂ H²` if and only if
  `φ₁ / φ₂` is a unit-modulus constant on `U = Metric.ball 0 1`.
- `(c)` Every **nonzero** closed `mulZ`-invariant subspace `Y` of `H²` (`Y ≠ ⊥`) is of the form
  `Y = innerSubspace φ hφ` for some inner function `φ`. -/
theorem theorem17_21 (hPartB : HardyPartBInterface) :
    (∀ {φ : ℂ → ℂ} (hφ : IsInnerFunction φ),
      Isometry (mulByInner hφ) ∧
      IsClosedInvariantSubspace (innerSubspace φ hφ) ∧
      innerSubspace φ hφ ≠ ⊥) ∧
    (∀ {φ₁ φ₂ : ℂ → ℂ} (hφ₁ : IsInnerFunction φ₁) (hφ₂ : IsInnerFunction φ₂),
      innerSubspace φ₁ hφ₁ = innerSubspace φ₂ hφ₂ ↔
        ∃ c : ℂ, ‖c‖ = 1 ∧ ∀ z ∈ Metric.ball (0 : ℂ) 1, φ₁ z = c * φ₂ z) ∧
    (∀ (Y : Submodule ℂ (HardyElem 2)),
      IsClosedInvariantSubspace Y → Y ≠ ⊥ →
        ∃ (φ : ℂ → ℂ) (hφ : IsInnerFunction φ), Y = innerSubspace φ hφ) := by
  refine ⟨fun hφ ↦ ⟨mulByInner_isometry hPartB hφ,
      (isClosedInvariantSubspace_innerSubspace hPartB hφ).1,
      (isClosedInvariantSubspace_innerSubspace hPartB hφ).2⟩,
    fun hφ₁ hφ₂ ↦ innerSubspace_eq_iff hPartB hφ₁ hφ₂, ?_⟩
  intro Y hY hY_ne
  -- Step 1: `Z := mulZ(Y)` is a closed subspace of `Y`
  let Z : Submodule ℂ (HardyElem 2) := Y.map mulZ.toLinearMap
  have hZ_le_Y : Z ≤ Y := by
    rintro _ ⟨F, hF, rfl⟩
    exact hY.2 F hF
  have hZ_closed : IsClosed (Z : Set (HardyElem 2)) := by
    rw [← isSeqClosed_iff_isClosed]
    intro u w hu hlim
    have hcauchy_u : CauchySeq u := hlim.cauchySeq
    choose y hy_mem hy_eq using hu
    have hy_eq' : ∀ n : ℕ, mulZ (y n) = u n := hy_eq
    have hcauchy_y : CauchySeq y := by
      rw [Metric.cauchySeq_iff] at hcauchy_u ⊢
      intro ε hε
      obtain ⟨N, hN⟩ := hcauchy_u ε hε
      refine ⟨N, fun m hm n hn ↦ ?_⟩
      rw [← mulZ_isometry.dist_eq, hy_eq' m, hy_eq' n]
      exact hN m hm n hn
    obtain ⟨y₀, hy₀_lim⟩ := cauchySeq_tendsto_of_complete hcauchy_y
    have hy₀_mem : y₀ ∈ Y := hY.1.mem_of_tendsto hy₀_lim (Eventually.of_forall hy_mem)
    have hw_eq : mulZ y₀ = w := by
      have hlim2 : Tendsto (fun n ↦ mulZ (y n)) atTop (𝓝 (mulZ y₀)) :=
        mulZ.continuous.tendsto y₀ |>.comp hy₀_lim
      exact tendsto_nhds_unique (hlim2.congr' (Eventually.of_forall hy_eq')) hlim
    exact ⟨y₀, hy₀_mem, hw_eq⟩
  -- Step 2: Find `G₀ ∈ Y \ Z` via minimal Maclaurin order in `Y \ {0}`
  have hex_G₀ : ∃ G₀ ∈ Y, G₀ ∉ Z := by
    classical
    obtain ⟨F₁, hF₁_mem, hF₁_ne⟩ : ∃ F₁ ∈ Y, F₁ ≠ 0 := by
      by_contra hall
      refine hY_ne (eq_bot_iff.mpr fun x hx ↦ ?_)
      by_contra hx0
      exact hall ⟨x, hx, hx0⟩
    have hex_n : ∃ n : ℕ, ∃ G ∈ Y, taylorCoeff G.toFun n ≠ 0 := by
      by_contra hnone
      refine hF₁_ne (coeffEquivH2.symm.injective ?_)
      rw [map_zero]
      ext n
      simp only [coeffEquivH2_symm_apply, lp.coeFn_zero, Pi.zero_apply]
      by_contra hnz
      exact hnone ⟨n, F₁, hF₁_mem, hnz⟩
    let k : ℕ := Nat.find hex_n
    have hk_spec : ∃ G ∈ Y, taylorCoeff G.toFun k ≠ 0 := Nat.find_spec hex_n
    obtain ⟨G₀, hG₀_mem, hG₀_nz⟩ := hk_spec
    refine ⟨G₀, hG₀_mem, fun hG₀_Z ↦ ?_⟩
    obtain ⟨H, hH_mem, hHG₀⟩ := hG₀_Z
    change mulZ H = G₀ at hHG₀
    have hk_eq : taylorCoeff G₀.toFun k = shiftSeq (taylorCoeff H.toFun) k := by
      rw [← hHG₀, taylorCoeff_mulZ]
    rcases hk_def : k with _ | m
    · rw [hk_def] at hk_eq hG₀_nz
      exact hG₀_nz hk_eq
    · have hm_lt : m < Nat.find hex_n := by change m < k; omega
      have hmin := Nat.find_min hex_n hm_lt
      have hHm0 : taylorCoeff H.toFun m = 0 := by
        by_contra hnz
        exact hmin ⟨H, hH_mem, hnz⟩
      rw [hk_def, shiftSeq, hHm0] at hk_eq
      rw [hk_def] at hG₀_nz
      exact hG₀_nz hk_eq
  obtain ⟨G₀, hG₀_Y, hG₀_not_Z⟩ := hex_G₀
  -- Step 3: Project `G₀` onto `Zᗮ` via Rudin 4.11 (`Chapter04.theorem_4_11`) and normalize to `Φ`
  obtain ⟨P_Z, Q_Z, hPQ_Z, _, _, _, _⟩ := RudinRCA.Chapter04.theorem_4_11 Z hZ_closed
  have hQZ_mem_Y : Q_Z G₀ ∈ Y := by
    have hdecomp := (hPQ_Z G₀).2.2
    have hPZ_Y : P_Z G₀ ∈ Y := hZ_le_Y (hPQ_Z G₀).1
    have hsub : Q_Z G₀ = G₀ - P_Z G₀ := eq_sub_of_add_eq' hdecomp.symm
    exact hsub ▸ Y.sub_mem hG₀_Y hPZ_Y
  have hQZ_ne : Q_Z G₀ ≠ 0 := by
    intro h0
    have hdecomp := (hPQ_Z G₀).2.2
    rw [h0, add_zero] at hdecomp
    exact hG₀_not_Z (hdecomp ▸ (hPQ_Z G₀).1)
  let Φ : HardyElem 2 := (‖Q_Z G₀‖ : ℂ)⁻¹ • Q_Z G₀
  have hΦ_Y : Φ ∈ Y := Y.smul_mem _ hQZ_mem_Y
  have hΦ_orth : Φ ∈ Zᗮ := Zᗮ.smul_mem _ (hPQ_Z G₀).2.1
  have hΦ_norm : ‖Φ‖ = 1 := by
    change ‖(‖Q_Z G₀‖ : ℂ)⁻¹ • Q_Z G₀‖ = 1
    rw [norm_smul, norm_inv, Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _),
      inv_mul_cancel₀ (norm_ne_zero_iff.mpr hQZ_ne)]
  -- Step 4: Show `‖Φ*‖ = 1` `circleMeasure`-a.e. via vanishing of all Fourier modes of `‖Φ*‖² - 1`
  obtain ⟨hΦ_rad, hΦ_memLp, _, _, hΦ_poisson⟩ := hPartB.hardy_boundary (by norm_num) Φ.mem_hardy
  let w : FourierCircle → ℂ := fun ζ ↦ ((‖radialBoundaryLimit Φ.toFun ζ‖ ^ 2 - 1 : ℝ) : ℂ)
  have hw_sq_int : Integrable (fun ζ ↦ ‖radialBoundaryLimit Φ.toFun ζ‖ ^ 2) circleMeasure := by
    simpa using hΦ_memLp.integrable_norm_rpow (by norm_num) (by norm_num)
  have hw_int : Integrable w circleMeasure :=
    Complex.ofRealCLM.integrable_comp (hw_sq_int.sub (integrable_const 1))
  have hint_star_trig : ∀ n : ℤ,
      ∫ ζ, star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure =
        if n = 0 then 1 else 0 := by
    intro n
    have hstar : (fun ζ : FourierCircle ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)) =
        fun ζ ↦ fourier (-n) ζ := by
      funext ζ
      simp [RudinRCA.Chapter04.trigMonomial]
    rw [hstar, show circleMeasure = AddCircle.haarAddCircle from rfl,
      RudinRCA.Chapter04.integral_fourier_monomial (-n)]
    simp
  have hw_fourier_zero : ∀ n : ℤ,
      ∫ ζ, w ζ * star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure = 0 := by
    intro n
    have hw_split : ∫ ζ, w ζ * star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure =
        (∫ ζ, ((‖radialBoundaryLimit Φ.toFun ζ‖ ^ 2 : ℝ) : ℂ) *
            star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure) -
          ∫ ζ, star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure := by
      have hi1 : Integrable (fun ζ ↦ ((‖radialBoundaryLimit Φ.toFun ζ‖ ^ 2 : ℝ) : ℂ) *
          star (RudinRCA.Chapter04.trigMonomial n ζ)) circleMeasure :=
        integrable_mul_continuous_circleMeasure
          (Complex.ofRealCLM.integrable_comp hw_sq_int)
          (continuous_star.comp (RudinRCA.Chapter04.trigMonomial n).continuous)
      have hi2 : Integrable (fun ζ ↦ (1 : ℂ) *
          star (RudinRCA.Chapter04.trigMonomial n ζ)) circleMeasure :=
        integrable_mul_continuous_circleMeasure
          (integrable_const (1 : ℂ))
          (continuous_star.comp (RudinRCA.Chapter04.trigMonomial n).continuous)
      have hcongr : (fun ζ ↦ w ζ * star (RudinRCA.Chapter04.trigMonomial n ζ)) =
          fun ζ ↦ ((‖radialBoundaryLimit Φ.toFun ζ‖ ^ 2 : ℝ) : ℂ) *
              star (RudinRCA.Chapter04.trigMonomial n ζ) -
            1 * star (RudinRCA.Chapter04.trigMonomial n ζ) := by
        funext ζ
        dsimp [w]
        push_cast
        ring
      rw [hcongr, integral_sub hi1 hi2]
      simp
    rw [hw_split, hint_star_trig n]
    rcases lt_trichotomy n 0 with hn_neg | rfl | hn_pos
    · obtain ⟨k, hk⟩ : ∃ k : ℕ, n = -((k + 1 : ℕ) : ℤ) := ⟨(-n - 1).toNat, by omega⟩
      subst hk
      have hne0 : (-((k + 1 : ℕ) : ℤ)) ≠ 0 := by omega
      simp only [hne0, ↓reduceIte, sub_zero]
      have hmemZ : (mulZ^[k + 1]) Φ ∈ Z := by
        rw [Function.iterate_succ_apply']
        exact ⟨(mulZ^[k]) Φ, mulZ_iterate_mem_of_invariant hY.2 k hΦ_Y, rfl⟩
      have horth0 : inner ℂ Φ ((mulZ^[k + 1]) Φ) = 0 :=
        (Submodule.mem_orthogonal Z Φ).mp hΦ_orth _ hmemZ |> inner_eq_zero_symm.mp
      rw [inner_eq_boundary_integral hPartB] at horth0
      rw [← horth0]
      refine integral_congr_ae ?_
      filter_upwards [radialBoundaryLimit_mulZ_iterate_ae hPartB (k + 1) Φ] with ζ hmul
      have htrig : star (RudinRCA.Chapter04.trigMonomial (-((k + 1 : ℕ) : ℤ)) ζ) =
          (circlePoint ζ) ^ (k + 1) := by
        rw [star_trigMonomial, neg_neg, trigMonomial_eq_circlePoint_zpow, zpow_natCast]
      rw [hmul, htrig, ← star_mul_self_eq_norm_sq]
      ring
    · simp only [↓reduceIte]
      have hinner1 : inner ℂ Φ Φ = 1 := by
        rw [inner_self_eq_norm_sq_to_K, hΦ_norm]
        simp
      rw [inner_eq_boundary_integral hPartB] at hinner1
      have hlhs1 : (∫ ζ, ((‖radialBoundaryLimit Φ.toFun ζ‖ ^ 2 : ℝ) : ℂ) *
            star (RudinRCA.Chapter04.trigMonomial 0 ζ) ∂circleMeasure) = 1 := by
        rw [← hinner1]
        refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
        dsimp only
        have h0 : star (RudinRCA.Chapter04.trigMonomial 0 ζ) = 1 := by
          rw [star_trigMonomial, neg_zero, trigMonomial_eq_circlePoint_zpow, zpow_zero]
        rw [h0, mul_one, ← star_mul_self_eq_norm_sq]
      rw [hlhs1, sub_self]
    · obtain ⟨k, hk⟩ : ∃ k : ℕ, n = ((k + 1 : ℕ) : ℤ) := ⟨(n - 1).toNat, by omega⟩
      subst hk
      have hne0 : (((k + 1 : ℕ) : ℤ)) ≠ 0 := by omega
      simp only [hne0, ↓reduceIte, sub_zero]
      have hmemZ : (mulZ^[k + 1]) Φ ∈ Z := by
        rw [Function.iterate_succ_apply']
        exact ⟨(mulZ^[k]) Φ, mulZ_iterate_mem_of_invariant hY.2 k hΦ_Y, rfl⟩
      have horth0 : inner ℂ ((mulZ^[k + 1]) Φ) Φ = 0 :=
        (Submodule.mem_orthogonal Z Φ).mp hΦ_orth _ hmemZ
      rw [inner_eq_boundary_integral hPartB] at horth0
      rw [← horth0]
      refine integral_congr_ae ?_
      filter_upwards [radialBoundaryLimit_mulZ_iterate_ae hPartB (k + 1) Φ] with ζ hmul
      have htrig : star (RudinRCA.Chapter04.trigMonomial ((k + 1 : ℕ) : ℤ) ζ) =
          star ((circlePoint ζ) ^ (k + 1)) := by
        rw [trigMonomial_eq_circlePoint_zpow, zpow_natCast]
      rw [hmul, htrig, star_mul, ← star_mul_self_eq_norm_sq]
      ring
  have hw_ae0 := ae_eq_zero_of_forall_integral_trigMonomial_eq_zero hw_int hw_fourier_zero
  have hΦ_bdry_norm1 : ∀ᵐ ζ ∂circleMeasure, ‖radialBoundaryLimit Φ.toFun ζ‖ = 1 := by
    filter_upwards [hw_ae0] with ζ hζ
    have h0 : ((‖radialBoundaryLimit Φ.toFun ζ‖ ^ 2 - 1 : ℝ) : ℂ) = 0 := hζ
    have hre : ‖radialBoundaryLimit Φ.toFun ζ‖ ^ 2 - 1 = 0 := Complex.ofReal_eq_zero.mp h0
    nlinarith [norm_nonneg (radialBoundaryLimit Φ.toFun ζ)]
  -- Step 5: Bound `‖Φ z‖ ≤ 1` on `ball 0 1` via Poisson integral (`hPartB.hardy_boundary`)
  have hΦ_le1 : ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖Φ z‖ ≤ 1 := by
    intro z hz
    rw [hΦ_poisson (by norm_num) z hz]
    calc ‖∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit Φ.toFun ζ
            ∂circleMeasure‖
        ≤ ∫ ζ, ‖_root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit Φ.toFun ζ‖
            ∂circleMeasure := norm_integral_le_integral_norm _
      _ = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂circleMeasure := by
          refine integral_congr_ae ?_
          filter_upwards [hΦ_bdry_norm1] with ζ hζ
          rw [norm_smul, Real.norm_of_nonneg (poissonKernel_circlePoint_nonneg hz ζ), hζ, mul_one]
      _ = 1 := integral_poissonKernel_circlePoint_eq_one hz
  have hΦ_inner : IsInnerFunction Φ.toFun := ⟨Φ.mem_hardy.2.1, hΦ_le1, hΦ_bdry_norm1⟩
  have hmul_one : mulByInner hΦ_inner hardyOne = Φ := by
    apply HardyElem.ext_ball
    intro z hz
    simp [hz]
  -- Step 6: Show `Y = innerSubspace Φ.toFun hΦ_inner`
  refine ⟨Φ.toFun, hΦ_inner, le_antisymm ?_ ?_⟩
  · -- `Y ≤ innerSubspace Φ.toFun hΦ_inner` via orthogonal decomposition and Fourier uniqueness
    have hM_le_Y : innerSubspace Φ.toFun hΦ_inner ≤ Y := by
      rintro _ ⟨G, rfl⟩
      have hlim := (mulByInner hΦ_inner).continuous.tendsto G |>.comp
        (tendsto_sum_taylorCoeff_mulZ_hardyOne G)
      refine hY.1.mem_of_tendsto hlim (Eventually.of_forall fun N ↦ ?_)
      change mulByInner hΦ_inner (∑ n ∈ Finset.range N, taylorCoeff G.toFun n • (mulZ^[n]) hardyOne) ∈ Y
      rw [map_sum]
      refine Y.sum_mem fun n _ ↦ ?_
      rw [map_smul, ← mulZ_iterate_mulByInner, hmul_one]
      exact Y.smul_mem _ (mulZ_iterate_mem_of_invariant hY.2 n hΦ_Y)
    have hM_closed := (isClosedInvariantSubspace_innerSubspace hPartB hΦ_inner).1.1
    obtain ⟨P_M, Q_M, hPQ_M, _, _, _, _⟩ :=
      RudinRCA.Chapter04.theorem_4_11 (innerSubspace Φ.toFun hΦ_inner) hM_closed
    intro F hF_Y
    let R : HardyElem 2 := Q_M F
    have hR_orth : R ∈ (innerSubspace Φ.toFun hΦ_inner)ᗮ := (hPQ_M F).2.1
    have hR_Y : R ∈ Y := by
      have hdecomp := (hPQ_M F).2.2
      have hsub : R = F - P_M F := eq_sub_of_add_eq' hdecomp.symm
      exact hsub ▸ Y.sub_mem hF_Y (hM_le_Y (hPQ_M F).1)
    obtain ⟨_, hR_memLp, hR_eLp, _, _⟩ := hPartB.hardy_boundary (by norm_num) R.mem_hardy
    let g : FourierCircle → ℂ :=
      fun ζ ↦ star (radialBoundaryLimit R.toFun ζ) * radialBoundaryLimit Φ.toFun ζ
    have hg_int : Integrable g circleMeasure := by
      have hR_int : Integrable (radialBoundaryLimit R.toFun) circleMeasure :=
        hR_memLp.integrable (by norm_num)
      refine hR_int.norm.mono'
        (hR_memLp.aestronglyMeasurable.star.mul hΦ_memLp.aestronglyMeasurable) ?_
      filter_upwards [hΦ_bdry_norm1] with ζ hζ
      simp [g, hζ]
    have hg_fourier : ∀ n : ℤ,
        ∫ ζ, g ζ * star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure = 0 := by
      intro n
      rcases le_or_gt n 0 with hn_le | hn_gt
      · obtain ⟨k, rfl⟩ : ∃ k : ℕ, n = -(k : ℤ) := ⟨(-n).toNat, by omega⟩
        have hmemM : (mulZ^[k]) Φ ∈ innerSubspace Φ.toFun hΦ_inner :=
          ⟨(mulZ^[k]) hardyOne, by
            change mulByInner hΦ_inner ((mulZ^[k]) hardyOne) = (mulZ^[k]) Φ
            rw [← mulZ_iterate_mulByInner, hmul_one]⟩
        have horth0 : inner ℂ R ((mulZ^[k]) Φ) = 0 :=
          (Submodule.mem_orthogonal _ R).mp hR_orth _ hmemM |> inner_eq_zero_symm.mp
        rw [inner_eq_boundary_integral hPartB] at horth0
        rw [← horth0]
        refine integral_congr_ae ?_
        filter_upwards [radialBoundaryLimit_mulZ_iterate_ae hPartB k Φ] with ζ hmul
        have htrig : star (RudinRCA.Chapter04.trigMonomial (-(k : ℤ)) ζ) = (circlePoint ζ) ^ k := by
          rw [star_trigMonomial, neg_neg, trigMonomial_eq_circlePoint_zpow, zpow_natCast]
        change star (radialBoundaryLimit R.toFun ζ) * radialBoundaryLimit Φ.toFun ζ *
            star (RudinRCA.Chapter04.trigMonomial (-(k : ℤ)) ζ) =
          star (radialBoundaryLimit R.toFun ζ) * radialBoundaryLimit ((mulZ^[k]) Φ).toFun ζ
        rw [hmul, htrig]
        ring
      · obtain ⟨k, rfl⟩ : ∃ k : ℕ, n = ((k + 1 : ℕ) : ℤ) := ⟨(n - 1).toNat, by omega⟩
        have hmemZ : (mulZ^[k + 1]) R ∈ Z := by
          rw [Function.iterate_succ_apply']
          exact ⟨(mulZ^[k]) R, mulZ_iterate_mem_of_invariant hY.2 k hR_Y, rfl⟩
        have horth0 : inner ℂ ((mulZ^[k + 1]) R) Φ = 0 :=
          (Submodule.mem_orthogonal Z Φ).mp hΦ_orth _ hmemZ
        rw [inner_eq_boundary_integral hPartB] at horth0
        rw [← horth0]
        refine integral_congr_ae ?_
        filter_upwards [radialBoundaryLimit_mulZ_iterate_ae hPartB (k + 1) R] with ζ hmul
        have htrig : star (RudinRCA.Chapter04.trigMonomial ((k + 1 : ℕ) : ℤ) ζ) =
            star ((circlePoint ζ) ^ (k + 1)) := by
          rw [trigMonomial_eq_circlePoint_zpow, zpow_natCast]
        change star (radialBoundaryLimit R.toFun ζ) * radialBoundaryLimit Φ.toFun ζ *
            star (RudinRCA.Chapter04.trigMonomial ((k + 1 : ℕ) : ℤ) ζ) =
          star (radialBoundaryLimit ((mulZ^[k + 1]) R).toFun ζ) * radialBoundaryLimit Φ.toFun ζ
        rw [hmul, htrig, star_mul]
        ring
    have hg_ae0 := ae_eq_zero_of_forall_integral_trigMonomial_eq_zero hg_int hg_fourier
    have hR_ae0 : radialBoundaryLimit R.toFun =ᵐ[circleMeasure] 0 := by
      filter_upwards [hg_ae0, hΦ_bdry_norm1] with ζ hg0 hΦ1
      have hg0' : star (radialBoundaryLimit R.toFun ζ) * radialBoundaryLimit Φ.toFun ζ = 0 := hg0
      show radialBoundaryLimit R.toFun ζ = 0
      rcases mul_eq_zero.mp hg0' with hR0 | hΦ0
      · exact star_eq_zero.mp hR0
      · exfalso
        rw [hΦ0, norm_zero] at hΦ1
        exact zero_ne_one hΦ1
    have hR_ENN0 : hardySizeENNReal 2 R.toFun = 0 := by
      rw [← hR_eLp, eLpNorm_congr_ae hR_ae0, eLpNorm_zero]
    have hR_zero : R = 0 := by
      refine norm_eq_zero.mp ?_
      rw [HardyElem.norm_def, hardySize, hR_ENN0, ENNReal.toReal_zero]
    have hdecomp := (hPQ_M F).2.2
    change F = P_M F + R at hdecomp
    rw [hR_zero, add_zero] at hdecomp
    exact hdecomp ▸ (hPQ_M F).1
  · -- `innerSubspace Φ.toFun hΦ_inner ≤ Y`
    rintro _ ⟨G, rfl⟩
    have hlim := (mulByInner hΦ_inner).continuous.tendsto G |>.comp
      (tendsto_sum_taylorCoeff_mulZ_hardyOne G)
    refine hY.1.mem_of_tendsto hlim (Eventually.of_forall fun N ↦ ?_)
    change mulByInner hΦ_inner (∑ n ∈ Finset.range N, taylorCoeff G.toFun n • (mulZ^[n]) hardyOne) ∈ Y
    rw [map_sum]
    refine Y.sum_mem fun n _ ↦ ?_
    rw [map_smul, ← mulZ_iterate_mulByInner, hmul_one]
    exact Y.smul_mem _ (mulZ_iterate_mem_of_invariant hY.2 n hΦ_Y)

/-! ### Section 17.22: Classification of Nonzero Closed Invariant Subspaces by `(B, μ)` (RCA p. 349) -/

private theorem circleMeasure_singleton (ζ₀ : FourierCircle) :
    circleMeasure {ζ₀} = 0 := by
  have h0 : circleMeasure {(0 : FourierCircle)} = 0 := by
    have hae := ae_circleMeasure_ne_zero
    rw [ae_iff] at hae
    convert hae using 2
    ext ζ
    simp
  have hpre : (fun x : FourierCircle ↦ ζ₀ + x) ⁻¹' {ζ₀} = {(0 : FourierCircle)} := by
    ext x
    simp
  have hinv : circleMeasure ((fun x : FourierCircle ↦ ζ₀ + x) ⁻¹' {ζ₀}) =
      circleMeasure {ζ₀} :=
    show AddCircle.haarAddCircle ((fun x : FourierCircle ↦ ζ₀ + x) ⁻¹' {ζ₀}) =
      AddCircle.haarAddCircle {ζ₀} from
      measure_preimage_add AddCircle.haarAddCircle ζ₀ {ζ₀}
  rw [← hinv, hpre, h0]

private theorem circlePoint_injective : Function.Injective circlePoint :=
  fun _ _ h ↦ fourierCircleHomeomorphism.injective (Subtype.ext h)

private theorem blaschke_radial_log_props {B : ℂ → ℂ}
    (hB : RudinRCA.Chapter15.IsBlaschkeProduct B) :
    (∀ r ∈ Set.Ioo (0 : ℝ) 1, ∀ᵐ ζ ∂circleMeasure, B ((r : ℂ) * circlePoint ζ) ≠ 0) ∧
    (∀ r ∈ Set.Ioo (0 : ℝ) 1,
      Integrable (fun ζ ↦ Real.log ‖B ((r : ℂ) * circlePoint ζ)‖) circleMeasure) ∧
    Tendsto (fun r : ℝ ↦ ∫ ζ, Real.log ‖B ((r : ℂ) * circlePoint ζ)‖ ∂circleMeasure)
      (𝓝[<] (1 : ℝ)) (𝓝 0) := by
  have hB_inner := isInnerFunction_of_isBlaschkeProduct hB
  have hcnt_zeros : {w ∈ Metric.ball (0 : ℂ) 1 | B w = 0}.Countable := by
    rcases hB with ⟨k, N, a, ha, hBeq⟩ | ⟨k, a, ha, hsum, hBeq⟩
    · have hfin := RudinRCA.Chapter15.finite_blaschke_product k N a ha
      refine ((Set.countable_singleton (0 : ℂ)).union (Set.countable_range a)).mono ?_
      rintro w ⟨hw, hBw⟩
      rw [hBeq w hw] at hBw
      rcases (hfin.2.2.2.2.2.1 w hw).mp hBw with ⟨rfl, _⟩ | ⟨i, rfl⟩
      · exact Or.inl rfl
      · exact Or.inr ⟨i, rfl⟩
    · have hinf := RudinRCA.Chapter15.theorem15_21 k ha hsum
      refine ((Set.countable_singleton (0 : ℂ)).union (Set.countable_range a)).mono ?_
      rintro w ⟨hw, hBw⟩
      rw [hBeq w hw] at hBw
      rcases (hinf.2.2.2.2.2.2.2.1 w hw).mp hBw with ⟨rfl, _⟩ | ⟨n, rfl⟩
      · exact Or.inl rfl
      · exact Or.inr ⟨n, rfl⟩
  refine ⟨fun r hr ↦ ?_, fun r hr ↦ ?_, ?_⟩
  · let φ_r : FourierCircle → ℂ := fun ζ ↦ (r : ℂ) * circlePoint ζ
    have hφ_inj : Function.Injective φ_r := fun ζ₁ ζ₂ h ↦
      circlePoint_injective (mul_left_cancel₀ (Complex.ofReal_ne_zero.mpr hr.1.ne') h)
    let S_r : Set FourierCircle := φ_r ⁻¹' {w ∈ Metric.ball (0 : ℂ) 1 | B w = 0}
    have hcnt_pre : S_r.Countable := hcnt_zeros.preimage hφ_inj
    have hSr_null : circleMeasure S_r = 0 := by
      rw [← Set.biUnion_of_singleton S_r]
      exact (measure_biUnion_null_iff hcnt_pre).mpr fun x _ ↦ circleMeasure_singleton x
    rw [ae_iff]
    refine measure_mono_null (fun ζ hζ ↦ ?_) hSr_null
    have hBz0 : B (φ_r ζ) = 0 := of_not_not hζ
    refine ⟨?_, hBz0⟩
    simpa [φ_r, Metric.mem_ball, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr.1] using hr.2
  · have hana_B : AnalyticOnNhd ℂ B (Metric.ball (0 : ℂ) 1) :=
      ((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hB_inner.1).analyticOnNhd
        Metric.isOpen_ball
    have hsub : Metric.sphere (0 : ℂ) |r| ⊆ Metric.ball (0 : ℂ) 1 := by
      rw [abs_of_pos hr.1]
      exact Metric.sphere_subset_closedBall.trans (Metric.closedBall_subset_ball hr.2)
    have hcint : CircleIntegrable (fun ξ ↦ Real.log ‖B ξ‖) 0 r :=
      (hana_B.mono hsub).meromorphicOn.circleIntegrable_log_norm
    let G : FourierCircle → ℝ := fun ζ ↦ Real.log ‖B ((r : ℂ) * circlePoint ζ)‖
    have hG_meas : Measurable G :=
      Real.measurable_log.comp
        ((continuous_radialSlice_of_holomorphicOn hB_inner.1 hr.1.le hr.2).norm.measurable)
    have hint_Ioc : IntegrableOn (fun θ : ℝ ↦ G (θ : FourierCircle))
        (Set.Ioc 0 (0 + 2 * Real.pi)) MeasureTheory.volume := by
      rw [zero_add]
      refine hcint.1.congr_fun (fun θ _ ↦ ?_) measurableSet_Ioc
      simp [G, circleMap]
    have hmp := AddCircle.measurePreserving_mk (2 * Real.pi) 0
    have hG_vol : Integrable G (MeasureTheory.volume : Measure FourierCircle) :=
      (hmp.integrable_comp hG_meas.aestronglyMeasurable).mp hint_Ioc
    rw [AddCircle.volume_eq_smul_haarAddCircle] at hG_vol
    have hsmul := hG_vol.smul_measure (c := (ENNReal.ofReal (2 * Real.pi))⁻¹)
      (ENNReal.inv_ne_top.mpr (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne')
    rwa [smul_smul, ENNReal.inv_mul_cancel (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne'
      ENNReal.ofReal_ne_top, one_smul] at hsmul
  · have hlim := (RudinRCA.Chapter15.theorem15_24 hB).1.1
    refine hlim.congr fun r ↦ ?_
    exact (integral_radialSlice_eq_circleAverage (fun ξ : ℂ ↦ Real.log ‖B ξ‖) r).symm

private theorem blaschke_origin_factor {B : ℂ → ℂ}
    (hB : RudinRCA.Chapter15.IsBlaschkeProduct B) :
    ∃ (k : ℕ) (P : ℂ → ℂ) (r₀ : ℝ),
      0 < r₀ ∧
      HolomorphicOn P (Metric.ball (0 : ℂ) 1) ∧
      P 0 = (r₀ : ℂ) ∧
      ∀ z ∈ Metric.ball (0 : ℂ) 1, B z = z ^ k * P z := by
  rcases hB with ⟨k, N, a, ha, hBeq⟩ | ⟨k, a, ha, hsum, hBeq⟩
  · let P : ℂ → ℂ := fun z ↦ ∏ i : Fin N, RudinRCA.Chapter15.blaschkeFactor (a i) z
    let r₀ : ℝ := ∏ i : Fin N, ‖a i‖
    have hr₀_pos : 0 < r₀ := Finset.prod_pos fun i _ ↦ norm_pos_iff.mpr (ha i).2
    have hfin0 := RudinRCA.Chapter15.finite_blaschke_product 0 N a ha
    have hP_holo : HolomorphicOn P (Metric.ball (0 : ℂ) 1) := by
      have hd : DifferentiableOn ℂ P (Metric.ball (0 : ℂ) 1) := by
        simpa [P] using hfin0.2.2.1
      exact (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hd
    have hP0 : P 0 = (r₀ : ℂ) := by
      simp only [P, r₀, Complex.ofReal_prod]
      exact Finset.prod_congr rfl fun i _ ↦ RudinRCA.Chapter15.blaschkeFactor_zero (ha i).2
    exact ⟨k, P, r₀, hr₀_pos, hP_holo, hP0, hBeq⟩
  · have hinf := RudinRCA.Chapter15.theorem15_21 k ha hsum
    let P : ℂ → ℂ := fun z ↦ ∏' n, RudinRCA.Chapter15.blaschkeFactor (a n) z
    have hP_holo : HolomorphicOn P (Metric.ball (0 : ℂ) 1) :=
      (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hinf.2.2.2.1
    have hP0_ne : P 0 ≠ 0 := hinf.2.2.2.2.2.2.1
    have hlim0 : Tendsto (fun N ↦ ∏ n ∈ Finset.range N,
        RudinRCA.Chapter15.blaschkeFactor (a n) 0) atTop (𝓝 (P 0)) :=
      hinf.2.1.tendsto_at (Metric.mem_ball_self zero_lt_one)
    have hpart_eq : ∀ N : ℕ, (∏ n ∈ Finset.range N,
        RudinRCA.Chapter15.blaschkeFactor (a n) 0) =
        ((∏ n ∈ Finset.range N, ‖a n‖ : ℝ) : ℂ) := fun N ↦ by
      rw [Complex.ofReal_prod]
      exact Finset.prod_congr rfl fun n _ ↦ RudinRCA.Chapter15.blaschkeFactor_zero (ha n).2
    have him_lim : Tendsto (fun N : ℕ ↦ ((∏ n ∈ Finset.range N,
        RudinRCA.Chapter15.blaschkeFactor (a n) 0)).im) atTop (𝓝 (P 0).im) :=
      (Complex.continuous_im.tendsto (P 0)).comp hlim0
    have him0 : (P 0).im = 0 := by
      refine tendsto_nhds_unique him_lim ?_
      refine tendsto_const_nhds.congr fun N ↦ ?_
      rw [hpart_eq N, Complex.ofReal_im]
    have hre_lim : Tendsto (fun N : ℕ ↦ ((∏ n ∈ Finset.range N,
        RudinRCA.Chapter15.blaschkeFactor (a n) 0)).re) atTop (𝓝 (P 0).re) :=
      (Complex.continuous_re.tendsto (P 0)).comp hlim0
    have hre_nn : 0 ≤ (P 0).re := by
      refine ge_of_tendsto hre_lim (Eventually.of_forall fun N ↦ ?_)
      rw [hpart_eq N, Complex.ofReal_re]
      exact Finset.prod_nonneg fun _ _ ↦ norm_nonneg _
    have hP0_eq : P 0 = ((P 0).re : ℂ) := by
      apply Complex.ext
      · simp
      · simp [him0]
    have hre_ne : (P 0).re ≠ 0 := fun h0 ↦ hP0_ne (by rw [hP0_eq, h0, Complex.ofReal_zero])
    exact ⟨k, P, (P 0).re, lt_of_le_of_ne hre_nn hre_ne.symm, hP_holo, hP0_eq, hBeq⟩

private theorem poisson_trigMonomial_half (m : ℕ) (η : FourierCircle) :
    ∫ ζ, _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint η) (circlePoint ζ) •
        RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ ∂circleMeasure =
      ((1 / 2 : ℝ) ^ m : ℂ) * RudinRCA.Chapter04.trigMonomial (m : ℤ) η := by
  let z : ℂ := (1 / 2 : ℂ) * circlePoint η
  have hz : z ∈ Metric.ball (0 : ℂ) 1 := by
    simpa [z, Metric.mem_ball] using (by norm_num : (1 / 2 : ℝ) < 1)
  have hdcc : DiffContOnCl ℂ (fun ξ : ℂ ↦ ξ ^ m) (Metric.ball (0 : ℂ) 1) :=
    ⟨(differentiable_id.pow m).differentiableOn, (continuous_id.pow m).continuousOn⟩
  have hpif := hdcc.circleAverage_poissonKernel_smul hz
  have hca := integral_radialSlice_eq_circleAverage
    (fun ξ : ℂ ↦ _root_.poissonKernel 0 z ξ • ξ ^ m) 1
  simp only [Complex.ofReal_one, one_mul] at hca
  calc ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) •
          RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ ∂circleMeasure
      = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • (circlePoint ζ) ^ m ∂circleMeasure := by
          refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
          dsimp only
          rw [trigMonomial_eq_circlePoint_zpow, zpow_natCast]
    _ = Real.circleAverage (_root_.poissonKernel 0 z • fun ξ : ℂ ↦ ξ ^ m) 0 1 := hca
    _ = z ^ m := hpif
    _ = ((1 / 2 : ℝ) ^ m : ℂ) * RudinRCA.Chapter04.trigMonomial (m : ℤ) η := by
          dsimp only [z]
          rw [mul_pow, trigMonomial_eq_circlePoint_zpow, zpow_natCast]
          push_cast
          rfl

private theorem eq_of_poissonIntegral_eq_on_ball
    (μ₁ μ₂ : Measure FourierCircle) [IsFiniteMeasure μ₁] [IsFiniteMeasure μ₂]
    (hP_eq : ∀ z ∈ Metric.ball (0 : ℂ) 1,
      (∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂μ₁) =
        ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂μ₂) :
    μ₁ = μ₂ := by
  -- Step 1: Equal integrals on `trigMonomial (m : ℤ)` for all `m : ℕ` via Fubini at `r = 1 / 2`
  have hmono_nat : ∀ m : ℕ,
      (∫ η, RudinRCA.Chapter04.trigMonomial (m : ℤ) η ∂μ₁) =
        ∫ η, RudinRCA.Chapter04.trigMonomial (m : ℤ) η ∂μ₂ := by
    intro m
    let K : FourierCircle → FourierCircle → ℂ := fun η ζ ↦
      _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint η) (circlePoint ζ) •
        RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ
    have hK_cont : Continuous (Function.uncurry K) := by
      have hp_cont : Continuous (fun p : FourierCircle × FourierCircle ↦
          _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint p.1) (circlePoint p.2)) := by
        have hform : (fun p : FourierCircle × FourierCircle ↦
            _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint p.1) (circlePoint p.2)) =
            fun p ↦ (1 - ‖(1 / 2 : ℂ) * circlePoint p.1‖ ^ 2) /
              ‖circlePoint p.2 - (1 / 2 : ℂ) * circlePoint p.1‖ ^ 2 := by
          ext p
          exact poissonKernel_circlePoint_formula _ _
        rw [hform]
        refine Continuous.div (by fun_prop) (by fun_prop) fun p ↦ ?_
        have htri : (1 / 2 : ℝ) ≤ ‖circlePoint p.2 - (1 / 2 : ℂ) * circlePoint p.1‖ := by
          have h1 := norm_sub_norm_le (circlePoint p.2) ((1 / 2 : ℂ) * circlePoint p.1)
          have hn1 : ‖circlePoint p.2‖ = 1 := norm_circlePoint p.2
          have hn2 : ‖(1 / 2 : ℂ) * circlePoint p.1‖ = 1 / 2 := by simp
          linarith
        exact (pow_pos (lt_of_lt_of_le (by norm_num : (0 : ℝ) < 1 / 2) htri) 2).ne'
      exact hp_cont.smul ((RudinRCA.Chapter04.trigMonomial (m : ℤ)).continuous.comp continuous_snd)
    obtain ⟨B_K, hB_K⟩ := isCompact_univ.exists_bound_of_continuousOn hK_cont.continuousOn
    have hfub : ∀ (ν : Measure FourierCircle) [IsFiniteMeasure ν],
        ((1 / 2 : ℝ) ^ m : ℂ) * (∫ η, RudinRCA.Chapter04.trigMonomial (m : ℤ) η ∂ν) =
          ∫ ζ, ((∫ η, _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint ζ) (circlePoint η) ∂ν : ℝ) : ℂ) *
            RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ ∂circleMeasure := by
      intro ν hν
      have hint_prod : Integrable (Function.uncurry K) (ν.prod circleMeasure) :=
        Integrable.of_bound hK_cont.aestronglyMeasurable B_K
          (Eventually.of_forall fun p ↦ hB_K p (mem_univ p))
      have hswap := integral_integral_swap hint_prod
      have hlhs : (∫ η, ∫ ζ, K η ζ ∂circleMeasure ∂ν) =
          ((1 / 2 : ℝ) ^ m : ℂ) * ∫ η, RudinRCA.Chapter04.trigMonomial (m : ℤ) η ∂ν := by
        simp_rw [K, poisson_trigMonomial_half m, integral_const_mul]
      have hrhs : (∫ ζ, ∫ η, K η ζ ∂ν ∂circleMeasure) =
          ∫ ζ, ((∫ η, _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint ζ) (circlePoint η) ∂ν : ℝ) : ℂ) *
            RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ ∂circleMeasure := by
        refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
        dsimp only
        have hhz : (1 / 2 : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
          simpa [Metric.mem_ball] using (by norm_num : (1 / 2 : ℝ) < 1)
        have hp_c := continuous_poissonKernel_circlePoint hhz
        obtain ⟨Bp, hBp⟩ := isCompact_univ.exists_bound_of_continuousOn hp_c.continuousOn
        have hp_int : Integrable (fun η ↦ _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint ζ)
            (circlePoint η)) ν :=
          Integrable.of_bound hp_c.aestronglyMeasurable Bp
            (Eventually.of_forall fun η ↦ hBp η (mem_univ η))
        have hhalf : (1 / 2 : ℂ) = ((1 / 2 : ℝ) : ℂ) := by norm_num
        have hcongr_η : (fun η ↦ K η ζ) =
            fun η ↦ ((_root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint ζ) (circlePoint η) : ℝ) : ℂ) *
              RudinRCA.Chapter04.trigMonomial (m : ℤ) ζ := by
          ext η
          dsimp only [K]
          rw [hhalf, poissonKernel_circlePoint_symm (1 / 2) η ζ, Complex.real_smul]
        have hcomm :
            (∫ η, ((_root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint ζ) (circlePoint η) : ℝ) : ℂ) ∂ν) =
              ((∫ η, _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint ζ) (circlePoint η) ∂ν : ℝ) : ℂ) :=
          Complex.ofRealCLM.integral_comp_comm hp_int
        rw [hcongr_η, integral_mul_const, hcomm]
      exact hlhs.symm.trans (hswap.trans hrhs)
    have heq_mul : ((1 / 2 : ℝ) ^ m : ℂ) * (∫ η, RudinRCA.Chapter04.trigMonomial (m : ℤ) η ∂μ₁) =
        ((1 / 2 : ℝ) ^ m : ℂ) * (∫ η, RudinRCA.Chapter04.trigMonomial (m : ℤ) η ∂μ₂) := by
      rw [hfub μ₁, hfub μ₂]
      refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
      dsimp only
      have hhz : (1 / 2 : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
        simpa [Metric.mem_ball] using (by norm_num : (1 / 2 : ℝ) < 1)
      have hPz : (∫ η, _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint ζ) (circlePoint η) ∂μ₁) =
          ∫ η, _root_.poissonKernel 0 ((1 / 2 : ℂ) * circlePoint ζ) (circlePoint η) ∂μ₂ :=
        hP_eq _ hhz
      rw [hPz]
    have hpow_ne : ((1 / 2 : ℝ) ^ m : ℂ) ≠ 0 := pow_ne_zero m (by norm_num)
    exact mul_left_cancel₀ hpow_ne heq_mul
  -- Step 2: Extend to all `n : ℤ` via conjugation
  have hmono_int : ∀ n : ℤ,
      (∫ η, RudinRCA.Chapter04.trigMonomial n η ∂μ₁) =
        ∫ η, RudinRCA.Chapter04.trigMonomial n η ∂μ₂ := by
    intro n
    rcases le_or_gt 0 n with hn | hn
    · obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = (m : ℤ) := ⟨n.toNat, by omega⟩
      exact hmono_nat m
    · obtain ⟨m, rfl⟩ : ∃ m : ℕ, n = -(m : ℤ) := ⟨(-n).toNat, by omega⟩
      have hstar_eq : (fun η : FourierCircle ↦ RudinRCA.Chapter04.trigMonomial (-(m : ℤ)) η) =
          fun η ↦ starRingEnd ℂ (RudinRCA.Chapter04.trigMonomial (m : ℤ) η) := by
        ext η
        exact (star_trigMonomial (m : ℤ) η).symm
      rw [hstar_eq, integral_conj, integral_conj, hmono_nat m]
  -- Step 3: Extend to trigonometric polynomials and uniform limits in `C(FourierCircle, ℂ)`
  have hcont_int : ∀ (ν : Measure FourierCircle) [IsFiniteMeasure ν] (h : C(FourierCircle, ℂ)),
      Integrable h ν := by
    intro ν hν h
    obtain ⟨Bh, hBh⟩ := isCompact_univ.exists_bound_of_continuousOn h.continuous.continuousOn
    exact Integrable.of_bound h.continuous.aestronglyMeasurable Bh
      (Eventually.of_forall fun η ↦ hBh η (mem_univ η))
  have hpoly : ∀ c : ℤ →₀ ℂ,
      (∫ η, RudinRCA.Chapter04.trigPolynomial c η ∂μ₁) =
        ∫ η, RudinRCA.Chapter04.trigPolynomial c η ∂μ₂ := by
    intro c
    have hexpand : ∀ (ν : Measure FourierCircle) [IsFiniteMeasure ν],
        (∫ η, RudinRCA.Chapter04.trigPolynomial c η ∂ν) =
          ∑ n ∈ c.support, c n * ∫ η, RudinRCA.Chapter04.trigMonomial n η ∂ν := by
      intro ν hν
      have hfn : (fun η ↦ RudinRCA.Chapter04.trigPolynomial c η) =
          fun η ↦ ∑ n ∈ c.support, c n * RudinRCA.Chapter04.trigMonomial n η := by
        ext η
        simp [RudinRCA.Chapter04.trigPolynomial, Finsupp.sum]
      rw [hfn, integral_finsetSum]
      · exact Finset.sum_congr rfl fun n _ ↦ integral_const_mul (c n) _
      · intro n _
        exact (hcont_int ν (RudinRCA.Chapter04.trigMonomial n)).const_mul (c n)
    rw [hexpand μ₁, hexpand μ₂]
    exact Finset.sum_congr rfl fun n _ ↦ by rw [hmono_int n]
  have hcont_eq : ∀ h : C(FourierCircle, ℂ), (∫ η, h η ∂μ₁) = ∫ η, h η ∂μ₂ := by
    intro h
    apply sub_eq_zero.mp
    rw [← norm_le_zero_iff]
    refine le_of_forall_pos_le_add fun δ hδ ↦ ?_
    rw [zero_add]
    let M : ℝ := μ₁.real Set.univ + μ₂.real Set.univ + 1
    have hM_pos : 0 < M := by
      dsimp [M]
      linarith [ @measureReal_nonneg _ _ μ₁ Set.univ, @measureReal_nonneg _ _ μ₂ Set.univ]
    obtain ⟨c, hc⟩ := RudinRCA.Chapter04.uniform_trigonometric_approximation h (δ / M)
      (div_pos hδ hM_pos)
    have hsub_eq : (∫ η, h η ∂μ₁) - (∫ η, h η ∂μ₂) =
        (∫ η, (h - RudinRCA.Chapter04.trigPolynomial c) η ∂μ₁) -
          (∫ η, (h - RudinRCA.Chapter04.trigPolynomial c) η ∂μ₂) := by
      have hi1 := integral_sub (hcont_int μ₁ h) (hcont_int μ₁ (RudinRCA.Chapter04.trigPolynomial c))
      have hi2 := integral_sub (hcont_int μ₂ h) (hcont_int μ₂ (RudinRCA.Chapter04.trigPolynomial c))
      change _ = (∫ η, (h η - RudinRCA.Chapter04.trigPolynomial c η) ∂μ₁) -
        (∫ η, (h η - RudinRCA.Chapter04.trigPolynomial c η) ∂μ₂)
      rw [hi1, hi2, hpoly c]
      ring
    have hbound : ∀ (ν : Measure FourierCircle) [IsFiniteMeasure ν],
        ‖∫ η, (h - RudinRCA.Chapter04.trigPolynomial c) η ∂ν‖ ≤
          (δ / M) * ν.real Set.univ := by
      intro ν hν
      calc ‖∫ η, (h - RudinRCA.Chapter04.trigPolynomial c) η ∂ν‖
          ≤ ∫ η, ‖(h - RudinRCA.Chapter04.trigPolynomial c) η‖ ∂ν :=
            norm_integral_le_integral_norm _
        _ ≤ ∫ _, (δ / M) ∂ν := by
            refine integral_mono (hcont_int ν (h - RudinRCA.Chapter04.trigPolynomial c)).norm
              (integrable_const _) fun η ↦ ?_
            exact ((h - RudinRCA.Chapter04.trigPolynomial c).norm_coe_le_norm η).trans hc.le
        _ = (δ / M) * ν.real Set.univ := by
            rw [integral_const, smul_eq_mul, mul_comm]
    rw [hsub_eq]
    calc ‖(∫ η, (h - RudinRCA.Chapter04.trigPolynomial c) η ∂μ₁) -
            (∫ η, (h - RudinRCA.Chapter04.trigPolynomial c) η ∂μ₂)‖
        ≤ ‖∫ η, (h - RudinRCA.Chapter04.trigPolynomial c) η ∂μ₁‖ +
            ‖∫ η, (h - RudinRCA.Chapter04.trigPolynomial c) η ∂μ₂‖ := norm_sub_le _ _
      _ ≤ (δ / M) * μ₁.real Set.univ + (δ / M) * μ₂.real Set.univ :=
          add_le_add (hbound μ₁) (hbound μ₂)
      _ = (δ / M) * (μ₁.real Set.univ + μ₂.real Set.univ) := by ring
      _ ≤ (δ / M) * M := by
          refine mul_le_mul_of_nonneg_left ?_ (div_pos hδ hM_pos).le
          dsimp [M]; linarith
      _ = δ := div_mul_cancel₀ δ hM_pos.ne'
  -- Step 4: Conclude `μ₁ = μ₂` by `Measure.ext_of_integral_eq_on_compactlySupported`
  refine Measure.ext_of_integral_eq_on_compactlySupported fun f ↦ ?_
  let fC : C(FourierCircle, ℂ) :=
    ⟨fun η ↦ (f η : ℂ), Complex.continuous_ofReal.comp f.continuous⟩
  have hf1 : Integrable (fun η ↦ f η) μ₁ := by
    simpa [fC] using Complex.reCLM.integrable_comp (hcont_int μ₁ fC)
  have hf2 : Integrable (fun η ↦ f η) μ₂ := by
    simpa [fC] using Complex.reCLM.integrable_comp (hcont_int μ₂ fC)
  have h1 : ((∫ η, f η ∂μ₁ : ℝ) : ℂ) = ∫ η, (f η : ℂ) ∂μ₁ :=
    (Complex.ofRealCLM.integral_comp_comm hf1).symm
  have h2 : ((∫ η, f η ∂μ₂ : ℝ) : ℂ) = ∫ η, (f η : ℂ) ∂μ₂ :=
    (Complex.ofRealCLM.integral_comp_comm hf2).symm
  have heqC : ((∫ η, f η ∂μ₁ : ℝ) : ℂ) = ((∫ η, f η ∂μ₂ : ℝ) : ℂ) := by
    rw [h1, h2]
    exact hcont_eq fC
  exact Complex.ofReal_injective heqC

/-- **17.22 (Classification of Nonzero Closed Invariant Subspaces of `H²` by `(B, μ)`,
RCA p. 349):**
1. The zero subspace `⊥` of `H²` is a closed `mulZ`-invariant subspace (the explicit exception
   inherited from Beurling's theorem `17.21`).
2. Every Blaschke product `B` (`IsBlaschkeProduct B`) and every finite positive Borel measure `μ`
   on `T` mutually singular with respect to `circleMeasure` (`μ ⟂ₘ circleMeasure`) determine a
   **nonzero** closed `mulZ`-invariant subspace `(B · S_μ) H²` of `H²`.
3. Every **nonzero** closed `mulZ`-invariant subspace `Y` of `H²` (`Y ≠ ⊥`) is of this form for a
   Blaschke product `B` and a finite singular measure `μ` (`μ ⟂ₘ circleMeasure`).
4. **Uniqueness:** Two such pairs `(B₁, μ₁)` and `(B₂, μ₂)` generate the same subspace of `H²` if
   and only if `μ₁ = μ₂` and `B₁ = B₂` throughout `U = Metric.ball 0 1` (in particular, `B₁` and
   `B₂` have identical zero multiplicities `analyticOrderNatAt B₁ z = analyticOrderNatAt B₂ z` at
   every point `z ∈ U`). -/
theorem theorem17_22 (hPartB : HardyPartBInterface) :
    IsClosedInvariantSubspace (⊥ : Submodule ℂ (HardyElem 2)) ∧
    (∀ (B : ℂ → ℂ) (μ : Measure FourierCircle)
      (hB : RudinRCA.Chapter15.IsBlaschkeProduct B) [IsFiniteMeasure μ]
      (hμ : μ ⟂ₘ circleMeasure),
      let hInner := (isInnerFunction_of_isBlaschkeProduct hB).mul
        ((isInnerFunction_singularInnerFactor_iff μ).mpr hμ)
      IsClosedInvariantSubspace (innerSubspace (fun z ↦ B z * singularInnerFactor μ z) hInner) ∧
        innerSubspace (fun z ↦ B z * singularInnerFactor μ z) hInner ≠ ⊥) ∧
    (∀ (Y : Submodule ℂ (HardyElem 2)),
      IsClosedInvariantSubspace Y → Y ≠ ⊥ →
        ∃ (B : ℂ → ℂ) (μ : Measure FourierCircle)
          (hB : RudinRCA.Chapter15.IsBlaschkeProduct B) (_ : IsFiniteMeasure μ)
          (hμ : μ ⟂ₘ circleMeasure),
          Y = innerSubspace (fun z ↦ B z * singularInnerFactor μ z)
            ((isInnerFunction_of_isBlaschkeProduct hB).mul
              ((isInnerFunction_singularInnerFactor_iff μ).mpr hμ))) ∧
    (∀ (B₁ B₂ : ℂ → ℂ) (μ₁ μ₂ : Measure FourierCircle)
      (hB₁ : RudinRCA.Chapter15.IsBlaschkeProduct B₁)
      (hB₂ : RudinRCA.Chapter15.IsBlaschkeProduct B₂)
      [IsFiniteMeasure μ₁] [IsFiniteMeasure μ₂]
      (hμ₁ : μ₁ ⟂ₘ circleMeasure) (hμ₂ : μ₂ ⟂ₘ circleMeasure),
      (innerSubspace (fun z ↦ B₁ z * singularInnerFactor μ₁ z)
          ((isInnerFunction_of_isBlaschkeProduct hB₁).mul
            ((isInnerFunction_singularInnerFactor_iff μ₁).mpr hμ₁)) =
        innerSubspace (fun z ↦ B₂ z * singularInnerFactor μ₂ z)
          ((isInnerFunction_of_isBlaschkeProduct hB₂).mul
            ((isInnerFunction_singularInnerFactor_iff μ₂).mpr hμ₂)) ↔
        (μ₁ = μ₂ ∧ ∀ z ∈ Metric.ball (0 : ℂ) 1, B₁ z = B₂ z)) ∧
      (innerSubspace (fun z ↦ B₁ z * singularInnerFactor μ₁ z)
          ((isInnerFunction_of_isBlaschkeProduct hB₁).mul
            ((isInnerFunction_singularInnerFactor_iff μ₁).mpr hμ₁)) =
        innerSubspace (fun z ↦ B₂ z * singularInnerFactor μ₂ z)
          ((isInnerFunction_of_isBlaschkeProduct hB₂).mul
            ((isInnerFunction_singularInnerFactor_iff μ₂).mpr hμ₂)) →
        ∀ z ∈ Metric.ball (0 : ℂ) 1, analyticOrderNatAt B₁ z = analyticOrderNatAt B₂ z)) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · -- Clause 1: `⊥` is closed and `mulZ`-invariant
    refine ⟨?_, fun F hF ↦ ?_⟩
    · change IsClosed ({(0 : HardyElem 2)} : Set (HardyElem 2))
      exact isClosed_singleton
    · rw [Submodule.mem_bot] at hF ⊢
      rw [hF, map_zero]
  · -- Clause 2: Every `(B, μ)` gives a nonzero closed `mulZ`-invariant subspace
    intro B μ hB _ hμ
    exact isClosedInvariantSubspace_innerSubspace hPartB _
  · -- Clause 3: Existence for every nonzero closed `mulZ`-invariant subspace `Y ≠ ⊥`
    intro Y hY hY_ne
    obtain ⟨φ, hφ, rfl⟩ := (theorem17_21 hPartB).2.2 Y hY hY_ne
    obtain ⟨c, B, μ, hc, hB, hμ_fin, hμ_sing, hφ_eq⟩ := (theorem17_15 hPartB).mp hφ
    have hBS_inner : IsInnerFunction (fun z ↦ B z * singularInnerFactor μ z) :=
      (isInnerFunction_of_isBlaschkeProduct hB).mul
        ((@isInnerFunction_singularInnerFactor_iff μ hμ_fin).mpr hμ_sing)
    refine ⟨B, μ, hB, hμ_fin, hμ_sing, ?_⟩
    refine (innerSubspace_eq_iff hPartB hφ hBS_inner).mpr ⟨c, hc, fun z hz ↦ ?_⟩
    rw [hφ_eq z hz, mul_assoc]
  · -- Clause 4: Uniqueness of `(B, μ)` and zero multiplicities
    intro B₁ B₂ μ₁ μ₂ hB₁ hB₂ _ _ hμ₁ hμ₂
    let hI₁ : IsInnerFunction (fun z ↦ B₁ z * singularInnerFactor μ₁ z) :=
      (isInnerFunction_of_isBlaschkeProduct hB₁).mul
        ((isInnerFunction_singularInnerFactor_iff μ₁).mpr hμ₁)
    let hI₂ : IsInnerFunction (fun z ↦ B₂ z * singularInnerFactor μ₂ z) :=
      (isInnerFunction_of_isBlaschkeProduct hB₂).mul
        ((isInnerFunction_singularInnerFactor_iff μ₂).mpr hμ₂)
    have hforward : innerSubspace (fun z ↦ B₁ z * singularInnerFactor μ₁ z) hI₁ =
          innerSubspace (fun z ↦ B₂ z * singularInnerFactor μ₂ z) hI₂ →
        μ₁ = μ₂ ∧ ∀ z ∈ Metric.ball (0 : ℂ) 1, B₁ z = B₂ z := by
      intro hsub_eq
      obtain ⟨c, hc, hrel⟩ := (innerSubspace_eq_iff hPartB hI₁ hI₂).mp hsub_eq
      have hc_ne : c ≠ 0 := norm_ne_zero_iff.mp (hc ▸ one_ne_zero)
      let u : ℂ → ℂ := fun z ↦ c * singularInnerFactor μ₂ z / singularInnerFactor μ₁ z
      have hu_holo : HolomorphicOn u (Metric.ball (0 : ℂ) 1) := fun z hz ↦
        ((differentiableAt_const c).mul (holomorphicOn_singularInnerFactor μ₂ z hz)).div
          (holomorphicOn_singularInnerFactor μ₁ z hz) (singularInnerFactor_ne_zero μ₁ z)
      have hu_nz : ∀ z ∈ Metric.ball (0 : ℂ) 1, u z ≠ 0 := fun z _ ↦
        div_ne_zero (mul_ne_zero hc_ne (singularInnerFactor_ne_zero μ₂ z))
          (singularInnerFactor_ne_zero μ₁ z)
      have hB₁_eq_uB₂ : ∀ z ∈ Metric.ball (0 : ℂ) 1, B₁ z = u z * B₂ z := by
        intro z hz
        dsimp [u]
        have h1 := hrel z hz
        calc B₁ z = (B₁ z * singularInnerFactor μ₁ z) / singularInnerFactor μ₁ z :=
              (mul_div_cancel_right₀ (B₁ z) (singularInnerFactor_ne_zero μ₁ z)).symm
          _ = (c * (B₂ z * singularInnerFactor μ₂ z)) / singularInnerFactor μ₁ z := by rw [h1]
          _ = c * singularInnerFactor μ₂ z / singularInnerFactor μ₁ z * B₂ z := by ring
      have hu_log_poisson : ∀ z ∈ Metric.ball (0 : ℂ) 1,
          Real.log ‖u z‖ =
            (∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂μ₁) -
              ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂μ₂ := by
        intro z hz
        dsimp [u]
        rw [norm_div, norm_mul, hc, one_mul, norm_singularInnerFactor μ₂ hz,
          norm_singularInnerFactor μ₁ hz, ← Real.exp_sub, Real.log_exp]
        ring
      -- Show `Real.log ‖u z‖ = 0` on `ball 0 1` by radial Herglotz + `theorem15_24`
      obtain ⟨L, hL_holo, hu_exp⟩ := exists_holomorphic_log_ball hu_holo hu_nz
      have hL_re : ∀ z ∈ Metric.ball (0 : ℂ) 1, (L z).re = Real.log ‖u z‖ := by
        intro z hz
        rw [hu_exp z hz, Complex.norm_exp, Real.log_exp]
      obtain ⟨hB₁_ae_nz, hB₁_log_int, hB₁_log_lim⟩ := blaschke_radial_log_props hB₁
      obtain ⟨hB₂_ae_nz, hB₂_log_int, hB₂_log_lim⟩ := blaschke_radial_log_props hB₂
      have hB₁_inner := isInnerFunction_of_isBlaschkeProduct hB₁
      have hB₂_inner := isInnerFunction_of_isBlaschkeProduct hB₂
      have hu_log_zero : ∀ z ∈ Metric.ball (0 : ℂ) 1, Real.log ‖u z‖ = 0 := by
        intro z hz
        have hz_lt : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
        let r₀ : ℝ := (1 + ‖z‖) / 2
        have hr₀_lt1 : r₀ < 1 := by dsimp [r₀]; linarith
        let C_z : ℝ := 1 / ((1 - ‖z‖) / 2) ^ 2
        have hCz_pos : 0 < C_z := by
          dsimp [C_z]
          exact div_pos zero_lt_one (pow_pos (half_pos (sub_pos.mpr hz_lt)) 2)
        have hrhs_lim : Tendsto
            (fun r : ℝ ↦ C_z * (-(∫ ζ, Real.log ‖B₁ ((r : ℂ) * circlePoint ζ)‖ ∂circleMeasure) -
              ∫ ζ, Real.log ‖B₂ ((r : ℂ) * circlePoint ζ)‖ ∂circleMeasure))
            (𝓝[<] (1 : ℝ)) (𝓝 0) := by
          simpa using (hB₁_log_lim.neg.sub hB₂_log_lim).const_mul C_z
        have habs_le0 : |Real.log ‖u z‖| ≤ 0 := by
          refine ge_of_tendsto hrhs_lim ?_
          filter_upwards [Ioo_mem_nhdsLT hr₀_lt1] with r hr
          have hr_pos : 0 < r := by
            have : (0 : ℝ) < r₀ := by dsimp [r₀]; linarith [norm_nonneg z]
            exact this.trans hr.1
          have hzr : ‖z‖ < r := by
            have : ‖z‖ < r₀ := by dsimp [r₀]; linarith
            exact this.trans hr.1
          have hr_mem : r ∈ Set.Ioo (0 : ℝ) 1 := ⟨hr_pos, hr.2⟩
          let w : ℂ := z / (r : ℂ)
          have hw_norm : ‖w‖ = ‖z‖ / r := by
            simp [w, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_pos]
          have hw_lt1 : ‖w‖ < 1 := by
            rw [hw_norm]
            exact (div_lt_one hr_pos).mpr hzr
          have hw_ball : w ∈ Metric.ball (0 : ℂ) 1 := mem_ball_zero_iff.mpr hw_lt1
          have hrw : (r : ℂ) * w = z :=
            mul_div_cancel₀ z (Complex.ofReal_ne_zero.mpr hr_pos.ne')
          have hherg := congr_arg Complex.re
            (holomorphic_herglotz_radial hL_holo hr_pos.le hr.2 hw_ball)
          have hur_cont : Continuous (fun ζ : FourierCircle ↦ (L ((r : ℂ) * circlePoint ζ)).re) := by
            refine Complex.continuous_re.comp
              ((RudinRCA.Chapter10.continuousOn_of_holomorphicOn hL_holo).comp_continuous
                (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_)
            simpa [Metric.mem_ball, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_pos]
              using hr.2
          have hur_int : Integrable (fun ζ : FourierCircle ↦ (L ((r : ℂ) * circlePoint ζ)).re)
              circleMeasure :=
            (memLp_circleMeasure_of_continuous hur_cont 1).integrable le_rfl
          rw [hrw, hL_re z hz, Complex.add_re, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
            Complex.I_re, Complex.I_im, mul_zero, zero_mul, sub_self, zero_add,
            re_herglotzTransform_ofReal hur_int hw_ball] at hherg
          have hP_le_Cz : ∀ ζ : FourierCircle,
              _root_.poissonKernel 0 w (circlePoint ζ) ≤ C_z := by
            intro ζ
            rw [poissonKernel_circlePoint_formula]
            have h1mw : (1 - ‖z‖) / 2 ≤ 1 - ‖w‖ := by
              rw [hw_norm]
              have hdiff : (1 - ‖z‖) / 2 < r - ‖z‖ := by
                have hr1 : (1 + ‖z‖) / 2 < r := hr.1
                linarith
              calc (1 - ‖z‖) / 2 ≤ (r - ‖z‖) / 1 := by linarith
                _ ≤ (r - ‖z‖) / r :=
                    div_le_div_of_nonneg_left (by linarith) hr_pos hr.2.le
                _ = 1 - ‖z‖ / r := by field_simp [hr_pos.ne']
            have hden_ge : (1 - ‖z‖) / 2 ≤ ‖circlePoint ζ - w‖ := by
              have htri := norm_sub_norm_le (circlePoint ζ) w
              rw [norm_circlePoint] at htri
              linarith
            have hnum_le : 1 - ‖w‖ ^ 2 ≤ 1 := sub_le_self 1 (sq_nonneg _)
            calc (1 - ‖w‖ ^ 2) / ‖circlePoint ζ - w‖ ^ 2
                ≤ 1 / ‖circlePoint ζ - w‖ ^ 2 :=
                  div_le_div_of_nonneg_right hnum_le (sq_nonneg _)
              _ ≤ 1 / ((1 - ‖z‖) / 2) ^ 2 :=
                  div_le_div_of_nonneg_left zero_le_one
                    (pow_pos (half_pos (sub_pos.mpr hz_lt)) 2)
                    (pow_le_pow_left₀ (half_pos (sub_pos.mpr hz_lt)).le hden_ge 2)
          have hp_cont := continuous_poissonKernel_circlePoint hw_ball
          have hint_lhs : Integrable (fun ζ ↦ _root_.poissonKernel 0 w (circlePoint ζ) *
              (L ((r : ℂ) * circlePoint ζ)).re) circleMeasure :=
            hur_int.bdd_mul hp_cont.aestronglyMeasurable
              (Eventually.of_forall fun ζ ↦ by
                rw [Real.norm_of_nonneg (poissonKernel_circlePoint_nonneg hw_ball ζ)]
                exact hP_le_Cz ζ)
          have hint_dom : Integrable (fun ζ ↦ C_z *
              (-Real.log ‖B₁ ((r : ℂ) * circlePoint ζ)‖ -
                Real.log ‖B₂ ((r : ℂ) * circlePoint ζ)‖)) circleMeasure :=
            ((hB₁_log_int r hr_mem).neg.sub (hB₂_log_int r hr_mem)).const_mul C_z
          rw [hherg]
          unfold circlePoissonIntegral
          simp_rw [smul_eq_mul]
          calc |∫ ζ, _root_.poissonKernel 0 w (circlePoint ζ) *
                  (L ((r : ℂ) * circlePoint ζ)).re ∂circleMeasure|
              ≤ ∫ ζ, |_root_.poissonKernel 0 w (circlePoint ζ) *
                  (L ((r : ℂ) * circlePoint ζ)).re| ∂circleMeasure :=
                abs_integral_le_integral_abs
            _ ≤ ∫ ζ, C_z * (-Real.log ‖B₁ ((r : ℂ) * circlePoint ζ)‖ -
                  Real.log ‖B₂ ((r : ℂ) * circlePoint ζ)‖) ∂circleMeasure := by
                refine integral_mono_ae hint_lhs.abs hint_dom ?_
                filter_upwards [hB₁_ae_nz r hr_mem, hB₂_ae_nz r hr_mem] with ζ hB₁_nz hB₂_nz
                have hrz_ball : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
                  simpa [Metric.mem_ball, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr_pos]
                    using hr.2
                have hl_eq : (L ((r : ℂ) * circlePoint ζ)).re =
                    Real.log ‖B₁ ((r : ℂ) * circlePoint ζ)‖ -
                      Real.log ‖B₂ ((r : ℂ) * circlePoint ζ)‖ := by
                  rw [hL_re _ hrz_ball, hB₁_eq_uB₂ _ hrz_ball, norm_mul,
                    Real.log_mul (norm_ne_zero_iff.mpr (hu_nz _ hrz_ball))
                      (norm_ne_zero_iff.mpr hB₂_nz)]
                  ring
                have hlog1_le0 : Real.log ‖B₁ ((r : ℂ) * circlePoint ζ)‖ ≤ 0 :=
                  Real.log_nonpos (norm_nonneg _) (hB₁_inner.2.1 _ hrz_ball)
                have hlog2_le0 : Real.log ‖B₂ ((r : ℂ) * circlePoint ζ)‖ ≤ 0 :=
                  Real.log_nonpos (norm_nonneg _) (hB₂_inner.2.1 _ hrz_ball)
                have habs_l : |(L ((r : ℂ) * circlePoint ζ)).re| ≤
                    -Real.log ‖B₁ ((r : ℂ) * circlePoint ζ)‖ -
                      Real.log ‖B₂ ((r : ℂ) * circlePoint ζ)‖ := by
                  rw [hl_eq]
                  exact abs_le.mpr ⟨by linarith, by linarith⟩
                rw [abs_mul, abs_of_nonneg (poissonKernel_circlePoint_nonneg hw_ball ζ)]
                exact mul_le_mul (hP_le_Cz ζ) habs_l (abs_nonneg _) hCz_pos.le
            _ = C_z * (-(∫ ζ, Real.log ‖B₁ ((r : ℂ) * circlePoint ζ)‖ ∂circleMeasure) -
                  ∫ ζ, Real.log ‖B₂ ((r : ℂ) * circlePoint ζ)‖ ∂circleMeasure) := by
                have hneg_int : Integrable
                    (fun ζ ↦ -Real.log ‖B₁ ((r : ℂ) * circlePoint ζ)‖) circleMeasure :=
                  (hB₁_log_int r hr_mem).neg
                rw [integral_const_mul, integral_sub hneg_int (hB₂_log_int r hr_mem), integral_neg]
        exact abs_eq_zero.mp (le_antisymm habs_le0 (abs_nonneg _))
      -- Deduce `μ₁ = μ₂`
      have hP_eq : ∀ z ∈ Metric.ball (0 : ℂ) 1,
          (∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂μ₁) =
            ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) ∂μ₂ := by
        intro z hz
        have h0 := hu_log_zero z hz
        rw [hu_log_poisson z hz] at h0
        exact sub_eq_zero.mp h0
      have hμ_eq : μ₁ = μ₂ := eq_of_poissonIntegral_eq_on_ball μ₁ μ₂ hP_eq
      -- Deduce `B₁ z = c * B₂ z` on `ball 0 1`, then `c = 1` via positive origin factors
      have hB_c : ∀ z ∈ Metric.ball (0 : ℂ) 1, B₁ z = c * B₂ z := by
        intro z hz
        have h1 := hrel z hz
        rw [hμ_eq] at h1
        exact mul_right_cancel₀ (singularInnerFactor_ne_zero μ₂ z)
          (by rw [h1, mul_assoc])
      obtain ⟨k₁, P₁, r₁, hr₁_pos, hP₁_holo, hP₁0, hB₁_fac⟩ := blaschke_origin_factor hB₁
      obtain ⟨k₂, P₂, r₂, hr₂_pos, hP₂_holo, hP₂0, hB₂_fac⟩ := blaschke_origin_factor hB₂
      let d₁ : ℕ → ℂ := fun n ↦ if n < k₁ then 0 else taylorCoeff P₁ (n - k₁)
      let d₂ : ℕ → ℂ := fun n ↦ c * (if n < k₂ then 0 else taylorCoeff P₂ (n - k₂))
      have hd₁_sum : ∀ z ∈ RudinRCA.Chapter10.disc (0 : ℂ) 1,
          HasSum (fun n : ℕ ↦ d₁ n * (z - 0) ^ n) (B₁ z) := by
        intro z hz
        have hz_ball : z ∈ Metric.ball (0 : ℂ) 1 := hz
        simp only [sub_zero]
        rw [hB₁_fac z hz_ball, ← hasSum_nat_add_iff' k₁]
        have hfin0 : ∑ i ∈ Finset.range k₁, d₁ i * z ^ i = 0 :=
          Finset.sum_eq_zero fun i hi ↦ by simp [d₁, Finset.mem_range.mp hi]
        rw [hfin0, sub_zero]
        convert (hasSum_taylorCoeff_ball hP₁_holo hz_ball).mul_left (z ^ k₁) using 1
        funext m
        have hnot : ¬ (m + k₁ < k₁) := by omega
        simp only [d₁, hnot, ↓reduceIte, Nat.add_sub_cancel, pow_add]
        ring
      have hd₂_sum : ∀ z ∈ RudinRCA.Chapter10.disc (0 : ℂ) 1,
          HasSum (fun n : ℕ ↦ d₂ n * (z - 0) ^ n) (B₁ z) := by
        intro z hz
        have hz_ball : z ∈ Metric.ball (0 : ℂ) 1 := hz
        simp only [sub_zero]
        rw [hB_c z hz_ball, hB₂_fac z hz_ball, ← mul_assoc, ← hasSum_nat_add_iff' k₂]
        have hfin0 : ∑ i ∈ Finset.range k₂, d₂ i * z ^ i = 0 :=
          Finset.sum_eq_zero fun i hi ↦ by simp [d₂, Finset.mem_range.mp hi]
        rw [hfin0, sub_zero]
        convert (hasSum_taylorCoeff_ball hP₂_holo hz_ball).mul_left (c * z ^ k₂) using 1
        funext m
        have hnot : ¬ (m + k₂ < k₂) := by omega
        simp only [d₂, hnot, ↓reduceIte, Nat.add_sub_cancel, pow_add]
        ring
      have hd_eq : ∀ n : ℕ, d₁ n = d₂ n :=
        congr_fun (RudinRCA.Chapter10.powerSeries_coefficients_unique zero_lt_one hd₁_sum hd₂_sum)
      have hd₁_k₁ : d₁ k₁ = (r₁ : ℂ) := by simp [d₁, taylorCoeff, hP₁0]
      have hd₂_k₂ : d₂ k₂ = c * (r₂ : ℂ) := by simp [d₂, taylorCoeff, hP₂0]
      have hr₁C_ne : (r₁ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr₁_pos.ne'
      have hr₂C_ne : (r₂ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr₂_pos.ne'
      have hk_eq : k₁ = k₂ := by
        rcases lt_trichotomy k₁ k₂ with hlt | heq | hgt
        · exfalso
          have h := hd_eq k₁
          rw [hd₁_k₁] at h
          simp only [d₂, hlt, ↓reduceIte, mul_zero] at h
          exact hr₁C_ne h
        · exact heq
        · exfalso
          have h := hd_eq k₂
          rw [hd₂_k₂] at h
          simp only [d₁, hgt, ↓reduceIte] at h
          exact mul_ne_zero hc_ne hr₂C_ne h.symm
      have hcr_eq : (r₁ : ℂ) = c * (r₂ : ℂ) := by
        have h := hd_eq k₁
        rw [hd₁_k₁, hk_eq, hd₂_k₂] at h
        exact h
      have hr_eq : r₁ = r₂ := by
        have hn := congr_arg norm hcr_eq
        simpa [Complex.norm_real, Real.norm_of_nonneg hr₁_pos.le,
          Real.norm_of_nonneg hr₂_pos.le, hc] using hn
      have hc_one : c = 1 := by
        rw [hr_eq] at hcr_eq
        exact mul_right_cancel₀ hr₂C_ne (by rw [one_mul]; exact hcr_eq.symm)
      refine ⟨hμ_eq, fun z hz ↦ ?_⟩
      rw [hB_c z hz, hc_one, one_mul]
    refine ⟨⟨hforward, ?_⟩, fun hsub_eq z hz ↦ ?_⟩
    · rintro ⟨hμ_eq, hB_eq⟩
      refine (innerSubspace_eq_iff hPartB hI₁ hI₂).mpr ⟨1, norm_one, fun z hz ↦ ?_⟩
      rw [one_mul, hB_eq z hz, hμ_eq]
    · obtain ⟨_, hB_eq⟩ := hforward hsub_eq
      unfold analyticOrderNatAt
      rw [analyticOrderAt_congr (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz) hB_eq)]

/-! ### Section 17.23: Cyclic Vectors and Invariant Subspaces Generated by `F ∈ H²` (RCA p. 350) -/

/-- The closed `mulZ`-invariant subspace of `H²` generated by `F : HardyElem 2`, defined as the
closure in `H²` of `span_ℂ {mulZ^[n] F | n : ℕ}` (RCA p. 350). -/
def generatedInvariantSubspace (F : HardyElem 2) : Submodule ℂ (HardyElem 2) :=
  (Submodule.span ℂ (Set.range fun n : ℕ ↦ (mulZ^[n]) F)).topologicalClosure

/-- Multiplication of `F ∈ H²` by a complex polynomial `P : Polynomial ℂ`, defined inside
`HardyElem 2` as `∑_{n ≤ deg P} P.coeff n • mulZ^[n] F`. -/
def polyMulHardy (P : Polynomial ℂ) (F : HardyElem 2) : HardyElem 2 :=
  ∑ n ∈ Finset.range (P.natDegree + 1), P.coeff n • (mulZ^[n]) F

@[simp]
theorem polyMulHardy_apply_ball (P : Polynomial ℂ) (F : HardyElem 2)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    polyMulHardy P F z = P.eval z * F z := by
  have hsum_fn : (polyMulHardy P F).toFun =
      ∑ n ∈ Finset.range (P.natDegree + 1), (P.coeff n • (mulZ^[n]) F).toFun :=
    map_sum (HardyElem.toFunAddMonoidHom 2)
      (fun n ↦ P.coeff n • (mulZ^[n]) F) (Finset.range (P.natDegree + 1))
  change (polyMulHardy P F).toFun z = P.eval z * F z
  rw [hsum_fn, Finset.sum_apply]
  calc ∑ n ∈ Finset.range (P.natDegree + 1), (P.coeff n • (mulZ^[n]) F).toFun z
      = ∑ n ∈ Finset.range (P.natDegree + 1), (P.coeff n * z ^ n) * F z := by
          refine Finset.sum_congr rfl fun n _ ↦ ?_
          rw [HardyElem.toFun_smul, Pi.smul_apply, smul_eq_mul,
            mulZ_iterate_apply_ball n F hz, mul_assoc]
    _ = (∑ n ∈ Finset.range (P.natDegree + 1), P.coeff n * z ^ n) * F z :=
          (Finset.sum_mul _ _ _).symm
    _ = P.eval z * F z := by rw [← Polynomial.eval_eq_sum_range]

theorem span_mulZ_iterate_eq_range_polyMulHardy (F : HardyElem 2) :
    (Submodule.span ℂ (Set.range fun n : ℕ ↦ (mulZ^[n]) F) : Set (HardyElem 2)) =
      Set.range (fun P : Polynomial ℂ ↦ polyMulHardy P F) ∧
    Set.range (fun P : Polynomial ℂ ↦ polyMulHardy P F) =
      {G : HardyElem 2 | ∃ P : Polynomial ℂ, ∀ z ∈ Metric.ball (0 : ℂ) 1,
        G z = P.eval z * F z} := by
  have h2 : Set.range (fun P : Polynomial ℂ ↦ polyMulHardy P F) =
      {G : HardyElem 2 | ∃ P : Polynomial ℂ, ∀ z ∈ Metric.ball (0 : ℂ) 1,
        G z = P.eval z * F z} := by
    ext G
    constructor
    · rintro ⟨P, rfl⟩
      exact ⟨P, fun z hz ↦ polyMulHardy_apply_ball P F hz⟩
    · rintro ⟨P, hP⟩
      refine ⟨P, HardyElem.ext_ball fun z hz ↦ ?_⟩
      change polyMulHardy P F z = G z
      rw [polyMulHardy_apply_ball P F hz, hP z hz]
  refine ⟨?_, h2⟩
  rw [h2]
  refine Set.Subset.antisymm ?_ ?_
  · intro G hG
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hG
    · rintro _ ⟨n, rfl⟩
      exact ⟨Polynomial.X ^ n, fun z hz ↦ by simp [hz]⟩
    · exact ⟨0, fun z _ ↦ by simp⟩
    · rintro G₁ G₂ _ _ ⟨P₁, hP₁⟩ ⟨P₂, hP₂⟩
      refine ⟨P₁ + P₂, fun z hz ↦ ?_⟩
      change (G₁ + G₂).toFun z = (P₁ + P₂).eval z * F z
      rw [HardyElem.toFun_add, Pi.add_apply, Polynomial.eval_add, add_mul,
        ← hP₁ z hz, ← hP₂ z hz]
    · rintro c G₀ _ ⟨P, hP⟩
      refine ⟨Polynomial.C c * P, fun z hz ↦ ?_⟩
      change (c • G₀).toFun z = (Polynomial.C c * P).eval z * F z
      rw [HardyElem.toFun_smul, Pi.smul_apply, smul_eq_mul, Polynomial.eval_mul,
        Polynomial.eval_C, mul_assoc, ← hP z hz]
  · rintro G ⟨P, hP⟩
    have hG_eq : G = polyMulHardy P F := by
      apply HardyElem.ext_ball
      intro z hz
      rw [polyMulHardy_apply_ball P F hz, hP z hz]
    rw [hG_eq]
    exact Submodule.sum_mem _ fun n _ ↦ Submodule.smul_mem _ _ (Submodule.subset_span ⟨n, rfl⟩)

theorem generatedInvariantSubspace_carrier_eq_closure_polynomial_mul (F : HardyElem 2) :
    (generatedInvariantSubspace F : Set (HardyElem 2)) =
      closure {G : HardyElem 2 | ∃ P : Polynomial ℂ,
        ∀ z ∈ Metric.ball (0 : ℂ) 1, G z = P.eval z * F z} := by
  unfold generatedInvariantSubspace
  rw [Submodule.topologicalClosure_coe, (span_mulZ_iterate_eq_range_polyMulHardy F).1,
    (span_mulZ_iterate_eq_range_polyMulHardy F).2]

theorem isClosedInvariantSubspace_generatedInvariantSubspace (F : HardyElem 2) :
    IsClosedInvariantSubspace (generatedInvariantSubspace F) ∧
    F ∈ generatedInvariantSubspace F ∧
    (∀ Y : Submodule ℂ (HardyElem 2),
      IsClosedInvariantSubspace Y → F ∈ Y → generatedInvariantSubspace F ≤ Y) := by
  let S₀ := Submodule.span ℂ (Set.range fun n : ℕ ↦ (mulZ^[n]) F)
  have hS₀_inv : ∀ G ∈ S₀, mulZ G ∈ S₀ := by
    intro G hG
    refine Submodule.span_induction ?_ ?_ ?_ ?_ hG
    · rintro _ ⟨n, rfl⟩
      rw [← Function.iterate_succ_apply' mulZ n F]
      exact Submodule.subset_span ⟨n + 1, rfl⟩
    · rw [map_zero]
      exact S₀.zero_mem
    · intro G₁ G₂ _ _ h₁ h₂
      rw [map_add]
      exact S₀.add_mem h₁ h₂
    · intro c G₀ _ h₀
      rw [map_smul]
      exact S₀.smul_mem c h₀
  refine ⟨⟨S₀.isClosed_topologicalClosure, ?_⟩,
    Submodule.le_topologicalClosure S₀ (Submodule.subset_span ⟨0, rfl⟩), ?_⟩
  · intro G hG
    have hcl : IsClosed (mulZ ⁻¹' (generatedInvariantSubspace F : Set (HardyElem 2))) :=
      S₀.isClosed_topologicalClosure.preimage mulZ.continuous
    have hsub : (S₀ : Set (HardyElem 2)) ⊆
        mulZ ⁻¹' (generatedInvariantSubspace F : Set (HardyElem 2)) :=
      fun x hx ↦ Submodule.le_topologicalClosure S₀ (hS₀_inv x hx)
    have hmem : G ∈ closure (S₀ : Set (HardyElem 2)) := by
      rwa [← S₀.topologicalClosure_coe]
    exact closure_minimal hsub hcl hmem
  · intro Y hY hFY
    have hS₀_le : S₀ ≤ Y := by
      rw [Submodule.span_le]
      rintro _ ⟨n, rfl⟩
      exact mulZ_iterate_mem_of_invariant hY.2 n hFY
    intro G hG
    have hmem : G ∈ closure (S₀ : Set (HardyElem 2)) := by
      rwa [← S₀.topologicalClosure_coe]
    exact closure_minimal hS₀_le hY.1 hmem

private theorem generatedInvariantSubspace_eq_top_of_isOuterFunction
    (hPartB : HardyPartBInterface) {Q : HardyElem 2} (hQ_outer : IsOuterFunction Q.toFun) :
    generatedInvariantSubspace Q = ⊤ := by
  have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
  have hQ_nz : ∀ z ∈ Metric.ball (0 : ℂ) 1, Q.toFun z ≠ 0 :=
    (theorem17_14.2.2.2 hQ_outer).2
  have hQ0_ne : Q.toFun 0 ≠ 0 := hQ_nz 0 h0_mem
  have hQ_ne : Q ≠ 0 := fun h0 ↦ hQ0_ne (by rw [h0]; rfl)
  obtain ⟨hgen_inv, hQ_mem, _⟩ := isClosedInvariantSubspace_generatedInvariantSubspace Q
  have hgen_ne_bot : generatedInvariantSubspace Q ≠ ⊥ := by
    intro hbot
    rw [hbot, Submodule.mem_bot] at hQ_mem
    exact hQ_ne hQ_mem
  obtain ⟨φ, hφ, hgen_eq⟩ := (theorem17_21 hPartB).2.2 _ hgen_inv hgen_ne_bot
  have hQ_in_φ : Q ∈ innerSubspace φ hφ := hgen_eq ▸ hQ_mem
  obtain ⟨H, hQH⟩ := hQ_in_φ
  change mulByInner hφ H = Q at hQH
  have hQ0_fac : Q.toFun 0 = φ 0 * H.toFun 0 := by
    have h := congr_arg (fun F : HardyElem 2 ↦ F 0) hQH.symm
    simpa [h0_mem] using h
  have hφ0_ne : φ 0 ≠ 0 := fun h0 ↦ hQ0_ne (by rw [hQ0_fac, h0, zero_mul])
  have hH0_ne : H.toFun 0 ≠ 0 := fun h0 ↦ hQ0_ne (by rw [hQ0_fac, h0, mul_zero])
  have h17_Q := theorem17_17 hPartB (p := 2) (by norm_num) Q.mem_hardy ⟨0, h0_mem, hQ0_ne⟩
  have h17_H := theorem17_17 hPartB (p := 2) (by norm_num) H.mem_hardy ⟨0, h0_mem, hH0_ne⟩
  have hQ_log_eq : Real.log ‖Q.toFun 0‖ =
      ∫ ζ, Real.log ‖radialBoundaryLimit Q.toFun ζ‖ ∂circleMeasure :=
    (h17_Q.2.2.2.2.2.2.2.2.2.2.2.mpr hQ_outer).2
  have hH_log_le : Real.log ‖H.toFun 0‖ ≤
      ∫ ζ, Real.log ‖radialBoundaryLimit H.toFun ζ‖ ∂circleMeasure :=
    h17_H.2.2.2.2.2.2.2.2.2.1 hH0_ne
  have hint_eq : (∫ ζ, Real.log ‖radialBoundaryLimit Q.toFun ζ‖ ∂circleMeasure) =
      ∫ ζ, Real.log ‖radialBoundaryLimit H.toFun ζ‖ ∂circleMeasure := by
    rw [← hQH]
    refine integral_congr_ae ?_
    filter_upwards [radialBoundaryLimit_mulByInner_ae hPartB hφ H, hφ.2.2] with ζ hmul h1
    rw [hmul, norm_mul, h1, one_mul]
  have hlog_sum : Real.log ‖Q.toFun 0‖ = Real.log ‖φ 0‖ + Real.log ‖H.toFun 0‖ := by
    rw [hQ0_fac, norm_mul, Real.log_mul (norm_ne_zero_iff.mpr hφ0_ne) (norm_ne_zero_iff.mpr hH0_ne)]
  have hlog_φ0_ge : 0 ≤ Real.log ‖φ 0‖ := by
    linarith [hQ_log_eq, hH_log_le, hint_eq, hlog_sum]
  have hlog_φ0_le : Real.log ‖φ 0‖ ≤ 0 :=
    Real.log_nonpos (norm_nonneg _) (hφ.2.1 0 h0_mem)
  have hlog_φ0_eq : Real.log ‖φ 0‖ = 0 := le_antisymm hlog_φ0_le hlog_φ0_ge
  have hφ0_norm1 : ‖φ 0‖ = 1 := by
    rw [← Real.exp_log (norm_pos_iff.mpr hφ0_ne), hlog_φ0_eq, Real.exp_zero]
  have hφ_const := eq_const_on_ball_of_norm_le_one_of_norm_zero_eq_one hφ.1 hφ.2.1 hφ0_norm1
  have hsub_top : innerSubspace φ hφ = ⊤ := by
    rw [← innerSubspace_one_eq_top]
    exact (innerSubspace_eq_iff hPartB hφ (isInnerFunction_const norm_one)).mpr
      ⟨φ 0, hφ0_norm1, fun z hz ↦ by rw [mul_one]; exact hφ_const z hz⟩
  exact hgen_eq.trans hsub_top

/-- **Theorem 17.23 (Generated Invariant Subspaces and Cyclic Vectors in `H²`, RCA p. 350):**
Let `F ∈ H²` (`F : HardyElem 2`) be **nonzero** (`F ≠ 0`), so its canonical inner factor
`M_F = canonicalInnerFactor F.toFun` is an inner function (`hMf : IsInnerFunction M_F`).
1. The closed `mulZ`-invariant subspace `generatedInvariantSubspace F` generated by `F` is
   precisely `M_F H² = innerSubspace (canonicalInnerFactor F.toFun) hMf`.
2. In particular, `generatedInvariantSubspace F = ⊤` (polynomial multiples of `F` are dense in
   `H²`) if and only if `F` is an outer function (`IsOuterFunction F.toFun`).
3. Equivalently, for every `G ∈ H²`, `G` can be approximated in the `H²` norm by polynomial
   multiples `polyMulHardy P F` (`z ↦ P(z) F(z)`) if and only if `G ∈ M_F H²` (`G / M_F ∈ H²`). -/
theorem theorem17_23 (hPartB : HardyPartBInterface) {F : HardyElem 2} (hF_ne : F ≠ 0) :
    ∃ hMf : IsInnerFunction (canonicalInnerFactor F.toFun),
      generatedInvariantSubspace F = innerSubspace (canonicalInnerFactor F.toFun) hMf ∧
      (generatedInvariantSubspace F = ⊤ ↔ IsOuterFunction F.toFun) ∧
      (∀ G : HardyElem 2,
        G ∈ innerSubspace (canonicalInnerFactor F.toFun) hMf ↔
          ∀ ε : ℝ, 0 < ε → ∃ P : Polynomial ℂ, ‖G - polyMulHardy P F‖ < ε) := by
  have hex_nz : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, F.toFun z₀ ≠ 0 := by
    by_contra hall
    refine hF_ne (HardyElem.ext_ball fun z hz ↦ ?_)
    by_contra hnz
    exact hall ⟨z, hz, hnz⟩
  have h17 := theorem17_17 hPartB (p := 2) (by norm_num) F.mem_hardy hex_nz
  have hQf_outer : IsOuterFunction (canonicalOuterFactor F.toFun) := h17.2.2.1
  have hQf_h2 : IsInHardySpace 2 (canonicalOuterFactor F.toFun) := h17.2.2.2.1
  have hMf : IsInnerFunction (canonicalInnerFactor F.toFun) := h17.2.2.2.2.2.1
  have hF_fac : ∀ z ∈ Metric.ball (0 : ℂ) 1,
      F.toFun z = canonicalInnerFactor F.toFun z * canonicalOuterFactor F.toFun z :=
    h17.2.2.2.2.2.2.1
  let Q_F : HardyElem 2 := HardyElem.ofIsInHardySpace (canonicalOuterFactor F.toFun) hQf_h2
  have hQF_outer : IsOuterFunction Q_F.toFun := by
    obtain ⟨c, φ, hc, hφ_meas, hφ_pos, hφ_log, heq⟩ := hQf_outer
    refine ⟨c, φ, hc, hφ_meas, hφ_pos, hφ_log, fun z hz ↦ ?_⟩
    rw [HardyElem.ofIsInHardySpace_apply_of_mem _ _ hz]
    exact heq hz
  have hmul_QF : mulByInner hMf Q_F = F := by
    apply HardyElem.ext_ball
    intro z hz
    rw [mulByInner_apply_ball hMf Q_F hz, HardyElem.ofIsInHardySpace_apply_of_mem _ _ hz,
      ← hF_fac z hz]
  have hQF_top : generatedInvariantSubspace Q_F = ⊤ :=
    generatedInvariantSubspace_eq_top_of_isOuterFunction hPartB hQF_outer
  obtain ⟨hgenF_inv, hF_mem_gen, hgenF_min⟩ := isClosedInvariantSubspace_generatedInvariantSubspace F
  have hgen_eq_Mf : generatedInvariantSubspace F =
      innerSubspace (canonicalInnerFactor F.toFun) hMf := by
    refine le_antisymm ?_ ?_
    · exact hgenF_min _ (isClosedInvariantSubspace_innerSubspace hPartB hMf).1 ⟨Q_F, hmul_QF⟩
    · rintro _ ⟨G, rfl⟩
      let S_Q := Submodule.span ℂ (Set.range fun n : ℕ ↦ (mulZ^[n]) Q_F)
      have hG_mem : G ∈ closure (S_Q : Set (HardyElem 2)) := by
        rw [← S_Q.topologicalClosure_coe]
        change G ∈ generatedInvariantSubspace Q_F
        rw [hQF_top]
        exact Submodule.mem_top
      have hpre_closed :
          IsClosed ((mulByInner hMf) ⁻¹' (generatedInvariantSubspace F : Set (HardyElem 2))) :=
        hgenF_inv.1.preimage (mulByInner hMf).continuous
      have hSQ_le : S_Q ≤ (generatedInvariantSubspace F).comap (mulByInner hMf).toLinearMap := by
        rw [Submodule.span_le]
        rintro _ ⟨n, rfl⟩
        change mulByInner hMf ((mulZ^[n]) Q_F) ∈ generatedInvariantSubspace F
        rw [← mulZ_iterate_mulByInner, hmul_QF]
        exact mulZ_iterate_mem_of_invariant hgenF_inv.2 n hF_mem_gen
      exact closure_minimal hSQ_le hpre_closed hG_mem
  refine ⟨hMf, hgen_eq_Mf, ?_, ?_⟩
  · constructor
    · intro htop
      have hMf_top : innerSubspace (canonicalInnerFactor F.toFun) hMf =
          innerSubspace (fun _ ↦ (1 : ℂ)) (isInnerFunction_const norm_one) := by
        rw [← hgen_eq_Mf, htop, innerSubspace_one_eq_top]
      obtain ⟨c, hc, hMf_c⟩ :=
        (innerSubspace_eq_iff hPartB hMf (isInnerFunction_const norm_one)).mp hMf_top
      have hMf_const : ∃ c : ℂ, ‖c‖ = 1 ∧
          ∀ z ∈ Metric.ball (0 : ℂ) 1, canonicalInnerFactor F.toFun z = c :=
        ⟨c, hc, fun z hz ↦ by simpa using hMf_c z hz⟩
      exact h17.2.2.2.2.2.2.2.2.2.2.2.mp (h17.2.2.2.2.2.2.2.2.2.2.1.mpr hMf_const)
    · exact generatedInvariantSubspace_eq_top_of_isOuterFunction hPartB
  · intro G
    rw [← hgen_eq_Mf]
    change G ∈ (generatedInvariantSubspace F : Set (HardyElem 2)) ↔ _
    rw [generatedInvariantSubspace, Submodule.topologicalClosure_coe,
      (span_mulZ_iterate_eq_range_polyMulHardy F).1, Metric.mem_closure_iff]
    simp only [Set.mem_range, exists_exists_eq_and, dist_eq_norm]

end PartC

namespace PartD
open MeasureTheory Filter RudinRCA.Chapter04 RudinRCA.Chapter10
open scoped ENNReal Real ComplexConjugate Topology

/-! ### Basic `circlePoint` and `circleMeasure` bridges -/

theorem circlePoint_coe (t : ℝ) :
    circlePoint (t : FourierCircle) = Complex.exp ((t : ℂ) * Complex.I) :=
  rfl

@[continuity, fun_prop]
theorem continuous_circlePoint : Continuous circlePoint :=
  continuous_subtype_val.comp fourierCircleHomeomorphism.continuous

@[simp]
theorem norm_circlePoint (ζ : FourierCircle) : ‖circlePoint ζ‖ = 1 :=
  Circle.norm_coe _

theorem circlePoint_mem_sphere (ζ : FourierCircle) :
    circlePoint ζ ∈ Metric.sphere (0 : ℂ) 1 := by
  simp

theorem circlePoint_ne_zero (ζ : FourierCircle) : circlePoint ζ ≠ 0 := by
  intro h
  have hn := norm_circlePoint ζ
  rw [h, norm_zero] at hn
  exact zero_ne_one hn

@[simp]
theorem circlePoint_zero : circlePoint 0 = 1 := by
  rw [← QuotientAddGroup.mk_zero, circlePoint_coe]
  simp

theorem circlePoint_add (ζ η : FourierCircle) :
    circlePoint (ζ + η) = circlePoint ζ * circlePoint η := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
  obtain ⟨s, rfl⟩ := QuotientAddGroup.mk_surjective η
  change circlePoint (((t + s : ℝ) : FourierCircle)) = _
  rw [circlePoint_coe, circlePoint_coe, circlePoint_coe]
  push_cast
  rw [add_mul, Complex.exp_add]

theorem circlePoint_neg (ζ : FourierCircle) :
    circlePoint (-ζ) = conj (circlePoint ζ) := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
  change circlePoint (((-t : ℝ) : FourierCircle)) = _
  rw [circlePoint_coe, circlePoint_coe, ← Complex.exp_conj]
  congr 1
  simp

theorem circlePoint_inv (ζ : FourierCircle) :
    (circlePoint ζ)⁻¹ = circlePoint (-ζ) := by
  rw [circlePoint_neg]
  exact Circle.coe_inv_eq_conj (fourierCircleHomeomorphism ζ)

theorem circlePoint_sub (ζ η : FourierCircle) :
    circlePoint (ζ - η) = circlePoint ζ * (circlePoint η)⁻¹ := by
  rw [sub_eq_add_neg, circlePoint_add, circlePoint_inv]

/-- Normalized Haar integral of a radial slice on `FourierCircle` equals `Real.circleAverage`. -/
theorem integral_radialSlice_eq_circleAverage {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] (G : ℂ → E) (r : ℝ) :
    (∫ ζ, G ((r : ℂ) * circlePoint ζ) ∂circleMeasure) = Real.circleAverage G 0 r := by
  rw [AddCircle.integral_haarAddCircle,
    ← AddCircle.intervalIntegral_preimage (2 * Real.pi) 0
      (fun ζ : FourierCircle ↦ G ((r : ℂ) * circlePoint ζ)),
    zero_add, Real.circleAverage_def]
  congr 2
  ext θ
  simp [circleMap]

/-- Mean value property on `FourierCircle` for holomorphic functions on `Metric.ball 0 1`. -/
theorem integral_radialSlice_eq_eval_zero {g : ℂ → ℂ}
    (hg : HolomorphicOn g (Metric.ball (0 : ℂ) 1)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (∫ ζ, radialSlice g r ζ ∂circleMeasure) = g 0 := by
  unfold radialSlice
  rw [integral_radialSlice_eq_circleAverage]
  have hsub : Metric.closedBall (0 : ℂ) |r| ⊆ Metric.ball (0 : ℂ) 1 := by
    rw [abs_of_nonneg hr0]
    exact Metric.closedBall_subset_ball hr1
  have hg_diff : DifferentiableOn ℂ g (Metric.ball (0 : ℂ) 1) :=
    (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hg
  have hdcc : DiffContOnCl ℂ g (Metric.ball (0 : ℂ) |r|) := by
    refine ⟨hg_diff.mono (Metric.ball_subset_closedBall.trans hsub), ?_⟩
    exact hg_diff.continuousOn.mono (Metric.closure_ball_subset_closedBall.trans hsub)
  exact hdcc.circleAverage

theorem continuous_radialSlice_of_continuousOn {E : Type*} [TopologicalSpace E]
    {g : ℂ → E} (hg : ContinuousOn g (Metric.ball (0 : ℂ) 1))
    {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Continuous (fun ζ : FourierCircle ↦ g ((r : ℂ) * circlePoint ζ)) := by
  refine hg.comp_continuous (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_
  rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hr0, norm_circlePoint, mul_one]
  exact hr1

private theorem continuous_integrable_of_compact {X E : Type*}
    [TopologicalSpace X] [CompactSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [NormedAddCommGroup E] [SecondCountableTopology E] {μ : Measure X} [IsFiniteMeasure μ]
    {f : X → E} (hf : Continuous f) : Integrable f μ := by
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hf.continuousOn
  exact Integrable.of_bound hf.aestronglyMeasurable C
    (Eventually.of_forall fun x ↦ hC x (Set.mem_univ x))

private theorem continuous_memLp_of_compact {X E : Type*}
    [TopologicalSpace X] [CompactSpace X] [MeasurableSpace X] [OpensMeasurableSpace X]
    [NormedAddCommGroup E] [SecondCountableTopology E] {μ : Measure X} [IsFiniteMeasure μ]
    {p : ℝ≥0∞} {f : X → E} (hf : Continuous f) : MemLp f p μ := by
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hf.continuousOn
  exact MemLp.of_bound hf.aestronglyMeasurable C
    (Eventually.of_forall fun x ↦ hC x (Set.mem_univ x))

private theorem one_lt_toReal_of_one_lt {p : ℝ≥0∞} (hp1 : 1 < p) (hptop : p ≠ ⊤) :
    1 < p.toReal := by
  by_contra hnot
  have hle : p.toReal ≤ 1 := le_of_not_gt hnot
  have hp_le : p ≤ 1 := by
    rw [← ENNReal.ofReal_toReal hptop, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hle
  exact not_lt_of_ge hp_le hp1

/-! ### 17.24: Formulation of the Harmonic Conjugate Problem (pp. 350–351) -/

/-- Normalized harmonic conjugate on the open unit disc `U = Metric.ball 0 1`:
`u + i v` is holomorphic on `U` and `v(0) = 0`. -/
def IsNormalizedHarmonicConjugate (u v : ℂ → ℝ) : Prop :=
  HolomorphicOn (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I) (Metric.ball (0 : ℂ) 1) ∧ v 0 = 0

/-- Rudin's Herglotz operator `ψh(z) = ∫_T ((ζ + z) / (ζ - z)) h(ζ) dσ(ζ)` (17.24(2)). -/
def herglotzTransform (h : FourierCircle → ℂ) (z : ℂ) : ℂ :=
  ∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) * h ζ ∂circleMeasure

/-- `L^p(T)` version of Rudin's Herglotz operator `ψ`. -/
def herglotzTransformLp (p : ℝ≥0∞) (h : CircleLp p) (z : ℂ) : ℂ :=
  herglotzTransform (h : FourierCircle → ℂ) z

/-- Poisson integral on `FourierCircle` against normalized Haar measure `σ`. -/
def circlePoissonIntegral {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (h : FourierCircle → E) (z : ℂ) : E :=
  ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • h ζ ∂circleMeasure

private theorem holomorphic_re_zero_is_const {D : Set ℂ} (hD_open : IsOpen D)
    (hD_conn : IsPreconnected D) {f : ℂ → ℂ} (hf : DifferentiableOn ℂ f D)
    (hre : ∀ z ∈ D, (f z).re = 0) {z w : ℂ} (hz : z ∈ D) (hw : w ∈ D) :
    f z = f w := by
  refine hD_open.is_const_of_deriv_eq_zero hD_conn hf (fun a ha ↦ ?_) hz hw
  obtain ⟨hdr, hcr⟩ := differentiableAt_complex_iff_differentiableAt_real.mp
    (hf.differentiableAt (hD_open.mem_nhds ha))
  rw [complexOfReal_deriv hdr hcr]
  have hre_fderiv : HasFDerivAt (fun x : ℂ ↦ (f x).re)
      (Complex.reCLM.comp (fderiv ℝ f a)) a :=
    Complex.reCLM.hasFDerivAt.comp a hdr.hasFDerivAt
  have hre_zero : HasFDerivAt (fun x : ℂ ↦ (f x).re) (0 : ℂ →L[ℝ] ℝ) a := by
    refine (hasFDerivAt_const (0 : ℝ) a).congr_of_eventuallyEq ?_
    filter_upwards [hD_open.mem_nhds ha] with x hx
    exact hre x hx
  have hclm_eq : Complex.reCLM.comp (fderiv ℝ f a) = 0 := hre_fderiv.unique hre_zero
  have h1_re : (fderiv ℝ f a 1).re = 0 := by
    simpa using ContinuousLinearMap.ext_iff.mp hclm_eq 1
  have hI_re : (fderiv ℝ f a Complex.I).re = 0 := by
    simpa using ContinuousLinearMap.ext_iff.mp hclm_eq Complex.I
  rw [hcr] at hI_re
  have h1_im : (fderiv ℝ f a 1).im = 0 := by
    have : -(fderiv ℝ f a 1).im = 0 := by simpa [smul_eq_mul, Complex.mul_re] using hI_re
    linarith
  exact Complex.ext h1_re h1_im

/-- Uniqueness on `Metric.ball 0 1` of the normalized harmonic conjugate (`v(0) = 0`). -/
theorem normalizedHarmonicConjugate_unique {u v₁ v₂ : ℂ → ℝ}
    (hv₁ : IsNormalizedHarmonicConjugate u v₁) (hv₂ : IsNormalizedHarmonicConjugate u v₂) :
    Set.EqOn v₁ v₂ (Metric.ball (0 : ℂ) 1) := by
  intro z hz
  let F₁ : ℂ → ℂ := fun w ↦ (u w : ℂ) + (v₁ w : ℂ) * Complex.I
  let F₂ : ℂ → ℂ := fun w ↦ (u w : ℂ) + (v₂ w : ℂ) * Complex.I
  have hdiff : DifferentiableOn ℂ (fun w ↦ F₁ w - F₂ w) (Metric.ball (0 : ℂ) 1) :=
    ((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hv₁.1).sub
      ((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hv₂.1)
  have hre : ∀ w ∈ Metric.ball (0 : ℂ) 1, (F₁ w - F₂ w).re = 0 := by
    intro w _
    simp [F₁, F₂]
  have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
  have heq := holomorphic_re_zero_is_const Metric.isOpen_ball
    (convex_ball (0 : ℂ) 1).isPreconnected hdiff hre hz h0_mem
  have him := congr_arg Complex.im heq
  simp only [F₁, F₂, Complex.sub_im, Complex.add_im, Complex.ofReal_im, Complex.mul_im,
    Complex.ofReal_re, Complex.I_re, Complex.I_im, Complex.zero_im, mul_zero, mul_one,
    zero_add, add_zero, hv₁.2, hv₂.2, sub_self] at him
  linarith

/-- Existence of a normalized harmonic conjugate on `Metric.ball 0 1` for every real harmonic `u`. -/
theorem exists_normalizedHarmonicConjugate {u : ℂ → ℝ}
    (hu : RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1)) :
    ∃ v : ℂ → ℝ, IsNormalizedHarmonicConjugate u v ∧
      RudinRCA.Chapter11.HarmonicOn v (Metric.ball (0 : ℂ) 1) := by
  obtain ⟨F, hF_diff, hF_re⟩ := (RudinRCA.Chapter11.theorem11_10 (a := 0) (R := 1) zero_lt_one).2 hu
  let v : ℂ → ℝ := fun z ↦ (F z).im - (F 0).im
  let G : ℂ → ℂ := fun z ↦ F z - ((F 0).im : ℂ) * Complex.I
  have hG_diff : DifferentiableOn ℂ G (Metric.ball (0 : ℂ) 1) :=
    hF_diff.sub_const (((F 0).im : ℂ) * Complex.I)
  have hG_eq : ∀ z ∈ Metric.ball (0 : ℂ) 1,
      (u z : ℂ) + (v z : ℂ) * Complex.I = G z := by
    intro z hz
    dsimp [G, v]
    have hre := hF_re z hz
    apply Complex.ext <;> simp [hre]
  have hholo : HolomorphicOn (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I) (Metric.ball (0 : ℂ) 1) :=
    (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr (hG_diff.congr hG_eq)
  have hv_harm : RudinRCA.Chapter11.HarmonicOn v (Metric.ball (0 : ℂ) 1) := by
    have hG_harm := RudinRCA.Chapter11.node11_4_holomorphic_harmonic Metric.isOpen_ball hG_diff
    have him_harm := hG_harm.comp_clm Metric.isOpen_ball Complex.imCLM
    refine him_harm.congr_of_isOpen Metric.isOpen_ball fun z _ ↦ ?_
    simp [G, v]
  exact ⟨v, ⟨hholo, sub_self _⟩, hv_harm⟩

theorem herglotzTransform_congr_ae {h₁ h₂ : FourierCircle → ℂ}
    (heq : h₁ =ᵐ[circleMeasure] h₂) (z : ℂ) :
    herglotzTransform h₁ z = herglotzTransform h₂ z := by
  unfold herglotzTransform
  refine integral_congr_ae (heq.mono fun ζ hζ ↦ ?_)
  dsimp only
  rw [hζ]

theorem norm_circlePoint_sub_ge (z : ℂ) (ζ : FourierCircle) :
    |1 - ‖z‖| ≤ ‖circlePoint ζ - z‖ := by
  have h := abs_norm_sub_norm_le (circlePoint ζ) z
  rwa [norm_circlePoint] at h

theorem norm_herglotzKernel_le {z : ℂ} (hz : ‖z‖ < 1) (ζ : FourierCircle) :
    ‖(circlePoint ζ + z) / (circlePoint ζ - z)‖ ≤ (1 + ‖z‖) / (1 - ‖z‖) := by
  have hden_pos : 0 < 1 - ‖z‖ := sub_pos.mpr hz
  have hden_le : 1 - ‖z‖ ≤ ‖circlePoint ζ - z‖ := by
    have h := norm_circlePoint_sub_ge z ζ
    rwa [abs_of_pos hden_pos] at h
  have hnum_le : ‖circlePoint ζ + z‖ ≤ 1 + ‖z‖ := by
    calc ‖circlePoint ζ + z‖ ≤ ‖circlePoint ζ‖ + ‖z‖ := norm_add_le _ _
      _ = 1 + ‖z‖ := by rw [norm_circlePoint]
  rw [norm_div]
  exact div_le_div₀ (by positivity) hnum_le hden_pos hden_le

theorem integrable_herglotzIntegrand {h : FourierCircle → ℂ}
    (hh : Integrable h circleMeasure) {z : ℂ} (hz : ‖z‖ ≠ 1) :
    Integrable (fun ζ ↦ ((circlePoint ζ + z) / (circlePoint ζ - z)) * h ζ) circleMeasure := by
  have hcont : Continuous (fun ζ : FourierCircle ↦ (circlePoint ζ + z) / (circlePoint ζ - z)) := by
    refine Continuous.div (continuous_circlePoint.add continuous_const)
      (continuous_circlePoint.sub continuous_const) fun ζ h0 ↦ hz ?_
    have heq : circlePoint ζ = z := sub_eq_zero.mp h0
    rw [← heq, norm_circlePoint]
  obtain ⟨C, hC⟩ := isCompact_univ.exists_bound_of_continuousOn hcont.continuousOn
  exact hh.bdd_mul hcont.aestronglyMeasurable (Eventually.of_forall fun ζ ↦ hC ζ (Set.mem_univ ζ))

theorem herglotzTransform_add {h₁ h₂ : FourierCircle → ℂ}
    (hh₁ : Integrable h₁ circleMeasure) (hh₂ : Integrable h₂ circleMeasure)
    {z : ℂ} (hz : ‖z‖ ≠ 1) :
    herglotzTransform (fun ζ ↦ h₁ ζ + h₂ ζ) z =
      herglotzTransform h₁ z + herglotzTransform h₂ z := by
  unfold herglotzTransform
  have heq : (fun ζ ↦ ((circlePoint ζ + z) / (circlePoint ζ - z)) * (h₁ ζ + h₂ ζ)) =
      fun ζ ↦ ((circlePoint ζ + z) / (circlePoint ζ - z)) * h₁ ζ +
        ((circlePoint ζ + z) / (circlePoint ζ - z)) * h₂ ζ := by
    ext ζ; ring
  rw [heq]
  exact integral_add (integrable_herglotzIntegrand hh₁ hz) (integrable_herglotzIntegrand hh₂ hz)

theorem herglotzTransform_sub {h₁ h₂ : FourierCircle → ℂ}
    (hh₁ : Integrable h₁ circleMeasure) (hh₂ : Integrable h₂ circleMeasure)
    {z : ℂ} (hz : ‖z‖ ≠ 1) :
    herglotzTransform (fun ζ ↦ h₁ ζ - h₂ ζ) z =
      herglotzTransform h₁ z - herglotzTransform h₂ z := by
  unfold herglotzTransform
  have heq : (fun ζ ↦ ((circlePoint ζ + z) / (circlePoint ζ - z)) * (h₁ ζ - h₂ ζ)) =
      fun ζ ↦ ((circlePoint ζ + z) / (circlePoint ζ - z)) * h₁ ζ -
        ((circlePoint ζ + z) / (circlePoint ζ - z)) * h₂ ζ := by
    ext ζ; ring
  rw [heq]
  exact integral_sub (integrable_herglotzIntegrand hh₁ hz) (integrable_herglotzIntegrand hh₂ hz)

theorem herglotzTransform_const_mul (c : ℂ) (h : FourierCircle → ℂ) (z : ℂ) :
    herglotzTransform (fun ζ ↦ c * h ζ) z = c * herglotzTransform h z := by
  unfold herglotzTransform
  have heq : (fun ζ ↦ ((circlePoint ζ + z) / (circlePoint ζ - z)) * (c * h ζ)) =
      fun ζ ↦ c * (((circlePoint ζ + z) / (circlePoint ζ - z)) * h ζ) := by
    ext ζ; ring
  rw [heq, integral_const_mul]

/-- Parametric differentiation of `herglotzTransform h` off the unit circle. -/
theorem hasDerivAt_herglotzTransform {h : FourierCircle → ℂ}
    (hh : Integrable h circleMeasure) {z : ℂ} (hz : ‖z‖ ≠ 1) :
    HasDerivAt (herglotzTransform h)
      (∫ ζ, (2 * circlePoint ζ / (circlePoint ζ - z) ^ 2) * h ζ ∂circleMeasure) z := by
  let d : ℝ := |1 - ‖z‖| / 2
  have hd_pos : 0 < d := half_pos (abs_pos.mpr (sub_ne_zero.mpr hz.symm))
  have hdist : ∀ x ∈ Metric.ball z d, ∀ ζ : FourierCircle, d ≤ ‖circlePoint ζ - x‖ := by
    intro x hx ζ
    have hxz : ‖x - z‖ < d := by simpa [Metric.mem_ball, dist_eq_norm] using hx
    have h1 : |1 - ‖z‖| ≤ ‖circlePoint ζ - z‖ := norm_circlePoint_sub_ge z ζ
    have h2 : ‖circlePoint ζ - z‖ ≤ ‖circlePoint ζ - x‖ + ‖x - z‖ :=
      norm_sub_le_norm_sub_add_norm_sub (circlePoint ζ) x z
    dsimp [d] at hxz ⊢
    linarith
  refine (hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (F := fun x ζ ↦ ((circlePoint ζ + x) / (circlePoint ζ - x)) * h ζ)
    (F' := fun x ζ ↦ (2 * circlePoint ζ / (circlePoint ζ - x) ^ 2) * h ζ)
    (bound := fun ζ ↦ (2 / d ^ 2) * ‖h ζ‖)
    (Metric.ball_mem_nhds z hd_pos) ?_ (integrable_herglotzIntegrand hh hz) ?_ ?_ ?_ ?_).2
  · exact Eventually.of_forall fun x ↦
      (Measurable.aestronglyMeasurable (by fun_prop)).mul hh.aestronglyMeasurable
  · exact (Measurable.aestronglyMeasurable (by fun_prop)).mul hh.aestronglyMeasurable
  · refine Eventually.of_forall fun ζ x hx ↦ ?_
    have hdx : d ≤ ‖circlePoint ζ - x‖ := hdist x hx ζ
    rw [norm_mul, norm_div, norm_mul, norm_pow, norm_circlePoint, mul_one]
    have h2 : ‖(2 : ℂ)‖ = 2 := by norm_num
    rw [h2]
    refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
    exact div_le_div_of_nonneg_left zero_le_two (pow_pos hd_pos 2)
      (pow_le_pow_left₀ hd_pos.le hdx 2)
  · exact hh.norm.const_mul (2 / d ^ 2)
  · refine Eventually.of_forall fun ζ x hx ↦ ?_
    have hne : circlePoint ζ - x ≠ 0 :=
      norm_pos_iff.mp (lt_of_lt_of_le hd_pos (hdist x hx ζ))
    have hd_quot : HasDerivAt (fun w ↦ (circlePoint ζ + w) / (circlePoint ζ - w))
        (2 * circlePoint ζ / (circlePoint ζ - x) ^ 2) x := by
      have h3 := ((hasDerivAt_id' x).const_add (circlePoint ζ)).div
        ((hasDerivAt_id' x).const_sub (circlePoint ζ)) hne
      refine h3.congr_deriv ?_
      ring
    exact hd_quot.mul_const (h ζ)

/-- For every `h ∈ L¹(T)`, `herglotzTransform h` is holomorphic on `U = Metric.ball 0 1`. -/
theorem holomorphicOn_herglotzTransform {h : FourierCircle → ℂ}
    (hh : Integrable h circleMeasure) :
    HolomorphicOn (herglotzTransform h) (Metric.ball (0 : ℂ) 1) := by
  intro z hz
  have hnorm : ‖z‖ ≠ 1 := (mem_ball_zero_iff.mp hz).ne
  exact (hasDerivAt_herglotzTransform hh hnorm).differentiableAt

@[simp]
theorem herglotzTransform_zero_eval (h : FourierCircle → ℂ) :
    herglotzTransform h 0 = ∫ ζ, h ζ ∂circleMeasure := by
  unfold herglotzTransform
  refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
  dsimp only
  rw [add_zero, sub_zero, div_self (circlePoint_ne_zero ζ), one_mul]

theorem herglotzTransform_const {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) (c : ℂ) :
    herglotzTransform (fun _ ↦ c) z = c := by
  have hz_lt : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
  unfold herglotzTransform
  have h1 : (∫ ζ, ((circlePoint ζ + z) / (circlePoint ζ - z)) * c ∂circleMeasure) =
      (∫ ζ, (circlePoint ζ + z) / (circlePoint ζ - z) ∂circleMeasure) * c :=
    integral_mul_const c _
  rw [h1]
  suffices hkern : (∫ ζ, (circlePoint ζ + z) / (circlePoint ζ - z) ∂circleMeasure) = 1 by
    rw [hkern, one_mul]
  let F : ℂ → ℂ := herglotzTransform (fun _ ↦ (1 : ℂ))
  have hF_diff : DifferentiableOn ℂ F (Metric.ball (0 : ℂ) 1) :=
    (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp
      (holomorphicOn_herglotzTransform (integrable_const (1 : ℂ)))
  have hF_re : ∀ w ∈ Metric.ball (0 : ℂ) 1, (F w - 1).re = 0 := by
    intro w hw
    have hw_lt : ‖w‖ < 1 := mem_ball_zero_iff.mp hw
    have hint := integrable_herglotzIntegrand (h := fun _ ↦ (1 : ℂ)) (integrable_const 1) hw_lt.ne
    have hre_int : (F w).re = ∫ ζ, ((circlePoint ζ + w) / (circlePoint ζ - w)).re ∂circleMeasure := by
      simpa [F, herglotzTransform] using (Complex.reCLM.integral_comp_comm hint).symm
    have hca : (∫ ζ, ((circlePoint ζ + w) / (circlePoint ζ - w)).re ∂circleMeasure) =
        Real.circleAverage (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re • (1 : ℝ)) 0 1 := by
      simpa [one_mul, smul_eq_mul] using
        integral_radialSlice_eq_circleAverage (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re) 1
    have hdcc : DiffContOnCl ℂ (fun _ : ℂ ↦ (1 : ℂ)) (Metric.ball (0 : ℂ) 1) :=
      ⟨differentiableOn_const 1, continuousOn_const⟩
    have hpif := congr_arg Complex.re (hdcc.circleAverage_re_herglotzRieszKernel_smul' hw)
    have hpif' : Real.circleAverage (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re • (1 : ℝ)) 0 1 = 1 := by
      have hci : CircleIntegrable (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re • (1 : ℂ)) 0 1 := by
        have hw_not : w ∉ Metric.sphere (0 : ℂ) |(1 : ℝ)| := by
          rw [abs_of_pos zero_lt_one, Metric.mem_sphere, dist_zero_right]
          exact hw_lt.ne
        have hck := Complex.continuous_re.comp_continuousOn
          (continuousOn_herglotzRieszKernel_sphere hw_not)
        rw [abs_of_pos zero_lt_one] at hck
        have hck' : ContinuousOn (fun ξ : ℂ ↦ ((ξ + w) / (ξ - w)).re) (Metric.sphere 0 1) := by
          simpa [Function.comp_def, herglotzRieszKernel_def] using hck
        exact (hck'.smul continuousOn_const).circleIntegrable zero_le_one
      have hcomm := (Complex.reCLM.circleAverage_comp_comm hci).trans
        (by simpa [sub_zero] using hpif)
      exact (Real.circleAverage_congr_sphere fun ξ _ ↦ by simp [Complex.real_smul]).trans hcomm
    rw [Complex.sub_re, Complex.one_re, hre_int, hca, hpif', sub_self]
  have heq := holomorphic_re_zero_is_const Metric.isOpen_ball (convex_ball (0 : ℂ) 1).isPreconnected
    (hF_diff.sub_const 1) hF_re hz (Metric.mem_ball_self zero_lt_one)
  have hF0 : F 0 = 1 := by simp [F, Measure.real]
  rw [hF0, sub_self] at heq
  simpa [F, herglotzTransform] using sub_eq_zero.mp heq

/-- For real-valued `h ∈ L¹(T)`, `Re (ψh(z))` is the Poisson integral of `h`, `Im (ψh(0)) = 0`,
and `Im (ψh)` is the unique normalized harmonic conjugate of `Re (ψh)` on `U`. -/
theorem herglotzTransform_real_properties {h : FourierCircle → ℂ}
    (hh : Integrable h circleMeasure) (hreal : ∀ ζ, (h ζ).im = 0) :
    (∀ z ∈ Metric.ball (0 : ℂ) 1,
      (herglotzTransform h z).re = circlePoissonIntegral (fun ζ ↦ (h ζ).re) z) ∧
    (herglotzTransform h 0).im = 0 ∧
    IsNormalizedHarmonicConjugate
      (fun z ↦ (herglotzTransform h z).re) (fun z ↦ (herglotzTransform h z).im) ∧
    IsNormalizedHarmonicConjugate
      (circlePoissonIntegral (fun ζ ↦ (h ζ).re)) (fun z ↦ (herglotzTransform h z).im) := by
  have hre_eq : ∀ z ∈ Metric.ball (0 : ℂ) 1,
      (herglotzTransform h z).re = circlePoissonIntegral (fun ζ ↦ (h ζ).re) z := by
    intro z hz
    have hz_ne : ‖z‖ ≠ 1 := (mem_ball_zero_iff.mp hz).ne
    have hint := integrable_herglotzIntegrand hh hz_ne
    have hcomm := (Complex.reCLM.integral_comp_comm hint).symm
    change (herglotzTransform h z).re = _ at hcomm
    rw [hcomm]
    unfold circlePoissonIntegral
    refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
    have hpk : _root_.poissonKernel 0 z (circlePoint ζ) =
        ((circlePoint ζ + z) / (circlePoint ζ - z)).re := by
      have h1 := congr_fun (poissonKernel_eq_re_herglotzRieszKernel (c := 0) (w := z)) (circlePoint ζ)
      simpa [herglotzRieszKernel_def] using h1
    simp [Complex.mul_re, hreal ζ, hpk]
  have him0 : (herglotzTransform h 0).im = 0 := by
    rw [herglotzTransform_zero_eval]
    have hcomm := (Complex.imCLM.integral_comp_comm hh).symm
    change (∫ ζ, h ζ ∂circleMeasure).im = _ at hcomm
    rw [hcomm]
    simp [hreal]
  have hholo := holomorphicOn_herglotzTransform hh
  have hconj1 : IsNormalizedHarmonicConjugate
      (fun z ↦ (herglotzTransform h z).re) (fun z ↦ (herglotzTransform h z).im) := by
    refine ⟨?_, him0⟩
    intro z hz
    refine (hholo z hz).congr_of_eventuallyEq (Eventually.of_forall fun w ↦ ?_)
    dsimp only
    exact Complex.re_add_im (herglotzTransform h w)
  have hconj2 : IsNormalizedHarmonicConjugate
      (circlePoissonIntegral (fun ζ ↦ (h ζ).re)) (fun z ↦ (herglotzTransform h z).im) := by
    refine ⟨?_, him0⟩
    refine (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr ?_
    refine ((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hconj1.1).congr fun z hz ↦ ?_
    dsimp only
    rw [hre_eq z hz]
  exact ⟨hre_eq, him0, hconj1, hconj2⟩

/-- **17.24 Setup (pp. 350–351):**
(a) Every real harmonic function `u` on `U = Metric.ball 0 1` admits a normalized harmonic conjugate
    `v` (`v(0) = 0`), unique on `U`;
(b) For every `h ∈ L¹(T)`, `ψh = herglotzTransform h` is holomorphic on `U`;
(c) If `h ∈ L¹(T)` is real-valued, `Re (ψh)` is the Poisson integral of `h` on `U`,
    `Im (ψh(0)) = 0`, and `Im (ψh)` is the unique normalized harmonic conjugate of `Re (ψh)`.
The full node `theorem17_24` below combines these with the affirmative `1 < p < ∞` transfer
(`harmonicConjugate_hardy_bound`) and the `p = 1, ∞` endpoint counterexamples
(`node17_24_endpoint_one_counterexample`, `node17_24_endpoint_top_counterexample`). -/
theorem theorem17_24_setup :
    (∀ {u : ℂ → ℝ}, RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1) →
      (∃ v : ℂ → ℝ, IsNormalizedHarmonicConjugate u v ∧
        RudinRCA.Chapter11.HarmonicOn v (Metric.ball (0 : ℂ) 1)) ∧
      ∀ {v₁ v₂ : ℂ → ℝ}, IsNormalizedHarmonicConjugate u v₁ →
        IsNormalizedHarmonicConjugate u v₂ → Set.EqOn v₁ v₂ (Metric.ball (0 : ℂ) 1)) ∧
    (∀ {h : FourierCircle → ℂ}, Integrable h circleMeasure →
      HolomorphicOn (herglotzTransform h) (Metric.ball (0 : ℂ) 1)) ∧
    (∀ {h : FourierCircle → ℂ}, Integrable h circleMeasure → (∀ ζ, (h ζ).im = 0) →
      (∀ z ∈ Metric.ball (0 : ℂ) 1,
        (herglotzTransform h z).re = circlePoissonIntegral (fun ζ ↦ (h ζ).re) z) ∧
      (herglotzTransform h 0).im = 0 ∧
      IsNormalizedHarmonicConjugate
        (fun z ↦ (herglotzTransform h z).re) (fun z ↦ (herglotzTransform h z).im)) :=
  ⟨fun hu ↦ ⟨exists_normalizedHarmonicConjugate hu,
      fun hv₁ hv₂ ↦ normalizedHarmonicConjugate_unique hv₁ hv₂⟩,
   fun hh ↦ holomorphicOn_herglotzTransform hh,
   fun hh hreal ↦
     let ⟨h1, h2, h3, _⟩ := herglotzTransform_real_properties hh hreal
     ⟨h1, h2, h3⟩⟩

/-! ### 17.25: Elementary Trigonometric Inequality (Lemma, p. 351) -/

/-- `δ = π / (1 + p)` in Rudin's Lemma 17.25. -/
def rieszDelta (p : ℝ) : ℝ :=
  Real.pi / (1 + p)

/-- `α = 1 / cos δ` in Rudin's Lemma 17.25. -/
def rieszAlpha (p : ℝ) : ℝ :=
  1 / Real.cos (rieszDelta p)

/-- `β = α^p (1 + α)` in Rudin's Lemma 17.25. -/
def rieszBeta (p : ℝ) : ℝ :=
  (rieszAlpha p) ^ p * (1 + rieszAlpha p)

theorem rieszDelta_mem_Ioo {p : ℝ} (hp1 : 1 < p) :
    rieszDelta p ∈ Set.Ioo 0 (Real.pi / 2) := by
  unfold rieszDelta
  refine ⟨div_pos Real.pi_pos (by linarith), ?_⟩
  exact div_lt_div_of_pos_left Real.pi_pos zero_lt_two (by linarith)

theorem cos_rieszDelta_pos {p : ℝ} (hp1 : 1 < p) :
    0 < Real.cos (rieszDelta p) := by
  have hδ := rieszDelta_mem_Ioo hp1
  exact Real.cos_pos_of_mem_Ioo ⟨by linarith [Real.pi_pos, hδ.1], hδ.2⟩

theorem rieszAlpha_pos {p : ℝ} (hp1 : 1 < p) :
    0 < rieszAlpha p :=
  one_div_pos.mpr (cos_rieszDelta_pos hp1)

theorem rieszBeta_pos {p : ℝ} (hp1 : 1 < p) :
    0 < rieszBeta p := by
  have hα := rieszAlpha_pos hp1
  exact mul_pos (Real.rpow_pos_of_pos hα p) (by linarith)

/-- **17.25 (Lemma, p. 351):** For `1 < p ≤ 2`, with `δ = π / (1 + p)`, `α = 1 / cos δ`, and
`β = α^p (1 + α)`, we have `0 < α`, `0 < β`, and
`1 ≤ β (cos φ)^p - α cos(p φ)` for all `φ ∈ [-π/2, π/2]`. -/
theorem theorem17_25 {p : ℝ} (hp1 : 1 < p) (hp2 : p ≤ 2) :
    0 < rieszAlpha p ∧ 0 < rieszBeta p ∧
      ∀ φ ∈ Set.Icc (-Real.pi / 2) (Real.pi / 2),
        1 ≤ rieszBeta p * (Real.cos φ) ^ p - rieszAlpha p * Real.cos (p * φ) := by
  have hα_pos : 0 < rieszAlpha p := rieszAlpha_pos hp1
  have hβ_pos : 0 < rieszBeta p := rieszBeta_pos hp1
  have hcosδ_pos : 0 < Real.cos (rieszDelta p) := cos_rieszDelta_pos hp1
  have hα_mul_cosδ : rieszAlpha p * Real.cos (rieszDelta p) = 1 :=
    one_div_mul_cancel hcosδ_pos.ne'
  have hδ := rieszDelta_mem_Ioo hp1
  refine ⟨hα_pos, hβ_pos, fun φ hφ ↦ ?_⟩
  let ψ : ℝ := |φ|
  have hψ0 : 0 ≤ ψ := abs_nonneg φ
  have hψ_pi2 : ψ ≤ Real.pi / 2 := abs_le.mpr ⟨by linarith [hφ.1], hφ.2⟩
  have hcos_eq : Real.cos φ = Real.cos ψ := (Real.cos_abs φ).symm
  have hcosp_eq : Real.cos (p * φ) = Real.cos (p * ψ) := by
    have hp_abs : p * ψ = |p * φ| := by
      dsimp [ψ]
      rw [abs_mul, abs_of_pos (by linarith : 0 < p)]
    rw [hp_abs, Real.cos_abs]
  rw [hcos_eq, hcosp_eq]
  rcases le_total ψ (rieszDelta p) with hle | hge
  · -- Case `0 ≤ ψ ≤ δ`: `cos ψ ≥ cos δ = α⁻¹`, while `cos(p ψ) ≤ 1`.
    have hcos_ge : Real.cos (rieszDelta p) ≤ Real.cos ψ :=
      Real.antitoneOn_cos
        ⟨hψ0, hle.trans (hδ.2.le.trans (by linarith [Real.pi_pos]))⟩
        ⟨hδ.1.le, hδ.2.le.trans (by linarith [Real.pi_pos])⟩ hle
    have hrpow_ge : (Real.cos (rieszDelta p)) ^ p ≤ (Real.cos ψ) ^ p :=
      Real.rpow_le_rpow hcosδ_pos.le hcos_ge (by linarith)
    have hprod1 : (rieszAlpha p) ^ p * (Real.cos (rieszDelta p)) ^ p = 1 := by
      rw [← Real.mul_rpow hα_pos.le hcosδ_pos.le, hα_mul_cosδ, Real.one_rpow]
    have hterm1 : 1 + rieszAlpha p ≤ rieszBeta p * (Real.cos ψ) ^ p := by
      calc 1 + rieszAlpha p
          = (1 + rieszAlpha p) * ((rieszAlpha p) ^ p * (Real.cos (rieszDelta p)) ^ p) := by
            rw [hprod1, mul_one]
        _ ≤ (1 + rieszAlpha p) * ((rieszAlpha p) ^ p * (Real.cos ψ) ^ p) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_left hrpow_ge (Real.rpow_nonneg hα_pos.le p)) (by linarith)
        _ = rieszBeta p * (Real.cos ψ) ^ p := by unfold rieszBeta; ring
    have hterm2 : rieszAlpha p * Real.cos (p * ψ) ≤ rieszAlpha p := by
      calc rieszAlpha p * Real.cos (p * ψ) ≤ rieszAlpha p * 1 :=
            mul_le_mul_of_nonneg_left (Real.cos_le_one _) hα_pos.le
        _ = rieszAlpha p := mul_one _
    linarith
  · -- Case `δ ≤ ψ ≤ π/2`: `π - δ = p δ ≤ p ψ ≤ π`, so `cos(p ψ) ≤ cos(π - δ) = -cos δ`.
    have hpδ : p * rieszDelta p = Real.pi - rieszDelta p := by
      have h1 : (1 + p) * rieszDelta p = Real.pi := mul_div_cancel₀ Real.pi (by linarith)
      linarith
    have hpψ_lo : Real.pi - rieszDelta p ≤ p * ψ := by
      rw [← hpδ]
      exact mul_le_mul_of_nonneg_left hge (by linarith)
    have hpψ_hi : p * ψ ≤ Real.pi := by nlinarith
    have hcosp_le : Real.cos (p * ψ) ≤ -Real.cos (rieszDelta p) := by
      rw [← Real.cos_pi_sub]
      exact Real.antitoneOn_cos
        ⟨by linarith [hδ.2, Real.pi_pos], by linarith [hδ.1]⟩
        ⟨by linarith [hδ.2, Real.pi_pos, hpψ_lo], hpψ_hi⟩ hpψ_lo
    have hterm2 : rieszAlpha p * Real.cos (p * ψ) ≤ -1 := by
      calc rieszAlpha p * Real.cos (p * ψ)
          ≤ rieszAlpha p * (-Real.cos (rieszDelta p)) :=
            mul_le_mul_of_nonneg_left hcosp_le hα_pos.le
        _ = -(rieszAlpha p * Real.cos (rieszDelta p)) := by ring
        _ = -1 := by rw [hα_mul_cosδ]
    have hcosψ_nn : 0 ≤ Real.cos ψ :=
      Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], hψ_pi2⟩
    have hterm1 : 0 ≤ rieszBeta p * (Real.cos ψ) ^ p :=
      mul_nonneg hβ_pos.le (Real.rpow_nonneg hcosψ_nn p)
    linarith

/-! ### 17.26: M. Riesz's Theorem (pp. 351–352) -/

/-- Single-variable Herglotz convolution kernel `(1 + r ζ) / (1 - r ζ)` on `FourierCircle`. -/
def herglotzConvKernel (r : ℝ) (ξ : FourierCircle) : ℂ :=
  (1 + (r : ℂ) * circlePoint ξ) / (1 - (r : ℂ) * circlePoint ξ)

/-- Real part of `herglotzConvKernel`: the Poisson convolution kernel on `FourierCircle`. -/
def poissonConvKernel (r : ℝ) (ξ : FourierCircle) : ℝ :=
  (herglotzConvKernel r ξ).re

/-- Imaginary part of `herglotzConvKernel`: the conjugate Poisson kernel on `FourierCircle`. -/
def conjPoissonConvKernel (r : ℝ) (ξ : FourierCircle) : ℝ :=
  (herglotzConvKernel r ξ).im

private theorem herglotzKernel_eq_convKernel (r : ℝ) (θ τ : FourierCircle) :
    (circlePoint τ + (r : ℂ) * circlePoint θ) / (circlePoint τ - (r : ℂ) * circlePoint θ) =
      herglotzConvKernel r (θ - τ) := by
  have hτ : circlePoint τ ≠ 0 := circlePoint_ne_zero τ
  have hmul : circlePoint τ * circlePoint (θ - τ) = circlePoint θ := by
    rw [circlePoint_sub, mul_comm (circlePoint θ), ← mul_assoc, mul_inv_cancel₀ hτ, one_mul]
  have hnum : circlePoint τ + (r : ℂ) * circlePoint θ =
      circlePoint τ * (1 + (r : ℂ) * circlePoint (θ - τ)) := by
    rw [← hmul]; ring
  have hden : circlePoint τ - (r : ℂ) * circlePoint θ =
      circlePoint τ * (1 - (r : ℂ) * circlePoint (θ - τ)) := by
    rw [← hmul]; ring
  rw [hnum, hden, mul_div_mul_left _ _ hτ]
  rfl

private theorem radialSlice_herglotzTransform (h : FourierCircle → ℂ) (r : ℝ) (θ : FourierCircle) :
    radialSlice (herglotzTransform h) r θ =
      ∫ τ, herglotzConvKernel r (θ - τ) * h τ ∂circleMeasure := by
  unfold radialSlice herglotzTransform
  refine integral_congr_ae (Eventually.of_forall fun τ ↦ ?_)
  dsimp only
  rw [herglotzKernel_eq_convKernel]

private theorem herglotzConvKernel_neg (r : ℝ) (ξ : FourierCircle) :
    herglotzConvKernel r (-ξ) = conj (herglotzConvKernel r ξ) := by
  unfold herglotzConvKernel
  rw [circlePoint_neg]
  simp [map_div₀]

private theorem poissonConvKernel_neg (r : ℝ) (ξ : FourierCircle) :
    poissonConvKernel r (-ξ) = poissonConvKernel r ξ := by
  simp [poissonConvKernel, herglotzConvKernel_neg]

private theorem poissonConvKernel_sub_comm (r : ℝ) (θ τ : FourierCircle) :
    poissonConvKernel r (τ - θ) = poissonConvKernel r (θ - τ) := by
  rw [← neg_sub, poissonConvKernel_neg]

private theorem conjPoissonConvKernel_neg (r : ℝ) (ξ : FourierCircle) :
    conjPoissonConvKernel r (-ξ) = -conjPoissonConvKernel r ξ := by
  simp [conjPoissonConvKernel, herglotzConvKernel_neg]

private theorem conjPoissonConvKernel_sub_comm (r : ℝ) (θ τ : FourierCircle) :
    conjPoissonConvKernel r (θ - τ) = -conjPoissonConvKernel r (τ - θ) := by
  rw [← neg_sub τ θ, conjPoissonConvKernel_neg]

private theorem continuous_herglotzConvKernel {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Continuous (herglotzConvKernel r) := by
  unfold herglotzConvKernel
  refine Continuous.div (continuous_const.add (continuous_const.mul continuous_circlePoint))
    (continuous_const.sub (continuous_const.mul continuous_circlePoint)) fun ξ h0 ↦ ?_
  have heq : (1 : ℂ) = (r : ℂ) * circlePoint ξ := sub_eq_zero.mp h0
  have hn := congr_arg (‖·‖) heq
  rw [norm_one, norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0,
    norm_circlePoint, mul_one] at hn
  exact hr1.ne hn.symm

private theorem continuous_poissonConvKernel {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Continuous (poissonConvKernel r) :=
  Complex.continuous_re.comp (continuous_herglotzConvKernel hr0 hr1)

private theorem continuous_conjPoissonConvKernel {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Continuous (conjPoissonConvKernel r) :=
  Complex.continuous_im.comp (continuous_herglotzConvKernel hr0 hr1)

private theorem poissonConvKernel_coe {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (t : ℝ) :
    poissonConvKernel r (t : FourierCircle) = RudinRCA.Chapter11.poissonKernel r t := by
  unfold poissonConvKernel herglotzConvKernel
  rw [circlePoint_coe, mul_comm (t : ℂ) Complex.I]
  exact RudinRCA.Chapter11.node11_5_herglotz_re hr0 hr1 t

private theorem poissonConvKernel_pos {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (ξ : FourierCircle) :
    0 < poissonConvKernel r ξ := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ξ
  rw [poissonConvKernel_coe hr0 hr1 t]
  exact RudinRCA.Chapter11.node11_5_pos hr0 hr1 t

private theorem integral_poissonConvKernel {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (∫ ξ, poissonConvKernel r ξ ∂circleMeasure) = 1 := by
  rw [circleIntegral_interval, smul_eq_mul]
  have hcongr : (∫ t in -Real.pi..Real.pi, poissonConvKernel r (t : FourierCircle)) =
      ∫ t in -Real.pi..Real.pi, RudinRCA.Chapter11.poissonKernel r t :=
    intervalIntegral.integral_congr fun t _ ↦ poissonConvKernel_coe hr0 hr1 t
  rw [hcongr, one_div]
  exact (RudinRCA.Chapter11.node11_5_integral_eq_one hr0 hr1).1

private theorem integral_poissonConvKernel_sub_right {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    (τ : FourierCircle) :
    (∫ θ, poissonConvKernel r (θ - τ) ∂circleMeasure) = 1 := by
  simp_rw [sub_eq_add_neg]
  rw [integral_add_right_eq_self, integral_poissonConvKernel hr0 hr1]

private theorem integral_poissonConvKernel_sub_left {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    (θ : FourierCircle) :
    (∫ τ, poissonConvKernel r (θ - τ) ∂circleMeasure) = 1 := by
  have heq : (fun τ ↦ poissonConvKernel r (θ - τ)) = fun τ ↦ poissonConvKernel r (τ + -θ) := by
    ext τ
    rw [poissonConvKernel_sub_comm r _ θ, sub_eq_add_neg]
  rw [heq, integral_add_right_eq_self, integral_poissonConvKernel hr0 hr1]

private theorem radialSlice_herglotz_real_re_im (h : C(FourierCircle, ℝ))
    {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) (θ : FourierCircle) :
    (radialSlice (herglotzTransform (fun ζ ↦ (h ζ : ℂ))) r θ).re =
      (∫ τ, poissonConvKernel r (θ - τ) * h τ ∂circleMeasure) ∧
    (radialSlice (herglotzTransform (fun ζ ↦ (h ζ : ℂ))) r θ).im =
      (∫ τ, conjPoissonConvKernel r (θ - τ) * h τ ∂circleMeasure) := by
  rw [radialSlice_herglotzTransform]
  have hcont : Continuous (fun τ : FourierCircle ↦
      herglotzConvKernel r (θ - τ) * (h τ : ℂ)) :=
    ((continuous_herglotzConvKernel hr0 hr1).comp (continuous_const.sub continuous_id)).mul
      (Complex.continuous_ofReal.comp h.continuous)
  have hint : Integrable (fun τ : FourierCircle ↦
      herglotzConvKernel r (θ - τ) * (h τ : ℂ)) circleMeasure :=
    continuous_integrable_of_compact hcont
  constructor
  · have hre := (Complex.reCLM.integral_comp_comm hint).symm
    change (∫ τ, herglotzConvKernel r (θ - τ) * (h τ : ℂ) ∂circleMeasure).re = _ at hre
    rw [hre]
    refine integral_congr_ae (Eventually.of_forall fun τ ↦ ?_)
    simp [poissonConvKernel, Complex.mul_re]
  · have him := (Complex.imCLM.integral_comp_comm hint).symm
    change (∫ τ, herglotzConvKernel r (θ - τ) * (h τ : ℂ) ∂circleMeasure).im = _ at him
    rw [him]
    refine integral_congr_ae (Eventually.of_forall fun τ ↦ ?_)
    simp [conjPoissonConvKernel, Complex.mul_im]

/-- Elementary Young/AM-GM inequality `t ≤ (1/q) t^q + (1 - 1/q)` for `t ≥ 0` and `q > 1`. -/
private theorem le_inv_mul_rpow_add_one_sub {t q : ℝ} (ht : 0 ≤ t) (hq : 1 < q) :
    t ≤ (1 / q) * t ^ q + (1 - 1 / q) := by
  have hq_pos : 0 < q := by linarith
  have hw1 : 0 ≤ 1 / q := by positivity
  have hw2 : 0 ≤ 1 - 1 / q := sub_nonneg.mpr (div_le_one_of_le₀ hq.le hq_pos.le)
  have hgm := Real.geom_mean_le_arith_mean2_weighted hw1 hw2
    (Real.rpow_nonneg ht q) zero_le_one (by ring)
  rw [Real.one_rpow, mul_one, mul_one, ← Real.rpow_mul ht,
    mul_one_div_cancel hq_pos.ne', Real.rpow_one] at hgm
  exact hgm

/-- Pointwise weighted Jensen inequality for `x ↦ |x|^q` against `poissonConvKernel r (θ - ·)`. -/
private theorem poisson_pointwise_jensen {q : ℝ} (hq : 1 < q) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    (h : C(FourierCircle, ℝ)) (θ : FourierCircle) :
    |(∫ τ, poissonConvKernel r (θ - τ) * h τ ∂circleMeasure)| ^ q ≤
      ∫ τ, poissonConvKernel r (θ - τ) * |h τ| ^ q ∂circleMeasure := by
  have hq_pos : 0 < q := by linarith
  have hw_pos : ∀ τ, 0 < poissonConvKernel r (θ - τ) :=
    fun τ ↦ poissonConvKernel_pos hr0 hr1 (θ - τ)
  have hw_cont : Continuous (fun τ ↦ poissonConvKernel r (θ - τ)) :=
    (continuous_poissonConvKernel hr0 hr1).comp (continuous_const.sub continuous_id)
  have habs_le : |(∫ τ, poissonConvKernel r (θ - τ) * h τ ∂circleMeasure)| ≤
      ∫ τ, poissonConvKernel r (θ - τ) * |h τ| ∂circleMeasure := by
    calc |(∫ τ, poissonConvKernel r (θ - τ) * h τ ∂circleMeasure)|
        ≤ ∫ τ, |poissonConvKernel r (θ - τ) * h τ| ∂circleMeasure :=
          abs_integral_le_integral_abs
      _ = ∫ τ, poissonConvKernel r (θ - τ) * |h τ| ∂circleMeasure := by
          refine integral_congr_ae (Eventually.of_forall fun τ ↦ ?_)
          dsimp only
          rw [abs_mul, abs_of_pos (hw_pos τ)]
  refine (Real.rpow_le_rpow (abs_nonneg _) habs_le hq_pos.le).trans ?_
  let I : ℝ := ∫ τ, poissonConvKernel r (θ - τ) * |h τ| ^ q ∂circleMeasure
  have hI_nn : 0 ≤ I :=
    integral_nonneg fun τ ↦ mul_nonneg (hw_pos τ).le (Real.rpow_nonneg (abs_nonneg _) q)
  refine le_of_forall_pos_le_add fun ε hε ↦ ?_
  let M : ℝ := (I + ε) ^ (1 / q)
  have hIε_pos : 0 < I + ε := by linarith
  have hM_pos : 0 < M := Real.rpow_pos_of_pos hIε_pos (1 / q)
  have hMq : M ^ q = I + ε := by
    dsimp [M]
    rw [← Real.rpow_mul hIε_pos.le, one_div_mul_cancel hq_pos.ne', Real.rpow_one]
  have hpt : ∀ τ : FourierCircle,
      poissonConvKernel r (θ - τ) * (|h τ| / M) ≤
        (1 / (q * M ^ q)) * (poissonConvKernel r (θ - τ) * |h τ| ^ q) +
          (1 - 1 / q) * poissonConvKernel r (θ - τ) := by
    intro τ
    have hy := le_inv_mul_rpow_add_one_sub (div_nonneg (abs_nonneg (h τ)) hM_pos.le) hq
    have hm := mul_le_mul_of_nonneg_left hy (hw_pos τ).le
    rw [Real.div_rpow (abs_nonneg (h τ)) hM_pos.le] at hm
    calc poissonConvKernel r (θ - τ) * (|h τ| / M)
        ≤ poissonConvKernel r (θ - τ) *
            (1 / q * (|h τ| ^ q / M ^ q) + (1 - 1 / q)) := hm
      _ = (1 / (q * M ^ q)) * (poissonConvKernel r (θ - τ) * |h τ| ^ q) +
            (1 - 1 / q) * poissonConvKernel r (θ - τ) := by ring
  have hint_lhs : Integrable (fun τ ↦ poissonConvKernel r (θ - τ) * (|h τ| / M)) circleMeasure :=
    continuous_integrable_of_compact
      (hw_cont.mul ((continuous_abs.comp h.continuous).div_const M))
  have hint_rhs1 : Integrable
      (fun τ ↦ poissonConvKernel r (θ - τ) * |h τ| ^ q) circleMeasure :=
    continuous_integrable_of_compact
      (hw_cont.mul ((continuous_abs.comp h.continuous).rpow_const fun _ ↦ Or.inr hq_pos.le))
  have hint_rhs2 : Integrable (fun τ ↦ poissonConvKernel r (θ - τ)) circleMeasure :=
    continuous_integrable_of_compact hw_cont
  have hint_le := integral_mono hint_lhs
    ((hint_rhs1.const_mul (1 / (q * M ^ q))).add (hint_rhs2.const_mul (1 - 1 / q))) hpt
  simp only [Pi.add_apply] at hint_le
  have hlhs_eq : (∫ τ, poissonConvKernel r (θ - τ) * (|h τ| / M) ∂circleMeasure) =
      (∫ τ, poissonConvKernel r (θ - τ) * |h τ| ∂circleMeasure) / M := by
    have : (fun τ ↦ poissonConvKernel r (θ - τ) * (|h τ| / M)) =
        fun τ ↦ (poissonConvKernel r (θ - τ) * |h τ|) / M := by ext τ; ring
    rw [this, integral_div]
  have hrhs_eq : (∫ τ, (1 / (q * M ^ q)) * (poissonConvKernel r (θ - τ) * |h τ| ^ q) +
        (1 - 1 / q) * poissonConvKernel r (θ - τ) ∂circleMeasure) =
      (1 / q) * (I / M ^ q) + (1 - 1 / q) := by
    rw [integral_add (hint_rhs1.const_mul _) (hint_rhs2.const_mul _),
      integral_const_mul, integral_const_mul, integral_poissonConvKernel_sub_left hr0 hr1 θ]
    dsimp [I]
    ring
  rw [hlhs_eq, hrhs_eq, hMq] at hint_le
  have hquot_le : I / (I + ε) ≤ 1 := (div_le_one hIε_pos).mpr (by linarith)
  have h1_le : (∫ τ, poissonConvKernel r (θ - τ) * |h τ| ∂circleMeasure) / M ≤ 1 := by
    calc (∫ τ, poissonConvKernel r (θ - τ) * |h τ| ∂circleMeasure) / M
        ≤ (1 / q) * (I / (I + ε)) + (1 - 1 / q) := hint_le
      _ ≤ (1 / q) * 1 + (1 - 1 / q) := by
          gcongr
      _ = 1 := by ring
  have hle_M : (∫ τ, poissonConvKernel r (θ - τ) * |h τ| ∂circleMeasure) ≤ M :=
    (div_le_one hM_pos).mp h1_le
  have hint_nn : 0 ≤ ∫ τ, poissonConvKernel r (θ - τ) * |h τ| ∂circleMeasure :=
    integral_nonneg fun τ ↦ mul_nonneg (hw_pos τ).le (abs_nonneg _)
  calc (∫ τ, poissonConvKernel r (θ - τ) * |h τ| ∂circleMeasure) ^ q
      ≤ M ^ q := Real.rpow_le_rpow hint_nn hle_M hq_pos.le
    _ = I + ε := hMq

/-- Poisson `L^q` contraction on `C(FourierCircle, ℝ)` for all `1 < q < ∞` and `0 ≤ r < 1`. -/
private theorem poisson_Lq_contraction {q : ℝ} (hq : 1 < q) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    (h : C(FourierCircle, ℝ)) :
    (∫ θ, |(radialSlice (herglotzTransform (fun ζ ↦ (h ζ : ℂ))) r θ).re| ^ q ∂circleMeasure) ≤
      ∫ τ, |h τ| ^ q ∂circleMeasure := by
  have hq_pos : 0 < q := by linarith
  let f := herglotzTransform (fun ζ ↦ (h ζ : ℂ))
  have hf_cont : Continuous (radialSlice f r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn
        (holomorphicOn_herglotzTransform
          (continuous_integrable_of_compact (Complex.continuous_ofReal.comp h.continuous))))
      hr0 hr1
  have hint_lhs : Integrable (fun θ ↦ |(radialSlice f r θ).re| ^ q) circleMeasure :=
    continuous_integrable_of_compact
      (((continuous_abs.comp (Complex.continuous_re.comp hf_cont)).rpow_const
        fun _ ↦ Or.inr hq_pos.le))
  have hprod_cont : Continuous (fun p : FourierCircle × FourierCircle ↦
      poissonConvKernel r (p.1 - p.2) * |h p.2| ^ q) :=
    ((continuous_poissonConvKernel hr0 hr1).comp (continuous_fst.sub continuous_snd)).mul
      (((continuous_abs.comp h.continuous).rpow_const fun _ ↦ Or.inr hq_pos.le).comp continuous_snd)
  have hprod_int : Integrable (fun p : FourierCircle × FourierCircle ↦
      poissonConvKernel r (p.1 - p.2) * |h p.2| ^ q) (circleMeasure.prod circleMeasure) :=
    continuous_integrable_of_compact hprod_cont
  have hint_rhs : Integrable (fun θ ↦
      ∫ τ, poissonConvKernel r (θ - τ) * |h τ| ^ q ∂circleMeasure) circleMeasure :=
    hprod_int.integral_prod_left
  have hpt : ∀ θ : FourierCircle,
      |(radialSlice f r θ).re| ^ q ≤
        ∫ τ, poissonConvKernel r (θ - τ) * |h τ| ^ q ∂circleMeasure := by
    intro θ
    rw [(radialSlice_herglotz_real_re_im h hr0 hr1 θ).1]
    exact poisson_pointwise_jensen hq hr0 hr1 h θ
  calc (∫ θ, |(radialSlice f r θ).re| ^ q ∂circleMeasure)
      ≤ ∫ θ, (∫ τ, poissonConvKernel r (θ - τ) * |h τ| ^ q ∂circleMeasure) ∂circleMeasure :=
        integral_mono hint_lhs hint_rhs hpt
    _ = ∫ τ, (∫ θ, poissonConvKernel r (θ - τ) * |h τ| ^ q ∂circleMeasure) ∂circleMeasure :=
        integral_integral_swap hprod_int
    _ = ∫ τ, |h τ| ^ q ∂circleMeasure := by
        refine integral_congr_ae (Eventually.of_forall fun τ ↦ ?_)
        dsimp only
        rw [integral_mul_const, integral_poissonConvKernel_sub_right hr0 hr1 τ, one_mul]

/-- Polar real-part identity `Re (w^q) = ‖w‖^q cos(q arg w)` for `w ≠ 0` and real `q`. -/
private theorem re_cpow_ofReal {w : ℂ} (hw : w ≠ 0) (q : ℝ) :
    (w ^ (q : ℂ)).re = ‖w‖ ^ q * Real.cos (q * Complex.arg w) := by
  rw [Complex.cpow_def_of_ne_zero hw]
  have hlog : Complex.log w * (q : ℂ) =
      ((Real.log ‖w‖ * q : ℝ) : ℂ) + ((q * Complex.arg w : ℝ) : ℂ) * Complex.I := by
    rw [← Complex.re_add_im (Complex.log w), Complex.log_re, Complex.log_im]
    push_cast
    ring
  rw [hlog, Complex.exp_add, ← Complex.ofReal_exp,
    ← Real.rpow_def_of_pos (norm_pos_iff.mpr hw) q, Complex.exp_ofReal_mul_I]
  simp only [Complex.mul_re, Complex.add_re, Complex.ofReal_re, Complex.ofReal_im,
    Complex.I_re, mul_zero, zero_mul, add_zero, sub_zero]

/-- Elementary `(a + b)^q ≤ 2^q (a^q + b^q)` for `a, b ≥ 0` and `q > 0`. -/
private theorem add_rpow_le_two_rpow_mul_add {a b q : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hq : 0 < q) :
    (a + b) ^ q ≤ 2 ^ q * (a ^ q + b ^ q) := by
  rcases le_total a b with hab | hba
  · calc (a + b) ^ q ≤ (2 * b) ^ q := Real.rpow_le_rpow (by positivity) (by linarith) hq.le
      _ = 2 ^ q * b ^ q := Real.mul_rpow zero_le_two hb
      _ ≤ 2 ^ q * (a ^ q + b ^ q) :=
          mul_le_mul_of_nonneg_left (le_add_of_nonneg_left (Real.rpow_nonneg ha q))
            (Real.rpow_nonneg zero_le_two q)
  · calc (a + b) ^ q ≤ (2 * a) ^ q := Real.rpow_le_rpow (by positivity) (by linarith) hq.le
      _ = 2 ^ q * a ^ q := Real.mul_rpow zero_le_two ha
      _ ≤ 2 ^ q * (a ^ q + b ^ q) :=
          mul_le_mul_of_nonneg_left (le_add_of_nonneg_right (Real.rpow_nonneg hb q))
            (Real.rpow_nonneg zero_le_two q)

/-- Step 1 of 17.26: `1 < q ≤ 2` and strictly positive `h ∈ C(FourierCircle, ℝ)`. -/
private theorem riesz_step1_strict_pos {q : ℝ} (hq1 : 1 < q) (hq2 : q ≤ 2)
    (h : C(FourierCircle, ℝ)) (hpos : ∀ ζ, 0 < h ζ)
    {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (∫ θ, ‖radialSlice (herglotzTransform (fun ζ ↦ (h ζ : ℂ))) r θ‖ ^ q ∂circleMeasure) ≤
      rieszBeta q * ∫ τ, |h τ| ^ q ∂circleMeasure := by
  have hq_pos : 0 < q := by linarith
  obtain ⟨hα_pos, hβ_pos, hlem⟩ := theorem17_25 hq1 hq2
  let f : ℂ → ℂ := herglotzTransform (fun ζ ↦ (h ζ : ℂ))
  have hh_int : Integrable (fun ζ ↦ (h ζ : ℂ)) circleMeasure :=
    continuous_integrable_of_compact (Complex.continuous_ofReal.comp h.continuous)
  have hf_holo : HolomorphicOn f (Metric.ball (0 : ℂ) 1) :=
    holomorphicOn_herglotzTransform hh_int
  -- Show `(f z).re > 0` on `ball 0 1` using minimum of `h` on compact `FourierCircle`.
  obtain ⟨ζ₀, _, hmin⟩ := isCompact_univ.exists_isMinOn
    (⟨0, Set.mem_univ 0⟩ : (Set.univ : Set FourierCircle).Nonempty) h.continuous.continuousOn
  let m : ℝ := h ζ₀
  have hm_pos : 0 < m := hpos ζ₀
  have hf_re_pos : ∀ z ∈ Metric.ball (0 : ℂ) 1, 0 < (f z).re := by
    intro z hz
    have hz_lt : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
    have hre_eq := (herglotzTransform_real_properties hh_int (fun _ ↦ Complex.ofReal_im _)).1 z hz
    rw [hre_eq]
    unfold circlePoissonIntegral
    let c₀ : ℝ := ((1 - ‖z‖) / (1 + ‖z‖)) * m
    have hc₀_pos : 0 < c₀ :=
      mul_pos (div_pos (sub_pos.mpr hz_lt) (by linarith [norm_nonneg z])) hm_pos
    have hcont_int : Continuous (fun ζ : FourierCircle ↦
        _root_.poissonKernel 0 z (circlePoint ζ) • (h ζ : ℂ).re) := by
      have hw_not : z ∉ Metric.sphere (0 : ℂ) |(1 : ℝ)| := by
        rw [abs_of_pos zero_lt_one, Metric.mem_sphere, dist_zero_right]
        exact hz_lt.ne
      have hck : ContinuousOn (_root_.poissonKernel 0 z) (Metric.sphere 0 1) := by
        have hk := Complex.continuous_re.comp_continuousOn
          (continuousOn_herglotzRieszKernel_sphere hw_not)
        rwa [← poissonKernel_eq_re_herglotzRieszKernel, abs_of_pos zero_lt_one] at hk
      exact (hck.comp_continuous continuous_circlePoint circlePoint_mem_sphere).smul
        (Complex.continuous_re.comp (Complex.continuous_ofReal.comp h.continuous))
    have hlo : ∀ ζ : FourierCircle,
        c₀ ≤ _root_.poissonKernel 0 z (circlePoint ζ) • (h ζ : ℂ).re := by
      intro ζ
      simp only [Complex.ofReal_re, smul_eq_mul]
      have hpk_lo : (1 - ‖z‖) / (1 + ‖z‖) ≤ _root_.poissonKernel 0 z (circlePoint ζ) := by
        have h1 := le_re_herglotzRieszKernel (circlePoint_mem_sphere ζ) hz
        have h2 := congr_fun (poissonKernel_eq_re_herglotzRieszKernel (c := 0) (w := z))
          (circlePoint ζ)
        rw [h2]
        simpa [herglotzRieszKernel_def] using h1
      have hm_le : m ≤ h ζ := hmin (Set.mem_univ ζ)
      have hlo_nn : 0 ≤ (1 - ‖z‖) / (1 + ‖z‖) :=
        div_nonneg (sub_pos.mpr hz_lt).le (by linarith [norm_nonneg z])
      exact mul_le_mul hpk_lo hm_le hm_pos.le (hlo_nn.trans hpk_lo)
    have hint_ge := integral_mono (μ := circleMeasure) (integrable_const c₀)
      (continuous_integrable_of_compact hcont_int) hlo
    have hc₀_int : (∫ _ : FourierCircle, c₀ ∂circleMeasure) = c₀ := by
      simp [Measure.real]
    linarith
  have hf_slit : ∀ z ∈ Metric.ball (0 : ℂ) 1, f z ∈ Complex.slitPlane :=
    fun z hz ↦ Complex.mem_slitPlane_iff.mpr (Or.inl (hf_re_pos z hz))
  let g : ℂ → ℂ := fun z ↦ (f z) ^ (q : ℂ)
  have hg_holo : HolomorphicOn g (Metric.ball (0 : ℂ) 1) :=
    fun z hz ↦ (hf_holo z hz).cpow_const (hf_slit z hz)
  have hg_cont : Continuous (radialSlice g r) :=
    continuous_radialSlice_of_continuousOn (continuousOn_of_holomorphicOn hg_holo) hr0 hr1
  have hf_cont : Continuous (radialSlice f r) :=
    continuous_radialSlice_of_continuousOn (continuousOn_of_holomorphicOn hf_holo) hr0 hr1
  -- Mean value of `Re g` on `|z| = r` equals `Re (g 0) = (Re (f 0))^q > 0`.
  have hg_mean : (∫ θ, (radialSlice g r θ).re ∂circleMeasure) = (g 0).re := by
    have hcomm := (Complex.reCLM.integral_comp_comm
      (continuous_integrable_of_compact (μ := circleMeasure) hg_cont)).symm
    change (∫ θ, radialSlice g r θ ∂circleMeasure).re =
      ∫ θ, (radialSlice g r θ).re ∂circleMeasure at hcomm
    rw [← hcomm, integral_radialSlice_eq_eval_zero hg_holo hr0 hr1]
  have hg0_re_nn : 0 ≤ (g 0).re := by
    let r0 : ℝ := (f 0).re
    have hf0_im : (f 0).im = 0 :=
      (herglotzTransform_real_properties hh_int (fun _ ↦ Complex.ofReal_im _)).2.1
    have hf0_re_pos : 0 < r0 := hf_re_pos 0 (Metric.mem_ball_self zero_lt_one)
    have hf0_eq : f 0 = (r0 : ℂ) := by
      apply Complex.ext <;> simp [r0, hf0_im]
    have hg0_eq : g 0 = ((r0 ^ q : ℝ) : ℂ) := by
      dsimp [g]
      rw [hf0_eq, Complex.ofReal_cpow hf0_re_pos.le q]
    rw [hg0_eq, Complex.ofReal_re]
    exact Real.rpow_nonneg hf0_re_pos.le q
  -- Pointwise inequality on `|z| = r` from Lemma 17.25.
  have hpt : ∀ θ : FourierCircle,
      ‖radialSlice f r θ‖ ^ q ≤
        rieszBeta q * |(radialSlice f r θ).re| ^ q - rieszAlpha q * (radialSlice g r θ).re := by
    intro θ
    have hz_mem : (r : ℂ) * circlePoint θ ∈ Metric.ball (0 : ℂ) 1 := by
      rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hr0, norm_circlePoint, mul_one]
      exact hr1
    let w : ℂ := radialSlice f r θ
    have hw_re : 0 < w.re := hf_re_pos _ hz_mem
    have hw_ne : w ≠ 0 := fun h0 ↦ by simp [h0] at hw_re
    have harg_lt : |Complex.arg w| < Real.pi / 2 :=
      Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl hw_re)
    have harg_mem : Complex.arg w ∈ Set.Icc (-Real.pi / 2) (Real.pi / 2) := by
      have habs := abs_lt.mp harg_lt
      exact ⟨by linarith, by linarith⟩
    have hineq := mul_le_mul_of_nonneg_left (hlem (Complex.arg w) harg_mem)
      (Real.rpow_nonneg (norm_nonneg w) q)
    have hcos_nn : 0 ≤ Real.cos (Complex.arg w) :=
      Real.cos_nonneg_of_mem_Icc ⟨by linarith [harg_mem.1], harg_mem.2⟩
    have h1 : ‖w‖ ^ q * (Real.cos (Complex.arg w)) ^ q = |w.re| ^ q := by
      rw [← Real.mul_rpow (norm_nonneg w) hcos_nn, Complex.norm_mul_cos_arg, abs_of_pos hw_re]
    have h2 : ‖w‖ ^ q * Real.cos (q * Complex.arg w) = (radialSlice g r θ).re :=
      (re_cpow_ofReal hw_ne q).symm
    calc ‖w‖ ^ q = ‖w‖ ^ q * 1 := (mul_one _).symm
      _ ≤ ‖w‖ ^ q * (rieszBeta q * (Real.cos (Complex.arg w)) ^ q -
            rieszAlpha q * Real.cos (q * Complex.arg w)) := hineq
      _ = rieszBeta q * (‖w‖ ^ q * (Real.cos (Complex.arg w)) ^ q) -
            rieszAlpha q * (‖w‖ ^ q * Real.cos (q * Complex.arg w)) := by ring
      _ = rieszBeta q * |w.re| ^ q - rieszAlpha q * (radialSlice g r θ).re := by rw [h1, h2]
  have hint_norm : Integrable (fun θ ↦ ‖radialSlice f r θ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact
      ((hf_cont.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_re : Integrable (fun θ ↦ |(radialSlice f r θ).re| ^ q) circleMeasure :=
    continuous_integrable_of_compact
      (((continuous_abs.comp (Complex.continuous_re.comp hf_cont)).rpow_const
        fun _ ↦ Or.inr hq_pos.le))
  have hint_g : Integrable (fun θ ↦ (radialSlice g r θ).re) circleMeasure :=
    continuous_integrable_of_compact (Complex.continuous_re.comp hg_cont)
  calc (∫ θ, ‖radialSlice f r θ‖ ^ q ∂circleMeasure)
      ≤ ∫ θ, (rieszBeta q * |(radialSlice f r θ).re| ^ q -
          rieszAlpha q * (radialSlice g r θ).re) ∂circleMeasure :=
        integral_mono hint_norm ((hint_re.const_mul _).sub (hint_g.const_mul _)) hpt
    _ = rieszBeta q * (∫ θ, |(radialSlice f r θ).re| ^ q ∂circleMeasure) -
          rieszAlpha q * (g 0).re := by
        rw [integral_sub (hint_re.const_mul _) (hint_g.const_mul _),
          integral_const_mul, integral_const_mul, hg_mean]
    _ ≤ rieszBeta q * (∫ θ, |(radialSlice f r θ).re| ^ q ∂circleMeasure) := by
        linarith [mul_nonneg hα_pos.le hg0_re_nn]
    _ ≤ rieszBeta q * ∫ τ, |h τ| ^ q ∂circleMeasure :=
        mul_le_mul_of_nonneg_left (poisson_Lq_contraction hq1 hr0 hr1 h) hβ_pos.le

/-- Step 2a of 17.26: `1 < q ≤ 2` and nonnegative `h ∈ C(FourierCircle, ℝ)`. -/
private theorem riesz_step2_nonneg {q : ℝ} (hq1 : 1 < q) (hq2 : q ≤ 2)
    (h : C(FourierCircle, ℝ)) (hnn : ∀ ζ, 0 ≤ h ζ)
    {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (∫ θ, ‖radialSlice (herglotzTransform (fun ζ ↦ (h ζ : ℂ))) r θ‖ ^ q ∂circleMeasure) ≤
      rieszBeta q * ∫ τ, |h τ| ^ q ∂circleMeasure := by
  have hq_pos : 0 < q := by linarith
  let f : ℂ → ℂ := herglotzTransform (fun ζ ↦ (h ζ : ℂ))
  have hh_int : Integrable (fun ζ ↦ (h ζ : ℂ)) circleMeasure :=
    continuous_integrable_of_compact (Complex.continuous_ofReal.comp h.continuous)
  have hf_cont : Continuous (radialSlice f r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn (holomorphicOn_herglotzTransform hh_int)) hr0 hr1
  obtain ⟨M_f, hM_f⟩ := isCompact_univ.exists_bound_of_continuousOn hf_cont.continuousOn
  obtain ⟨M_h, hM_h⟩ := isCompact_univ.exists_bound_of_continuousOn h.continuous.continuousOn
  let ε : ℕ → ℝ := fun n ↦ 1 / ((n : ℝ) + 1)
  have hε_pos : ∀ n, 0 < ε n := fun n ↦ by positivity
  have hε_le1 : ∀ n, ε n ≤ 1 := fun n ↦ by
    have hn : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    exact div_le_one_of_le₀ (by linarith) (by positivity)
  have hε_lim : Tendsto ε atTop (nhds 0) :=
    tendsto_one_div_add_atTop_nhds_zero_nat
  let h_seq : ℕ → C(FourierCircle, ℝ) := fun n ↦ ⟨fun ζ ↦ h ζ + ε n, h.continuous.add continuous_const⟩
  have hseq_ineq : ∀ n,
      (∫ θ, ‖radialSlice f r θ + (ε n : ℂ)‖ ^ q ∂circleMeasure) ≤
        rieszBeta q * ∫ τ, |h τ + ε n| ^ q ∂circleMeasure := by
    intro n
    have hstep1 := riesz_step1_strict_pos hq1 hq2 (h_seq n)
      (fun ζ ↦ add_pos_of_nonneg_of_pos (hnn ζ) (hε_pos n)) hr0 hr1
    have hslice_eq : ∀ θ : FourierCircle,
        radialSlice (herglotzTransform (fun ζ ↦ ((h_seq n ζ : ℝ) : ℂ))) r θ =
          radialSlice f r θ + (ε n : ℂ) := by
      intro θ
      unfold radialSlice
      have hz_mem : (r : ℂ) * circlePoint θ ∈ Metric.ball (0 : ℂ) 1 := by
        rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg hr0, norm_circlePoint, mul_one]
        exact hr1
      have hfn : (fun ζ : FourierCircle ↦ ((h_seq n ζ : ℝ) : ℂ)) =
          fun ζ ↦ (h ζ : ℂ) + (ε n : ℂ) := by ext ζ; simp [h_seq]
      rw [hfn, herglotzTransform_add hh_int (integrable_const _) (mem_ball_zero_iff.mp hz_mem).ne,
        herglotzTransform_const hz_mem]
    have hlhs_eq :
        (∫ θ, ‖radialSlice (herglotzTransform (fun ζ ↦ ((h_seq n ζ : ℝ) : ℂ))) r θ‖ ^ q ∂circleMeasure) =
          ∫ θ, ‖radialSlice f r θ + (ε n : ℂ)‖ ^ q ∂circleMeasure := by
      refine integral_congr_ae (Eventually.of_forall fun θ ↦ ?_)
      dsimp only
      rw [hslice_eq θ]
    rw [hlhs_eq] at hstep1
    simpa only [h_seq, ContinuousMap.coe_mk] using hstep1
  -- Pass `n → ∞` on both sides via dominated convergence.
  have hlhs_lim : Tendsto (fun n ↦ ∫ θ, ‖radialSlice f r θ + (ε n : ℂ)‖ ^ q ∂circleMeasure)
      atTop (nhds (∫ θ, ‖radialSlice f r θ‖ ^ q ∂circleMeasure)) := by
    refine tendsto_integral_of_dominated_convergence
      (fun _ ↦ (max 0 M_f + 1) ^ q)
      (fun n ↦ ((((hf_cont.add continuous_const).norm).rpow_const
        fun _ ↦ Or.inr hq_pos.le)).aestronglyMeasurable)
      (integrable_const _)
      (fun n ↦ Eventually.of_forall fun θ ↦ ?_)
      (Eventually.of_forall fun θ ↦ ?_)
    · rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) q)]
      refine Real.rpow_le_rpow (norm_nonneg _) ?_ hq_pos.le
      calc ‖radialSlice f r θ + (ε n : ℂ)‖
          ≤ ‖radialSlice f r θ‖ + ‖(ε n : ℂ)‖ := norm_add_le _ _
        _ ≤ max 0 M_f + 1 := add_le_add
            ((hM_f θ (Set.mem_univ θ)).trans (le_max_right 0 M_f))
            (by rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos (hε_pos n)]; exact hε_le1 n)
    · have hc : Tendsto (fun n ↦ radialSlice f r θ + (ε n : ℂ)) atTop (nhds (radialSlice f r θ)) := by
        simpa using tendsto_const_nhds.add (Complex.continuous_ofReal.tendsto 0 |>.comp hε_lim)
      exact (hc.norm.rpow_const (Or.inr hq_pos.le))
  have hrhs_lim : Tendsto (fun n ↦ rieszBeta q * ∫ τ, |h τ + ε n| ^ q ∂circleMeasure)
      atTop (nhds (rieszBeta q * ∫ τ, |h τ| ^ q ∂circleMeasure)) := by
    refine Tendsto.const_mul (rieszBeta q) ?_
    refine tendsto_integral_of_dominated_convergence
      (fun _ ↦ (max 0 M_h + 1) ^ q)
      (fun n ↦ (((continuous_abs.comp (h.continuous.add continuous_const)).rpow_const
        fun _ ↦ Or.inr hq_pos.le)).aestronglyMeasurable)
      (integrable_const _)
      (fun n ↦ Eventually.of_forall fun τ ↦ ?_)
      (Eventually.of_forall fun τ ↦ ?_)
    · rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) q)]
      refine Real.rpow_le_rpow (abs_nonneg _) ?_ hq_pos.le
      have hτ_le : |h τ| ≤ M_h := by simpa [Real.norm_eq_abs] using hM_h τ (Set.mem_univ τ)
      calc |h τ + ε n| ≤ |h τ| + |ε n| := abs_add_le _ _
        _ ≤ max 0 M_h + 1 := add_le_add (hτ_le.trans (le_max_right 0 M_h))
            (by rw [abs_of_pos (hε_pos n)]; exact hε_le1 n)
    · have hc : Tendsto (fun n ↦ h τ + ε n) atTop (nhds (h τ)) := by
        simpa using tendsto_const_nhds.add hε_lim
      exact (hc.abs.rpow_const (Or.inr hq_pos.le))
  exact le_of_tendsto_of_tendsto hlhs_lim hrhs_lim (Eventually.of_forall hseq_ineq)

/-- Step 2b of 17.26: `1 < q ≤ 2` and general real `h ∈ C(FourierCircle, ℝ)`. -/
private theorem riesz_step2_real_le_two {q : ℝ} (hq1 : 1 < q) (hq2 : q ≤ 2)
    (h : C(FourierCircle, ℝ)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (∫ θ, ‖radialSlice (herglotzTransform (fun ζ ↦ (h ζ : ℂ))) r θ‖ ^ q ∂circleMeasure) ≤
      (2 ^ q * rieszBeta q) * ∫ τ, |h τ| ^ q ∂circleMeasure := by
  have hq_pos : 0 < q := by linarith
  have hβ_pos : 0 < rieszBeta q := rieszBeta_pos hq1
  let h_pos : C(FourierCircle, ℝ) := ⟨fun ζ ↦ max (h ζ) 0, h.continuous.max continuous_const⟩
  let h_neg : C(FourierCircle, ℝ) := ⟨fun ζ ↦ max (-h ζ) 0, h.continuous.neg.max continuous_const⟩
  let f_pos := herglotzTransform (fun ζ ↦ (h_pos ζ : ℂ))
  let f_neg := herglotzTransform (fun ζ ↦ (h_neg ζ : ℂ))
  let f := herglotzTransform (fun ζ ↦ (h ζ : ℂ))
  have hh_pos_int : Integrable (fun ζ ↦ (h_pos ζ : ℂ)) circleMeasure :=
    continuous_integrable_of_compact (Complex.continuous_ofReal.comp h_pos.continuous)
  have hh_neg_int : Integrable (fun ζ ↦ (h_neg ζ : ℂ)) circleMeasure :=
    continuous_integrable_of_compact (Complex.continuous_ofReal.comp h_neg.continuous)
  have hf_pos_cont : Continuous (radialSlice f_pos r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn (holomorphicOn_herglotzTransform hh_pos_int)) hr0 hr1
  have hf_neg_cont : Continuous (radialSlice f_neg r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn (holomorphicOn_herglotzTransform hh_neg_int)) hr0 hr1
  have hf_cont : Continuous (radialSlice f r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn
        (holomorphicOn_herglotzTransform
          (continuous_integrable_of_compact (Complex.continuous_ofReal.comp h.continuous)))) hr0 hr1
  have hpt : ∀ θ : FourierCircle,
      ‖radialSlice f r θ‖ ^ q ≤
        2 ^ q * (‖radialSlice f_pos r θ‖ ^ q + ‖radialSlice f_neg r θ‖ ^ q) := by
    intro θ
    have hz_lt : ‖(r : ℂ) * circlePoint θ‖ < 1 := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0,
        norm_circlePoint, mul_one]
      exact hr1
    have hdecomp : (fun ζ : FourierCircle ↦ (h ζ : ℂ)) =
        fun ζ ↦ (h_pos ζ : ℂ) - (h_neg ζ : ℂ) := by
      ext ζ
      have hreal : h ζ = h_pos ζ - h_neg ζ := by
        dsimp [h_pos, h_neg]
        rcases le_total 0 (h ζ) with h0 | h0
        · rw [max_eq_left h0, max_eq_right (by linarith), sub_zero]
        · rw [max_eq_right h0, max_eq_left (by linarith), zero_sub, neg_neg]
      simp [hreal]
    have hsub : radialSlice f r θ = radialSlice f_pos r θ - radialSlice f_neg r θ := by
      unfold radialSlice f f_pos f_neg
      rw [hdecomp]
      exact herglotzTransform_sub hh_pos_int hh_neg_int hz_lt.ne
    rw [hsub]
    exact (Real.rpow_le_rpow (norm_nonneg _) (norm_sub_le _ _) hq_pos.le).trans
      (add_rpow_le_two_rpow_mul_add (norm_nonneg _) (norm_nonneg _) hq_pos)
  have hint_f : Integrable (fun θ ↦ ‖radialSlice f r θ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact ((hf_cont.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_pos : Integrable (fun θ ↦ ‖radialSlice f_pos r θ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact ((hf_pos_cont.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_neg : Integrable (fun θ ↦ ‖radialSlice f_neg r θ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact ((hf_neg_cont.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hb_pos := riesz_step2_nonneg hq1 hq2 h_pos (fun ζ ↦ le_max_right _ _) hr0 hr1
  have hb_neg := riesz_step2_nonneg hq1 hq2 h_neg (fun ζ ↦ le_max_right _ _) hr0 hr1
  have hsum_h : (∫ τ, |h_pos τ| ^ q ∂circleMeasure) + (∫ τ, |h_neg τ| ^ q ∂circleMeasure) =
      ∫ τ, |h τ| ^ q ∂circleMeasure := by
    have hi1 : Integrable (fun τ ↦ |h_pos τ| ^ q) circleMeasure :=
      continuous_integrable_of_compact
        ((continuous_abs.comp h_pos.continuous).rpow_const fun _ ↦ Or.inr hq_pos.le)
    have hi2 : Integrable (fun τ ↦ |h_neg τ| ^ q) circleMeasure :=
      continuous_integrable_of_compact
        ((continuous_abs.comp h_neg.continuous).rpow_const fun _ ↦ Or.inr hq_pos.le)
    rw [← integral_add hi1 hi2]
    refine integral_congr_ae (Eventually.of_forall fun τ ↦ ?_)
    dsimp [h_pos, h_neg]
    rcases le_total 0 (h τ) with h0 | h0
    · rw [max_eq_left h0, max_eq_right (by linarith), abs_zero, Real.zero_rpow hq_pos.ne', add_zero]
    · rw [max_eq_right h0, max_eq_left (by linarith), abs_zero, Real.zero_rpow hq_pos.ne',
        zero_add, abs_of_nonneg (by linarith), abs_of_nonpos h0]
  calc (∫ θ, ‖radialSlice f r θ‖ ^ q ∂circleMeasure)
      ≤ ∫ θ, 2 ^ q * (‖radialSlice f_pos r θ‖ ^ q + ‖radialSlice f_neg r θ‖ ^ q) ∂circleMeasure :=
        integral_mono hint_f ((hint_pos.add hint_neg).const_mul _) hpt
    _ = 2 ^ q * ((∫ θ, ‖radialSlice f_pos r θ‖ ^ q ∂circleMeasure) +
          (∫ θ, ‖radialSlice f_neg r θ‖ ^ q ∂circleMeasure)) := by
        rw [integral_const_mul, integral_add hint_pos hint_neg]
    _ ≤ 2 ^ q * (rieszBeta q * (∫ τ, |h_pos τ| ^ q ∂circleMeasure) +
          rieszBeta q * (∫ τ, |h_neg τ| ^ q ∂circleMeasure)) :=
        mul_le_mul_of_nonneg_left (add_le_add hb_pos hb_neg) (Real.rpow_nonneg zero_le_two q)
    _ = (2 ^ q * rieszBeta q) * ∫ τ, |h τ| ^ q ∂circleMeasure := by
        rw [← mul_add (rieszBeta q), hsum_h, mul_assoc]

/-- Elementary Hölder inequality on `circleMeasure` for continuous functions (`1 < q`). -/
private theorem continuous_holder_circleMeasure {q q' : ℝ} (hq1 : 1 < q)
    (hconj : 1 / q + 1 / q' = 1) (hq'_pos : 0 < q')
    {u v : FourierCircle → ℝ} (hu : Continuous u) (hv : Continuous v) :
    (∫ τ, |u τ| * |v τ| ∂circleMeasure) ≤
      ((∫ τ, |u τ| ^ q ∂circleMeasure) ^ (1 / q)) *
        ((∫ τ, |v τ| ^ q' ∂circleMeasure) ^ (1 / q')) := by
  have hq_pos : 0 < q := by linarith
  have hw1 : 0 ≤ 1 / q := by positivity
  have hw2 : 0 ≤ 1 / q' := by positivity
  let Iu := ∫ τ, |u τ| ^ q ∂circleMeasure
  let Iv := ∫ τ, |v τ| ^ q' ∂circleMeasure
  have hIu_nn : 0 ≤ Iu := integral_nonneg fun τ ↦ Real.rpow_nonneg (abs_nonneg _) q
  have hIv_nn : 0 ≤ Iv := integral_nonneg fun τ ↦ Real.rpow_nonneg (abs_nonneg _) q'
  have hint_prod : Integrable (fun τ ↦ |u τ| * |v τ|) circleMeasure :=
    continuous_integrable_of_compact ((continuous_abs.comp hu).mul (continuous_abs.comp hv))
  have hint_u : Integrable (fun τ ↦ |u τ| ^ q) circleMeasure :=
    continuous_integrable_of_compact ((continuous_abs.comp hu).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_v : Integrable (fun τ ↦ |v τ| ^ q') circleMeasure :=
    continuous_integrable_of_compact ((continuous_abs.comp hv).rpow_const fun _ ↦ Or.inr hq'_pos.le)
  -- Prove for `(Iu + ε)^(1/q) * (Iv + ε)^(1/q')` and let `ε → 0⁺` via sequential limit `1/(n+1)`.
  let ε : ℕ → ℝ := fun n ↦ 1 / ((n : ℝ) + 1)
  have hε_pos : ∀ n, 0 < ε n := fun n ↦ by positivity
  have hε_lim : Tendsto ε atTop (nhds 0) := tendsto_one_div_add_atTop_nhds_zero_nat
  have hseq : ∀ n, (∫ τ, |u τ| * |v τ| ∂circleMeasure) ≤
      ((Iu + ε n) ^ (1 / q)) * ((Iv + ε n) ^ (1 / q')) := by
    intro n
    let A := (Iu + ε n) ^ (1 / q)
    let B := (Iv + ε n) ^ (1 / q')
    have hA_pos : 0 < A := Real.rpow_pos_of_pos (by linarith [hε_pos n]) _
    have hB_pos : 0 < B := Real.rpow_pos_of_pos (by linarith [hε_pos n]) _
    have hAq : A ^ q = Iu + ε n := by
      dsimp [A]; rw [← Real.rpow_mul (by linarith [hε_pos n]), one_div_mul_cancel hq_pos.ne', Real.rpow_one]
    have hBq : B ^ q' = Iv + ε n := by
      dsimp [B]; rw [← Real.rpow_mul (by linarith [hε_pos n]), one_div_mul_cancel hq'_pos.ne', Real.rpow_one]
    have hpt : ∀ τ : FourierCircle,
        (|u τ| * |v τ|) / (A * B) ≤
          (1 / (q * A ^ q)) * |u τ| ^ q + (1 / (q' * B ^ q')) * |v τ| ^ q' := by
      intro τ
      have hgm := Real.geom_mean_le_arith_mean2_weighted hw1 hw2
        (Real.rpow_nonneg (div_nonneg (abs_nonneg (u τ)) hA_pos.le) q)
        (Real.rpow_nonneg (div_nonneg (abs_nonneg (v τ)) hB_pos.le) q') hconj
      rw [← Real.rpow_mul (div_nonneg (abs_nonneg (u τ)) hA_pos.le),
        mul_one_div_cancel hq_pos.ne', Real.rpow_one,
        ← Real.rpow_mul (div_nonneg (abs_nonneg (v τ)) hB_pos.le),
        mul_one_div_cancel hq'_pos.ne', Real.rpow_one,
        Real.div_rpow (abs_nonneg (u τ)) hA_pos.le,
        Real.div_rpow (abs_nonneg (v τ)) hB_pos.le] at hgm
      calc (|u τ| * |v τ|) / (A * B) = (|u τ| / A) * (|v τ| / B) := by ring
        _ ≤ 1 / q * (|u τ| ^ q / A ^ q) + 1 / q' * (|v τ| ^ q' / B ^ q') := hgm
        _ = (1 / (q * A ^ q)) * |u τ| ^ q + (1 / (q' * B ^ q')) * |v τ| ^ q' := by ring
    have hint_le := integral_mono (hint_prod.div_const (A * B))
      ((hint_u.const_mul _).add (hint_v.const_mul _)) hpt
    simp only [Pi.add_apply] at hint_le
    rw [integral_div, integral_add (hint_u.const_mul _) (hint_v.const_mul _),
      integral_const_mul, integral_const_mul] at hint_le
    change (∫ τ, |u τ| * |v τ| ∂circleMeasure) / (A * B) ≤
      (1 / (q * A ^ q)) * Iu + (1 / (q' * B ^ q')) * Iv at hint_le
    rw [hAq, hBq] at hint_le
    have h1 : (1 / (q * (Iu + ε n))) * Iu + (1 / (q' * (Iv + ε n))) * Iv ≤ 1 := by
      have hu1 : Iu / (Iu + ε n) ≤ 1 := (div_le_one (by linarith [hε_pos n])).mpr (by linarith [hε_pos n])
      have hv1 : Iv / (Iv + ε n) ≤ 1 := (div_le_one (by linarith [hε_pos n])).mpr (by linarith [hε_pos n])
      calc (1 / (q * (Iu + ε n))) * Iu + (1 / (q' * (Iv + ε n))) * Iv
          = (1 / q) * (Iu / (Iu + ε n)) + (1 / q') * (Iv / (Iv + ε n)) := by
            simp only [div_eq_mul_inv, mul_inv]; ring
        _ ≤ (1 / q) * 1 + (1 / q') * 1 := by gcongr
        _ = 1 := by linarith
    exact (div_le_one (mul_pos hA_pos hB_pos)).mp (hint_le.trans h1)
  have hlim_rhs : Tendsto (fun n ↦ ((Iu + ε n) ^ (1 / q)) * ((Iv + ε n) ^ (1 / q')))
      atTop (nhds ((Iu ^ (1 / q)) * (Iv ^ (1 / q')))) := by
    have h1 : Tendsto (fun n ↦ (Iu + ε n) ^ (1 / q)) atTop (nhds (Iu ^ (1 / q))) := by
      have hc : Tendsto (fun n ↦ Iu + ε n) atTop (nhds Iu) := by
        simpa using tendsto_const_nhds.add hε_lim
      exact hc.rpow_const (Or.inr hw1)
    have h2 : Tendsto (fun n ↦ (Iv + ε n) ^ (1 / q')) atTop (nhds (Iv ^ (1 / q'))) := by
      have hc : Tendsto (fun n ↦ Iv + ε n) atTop (nhds Iv) := by
        simpa using tendsto_const_nhds.add hε_lim
      exact hc.rpow_const (Or.inr hw2)
    exact h1.mul h2
  exact le_of_tendsto_of_tendsto tendsto_const_nhds hlim_rhs (Eventually.of_forall hseq)

/-- Step 3 of 17.26: `2 < q < ∞` and real `h ∈ C(FourierCircle, ℝ)` via conjugate duality. -/
private theorem riesz_step3_real_gt_two {q : ℝ} (hq2 : 2 < q)
    (h : C(FourierCircle, ℝ)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (∫ θ, ‖radialSlice (herglotzTransform (fun ζ ↦ (h ζ : ℂ))) r θ‖ ^ q ∂circleMeasure) ≤
      (2 ^ q * (1 + (2 ^ (q / (q - 1)) * rieszBeta (q / (q - 1))) ^ (q - 1))) *
        ∫ τ, |h τ| ^ q ∂circleMeasure := by
  have hq1 : 1 < q := by linarith
  have hq_pos : 0 < q := by linarith
  have hqm1_pos : 0 < q - 1 := by linarith
  have hqm2_pos : 0 < q - 2 := by linarith
  let q' : ℝ := q / (q - 1)
  have hq'_pos : 0 < q' := div_pos hq_pos hqm1_pos
  have hq'1 : 1 < q' := (one_lt_div hqm1_pos).mpr (by linarith)
  have hq'2 : q' ≤ 2 := le_of_lt ((div_lt_iff₀ hqm1_pos).mpr (by linarith))
  have hconj : 1 / q + 1 / q' = 1 := by
    dsimp [q']
    field_simp [hq_pos.ne', hqm1_pos.ne']
    ring
  let C_q' : ℝ := 2 ^ q' * rieszBeta q'
  have hCq'_pos : 0 < C_q' := mul_pos (Real.rpow_pos_of_pos zero_lt_two q') (rieszBeta_pos hq'1)
  let f := herglotzTransform (fun ζ ↦ (h ζ : ℂ))
  have hf_cont : Continuous (radialSlice f r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn
        (holomorphicOn_herglotzTransform
          (continuous_integrable_of_compact (Complex.continuous_ofReal.comp h.continuous)))) hr0 hr1
  let u_r : FourierCircle → ℝ := fun θ ↦ (radialSlice f r θ).re
  let v_r : FourierCircle → ℝ := fun θ ↦ (radialSlice f r θ).im
  have hu_cont : Continuous u_r := Complex.continuous_re.comp hf_cont
  have hv_cont : Continuous v_r := Complex.continuous_im.comp hf_cont
  let g : C(FourierCircle, ℝ) :=
    ⟨fun θ ↦ |v_r θ| ^ (q - 2) * v_r θ,
      ((continuous_abs.comp hv_cont).rpow_const fun _ ↦ Or.inr hqm2_pos.le).mul hv_cont⟩
  have hvg_eq : ∀ θ : FourierCircle, v_r θ * g θ = |v_r θ| ^ q := by
    intro θ
    dsimp [g]
    rcases eq_or_lt_of_le (abs_nonneg (v_r θ)) with h0 | hpos
    · have hv0 : v_r θ = 0 := abs_eq_zero.mp h0.symm
      rw [hv0, abs_zero, mul_zero, mul_zero, Real.zero_rpow hq_pos.ne']
    · have hsq : v_r θ * (|v_r θ| ^ (q - 2) * v_r θ) = |v_r θ| ^ (q - 2) * |v_r θ| ^ (2 : ℝ) := by
        have h2 : |v_r θ| ^ (2 : ℝ) = (v_r θ) ^ 2 := by
          rw [Real.rpow_ofNat, sq_abs]
        rw [h2]; ring
      rw [hsq, ← Real.rpow_add hpos]
      congr 1; ring
  have hg_q' : ∀ θ : FourierCircle, |g θ| ^ q' = |v_r θ| ^ q := by
    intro θ
    dsimp [g]
    rw [abs_mul, abs_of_nonneg (Real.rpow_nonneg (abs_nonneg (v_r θ)) (q - 2))]
    rcases eq_or_lt_of_le (abs_nonneg (v_r θ)) with h0 | hpos
    · rw [← h0, Real.zero_rpow hqm2_pos.ne', zero_mul,
        Real.zero_rpow hq'_pos.ne', Real.zero_rpow hq_pos.ne']
    · have h1 : |v_r θ| ^ (q - 2) * |v_r θ| = |v_r θ| ^ (q - 1) := by
        calc |v_r θ| ^ (q - 2) * |v_r θ|
            = |v_r θ| ^ (q - 2) * |v_r θ| ^ (1 : ℝ) := by rw [Real.rpow_one]
          _ = |v_r θ| ^ (q - 2 + 1) := (Real.rpow_add hpos _ _).symm
          _ = |v_r θ| ^ (q - 1) := by congr 1; ring
      rw [h1, ← Real.rpow_mul hpos.le]
      congr 1
      dsimp [q']
      exact mul_div_cancel₀ q hqm1_pos.ne'
  -- Fubini + oddness of `conjPoissonConvKernel` for `V := ∫ |v_r|^q`.
  let G_r := radialSlice (herglotzTransform (fun ζ ↦ (g ζ : ℂ))) r
  have hG_cont : Continuous G_r :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn
        (holomorphicOn_herglotzTransform
          (continuous_integrable_of_compact (Complex.continuous_ofReal.comp g.continuous)))) hr0 hr1
  have hprod_cont : Continuous (fun p : FourierCircle × FourierCircle ↦
      conjPoissonConvKernel r (p.1 - p.2) * h p.2 * g p.1) :=
    (((continuous_conjPoissonConvKernel hr0 hr1).comp (continuous_fst.sub continuous_snd)).mul
      (h.continuous.comp continuous_snd)).mul (g.continuous.comp continuous_fst)
  have hprod_int : Integrable (fun p : FourierCircle × FourierCircle ↦
      conjPoissonConvKernel r (p.1 - p.2) * h p.2 * g p.1) (circleMeasure.prod circleMeasure) :=
    continuous_integrable_of_compact hprod_cont
  let V : ℝ := ∫ θ, |v_r θ| ^ q ∂circleMeasure
  have hV_nn : 0 ≤ V := integral_nonneg fun θ ↦ Real.rpow_nonneg (abs_nonneg _) q
  have hV_duality : V = ∫ τ, (-h τ) * (G_r τ).im ∂circleMeasure := by
    dsimp [V]
    have h1 : (∫ θ, |v_r θ| ^ q ∂circleMeasure) =
        ∫ θ, (∫ τ, conjPoissonConvKernel r (θ - τ) * h τ * g θ ∂circleMeasure) ∂circleMeasure := by
      refine integral_congr_ae (Eventually.of_forall fun θ ↦ ?_)
      dsimp only
      rw [← hvg_eq θ, show v_r θ = ∫ τ, conjPoissonConvKernel r (θ - τ) * h τ ∂circleMeasure from
        (radialSlice_herglotz_real_re_im h hr0 hr1 θ).2, integral_mul_const]
    rw [h1, integral_integral_swap hprod_int]
    refine integral_congr_ae (Eventually.of_forall fun τ ↦ ?_)
    dsimp only
    have him_G : (G_r τ).im = ∫ θ, conjPoissonConvKernel r (τ - θ) * g θ ∂circleMeasure :=
      (radialSlice_herglotz_real_re_im g hr0 hr1 τ).2
    have heq_in : (fun θ ↦ conjPoissonConvKernel r (θ - τ) * h τ * g θ) =
        fun θ ↦ (-h τ) * (conjPoissonConvKernel r (τ - θ) * g θ) := by
      ext θ
      rw [conjPoissonConvKernel_sub_comm r θ τ]
      ring
    rw [heq_in, integral_const_mul, ← him_G]
  have hV_holder : V ≤ ((∫ τ, |h τ| ^ q ∂circleMeasure) ^ (1 / q)) *
      (C_q' ^ (1 / q') * V ^ (1 / q')) := by
    have h1 : V ≤ ∫ τ, |h τ| * ‖G_r τ‖ ∂circleMeasure := by
      rw [hV_duality]
      calc (∫ τ, (-h τ) * (G_r τ).im ∂circleMeasure)
          ≤ |(∫ τ, (-h τ) * (G_r τ).im ∂circleMeasure)| := le_abs_self _
        _ ≤ ∫ τ, |(-h τ) * (G_r τ).im| ∂circleMeasure := abs_integral_le_integral_abs
        _ ≤ ∫ τ, |h τ| * ‖G_r τ‖ ∂circleMeasure := by
            refine integral_mono
              (continuous_integrable_of_compact
                (continuous_abs.comp ((h.continuous.neg).mul (Complex.continuous_im.comp hG_cont))))
              (continuous_integrable_of_compact
                ((continuous_abs.comp h.continuous).mul hG_cont.norm))
              fun τ ↦ ?_
            dsimp only
            rw [abs_mul, abs_neg]
            exact mul_le_mul_of_nonneg_left (Complex.abs_im_le_norm (G_r τ)) (abs_nonneg _)
    have h2 := continuous_holder_circleMeasure hq1 hconj hq'_pos h.continuous hG_cont.norm
    have h2' : (∫ τ, |h τ| * ‖G_r τ‖ ∂circleMeasure) ≤
        ((∫ τ, |h τ| ^ q ∂circleMeasure) ^ (1 / q)) *
          ((∫ τ, ‖G_r τ‖ ^ q' ∂circleMeasure) ^ (1 / q')) := by
      simpa only [abs_norm] using h2
    have hG_bound := riesz_step2_real_le_two hq'1 hq'2 g hr0 hr1
    have hG_bound' : (∫ τ, ‖G_r τ‖ ^ q' ∂circleMeasure) ≤ C_q' * V := by
      refine hG_bound.trans_eq ?_
      dsimp [C_q', V]
      congr 1
      exact integral_congr_ae (Eventually.of_forall hg_q')
    have hG_rpow : (∫ τ, ‖G_r τ‖ ^ q' ∂circleMeasure) ^ (1 / q') ≤
        C_q' ^ (1 / q') * V ^ (1 / q') := by
      calc (∫ τ, ‖G_r τ‖ ^ q' ∂circleMeasure) ^ (1 / q')
          ≤ (C_q' * V) ^ (1 / q') := Real.rpow_le_rpow
              (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) q') hG_bound' (by positivity)
        _ = C_q' ^ (1 / q') * V ^ (1 / q') := Real.mul_rpow hCq'_pos.le hV_nn
    exact h1.trans (h2'.trans (mul_le_mul_of_nonneg_left hG_rpow
      (Real.rpow_nonneg (integral_nonneg fun _ ↦ Real.rpow_nonneg (abs_nonneg _) q) _)))
  -- Deduce `V ≤ C_q' ^ (q - 1) * ∫ |h|^q`.
  have hV_bound : V ≤ C_q' ^ (q - 1) * ∫ τ, |h τ| ^ q ∂circleMeasure := by
    rcases eq_or_lt_of_le hV_nn with hV0 | hV_pos
    · rw [← hV0]
      exact mul_nonneg (Real.rpow_nonneg hCq'_pos.le _)
        (integral_nonneg fun _ ↦ Real.rpow_nonneg (abs_nonneg _) q)
    · have hV_split : V ^ (1 / q) * V ^ (1 / q') = V := by
        rw [← Real.rpow_add hV_pos, hconj, Real.rpow_one]
      have hV_q'_pos : 0 < V ^ (1 / q') := Real.rpow_pos_of_pos hV_pos _
      have hdiv : V ^ (1 / q) ≤ C_q' ^ (1 / q') * (∫ τ, |h τ| ^ q ∂circleMeasure) ^ (1 / q) := by
        refine le_of_mul_le_mul_right ?_ hV_q'_pos
        rw [hV_split]
        calc V ≤ ((∫ τ, |h τ| ^ q ∂circleMeasure) ^ (1 / q)) * (C_q' ^ (1 / q') * V ^ (1 / q')) :=
              hV_holder
          _ = (C_q' ^ (1 / q') * (∫ τ, |h τ| ^ q ∂circleMeasure) ^ (1 / q)) * V ^ (1 / q') := by
              ring
      have hrpow_q := Real.rpow_le_rpow (Real.rpow_nonneg hV_pos.le _) hdiv hq_pos.le
      have hlhs : (V ^ (1 / q)) ^ q = V := by
        rw [← Real.rpow_mul hV_pos.le, one_div_mul_cancel hq_pos.ne', Real.rpow_one]
      have hIh_nn : 0 ≤ ∫ τ, |h τ| ^ q ∂circleMeasure :=
        integral_nonneg fun _ ↦ Real.rpow_nonneg (abs_nonneg _) q
      have hrhs : (C_q' ^ (1 / q') * (∫ τ, |h τ| ^ q ∂circleMeasure) ^ (1 / q)) ^ q =
          C_q' ^ (q - 1) * ∫ τ, |h τ| ^ q ∂circleMeasure := by
        rw [Real.mul_rpow (Real.rpow_nonneg hCq'_pos.le _) (Real.rpow_nonneg hIh_nn _),
          ← Real.rpow_mul hCq'_pos.le, ← Real.rpow_mul hIh_nn,
          one_div_mul_cancel hq_pos.ne', Real.rpow_one]
        congr 2
        dsimp [q']
        field_simp [hq_pos.ne', hqm1_pos.ne']
      rwa [hlhs, hrhs] at hrpow_q
  -- Combine `u_r` and `v_r`.
  have hu_bound : (∫ θ, |u_r θ| ^ q ∂circleMeasure) ≤ ∫ τ, |h τ| ^ q ∂circleMeasure :=
    poisson_Lq_contraction hq1 hr0 hr1 h
  have hpt : ∀ θ : FourierCircle,
      ‖radialSlice f r θ‖ ^ q ≤ 2 ^ q * (|u_r θ| ^ q + |v_r θ| ^ q) := by
    intro θ
    exact (Real.rpow_le_rpow (norm_nonneg _)
      (Complex.norm_le_abs_re_add_abs_im (radialSlice f r θ)) hq_pos.le).trans
      (add_rpow_le_two_rpow_mul_add (abs_nonneg _) (abs_nonneg _) hq_pos)
  have hint_f : Integrable (fun θ ↦ ‖radialSlice f r θ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact ((hf_cont.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_u : Integrable (fun θ ↦ |u_r θ| ^ q) circleMeasure :=
    continuous_integrable_of_compact ((continuous_abs.comp hu_cont).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_v : Integrable (fun θ ↦ |v_r θ| ^ q) circleMeasure :=
    continuous_integrable_of_compact ((continuous_abs.comp hv_cont).rpow_const fun _ ↦ Or.inr hq_pos.le)
  calc (∫ θ, ‖radialSlice f r θ‖ ^ q ∂circleMeasure)
      ≤ ∫ θ, 2 ^ q * (|u_r θ| ^ q + |v_r θ| ^ q) ∂circleMeasure :=
        integral_mono hint_f ((hint_u.add hint_v).const_mul _) hpt
    _ = 2 ^ q * ((∫ θ, |u_r θ| ^ q ∂circleMeasure) + V) := by
        rw [integral_const_mul, integral_add hint_u hint_v]
    _ ≤ 2 ^ q * ((∫ τ, |h τ| ^ q ∂circleMeasure) +
          C_q' ^ (q - 1) * (∫ τ, |h τ| ^ q ∂circleMeasure)) :=
        mul_le_mul_of_nonneg_left (add_le_add hu_bound hV_bound) (Real.rpow_nonneg zero_le_two q)
    _ = (2 ^ q * (1 + C_q' ^ (q - 1))) * ∫ τ, |h τ| ^ q ∂circleMeasure := by ring

/-- Explicit `q`-th power constant for real boundary data in M. Riesz's theorem (`1 < q < ∞`). -/
def rieszRealPowerConst (q : ℝ) : ℝ :=
  if q ≤ 2 then 2 ^ q * rieszBeta q
  else 2 ^ q * (1 + (2 ^ (q / (q - 1)) * rieszBeta (q / (q - 1))) ^ (q - 1))

theorem rieszRealPowerConst_pos {q : ℝ} (hq1 : 1 < q) :
    0 < rieszRealPowerConst q := by
  unfold rieszRealPowerConst
  split_ifs with hle
  · exact mul_pos (Real.rpow_pos_of_pos zero_lt_two q) (rieszBeta_pos hq1)
  · have hgt : 2 < q := lt_of_not_ge hle
    have hq'1 : 1 < q / (q - 1) := (one_lt_div (by linarith)).mpr (by linarith)
    have hbase : 0 < 2 ^ (q / (q - 1)) * rieszBeta (q / (q - 1)) :=
      mul_pos (Real.rpow_pos_of_pos zero_lt_two _) (rieszBeta_pos hq'1)
    exact mul_pos (Real.rpow_pos_of_pos zero_lt_two q)
      (add_pos_of_pos_of_nonneg zero_lt_one (Real.rpow_nonneg hbase.le _))

/-- Explicit constant `A_q > 0` in M. Riesz's theorem (`1 < q < ∞`) for complex boundary data. -/
def rieszConstant (q : ℝ) : ℝ :=
  (2 ^ (q + 1) * rieszRealPowerConst q) ^ (1 / q)

theorem rieszConstant_pos {q : ℝ} (hq1 : 1 < q) :
    0 < rieszConstant q := by
  unfold rieszConstant
  exact Real.rpow_pos_of_pos
    (mul_pos (Real.rpow_pos_of_pos zero_lt_two (q + 1)) (rieszRealPowerConst_pos hq1)) _

/-- Step 4 of 17.26: all `1 < q < ∞` and complex `h ∈ C(FourierCircle, ℂ)`. -/
private theorem riesz_step4_continuous_complex {q : ℝ} (hq1 : 1 < q)
    (h : C(FourierCircle, ℂ)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (∫ θ, ‖radialSlice (herglotzTransform h) r θ‖ ^ q ∂circleMeasure) ≤
      (2 ^ (q + 1) * rieszRealPowerConst q) * ∫ τ, ‖h τ‖ ^ q ∂circleMeasure := by
  have hq_pos : 0 < q := by linarith
  have hC_pos : 0 < rieszRealPowerConst q := rieszRealPowerConst_pos hq1
  have hreal_bound : ∀ k : C(FourierCircle, ℝ),
      (∫ θ, ‖radialSlice (herglotzTransform (fun ζ ↦ (k ζ : ℂ))) r θ‖ ^ q ∂circleMeasure) ≤
        rieszRealPowerConst q * ∫ τ, |k τ| ^ q ∂circleMeasure := by
    intro k
    unfold rieszRealPowerConst
    split_ifs with hle
    · exact riesz_step2_real_le_two hq1 hle k hr0 hr1
    · exact riesz_step3_real_gt_two (lt_of_not_ge hle) k hr0 hr1
  let h_re : C(FourierCircle, ℝ) := ⟨fun ζ ↦ (h ζ).re, Complex.continuous_re.comp h.continuous⟩
  let h_im : C(FourierCircle, ℝ) := ⟨fun ζ ↦ (h ζ).im, Complex.continuous_im.comp h.continuous⟩
  let f_re := herglotzTransform (fun ζ ↦ (h_re ζ : ℂ))
  let f_im := herglotzTransform (fun ζ ↦ (h_im ζ : ℂ))
  let f := herglotzTransform h
  have hh_re_int : Integrable (fun ζ ↦ (h_re ζ : ℂ)) circleMeasure :=
    continuous_integrable_of_compact (Complex.continuous_ofReal.comp h_re.continuous)
  have hh_im_int : Integrable (fun ζ ↦ (h_im ζ : ℂ)) circleMeasure :=
    continuous_integrable_of_compact (Complex.continuous_ofReal.comp h_im.continuous)
  have hf_re_cont : Continuous (radialSlice f_re r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn (holomorphicOn_herglotzTransform hh_re_int)) hr0 hr1
  have hf_im_cont : Continuous (radialSlice f_im r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn (holomorphicOn_herglotzTransform hh_im_int)) hr0 hr1
  have hf_cont : Continuous (radialSlice f r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn
        (holomorphicOn_herglotzTransform (continuous_integrable_of_compact h.continuous))) hr0 hr1
  have hpt : ∀ θ : FourierCircle,
      ‖radialSlice f r θ‖ ^ q ≤
        2 ^ q * (‖radialSlice f_re r θ‖ ^ q + ‖radialSlice f_im r θ‖ ^ q) := by
    intro θ
    have hz_lt : ‖(r : ℂ) * circlePoint θ‖ < 1 := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0,
        norm_circlePoint, mul_one]
      exact hr1
    have hdecomp : (h : FourierCircle → ℂ) =
        fun ζ ↦ (h_re ζ : ℂ) + Complex.I * (h_im ζ : ℂ) := by
      ext ζ
      dsimp [h_re, h_im]
      rw [mul_comm Complex.I, Complex.re_add_im]
    have hadd : radialSlice f r θ = radialSlice f_re r θ + Complex.I * radialSlice f_im r θ := by
      unfold radialSlice f f_re f_im
      rw [hdecomp, herglotzTransform_add hh_re_int (hh_im_int.const_mul Complex.I) hz_lt.ne,
        herglotzTransform_const_mul]
    rw [hadd]
    have hnorm : ‖radialSlice f_re r θ + Complex.I * radialSlice f_im r θ‖ ≤
        ‖radialSlice f_re r θ‖ + ‖radialSlice f_im r θ‖ := by
      calc ‖radialSlice f_re r θ + Complex.I * radialSlice f_im r θ‖
          ≤ ‖radialSlice f_re r θ‖ + ‖Complex.I * radialSlice f_im r θ‖ := norm_add_le _ _
        _ = ‖radialSlice f_re r θ‖ + ‖radialSlice f_im r θ‖ := by simp
    exact (Real.rpow_le_rpow (norm_nonneg _) hnorm hq_pos.le).trans
      (add_rpow_le_two_rpow_mul_add (norm_nonneg _) (norm_nonneg _) hq_pos)
  have hint_f : Integrable (fun θ ↦ ‖radialSlice f r θ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact ((hf_cont.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_re : Integrable (fun θ ↦ ‖radialSlice f_re r θ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact ((hf_re_cont.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_im : Integrable (fun θ ↦ ‖radialSlice f_im r θ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact ((hf_im_cont.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hint_h : Integrable (fun τ ↦ ‖h τ‖ ^ q) circleMeasure :=
    continuous_integrable_of_compact ((h.continuous.norm).rpow_const fun _ ↦ Or.inr hq_pos.le)
  have hre_le : (∫ τ, |h_re τ| ^ q ∂circleMeasure) ≤ ∫ τ, ‖h τ‖ ^ q ∂circleMeasure :=
    integral_mono
      (continuous_integrable_of_compact
        ((continuous_abs.comp h_re.continuous).rpow_const fun _ ↦ Or.inr hq_pos.le))
      hint_h fun τ ↦ Real.rpow_le_rpow (abs_nonneg _) (Complex.abs_re_le_norm (h τ)) hq_pos.le
  have him_le : (∫ τ, |h_im τ| ^ q ∂circleMeasure) ≤ ∫ τ, ‖h τ‖ ^ q ∂circleMeasure :=
    integral_mono
      (continuous_integrable_of_compact
        ((continuous_abs.comp h_im.continuous).rpow_const fun _ ↦ Or.inr hq_pos.le))
      hint_h fun τ ↦ Real.rpow_le_rpow (abs_nonneg _) (Complex.abs_im_le_norm (h τ)) hq_pos.le
  calc (∫ θ, ‖radialSlice f r θ‖ ^ q ∂circleMeasure)
      ≤ ∫ θ, 2 ^ q * (‖radialSlice f_re r θ‖ ^ q + ‖radialSlice f_im r θ‖ ^ q) ∂circleMeasure :=
        integral_mono hint_f ((hint_re.add hint_im).const_mul _) hpt
    _ = 2 ^ q * ((∫ θ, ‖radialSlice f_re r θ‖ ^ q ∂circleMeasure) +
          (∫ θ, ‖radialSlice f_im r θ‖ ^ q ∂circleMeasure)) := by
        rw [integral_const_mul, integral_add hint_re hint_im]
    _ ≤ 2 ^ q * (rieszRealPowerConst q * (∫ τ, |h_re τ| ^ q ∂circleMeasure) +
          rieszRealPowerConst q * (∫ τ, |h_im τ| ^ q ∂circleMeasure)) :=
        mul_le_mul_of_nonneg_left (add_le_add (hreal_bound h_re) (hreal_bound h_im))
          (Real.rpow_nonneg zero_le_two q)
    _ ≤ 2 ^ q * (rieszRealPowerConst q * (∫ τ, ‖h τ‖ ^ q ∂circleMeasure) +
          rieszRealPowerConst q * (∫ τ, ‖h τ‖ ^ q ∂circleMeasure)) :=
        mul_le_mul_of_nonneg_left
          (add_le_add (mul_le_mul_of_nonneg_left hre_le hC_pos.le)
            (mul_le_mul_of_nonneg_left him_le hC_pos.le))
          (Real.rpow_nonneg zero_le_two q)
    _ = (2 ^ (q + 1) * rieszRealPowerConst q) * ∫ τ, ‖h τ‖ ^ q ∂circleMeasure := by
        rw [Real.rpow_add zero_lt_two, Real.rpow_one]
        ring

/-- `eLpNorm` version of Step 4 for continuous `g : C(FourierCircle, ℂ)`. -/
private theorem riesz_step4_eLpNorm {p : ℝ≥0∞} (hp1 : 1 < p) (hptop : p ≠ ⊤)
    (g : C(FourierCircle, ℂ)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (eLpNorm (radialSlice (herglotzTransform g) r) p circleMeasure).toReal ≤
      rieszConstant p.toReal * (eLpNorm g p circleMeasure).toReal := by
  have hp0 : p ≠ 0 := (zero_lt_one.trans hp1).ne'
  let q : ℝ := p.toReal
  have hq1 : 1 < q := one_lt_toReal_of_one_lt hp1 hptop
  have hq_pos : 0 < q := by linarith
  have hg_mem : MemLp g p circleMeasure := continuous_memLp_of_compact g.continuous
  have hf_cont : Continuous (radialSlice (herglotzTransform g) r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn
        (holomorphicOn_herglotzTransform (continuous_integrable_of_compact g.continuous))) hr0 hr1
  have hf_mem : MemLp (radialSlice (herglotzTransform g) r) p circleMeasure :=
    continuous_memLp_of_compact hf_cont
  have hf_norm : (eLpNorm (radialSlice (herglotzTransform g) r) p circleMeasure).toReal =
      (∫ θ, ‖radialSlice (herglotzTransform g) r θ‖ ^ q ∂circleMeasure) ^ q⁻¹ := by
    rw [hf_mem.eLpNorm_eq_integral_rpow_norm hp0 hptop, ENNReal.toReal_ofReal (by positivity)]
  have hg_norm : (eLpNorm g p circleMeasure).toReal =
      (∫ τ, ‖g τ‖ ^ q ∂circleMeasure) ^ q⁻¹ := by
    rw [hg_mem.eLpNorm_eq_integral_rpow_norm hp0 hptop, ENNReal.toReal_ofReal (by positivity)]
  rw [hf_norm, hg_norm]
  have hstep4 := riesz_step4_continuous_complex hq1 g hr0 hr1
  have hrpow := Real.rpow_le_rpow
    (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) q) hstep4 (inv_pos.mpr hq_pos).le
  have hC_nn : 0 ≤ 2 ^ (q + 1) * rieszRealPowerConst q :=
    mul_nonneg (Real.rpow_nonneg zero_le_two _) (rieszRealPowerConst_pos hq1).le
  have hIg_nn : 0 ≤ ∫ τ, ‖g τ‖ ^ q ∂circleMeasure :=
    integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) q
  rw [Real.mul_rpow hC_nn hIg_nn] at hrpow
  simpa only [rieszConstant, q, one_div] using hrpow

/-- Uniform radial `L^p(T)` bound of M. Riesz's theorem for arbitrary `MemLp h p circleMeasure`
(`1 < p < ∞`). -/
theorem herglotzTransform_radialSize_le {p : ℝ≥0∞} (hp1 : 1 < p) (hptop : p ≠ ⊤)
    {h : FourierCircle → ℂ} (hh : MemLp h p circleMeasure)
    {r : ℝ} (hr : r ∈ Set.Ico (0 : ℝ) 1) :
    radialSize p (herglotzTransform h) r ≤
      rieszConstant p.toReal * (eLpNorm h p circleMeasure).toReal := by
  rcases hr with ⟨hr0, hr1⟩
  have hp0 : p ≠ 0 := (zero_lt_one.trans hp1).ne'
  have hp1_le : 1 ≤ p := hp1.le
  have : Fact (1 ≤ p) := ⟨hp1_le⟩
  have hh_int : Integrable h circleMeasure := hh.integrable hp1_le
  let F_h : FourierCircle → ℂ := radialSlice (herglotzTransform h) r
  have hFh_cont : Continuous F_h :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn (holomorphicOn_herglotzTransform hh_int)) hr0 hr1
  unfold radialSize radialSizeENNReal
  simp only [hp0, ↓reduceIte]
  change (eLpNorm F_h p circleMeasure).toReal ≤
    rieszConstant p.toReal * (eLpNorm h p circleMeasure).toReal
  let A_p : ℝ := rieszConstant p.toReal
  have hAp_pos : 0 < A_p := rieszConstant_pos (one_lt_toReal_of_one_lt hp1 hptop)
  let K_r : ℝ := (1 + r) / (1 - r)
  have hKr_pos : 0 < K_r := div_pos (by linarith) (sub_pos.mpr hr1)
  refine le_of_forall_pos_le_add fun δ hδ ↦ ?_
  let ε : ℝ := δ / (K_r + A_p + 1)
  have hε_pos : 0 < ε := div_pos hδ (by positivity)
  let H : CircleLp p := hh.toLp h
  have hH_norm : ‖H‖ = (eLpNorm h p circleMeasure).toReal := by
    rw [Lp.norm_def, eLpNorm_congr_ae (hh.coeFn_toLp)]
  have hdense := ContinuousMap.toLp_denseRange ℂ circleMeasure ℂ hptop
  obtain ⟨g, hg_dist⟩ := Metric.denseRange_iff.mp hdense H ε hε_pos
  rw [dist_comm, dist_eq_norm] at hg_dist
  let G : CircleLp p := ContinuousMap.toLp p circleMeasure ℂ g
  have hG_norm_eq : ‖G‖ = (eLpNorm g p circleMeasure).toReal := by
    rw [Lp.norm_def, eLpNorm_congr_ae (ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℂ) circleMeasure g)]
  have hdiff_ae : ((G - H : CircleLp p) : FourierCircle → ℂ) =ᵐ[circleMeasure]
      fun τ ↦ g τ - h τ := by
    filter_upwards [Lp.coeFn_sub G H, ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℂ) circleMeasure g,
      hh.coeFn_toLp] with τ h1 h2 h3
    rw [h1, Pi.sub_apply, h2, h3]
  have hdiff_Lp : (eLpNorm (fun τ ↦ g τ - h τ) p circleMeasure).toReal < ε := by
    have heq : (eLpNorm (fun τ ↦ g τ - h τ) p circleMeasure).toReal = ‖G - H‖ := by
      rw [Lp.norm_def, eLpNorm_congr_ae hdiff_ae]
    rwa [heq]
  have hdiff_L1 : (∫ τ, ‖h τ - g τ‖ ∂circleMeasure) ≤ ε := by
    have hint_d : Integrable (fun τ ↦ g τ - h τ) circleMeasure :=
      (continuous_integrable_of_compact g.continuous).sub hh_int
    have h1_le_p : eLpNorm (fun τ ↦ g τ - h τ) 1 circleMeasure ≤
        eLpNorm (fun τ ↦ g τ - h τ) p circleMeasure :=
      eLpNorm_le_eLpNorm_of_exponent_le hp1_le
    have hp_fin : eLpNorm (fun τ ↦ g τ - h τ) p circleMeasure ≠ ⊤ :=
      ((continuous_memLp_of_compact g.continuous).sub hh).eLpNorm_ne_top
    have hl1_eq : (eLpNorm (fun τ ↦ g τ - h τ) 1 circleMeasure).toReal =
        ∫ τ, ‖h τ - g τ‖ ∂circleMeasure := by
      have hm1 : MemLp (fun τ ↦ g τ - h τ) 1 circleMeasure := memLp_one_iff_integrable.mpr hint_d
      rw [hm1.eLpNorm_eq_integral_rpow_norm one_ne_zero ENNReal.coe_ne_top,
        ENNReal.toReal_one, inv_one, Real.rpow_one,
        ENNReal.toReal_ofReal (integral_nonneg fun _ ↦ by positivity)]
      refine integral_congr_ae (Eventually.of_forall fun τ ↦ ?_)
      simp [norm_sub_rev]
    rw [← hl1_eq]
    exact (ENNReal.toReal_mono hp_fin h1_le_p).trans hdiff_Lp.le
  let F_g : FourierCircle → ℂ := radialSlice (herglotzTransform g) r
  have hFg_cont : Continuous F_g :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn
        (holomorphicOn_herglotzTransform (continuous_integrable_of_compact g.continuous))) hr0 hr1
  have hFg_mem : MemLp F_g p circleMeasure := continuous_memLp_of_compact hFg_cont
  have hpt_diff : ∀ θ : FourierCircle, ‖F_h θ - F_g θ‖ ≤ K_r * ε := by
    intro θ
    let z : ℂ := (r : ℂ) * circlePoint θ
    have hz_norm : ‖z‖ = r := by
      dsimp [z]
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hr0,
        norm_circlePoint, mul_one]
    have hz_lt : ‖z‖ < 1 := hz_norm.trans_lt hr1
    have hsub : F_h θ - F_g θ = herglotzTransform (fun τ ↦ h τ - g τ) z :=
      (herglotzTransform_sub hh_int (continuous_integrable_of_compact g.continuous) hz_lt.ne).symm
    rw [hsub]
    unfold herglotzTransform
    calc ‖∫ τ, ((circlePoint τ + z) / (circlePoint τ - z)) * (h τ - g τ) ∂circleMeasure‖
        ≤ ∫ τ, ‖((circlePoint τ + z) / (circlePoint τ - z)) * (h τ - g τ)‖ ∂circleMeasure :=
          norm_integral_le_integral_norm _
      _ ≤ ∫ τ, K_r * ‖h τ - g τ‖ ∂circleMeasure := by
          refine integral_mono
            (integrable_herglotzIntegrand
              (hh_int.sub (continuous_integrable_of_compact g.continuous)) hz_lt.ne).norm
            ((hh_int.sub (continuous_integrable_of_compact g.continuous)).norm.const_mul K_r)
            fun τ ↦ ?_
          dsimp only
          rw [norm_mul]
          refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
          simpa [K_r, hz_norm] using norm_herglotzKernel_le hz_lt τ
      _ = K_r * ∫ τ, ‖h τ - g τ‖ ∂circleMeasure := integral_const_mul _ _
      _ ≤ K_r * ε := mul_le_mul_of_nonneg_left hdiff_L1 hKr_pos.le
  have hdiff_F_eLp : eLpNorm (F_h - F_g) p circleMeasure ≤ ENNReal.ofReal (K_r * ε) := by
    have hb : eLpNorm (F_h - F_g) p circleMeasure ≤ _ := eLpNorm_le_of_ae_bound
      (hFh_cont.sub hFg_cont).aestronglyMeasurable (Eventually.of_forall hpt_diff)
    simpa [measure_univ] using hb
  have htri_F : eLpNorm F_h p circleMeasure ≤
      ENNReal.ofReal (K_r * ε) + eLpNorm F_g p circleMeasure := by
    have hadd : F_h = (F_h - F_g) + F_g := by ext θ; simp
    calc eLpNorm F_h p circleMeasure
        = eLpNorm ((F_h - F_g) + F_g) p circleMeasure := by rw [← hadd]
      _ ≤ eLpNorm (F_h - F_g) p circleMeasure + eLpNorm F_g p circleMeasure :=
          eLpNorm_add_le hp1_le
      _ ≤ ENNReal.ofReal (K_r * ε) + eLpNorm F_g p circleMeasure :=
          add_le_add hdiff_F_eLp le_rfl
  have hFh_le : (eLpNorm F_h p circleMeasure).toReal ≤
      K_r * ε + (eLpNorm F_g p circleMeasure).toReal := by
    have hfin : ENNReal.ofReal (K_r * ε) + eLpNorm F_g p circleMeasure ≠ ⊤ :=
      ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, hFg_mem.eLpNorm_ne_top⟩
    calc (eLpNorm F_h p circleMeasure).toReal
        ≤ (ENNReal.ofReal (K_r * ε) + eLpNorm F_g p circleMeasure).toReal :=
          ENNReal.toReal_mono hfin htri_F
      _ = K_r * ε + (eLpNorm F_g p circleMeasure).toReal := by
          rw [ENNReal.toReal_add ENNReal.ofReal_ne_top hFg_mem.eLpNorm_ne_top,
            ENNReal.toReal_ofReal (by positivity)]
  have hFg_bound : (eLpNorm F_g p circleMeasure).toReal ≤
      A_p * (eLpNorm g p circleMeasure).toReal :=
    riesz_step4_eLpNorm hp1 hptop g hr0 hr1
  have hg_le_h : (eLpNorm g p circleMeasure).toReal ≤
      (eLpNorm h p circleMeasure).toReal + ε := by
    rw [← hG_norm_eq, ← hH_norm]
    have htri : ‖G‖ ≤ ‖H‖ + ‖G - H‖ := by
      calc ‖G‖ = ‖H + (G - H)‖ := by abel_nf
        _ ≤ ‖H‖ + ‖G - H‖ := norm_add_le _ _
    linarith
  have hsmall : (K_r + A_p) * ε < δ := by
    dsimp [ε]
    rw [mul_div_assoc', div_lt_iff₀ (by positivity)]
    nlinarith
  calc (eLpNorm F_h p circleMeasure).toReal
      ≤ K_r * ε + A_p * ((eLpNorm h p circleMeasure).toReal + ε) :=
        hFh_le.trans (add_le_add le_rfl
          (hFg_bound.trans (mul_le_mul_of_nonneg_left hg_le_h hAp_pos.le)))
    _ = A_p * (eLpNorm h p circleMeasure).toReal + (K_r + A_p) * ε := by ring
    _ ≤ A_p * (eLpNorm h p circleMeasure).toReal + δ := by linarith

theorem herglotzTransform_radialSizeENNReal_le {p : ℝ≥0∞} (hp1 : 1 < p) (hptop : p ≠ ⊤)
    {h : FourierCircle → ℂ} (hh : MemLp h p circleMeasure)
    {r : ℝ} (hr : r ∈ Set.Ico (0 : ℝ) 1) :
    radialSizeENNReal p (herglotzTransform h) r ≤
      ENNReal.ofReal (rieszConstant p.toReal * (eLpNorm h p circleMeasure).toReal) := by
  have hp0 : p ≠ 0 := (zero_lt_one.trans hp1).ne'
  have hh_int : Integrable h circleMeasure := hh.integrable hp1.le
  have hcont : Continuous (radialSlice (herglotzTransform h) r) :=
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn (holomorphicOn_herglotzTransform hh_int)) hr.1 hr.2
  have hfin : radialSizeENNReal p (herglotzTransform h) r ≠ ⊤ := by
    unfold radialSizeENNReal
    simp only [hp0, ↓reduceIte]
    exact (continuous_memLp_of_compact hcont).eLpNorm_ne_top
  rw [← ENNReal.ofReal_toReal hfin]
  exact ENNReal.ofReal_le_ofReal (herglotzTransform_radialSize_le hp1 hptop hh hr)

theorem herglotzTransform_hardySizeENNReal_le {p : ℝ≥0∞} (hp1 : 1 < p) (hptop : p ≠ ⊤)
    {h : FourierCircle → ℂ} (hh : MemLp h p circleMeasure) :
    hardySizeENNReal p (herglotzTransform h) ≤
      ENNReal.ofReal (rieszConstant p.toReal * (eLpNorm h p circleMeasure).toReal) := by
  unfold hardySizeENNReal
  exact iSup₂_le fun r hr ↦ herglotzTransform_radialSizeENNReal_le hp1 hptop hh hr

/-- **M. Riesz's Theorem** (`IsInHardySpace` & `hardySize` bound for `MemLp h p circleMeasure`). -/
theorem herglotzTransform_isInHardySpace {p : ℝ≥0∞} (hp1 : 1 < p) (hptop : p ≠ ⊤)
    {h : FourierCircle → ℂ} (hh : MemLp h p circleMeasure) :
    IsInHardySpace p (herglotzTransform h) ∧
    hardySize p (herglotzTransform h) ≤
      rieszConstant p.toReal * (eLpNorm h p circleMeasure).toReal := by
  have hp0 : p ≠ 0 := (zero_lt_one.trans hp1).ne'
  have hh_int : Integrable h circleMeasure := hh.integrable hp1.le
  have hle := herglotzTransform_hardySizeENNReal_le hp1 hptop hh
  have hlt : hardySizeENNReal p (herglotzTransform h) < ⊤ :=
    lt_of_le_of_lt hle ENNReal.ofReal_lt_top
  have hAp_nn : 0 ≤ rieszConstant p.toReal * (eLpNorm h p circleMeasure).toReal :=
    mul_nonneg (rieszConstant_pos (one_lt_toReal_of_one_lt hp1 hptop)).le
      ENNReal.toReal_nonneg
  refine ⟨⟨hp0, holomorphicOn_herglotzTransform hh_int, hlt⟩, ?_⟩
  unfold hardySize
  calc (hardySizeENNReal p (herglotzTransform h)).toReal
      ≤ (ENNReal.ofReal (rieszConstant p.toReal * (eLpNorm h p circleMeasure).toReal)).toReal :=
        ENNReal.toReal_mono ENNReal.ofReal_ne_top hle
    _ = rieszConstant p.toReal * (eLpNorm h p circleMeasure).toReal :=
        ENNReal.toReal_ofReal hAp_nn


/-- `ψ` as a map `CircleLp p → HardyElem p` (`1 < p < ∞`). -/
def herglotzHardyMap (p : ℝ≥0∞) (hp1 : 1 < p) (hptop : p ≠ ⊤) (H : CircleLp p) : HardyElem p :=
  HardyElem.ofIsInHardySpace (herglotzTransformLp p H)
    (herglotzTransform_isInHardySpace hp1 hptop (Lp.memLp H)).1

private def radialHerglotzContMap (p : ℝ≥0∞) (hp1 : 1 < p) (H : CircleLp p)
    (r : ℝ) (hr : r ∈ Set.Ico (0 : ℝ) 1) : C(FourierCircle, ℂ) :=
  ⟨radialSlice (herglotzTransformLp p H) r,
    continuous_radialSlice_of_continuousOn
      (continuousOn_of_holomorphicOn
        (holomorphicOn_herglotzTransform ((Lp.memLp H).integrable hp1.le)))
      (Set.mem_Ico.mp hr).1 (Set.mem_Ico.mp hr).2⟩

private theorem radialHerglotzContMap_apply (p : ℝ≥0∞) (hp1 : 1 < p) (H : CircleLp p)
    (r : ℝ) (hr : r ∈ Set.Ico (0 : ℝ) 1) (θ : FourierCircle) :
    radialHerglotzContMap p hp1 H r hr θ =
      herglotzTransform H ((r : ℂ) * circlePoint θ) :=
  rfl

private theorem coe_radialHerglotzContMap (p : ℝ≥0∞) (hp1 : 1 < p) (H : CircleLp p)
    (r : ℝ) (hr : r ∈ Set.Ico (0 : ℝ) 1) :
    (radialHerglotzContMap p hp1 H r hr : FourierCircle → ℂ) =
      radialSlice (herglotzTransform H) r :=
  rfl

private def herglotzRadialLinearMap (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp1 : 1 < p)
    (r : ℝ) (hr : r ∈ Set.Ico (0 : ℝ) 1) : CircleLp p →ₗ[ℂ] CircleLp p where
  toFun H := ContinuousMap.toLp p circleMeasure ℂ (radialHerglotzContMap p hp1 H r hr)
  map_add' H₁ H₂ := by
    apply Lp.ext
    filter_upwards [
      ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℂ) circleMeasure
        (radialHerglotzContMap p hp1 (H₁ + H₂) r hr),
      Lp.coeFn_add
        (ContinuousMap.toLp p circleMeasure ℂ (radialHerglotzContMap p hp1 H₁ r hr))
        (ContinuousMap.toLp p circleMeasure ℂ (radialHerglotzContMap p hp1 H₂ r hr)),
      ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℂ) circleMeasure
        (radialHerglotzContMap p hp1 H₁ r hr),
      ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℂ) circleMeasure
        (radialHerglotzContMap p hp1 H₂ r hr)] with θ h0 h1 h2 h3
    rw [h0, h1, Pi.add_apply, h2, h3, radialHerglotzContMap_apply,
      radialHerglotzContMap_apply, radialHerglotzContMap_apply]
    have hz_lt : ‖(r : ℂ) * circlePoint θ‖ < 1 := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (Set.mem_Ico.mp hr).1, norm_circlePoint, mul_one]
      exact (Set.mem_Ico.mp hr).2
    rw [herglotzTransform_congr_ae (Lp.coeFn_add H₁ H₂)]
    exact herglotzTransform_add ((Lp.memLp H₁).integrable hp1.le)
      ((Lp.memLp H₂).integrable hp1.le) hz_lt.ne
  map_smul' (c : ℂ) H := by
    dsimp only [RingHom.id_apply]
    apply Lp.ext
    filter_upwards [
      ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℂ) circleMeasure
        (radialHerglotzContMap p hp1 (c • H) r hr),
      Lp.coeFn_smul c
        (ContinuousMap.toLp p circleMeasure ℂ (radialHerglotzContMap p hp1 H r hr)),
      ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℂ) circleMeasure
        (radialHerglotzContMap p hp1 H r hr)] with θ h0 h1 h2
    rw [h0, h1, Pi.smul_apply, h2, radialHerglotzContMap_apply, radialHerglotzContMap_apply,
      smul_eq_mul]
    rw [herglotzTransform_congr_ae (Lp.coeFn_smul c H)]
    exact herglotzTransform_const_mul c H ((r : ℂ) * circlePoint θ)

private theorem herglotzRadialLinearMap_apply (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp1 : 1 < p)
    (r : ℝ) (hr : r ∈ Set.Ico (0 : ℝ) 1) (H : CircleLp p) :
    herglotzRadialLinearMap p hp1 r hr H =
      ContinuousMap.toLp p circleMeasure ℂ (radialHerglotzContMap p hp1 H r hr) :=
  rfl

/-- Bundled radial Herglotz operator `H ↦ (ψH)_r` as a continuous linear map
`CircleLp p →L[ℂ] CircleLp p` (`1 < p < ∞`, `0 ≤ r < 1`), uniformly norm-bounded by `A_p`. -/
def herglotzRadialCLM (p : ℝ≥0∞) [Fact (1 ≤ p)] (hp1 : 1 < p) (hptop : p ≠ ⊤)
    (r : ℝ) (hr : r ∈ Set.Ico (0 : ℝ) 1) : CircleLp p →L[ℂ] CircleLp p :=
  LinearMap.mkContinuous (herglotzRadialLinearMap p hp1 r hr) (rieszConstant p.toReal) fun H ↦ by
    have hcoe := ContinuousMap.coeFn_toLp (p := p) (𝕜 := ℂ) circleMeasure
      (radialHerglotzContMap p hp1 H r hr)
    rw [herglotzRadialLinearMap_apply, Lp.norm_def, eLpNorm_congr_ae hcoe,
      coe_radialHerglotzContMap, Lp.norm_def]
    simpa only [radialSize, radialSizeENNReal,
      (zero_lt_one.trans hp1).ne', ↓reduceIte] using
      herglotzTransform_radialSize_le hp1 hptop (Lp.memLp H) hr

theorem herglotzRadialCLM_opNorm_le {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp1 : 1 < p) (hptop : p ≠ ⊤)
    {r : ℝ} (hr : r ∈ Set.Ico (0 : ℝ) 1) :
    ‖herglotzRadialCLM p hp1 hptop r hr‖ ≤ rieszConstant p.toReal :=
  LinearMap.mkContinuous_norm_le _
    (rieszConstant_pos (one_lt_toReal_of_one_lt hp1 hptop)).le _

/-- **17.26 (M. Riesz's Theorem, `ℝ≥0∞` exponent form, pp. 351–352):**
For every `p : ℝ≥0∞` with `1 < p` and `p < ⊤`, there exists `A_p > 0` such that for every
`h : FourierCircle → ℂ` with `MemLp h p circleMeasure`:
- `ψh = herglotzTransform h` belongs to `H^p(U)` (`IsInHardySpace p (herglotzTransform h)`),
- `hardySize p (herglotzTransform h) ≤ A_p * (eLpNorm h p circleMeasure).toReal`,
- uniformly for all `r ∈ [0, 1)`,
  `radialSize p (herglotzTransform h) r ≤ A_p * (eLpNorm h p circleMeasure).toReal`,
and for every `H : CircleLp p`, `herglotzTransformLp p H` belongs to `H^p(U)` with
`hardySize p (herglotzTransformLp p H) ≤ A_p * ‖H‖`. -/
theorem theorem17_26 {p : ℝ≥0∞} (hp1 : 1 < p) (hptop : p < ⊤) :
    ∃ A_p : ℝ, 0 < A_p ∧
      (∀ {h : FourierCircle → ℂ}, MemLp h p circleMeasure →
        IsInHardySpace p (herglotzTransform h) ∧
        hardySize p (herglotzTransform h) ≤
          A_p * (eLpNorm h p circleMeasure).toReal ∧
        ∀ r ∈ Set.Ico (0 : ℝ) 1,
          radialSize p (herglotzTransform h) r ≤
            A_p * (eLpNorm h p circleMeasure).toReal) ∧
      (∀ H : CircleLp p,
        IsInHardySpace p (herglotzTransformLp p H) ∧
        hardySize p (herglotzTransformLp p H) ≤ A_p * ‖H‖) := by
  refine ⟨rieszConstant p.toReal,
    rieszConstant_pos (one_lt_toReal_of_one_lt hp1 hptop.ne), ?_, ?_⟩
  · intro h hh
    obtain ⟨hhardy, hsize⟩ := herglotzTransform_isInHardySpace hp1 hptop.ne hh
    exact ⟨hhardy, hsize, fun r hr ↦ herglotzTransform_radialSize_le hp1 hptop.ne hh hr⟩
  · intro H
    obtain ⟨hhardy, hsize⟩ := herglotzTransform_isInHardySpace hp1 hptop.ne (Lp.memLp H)
    rw [← Lp.norm_def] at hsize
    exact ⟨hhardy, hsize⟩

/-- Bundled continuous-linear-map uniform operator-norm version of `theorem17_26`. -/
theorem theorem17_26_clm {p : ℝ≥0∞} [Fact (1 ≤ p)] (hp1 : 1 < p) (hptop : p < ⊤) :
    ∃ A_p : ℝ, 0 < A_p ∧
      ∀ (r : ℝ) (hr : r ∈ Set.Ico (0 : ℝ) 1),
        ‖herglotzRadialCLM p hp1 hptop.ne r hr‖ ≤ A_p :=
  ⟨rieszConstant p.toReal,
    rieszConstant_pos (one_lt_toReal_of_one_lt hp1 hptop.ne),
    fun _ hr ↦ herglotzRadialCLM_opNorm_le hp1 hptop.ne hr⟩

/-- **17.26 (M. Riesz's Theorem, real exponent `1 < p < ∞` form, pp. 351–352):**
Verbatim real-exponent specialization for `p : ℝ` with `1 < p`. -/
theorem theorem17_26_real {p : ℝ} (hp1 : 1 < p) :
    ∃ A_p : ℝ, 0 < A_p ∧
      ∀ {h : FourierCircle → ℂ}, MemLp h (ENNReal.ofReal p) circleMeasure →
        IsInHardySpace (ENNReal.ofReal p) (herglotzTransform h) ∧
        hardySize (ENNReal.ofReal p) (herglotzTransform h) ≤
          A_p * (eLpNorm h (ENNReal.ofReal p) circleMeasure).toReal ∧
        ∀ r ∈ Set.Ico (0 : ℝ) 1,
          radialSize (ENNReal.ofReal p) (herglotzTransform h) r ≤
            A_p * (eLpNorm h (ENNReal.ofReal p) circleMeasure).toReal := by
  have hp1_enn : 1 < ENNReal.ofReal p := by
    by_contra hnot
    have hle : ENNReal.ofReal p ≤ 1 := le_of_not_gt hnot
    have htr := ENNReal.toReal_mono ENNReal.one_ne_top hle
    rw [ENNReal.toReal_ofReal (by linarith), ENNReal.toReal_one] at htr
    linarith
  obtain ⟨A_p, hAp_pos, hmain, _⟩ := theorem17_26 hp1_enn ENNReal.ofReal_lt_top
  exact ⟨A_p, hAp_pos, hmain⟩

/-- **Solution of the 17.24 Harmonic Conjugate Problem (`1 < p < ∞`, pp. 350–352):**
If `v` is the normalized harmonic conjugate of `u` on `U = Metric.ball 0 1` (`v(0) = 0`) and
`U_sup := ⨆ r ∈ [0, 1), ‖u_r‖_{L^p(T)} < ⊤` (`1 < p < ⊤`), then `F = u + i v` belongs to `H^p(U)`,
`hardySize p F ≤ rieszConstant p.toReal * U_sup.toReal`, and
`(⨆ r ∈ [0, 1), ‖v_r‖_{L^p(T)}).toReal ≤ rieszConstant p.toReal * U_sup.toReal`. -/
theorem harmonicConjugate_hardy_bound {p : ℝ≥0∞} (hp1 : 1 < p) (hptop : p < ⊤)
    {u v : ℂ → ℝ} (hconj : IsNormalizedHarmonicConjugate u v)
    (hu_bdd : (⨆ r ∈ Set.Ico (0 : ℝ) 1,
      eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) p circleMeasure) < ⊤) :
    let F : ℂ → ℂ := fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I
    let U_sup : ℝ≥0∞ := ⨆ r ∈ Set.Ico (0 : ℝ) 1,
      eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) p circleMeasure
    let V_sup : ℝ≥0∞ := ⨆ r ∈ Set.Ico (0 : ℝ) 1,
      eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) p circleMeasure
    IsInHardySpace p F ∧
    V_sup < ⊤ ∧
    hardySize p F ≤ rieszConstant p.toReal * U_sup.toReal ∧
    V_sup.toReal ≤ rieszConstant p.toReal * U_sup.toReal := by
  intro F U_sup V_sup
  have hp0 : p ≠ 0 := (zero_lt_one.trans hp1).ne'
  have hF_holo : HolomorphicOn F (Metric.ball (0 : ℂ) 1) := hconj.1
  have hF_diff : DifferentiableOn ℂ F (Metric.ball (0 : ℂ) 1) :=
    (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hF_holo
  have hrad_F : ∀ r ∈ Set.Ico (0 : ℝ) 1,
      radialSizeENNReal p F r ≤
        ENNReal.ofReal (rieszConstant p.toReal * U_sup.toReal) := by
    intro r hr
    rcases hr with ⟨hr0, hr1⟩
    let R : ℝ := (r + 1) / 2
    have hR0 : 0 < R := by dsimp [R]; linarith
    have hR1 : R < 1 := by dsimp [R]; linarith
    let ρ : ℝ := r / R
    have hρ_mem : ρ ∈ Set.Ico (0 : ℝ) 1 :=
      ⟨div_nonneg hr0 hR0.le, (div_lt_one hR0).mpr (by dsimp [R]; linarith)⟩
    let G : ℂ → ℂ := fun z ↦ F ((R : ℂ) * z)
    have hscale_maps : Set.MapsTo (fun z : ℂ ↦ (R : ℂ) * z)
        (Metric.closedBall (0 : ℂ) 1) (Metric.ball (0 : ℂ) 1) := by
      intro z hz
      rw [Metric.mem_closedBall, dist_zero_right] at hz
      rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hR0]
      nlinarith
    have hG_diff : DifferentiableOn ℂ G (Metric.ball (0 : ℂ) 1) :=
      hF_diff.comp ((differentiable_id.const_mul (R : ℂ)).differentiableOn)
        (Metric.ball_subset_closedBall.trans hscale_maps)
    have hdcc : DiffContOnCl ℂ G (Metric.ball (0 : ℂ) 1) :=
      ⟨hG_diff, hF_diff.continuousOn.comp
        ((continuous_const.mul continuous_id).continuousOn)
        (Metric.closure_ball_subset_closedBall.trans hscale_maps)⟩
    let h_R : FourierCircle → ℂ := fun ζ ↦ (u ((R : ℂ) * circlePoint ζ) : ℂ)
    have hu_R_cont : Continuous (fun ζ : FourierCircle ↦ u ((R : ℂ) * circlePoint ζ)) := by
      have hu_cont : ContinuousOn u (Metric.ball (0 : ℂ) 1) := by
        have := Complex.continuous_re.comp_continuousOn hF_diff.continuousOn
        refine this.congr fun z _ ↦ ?_
        simp [F]
      exact continuous_radialSlice_of_continuousOn hu_cont hR0.le hR1
    have hhR_cont : Continuous h_R := Complex.continuous_ofReal.comp hu_R_cont
    have hhR_mem : MemLp h_R p circleMeasure := continuous_memLp_of_compact hhR_cont
    have hhR_int : Integrable h_R circleMeasure := hhR_mem.integrable hp1.le
    have hG_eq_herg : ∀ z ∈ Metric.ball (0 : ℂ) 1, G z = herglotzTransform h_R z := by
      have hre_eq : ∀ w ∈ Metric.ball (0 : ℂ) 1, (G w - herglotzTransform h_R w).re = 0 := by
        intro w hw
        have hpif := hdcc.circleAverage_poissonKernel_smul hw
        have havg := integral_radialSlice_eq_circleAverage (_root_.poissonKernel 0 w • G) 1
        simp only [Complex.ofReal_one, one_mul] at havg
        rw [← havg] at hpif
        change (∫ ζ, _root_.poissonKernel 0 w (circlePoint ζ) • G (circlePoint ζ) ∂circleMeasure) =
          G w at hpif
        have hw_lt : ‖w‖ < 1 := mem_ball_zero_iff.mp hw
        have hw_not : w ∉ Metric.sphere (0 : ℂ) |(1 : ℝ)| := by
          rw [abs_of_pos zero_lt_one, Metric.mem_sphere, dist_zero_right]
          exact hw_lt.ne
        have hpk_cont : ContinuousOn (_root_.poissonKernel 0 w) (Metric.sphere 0 1) := by
          have hk := Complex.continuous_re.comp_continuousOn
            (continuousOn_herglotzRieszKernel_sphere hw_not)
          rwa [← poissonKernel_eq_re_herglotzRieszKernel, abs_of_pos zero_lt_one] at hk
        have hG_sph_cont : Continuous (fun ζ : FourierCircle ↦ G (circlePoint ζ)) :=
          continuous_radialSlice_of_continuousOn hF_diff.continuousOn hR0.le hR1
        have hint_pG : Integrable
            (fun ζ : FourierCircle ↦ _root_.poissonKernel 0 w (circlePoint ζ) • G (circlePoint ζ))
            circleMeasure :=
          continuous_integrable_of_compact
            ((hpk_cont.comp_continuous continuous_circlePoint circlePoint_mem_sphere).smul
              hG_sph_cont)
        have hcomm := (Complex.reCLM.integral_comp_comm hint_pG).symm
        change (∫ ζ, _root_.poissonKernel 0 w (circlePoint ζ) • G (circlePoint ζ)
            ∂circleMeasure).re =
          ∫ ζ, (_root_.poissonKernel 0 w (circlePoint ζ) • G (circlePoint ζ)).re
            ∂circleMeasure at hcomm
        rw [hpif] at hcomm
        have hGre : (G w).re = circlePoissonIntegral (fun ζ ↦ (h_R ζ).re) w := by
          rw [hcomm]
          unfold circlePoissonIntegral
          refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
          simp [G, F, h_R, smul_eq_mul]
        have hHre := (herglotzTransform_real_properties hhR_int
          (fun _ ↦ Complex.ofReal_im _)).1 w hw
        rw [Complex.sub_re, hGre, hHre, sub_self]
      have hdiff_sub : DifferentiableOn ℂ (fun w ↦ G w - herglotzTransform h_R w)
          (Metric.ball (0 : ℂ) 1) :=
        hG_diff.sub
          ((holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp
            (holomorphicOn_herglotzTransform hhR_int))
      intro z hz
      have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
      have hc := holomorphic_re_zero_is_const Metric.isOpen_ball
        (convex_ball (0 : ℂ) 1).isPreconnected hdiff_sub hre_eq hz h0_mem
      have h0_zero : G 0 - herglotzTransform h_R 0 = 0 := by
        apply Complex.ext
        · exact hre_eq 0 h0_mem
        · have him0 := (herglotzTransform_real_properties hhR_int
            (fun _ ↦ Complex.ofReal_im _)).2.1
          rw [Complex.sub_im, him0, sub_zero]
          simp [G, F, hconj.2]
      exact sub_eq_zero.mp (hc.trans h0_zero)
    have hslice_eq : radialSlice F r = radialSlice (herglotzTransform h_R) ρ := by
      ext θ
      unfold radialSlice
      have hρ_ball : (ρ : ℂ) * circlePoint θ ∈ Metric.ball (0 : ℂ) 1 := by
        rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg hρ_mem.1, norm_circlePoint, mul_one]
        exact hρ_mem.2
      rw [← hG_eq_herg _ hρ_ball]
      dsimp [G, ρ]
      congr 1
      rw [← mul_assoc]
      congr 1
      push_cast
      exact (mul_div_cancel₀ (r : ℂ) (Complex.ofReal_ne_zero.mpr hR0.ne')).symm
    have hrad_eq : radialSizeENNReal p F r =
        radialSizeENNReal p (herglotzTransform h_R) ρ := by
      unfold radialSizeENNReal radialZeroSize
      rw [hslice_eq]
    rw [hrad_eq]
    have hbound := herglotzTransform_radialSizeENNReal_le hp1 hptop.ne hhR_mem hρ_mem
    refine hbound.trans (ENNReal.ofReal_le_ofReal ?_)
    have heLp_eq : eLpNorm h_R p circleMeasure =
        eLpNorm (fun ζ ↦ u ((R : ℂ) * circlePoint ζ)) p circleMeasure := by
      refine eLpNorm_congr_norm_ae hhR_cont.aestronglyMeasurable hu_R_cont.aestronglyMeasurable
        (Eventually.of_forall fun ζ ↦ ?_)
      simp [h_R]
    have hR_ico : R ∈ Set.Ico (0 : ℝ) 1 := ⟨hR0.le, hR1⟩
    have hle_sup : eLpNorm h_R p circleMeasure ≤ U_sup := by
      rw [heLp_eq]
      exact le_biSup
        (fun s : ℝ ↦ eLpNorm (fun ζ ↦ u ((s : ℂ) * circlePoint ζ)) p circleMeasure) hR_ico
    exact mul_le_mul_of_nonneg_left (ENNReal.toReal_mono hu_bdd.ne hle_sup)
      (rieszConstant_pos (one_lt_toReal_of_one_lt hp1 hptop.ne)).le
  have hhardy_le : hardySizeENNReal p F ≤
      ENNReal.ofReal (rieszConstant p.toReal * U_sup.toReal) :=
    iSup₂_le hrad_F
  have hhardy_lt : hardySizeENNReal p F < ⊤ :=
    lt_of_le_of_lt hhardy_le ENNReal.ofReal_lt_top
  have hV_le_F : V_sup ≤ hardySizeENNReal p F := by
    refine iSup₂_le fun r hr ↦ ?_
    have hle_r : eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) p circleMeasure ≤
        radialSizeENNReal p F r := by
      unfold radialSizeENNReal
      simp only [hp0, ↓reduceIte]
      have hF_r_cont : Continuous (radialSlice F r) :=
        continuous_radialSlice_of_continuousOn hF_diff.continuousOn hr.1 hr.2
      have hv_r_cont : Continuous (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) := by
        have : (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) = fun ζ ↦ (radialSlice F r ζ).im := by
          ext ζ; simp [radialSlice, F]
        rw [this]
        exact Complex.continuous_im.comp hF_r_cont
      refine eLpNorm_mono hv_r_cont.aestronglyMeasurable fun ζ ↦ ?_
      have him_eq : v ((r : ℂ) * circlePoint ζ) = (radialSlice F r ζ).im := by
        simp [radialSlice, F]
      rw [Real.norm_eq_abs, him_eq]
      exact Complex.abs_im_le_norm _
    exact hle_r.trans (le_biSup (radialSizeENNReal p F) hr)
  have hV_lt : V_sup < ⊤ := lt_of_le_of_lt hV_le_F hhardy_lt
  have hAp_nn : 0 ≤ rieszConstant p.toReal * U_sup.toReal :=
    mul_nonneg (rieszConstant_pos (one_lt_toReal_of_one_lt hp1 hptop.ne)).le
      ENNReal.toReal_nonneg
  have hF_size_le : hardySize p F ≤ rieszConstant p.toReal * U_sup.toReal := by
    unfold hardySize
    calc (hardySizeENNReal p F).toReal
        ≤ (ENNReal.ofReal (rieszConstant p.toReal * U_sup.toReal)).toReal :=
          ENNReal.toReal_mono ENNReal.ofReal_ne_top hhardy_le
      _ = rieszConstant p.toReal * U_sup.toReal := ENNReal.toReal_ofReal hAp_nn
  have hV_size_le : V_sup.toReal ≤ rieszConstant p.toReal * U_sup.toReal :=
    (ENNReal.toReal_mono hhardy_lt.ne hV_le_F).trans hF_size_le
  exact ⟨⟨hp0, hF_holo, hhardy_lt⟩, hV_lt, hF_size_le, hV_size_le⟩

/-! ### 17.24 Endpoint Counterexamples (`p = 1` and `p = ∞`, pp. 350–351) -/

private theorem poissonDen_pos {r : ℝ} (_hr0 : 0 ≤ r) (hr1 : r < 1) (θ : ℝ) :
    0 < 1 - 2 * r * Real.cos θ + r ^ 2 := by
  have hc : Real.cos θ ≤ 1 := Real.cos_le_one θ
  have hsq : 0 < (1 - r) ^ 2 := sq_pos_of_pos (sub_pos.mpr hr1)
  nlinarith

private theorem conjPoissonConvKernel_coe {r : ℝ} (_hr0 : 0 ≤ r) (_hr1 : r < 1) (θ : ℝ) :
    conjPoissonConvKernel r (θ : FourierCircle) =
      (2 * r * Real.sin θ) / (1 - 2 * r * Real.cos θ + r ^ 2) := by
  unfold conjPoissonConvKernel herglotzConvKernel
  rw [circlePoint_coe]
  let z : ℂ := (r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)
  change ((1 + z) / (1 - z)).im = _
  have hz : z = ((r * Real.cos θ : ℝ) : ℂ) + ((r * Real.sin θ : ℝ) : ℂ) * Complex.I := by
    dsimp [z]
    rw [Complex.exp_ofReal_mul_I]
    push_cast
    ring
  have h1zp : 1 + z = ((1 + r * Real.cos θ : ℝ) : ℂ) + ((r * Real.sin θ : ℝ) : ℂ) * Complex.I := by
    rw [hz]; push_cast; ring
  have h1zm : 1 - z = ((1 - r * Real.cos θ : ℝ) : ℂ) + ((-r * Real.sin θ : ℝ) : ℂ) * Complex.I := by
    rw [hz]; push_cast; ring
  have hns : Complex.normSq (1 - z) = 1 - 2 * r * Real.cos θ + r ^ 2 := by
    rw [h1zm]
    simp only [Complex.normSq_apply, Complex.add_re, Complex.add_im, Complex.ofReal_re,
      Complex.ofReal_im, Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im,
      mul_zero, mul_one, add_zero, zero_add, sub_zero]
    calc (1 - r * Real.cos θ) * (1 - r * Real.cos θ) + (-r * Real.sin θ) * (-r * Real.sin θ)
        = 1 - 2 * r * Real.cos θ + r ^ 2 * (Real.cos θ ^ 2 + Real.sin θ ^ 2) := by ring
      _ = 1 - 2 * r * Real.cos θ + r ^ 2 := by rw [Real.cos_sq_add_sin_sq, mul_one]
  rw [Complex.div_im, hns, h1zp, h1zm, ← sub_div]
  congr 1
  simp only [Complex.add_re, Complex.add_im, Complex.ofReal_re, Complex.ofReal_im,
    Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im,
    mul_zero, mul_one, add_zero, zero_add, sub_zero]
  ring

private theorem integral_conjPoisson_zero_pi {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (∫ θ in (0 : ℝ)..Real.pi, (2 * r * Real.sin θ) / (1 - 2 * r * Real.cos θ + r ^ 2)) =
      2 * Real.log ((1 + r) / (1 - r)) := by
  have hderiv : ∀ θ ∈ Set.uIcc (0 : ℝ) Real.pi,
      HasDerivAt (fun t ↦ Real.log (1 - 2 * r * Real.cos t + r ^ 2))
        ((2 * r * Real.sin θ) / (1 - 2 * r * Real.cos θ + r ^ 2)) θ := by
    intro θ _
    have hd1 : HasDerivAt (fun t ↦ 1 - 2 * r * Real.cos t + r ^ 2) (2 * r * Real.sin θ) θ := by
      have hc := (Real.hasDerivAt_cos θ).const_mul (-2 * r)
      have hsub : HasDerivAt (fun t ↦ 1 + (-2 * r * Real.cos t) + r ^ 2)
          (0 + (-2 * r) * (-Real.sin θ) + 0) θ :=
        ((hasDerivAt_const θ (1 : ℝ)).add hc).add (hasDerivAt_const θ (r ^ 2))
      convert hsub using 1
      · ext t; ring
      · ring
    exact hd1.log (poissonDen_pos hr0 hr1 θ).ne'
  have hint : IntervalIntegrable
      (fun θ ↦ (2 * r * Real.sin θ) / (1 - 2 * r * Real.cos θ + r ^ 2))
      volume 0 Real.pi := by
    refine Continuous.intervalIntegrable ?_ 0 Real.pi
    exact ((continuous_const.mul Real.continuous_sin).div
      ((continuous_const.sub (continuous_const.mul Real.continuous_cos)).add continuous_const)
      fun θ ↦ (poissonDen_pos hr0 hr1 θ).ne')
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv hint]
  have hpi : 1 - 2 * r * Real.cos Real.pi + r ^ 2 = (1 + r) ^ 2 := by
    rw [Real.cos_pi]; ring
  have h0 : 1 - 2 * r * Real.cos 0 + r ^ 2 = (1 - r) ^ 2 := by
    rw [Real.cos_zero]; ring
  have h1pr : 0 < 1 + r := by linarith
  have h1mr : 0 < 1 - r := sub_pos.mpr hr1
  rw [hpi, h0, Real.log_pow, Real.log_pow, Nat.cast_ofNat,
    ← mul_sub, Real.log_div h1pr.ne' h1mr.ne']

private theorem integral_abs_conjPoissonConvKernel_ge {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Real.pi⁻¹ * Real.log ((1 + r) / (1 - r)) ≤
      ∫ ζ, |conjPoissonConvKernel r ζ| ∂circleMeasure := by
  rw [AddCircle.integral_haarAddCircle,
    ← AddCircle.intervalIntegral_preimage (2 * Real.pi) 0
      (fun ζ : FourierCircle ↦ |conjPoissonConvKernel r ζ|),
    zero_add, smul_eq_mul]
  have hcont_all : Continuous (fun θ : ℝ ↦ |conjPoissonConvKernel r (θ : FourierCircle)|) :=
    continuous_abs.comp ((continuous_conjPoissonConvKernel hr0 hr1).comp continuous_quotient_mk')
  have hmono := intervalIntegral.integral_mono_interval (μ := volume)
    (le_refl (0 : ℝ)) Real.pi_pos.le (by linarith [Real.pi_pos])
    (Eventually.of_forall fun θ ↦ abs_nonneg (conjPoissonConvKernel r (θ : FourierCircle)))
    (hcont_all.intervalIntegrable 0 (2 * Real.pi))
  have hcongr : (∫ θ in (0 : ℝ)..Real.pi, |conjPoissonConvKernel r (θ : FourierCircle)|) =
      ∫ θ in (0 : ℝ)..Real.pi, (2 * r * Real.sin θ) / (1 - 2 * r * Real.cos θ + r ^ 2) := by
    refine intervalIntegral.integral_congr fun θ hθ ↦ ?_
    rw [Set.uIcc_of_le Real.pi_pos.le] at hθ
    rw [conjPoissonConvKernel_coe hr0 hr1 θ, abs_of_nonneg]
    exact div_nonneg (mul_nonneg (by linarith) (Real.sin_nonneg_of_mem_Icc hθ))
      (poissonDen_pos hr0 hr1 θ).le
  rw [hcongr, integral_conjPoisson_zero_pi hr0 hr1] at hmono
  calc Real.pi⁻¹ * Real.log ((1 + r) / (1 - r))
      = (2 * Real.pi)⁻¹ * (2 * Real.log ((1 + r) / (1 - r))) := by
          field_simp [Real.pi_ne_zero]
    _ ≤ (2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..(2 * Real.pi),
          |conjPoissonConvKernel r (θ : FourierCircle)| :=
        mul_le_mul_of_nonneg_left hmono (inv_nonneg.mpr (by positivity))

private theorem ofReal_norm_le_eLpNorm_top_of_continuous {E : Type*} [NormedAddCommGroup E]
    {f : FourierCircle → E} (hf : Continuous f) (ζ₀ : FourierCircle) :
    ENNReal.ofReal ‖f ζ₀‖ ≤ eLpNorm f ⊤ circleMeasure := by
  by_contra hnot
  have hlt : eLpNorm f ⊤ circleMeasure < ENNReal.ofReal ‖f ζ₀‖ := lt_of_not_ge hnot
  have hfin : eLpNorm f ⊤ circleMeasure ≠ ⊤ := ne_top_of_lt hlt
  have hpos : 0 < ‖f ζ₀‖ := by
    by_contra h0
    have hz : ‖f ζ₀‖ = 0 := le_antisymm (le_of_not_gt h0) (norm_nonneg _)
    rw [hz, ENNReal.ofReal_zero] at hlt
    exact not_lt_zero hlt
  let c : ℝ := (eLpNorm f ⊤ circleMeasure).toReal
  have hc_lt : c < ‖f ζ₀‖ :=
    (ENNReal.ofReal_lt_ofReal_iff hpos).mp (by rwa [ENNReal.ofReal_toReal hfin])
  let U : Set FourierCircle := {ζ | c < ‖f ζ‖}
  have hU_open : IsOpen U := isOpen_lt continuous_const hf.norm
  have hU_pos : circleMeasure U ≠ 0 := hU_open.measure_ne_zero circleMeasure ⟨ζ₀, hc_lt⟩
  have hae : ∀ᵐ ζ ∂circleMeasure, ‖f ζ‖ ≤ c := by
    filter_upwards [ae_le_eLpNormEssSup (f := f) (μ := circleMeasure)] with ζ hζ
    have hle : ‖f ζ‖ₑ ≤ eLpNorm f ⊤ circleMeasure :=
      hζ.trans eLpNormEssSup_le_eLpNorm_top
    have htr := ENNReal.toReal_mono hfin hle
    simpa [c, enorm_eq_nnnorm] using htr
  have hzero : circleMeasure {ζ : FourierCircle | ¬ ‖f ζ‖ ≤ c} = 0 := ae_iff.mp hae
  simp only [not_le] at hzero
  exact hU_pos hzero

private theorem iSup_Ico_eq_top_of_log_lower_bound {Φ : ℝ → ℝ≥0∞} {κ : ℝ} (hκ : 0 < κ)
    (hlo : ∀ r ∈ Set.Ioo (0 : ℝ) 1,
      ENNReal.ofReal (κ * Real.log ((1 + r) / (1 - r))) ≤ Φ r) :
    (⨆ r ∈ Set.Ico (0 : ℝ) 1, Φ r) = ⊤ := by
  by_contra hne
  let S : ℝ≥0∞ := ⨆ r ∈ Set.Ico (0 : ℝ) 1, Φ r
  change S ≠ ⊤ at hne
  let b : ℝ := S.toReal
  have hb_nn : 0 ≤ b := ENNReal.toReal_nonneg
  let M : ℝ := max 1 ((b + 1) / κ)
  have hM_pos : 0 < M := lt_of_lt_of_le zero_lt_one (le_max_left _ _)
  let r : ℝ := 1 - 1 / (Real.exp M + 1)
  have hexp_pos : 0 < Real.exp M := Real.exp_pos M
  have hexp_gt1 : 1 < Real.exp M := Real.one_lt_exp_iff.mpr hM_pos
  have hr0 : 0 < r := by
    dsimp [r]
    have : 1 / (Real.exp M + 1) < 1 := (div_lt_one (by linarith)).mpr (by linarith)
    linarith
  have hr1 : r < 1 := by
    dsimp [r]
    have : 0 < 1 / (Real.exp M + 1) := by positivity
    linarith
  have hquot : Real.exp M ≤ (1 + r) / (1 - r) := by
    have h1mr : 1 - r = (Real.exp M + 1)⁻¹ := by dsimp [r]; ring
    rw [h1mr, div_inv_eq_mul]
    nlinarith
  have hlog : M ≤ Real.log ((1 + r) / (1 - r)) := by
    calc M = Real.log (Real.exp M) := (Real.log_exp M).symm
      _ ≤ Real.log ((1 + r) / (1 - r)) := Real.log_le_log hexp_pos hquot
  have hbp1_le : b + 1 ≤ κ * Real.log ((1 + r) / (1 - r)) := by
    have hM_ge : (b + 1) / κ ≤ M := le_max_right _ _
    have h1 : b + 1 ≤ κ * M := by
      have := mul_le_mul_of_nonneg_left hM_ge hκ.le
      rwa [mul_div_cancel₀ _ hκ.ne'] at this
    have h2 : κ * M ≤ κ * Real.log ((1 + r) / (1 - r)) :=
      mul_le_mul_of_nonneg_left hlog hκ.le
    linarith
  have hr_ico : r ∈ Set.Ico (0 : ℝ) 1 := ⟨hr0.le, hr1⟩
  have hchain : ENNReal.ofReal (b + 1) ≤ S :=
    (ENNReal.ofReal_le_ofReal hbp1_le).trans
      ((hlo r ⟨hr0, hr1⟩).trans (le_biSup Φ hr_ico))
  have htr := ENNReal.toReal_mono hne hchain
  rw [ENNReal.toReal_ofReal (by linarith)] at htr
  dsimp [b] at htr
  linarith

/-- **17.24 Endpoint Failure at `p = 1` (pp. 350–351):**
For `F(z) = (1 + z) / (1 - z)` on `U = Metric.ball 0 1`, `u = Re F` is positive and harmonic on `U`,
`v = Im F` is its normalized harmonic conjugate (`v(0) = 0`),
`⨆_{0 ≤ r < 1} ‖u_r‖_{L^1(T)} = 1 < ⊤`, yet `⨆_{0 ≤ r < 1} ‖v_r‖_{L^1(T)} = ⊤` and
`¬ IsInHardySpace 1 (u + i v)`. -/
theorem node17_24_endpoint_one_counterexample :
    ∃ u v : ℂ → ℝ,
      RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1) ∧
      IsNormalizedHarmonicConjugate u v ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) 1 circleMeasure) = 1 ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) 1 circleMeasure) = ⊤ ∧
      ¬ IsInHardySpace 1 (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I) := by
  let F : ℂ → ℂ := fun z ↦ (1 + z) / (1 - z)
  let u : ℂ → ℝ := fun z ↦ (F z).re
  let v : ℂ → ℝ := fun z ↦ (F z).im
  have hF_eq : (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I) = F := by
    ext z; exact Complex.re_add_im (F z)
  have hF_diff : DifferentiableOn ℂ F (Metric.ball (0 : ℂ) 1) := by
    refine DifferentiableOn.div (differentiableOn_const (1 : ℂ) |>.add differentiableOn_id)
      (differentiableOn_const (1 : ℂ) |>.sub differentiableOn_id) fun z hz h0 ↦ ?_
    have hz1 : (1 : ℂ) = z := sub_eq_zero.mp h0
    have hn : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
    rw [← hz1, norm_one] at hn
    exact lt_irrefl 1 hn
  have hF_holo : HolomorphicOn F (Metric.ball (0 : ℂ) 1) :=
    (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hF_diff
  have hu_harm : RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1) :=
    (RudinRCA.Chapter11.node11_4_holomorphic_harmonic Metric.isOpen_ball hF_diff).comp_clm
      Metric.isOpen_ball Complex.reCLM
  have hv0 : v 0 = 0 := by simp [v, F]
  have hconj : IsNormalizedHarmonicConjugate u v := by
    refine ⟨?_, hv0⟩
    rwa [hF_eq]
  have hu_rad : ∀ r ∈ Set.Ico (0 : ℝ) 1,
      eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) 1 circleMeasure = 1 := by
    intro r ⟨hr0, hr1⟩
    have heq_p : (fun ζ : FourierCircle ↦ u ((r : ℂ) * circlePoint ζ)) = poissonConvKernel r :=
      rfl
    rw [heq_p]
    have hm1 : MemLp (poissonConvKernel r) 1 circleMeasure :=
      continuous_memLp_of_compact (continuous_poissonConvKernel hr0 hr1)
    rw [hm1.eLpNorm_eq_integral_rpow_norm one_ne_zero ENNReal.coe_ne_top,
      ENNReal.toReal_one, inv_one]
    have hint_eq : (∫ ζ, ‖poissonConvKernel r ζ‖ ^ (1 : ℝ) ∂circleMeasure) = 1 := by
      have hcongr : (∫ ζ, ‖poissonConvKernel r ζ‖ ^ (1 : ℝ) ∂circleMeasure) =
          ∫ ζ, poissonConvKernel r ζ ∂circleMeasure := by
        refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
        dsimp only
        rw [Real.rpow_one, Real.norm_eq_abs, abs_of_pos (poissonConvKernel_pos hr0 hr1 ζ)]
      rw [hcongr, integral_poissonConvKernel hr0 hr1]
    rw [hint_eq, Real.one_rpow, ENNReal.ofReal_one]
  have hu_sup : (⨆ r ∈ Set.Ico (0 : ℝ) 1,
      eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) 1 circleMeasure) = 1 := by
    refine le_antisymm (iSup₂_le fun r hr ↦ (hu_rad r hr).le) ?_
    have h0_mem : (0 : ℝ) ∈ Set.Ico (0 : ℝ) 1 := ⟨le_rfl, zero_lt_one⟩
    calc (1 : ℝ≥0∞)
        = eLpNorm (fun ζ ↦ u (((0 : ℝ) : ℂ) * circlePoint ζ)) 1 circleMeasure :=
          (hu_rad 0 h0_mem).symm
      _ ≤ ⨆ r ∈ Set.Ico (0 : ℝ) 1,
          eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) 1 circleMeasure :=
          le_biSup (fun r : ℝ ↦ eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) 1 circleMeasure)
            h0_mem
  have hv_lo : ∀ r ∈ Set.Ioo (0 : ℝ) 1,
      ENNReal.ofReal (Real.pi⁻¹ * Real.log ((1 + r) / (1 - r))) ≤
        eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) 1 circleMeasure := by
    intro r ⟨hr0, hr1⟩
    have heq_q : (fun ζ : FourierCircle ↦ v ((r : ℂ) * circlePoint ζ)) =
      conjPoissonConvKernel r := rfl
    rw [heq_q]
    have hm1 : MemLp (conjPoissonConvKernel r) 1 circleMeasure :=
      continuous_memLp_of_compact (continuous_conjPoissonConvKernel hr0.le hr1)
    rw [hm1.eLpNorm_eq_integral_rpow_norm one_ne_zero ENNReal.coe_ne_top,
      ENNReal.toReal_one, inv_one]
    refine ENNReal.ofReal_le_ofReal ?_
    have hcongr : (∫ ζ, ‖conjPoissonConvKernel r ζ‖ ^ (1 : ℝ) ∂circleMeasure) =
        ∫ ζ, |conjPoissonConvKernel r ζ| ∂circleMeasure := by
      refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
      simp [Real.norm_eq_abs]
    rw [hcongr, Real.rpow_one]
    exact integral_abs_conjPoissonConvKernel_ge hr0.le hr1
  have hv_sup : (⨆ r ∈ Set.Ico (0 : ℝ) 1,
      eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) 1 circleMeasure) = ⊤ :=
    iSup_Ico_eq_top_of_log_lower_bound (inv_pos.mpr Real.pi_pos) hv_lo
  have hnot_hardy : ¬ IsInHardySpace 1 (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I) := by
    rw [hF_eq]
    intro ⟨_, _, hlt⟩
    have hF_top : hardySizeENNReal 1 F = ⊤ := by
      refine iSup_Ico_eq_top_of_log_lower_bound (inv_pos.mpr Real.pi_pos) fun r hr ↦ ?_
      refine (hv_lo r hr).trans ?_
      unfold radialSizeENNReal
      simp only [one_ne_zero, ↓reduceIte]
      have hv_cont : Continuous (fun ζ : FourierCircle ↦ v ((r : ℂ) * circlePoint ζ)) :=
        continuous_conjPoissonConvKernel hr.1.le hr.2
      refine eLpNorm_mono hv_cont.aestronglyMeasurable fun ζ ↦ ?_
      rw [Real.norm_eq_abs]
      exact Complex.abs_im_le_norm (F ((r : ℂ) * circlePoint ζ))
    rw [hF_top] at hlt
    exact lt_irrefl ⊤ hlt
  exact ⟨u, v, hu_harm, hconj, hu_sup, hv_sup, hnot_hardy⟩

/-- **17.24 Endpoint Failure at `p = ∞` (pp. 350–351):**
1. For `F(z) = -i log ((1 + z) / (1 - z))` on `U = Metric.ball 0 1`, `u = Re F` is harmonic and
   bounded (`|u(z)| ≤ π / 2`, so `⨆_{0 ≤ r < 1} ‖u_r‖_{L^∞(T)} ≤ π / 2 < ⊤`), `v = Im F` is its
   normalized harmonic conjugate (`v(0) = 0`), yet `⨆_{0 ≤ r < 1} ‖v_r‖_{L^∞(T)} = ⊤` and
   `¬ IsInHardySpace ⊤ (u + i v)`.
2. Moreover, there exists a bounded real-valued `h ∈ L^∞(T)` (`MemLp h ⊤ circleMeasure` with
   `eLpNorm h ⊤ circleMeasure ≤ 1`) whose Herglotz transform satisfies
   `hardySizeENNReal ⊤ (herglotzTransform h) = ⊤` (`¬ IsInHardySpace ⊤ (herglotzTransform h)`). -/
theorem node17_24_endpoint_top_counterexample :
    (∃ u v : ℂ → ℝ,
      RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1) ∧
      IsNormalizedHarmonicConjugate u v ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) ⊤ circleMeasure) ≤
          ENNReal.ofReal (Real.pi / 2) ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) ⊤ circleMeasure) = ⊤ ∧
      ¬ IsInHardySpace ⊤ (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I)) ∧
    (∃ h : FourierCircle → ℂ,
      MemLp h ⊤ circleMeasure ∧
      (∀ ζ, (h ζ).im = 0) ∧
      eLpNorm h ⊤ circleMeasure ≤ 1 ∧
      hardySizeENNReal ⊤ (herglotzTransform h) = ⊤ ∧
      ¬ IsInHardySpace ⊤ (herglotzTransform h)) := by
  constructor
  · -- Part 1: Normalized harmonic conjugate pair from `-i log ((1 + z) / (1 - z))`.
    let W : ℂ → ℂ := fun z ↦ (1 + z) / (1 - z)
    let F : ℂ → ℂ := fun z ↦ -Complex.I * Complex.log (W z)
    let u : ℂ → ℝ := fun z ↦ (F z).re
    let v : ℂ → ℝ := fun z ↦ (F z).im
    have hF_eq : (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I) = F := by
      ext z; exact Complex.re_add_im (F z)
    have hW_re_pos : ∀ z ∈ Metric.ball (0 : ℂ) 1, 0 < (W z).re := by
      intro z hz
      have hz_lt : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
      have h1_sph : (1 : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by simp
      have hle : (1 - ‖z‖) / (1 + ‖z‖) ≤ (W z).re := by
        simpa [W] using le_re_herglotzRieszKernel h1_sph hz
      have hlo : 0 < (1 - ‖z‖) / (1 + ‖z‖) :=
        div_pos (sub_pos.mpr hz_lt) (by linarith [norm_nonneg z])
      exact hlo.trans_le hle
    have hW_slit : ∀ z ∈ Metric.ball (0 : ℂ) 1, W z ∈ Complex.slitPlane :=
      fun z hz ↦ Complex.mem_slitPlane_iff.mpr (Or.inl (hW_re_pos z hz))
    have hW_holo : HolomorphicOn W (Metric.ball (0 : ℂ) 1) := by
      intro z hz
      refine DifferentiableAt.div (differentiableAt_const (1 : ℂ) |>.add differentiableAt_id)
        (differentiableAt_const (1 : ℂ) |>.sub differentiableAt_id) fun h0 ↦ ?_
      have hz1 : (1 : ℂ) = z := sub_eq_zero.mp h0
      have hn : ‖z‖ < 1 := mem_ball_zero_iff.mp hz
      rw [← hz1, norm_one] at hn
      exact lt_irrefl 1 hn
    have hF_holo : HolomorphicOn F (Metric.ball (0 : ℂ) 1) :=
      fun z hz ↦ (differentiableAt_const (-Complex.I)).mul ((hW_holo z hz).clog (hW_slit z hz))
    have hF_diff : DifferentiableOn ℂ F (Metric.ball (0 : ℂ) 1) :=
      (holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hF_holo
    have hu_harm : RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1) :=
      (RudinRCA.Chapter11.node11_4_holomorphic_harmonic Metric.isOpen_ball hF_diff).comp_clm
        Metric.isOpen_ball Complex.reCLM
    have hF_re_im : ∀ z : ℂ, u z = Complex.arg (W z) ∧ v z = -Real.log ‖W z‖ := by
      intro z
      have hlog : Complex.log (W z) =
          (Real.log ‖W z‖ : ℂ) + (Complex.arg (W z) : ℂ) * Complex.I := by
        rw [← Complex.re_add_im (Complex.log (W z)), Complex.log_re, Complex.log_im]
      have hF_val : F z = (Complex.arg (W z) : ℂ) - (Real.log ‖W z‖ : ℂ) * Complex.I := by
        dsimp [F]
        rw [hlog]
        calc -Complex.I * ((Real.log ‖W z‖ : ℂ) + (Complex.arg (W z) : ℂ) * Complex.I)
            = -(Complex.arg (W z) : ℂ) * (Complex.I * Complex.I) -
                (Real.log ‖W z‖ : ℂ) * Complex.I := by ring
          _ = (Complex.arg (W z) : ℂ) - (Real.log ‖W z‖ : ℂ) * Complex.I := by
                rw [Complex.I_mul_I]; ring
      constructor
      · change (F z).re = _; rw [hF_val]; simp
      · change (F z).im = _; rw [hF_val]; simp
    have hv0 : v 0 = 0 := by
      rw [(hF_re_im 0).2]
      simp [W]
    have hconj : IsNormalizedHarmonicConjugate u v := by
      refine ⟨?_, hv0⟩
      rwa [hF_eq]
    have hu_bdd : (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) ⊤ circleMeasure) ≤
          ENNReal.ofReal (Real.pi / 2) := by
      refine iSup₂_le fun r ⟨hr0, hr1⟩ ↦ ?_
      have hu_cont : Continuous (fun ζ : FourierCircle ↦ u ((r : ℂ) * circlePoint ζ)) :=
        Complex.continuous_re.comp
          (continuous_radialSlice_of_continuousOn hF_diff.continuousOn hr0 hr1)
      have hb : eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) ⊤ circleMeasure ≤ _ :=
        eLpNorm_le_of_ae_bound hu_cont.aestronglyMeasurable (Eventually.of_forall fun ζ ↦ by
          have hz_ball : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
            rw [Metric.mem_ball, dist_zero_right, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hr0, norm_circlePoint, mul_one]
            exact hr1
          rw [Real.norm_eq_abs, (hF_re_im _).1]
          exact (Complex.abs_arg_lt_pi_div_two_iff.mpr (Or.inl (hW_re_pos _ hz_ball))).le)
      simpa [measure_univ] using hb
    have hv_lo : ∀ r ∈ Set.Ioo (0 : ℝ) 1,
        ENNReal.ofReal (1 * Real.log ((1 + r) / (1 - r))) ≤
          eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) ⊤ circleMeasure := by
      intro r ⟨hr0, hr1⟩
      have hv_cont : Continuous (fun ζ : FourierCircle ↦ v ((r : ℂ) * circlePoint ζ)) :=
        Complex.continuous_im.comp
          (continuous_radialSlice_of_continuousOn hF_diff.continuousOn hr0.le hr1)
      have h0_le := ofReal_norm_le_eLpNorm_top_of_continuous hv_cont 0
      have hv_at0 : ‖v ((r : ℂ) * circlePoint 0)‖ = 1 * Real.log ((1 + r) / (1 - r)) := by
        rw [circlePoint_zero, mul_one, Real.norm_eq_abs, (hF_re_im (r : ℂ)).2, abs_neg]
        have hW_r : W (r : ℂ) = (((1 + r) / (1 - r) : ℝ) : ℂ) := by
          dsimp [W]; push_cast; rfl
        have hquot_gt1 : 1 < (1 + r) / (1 - r) :=
          (one_lt_div (sub_pos.mpr hr1)).mpr (by linarith)
        have hquot_pos : 0 < (1 + r) / (1 - r) := zero_lt_one.trans hquot_gt1
        rw [hW_r, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hquot_pos,
          abs_of_pos (Real.log_pos hquot_gt1), one_mul]
      rwa [hv_at0] at h0_le
    have hv_sup : (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) ⊤ circleMeasure) = ⊤ :=
      iSup_Ico_eq_top_of_log_lower_bound zero_lt_one hv_lo
    have hnot_hardy : ¬ IsInHardySpace ⊤ (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I) := by
      rw [hF_eq]
      intro ⟨_, _, hlt⟩
      have hF_top : hardySizeENNReal ⊤ F = ⊤ := by
        refine iSup_Ico_eq_top_of_log_lower_bound zero_lt_one fun r hr ↦ ?_
        refine (hv_lo r hr).trans ?_
        unfold radialSizeENNReal
        simp only [ENNReal.top_ne_zero, ↓reduceIte]
        have hv_cont : Continuous (fun ζ : FourierCircle ↦ v ((r : ℂ) * circlePoint ζ)) :=
          Complex.continuous_im.comp
            (continuous_radialSlice_of_continuousOn hF_diff.continuousOn hr.1.le hr.2)
        refine eLpNorm_mono hv_cont.aestronglyMeasurable fun ζ ↦ ?_
        rw [Real.norm_eq_abs]
        exact Complex.abs_im_le_norm (F ((r : ℂ) * circlePoint ζ))
      rw [hF_top] at hlt
      exact lt_irrefl ⊤ hlt
    exact ⟨u, v, hu_harm, hconj, hu_bdd, hv_sup, hnot_hardy⟩
  · -- Part 2: Bounded real `h ∈ L^∞(T)` whose `herglotzTransform h` is not in `H^∞(U)`.
    let h : FourierCircle → ℂ := fun ζ ↦ if 0 ≤ (circlePoint ζ).im then (-1 : ℂ) else (1 : ℂ)
    have hh_meas : Measurable h :=
      Measurable.ite
        (isClosed_le continuous_const (Complex.continuous_im.comp continuous_circlePoint)).measurableSet
        measurable_const measurable_const
    have hh_norm : ∀ ζ : FourierCircle, ‖h ζ‖ ≤ 1 := by
      intro ζ
      dsimp [h]
      split_ifs <;> simp
    have hh_mem : MemLp h ⊤ circleMeasure :=
      MemLp.of_bound hh_meas.aestronglyMeasurable 1 (Eventually.of_forall hh_norm)
    have hh_real : ∀ ζ : FourierCircle, (h ζ).im = 0 := by
      intro ζ
      dsimp [h]
      split_ifs <;> simp
    have hh_eLp : eLpNorm h ⊤ circleMeasure ≤ 1 := by
      have hb : eLpNorm h ⊤ circleMeasure ≤ _ :=
        eLpNorm_le_of_ae_bound hh_meas.aestronglyMeasurable (Eventually.of_forall hh_norm)
      simpa [measure_univ] using hb
    have hh_int : Integrable h circleMeasure := hh_mem.integrable le_top
    have hhardy_top : hardySizeENNReal ⊤ (herglotzTransform h) = ⊤ := by
      refine iSup_Ico_eq_top_of_log_lower_bound (inv_pos.mpr Real.pi_pos) fun r ⟨hr0, hr1⟩ ↦ ?_
      unfold radialSizeENNReal
      simp only [ENNReal.top_ne_zero, ↓reduceIte]
      have hslice_cont : Continuous (radialSlice (herglotzTransform h) r) :=
        continuous_radialSlice_of_continuousOn
          (continuousOn_of_holomorphicOn (holomorphicOn_herglotzTransform hh_int)) hr0.le hr1
      refine (ENNReal.ofReal_le_ofReal ?_).trans
        (ofReal_norm_le_eLpNorm_top_of_continuous hslice_cont 0)
      have him_eq : (radialSlice (herglotzTransform h) r 0).im =
          ∫ ζ, |conjPoissonConvKernel r ζ| ∂circleMeasure := by
        rw [radialSlice_herglotzTransform]
        have hker_cont : Continuous (fun τ : FourierCircle ↦ herglotzConvKernel r (0 - τ)) :=
          (continuous_herglotzConvKernel hr0.le hr1).comp (continuous_sub_left 0)
        obtain ⟨C_k, hC_k⟩ := isCompact_univ.exists_bound_of_continuousOn hker_cont.continuousOn
        have hint_prod : Integrable (fun τ : FourierCircle ↦ herglotzConvKernel r (0 - τ) * h τ)
            circleMeasure :=
          Integrable.of_bound (hker_cont.aestronglyMeasurable.mul hh_meas.aestronglyMeasurable)
            (C_k * 1) (Eventually.of_forall fun τ ↦ by
              rw [norm_mul]
              exact mul_le_mul (hC_k τ (Set.mem_univ τ)) (hh_norm τ) (norm_nonneg _)
                ((norm_nonneg _).trans (hC_k τ (Set.mem_univ τ))))
        have hcomm := (Complex.imCLM.integral_comp_comm hint_prod).symm
        change (∫ τ, herglotzConvKernel r (0 - τ) * h τ ∂circleMeasure).im =
          ∫ τ, (herglotzConvKernel r (0 - τ) * h τ).im ∂circleMeasure at hcomm
        rw [hcomm]
        refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
        dsimp only
        rw [zero_sub, Complex.mul_im, hh_real ζ, mul_zero, zero_add]
        change conjPoissonConvKernel r (-ζ) * (h ζ).re = |conjPoissonConvKernel r ζ|
        rw [conjPoissonConvKernel_neg]
        obtain ⟨θ, rfl⟩ := QuotientAddGroup.mk_surjective ζ
        have him_θ : (circlePoint (θ : FourierCircle)).im = Real.sin θ := by
          rw [circlePoint_coe, Complex.exp_ofReal_mul_I_im]
        rw [conjPoissonConvKernel_coe hr0.le hr1 θ]
        dsimp [h]
        rw [him_θ]
        have hden_pos := poissonDen_pos hr0.le hr1 θ
        by_cases hs : 0 ≤ Real.sin θ
        · simp only [hs, ↓reduceIte, Complex.neg_re, Complex.one_re, mul_neg, mul_one, neg_neg]
          exact (abs_of_nonneg (div_nonneg (mul_nonneg (by linarith) hs) hden_pos.le)).symm
        · simp only [hs, ↓reduceIte, Complex.one_re, mul_one]
          exact (abs_of_nonpos (div_nonpos_of_nonpos_of_nonneg
            (mul_nonpos_of_nonneg_of_nonpos (by linarith) (le_of_not_ge hs)) hden_pos.le)).symm
      calc Real.pi⁻¹ * Real.log ((1 + r) / (1 - r))
          ≤ ∫ ζ, |conjPoissonConvKernel r ζ| ∂circleMeasure :=
            integral_abs_conjPoissonConvKernel_ge hr0.le hr1
        _ = (radialSlice (herglotzTransform h) r 0).im := him_eq.symm
        _ ≤ |(radialSlice (herglotzTransform h) r 0).im| := le_abs_self _
        _ ≤ ‖radialSlice (herglotzTransform h) r 0‖ := Complex.abs_im_le_norm _
    have hnot_hardy : ¬ IsInHardySpace ⊤ (herglotzTransform h) := by
      intro ⟨_, _, hlt⟩
      rw [hhardy_top] at hlt
      exact lt_irrefl ⊤ hlt
    exact ⟨h, hh_mem, hh_real, hh_eLp, hhardy_top, hnot_hardy⟩

/-- **17.24 (Complete Node Bundle: Harmonic Conjugate Problem, Affirmative `1 < p < ∞` Range,
and `p = 1, ∞` Endpoint Failures, pp. 350–351):**
1. Existence & uniqueness of normalized harmonic conjugates (`v(0) = 0`) on `U = Metric.ball 0 1`;
2. Holomorphicity of `herglotzTransform h` on `U` for `h ∈ L^1(T)`;
3. Poisson-integral real part and normalized harmonic conjugate imaginary part of
   `herglotzTransform h` for real-valued `h ∈ L^1(T)`;
4. Affirmative radial `L^p` norm transfer from `u` to `v` (and `u + i v ∈ H^p(U)`) for every
   `1 < p < ⊤` (`harmonicConjugate_hardy_bound`, proved via M. Riesz's theorem `17.26`);
5. Endpoint failure at `p = 1` (`node17_24_endpoint_one_counterexample`);
6. Endpoint failure at `p = ⊤` (`node17_24_endpoint_top_counterexample`). -/
theorem theorem17_24 :
    ((∀ {u : ℂ → ℝ}, RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1) →
      (∃ v : ℂ → ℝ, IsNormalizedHarmonicConjugate u v ∧
        RudinRCA.Chapter11.HarmonicOn v (Metric.ball (0 : ℂ) 1)) ∧
      ∀ {v₁ v₂ : ℂ → ℝ}, IsNormalizedHarmonicConjugate u v₁ →
        IsNormalizedHarmonicConjugate u v₂ → Set.EqOn v₁ v₂ (Metric.ball (0 : ℂ) 1)) ∧
    (∀ {h : FourierCircle → ℂ}, Integrable h circleMeasure →
      HolomorphicOn (herglotzTransform h) (Metric.ball (0 : ℂ) 1)) ∧
    (∀ {h : FourierCircle → ℂ}, Integrable h circleMeasure → (∀ ζ, (h ζ).im = 0) →
      (∀ z ∈ Metric.ball (0 : ℂ) 1,
        (herglotzTransform h z).re = circlePoissonIntegral (fun ζ ↦ (h ζ).re) z) ∧
      (herglotzTransform h 0).im = 0 ∧
      IsNormalizedHarmonicConjugate
        (fun z ↦ (herglotzTransform h z).re) (fun z ↦ (herglotzTransform h z).im))) ∧
    (∀ {p : ℝ≥0∞}, 1 < p → p < ⊤ → ∀ {u v : ℂ → ℝ},
      IsNormalizedHarmonicConjugate u v →
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) p circleMeasure) < ⊤ →
      IsInHardySpace p (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I) ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) p circleMeasure) < ⊤) ∧
    (∃ u v : ℂ → ℝ,
      RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1) ∧
      IsNormalizedHarmonicConjugate u v ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) 1 circleMeasure) = 1 ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) 1 circleMeasure) = ⊤ ∧
      ¬ IsInHardySpace 1 (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I)) ∧
    ((∃ u v : ℂ → ℝ,
      RudinRCA.Chapter11.HarmonicOn u (Metric.ball (0 : ℂ) 1) ∧
      IsNormalizedHarmonicConjugate u v ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ u ((r : ℂ) * circlePoint ζ)) ⊤ circleMeasure) ≤
          ENNReal.ofReal (Real.pi / 2) ∧
      (⨆ r ∈ Set.Ico (0 : ℝ) 1,
        eLpNorm (fun ζ ↦ v ((r : ℂ) * circlePoint ζ)) ⊤ circleMeasure) = ⊤ ∧
      ¬ IsInHardySpace ⊤ (fun z ↦ (u z : ℂ) + (v z : ℂ) * Complex.I)) ∧
    (∃ h : FourierCircle → ℂ,
      MemLp h ⊤ circleMeasure ∧
      (∀ ζ, (h ζ).im = 0) ∧
      eLpNorm h ⊤ circleMeasure ≤ 1 ∧
      hardySizeENNReal ⊤ (herglotzTransform h) = ⊤ ∧
      ¬ IsInHardySpace ⊤ (herglotzTransform h))) :=
  ⟨theorem17_24_setup,
   fun {_} hp1 hptop {_ _} hconj hu_bdd ↦
     let ⟨hF, hV, _, _⟩ := harmonicConjugate_hardy_bound hp1 hptop hconj hu_bdd
     ⟨hF, hV⟩,
   node17_24_endpoint_one_counterexample,
   node17_24_endpoint_top_counterexample⟩

end PartD

/-! ### Top-Level Chapter 17 Definitions and Unconditional Theorems (`17.9`–`17.26`) -/

section TopLevelExports

