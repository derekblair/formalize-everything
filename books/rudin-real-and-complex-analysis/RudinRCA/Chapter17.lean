    rw [hmul_div] at hpoisson_R
    exact ⟨hpoisson_R, hcauchy_R⟩
  have hF_int_ev : ∀ᶠ R in 𝓝[<] (1 : ℝ), Integrable (radialSlice f R) circleMeasure := by
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with R hR
    exact (continuous_radialSlice_of_holomorphicOn hf.2.1
      hR.1.le hR.2).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  -- 3a: Pass `R → 1⁻` for Poisson kernel
  let Ψ_P : ℝ × FourierCircle → ℂ := fun p ↦
    (_root_.poissonKernel 0 (z / (p.1 : ℂ)) (circlePoint p.2) : ℂ)
  have hΨ_P_cont : ContinuousOn Ψ_P (Set.Icc R₀ 1 ×ˢ Set.univ) := by
    have heq_P : Ψ_P = fun p : ℝ × FourierCircle ↦
