/-- **17.23 (Action `P(mulZ) F` of polynomial `P ∈ ℂ[X]` on `F ∈ H²`, RCA p. 350).** -/
abbrev polyMulHardy (P : Polynomial ℂ) (F : HardyElem 2) : HardyElem 2 :=
