/-- Verification of the shared `HardyPartBInterface` bundle from `17.9`, `17.11`, and `17.12`. -/
theorem hardyPartBInterface_holds : HardyPartBInterface :=
  PartB.hardyPartBInterface_holds

/-- Stolz nontangential region `Ω_α(ζ)` of aperture `0 < α < 1` at `circlePoint ζ`. -/
abbrev stolzRegion (α : ℝ) (ζ : FourierCircle) : Set ℂ :=
  PartB.stolzRegion α ζ

/-- Extended-nonnegative nontangential maximal function `(N_α f)(ζ)`. -/
abbrev nontangentialMaximalENNReal (α : ℝ) (f : ℂ → ℂ) (ζ : FourierCircle) : ℝ≥0∞ :=
  PartB.nontangentialMaximalENNReal α f ζ

/-- Real-valued nontangential maximal function `(N_α f)(ζ)`. -/
abbrev nontangentialMaximal (α : ℝ) (f : ℂ → ℂ) (ζ : FourierCircle) : ℝ :=
  PartB.nontangentialMaximal α f ζ

/-- **Theorem 17.9 (Blaschke division in `N` and `Hᵖ`, `0 < p ≤ ∞`, RCA pp. 338–339):**
Dividing a nonzero `f ∈ N` by the Blaschke product `B` of its zeros yields a zero-free `g ∈ N`
with `‖g‖₀ = ‖f‖₀`, and for every `0 < p ≤ ∞`, `(f ∈ Hᵖ ↔ g ∈ Hᵖ)` and `‖g‖_p = ‖f‖_p`. -/
theorem theorem17_9 {f : ℂ → ℂ} (hfN : IsInNevanlinnaClassCh17 f)
    (hnonzero : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) :
    ∃ B g : ℂ → ℂ,
      RudinRCA.Chapter15.IsBlaschkeProduct B ∧
      IsInNevanlinnaClassCh17 g ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, g z ≠ 0) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, f z = B z * g z) ∧
      hardySizeENNReal 0 g = hardySizeENNReal 0 f ∧
      (∀ p : ℝ≥0∞, p ≠ 0 →
        (IsInHardySpace p f ↔ IsInHardySpace p g) ∧
        hardySizeENNReal p g = hardySizeENNReal p f) :=
  PartB.theorem17_9 hfN hnonzero

/-- **Theorem 17.10 (`Hᵖ = B · h^{2/p}` factorization for `0 < p < ∞`, RCA p. 339):**
Every nonzero `f ∈ Hᵖ` (`0 < p < ∞`) factors on `U` as `B(z) exp((2/p) L_h(z))` where `B` is its
zero Blaschke product and `h = exp(L_h) ∈ H²` is zero-free with `‖h‖₂² = ‖f‖_p^p`. -/
theorem theorem17_10 {p : ℝ≥0∞} {f : ℂ → ℂ} (hp0 : p ≠ 0) (hptop : p ≠ ⊤)
    (hf : IsInHardySpace p f) (hnonzero : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) :
    ∃ B h L_h : ℂ → ℂ,
      RudinRCA.Chapter15.IsBlaschkeProduct B ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, B z = 0 ↔ f z = 0) ∧
      IsInHardySpace 2 h ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, h z ≠ 0) ∧
      HolomorphicOn L_h (Metric.ball (0 : ℂ) 1) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, Complex.exp (L_h z) = h z) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1,
        f z = B z * Complex.exp (((2 / p.toReal : ℝ) : ℂ) * L_h z)) ∧
      hardySizeENNReal 2 h = (hardySizeENNReal p f) ^ (p.toReal / 2) ∧
      (hardySize 2 h) ^ 2 = (hardySize p f) ^ p.toReal :=
  PartB.theorem17_10 hp0 hptop hf hnonzero

/-- **Corollary to Theorem 17.10 (`H¹ = H² · H²`, RCA p. 339):**
Every `f ∈ H¹` is the product on `U` of two functions `f₁, f₂ ∈ H²` satisfying
`‖f₁‖₂ · ‖f₂‖₂ = ‖f‖₁`. -/
theorem corollary17_10_h1_mul_h2 {f : ℂ → ℂ} (hf : IsInHardySpace 1 f) :
    ∃ f₁ f₂ : ℂ → ℂ,
      IsInHardySpace 2 f₁ ∧
      IsInHardySpace 2 f₂ ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, f z = f₁ z * f₂ z) ∧
      hardySize 2 f₁ * hardySize 2 f₂ = hardySize 1 f :=
  PartB.corollary17_10_h1_mul_h2 hf

/-- **Theorem 17.11 (`Hᵖ` nontangential maximal `Lᵖ` bound and boundary convergence, RCA pp. 340–341):**
For `0 < p < ∞` and `f ∈ Hᵖ`, `N_α f ∈ Lᵖ(T)` (`0 < α < 1`), `f` converges nontangentially a.e. to
`f* ∈ Lᵖ(T)`, `‖f_r - f*‖_p → 0` as `r → 1⁻`, `‖f*‖_p = ‖f‖_p`, and when `1 ≤ p` both Poisson and
Cauchy representations hold on `U`. -/
theorem theorem17_11 {p : ℝ≥0∞} {f : ℂ → ℂ} (hp0 : p ≠ 0) (hptop : p ≠ ⊤)
    (hf : IsInHardySpace p f) :
    (∀ α : ℝ, 0 < α → α < 1 →
      (∀ᵐ ζ ∂circleMeasure, nontangentialMaximalENNReal α f ζ < ⊤) ∧
        MemLp (nontangentialMaximal α f) p circleMeasure) ∧
    (∀ᵐ ζ ∂circleMeasure,
      (∀ α : ℝ, 0 < α → α < 1 →
        Tendsto f (𝓝[stolzRegion α ζ] (circlePoint ζ)) (𝓝 (radialBoundaryLimit f ζ))) ∧
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
    MemLp (radialBoundaryLimit f) p circleMeasure ∧
    Tendsto
      (fun r : ℝ ↦ eLpNorm (radialSlice f r - radialBoundaryLimit f) p circleMeasure)
      (𝓝[<] 1) (𝓝 0) ∧
    eLpNorm (radialBoundaryLimit f) p circleMeasure = hardySizeENNReal p f ∧
    (1 ≤ p → ∀ z ∈ Metric.ball (0 : ℂ) 1,
      f z = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit f ζ
        ∂circleMeasure ∧
      f z = ∫ ζ, (1 - z * star (circlePoint ζ))⁻¹ • radialBoundaryLimit f ζ ∂circleMeasure ∧
      f z = ∫ ζ, (radialBoundaryLimit f ζ * circlePoint ζ) / (circlePoint ζ - z)
        ∂circleMeasure) :=
  PartB.theorem17_11 hp0 hptop hf

/-- **Theorem 17.12 (`H²` power series characterization, RCA p. 341):**
For `f ∈ H(U)` with Maclaurin coefficients `a_n`, `f ∈ H² ↔ ∑ |a_n|² < ∞`, with
`‖f‖₂² = ∑ |a_n|²` and Fourier coefficients of `f*` equal to `a_n` (`n ≥ 0`) and `0` (`n < 0`). -/
theorem theorem17_12 {f : ℂ → ℂ} (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    let a : ℕ → ℂ := fun n ↦ iteratedDeriv n f 0 / (Nat.factorial n : ℂ)
    (∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ a n * z ^ n) (f z)) ∧
    (IsInHardySpace 2 f ↔ Summable (fun n : ℕ ↦ ‖a n‖ ^ 2)) ∧
    (IsInHardySpace 2 f →
      (hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖a n‖ ^ 2 ∧
      ∀ n : ℤ,
        ∫ ζ, radialBoundaryLimit f ζ * star (RudinRCA.Chapter04.trigMonomial n ζ)
          ∂circleMeasure =
          if 0 ≤ n then a n.toNat else 0) :=
  PartB.theorem17_12 hf

/-- **Theorem 17.12 (Converse `ℓ² → H²` power-series synthesis, RCA p. 341).** -/
theorem theorem17_12_of_l2 {c : ℕ → ℂ} (hc : Summable (fun n : ℕ ↦ ‖c n‖ ^ 2)) :
    let f : ℂ → ℂ := fun z ↦ ∑' n : ℕ, c n * z ^ n
    (∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ c n * z ^ n) (f z)) ∧
    HolomorphicOn f (Metric.ball (0 : ℂ) 1) ∧
    (∀ n : ℕ, iteratedDeriv n f 0 / (Nat.factorial n : ℂ) = c n) ∧
    IsInHardySpace 2 f ∧
    (hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖c n‖ ^ 2 :=
  PartB.theorem17_12_of_l2 hc

/-- **Theorem 17.13 (The F. and M. Riesz Theorem, RCA pp. 341–342):**
Every complex Borel measure `μ` on `T` whose negative Fourier coefficients vanish is absolutely
continuous with respect to Lebesgue measure `σ`, with `dμ = f* dσ` for some `f ∈ H¹`. -/
theorem theorem17_13 (μ : MeasureTheory.ComplexMeasure FourierCircle)
    (hμ_neg : ∀ n : ℤ, n < 0 →
      RudinRCA.Chapter10.complexMeasureIntegral μ
        (fun ζ ↦ star (RudinRCA.Chapter04.trigMonomial n ζ)) = 0) :
    μ ≪ᵥ circleMeasure.toENNRealVectorMeasure ∧
    μ.variation ≪ circleMeasure ∧
    (∀ E : Set FourierCircle, MeasurableSet E → circleMeasure E = 0 → μ E = 0) ∧
    (∃ f : ℂ → ℂ, IsInHardySpace 1 f ∧
      ∀ E : Set FourierCircle, MeasurableSet E →
        μ E = ∫ ζ in E, radialBoundaryLimit f ζ ∂circleMeasure) :=
  PartB.theorem17_13 μ hμ_neg

/-- **Theorem 17.13 (`∫ e^{ikt} dμ(t) = 0` formulation, RCA p. 341 eq. (2)).** -/
theorem theorem17_13_pos_monomial (μ : MeasureTheory.ComplexMeasure FourierCircle)
    (hμ_pos : ∀ k : ℕ, 0 < k →
      RudinRCA.Chapter10.complexMeasureIntegral μ
        (RudinRCA.Chapter04.trigMonomial (k : ℤ)) = 0) :
    μ ≪ᵥ circleMeasure.toENNRealVectorMeasure ∧
    μ.variation ≪ circleMeasure ∧
    (∀ E : Set FourierCircle, MeasurableSet E → circleMeasure E = 0 → μ E = 0) ∧
    (∃ f : ℂ → ℂ, IsInHardySpace 1 f ∧
      ∀ E : Set FourierCircle, MeasurableSet E →
        μ E = ∫ ζ in E, radialBoundaryLimit f ζ ∂circleMeasure) :=
  PartB.theorem17_13_pos_monomial μ hμ_pos

/-- **17.14 (Inner function predicate, RCA p. 342):** bounded holomorphic on `U` with `|M*| = 1` a.e. -/
abbrev IsInnerFunction (M : ℂ → ℂ) : Prop :=
  PartC.IsInnerFunction M

/-- **17.14 (Outer function construction `Q_φ`, RCA p. 342).** -/
abbrev outerFunction (c : ℂ) (φ : FourierCircle → ℝ) (z : ℂ) : ℂ :=
  PartC.outerFunction c φ z

/-- **17.14 (Outer function predicate, RCA p. 342).** -/
abbrev IsOuterFunction (Q : ℂ → ℂ) : Prop :=
  PartC.IsOuterFunction Q

/-- **17.15 (Singular inner factor `S_μ`, RCA p. 342).** -/
abbrev singularInnerFactor (μ : Measure FourierCircle) (z : ℂ) : ℂ :=
