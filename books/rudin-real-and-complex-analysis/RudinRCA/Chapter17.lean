    have hg_lim0 : ∀ᵐ ζ ∂circleMeasure, Tendsto (fun k : ℕ ↦ g_diff k ζ) atTop (𝓝 0) := by
      filter_upwards [hae_nt_rad] with ζ ⟨_, hrad⟩
      have hsub0 : Tendsto
          (fun k : ℕ ↦ ‖radialSlice f (ρ' k) ζ - radialBoundaryLimit f ζ‖) atTop (𝓝 0) := by
        simpa using ((hrad.comp hρ'_tend).sub (tendsto_const_nhds (x := radialBoundaryLimit f ζ))).norm
      simpa [Function.comp_def, g_diff, Real.zero_rpow hp_pos.ne'] using
        ((Real.continuous_rpow_const hp_pos.le).continuousAt.tendsto.comp hsub0)
    have hint_lim0 : Tendsto (fun k : ℕ ↦ ∫ ζ, g_diff k ζ ∂circleMeasure) atTop (𝓝 0) := by
      simpa using tendsto_integral_of_dominated_convergence
        (fun ζ ↦ ‖2 * M_dom ζ‖ ^ p_real) hg_meas h2M_rpow_int hg_bound hg_lim0
    have heLp_shift : Tendsto
        (fun k : ℕ ↦ eLpNorm (radialSlice f (ρ' k) - radialBoundaryLimit f) p circleMeasure)
        atTop (𝓝 0) := by
      have hrpow_lim : Tendsto
          (fun k : ℕ ↦ ENNReal.ofReal ((∫ ζ, g_diff k ζ ∂circleMeasure) ^ p_real⁻¹))
          atTop (𝓝 0) := by
        have h1 : Tendsto (fun k : ℕ ↦ (∫ ζ, g_diff k ζ ∂circleMeasure) ^ p_real⁻¹)
