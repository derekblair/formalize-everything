  obtain ⟨hmax_all, hae_nt_rad⟩ := hcore
  -- Step 2: `MemLp (radialBoundaryLimit f) p`, radial `L^p` convergence, and norm equality
  obtain ⟨hN_half_fin, hN_half_memLp⟩ := hmax_all (1 / 2) (by norm_num) (by norm_num)
  let M_dom : FourierCircle → ℝ := nontangentialMaximal (1 / 2) f
  have hM_dom_nn : ∀ ζ, 0 ≤ M_dom ζ := fun _ ↦ ENNReal.toReal_nonneg
  have hrad_le_M : ∀ r ∈ Set.Ico (0 : ℝ) 1, ∀ᵐ ζ ∂circleMeasure,
