        rw [eventually_nhdsWithin_iff, Metric.eventually_nhds_iff] at hev_ball
        obtain ⟨η, hη_pos, hη⟩ := hev_ball
        let V : Set ℂ := stolzRegion α ζ ∩ Metric.ball (circlePoint ζ) η
        have hV_open : IsOpen V := (isOpen_stolzRegion hα0 hα1 ζ).inter Metric.isOpen_ball
        have hV_conn : IsPreconnected V :=
