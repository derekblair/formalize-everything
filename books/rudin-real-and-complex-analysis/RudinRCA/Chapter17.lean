      exact (hf.2.1 _ (by simpa [Metric.mem_ball] using hw_lt)).comp w
        (differentiableAt_id.const_mul (R : ℂ))
    have hw₀_ball : z / (R : ℂ) ∈ Metric.ball (0 : ℂ) 1 := by
      rw [Metric.mem_ball, dist_zero_right, norm_div, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hR_pos, div_lt_one hR_pos]
      exact hz_lt_R₀.trans hR.1
    have hmul_div : (R : ℂ) * (z / (R : ℂ)) = z := mul_div_cancel₀ z hR_ne
    have hcauchy_R := cauchy_representation_of_holomorphic_gt_one hρ_gt1 hg_R_hol_ρ hw₀_ball
    dsimp [g_R] at hcauchy_R
    rw [hmul_div] at hcauchy_R
    -- Poisson for `g_R` via `h2_powerSeries_and_boundary`
