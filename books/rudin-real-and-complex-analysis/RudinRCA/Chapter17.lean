          have h1 : Summable (fun m : ℕ ↦ ‖a m‖ ^ 2 * r ^ m) :=
            ha_l2.of_nonneg_of_le (fun _ ↦ mul_nonneg (sq_nonneg _) (pow_nonneg hr0 _))
              fun m ↦ mul_le_of_le_one_right (sq_nonneg _) (pow_le_one₀ hr0 hr1.le)
          exact h1.add (summable_geometric_of_lt_one hr0 hr1)
        have hsum_C : Summable (fun m : ℕ ↦
            (a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomial (m : ℤ)) := by
          refine Summable.of_norm_bounded hmaj fun m ↦ ?_
          have hle_norm : ‖(a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomial (m : ℤ)‖ ≤
              ‖a m * (r : ℂ) ^ m‖ * ‖RudinRCA.Chapter04.trigMonomial (m : ℤ)‖ :=
            norm_smul_le _ _
          have htrig_le1 : ‖RudinRCA.Chapter04.trigMonomial (m : ℤ)‖ ≤ 1 := by
            rw [ContinuousMap.norm_le _ zero_le_one]
            intro ζ
            obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
            rw [RudinRCA.Chapter04.trigMonomial_apply_real]
            have hexp : ((m : ℤ) : ℂ) * (t : ℂ) * Complex.I =
                ((((m : ℝ) * t) : ℝ) : ℂ) * Complex.I := by push_cast; ring
            rw [hexp, Complex.norm_exp_ofReal_mul_I]
          have ham_le : ‖a m‖ ≤ ‖a m‖ ^ 2 + 1 := by nlinarith [sq_nonneg (‖a m‖ - 1)]
          calc ‖(a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomial (m : ℤ)‖
              ≤ ‖a m * (r : ℂ) ^ m‖ * 1 :=
                hle_norm.trans (mul_le_mul_of_nonneg_left htrig_le1 (norm_nonneg _))
            _ = ‖a m‖ * r ^ m := by
                rw [mul_one, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs,
                  abs_of_nonneg hr0]
            _ ≤ (‖a m‖ ^ 2 + 1) * r ^ m :=
                mul_le_mul_of_nonneg_right ham_le (pow_nonneg hr0 m)
            _ = ‖a m‖ ^ 2 * r ^ m + r ^ m := by ring
        have hhasSum_C : HasSum (fun m : ℕ ↦
            (a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomial (m : ℤ)) Cr := by
          refine hsum_C.hasSum_iff.mpr ?_
          ext ζ
          obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
          have heval := (ContinuousMap.evalCLM ℂ (t : FourierCircle)).map_tsum hsum_C
          change (∑' m : ℕ, (a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomial (m : ℤ))
              (t : FourierCircle) =
            ∑' m : ℕ, ((a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomial (m : ℤ))
              (t : FourierCircle) at heval
          have hz_ball : (r : ℂ) * circlePoint (t : FourierCircle) ∈ Metric.ball (0 : ℂ) 1 := by
            simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hr0] using hr1
          have hpt := (ha_sum _ hz_ball).tsum_eq
          change (∑' m : ℕ, (a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomial (m : ℤ))
              (t : FourierCircle) =
            f ((r : ℂ) * circlePoint (t : FourierCircle))
          rw [heval, ← hpt]
          refine tsum_congr fun m ↦ ?_
          rw [ContinuousMap.smul_apply, smul_eq_mul, RudinRCA.Chapter04.trigMonomial_apply_real,
            circlePoint_coe, mul_pow, ← Complex.exp_nat_mul]
          have hexp_m : Complex.exp (((m : ℤ) : ℂ) * (t : ℂ) * Complex.I) =
              Complex.exp ((m : ℂ) * ((t : ℂ) * Complex.I)) := by
            congr 1; push_cast; ring
          rw [hexp_m]; ring
        have hhasSum_L2 : HasSum (fun m : ℕ ↦
            (a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomialL2 (m : ℤ)) Fr := by
          have h := hhasSum_C.map (ContinuousMap.toLp 2 circleMeasure ℂ)
            (ContinuousMap.toLp 2 circleMeasure ℂ).continuous
          exact h.congr_fun fun m ↦ by simp only [Function.comp_apply, map_smul]
        intro n
        have hhasSum_ell2 := hhasSum_L2.map RudinRCA.Chapter04.circleFourierIsometry
          RudinRCA.Chapter04.circleFourierIsometry.continuous
        have hcoord_cont : Continuous (fun x : lp (fun _ : ℤ ↦ ℂ) 2 ↦ x n) := by
          refine (LipschitzWith.of_dist_le_mul (K := 1) fun x y ↦ ?_).continuous
          rw [NNReal.coe_one, one_mul, dist_eq_norm, dist_eq_norm]
          exact lp.norm_apply_le_norm (by norm_num) (x - y) n
        have hhasSum_n := hhasSum_ell2.map
          (AddMonoidHom.mk' (fun x : lp (fun _ : ℤ ↦ ℂ) 2 ↦ x n) fun _ _ ↦ rfl) hcoord_cont
        rw [← RudinRCA.Chapter04.circleFourierIsometry_apply]
        have heq_fn : (fun m : ℕ ↦
            (RudinRCA.Chapter04.circleFourierIsometry
              ((a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomialL2 (m : ℤ))) n) =
            fun m : ℕ ↦ if (m : ℤ) = n then a m * (r : ℂ) ^ m else 0 := by
          funext m
          rw [map_smul, RudinRCA.Chapter04.circleFourierIsometry_monomial]
          simp [lp.single_apply, Pi.single_apply, eq_comm]
        change HasSum (fun m : ℕ ↦
          (RudinRCA.Chapter04.circleFourierIsometry
            ((a m * (r : ℂ) ^ m) • RudinRCA.Chapter04.trigMonomialL2 (m : ℤ))) n) _ at hhasSum_n
        rw [heq_fn] at hhasSum_n
        by_cases hnn : 0 ≤ n
        · have hn_eq : ((n.toNat : ℕ) : ℤ) = n := Int.toNat_of_nonneg hnn
          have heq_ite : (fun m : ℕ ↦ if (m : ℤ) = n then a m * (r : ℂ) ^ m else 0) =
              fun m : ℕ ↦ if m = n.toNat then a n.toNat * (r : ℂ) ^ n.toNat else 0 := by
            funext m
            by_cases hm : m = n.toNat
            · subst hm; simp [hn_eq]
            · have hmZ : (m : ℤ) ≠ n := fun h ↦ hm (by omega)
              simp [hm, hmZ]
          rw [heq_ite] at hhasSum_n
          simp only [hnn, ↓reduceIte]
          exact hhasSum_n.unique (hasSum_ite_eq n.toNat _)
        · have heq0 : (fun m : ℕ ↦ if (m : ℤ) = n then a m * (r : ℂ) ^ m else 0) = 0 := by
            funext m
            have hmZ : (m : ℤ) ≠ n := by omega
            simp [hmZ]
          rw [heq0] at hhasSum_n
          simp only [hnn, ↓reduceIte]
          exact hhasSum_n.unique hasSum_zero
      have hparseval_diff := (RudinRCA.Chapter04.fourier_parseval_norm (Fr - F)).tsum_eq.symm
      refine ⟨Fr, hFr_ae, ?_⟩
      rw [hparseval_diff]
      have hcoeff_sub : ∀ n : ℤ,
          ‖RudinRCA.Chapter04.circleFourierCoeff
              ((Fr - F : RudinRCA.Chapter04.CircleL2) : FourierCircle → ℂ) n‖ ^ 2 =
            if 0 ≤ n then ‖a n.toNat‖ ^ 2 * (1 - r ^ n.toNat) ^ 2 else 0 := by
        intro n
        have hlin : RudinRCA.Chapter04.circleFourierCoeff
            ((Fr - F : RudinRCA.Chapter04.CircleL2) : FourierCircle → ℂ) n =
            RudinRCA.Chapter04.circleFourierCoeff Fr n -
              RudinRCA.Chapter04.circleFourierCoeff F n := by
          rw [← RudinRCA.Chapter04.circleFourierIsometry_apply (Fr - F) n, map_sub,
            lp.coeFn_sub, Pi.sub_apply, RudinRCA.Chapter04.circleFourierIsometry_apply,
            RudinRCA.Chapter04.circleFourierIsometry_apply]
        rw [hlin, hFr_coeff n, hF_coeff n]
        by_cases hnn : 0 ≤ n
        · simp only [cZ, hnn, ↓reduceIte]
          have hsub : a n.toNat * (r : ℂ) ^ n.toNat - a n.toNat =
              -(a n.toNat * (((1 - r ^ n.toNat : ℝ) : ℂ))) := by push_cast; ring
          rw [hsub, norm_neg, norm_mul, Complex.norm_real, Real.norm_eq_abs, mul_pow, sq_abs]
        · simp [cZ, hnn]
      simp_rw [hcoeff_sub]
      rw [← (Nat.cast_injective (R := ℤ)).tsum_eq]
      · exact tsum_congr fun m ↦ by simp
      · intro n hn
        by_contra hnot
        have hn_neg : ¬ (0 ≤ n) := fun hnn ↦ hnot ⟨n.toNat, Int.toNat_of_nonneg hnn⟩
        exact hn (ite_eq_right_iff.mpr fun h ↦ (hn_neg h).elim)
    -- Show `∑' m, ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2 → 0` as `r → 1⁻`, hence `eLpNorm → 0`
    have hsq_tendsto : Tendsto
        (fun r : ℝ ↦ ∑' m : ℕ, ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2) (𝓝[<] 1) (𝓝 0) := by
      rw [Metric.tendsto_nhds]
      intro ε hε
      have htail_lim : Tendsto
          (fun N : ℕ ↦ (∑' m : ℕ, ‖a m‖ ^ 2) - ∑ m ∈ Finset.range N, ‖a m‖ ^ 2)
          atTop (𝓝 0) := by
        have h := (tendsto_const_nhds (x := ∑' m : ℕ, ‖a m‖ ^ 2)).sub ha_l2.hasSum.tendsto_sum_nat
        rwa [sub_self] at h
      obtain ⟨N, hN⟩ := (htail_lim.eventually (gt_mem_nhds (half_pos hε))).exists
      have hfin_lim : Tendsto
          (fun r : ℝ ↦ ∑ m ∈ Finset.range N, ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2) (𝓝[<] 1) (𝓝 0) := by
        have hcont : Continuous (fun r : ℝ ↦ ∑ m ∈ Finset.range N, ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2) :=
          continuous_finsetSum _ fun m _ ↦ by fun_prop
        have hval1 : (∑ m ∈ Finset.range N, ‖a m‖ ^ 2 * (1 - (1 : ℝ) ^ m) ^ 2) = 0 := by simp
        exact hval1 ▸ hcont.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one,
        hfin_lim.eventually (gt_mem_nhds (half_pos hε))] with r hr hfin_lt
      have hterm_nn : ∀ m : ℕ, 0 ≤ ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2 :=
        fun _ ↦ mul_nonneg (sq_nonneg _) (sq_nonneg _)
      have hterm_le : ∀ m : ℕ, ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2 ≤ ‖a m‖ ^ 2 := by
        intro m
        have h01 : 0 ≤ 1 - r ^ m ∧ 1 - r ^ m ≤ 1 :=
          ⟨sub_nonneg.mpr (pow_le_one₀ hr.1.le hr.2.le),
            sub_le_self 1 (pow_nonneg hr.1.le m)⟩
        have hsq1 : (1 - r ^ m) ^ 2 ≤ 1 := by nlinarith
        exact mul_le_of_le_one_right (sq_nonneg _) hsq1
      have hsum_r : Summable (fun m : ℕ ↦ ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2) :=
        ha_l2.of_nonneg_of_le hterm_nn hterm_le
      have hsplit_r := (hsum_r.sum_add_tsum_nat_add N).symm
      have hsplit_a := (ha_l2.sum_add_tsum_nat_add N).symm
      have htail_le : (∑' m : ℕ, ‖a (m + N)‖ ^ 2 * (1 - r ^ (m + N)) ^ 2) ≤
          ∑' m : ℕ, ‖a (m + N)‖ ^ 2 :=
        (hsum_r.comp_injective (add_left_injective N)).tsum_mono
          (ha_l2.comp_injective (add_left_injective N)) fun m ↦ hterm_le (m + N)
      have htail_lt : (∑' m : ℕ, ‖a (m + N)‖ ^ 2) < ε / 2 := by
        linarith
      rw [dist_zero_right, Real.norm_of_nonneg (tsum_nonneg hterm_nn), hsplit_r]
      linarith
    have hnorm_tendsto : Tendsto
        (fun r : ℝ ↦ ENNReal.ofReal (Real.sqrt (∑' m : ℕ, ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2)))
        (𝓝[<] 1) (𝓝 0) := by
      have hsqrt : Tendsto
          (fun r : ℝ ↦ Real.sqrt (∑' m : ℕ, ‖a m‖ ^ 2 * (1 - r ^ m) ^ 2)) (𝓝[<] 1) (𝓝 0) := by
        simpa [Function.comp_def] using Real.continuous_sqrt.continuousAt.tendsto.comp hsq_tendsto
      simpa [Function.comp_def] using ENNReal.continuous_ofReal.continuousAt.tendsto.comp hsqrt
    refine hnorm_tendsto.congr' ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    obtain ⟨Fr, hFr_ae, hFr_sq⟩ := hdiff_sq r hr.1.le hr.2
    have hae_sub : (Fr - F : RudinRCA.Chapter04.CircleL2) =ᵐ[circleMeasure]
        radialSlice f r - radialBoundaryLimit f := by
      filter_upwards [Lp.coeFn_sub Fr F, hFr_ae, hae_eq_F] with ζ h1 h2 h3
      rw [h1]
      simp only [Pi.sub_apply, h2, h3]
    have heLp : eLpNorm (radialSlice f r - radialBoundaryLimit f) 2 circleMeasure =
        ENNReal.ofReal ‖Fr - F‖ := by
      rw [← eLpNorm_congr_ae hae_sub]
      exact (Lp.norm_def (Fr - F)).symm ▸
        (ENNReal.ofReal_toReal (Lp.memLp (Fr - F)).eLpNorm_lt_top.ne).symm
    rw [heLp, ← Real.sqrt_sq (norm_nonneg (Fr - F)), hFr_sq]
  exact ⟨hhardy_sq, hae_both, hmemLp_bd, heLp_eq, hl2_tendsto, hf_poisson_bd, hfour_bd⟩

/-- **Theorem 17.12** (Rudin, *Real and Complex Analysis*, 3rd ed., p. 341):
Let `f` be holomorphic on `Metric.ball 0 1` with Taylor coefficients
`a n = iteratedDeriv n f 0 / n!`, so `f(z) = ∑_{n=0}^∞ a_n z^n` on `Metric.ball 0 1`.
Then `f ∈ H^2` if and only if `∑_{n=0}^∞ ‖a_n‖ ^ 2 < ∞`, in which case
`(hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖a n‖ ^ 2` and the radial boundary function `f*` satisfies
`∫ ζ, f*(ζ) * conj(e^{inθ}) dσ(ζ) = a_n` for `n ≥ 0` and `0` for `n < 0`. -/
theorem theorem17_12 {f : ℂ → ℂ} (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    let a : ℕ → ℂ := fun n ↦ iteratedDeriv n f 0 / (Nat.factorial n : ℂ)
    (∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ a n * z ^ n) (f z)) ∧
    (IsInHardySpace 2 f ↔ Summable (fun n : ℕ ↦ ‖a n‖ ^ 2)) ∧
    (IsInHardySpace 2 f →
      (hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖a n‖ ^ 2 ∧
      ∀ n : ℤ,
        ∫ ζ, radialBoundaryLimit f ζ * star (RudinRCA.Chapter04.trigMonomial n ζ)
          ∂circleMeasure =
          if 0 ≤ n then a n.toNat else 0) := by
  have h := h2_powerSeries_and_boundary hf
  exact ⟨h.1, h.2.1, fun h2f ↦ ⟨(h.2.2 h2f).1, (h.2.2 h2f).2.2.2.2.2.2⟩⟩

/-- **Theorem 17.12 (Power-Series Construction from `ℓ²(ℕ)`, Rudin p. 341)**:
Conversely, for any sequence `c : ℕ → ℂ` with `Summable (fun n ↦ ‖c n‖ ^ 2)`, the power series
`f(z) = ∑_{n=0}^∞ c_n z^n` converges on `Metric.ball 0 1`, defines a function `f ∈ H^2` with
Taylor coefficients `iteratedDeriv n f 0 / n! = c n`, and satisfies
`(hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖c n‖ ^ 2`. -/
theorem theorem17_12_of_l2 {c : ℕ → ℂ} (hc : Summable (fun n : ℕ ↦ ‖c n‖ ^ 2)) :
    let f : ℂ → ℂ := fun z ↦ ∑' n : ℕ, c n * z ^ n
    (∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ c n * z ^ n) (f z)) ∧
    HolomorphicOn f (Metric.ball (0 : ℂ) 1) ∧
    (∀ n : ℕ, iteratedDeriv n f 0 / (Nat.factorial n : ℂ) = c n) ∧
    IsInHardySpace 2 f ∧
    (hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖c n‖ ^ 2 := by
  intro f
  have hmaj_R : ∀ R : ℝ, 0 ≤ R → R < 1 →
      Summable (fun n : ℕ ↦ ‖c n‖ ^ 2 * R ^ n + R ^ n) := by
    intro R hR0 hR1
    have h1 : Summable (fun n : ℕ ↦ ‖c n‖ ^ 2 * R ^ n) :=
      hc.of_nonneg_of_le (fun _ ↦ mul_nonneg (sq_nonneg _) (pow_nonneg hR0 _))
        fun n ↦ mul_le_of_le_one_right (sq_nonneg _) (pow_le_one₀ hR0 hR1.le)
    exact h1.add (summable_geometric_of_lt_one hR0 hR1)
  have hterm_bound : ∀ {z : ℂ} {R : ℝ}, 0 ≤ R → ‖z‖ ≤ R → ∀ n : ℕ,
      ‖c n * z ^ n‖ ≤ ‖c n‖ ^ 2 * R ^ n + R ^ n := by
    intro z R hR0 hzR n
    have hcn : ‖c n‖ ≤ ‖c n‖ ^ 2 + 1 := by nlinarith [sq_nonneg (‖c n‖ - 1)]
    calc ‖c n * z ^ n‖
        = ‖c n‖ * ‖z‖ ^ n := by rw [norm_mul, norm_pow]
      _ ≤ (‖c n‖ ^ 2 + 1) * R ^ n :=
          mul_le_mul hcn (pow_le_pow_left₀ (norm_nonneg z) hzR n)
            (pow_nonneg (norm_nonneg z) n) (by positivity)
      _ = ‖c n‖ ^ 2 * R ^ n + R ^ n := by ring
  have hhasSum : ∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ c n * z ^ n) (f z) := by
    intro z hz
    have hz1 : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
    exact (Summable.of_norm_bounded (hmaj_R ‖z‖ (norm_nonneg z) hz1)
      (hterm_bound (norm_nonneg z) le_rfl)).hasSum
  have hf_hol : HolomorphicOn f (Metric.ball (0 : ℂ) 1) := by
    intro z₀ hz₀
    have hz₀_lt : ‖z₀‖ < 1 := by simpa [Metric.mem_ball] using hz₀
    let R : ℝ := (‖z₀‖ + 1) / 2
    have hR0 : 0 < R := by dsimp [R]; linarith [norm_nonneg z₀]
    have hR1 : R < 1 := by dsimp [R]; linarith
    have hz₀_R : z₀ ∈ Metric.ball (0 : ℂ) R := by
      rw [Metric.mem_ball, dist_zero_right]; dsimp [R]; linarith
    have hunif : TendstoUniformlyOn
        (fun N z ↦ ∑ n ∈ Finset.range N, c n * z ^ n) f atTop (Metric.ball (0 : ℂ) R) :=
      tendstoUniformlyOn_tsum_nat (hmaj_R R hR0.le hR1) fun n z hz ↦
        hterm_bound hR0.le (le_of_lt (by simpa [Metric.mem_ball] using hz)) n
    have hdiff_R : DifferentiableOn ℂ f (Metric.ball (0 : ℂ) R) :=
      hunif.tendstoLocallyUniformlyOn.differentiableOn
        (Eventually.of_forall fun N z _ ↦
          (DifferentiableAt.fun_sum fun n _ ↦
            (differentiableAt_id.pow n).const_mul (c n)).differentiableWithinAt)
        Metric.isOpen_ball
    exact hdiff_R.differentiableAt (Metric.isOpen_ball.mem_nhds hz₀_R)
  have hcoeff_eq : ∀ n : ℕ, iteratedDeriv n f 0 / (Nat.factorial n : ℂ) = c n := by
    let a : ℕ → ℂ := fun n ↦ iteratedDeriv n f 0 / (Nat.factorial n : ℂ)
    have ha_sum := taylorSeries_hasSum_unitDisc hf_hol
    let z0fn : ℂ → ℂ := fun _ ↦ 0
    have hd_disc : ∀ z ∈ RudinRCA.Chapter10.disc (0 : ℂ) 1,
        HasSum (fun n : ℕ ↦ (a n - c n) * (z - 0) ^ n) (z0fn z) := by
      intro z hz
      have hsub := (ha_sum z hz).sub (hhasSum z hz)
      dsimp only [a, z0fn]
      simpa only [sub_zero, sub_mul, sub_self] using hsub
    have hp := (RudinRCA.Chapter10.theorem10_22 (r := 1 / 2) (by norm_num) (by norm_num) hd_disc).1
    have hzero_rhs : (2 * Real.pi)⁻¹ *
        ∫ θ in (0 : ℝ)..2 * Real.pi, ‖z0fn (circleMap 0 (1 / 2) θ)‖ ^ 2 = 0 := by
      simp [z0fn]
    rw [hzero_rhs] at hp
    have hzero_all := (hasSum_zero_iff_of_nonneg
      (fun n ↦ mul_nonneg (sq_nonneg _) (by positivity))).mp hp
    intro n
    have hn0 : ‖a n - c n‖ ^ 2 * (1 / 2 : ℝ) ^ (2 * n) = 0 := congrFun hzero_all n
    have hpow_ne : (1 / 2 : ℝ) ^ (2 * n) ≠ 0 := by positivity
    have hsq0 : ‖a n - c n‖ ^ 2 = 0 := (mul_eq_zero.mp hn0).resolve_right hpow_ne
    exact sub_eq_zero.mp (norm_eq_zero.mp (sq_eq_zero_iff.mp hsq0))
  have h12 := theorem17_12 hf_hol
  dsimp only at h12
  simp_rw [hcoeff_eq] at h12
  have hf_h2 : IsInHardySpace 2 f := h12.2.1.mpr hc
  exact ⟨hhasSum, hf_hol, hcoeff_eq, hf_h2, (h12.2.2 hf_h2).1⟩

/-! ### 17.11: Stolz Regions, Nontangential Maximal Function, and `H^p` Boundary Convergence -/

/-- Rudin's Stolz region `Ω_α(ζ)` (`0 < α < 1`, RCA 11.18 & 17.11, p. 340): the intersection with
`U = Metric.ball 0 1` of the convex hull of `D(0; α) = Metric.ball 0 α` and `{circlePoint ζ}`. -/
def stolzRegion (α : ℝ) (ζ : RudinRCA.Chapter04.FourierCircle) : Set ℂ :=
  convexHull ℝ (Metric.ball (0 : ℂ) α ∪ {circlePoint ζ}) ∩ Metric.ball (0 : ℂ) 1

/-- Extended-nonnegative-real nontangential maximal function `(N_α f)(ζ) = sup_{z ∈ Ω_α(ζ)} ‖f z‖ₑ`
(Rudin, *Real and Complex Analysis*, 3rd ed., 11.18 & 17.11, p. 340). -/
def nontangentialMaximalENNReal (α : ℝ) (f : ℂ → ℂ)
    (ζ : RudinRCA.Chapter04.FourierCircle) : ℝ≥0∞ :=
  ⨆ z ∈ stolzRegion α ζ, ‖f z‖ₑ

/-- Real-valued nontangential maximal function `(N_α f)(ζ)` on `FourierCircle`
(Rudin, *Real and Complex Analysis*, 3rd ed., 17.11, p. 340). -/
def nontangentialMaximal (α : ℝ) (f : ℂ → ℂ)
    (ζ : RudinRCA.Chapter04.FourierCircle) : ℝ :=
  (nontangentialMaximalENNReal α f ζ).toReal

private theorem stolzRegion_subset_ball (α : ℝ) (ζ : FourierCircle) :
    stolzRegion α ζ ⊆ Metric.ball (0 : ℂ) 1 :=
  Set.inter_subset_right

private theorem convex_stolzRegion (α : ℝ) (ζ : FourierCircle) :
    Convex ℝ (stolzRegion α ζ) :=
  (convex_convexHull ℝ _).inter (convex_ball 0 1)

/-- Explicit union-of-balls representation of `stolzRegion α ζ` for `0 < α < 1`:
`Ω_α(ζ) = ⋃_{0 ≤ t < 1} Metric.ball (t · circlePoint ζ) ((1 - t) α)`. -/
private theorem stolzRegion_eq_iUnion_ball {α : ℝ} (hα0 : 0 < α) (hα1 : α < 1)
    (ζ : FourierCircle) :
    stolzRegion α ζ =
      ⋃ t ∈ Set.Ico (0 : ℝ) 1, Metric.ball ((t : ℂ) * circlePoint ζ) ((1 - t) * α) := by
  let w : ℂ := circlePoint ζ
  have hw_norm : ‖w‖ = 1 := norm_circlePoint ζ
  let S : Set ℂ := Metric.ball (0 : ℂ) α ∪ {w}
  let B_union : Set ℂ := ⋃ t ∈ Set.Ico (0 : ℝ) 1, Metric.ball ((t : ℂ) * w) ((1 - t) * α)
  let C : Set ℂ := {w} ∪ B_union
  have hB_sub_ball : B_union ⊆ Metric.ball (0 : ℂ) 1 := by
    intro z hz
    obtain ⟨t, ⟨ht0, ht1⟩, hzt⟩ := Set.mem_iUnion₂.mp hz
    rw [Metric.mem_ball, dist_eq_norm] at hzt
    rw [Metric.mem_ball, dist_zero_right]
    calc ‖z‖ = ‖(z - (t : ℂ) * w) + (t : ℂ) * w‖ := by ring_nf
      _ ≤ ‖z - (t : ℂ) * w‖ + ‖(t : ℂ) * w‖ := norm_add_le _ _
      _ < (1 - t) * α + t := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht0, hw_norm, mul_one]
          linarith
      _ < (1 - t) * 1 + t := by nlinarith
      _ = 1 := by ring
  have hB_sub_hull : B_union ⊆ convexHull ℝ S := by
    intro z hz
    obtain ⟨t, ⟨ht0, ht1⟩, hzt⟩ := Set.mem_iUnion₂.mp hz
    have h1mt : 0 < 1 - t := sub_pos.mpr ht1
    let u : ℂ := ((1 - t)⁻¹ : ℝ) • (z - (t : ℂ) * w)
    have hu_ball : u ∈ Metric.ball (0 : ℂ) α := by
      rw [Metric.mem_ball, dist_zero_right]
      dsimp [u]
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr h1mt),
        inv_mul_lt_iff₀ h1mt]
      simpa [Metric.mem_ball, dist_eq_norm] using hzt
    have hu_hull : u ∈ convexHull ℝ S := subset_convexHull ℝ S (Or.inl hu_ball)
    have hw_hull : w ∈ convexHull ℝ S := subset_convexHull ℝ S (Or.inr rfl)
    have hcomb : (1 - t) • u + t • w = z := by
      dsimp [u]
      rw [← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ h1mt.ne',
        Complex.ofReal_one, one_mul, sub_add_cancel]
    exact hcomb ▸ (convex_convexHull ℝ S) hu_hull hw_hull h1mt.le ht0 (sub_add_cancel 1 t)
  have hC_param : ∀ z ∈ C, ∃ t ∈ Set.Icc (0 : ℝ) 1, ∃ u ∈ Metric.ball (0 : ℂ) α,
      z = (1 - t) • u + t • w := by
    intro z hz
    rcases hz with rfl | hzB
    · exact ⟨1, ⟨zero_le_one, le_rfl⟩, 0, Metric.mem_ball_self hα0, by simp⟩
    · obtain ⟨t, ⟨ht0, ht1⟩, hzt⟩ := Set.mem_iUnion₂.mp hzB
      have h1mt : 0 < 1 - t := sub_pos.mpr ht1
      let u : ℂ := ((1 - t)⁻¹ : ℝ) • (z - (t : ℂ) * w)
      have hu_ball : u ∈ Metric.ball (0 : ℂ) α := by
        rw [Metric.mem_ball, dist_zero_right]
        dsimp [u]
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr h1mt),
          inv_mul_lt_iff₀ h1mt]
        simpa [Metric.mem_ball, dist_eq_norm] using hzt
      refine ⟨t, ⟨ht0, ht1.le⟩, u, hu_ball, ?_⟩
      dsimp [u]
      rw [← mul_assoc, ← Complex.ofReal_mul, mul_inv_cancel₀ h1mt.ne',
        Complex.ofReal_one, one_mul, sub_add_cancel]
  have hC_conv : Convex ℝ C := by
    intro z₁ hz₁ z₂ hz₂ a b ha hb hab
    obtain ⟨t₁, ⟨ht₁0, ht₁1⟩, u₁, hu₁, rfl⟩ := hC_param z₁ hz₁
    obtain ⟨t₂, ⟨ht₂0, ht₂1⟩, u₂, hu₂, rfl⟩ := hC_param z₂ hz₂
    let t : ℝ := a * t₁ + b * t₂
    have ht0 : 0 ≤ t := by positivity
    have ht1 : t ≤ 1 := by nlinarith
    rcases ht1.eq_or_lt with ht_eq | ht_lt
    · left
      have h1mt_sum : a * (1 - t₁) + b * (1 - t₂) = 0 := by dsimp [t] at ht_eq; linarith
      have ha0 : a * (1 - t₁) = 0 := by
        nlinarith [mul_nonneg ha (sub_nonneg.mpr ht₁1), mul_nonneg hb (sub_nonneg.mpr ht₂1)]
      have hb0 : b * (1 - t₂) = 0 := by linarith
      have hcomb : a • ((1 - t₁) • u₁ + t₁ • w) + b • ((1 - t₂) • u₂ + t₂ • w) =
          (a * (1 - t₁)) • u₁ + (b * (1 - t₂)) • u₂ + t • w := by
        dsimp [t]
        push_cast
        ring
      rw [hcomb, ha0, hb0, ht_eq, zero_smul, zero_smul, zero_add, zero_add, one_smul]
      rfl
    · right
      refine Set.mem_iUnion₂.mpr ⟨t, ⟨ht0, ht_lt⟩, ?_⟩
      have h1mt : 0 < 1 - t := sub_pos.mpr ht_lt
      let c₁ : ℝ := a * (1 - t₁) / (1 - t)
      let c₂ : ℝ := b * (1 - t₂) / (1 - t)
      have hc₁ : 0 ≤ c₁ := div_nonneg (mul_nonneg ha (sub_nonneg.mpr ht₁1)) h1mt.le
      have hc₂ : 0 ≤ c₂ := div_nonneg (mul_nonneg hb (sub_nonneg.mpr ht₂1)) h1mt.le
      have hc12 : c₁ + c₂ = 1 := by
        dsimp [c₁, c₂]
        rw [← add_div, div_eq_one_iff_eq h1mt.ne']
        dsimp [t]; ring_nf; linarith
      have hu_mem : c₁ • u₁ + c₂ • u₂ ∈ Metric.ball (0 : ℂ) α :=
        (convex_ball (0 : ℂ) α) hu₁ hu₂ hc₁ hc₂ hc12
      have hlin : a • ((1 - t₁) • u₁ + t₁ • w) + b • ((1 - t₂) • u₂ + t₂ • w) - (t : ℂ) * w =
          (1 - t) • (c₁ • u₁ + c₂ • u₂) := by
        have hc1_mul : (1 - t) * c₁ = a * (1 - t₁) := mul_div_cancel₀ _ h1mt.ne'
        have hc2_mul : (1 - t) * c₂ = b * (1 - t₂) := mul_div_cancel₀ _ h1mt.ne'
        conv_rhs => rw [smul_add, smul_smul, smul_smul, hc1_mul, hc2_mul]
        simp only [Complex.real_smul]
        dsimp [t]
        push_cast
        ring
      rw [Metric.mem_ball, dist_eq_norm, hlin, norm_smul, Real.norm_eq_abs, abs_of_pos h1mt]
      have hu_norm : ‖c₁ • u₁ + c₂ • u₂‖ < α := by simpa [Metric.mem_ball] using hu_mem
      exact mul_lt_mul_of_pos_left hu_norm h1mt
  have hS_sub_C : S ⊆ C := by
    rintro z (hz | rfl)
    · right
      refine Set.mem_iUnion₂.mpr ⟨0, ⟨le_rfl, zero_lt_one⟩, ?_⟩
      simpa using hz
    · exact Or.inl rfl
  have hhull_sub_C : convexHull ℝ S ⊆ C := convexHull_min hS_sub_C hC_conv
  ext z
  constructor
  · rintro ⟨hz_hull, hz_ball⟩
    rcases hhull_sub_C hz_hull with rfl | hzB
    · exfalso
      have : ‖w‖ < 1 := by simpa [Metric.mem_ball] using hz_ball
      linarith
    · exact hzB
  · intro hzB
    exact ⟨hB_sub_hull hzB, hB_sub_ball hzB⟩

private theorem isOpen_stolzRegion {α : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (ζ : FourierCircle) :
    IsOpen (stolzRegion α ζ) := by
  rw [stolzRegion_eq_iUnion_ball hα0 hα1 ζ]
  exact isOpen_biUnion fun _ _ ↦ Metric.isOpen_ball

private theorem radial_mem_stolzRegion {α r : ℝ} (hα0 : 0 < α) (hα1 : α < 1)
    (hr0 : 0 ≤ r) (hr1 : r < 1) (ζ : FourierCircle) :
    (r : ℂ) * circlePoint ζ ∈ stolzRegion α ζ := by
  rw [stolzRegion_eq_iUnion_ball hα0 hα1 ζ]
  exact Set.mem_iUnion₂.mpr ⟨r, ⟨hr0, hr1⟩, Metric.mem_ball_self (mul_pos (sub_pos.mpr hr1) hα0)⟩

private theorem isOpen_setOf_mem_stolzRegion {α : ℝ} (hα0 : 0 < α) (hα1 : α < 1) (z : ℂ) :
    IsOpen {ζ : FourierCircle | z ∈ stolzRegion α ζ} := by
  have heq : {ζ : FourierCircle | z ∈ stolzRegion α ζ} =
      ⋃ t ∈ Set.Ico (0 : ℝ) 1,
        {ζ : FourierCircle | dist z ((t : ℂ) * circlePoint ζ) < (1 - t) * α} := by
    ext ζ
    simp [stolzRegion_eq_iUnion_ball hα0 hα1 ζ, Metric.mem_ball]
  rw [heq]
  exact isOpen_biUnion fun t _ ↦
    isOpen_lt (continuous_const.dist (continuous_const.mul continuous_circlePoint))
      continuous_const

private theorem lowerSemicontinuous_nontangentialMaximalENNReal {α : ℝ}
    (hα0 : 0 < α) (hα1 : α < 1) (f : ℂ → ℂ) :
    LowerSemicontinuous (nontangentialMaximalENNReal α f) := by
  rw [lowerSemicontinuous_iff_isOpen_preimage]
  intro y
  have heq : nontangentialMaximalENNReal α f ⁻¹' Set.Ioi y =
      ⋃ z : ℂ, ⋃ (_ : y < ‖f z‖ₑ), {ζ : FourierCircle | z ∈ stolzRegion α ζ} := by
    ext ζ
    simp only [Set.mem_preimage, Set.mem_Ioi, nontangentialMaximalENNReal, lt_iSup_iff,
      Set.mem_iUnion, Set.mem_ofPred_eq]
    tauto
  rw [heq]
  exact isOpen_iUnion fun z ↦ isOpen_iUnion fun _ ↦ isOpen_setOf_mem_stolzRegion hα0 hα1 z

private theorem measurable_nontangentialMaximalENNReal {α : ℝ}
    (hα0 : 0 < α) (hα1 : α < 1) (f : ℂ → ℂ) :
    Measurable (nontangentialMaximalENNReal α f) :=
  (lowerSemicontinuous_nontangentialMaximalENNReal hα0 hα1 f).measurable

private theorem measurable_nontangentialMaximal {α : ℝ}
    (hα0 : 0 < α) (hα1 : α < 1) (f : ℂ → ℂ) :
    Measurable (nontangentialMaximal α f) :=
  (measurable_nontangentialMaximalENNReal hα0 hα1 f).ennreal_toReal

private theorem norm_sub_circlePoint_le_of_mem_stolzRegion {α : ℝ}
    (hα0 : 0 < α) (hα1 : α < 1) {ζ : FourierCircle} {z : ℂ} (hz : z ∈ stolzRegion α ζ) :
    ‖z - circlePoint ζ‖ ≤ ((1 + α) / (1 - α)) * (1 - ‖z‖) := by
  rw [stolzRegion_eq_iUnion_ball hα0 hα1 ζ] at hz
  obtain ⟨t, ⟨ht0, ht1⟩, hzt⟩ := Set.mem_iUnion₂.mp hz
  rw [Metric.mem_ball, dist_eq_norm] at hzt
  let w : ℂ := circlePoint ζ
  have hw_norm : ‖w‖ = 1 := norm_circlePoint ζ
  have h1mα : 0 < 1 - α := sub_pos.mpr hα1
  have htw_sub : ‖(t : ℂ) * w - w‖ = 1 - t := by
    have hrew : (t : ℂ) * w - w = (((t - 1 : ℝ) : ℂ)) * w := by push_cast; ring
    rw [hrew, norm_mul, Complex.norm_real, Real.norm_eq_abs, hw_norm, mul_one,
      abs_of_neg (sub_neg.mpr ht1)]
    ring
  have hzw_le : ‖z - w‖ ≤ (1 + α) * (1 - t) := by
    calc ‖z - w‖ = ‖(z - (t : ℂ) * w) + ((t : ℂ) * w - w)‖ := by ring_nf
      _ ≤ ‖z - (t : ℂ) * w‖ + ‖(t : ℂ) * w - w‖ := norm_add_le _ _
      _ ≤ (1 - t) * α + (1 - t) := add_le_add hzt.le htw_sub.le
      _ = (1 + α) * (1 - t) := by ring
  have hz_norm_le : ‖z‖ ≤ t + (1 - t) * α := by
    calc ‖z‖ = ‖(z - (t : ℂ) * w) + (t : ℂ) * w‖ := by ring_nf
      _ ≤ ‖z - (t : ℂ) * w‖ + ‖(t : ℂ) * w‖ := norm_add_le _ _
      _ ≤ (1 - t) * α + t := by
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg ht0, hw_norm, mul_one]
          linarith
      _ = t + (1 - t) * α := by ring
  have h1mt_le : 1 - t ≤ (1 - ‖z‖) / (1 - α) := by
    rw [le_div_iff₀ h1mα]
    nlinarith
  calc ‖z - w‖ ≤ (1 + α) * (1 - t) := hzw_le
    _ ≤ (1 + α) * ((1 - ‖z‖) / (1 - α)) :=
        mul_le_mul_of_nonneg_left h1mt_le (by linarith)
    _ = ((1 + α) / (1 - α)) * (1 - ‖z‖) := by ring

/-- Quadratic lower bound `x ^ 2 ≤ 32 * (1 - cos x)` for `x ∈ [-π, π]`. -/
private theorem sq_le_thirty_two_mul_one_sub_cos {x : ℝ}
    (hx : x ∈ Set.Icc (-Real.pi) Real.pi) :
    x ^ 2 ≤ 32 * (1 - Real.cos x) := by
  have hcos := Real.cos_le_one_sub_mul_cos_sq (abs_le.mpr hx)
  have hpi2 : Real.pi ^ 2 ≤ 16 := by nlinarith [Real.pi_pos, Real.pi_le_four]
  have hfrac : (1 : ℝ) / 8 ≤ 2 / Real.pi ^ 2 := by
    rw [div_le_div_iff₀ (by norm_num) (sq_pos_of_pos Real.pi_pos)]
    linarith
  have hmul : (1 / 8) * x ^ 2 ≤ 2 / Real.pi ^ 2 * x ^ 2 :=
    mul_le_mul_of_nonneg_right hfrac (sq_nonneg x)
  have h8 : x ^ 2 ≤ 8 * (1 - Real.cos x) := by linarith
  have h1mc : 0 ≤ 1 - Real.cos x := by linarith [Real.cos_le_one x]
  linarith

/-- Explicit polar-cone constant for `stolzRegion α` (`0 < α < 1`). -/
private def stolzConeConst (α : ℝ) : ℝ :=
  max 6 (8 * ((1 + α) / (1 - α)))

private theorem stolzConeConst_nonneg (α : ℝ) : 0 ≤ stolzConeConst α :=
  (by norm_num : (0 : ℝ) ≤ 6).trans (le_max_left _ _)

/-- Polar-cone representation on `stolzRegion α (θ₀ : FourierCircle)`: every `z ∈ Ω_α(e^{iθ₀})`
can be written `z = r e^{iθ}` with `r = ‖z‖ ∈ [0, 1)` and `|θ - θ₀| ≤ stolzConeConst α * (1 - r)`. -/
private theorem stolzRegion_polar_cone {α : ℝ} (hα0 : 0 < α) (hα1 : α < 1)
    (θ₀ : ℝ) {z : ℂ} (hz : z ∈ stolzRegion α (θ₀ : FourierCircle)) :
    ∃ θ : ℝ,
      z = ((‖z‖ : ℝ) : ℂ) * Complex.exp ((θ : ℂ) * Complex.I) ∧
      |θ - θ₀| ≤ stolzConeConst α * (1 - ‖z‖) := by
  let r : ℝ := ‖z‖
  have hr0 : 0 ≤ r := norm_nonneg z
  have hr1 : r < 1 := by simpa [r, Metric.mem_ball] using stolzRegion_subset_ball α _ hz
  by_cases hz0 : z = 0
  · refine ⟨θ₀, ?_, ?_⟩
    · simp [hz0]
    · simp [hz0, stolzConeConst_nonneg α]
  · let u : ℂ := z * Complex.exp (-(θ₀ : ℂ) * Complex.I)
    let φ : ℝ := Complex.arg u
    let θ : ℝ := θ₀ + φ
    have hu_norm : ‖u‖ = r := by
      dsimp [u, r]
      have hexp : -(θ₀ : ℂ) * Complex.I = (((-θ₀ : ℝ) : ℂ)) * Complex.I := by push_cast; ring
      rw [norm_mul, hexp, Complex.norm_exp_ofReal_mul_I, mul_one]
    have hz_eq : z = (r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I) := by
      have harg := Complex.norm_mul_exp_arg_mul_I u
      rw [hu_norm] at harg
      have hexp_split : Complex.exp ((θ : ℂ) * Complex.I) =
          Complex.exp ((φ : ℂ) * Complex.I) * Complex.exp ((θ₀ : ℂ) * Complex.I) := by
        dsimp [θ]
        rw [← Complex.exp_add]; congr 1; push_cast; ring
      rw [hexp_split, ← mul_assoc, harg]
      dsimp [u]
      rw [mul_assoc, ← Complex.exp_add]
      have h0 : -(θ₀ : ℂ) * Complex.I + (θ₀ : ℂ) * Complex.I = 0 := by ring
      rw [h0, Complex.exp_zero, mul_one]
    have hφ_Icc : φ ∈ Set.Icc (-Real.pi) Real.pi :=
      ⟨(Complex.neg_pi_lt_arg u).le, Complex.arg_le_pi u⟩
    have hφ_abs_le_pi : |φ| ≤ Real.pi := abs_le.mpr hφ_Icc
    have hsub_θ : θ - θ₀ = φ := by dsimp [θ]; ring
    refine ⟨θ, hz_eq, ?_⟩
    rw [hsub_θ]
    by_cases hr_quarter : r < 1 / 4
    · have hpi4 : Real.pi ≤ 4 := Real.pi_le_four
      have h6 : |φ| ≤ 6 * (1 - r) := by linarith
      exact h6.trans (mul_le_mul_of_nonneg_right (le_max_left _ _) (sub_nonneg.mpr hr1.le))
    · push Not at hr_quarter
      have hcone := norm_sub_circlePoint_le_of_mem_stolzRegion hα0 hα1 hz
      rw [circlePoint_coe] at hcone
      have hnorm_u_sub : ‖(1 : ℂ) - (r : ℂ) * Complex.exp ((φ : ℂ) * Complex.I)‖ =
          ‖z - Complex.exp ((θ₀ : ℂ) * Complex.I)‖ := by
        have hmul1 : ‖Complex.exp ((θ₀ : ℂ) * Complex.I)‖ = 1 :=
          Complex.norm_exp_ofReal_mul_I θ₀
        calc ‖(1 : ℂ) - (r : ℂ) * Complex.exp ((φ : ℂ) * Complex.I)‖
            = ‖((1 : ℂ) - (r : ℂ) * Complex.exp ((φ : ℂ) * Complex.I)) *
                Complex.exp ((θ₀ : ℂ) * Complex.I)‖ := by
              rw [norm_mul, hmul1, mul_one]
          _ = ‖Complex.exp ((θ₀ : ℂ) * Complex.I) - z‖ := by
              congr 1
              rw [hz_eq]
              dsimp [θ]
              have hexp_add : Complex.exp (((θ₀ + φ : ℝ) : ℂ) * Complex.I) =
                  Complex.exp ((φ : ℂ) * Complex.I) * Complex.exp ((θ₀ : ℂ) * Complex.I) := by
                rw [← Complex.exp_add]; congr 1; push_cast; ring
              rw [hexp_add]
              ring
          _ = ‖z - Complex.exp ((θ₀ : ℂ) * Complex.I)‖ := norm_sub_rev _ _
      have hpolar_sq : ‖(1 : ℂ) - (r : ℂ) * Complex.exp ((φ : ℂ) * Complex.I)‖ ^ 2 =
          (1 - r) ^ 2 + 2 * r * (1 - Real.cos φ) := by
        rw [RudinRCA.Chapter11.norm_sq_one_sub_polar]
        ring
      have hcos_sq := sq_le_thirty_two_mul_one_sub_cos hφ_Icc
      have h1mcos_nn : 0 ≤ 1 - Real.cos φ := sub_nonneg.mpr (Real.cos_le_one φ)
      have hφ_sq_le : φ ^ 2 ≤ 64 * ‖z - Complex.exp ((θ₀ : ℂ) * Complex.I)‖ ^ 2 := by
        rw [← hnorm_u_sub, hpolar_sq]
        have hr_mul : (1 / 2 : ℝ) * (1 - Real.cos φ) ≤ 2 * r * (1 - Real.cos φ) :=
          mul_le_mul_of_nonneg_right (by linarith) h1mcos_nn
        nlinarith [sq_nonneg (1 - r)]
      have hφ_abs_le : |φ| ≤ 8 * ‖z - Complex.exp ((θ₀ : ℂ) * Complex.I)‖ := by
        have hsq8 : |φ| ^ 2 ≤ (8 * ‖z - Complex.exp ((θ₀ : ℂ) * Complex.I)‖) ^ 2 := by
          rw [sq_abs]
          nlinarith
        exact (sq_le_sq₀ (abs_nonneg φ) (by positivity)).mp hsq8
      calc |φ| ≤ 8 * ‖z - Complex.exp ((θ₀ : ℂ) * Complex.I)‖ := hφ_abs_le
        _ ≤ 8 * (((1 + α) / (1 - α)) * (1 - r)) :=
            mul_le_mul_of_nonneg_left hcone (by norm_num)
        _ = (8 * ((1 + α) / (1 - α))) * (1 - r) := by ring
        _ ≤ stolzConeConst α * (1 - r) :=
            mul_le_mul_of_nonneg_right (le_max_right _ _) (sub_nonneg.mpr hr1.le)

/-- Bridge from polar-cone convergence at `θ₀` (`(θ₀ : FourierCircle) = ζ`) to filter convergence
along `𝓝[stolzRegion α ζ] (circlePoint ζ)` for every `0 < α < 1`. -/
private theorem tendsto_stolzRegion_of_polar_cone {f : ℂ → ℂ} {ζ : FourierCircle} {w : ℂ}
    {θ₀ : ℝ} (hθ₀ : (θ₀ : FourierCircle) = ζ)
    (hcone : ∀ {K : ℝ}, 0 ≤ K → ∀ {ι : Type} {l : Filter ι} (r θ : ι → ℝ),
      Tendsto r l (𝓝[<] 1) →
      (∀ᶠ j in l, |θ j - θ₀| ≤ K * (1 - r j)) →
      Tendsto (fun j ↦ f (((r j : ℝ) : ℂ) * Complex.exp (((θ j : ℝ) : ℂ) * Complex.I)))
        l (𝓝 w))
    {α : ℝ} (hα0 : 0 < α) (hα1 : α < 1) :
    Tendsto f (𝓝[stolzRegion α ζ] (circlePoint ζ)) (𝓝 w) := by
  subst hθ₀
  classical
  let r_fn : ℂ → ℝ := fun z ↦ ‖z‖
  let θ_fn : ℂ → ℝ := fun z ↦
    if hz : z ∈ stolzRegion α (θ₀ : FourierCircle) then
      Classical.choose (stolzRegion_polar_cone hα0 hα1 θ₀ hz)
    else θ₀
  have hr_lim : Tendsto r_fn
      (𝓝[stolzRegion α (θ₀ : FourierCircle)] (circlePoint (θ₀ : FourierCircle)))
      (𝓝[<] 1) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
    · have hnorm1 : ‖circlePoint (θ₀ : FourierCircle)‖ = 1 := norm_circlePoint _
      exact hnorm1 ▸ (continuous_norm.tendsto _).mono_left nhdsWithin_le_nhds
    · filter_upwards [self_mem_nhdsWithin] with z hz
      simpa [r_fn, Metric.mem_ball] using stolzRegion_subset_ball α _ hz
  have hθ_cone : ∀ᶠ z in 𝓝[stolzRegion α (θ₀ : FourierCircle)] (circlePoint (θ₀ : FourierCircle)),
      |θ_fn z - θ₀| ≤ stolzConeConst α * (1 - r_fn z) := by
    filter_upwards [self_mem_nhdsWithin] with z hz
    dsimp [θ_fn, r_fn]
    simp only [hz, ↓reduceDIte]
    exact (Classical.choose_spec (stolzRegion_polar_cone hα0 hα1 θ₀ hz)).2
  have hlim := hcone (stolzConeConst_nonneg α) r_fn θ_fn hr_lim hθ_cone
  refine hlim.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with z hz
  dsimp [θ_fn, r_fn]
  simp only [hz, ↓reduceDIte]
  exact congrArg f (Classical.choose_spec (stolzRegion_polar_cone hα0 hα1 θ₀ hz)).1.symm

/-- Radial approach `r ↦ (r : ℂ) * circlePoint ζ` tends to `circlePoint ζ` inside
`stolzRegion α ζ` as `r → 1⁻` (`0 < α < 1`). -/
private theorem tendsto_radial_stolzRegion {α : ℝ} (hα0 : 0 < α) (hα1 : α < 1)
    (ζ : FourierCircle) :
    Tendsto (fun r : ℝ ↦ (r : ℂ) * circlePoint ζ) (𝓝[<] 1)
      (𝓝[stolzRegion α ζ] (circlePoint ζ)) := by
  refine tendsto_nhdsWithin_iff.mpr ⟨?_, ?_⟩
  · have hcont : Continuous (fun r : ℝ ↦ (r : ℂ) * circlePoint ζ) :=
      Complex.continuous_ofReal.mul continuous_const
    simpa using (hcont.tendsto 1).mono_left nhdsWithin_le_nhds
  · filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    exact radial_mem_stolzRegion hα0 hα1 hr.1.le hr.2 ζ

/-- Push a Lebesgue-a.e. property on `ℝ` to `circleMeasure` via the fundamental domain
`(-π, π]`. -/
private theorem ae_exists_lift_of_ae_volume {R : ℝ → Prop}
    (hR : ∀ᵐ θ₀ ∂(volume : Measure ℝ), R θ₀) :
    ∀ᵐ ζ ∂circleMeasure, ∃ θ₀ : ℝ, (θ₀ : FourierCircle) = ζ ∧ R θ₀ := by
  have : Fact (0 < 2 * Real.pi) := ⟨Real.two_pi_pos⟩
  let e := AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
  have hmp_sub : MeasurePreserving (Subtype.val ∘ e) (volume : Measure FourierCircle)
      (volume.restrict (Set.Ioc (-Real.pi) (-Real.pi + 2 * Real.pi))) :=
    (measurePreserving_subtype_coe measurableSet_Ioc).comp
      (AddCircle.measurePreserving_equivIoc (2 * Real.pi) (a := -Real.pi))
  have hae_vol : ∀ᵐ ζ ∂(volume : Measure FourierCircle), R ((Subtype.val ∘ e) ζ) :=
    hmp_sub.quasiMeasurePreserving.tendsto_ae.eventually (ae_restrict_of_ae hR)
  have hsmul : (volume : Measure FourierCircle) = ENNReal.ofReal (2 * Real.pi) • circleMeasure :=
    AddCircle.volume_eq_smul_haarAddCircle
  have hae_circ : ∀ᵐ ζ ∂circleMeasure, R ((Subtype.val ∘ e) ζ) := by
    rw [Filter.Eventually, mem_ae_iff] at hae_vol ⊢
    rw [hsmul, Measure.smul_apply, smul_eq_mul, mul_eq_zero] at hae_vol
    exact hae_vol.resolve_left (ENNReal.ofReal_pos.mpr Real.two_pi_pos).ne'
  filter_upwards [hae_circ] with ζ hζ
  refine ⟨(e ζ).1, ?_, hζ⟩
  exact e.left_inv ζ

/-- Lebesgue integral on `circleMeasure` in terms of `Set.Ioc a (a + 2π)`. -/
private theorem lintegral_circleMeasure_eq_Ioc (a : ℝ) (g : FourierCircle → ℝ≥0∞) :
    ENNReal.ofReal (2 * Real.pi) * ∫⁻ ζ, g ζ ∂circleMeasure =
      ∫⁻ t in Set.Ioc a (a + 2 * Real.pi), g (t : FourierCircle) ∂volume := by
  have : Fact (0 < 2 * Real.pi) := ⟨Real.two_pi_pos⟩
  have hpre := AddCircle.lintegral_preimage (2 * Real.pi) a g
  rw [AddCircle.volume_eq_smul_haarAddCircle, lintegral_smul_measure, smul_eq_mul] at hpre
  exact hpre.symm

/-- Local integrability on `ℝ` of the `2π`-periodic lift of an integrable function on
`FourierCircle`. -/
private theorem locallyIntegrable_coe_of_integrable_circleMeasure {E : Type*}
    [NormedAddCommGroup E] {G : FourierCircle → E} (hG : Integrable G circleMeasure) :
    LocallyIntegrable (fun t : ℝ ↦ G (t : FourierCircle)) volume := by
  have hii_base : IntervalIntegrable (fun t : ℝ ↦ G (t : FourierCircle))
      volume (-Real.pi) Real.pi :=
    (integrable_circleMeasure_iff_intervalIntegrable G).mp hG
  have hper : Function.Periodic (fun t : ℝ ↦ G (t : FourierCircle)) (2 * Real.pi) := by
    intro t
    dsimp only
    congr 1
    exact QuotientAddGroup.mk_add_of_mem _ (AddSubgroup.mem_zmultiples (2 * Real.pi))
  have hii_period : ∀ a : ℝ,
      IntervalIntegrable (fun t : ℝ ↦ G (t : FourierCircle)) volume a (a + 2 * Real.pi) := by
    intro a
    refine (hper.intervalIntegrable_iff (t₁ := a) (t₂ := -Real.pi)).mpr ?_
    convert hii_base using 1
    ring
  intro x
  have hii := hii_period (x - Real.pi)
  have hpi : 0 < Real.pi := Real.pi_pos
  have hle : x - Real.pi ≤ x - Real.pi + 2 * Real.pi := by linarith
  rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hle] at hii
  refine ⟨Set.Ioo (x - Real.pi) (x + Real.pi),
    Ioo_mem_nhds (by linarith) (by linarith), hii.mono_set ?_⟩
  intro y hy
  exact ⟨hy.1, by linarith [hy.2]⟩

/-- Derivative formula `- P_r'(u)` on `ℝ` (`0 ≤ r < 1`) and integration by parts on `[0, π]`,
adapted for the nontangential maximal `L^2` estimate in `17.11`. -/
private def poissonNegDeriv (r u : ℝ) : ℝ :=
  (1 - r ^ 2) * (2 * r * Real.sin u) / (1 - 2 * r * Real.cos u + r ^ 2) ^ 2

private theorem poissonKernel_ibp_on_zero_pi {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    {φ : ℝ → ℝ} (hφ_loc : LocallyIntegrable φ volume) (hφ_nn : ∀ s, 0 ≤ φ s) :
    (∫ s in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r s * φ s) =
      RudinRCA.Chapter11.poissonKernel r Real.pi * (∫ s in (0 : ℝ)..Real.pi, φ s) +
        ∫ u in (0 : ℝ)..Real.pi, poissonNegDeriv r u * (∫ s in (0 : ℝ)..u, φ s) := by
  let P := RudinRCA.Chapter11.poissonKernel r
  let Q := poissonNegDeriv r
  let Φ : ℝ → ℝ := fun u ↦ ∫ s in (0 : ℝ)..u, φ s
  let μ₀ : Measure ℝ := volume.restrict (Set.Icc 0 Real.pi)
  have hP_cont : Continuous P := RudinRCA.Chapter11.continuous_poissonKernel hr0 hr1
  have hQ_cont : Continuous Q := by
    unfold Q poissonNegDeriv
    refine Continuous.div (by fun_prop) (by fun_prop) fun u ↦ ?_
    have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
      nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
    exact (sq_pos_of_pos hden_pos).ne'
  have hP_deriv : ∀ u : ℝ, HasDerivAt P (-Q u) u := by
    intro u
    have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
      nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
    have hden_d : HasDerivAt (fun x : ℝ ↦ 1 - 2 * r * Real.cos x + r ^ 2)
        (2 * r * Real.sin u) u := by
      convert ((hasDerivAt_const u (1 : ℝ)).sub
        ((Real.hasDerivAt_cos u).const_mul (2 * r))).add (hasDerivAt_const u (r ^ 2)) using 1
      ring
    refine ((hasDerivAt_const u (1 - r ^ 2)).div hden_d hden_pos.ne').congr_deriv ?_
    unfold Q poissonNegDeriv
    ring
  have hP_ftc : ∀ s : ℝ, P s = P Real.pi + ∫ u in s..Real.pi, Q u := by
    intro s
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (fun u _ ↦ hP_deriv u) (hQ_cont.neg.intervalIntegrable s Real.pi)
    rw [intervalIntegral.integral_neg] at h
    linarith
  have hQ_nn : ∀ u ∈ Set.Icc (0 : ℝ) Real.pi, 0 ≤ Q u := by
    intro u hu
    unfold Q poissonNegDeriv
    have hsin : 0 ≤ Real.sin u := Real.sin_nonneg_of_nonneg_of_le_pi hu.1 hu.2
    have h1mr2 : 0 ≤ 1 - r ^ 2 := by nlinarith
    have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
      nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
    positivity
  have hΦ_cont : ContinuousOn Φ (Set.Icc 0 Real.pi) := by
    have h := intervalIntegral.continuousOn_primitive_interval
      (a := (0 : ℝ)) (b := Real.pi) (hφ_loc.integrableOn_isCompact isCompact_uIcc)
    rwa [Set.uIcc_of_le Real.pi_pos.le] at h
  have hΦ_nn : ∀ u ∈ Set.Icc (0 : ℝ) Real.pi, 0 ≤ Φ u :=
    fun u hu ↦ intervalIntegral.integral_nonneg hu.1 fun s _ ↦ hφ_nn s
  have hφ_int_Icc : Integrable φ μ₀ := hφ_loc.integrableOn_isCompact isCompact_Icc
  have hPφ_int_Icc : Integrable (fun s ↦ P s * φ s) μ₀ := by
    have hii : IntervalIntegrable φ volume 0 Real.pi :=
      (hφ_loc.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
    have hint := hii.continuousOn_mul hP_cont.continuousOn
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le Real.pi_pos.le] at hint
    change IntegrableOn (fun s ↦ P s * φ s) (Set.Icc 0 Real.pi) volume
    simpa only [mul_comm] using hint
  have hQΦ_int_Icc : Integrable (fun u ↦ Q u * Φ u) μ₀ :=
    (hQ_cont.continuousOn.mul hΦ_cont).integrableOn_Icc
  have hP_ofReal : ∀ s ∈ Set.Icc (0 : ℝ) Real.pi,
      ENNReal.ofReal (P s) =
        ENNReal.ofReal (P Real.pi) +
          ∫⁻ u, (if s ≤ u then ENNReal.ofReal (Q u) else 0) ∂μ₀ := by
    intro s hs
    have hQ_int_s : IntegrableOn Q (Set.Icc s Real.pi) volume := hQ_cont.integrableOn_Icc
    have hQ_nn_s : 0 ≤ᵐ[volume.restrict (Set.Icc s Real.pi)] Q :=
      ae_restrict_of_forall_mem measurableSet_Icc fun u hu ↦ hQ_nn u ⟨hs.1.trans hu.1, hu.2⟩
    have hlint_s :
        (∫⁻ u, (if s ≤ u then ENNReal.ofReal (Q u) else 0) ∂μ₀) =
          ENNReal.ofReal (∫ u in s..Real.pi, Q u) := by
      have hind : (fun u ↦ if s ≤ u then ENNReal.ofReal (Q u) else 0) =
          Set.indicator (Set.Ici s) (fun u ↦ ENNReal.ofReal (Q u)) := by
        ext u; simp [Set.indicator]
      have hinter : Set.Icc (0 : ℝ) Real.pi ∩ Set.Ici s = Set.Icc s Real.pi := by
        ext u; simp only [Set.mem_inter_iff, Set.mem_Icc, Set.mem_Ici]; constructor
        · rintro ⟨⟨_, h2⟩, h3⟩; exact ⟨h3, h2⟩
        · rintro ⟨h1, h2⟩; exact ⟨⟨hs.1.trans h1, h2⟩, h1⟩
      rw [hind, lintegral_indicator measurableSet_Ici, Measure.restrict_restrict measurableSet_Ici,
        Set.inter_comm, hinter, ← ofReal_integral_eq_lintegral_ofReal hQ_int_s hQ_nn_s,
        intervalIntegral.integral_of_le hs.2, integral_Icc_eq_integral_Ioc]
    have hP_pi_nn : 0 ≤ P Real.pi := (RudinRCA.Chapter11.node11_5_pos hr0 hr1 Real.pi).le
    have hint_nn : 0 ≤ ∫ u in s..Real.pi, Q u :=
      intervalIntegral.integral_nonneg hs.2 fun u hu ↦ hQ_nn u ⟨hs.1.trans hu.1, hu.2⟩
    rw [hlint_s, ← ENNReal.ofReal_add hP_pi_nn hint_nn, ← hP_ftc s]
  have hLHS : ENNReal.ofReal (∫ s in (0 : ℝ)..Real.pi, P s * φ s) =
      ∫⁻ s, ENNReal.ofReal (P s * φ s) ∂μ₀ := by
    rw [intervalIntegral.integral_of_le Real.pi_pos.le, ← integral_Icc_eq_integral_Ioc]
    exact ofReal_integral_eq_lintegral_ofReal hPφ_int_Icc
      (ae_of_all _ fun s ↦ mul_nonneg (RudinRCA.Chapter11.node11_5_pos hr0 hr1 s).le (hφ_nn s))
  have hswap :
      (∫⁻ s, (∫⁻ u, (if s ≤ u then ENNReal.ofReal (Q u) else 0) ∂μ₀) *
          ENNReal.ofReal (φ s) ∂μ₀) =
        ∫⁻ u, ENNReal.ofReal (Q u * Φ u) ∂μ₀ := by
    have hstep1 :
        (∫⁻ s, (∫⁻ u, (if s ≤ u then ENNReal.ofReal (Q u) else 0) ∂μ₀) *
            ENNReal.ofReal (φ s) ∂μ₀) =
          ∫⁻ s, ∫⁻ u,
            (if s ≤ u then ENNReal.ofReal (Q u) * ENNReal.ofReal (φ s) else 0) ∂μ₀ ∂μ₀ := by
      refine lintegral_congr fun s ↦ ?_
      have hm : AEMeasurable (fun u : ℝ ↦ if s ≤ u then ENNReal.ofReal (Q u) else 0) μ₀ :=
        (Measurable.ite measurableSet_Ici hQ_cont.measurable.ennreal_ofReal
          measurable_const).aemeasurable
      rw [← lintegral_mul_const'' _ hm]
      refine lintegral_congr fun u ↦ ?_
      split_ifs <;> simp
    have hprod_meas : AEMeasurable
        (Function.uncurry fun s u : ℝ ↦
          if s ≤ u then ENNReal.ofReal (Q u) * ENNReal.ofReal (φ s) else 0)
        (μ₀.prod μ₀) := by
      have hle_meas : MeasurableSet {p : ℝ × ℝ | p.1 ≤ p.2} :=
        (isClosed_le continuous_fst continuous_snd).measurableSet
      have hQ_aem : AEMeasurable (fun p : ℝ × ℝ ↦ ENNReal.ofReal (Q p.2)) (μ₀.prod μ₀) :=
        (hQ_cont.measurable.ennreal_ofReal.comp measurable_snd).aemeasurable
      have hφ_aem : AEMeasurable (fun p : ℝ × ℝ ↦ ENNReal.ofReal (φ p.1)) (μ₀.prod μ₀) :=
        hφ_int_Icc.aestronglyMeasurable.aemeasurable.ennreal_ofReal.comp_quasiMeasurePreserving
          MeasureTheory.Measure.quasiMeasurePreserving_fst
      have hind_eq : (Function.uncurry fun s u : ℝ ↦
          if s ≤ u then ENNReal.ofReal (Q u) * ENNReal.ofReal (φ s) else 0) =
          Set.indicator {p : ℝ × ℝ | p.1 ≤ p.2}
            (fun p : ℝ × ℝ ↦ ENNReal.ofReal (Q p.2) * ENNReal.ofReal (φ p.1)) := by
        ext ⟨s, u⟩; simp [Set.indicator]
      rw [hind_eq]
      exact (hQ_aem.mul hφ_aem).indicator hle_meas
    rw [hstep1, lintegral_lintegral_swap hprod_meas]
    refine lintegral_congr_ae ?_
    filter_upwards [ae_restrict_mem measurableSet_Icc] with u hu
    have hpull :
        (∫⁻ s, (if s ≤ u then ENNReal.ofReal (Q u) * ENNReal.ofReal (φ s) else 0) ∂μ₀) =
          ENNReal.ofReal (Q u) * ∫⁻ s, (if s ≤ u then ENNReal.ofReal (φ s) else 0) ∂μ₀ := by
      have hm : AEMeasurable (fun s : ℝ ↦ if s ≤ u then ENNReal.ofReal (φ s) else 0) μ₀ := by
        have hind_eq : (fun s : ℝ ↦ if s ≤ u then ENNReal.ofReal (φ s) else 0) =
            Set.indicator (Set.Iic u) (fun s : ℝ ↦ ENNReal.ofReal (φ s)) := by
          ext s; simp [Set.indicator]
        rw [hind_eq]
        exact hφ_int_Icc.aestronglyMeasurable.aemeasurable.ennreal_ofReal.indicator
          measurableSet_Iic
      rw [← lintegral_const_mul'' _ hm]
      refine lintegral_congr fun s ↦ ?_
      split_ifs <;> simp
    have hΦ_u : (∫⁻ s, (if s ≤ u then ENNReal.ofReal (φ s) else 0) ∂μ₀) =
        ENNReal.ofReal (Φ u) := by
      have hind : (fun s ↦ if s ≤ u then ENNReal.ofReal (φ s) else 0) =
          Set.indicator (Set.Iic u) (fun s ↦ ENNReal.ofReal (φ s)) := by
        ext s; simp [Set.indicator]
      have hinter : Set.Iic u ∩ Set.Icc (0 : ℝ) Real.pi = Set.Icc 0 u := by
        ext s; simp only [Set.mem_inter_iff, Set.mem_Iic, Set.mem_Icc]; constructor
        · rintro ⟨h1, h2, _⟩; exact ⟨h2, h1⟩
        · rintro ⟨h1, h2⟩; exact ⟨h2, h1, h2.trans hu.2⟩
      have hφ_int_u : IntegrableOn φ (Set.Icc 0 u) volume :=
        hφ_loc.integrableOn_isCompact isCompact_Icc
      rw [hind, lintegral_indicator measurableSet_Iic, Measure.restrict_restrict measurableSet_Iic,
        hinter, ← ofReal_integral_eq_lintegral_ofReal hφ_int_u (ae_of_all _ hφ_nn),
        integral_Icc_eq_integral_Ioc, ← intervalIntegral.integral_of_le hu.1]
    rw [hpull, hΦ_u, ← ENNReal.ofReal_mul (hQ_nn u hu)]
  have hRHS_eq :
      (∫⁻ s, ENNReal.ofReal (P s * φ s) ∂μ₀) =
        ENNReal.ofReal (P Real.pi * Φ Real.pi + ∫ u in (0 : ℝ)..Real.pi, Q u * Φ u) := by
    have hcongr :
        (∫⁻ s, ENNReal.ofReal (P s * φ s) ∂μ₀) =
          ∫⁻ s, (ENNReal.ofReal (P Real.pi) * ENNReal.ofReal (φ s) +
            (∫⁻ u, (if s ≤ u then ENNReal.ofReal (Q u) else 0) ∂μ₀) *
              ENNReal.ofReal (φ s)) ∂μ₀ := by
      refine lintegral_congr_ae ?_
      filter_upwards [ae_restrict_mem measurableSet_Icc] with s hs
      rw [ENNReal.ofReal_mul (RudinRCA.Chapter11.node11_5_pos hr0 hr1 s).le, hP_ofReal s hs,
        add_mul]
    have hm1 : AEMeasurable (fun s ↦ ENNReal.ofReal (P Real.pi) * ENNReal.ofReal (φ s)) μ₀ :=
      aemeasurable_const.mul hφ_int_Icc.aestronglyMeasurable.aemeasurable.ennreal_ofReal
    have hterm1 :
        (∫⁻ s, ENNReal.ofReal (P Real.pi) * ENNReal.ofReal (φ s) ∂μ₀) =
          ENNReal.ofReal (P Real.pi * Φ Real.pi) := by
      rw [lintegral_const_mul'' _ hφ_int_Icc.aestronglyMeasurable.aemeasurable.ennreal_ofReal,
        ← ofReal_integral_eq_lintegral_ofReal hφ_int_Icc (ae_of_all _ hφ_nn)]
      have hint_pi : (∫ s, φ s ∂μ₀) = Φ Real.pi := by
        change (∫ s in Set.Icc 0 Real.pi, φ s) = ∫ s in (0 : ℝ)..Real.pi, φ s
        rw [integral_Icc_eq_integral_Ioc, intervalIntegral.integral_of_le Real.pi_pos.le]
      rw [hint_pi, ← ENNReal.ofReal_mul (RudinRCA.Chapter11.node11_5_pos hr0 hr1 Real.pi).le]
    have hterm2 :
        (∫⁻ u, ENNReal.ofReal (Q u * Φ u) ∂μ₀) =
          ENNReal.ofReal (∫ u in (0 : ℝ)..Real.pi, Q u * Φ u) := by
      rw [intervalIntegral.integral_of_le Real.pi_pos.le, ← integral_Icc_eq_integral_Ioc,
        ofReal_integral_eq_lintegral_ofReal hQΦ_int_Icc]
      exact ae_restrict_of_forall_mem measurableSet_Icc fun u hu ↦
        mul_nonneg (hQ_nn u hu) (hΦ_nn u hu)
    have hnn1 : 0 ≤ P Real.pi * Φ Real.pi :=
      mul_nonneg (RudinRCA.Chapter11.node11_5_pos hr0 hr1 Real.pi).le
        (hΦ_nn Real.pi ⟨Real.pi_pos.le, le_rfl⟩)
    have hnn2 : 0 ≤ ∫ u in (0 : ℝ)..Real.pi, Q u * Φ u :=
      intervalIntegral.integral_nonneg Real.pi_pos.le fun u hu ↦
        mul_nonneg (hQ_nn u hu) (hΦ_nn u hu)
    rw [hcongr, lintegral_add_left' hm1, hterm1, hswap, hterm2, ← ENNReal.ofReal_add hnn1 hnn2]
  have hLHS_nn : 0 ≤ ∫ s in (0 : ℝ)..Real.pi, P s * φ s :=
    intervalIntegral.integral_nonneg Real.pi_pos.le fun s _ ↦
      mul_nonneg (RudinRCA.Chapter11.node11_5_pos hr0 hr1 s).le (hφ_nn s)
  have hRHS_nn : 0 ≤ P Real.pi * Φ Real.pi + ∫ u in (0 : ℝ)..Real.pi, Q u * Φ u :=
    add_nonneg
      (mul_nonneg (RudinRCA.Chapter11.node11_5_pos hr0 hr1 Real.pi).le
        (hΦ_nn Real.pi ⟨Real.pi_pos.le, le_rfl⟩))
      (intervalIntegral.integral_nonneg Real.pi_pos.le fun u hu ↦
        mul_nonneg (hQ_nn u hu) (hΦ_nn u hu))
  exact (ENNReal.ofReal_eq_ofReal_iff hLHS_nn hRHS_nn).mp (hLHS.trans hRHS_eq)

/-- Radial Poisson integral bounded by the Hardy–Littlewood maximal function of the `[-2π, 2π]`
cutoff on `[-π, π]`. -/
private theorem poissonIntegral_radial_le_maximal_cutoff
    {G : FourierCircle → ℝ} (hG_int : Integrable G circleMeasure) (hG_nn : ∀ ζ, 0 ≤ G ζ)
    {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) {θ₀ : ℝ} (hθ₀ : θ₀ ∈ Set.Icc (-Real.pi) Real.pi) :
    let g_cut : ℝ → ℂ :=
      Set.indicator (Set.Icc (-2 * Real.pi) (2 * Real.pi)) (fun t ↦ (G (t : FourierCircle) : ℂ))
    ENNReal.ofReal ((2 * Real.pi)⁻¹ *
      ∫ t in (-Real.pi)..Real.pi, RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * G (t : FourierCircle)) ≤
      RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ := by
  intro g_cut
  by_cases hM_top : RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ = ⊤
  · rw [hM_top]; exact le_top
  let M₀ : ℝ := (RudinRCA.Chapter08.maximalFunction volume g_cut θ₀).toReal
  have hM₀_nn : 0 ≤ M₀ := ENNReal.toReal_nonneg
  have hM₀_ofReal : ENNReal.ofReal M₀ = RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ :=
    ENNReal.ofReal_toReal hM_top
  rw [← hM₀_ofReal]
  refine ENNReal.ofReal_le_ofReal ?_
  let gR : ℝ → ℝ := fun t ↦ G (t : FourierCircle)
  have hgR_loc : LocallyIntegrable gR volume := locallyIntegrable_coe_of_integrable_circleMeasure hG_int
  have hgR_per : Function.Periodic gR (2 * Real.pi) := by
    intro t; dsimp [gR]; congr 1
    exact QuotientAddGroup.mk_add_of_mem _ (AddSubgroup.mem_zmultiples (2 * Real.pi))
  let φ : ℝ → ℝ := fun s ↦ gR (θ₀ + s) + gR (θ₀ - s)
  have hφ_nn : ∀ s, 0 ≤ φ s := fun s ↦ add_nonneg (hG_nn _) (hG_nn _)
  have hloc_add : LocallyIntegrable (fun s ↦ gR (θ₀ + s)) volume := by
    intro x
    have hii : IntervalIntegrable gR volume (x - 1 + θ₀) (x + 1 + θ₀) :=
      (hgR_loc.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
    have hc := hii.comp_add_left θ₀
    rw [show x - 1 + θ₀ - θ₀ = x - 1 by ring, show x + 1 + θ₀ - θ₀ = x + 1 by ring,
      intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith)] at hc
    exact ⟨Set.Ioo (x - 1) (x + 1), Ioo_mem_nhds (by linarith) (by linarith),
      hc.mono_set Ioo_subset_Ioc_self⟩
  have hloc_sub : LocallyIntegrable (fun s ↦ gR (θ₀ - s)) volume := by
    intro x
    have hii : IntervalIntegrable gR volume (θ₀ - (x - 1)) (θ₀ - (x + 1)) :=
      (hgR_loc.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
    have hc := hii.comp_sub_left θ₀
    rw [show θ₀ - (θ₀ - (x - 1)) = x - 1 by ring, show θ₀ - (θ₀ - (x + 1)) = x + 1 by ring,
      intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith)] at hc
    exact ⟨Set.Ioo (x - 1) (x + 1), Ioo_mem_nhds (by linarith) (by linarith),
      hc.mono_set Ioo_subset_Ioc_self⟩
  have hφ_loc : LocallyIntegrable φ volume := hloc_add.add hloc_sub
  -- Rewrite `∫_{-π}^π P_r(θ₀ - t) gR(t) dt = ∫_0^π P_r(s) φ(s) ds`
  have hP_cont : Continuous (RudinRCA.Chapter11.poissonKernel r) :=
    RudinRCA.Chapter11.continuous_poissonKernel hr0 hr1
  have hsym_int : (∫ t in (-Real.pi)..Real.pi,
      RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * gR t) =
      ∫ s in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r s * φ s := by
    have hper_prod : Function.Periodic
        (fun t : ℝ ↦ RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * gR t) (2 * Real.pi) := by
      intro t
      dsimp only
      rw [hgR_per t, ← RudinRCA.Chapter11.node11_5_even r (θ₀ - (t + 2 * Real.pi)),
        ← RudinRCA.Chapter11.node11_5_even r (θ₀ - t)]
      have harg : -(θ₀ - (t + 2 * Real.pi)) = -(θ₀ - t) + 2 * Real.pi := by ring
      rw [harg, RudinRCA.Chapter11.node11_5_periodic]
    have hshift := hper_prod.intervalIntegral_add_eq (θ₀ - Real.pi) (-Real.pi)
    rw [show θ₀ - Real.pi + 2 * Real.pi = θ₀ + Real.pi by ring,
      show -Real.pi + 2 * Real.pi = Real.pi by ring] at hshift
    rw [← hshift]
    have hcomp := intervalIntegral.integral_comp_sub_left
      (fun s ↦ RudinRCA.Chapter11.poissonKernel r s * gR (θ₀ - s)) θ₀
      (a := θ₀ - Real.pi) (b := θ₀ + Real.pi)
    have hcomp' : (∫ t in (θ₀ - Real.pi)..(θ₀ + Real.pi),
        RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * gR t) =
        ∫ s in (-Real.pi)..Real.pi, RudinRCA.Chapter11.poissonKernel r s * gR (θ₀ - s) := by
      rw [show θ₀ - (θ₀ + Real.pi) = -Real.pi by ring,
        show θ₀ - (θ₀ - Real.pi) = Real.pi by ring] at hcomp
      exact (intervalIntegral.integral_congr fun t _ ↦ by
        rw [show θ₀ - (θ₀ - t) = t by ring]).trans hcomp
    rw [hcomp']
    have hii1 : IntervalIntegrable
        (fun s ↦ RudinRCA.Chapter11.poissonKernel r s * gR (θ₀ - s)) volume (-Real.pi) 0 := by
      simpa only [mul_comm] using
        ((hloc_sub.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
          (a := -Real.pi) (b := 0)).continuousOn_mul hP_cont.continuousOn
    have hii2 : IntervalIntegrable
        (fun s ↦ RudinRCA.Chapter11.poissonKernel r s * gR (θ₀ - s)) volume 0 Real.pi := by
      simpa only [mul_comm] using
        ((hloc_sub.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
          (a := 0) (b := Real.pi)).continuousOn_mul hP_cont.continuousOn
    have hii_pos : IntervalIntegrable
        (fun s ↦ RudinRCA.Chapter11.poissonKernel r s * gR (θ₀ + s)) volume 0 Real.pi := by
      simpa only [mul_comm] using
        ((hloc_add.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
          (a := 0) (b := Real.pi)).continuousOn_mul hP_cont.continuousOn
    rw [← intervalIntegral.integral_add_adjacent_intervals hii1 hii2]
    have hneg_half : (∫ s in (-Real.pi)..(0 : ℝ),
        RudinRCA.Chapter11.poissonKernel r s * gR (θ₀ - s)) =
        ∫ s in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r s * gR (θ₀ + s) := by
      have hc := intervalIntegral.integral_comp_neg
        (fun s ↦ RudinRCA.Chapter11.poissonKernel r s * gR (θ₀ - s)) (a := 0) (b := Real.pi)
      simp only [neg_zero, RudinRCA.Chapter11.node11_5_even, sub_neg_eq_add] at hc
      exact hc.symm
    rw [hneg_half, ← intervalIntegral.integral_add hii_pos hii2]
    exact intervalIntegral.integral_congr fun s _ ↦ by dsimp [φ]; ring
  -- Bound `Φ u = ∫_0^u φ ≤ 2 * u * M₀` for `u ∈ [0, π]`
  have hΦ_le : ∀ u ∈ Set.Icc (0 : ℝ) Real.pi,
      (∫ s in (0 : ℝ)..u, φ s) ≤ ∫ s in (0 : ℝ)..u, (2 * M₀) := by
    intro u hu
    rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul]
    rcases hu.1.eq_or_lt with rfl | hu_pos
    · simp
    · have hΦ_sym : (∫ s in (0 : ℝ)..u, φ s) = ∫ y in (θ₀ - u)..(θ₀ + u), gR y := by
        dsimp [φ]
        have hi1 : IntervalIntegrable (fun s ↦ gR (θ₀ + s)) volume 0 u :=
          (hloc_add.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
        have hi2 : IntervalIntegrable (fun s ↦ gR (θ₀ - s)) volume 0 u :=
          (hloc_sub.integrableOn_isCompact isCompact_uIcc).intervalIntegrable
        rw [intervalIntegral.integral_add hi1 hi2]
        have hc1 : (∫ s in (0 : ℝ)..u, gR (θ₀ + s)) = ∫ y in θ₀..(θ₀ + u), gR y := by
          simp
        have hc2 : (∫ s in (0 : ℝ)..u, gR (θ₀ - s)) = ∫ y in (θ₀ - u)..θ₀, gR y := by
          simpa only [sub_zero] using intervalIntegral.integral_comp_sub_left gR θ₀ (a := 0) (b := u)
        rw [hc1, hc2, add_comm, intervalIntegral.integral_add_adjacent_intervals
          ((hgR_loc.integrableOn_isCompact isCompact_uIcc).intervalIntegrable)
          ((hgR_loc.integrableOn_isCompact isCompact_uIcc).intervalIntegrable)]
      rw [hΦ_sym]
      have hsub_cut : Metric.ball θ₀ u ⊆ Set.Icc (-2 * Real.pi) (2 * Real.pi) := by
        intro y hy
        rw [Real.ball_eq_Ioo] at hy
        exact ⟨by linarith [hθ₀.1, hu.2, hy.1], by linarith [hθ₀.2, hu.2, hy.2]⟩
      have hball_vol : volume (Metric.ball θ₀ u) = ENNReal.ofReal (2 * u) := by
        rw [Real.ball_eq_Ioo, Real.volume_Ioo]
        congr 1; ring
      have hgR_ball : IntegrableOn gR (Metric.ball θ₀ u) volume := by
        rw [Real.ball_eq_Ioo]
        exact (hgR_loc.integrableOn_isCompact isCompact_Icc).mono_set Ioo_subset_Icc_self
      have hlint_eq : ENNReal.ofReal (∫ y in (θ₀ - u)..(θ₀ + u), gR y) =
          ∫⁻ y in Metric.ball θ₀ u, ‖g_cut y‖ₑ ∂volume := by
        rw [intervalIntegral.integral_of_le (by linarith),
          ← Measure.restrict_congr_set (Ioo_ae_eq_Ioc : Set.Ioo (θ₀ - u) (θ₀ + u) =ᵐ[volume] _),
          ← Real.ball_eq_Ioo,
          ofReal_integral_eq_lintegral_ofReal hgR_ball (ae_of_all _ fun y ↦ hG_nn _)]
        refine setLIntegral_congr_fun measurableSet_ball fun y hy ↦ ?_
        dsimp [g_cut]
        rw [Set.indicator_of_mem (hsub_cut hy), ← ofReal_norm, Complex.norm_real,
          Real.norm_eq_abs, abs_of_nonneg (hG_nn _)]
      have hdiv_le : (∫⁻ y in Metric.ball θ₀ u, ‖g_cut y‖ₑ ∂volume) / volume (Metric.ball θ₀ u) ≤
          RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ := by
        unfold RudinRCA.Chapter08.maximalFunction
        exact le_iSup_of_le u (le_iSup_of_le hu_pos le_rfl)
      have hvol_ne0 : volume (Metric.ball θ₀ u) ≠ 0 := by
        rw [hball_vol]; exact ENNReal.ofReal_ne_zero_iff.mpr (by positivity)
      have hvol_netop : volume (Metric.ball θ₀ u) ≠ ⊤ := by
        rw [hball_vol]; exact ENNReal.ofReal_ne_top
      have hmul_le : ENNReal.ofReal (∫ y in (θ₀ - u)..(θ₀ + u), gR y) ≤
          ENNReal.ofReal (u * (2 * M₀)) := by
        rw [hlint_eq]
        have h1 := (ENNReal.div_le_iff_le_mul (Or.inl hvol_ne0) (Or.inl hvol_netop)).mp hdiv_le
        rw [← hM₀_ofReal, hball_vol, ← ENNReal.ofReal_mul hM₀_nn] at h1
        exact h1.trans_eq (by congr 1; ring)
      exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hmul_le
  -- Reassemble via `poissonKernel_ibp_on_zero_pi` for `φ` and `fun _ ↦ 2 * M₀`
  have hibp_φ := poissonKernel_ibp_on_zero_pi hr0 hr1 hφ_loc hφ_nn
  have hibp_const := poissonKernel_ibp_on_zero_pi hr0 hr1
    (locallyIntegrable_const (2 * M₀)) (fun _ ↦ by positivity)
  have hQ_nn : ∀ u ∈ Set.Icc (0 : ℝ) Real.pi, 0 ≤ poissonNegDeriv r u := by
    intro u hu
    unfold poissonNegDeriv
    have hsin : 0 ≤ Real.sin u := Real.sin_nonneg_of_nonneg_of_le_pi hu.1 hu.2
    have h1mr2 : 0 ≤ 1 - r ^ 2 := by nlinarith
    have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
      nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
    positivity
  have hQ_cont : Continuous (poissonNegDeriv r) := by
    unfold poissonNegDeriv
    refine Continuous.div (by fun_prop) (by fun_prop) fun u ↦ ?_
    have hden_pos : 0 < 1 - 2 * r * Real.cos u + r ^ 2 := by
      nlinarith [Real.cos_le_one u, sq_pos_of_pos (sub_pos.mpr hr1)]
    exact (sq_pos_of_pos hden_pos).ne'
  have hΦ_cont : ContinuousOn (fun u ↦ ∫ s in (0 : ℝ)..u, φ s) (Set.Icc 0 Real.pi) := by
    have h := intervalIntegral.continuousOn_primitive_interval
      (a := (0 : ℝ)) (b := Real.pi) (hφ_loc.integrableOn_isCompact isCompact_uIcc)
    rwa [Set.uIcc_of_le Real.pi_pos.le] at h
  have hQΦ_ii : IntervalIntegrable
      (fun u ↦ poissonNegDeriv r u * ∫ s in (0 : ℝ)..u, φ s) volume 0 Real.pi := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le Real.pi_pos.le]
    exact (hQ_cont.continuousOn.mul hΦ_cont).integrableOn_Icc
  have hQconst_ii : IntervalIntegrable
      (fun u ↦ poissonNegDeriv r u * ∫ s in (0 : ℝ)..u, (2 * M₀)) volume 0 Real.pi := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le Real.pi_pos.le]
    refine (hQ_cont.continuousOn.mul ?_).integrableOn_Icc
    have h : (fun u : ℝ ↦ ∫ _ in (0 : ℝ)..u, (2 * M₀)) = fun u : ℝ ↦ u * (2 * M₀) := by
      funext u; simp [smul_eq_mul]; ring
    rw [h]
    exact continuousOn_id.mul continuousOn_const
  have hint_le : (∫ s in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r s * φ s) ≤
      ∫ s in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r s * (2 * M₀) := by
    rw [hibp_φ, hibp_const]
    refine add_le_add
      (mul_le_mul_of_nonneg_left (hΦ_le Real.pi ⟨Real.pi_pos.le, le_rfl⟩)
        (RudinRCA.Chapter11.node11_5_pos hr0 hr1 Real.pi).le)
      (intervalIntegral.integral_mono_on Real.pi_pos.le hQΦ_ii hQconst_ii fun u hu ↦
        mul_le_mul_of_nonneg_left (hΦ_le u hu) (hQ_nn u hu))
  have hhalf : ∫ u in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r u = Real.pi := by
    have hfull := (RudinRCA.Chapter11.node11_5_integral_eq_one hr0 hr1).1
    have hsplit := intervalIntegral.integral_add_adjacent_intervals
      (hP_cont.intervalIntegrable (μ := volume) (-Real.pi) 0)
      (hP_cont.intervalIntegrable (μ := volume) 0 Real.pi)
    have hneg : (∫ u in (-Real.pi)..(0 : ℝ), RudinRCA.Chapter11.poissonKernel r u) =
        ∫ u in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r u := by
      have hc := intervalIntegral.integral_comp_neg (RudinRCA.Chapter11.poissonKernel r)
        (a := 0) (b := Real.pi)
      simp only [neg_zero, RudinRCA.Chapter11.node11_5_even] at hc
      exact hc.symm
    rw [← hsplit, hneg] at hfull
    have hsum := ((inv_mul_eq_one₀ Real.two_pi_pos.ne').mp hfull).symm
    linarith
  have hconst_eval : (∫ s in (0 : ℝ)..Real.pi,
      RudinRCA.Chapter11.poissonKernel r s * (2 * M₀)) = 2 * Real.pi * M₀ := by
    rw [intervalIntegral.integral_mul_const, hhalf]; ring
  rw [hsym_int]
  have hle_2pi : (∫ s in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r s * φ s) ≤
      2 * Real.pi * M₀ := hint_le.trans_eq hconst_eval
  calc (2 * Real.pi)⁻¹ * ∫ s in (0 : ℝ)..Real.pi, RudinRCA.Chapter11.poissonKernel r s * φ s
      ≤ (2 * Real.pi)⁻¹ * (2 * Real.pi * M₀) :=
        mul_le_mul_of_nonneg_left hle_2pi (inv_nonneg.mpr Real.two_pi_pos.le)
    _ = M₀ := inv_mul_cancel_left₀ Real.two_pi_pos.ne' M₀

/-- Nontangential maximal `L^2` bound for `h ∈ H^2` (`0 < α < 1`). -/
private theorem h2_nontangentialMaximal_memLp {h : ℂ → ℂ} (hh : IsInHardySpace 2 h)
    {α : ℝ} (hα0 : 0 < α) (hα1 : α < 1) :
    (∀ᵐ ζ ∂circleMeasure, nontangentialMaximalENNReal α h ζ < ⊤) ∧
      MemLp (nontangentialMaximal α h) 2 circleMeasure ∧
      ∫⁻ ζ, nontangentialMaximalENNReal α h ζ ^ (2 : ℝ) ∂circleMeasure < ⊤ := by
  obtain ⟨_, _, hh_memLp, _, _, hh_poisson, _⟩ := (h2_powerSeries_and_boundary hh.2.1).2.2 hh
  let G : FourierCircle → ℝ := fun ζ ↦ ‖radialBoundaryLimit h ζ‖
  have hG_nn : ∀ ζ, 0 ≤ G ζ := fun _ ↦ norm_nonneg _
  have hG_memLp : MemLp G 2 circleMeasure := hh_memLp.norm
  have hG_int : Integrable G circleMeasure :=
    hG_memLp.integrable (by norm_num : (1 : ℝ≥0∞) ≤ 2)
  let g_cut : ℝ → ℂ :=
    Set.indicator (Set.Icc (-2 * Real.pi) (2 * Real.pi)) (fun t ↦ (G (t : FourierCircle) : ℂ))
  -- Show `MemLp g_cut (ENNReal.ofReal 2) volume`
  have hg_cut_aem : AEStronglyMeasurable g_cut volume := by
    refine AEStronglyMeasurable.indicator ?_ measurableSet_Icc
    exact Complex.continuous_ofReal.comp_aestronglyMeasurable
      (locallyIntegrable_coe_of_integrable_circleMeasure hG_int).aestronglyMeasurable
  have hg_cut_memLp : MemLp g_cut (ENNReal.ofReal 2) volume := by
    rw [memLp_iff, eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top
      (by norm_num) ENNReal.ofReal_ne_top hg_cut_aem, ENNReal.toReal_ofReal (by norm_num)]
    have hG_lint_lt : ∫⁻ ζ, ‖G ζ‖ₑ ^ (2 : ℝ) ∂circleMeasure < ⊤ := by
      have hlt := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top
        (by norm_num : (2 : ℝ≥0∞) ≠ 0) (by norm_num : (2 : ℝ≥0∞) ≠ ⊤) hG_memLp.eLpNorm_lt_top
      simpa using hlt
    have hsplit_supp : (∫⁻ t, ‖g_cut t‖ₑ ^ (2 : ℝ) ∂volume) =
        (∫⁻ t in Set.Ioc (-2 * Real.pi) (-2 * Real.pi + 2 * Real.pi),
          ‖G (t : FourierCircle)‖ₑ ^ (2 : ℝ) ∂volume) +
        (∫⁻ t in Set.Ioc (0 : ℝ) (0 + 2 * Real.pi),
          ‖G (t : FourierCircle)‖ₑ ^ (2 : ℝ) ∂volume) := by
      have hae_eq : (fun t : ℝ ↦ ‖g_cut t‖ₑ ^ (2 : ℝ)) =ᵐ[volume]
          Set.indicator (Set.Ioc (-2 * Real.pi) 0 ∪ Set.Ioc 0 (2 * Real.pi))
            (fun t : ℝ ↦ ‖G (t : FourierCircle)‖ₑ ^ (2 : ℝ)) := by
        have hsing : ({-2 * Real.pi} : Set ℝ)ᶜ ∈ ae volume :=
          compl_mem_ae_iff.mpr (Real.volume_singleton (a := -2 * Real.pi))
        filter_upwards [hsing] with t ht
        have hmem_iff : t ∈ Set.Icc (-2 * Real.pi) (2 * Real.pi) ↔
            t ∈ Set.Ioc (-2 * Real.pi) 0 ∪ Set.Ioc 0 (2 * Real.pi) := by
          simp only [Set.mem_Icc, Set.mem_union, Set.mem_Ioc]
          have hne : t ≠ -2 * Real.pi := ht
          constructor
          · rintro ⟨h1, h2⟩
            have h1' : -2 * Real.pi < t := lt_of_le_of_ne h1 (Ne.symm hne)
            rcases le_or_gt t 0 with ht0 | ht0
            · exact Or.inl ⟨h1', ht0⟩
            · exact Or.inr ⟨ht0, h2⟩
          · rintro (⟨h1, h2⟩ | ⟨h1, h2⟩)
            · exact ⟨h1.le, h2.trans (by positivity)⟩
            · exact ⟨(by linarith [Real.pi_pos] : -2 * Real.pi ≤ 0).trans h1.le, h2⟩
        by_cases hm : t ∈ Set.Icc (-2 * Real.pi) (2 * Real.pi)
        · have hm' : t ∈ Set.Ioc (-2 * Real.pi) 0 ∪ Set.Ioc 0 (2 * Real.pi) := hmem_iff.mp hm
          dsimp only [g_cut]
          rw [Set.indicator_of_mem hm, Set.indicator_of_mem hm', ← ofReal_norm, ← ofReal_norm,
            Complex.norm_real]
        · have hm' : t ∉ Set.Ioc (-2 * Real.pi) 0 ∪ Set.Ioc 0 (2 * Real.pi) :=
            fun h ↦ hm (hmem_iff.mpr h)
          dsimp only [g_cut]
          rw [Set.indicator_of_notMem hm, Set.indicator_of_notMem hm', enorm_zero,
            ENNReal.zero_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
      have hdisj : Disjoint (Set.Ioc (-2 * Real.pi) 0) (Set.Ioc 0 (2 * Real.pi)) :=
        Set.disjoint_left.mpr fun t ht1 ht2 ↦ lt_irrefl (0 : ℝ) (ht2.1.trans_le ht1.2)
      rw [lintegral_congr_ae hae_eq,
        lintegral_indicator (measurableSet_Ioc.union measurableSet_Ioc),
        lintegral_union measurableSet_Ioc hdisj,
        show -2 * Real.pi + 2 * Real.pi = (0 : ℝ) by ring,
        show (0 : ℝ) + 2 * Real.pi = 2 * Real.pi by ring]
    rw [hsplit_supp,
      ← lintegral_circleMeasure_eq_Ioc (-2 * Real.pi) (fun ζ ↦ ‖G ζ‖ₑ ^ (2 : ℝ)),
      ← lintegral_circleMeasure_eq_Ioc 0 (fun ζ ↦ ‖G ζ‖ₑ ^ (2 : ℝ))]
    exact ENNReal.add_lt_top.mpr
      ⟨ENNReal.mul_lt_top ENNReal.ofReal_lt_top hG_lint_lt,
        ENNReal.mul_lt_top ENNReal.ofReal_lt_top hG_lint_lt⟩
  -- Apply Hardy–Littlewood `L^2` maximal theorem on `ℝ` (`Chapter08.theorem_8_18`)
  obtain ⟨hmax_ae, hmax_memLp⟩ :=
    RudinRCA.Chapter08.theorem_8_18 volume (by norm_num : (1 : ℝ) < 2) hg_cut_memLp
  have hmax_lint_lt : ∫⁻ θ₀, RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ ^ (2 : ℝ) ∂volume < ⊤ := by
    have hlt := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top
      (by norm_num) ENNReal.ofReal_ne_top hmax_memLp.eLpNorm_lt_top
    rw [ENNReal.toReal_ofReal (by norm_num)] at hlt
    have hcongr : (∫⁻ θ₀, ‖(RudinRCA.Chapter08.maximalFunction volume g_cut θ₀).toReal‖ₑ ^ (2 : ℝ) ∂volume) =
        ∫⁻ θ₀, RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ ^ (2 : ℝ) ∂volume := by
      refine lintegral_congr_ae ?_
      filter_upwards [hmax_ae] with θ₀ hθ₀
      rw [Real.enorm_toReal hθ₀.ne]
    rwa [← hcongr]
  -- Pointwise domination on `[-π, π]`: `N_α h (θ₀ : FourierCircle) ≤ (1 + K_α)^2 * M g_cut (θ₀)`
  let C_α : ℝ := (1 + stolzConeConst α) ^ 2
  have hnt_le_max : ∀ θ₀ ∈ Set.Icc (-Real.pi) Real.pi,
      nontangentialMaximalENNReal α h (θ₀ : FourierCircle) ≤
        ENNReal.ofReal C_α * RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ := by
    intro θ₀ hθ₀
    refine iSup₂_le fun z hz ↦ ?_
    obtain ⟨θ, hz_eq, hθ_cone⟩ := stolzRegion_polar_cone hα0 hα1 θ₀ hz
    let r : ℝ := ‖z‖
    have hr0 : 0 ≤ r := norm_nonneg z
    have hr1 : r < 1 := by simpa [r, Metric.mem_ball] using stolzRegion_subset_ball α _ hz
    have hz_ball : z ∈ Metric.ball (0 : ℂ) 1 := stolzRegion_subset_ball α _ hz
    have hfz_norm : ‖h z‖ ≤ C_α * ((2 * Real.pi)⁻¹ *
        ∫ t in (-Real.pi)..Real.pi,
          RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * G (t : FourierCircle)) := by
      rw [hh_poisson z hz_ball, hz_eq,
        poissonIntegral_circleMeasure_eq_interval (radialBoundaryLimit h) hr0 θ, norm_smul,
        Real.norm_eq_abs, abs_of_pos (inv_pos.mpr Real.two_pi_pos)]
      have hPK_int : IntervalIntegrable
          (fun t : ℝ ↦ RudinRCA.Chapter11.poissonKernel r (θ - t) * G (t : FourierCircle))
          volume (-Real.pi) Real.pi := by
        have hcont : Continuous (fun t : ℝ ↦ RudinRCA.Chapter11.poissonKernel r (θ - t)) :=
          (RudinRCA.Chapter11.continuous_poissonKernel hr0 hr1).comp (by fun_prop)
        exact ((integrable_circleMeasure_iff_intervalIntegrable G).mp hG_int).continuousOn_mul
          hcont.continuousOn
      have hPK0_int : IntervalIntegrable
          (fun t : ℝ ↦ C_α * (RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * G (t : FourierCircle)))
          volume (-Real.pi) Real.pi := by
        have hcont0 : Continuous (fun t : ℝ ↦ RudinRCA.Chapter11.poissonKernel r (θ₀ - t)) :=
          (RudinRCA.Chapter11.continuous_poissonKernel hr0 hr1).comp (by fun_prop)
        exact (((integrable_circleMeasure_iff_intervalIntegrable G).mp hG_int).continuousOn_mul
          hcont0.continuousOn).const_mul C_α
      have h1 : ‖∫ t in (-Real.pi)..Real.pi,
          RudinRCA.Chapter11.poissonKernel r (θ - t) • radialBoundaryLimit h (t : FourierCircle)‖ ≤
          ∫ t in (-Real.pi)..Real.pi,
            RudinRCA.Chapter11.poissonKernel r (θ - t) * G (t : FourierCircle) := by
        refine (intervalIntegral.norm_integral_le_integral_norm
          (by linarith [Real.pi_pos])).trans (le_of_eq ?_)
        refine intervalIntegral.integral_congr fun t _ ↦ ?_
        rw [norm_smul, Real.norm_eq_abs,
          abs_of_pos (RudinRCA.Chapter11.node11_5_pos hr0 hr1 (θ - t))]
      have h2 : (∫ t in (-Real.pi)..Real.pi,
          RudinRCA.Chapter11.poissonKernel r (θ - t) * G (t : FourierCircle)) ≤
          C_α * ∫ t in (-Real.pi)..Real.pi,
            RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * G (t : FourierCircle) := by
        rw [← intervalIntegral.integral_const_mul]
        refine intervalIntegral.integral_mono_on (by linarith [Real.pi_pos]) hPK_int hPK0_int
          fun t _ ↦ ?_
        rw [← mul_assoc]
        refine mul_le_mul_of_nonneg_right ?_ (hG_nn _)
        have hnt := RudinRCA.Chapter15.poissonKernel_nontangential_le' hr0 hr1
          (stolzConeConst_nonneg α) hθ_cone (t - θ₀)
        rw [show (θ - θ₀) - (t - θ₀) = θ - t by ring,
          ← RudinRCA.Chapter11.node11_5_even r (t - θ₀),
          show -(t - θ₀) = θ₀ - t by ring] at hnt
        exact hnt
      calc (2 * Real.pi)⁻¹ *
            ‖∫ t in (-Real.pi)..Real.pi,
              RudinRCA.Chapter11.poissonKernel r (θ - t) • radialBoundaryLimit h (t : FourierCircle)‖
          ≤ (2 * Real.pi)⁻¹ *
              (C_α * ∫ t in (-Real.pi)..Real.pi,
                RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * G (t : FourierCircle)) :=
            mul_le_mul_of_nonneg_left (h1.trans h2) (inv_nonneg.mpr Real.two_pi_pos.le)
        _ = C_α * ((2 * Real.pi)⁻¹ * ∫ t in (-Real.pi)..Real.pi,
              RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * G (t : FourierCircle)) := by ring
    calc ‖h z‖ₑ = ENNReal.ofReal ‖h z‖ := (ofReal_norm _).symm
      _ ≤ ENNReal.ofReal (C_α * ((2 * Real.pi)⁻¹ *
            ∫ t in (-Real.pi)..Real.pi,
              RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * G (t : FourierCircle))) :=
          ENNReal.ofReal_le_ofReal hfz_norm
      _ = ENNReal.ofReal C_α * ENNReal.ofReal ((2 * Real.pi)⁻¹ *
            ∫ t in (-Real.pi)..Real.pi,
              RudinRCA.Chapter11.poissonKernel r (θ₀ - t) * G (t : FourierCircle)) :=
          ENNReal.ofReal_mul (by positivity)
      _ ≤ ENNReal.ofReal C_α * RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ := by
          gcongr
          exact poissonIntegral_radial_le_maximal_cutoff hG_int hG_nn hr0 hr1 hθ₀
  -- Deduce `∫⁻ ζ, (N_α h ζ)^2 ∂circleMeasure < ⊤`
  have hN_lint_lt : ∫⁻ ζ, nontangentialMaximalENNReal α h ζ ^ (2 : ℝ) ∂circleMeasure < ⊤ := by
    have hmul_eq := lintegral_circleMeasure_eq_Ioc (-Real.pi)
      (fun ζ ↦ nontangentialMaximalENNReal α h ζ ^ (2 : ℝ))
    have hIoc_lt : (∫⁻ θ₀ in Set.Ioc (-Real.pi) (-Real.pi + 2 * Real.pi),
        nontangentialMaximalENNReal α h (θ₀ : FourierCircle) ^ (2 : ℝ) ∂volume) < ⊤ := by
      have hmono : (∫⁻ θ₀ in Set.Ioc (-Real.pi) (-Real.pi + 2 * Real.pi),
          nontangentialMaximalENNReal α h (θ₀ : FourierCircle) ^ (2 : ℝ) ∂volume) ≤
          ∫⁻ θ₀ in Set.Ioc (-Real.pi) (-Real.pi + 2 * Real.pi),
            (ENNReal.ofReal C_α ^ (2 : ℝ) *
              RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ ^ (2 : ℝ)) ∂volume := by
        refine setLIntegral_mono' measurableSet_Ioc fun θ₀ hθ₀ ↦ ?_
        have hIcc : θ₀ ∈ Set.Icc (-Real.pi) Real.pi :=
          ⟨hθ₀.1.le, by linarith [hθ₀.2]⟩
        calc nontangentialMaximalENNReal α h (θ₀ : FourierCircle) ^ (2 : ℝ)
            ≤ (ENNReal.ofReal C_α * RudinRCA.Chapter08.maximalFunction volume g_cut θ₀) ^ (2 : ℝ) :=
              ENNReal.rpow_le_rpow (hnt_le_max θ₀ hIcc) (by norm_num)
          _ = ENNReal.ofReal C_α ^ (2 : ℝ) *
                RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ ^ (2 : ℝ) :=
              ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
      have hm_meas : Measurable
          (fun θ₀ ↦ RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ ^ (2 : ℝ)) :=
        (RudinRCA.Chapter08.maximalFunction_measurable volume hg_cut_aem).pow_const 2
      calc (∫⁻ θ₀ in Set.Ioc (-Real.pi) (-Real.pi + 2 * Real.pi),
            nontangentialMaximalENNReal α h (θ₀ : FourierCircle) ^ (2 : ℝ) ∂volume)
          ≤ ∫⁻ θ₀, ENNReal.ofReal C_α ^ (2 : ℝ) *
              RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ ^ (2 : ℝ) ∂volume :=
            hmono.trans (setLIntegral_le_lintegral _ _)
        _ = ENNReal.ofReal C_α ^ (2 : ℝ) *
              ∫⁻ θ₀, RudinRCA.Chapter08.maximalFunction volume g_cut θ₀ ^ (2 : ℝ) ∂volume :=
            lintegral_const_mul _ hm_meas
        _ < ⊤ := ENNReal.mul_lt_top
            (ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top) hmax_lint_lt
    rw [← hmul_eq] at hIoc_lt
    by_contra htop
    rw [not_lt, top_le_iff] at htop
    rw [htop, ENNReal.mul_top (ENNReal.ofReal_ne_zero_iff.mpr Real.two_pi_pos)] at hIoc_lt
    exact lt_irrefl ⊤ hIoc_lt
  have hN_meas := measurable_nontangentialMaximalENNReal hα0 hα1 h
  have hae_fin : ∀ᵐ ζ ∂circleMeasure, nontangentialMaximalENNReal α h ζ < ⊤ := by
    filter_upwards [ae_lt_top (hN_meas.pow_const (2 : ℝ)) hN_lint_lt.ne] with ζ hζ
    exact (ENNReal.rpow_lt_top_iff_of_pos (by norm_num : (0 : ℝ) < 2)).mp hζ
  have hmemLp_N : MemLp (nontangentialMaximal α h) 2 circleMeasure := by
    have hae_sm : AEStronglyMeasurable (nontangentialMaximal α h) circleMeasure :=
      (measurable_nontangentialMaximal hα0 hα1 h).aestronglyMeasurable
    rw [memLp_iff, eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top
      (by norm_num) (by norm_num) hae_sm, ENNReal.toReal_ofNat]
    have hcongr : (∫⁻ ζ, ‖nontangentialMaximal α h ζ‖ₑ ^ (2 : ℝ) ∂circleMeasure) =
        ∫⁻ ζ, nontangentialMaximalENNReal α h ζ ^ (2 : ℝ) ∂circleMeasure := by
      refine lintegral_congr_ae ?_
      filter_upwards [hae_fin] with ζ hζ
      rw [nontangentialMaximal, Real.enorm_toReal hζ.ne]
    rwa [hcongr]
  exact ⟨hae_fin, hmemLp_N, hN_lint_lt⟩

/-- Zero-free functions in `H^2` have a.e. nonvanishing radial boundary values
(via harmonic mean value property of `log ‖h‖` and Fatou's lemma on `posLog ‖w‖ - log ‖w‖`). -/
private theorem ae_radialBoundaryLimit_ne_zero_of_zero_free_h2 {h : ℂ → ℂ}
    (hh : IsInHardySpace 2 h) (hzero_free : ∀ z ∈ Metric.ball (0 : ℂ) 1, h z ≠ 0) :
    ∀ᵐ ζ ∂circleMeasure, radialBoundaryLimit h ζ ≠ 0 := by
  have hh_diff : DifferentiableOn ℂ h (Metric.ball (0 : ℂ) 1) :=
    (RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hh.2.1
  obtain ⟨L, hL_diff, hL_exp⟩ := RudinRCA.Chapter15.exists_holomorphic_log
    Metric.isOpen_ball isSimplyConnected_unitDisc hh_diff hzero_free
  have hlog_eq_re : ∀ z ∈ Metric.ball (0 : ℂ) 1, Real.log ‖h z‖ = (L z).re := by
    intro z hz
    rw [← hL_exp z hz, Complex.norm_exp, Real.log_exp]
  have hL_harm : RudinRCA.Chapter11.HarmonicOn (fun z ↦ (L z).re) (Metric.ball (0 : ℂ) 1) :=
    (RudinRCA.Chapter11.node11_4_holomorphic_harmonic Metric.isOpen_ball hL_diff).comp_clm
      Metric.isOpen_ball Complex.reCLM
  have hlog_mean : ∀ r : ℝ, 0 < r → r < 1 →
      ∫ ζ, Real.log ‖radialSlice h r ζ‖ ∂circleMeasure = Real.log ‖h 0‖ := by
    intro r hr0 hr1
    have hcongr : (fun ζ : FourierCircle ↦ Real.log ‖radialSlice h r ζ‖) =
        fun ζ : FourierCircle ↦ (fun z : ℂ ↦ (L z).re) (0 + (r : ℂ) * circlePoint ζ) := by
      funext ζ
      have hz_mem : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
        simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_pos hr0] using hr1
      simp [radialSlice, hlog_eq_re _ hz_mem]
    rw [hcongr, integral_circleMeasure_eq_circleAverage (fun z : ℂ ↦ (L z).re) 0 r,
      (RudinRCA.Chapter11.theorem11_12_real Metric.isOpen_ball hL_harm).1 hr0
        (Metric.closedBall_subset_ball hr1),
      ← hlog_eq_re 0 (Metric.mem_ball_self zero_lt_one)]
  let ψ : ℂ → ℝ≥0∞ := fun w ↦
    if w = 0 then ⊤ else ENNReal.ofReal (Real.posLog ‖w‖ - Real.log ‖w‖)
  have hψ_meas : Measurable ψ :=
    Measurable.ite (measurableSet_singleton 0) measurable_const
      (ENNReal.measurable_ofReal.comp
        ((Real.continuous_posLog.comp continuous_norm).measurable.sub
          (Real.measurable_log.comp continuous_norm.measurable)))
  have hψ_seq : ∀ (w_seq : ℕ → ℂ) (w : ℂ),
      Tendsto w_seq atTop (𝓝 w) → Tendsto (fun n : ℕ ↦ ψ (w_seq n)) atTop (𝓝 (ψ w)) := by
    intro w_seq w hw
    by_cases hw0 : w = 0
    · subst hw0
      have hψ0 : ψ 0 = ⊤ := by simp [ψ]
      rw [hψ0, tendsto_order]
      refine ⟨fun b hb ↦ ?_, fun _ hb ↦ (not_top_lt hb).elim⟩
      let B : ℝ := b.toReal + 1
      have hb_lt_B : b < ENNReal.ofReal B := by
        rw [← ENNReal.ofReal_toReal hb.ne]
        exact (ENNReal.ofReal_lt_ofReal_iff (by positivity)).mpr (by dsimp [B]; linarith)
      have hev_small : ∀ᶠ n in atTop, ‖w_seq n‖ < min 1 (Real.exp (-B)) := by
        have h0_lim : Tendsto (fun n ↦ ‖w_seq n‖) atTop (𝓝 0) := by simpa using hw.norm
        exact h0_lim.eventually (Iio_mem_nhds (lt_min zero_lt_one (Real.exp_pos (-B))))
      filter_upwards [hev_small] with n hn
      dsimp [ψ]
      split_ifs with hwn0
      · exact hb
      · have hpos_wn : 0 < ‖w_seq n‖ := norm_pos_iff.mpr hwn0
        have hle1 : |‖w_seq n‖| ≤ 1 := by
          rw [abs_of_pos hpos_wn]; exact (hn.trans_le (min_le_left _ _)).le
        have hposLog0 : Real.posLog ‖w_seq n‖ = 0 := (Real.posLog_eq_zero_iff _).mpr hle1
        have hlog_lt : Real.log ‖w_seq n‖ < -B := by
          calc Real.log ‖w_seq n‖ < Real.log (Real.exp (-B)) :=
                Real.log_lt_log hpos_wn (hn.trans_le (min_le_right _ _))
            _ = -B := Real.log_exp (-B)
        have hB_le : B ≤ Real.posLog ‖w_seq n‖ - Real.log ‖w_seq n‖ := by linarith
        exact lt_of_lt_of_le hb_lt_B (ENNReal.ofReal_le_ofReal hB_le)
    · have hψw : ψ w = ENNReal.ofReal (Real.posLog ‖w‖ - Real.log ‖w‖) := by simp [ψ, hw0]
      rw [hψw]
      have hlim : Tendsto
          (fun n : ℕ ↦ ENNReal.ofReal (Real.posLog ‖w_seq n‖ - Real.log ‖w_seq n‖))
          atTop (𝓝 (ENNReal.ofReal (Real.posLog ‖w‖ - Real.log ‖w‖))) :=
        ENNReal.continuous_ofReal.continuousAt.tendsto.comp
          (((Real.continuous_posLog.comp continuous_norm).continuousAt.tendsto.comp hw).sub
            ((Real.continuousAt_log (norm_ne_zero_iff.mpr hw0)).tendsto.comp hw.norm))
      refine hlim.congr' ?_
      filter_upwards [hw.eventually (isOpen_ne.mem_nhds hw0)] with n hwn
      simp [ψ, hwn]
  let r_seq : ℕ → ℝ := fun n ↦ 1 - 1 / ((n : ℝ) + 2)
  have hr_Ioo : ∀ n : ℕ, r_seq n ∈ Set.Ioo (0 : ℝ) 1 := fun n ↦ by
    dsimp [r_seq]
    have hn : (1 : ℝ) < (n : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) n]
    exact ⟨by linarith [div_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2) |>.mpr hn],
      by linarith [div_pos zero_lt_one (by positivity : (0 : ℝ) < (n : ℝ) + 2)]⟩
  have hr_lt1 : Tendsto r_seq atTop (𝓝[<] 1) := by
    refine tendsto_nhdsWithin_iff.mpr ⟨?_, Eventually.of_forall fun n ↦ (hr_Ioo n).2⟩
    have hdiv : Tendsto (fun n : ℕ ↦ (1 : ℝ) / ((n : ℝ) + 2)) atTop (𝓝 0) :=
      tendsto_const_nhds.div_atTop
        ((tendsto_natCast_atTop_atTop (R := ℝ)).atTop_add tendsto_const_nhds)
    simpa [r_seq] using (tendsto_const_nhds (x := (1 : ℝ))).sub hdiv
  have hf1 : IsInHardySpace 1 h := hh.mono_exponent one_ne_zero (by norm_num)
  have hlint_bound : ∀ n : ℕ,
      ∫⁻ ζ, ψ (radialSlice h (r_seq n) ζ) ∂circleMeasure ≤
        ENNReal.ofReal (hardySize 1 h - Real.log ‖h 0‖) := by
    intro n
    let r := r_seq n
    have hr0 : 0 < r := (hr_Ioo n).1
    have hr1 : r < 1 := (hr_Ioo n).2
    have hcont : Continuous (radialSlice h r) :=
      continuous_radialSlice_of_holomorphicOn hh.2.1 hr0.le hr1
    have hnz : ∀ ζ : FourierCircle, radialSlice h r ζ ≠ 0 := by
      intro ζ
      dsimp [radialSlice]
      refine hzero_free _ ?_
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_pos hr0] using hr1
    let g_diff : FourierCircle → ℝ :=
      fun ζ ↦ Real.posLog ‖radialSlice h r ζ‖ - Real.log ‖radialSlice h r ζ‖
    have hg_cont : Continuous g_diff :=
      (Real.continuous_posLog.comp hcont.norm).sub
        (hcont.norm.log fun ζ ↦ norm_ne_zero_iff.mpr (hnz ζ))
    have hg_nn : ∀ ζ, 0 ≤ g_diff ζ := fun ζ ↦
      sub_nonneg.mpr (by rw [Real.posLog_apply]; exact le_max_right 0 _)
    have hψ_eq : (fun ζ ↦ ψ (radialSlice h r ζ)) = fun ζ ↦ ENNReal.ofReal (g_diff ζ) := by
      funext ζ; simp [ψ, hnz ζ, g_diff]
    rw [hψ_eq, ← ofReal_integral_eq_lintegral_ofReal
      (hg_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
      (ae_of_all _ hg_nn)]
    refine ENNReal.ofReal_le_ofReal ?_
    have hpos_int : Integrable (fun ζ ↦ Real.posLog ‖radialSlice h r ζ‖) circleMeasure :=
      (Real.continuous_posLog.comp hcont.norm).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hlog_int : Integrable (fun ζ ↦ Real.log ‖radialSlice h r ζ‖) circleMeasure :=
      (hcont.norm.log fun ζ ↦ norm_ne_zero_iff.mpr (hnz ζ)).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hnorm_int : Integrable (fun ζ ↦ ‖radialSlice h r ζ‖) circleMeasure :=
      hcont.norm.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    have hint_sub : ∫ ζ, g_diff ζ ∂circleMeasure =
        (∫ ζ, Real.posLog ‖radialSlice h r ζ‖ ∂circleMeasure) - Real.log ‖h 0‖ := by
      dsimp [g_diff]
      rw [integral_sub hpos_int hlog_int, hlog_mean r hr0 hr1]
    rw [hint_sub]
    have hpos_le_norm : ∫ ζ, Real.posLog ‖radialSlice h r ζ‖ ∂circleMeasure ≤
        ∫ ζ, ‖radialSlice h r ζ‖ ∂circleMeasure :=
      integral_mono hpos_int hnorm_int fun ζ ↦ by
        simpa using mul_posLog_le_rpow (σ := 1) (norm_nonneg (radialSlice h r ζ))
    have hnorm_eq_rad : ENNReal.ofReal (∫ ζ, ‖radialSlice h r ζ‖ ∂circleMeasure) =
        radialSizeENNReal 1 h r := by
      unfold radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h0 ↦ (one_ne_zero h0).elim,
        (memLp_radialSlice_of_continuous hcont 1).eLpNorm_eq_integral_rpow_norm
          one_ne_zero ENNReal.one_ne_top]
      simp
    have hrad_le : ∫ ζ, ‖radialSlice h r ζ‖ ∂circleMeasure ≤ hardySize 1 h :=
      (ENNReal.ofReal_le_iff_le_toReal hf1.2.2.ne).mp
        (hnorm_eq_rad.trans_le
          (le_biSup (radialSizeENNReal 1 h) (⟨hr0.le, hr1⟩ : r ∈ Set.Ico (0 : ℝ) 1)))
    linarith
  have hae_rad := (h2_powerSeries_and_boundary hh.2.1).2.2 hh |>.2.1
  have hae_liminf : ∀ᵐ ζ ∂circleMeasure,
      ψ (radialBoundaryLimit h ζ) ≤
        Filter.liminf (fun n : ℕ ↦ ψ (radialSlice h (r_seq n) ζ)) atTop := by
    filter_upwards [hae_rad] with ζ ⟨_, hrad⟩
    exact le_of_eq (hψ_seq _ _ (hrad.comp hr_lt1)).liminf_eq.symm
  have hmeas_seq : ∀ n : ℕ, AEMeasurable (fun ζ ↦ ψ (radialSlice h (r_seq n) ζ)) circleMeasure :=
    fun n ↦ (hψ_meas.comp
      (continuous_radialSlice_of_holomorphicOn hh.2.1 (hr_Ioo n).1.le (hr_Ioo n).2).measurable).aemeasurable
  have hfatou : ∫⁻ ζ, ψ (radialBoundaryLimit h ζ) ∂circleMeasure < ⊤ := by
    calc ∫⁻ ζ, ψ (radialBoundaryLimit h ζ) ∂circleMeasure
        ≤ ∫⁻ ζ, Filter.liminf (fun n : ℕ ↦ ψ (radialSlice h (r_seq n) ζ)) atTop ∂circleMeasure :=
          lintegral_mono_ae hae_liminf
      _ ≤ Filter.liminf (fun n : ℕ ↦ ∫⁻ ζ, ψ (radialSlice h (r_seq n) ζ) ∂circleMeasure) atTop :=
          lintegral_liminf_le' hmeas_seq
      _ ≤ ENNReal.ofReal (hardySize 1 h - Real.log ‖h 0‖) := by
          refine liminf_le_of_frequently_le' (Frequently.of_forall hlint_bound)
      _ < ⊤ := ENNReal.ofReal_lt_top
  have hbd_aem : AEMeasurable (fun ζ ↦ ψ (radialBoundaryLimit h ζ)) circleMeasure :=
    hψ_meas.comp_aemeasurable
      ((h2_powerSeries_and_boundary hh.2.1).2.2 hh).2.2.1.aestronglyMeasurable.aemeasurable
  filter_upwards [ae_lt_top' hbd_aem hfatou.ne] with ζ hζ h0
  simp [ψ, h0] at hζ

/-- Helper for passing `R → 1⁻` in integral representations `∫ K_R * F_R` when `K_R → K₀`
uniformly on `FourierCircle` and `F_R → F₀` in `L^1(circleMeasure)`. -/
private theorem tendsto_integral_kernel_mul_of_L1_tendsto
    {K : ℝ → FourierCircle → ℂ} {K₀ : FourierCircle → ℂ}
    {F : ℝ → FourierCircle → ℂ} {F₀ : FourierCircle → ℂ}
    (hK_cont : ∀ᶠ R in 𝓝[<] (1 : ℝ), Continuous (K R))
    (hK₀_cont : Continuous K₀)
    (hK_unif : TendstoUniformly (fun R ζ ↦ K R ζ) K₀ (𝓝[<] (1 : ℝ)))
    (hF_int : ∀ᶠ R in 𝓝[<] (1 : ℝ), Integrable (F R) circleMeasure)
    (hF₀_int : Integrable F₀ circleMeasure)
    (hF_L1 : Tendsto (fun R : ℝ ↦ ∫ ζ, ‖F R ζ - F₀ ζ‖ ∂circleMeasure) (𝓝[<] (1 : ℝ)) (𝓝 0)) :
    Tendsto (fun R : ℝ ↦ ∫ ζ, K R ζ * F R ζ ∂circleMeasure) (𝓝[<] (1 : ℝ))
      (𝓝 (∫ ζ, K₀ ζ * F₀ ζ ∂circleMeasure)) := by
  rw [Metric.tendsto_nhds]
  intro ε hε
  obtain ⟨ζ_max, _, hK₀_max⟩ := isCompact_univ.exists_isMaxOn univ_nonempty hK₀_cont.norm.continuousOn
  let M_K : ℝ := ‖K₀ ζ_max‖ + 1
  have hMK_pos : 0 < M_K := by dsimp [M_K]; positivity
  have hK_close_1 : ∀ᶠ R in 𝓝[<] (1 : ℝ), ∀ ζ : FourierCircle, dist (K₀ ζ) (K R ζ) < 1 :=
    Metric.tendstoUniformly_iff.mp hK_unif 1 zero_lt_one
  have hF₀_norm_int : Integrable (fun ζ ↦ ‖F₀ ζ‖) circleMeasure := hF₀_int.norm
  let C_F : ℝ := (∫ ζ, ‖F₀ ζ‖ ∂circleMeasure) + 1
  have hCF_pos : 0 < C_F := by
    dsimp [C_F]
    have hnn : 0 ≤ ∫ ζ, ‖F₀ ζ‖ ∂circleMeasure := integral_nonneg fun _ ↦ norm_nonneg _
    linarith
  have hK_close_ε : ∀ᶠ R in 𝓝[<] (1 : ℝ),
      ∀ ζ : FourierCircle, dist (K₀ ζ) (K R ζ) < ε / (2 * C_F) :=
    Metric.tendstoUniformly_iff.mp hK_unif (ε / (2 * C_F)) (div_pos hε (by positivity))
  have hF_close_ε : ∀ᶠ R in 𝓝[<] (1 : ℝ),
      dist (∫ ζ, ‖F R ζ - F₀ ζ‖ ∂circleMeasure) 0 < ε / (2 * M_K) :=
    Metric.tendsto_nhds.mp hF_L1 (ε / (2 * M_K)) (div_pos hε (by positivity))
  filter_upwards [hK_cont, hF_int, hK_close_1, hK_close_ε, hF_close_ε] with
    R hKR_cont hFR_int hKR_1 hKR_ε hFR_ε
  have hKR_bdd : ∀ ζ : FourierCircle, ‖K R ζ‖ ≤ M_K := by
    intro ζ
    have h1 : ‖K R ζ - K₀ ζ‖ < 1 := by simpa [dist_eq_norm, norm_sub_rev] using hKR_1 ζ
    have h2 : ‖K₀ ζ‖ ≤ ‖K₀ ζ_max‖ := hK₀_max (mem_univ ζ)
    calc ‖K R ζ‖ = ‖(K R ζ - K₀ ζ) + K₀ ζ‖ := by ring_nf
      _ ≤ ‖K R ζ - K₀ ζ‖ + ‖K₀ ζ‖ := norm_add_le _ _
      _ ≤ 1 + ‖K₀ ζ_max‖ := by linarith
      _ = M_K := by dsimp [M_K]; ring
  have hint_KR_FR : Integrable (fun ζ ↦ K R ζ * F R ζ) circleMeasure :=
    hFR_int.bdd_mul hKR_cont.aestronglyMeasurable (Eventually.of_forall hKR_bdd)
  have hint_K0_F0 : Integrable (fun ζ ↦ K₀ ζ * F₀ ζ) circleMeasure :=
    hF₀_int.bdd_mul hK₀_cont.aestronglyMeasurable
      (Eventually.of_forall fun ζ ↦ hK₀_max (mem_univ ζ))
  have hdiff_int : (∫ ζ, K R ζ * F R ζ ∂circleMeasure) - (∫ ζ, K₀ ζ * F₀ ζ ∂circleMeasure) =
      ∫ ζ, (K R ζ * (F R ζ - F₀ ζ) + (K R ζ - K₀ ζ) * F₀ ζ) ∂circleMeasure := by
    rw [← integral_sub hint_KR_FR hint_K0_F0]
    exact integral_congr_ae (Eventually.of_forall fun ζ ↦ by ring)
  rw [dist_eq_norm, hdiff_int]
  have hnorm_sub_int : Integrable (fun ζ ↦ ‖F R ζ - F₀ ζ‖) circleMeasure :=
    (hFR_int.sub hF₀_int).norm
  have hmaj_int : Integrable
      (fun ζ ↦ M_K * ‖F R ζ - F₀ ζ‖ + (ε / (2 * C_F)) * ‖F₀ ζ‖) circleMeasure :=
    (hnorm_sub_int.const_mul M_K).add (hF₀_norm_int.const_mul _)
  have hpt_le : ∀ ζ : FourierCircle,
      ‖K R ζ * (F R ζ - F₀ ζ) + (K R ζ - K₀ ζ) * F₀ ζ‖ ≤
        M_K * ‖F R ζ - F₀ ζ‖ + (ε / (2 * C_F)) * ‖F₀ ζ‖ := by
    intro ζ
    have hk_lt : ‖K R ζ - K₀ ζ‖ ≤ ε / (2 * C_F) := by
      have h := (hKR_ε ζ).le
      rwa [dist_eq_norm, norm_sub_rev] at h
    calc ‖K R ζ * (F R ζ - F₀ ζ) + (K R ζ - K₀ ζ) * F₀ ζ‖
        ≤ ‖K R ζ * (F R ζ - F₀ ζ)‖ + ‖(K R ζ - K₀ ζ) * F₀ ζ‖ := norm_add_le _ _
      _ = ‖K R ζ‖ * ‖F R ζ - F₀ ζ‖ + ‖K R ζ - K₀ ζ‖ * ‖F₀ ζ‖ := by rw [norm_mul, norm_mul]
      _ ≤ M_K * ‖F R ζ - F₀ ζ‖ + (ε / (2 * C_F)) * ‖F₀ ζ‖ :=
          add_le_add (mul_le_mul_of_nonneg_right (hKR_bdd ζ) (norm_nonneg _))
            (mul_le_mul_of_nonneg_right hk_lt (norm_nonneg _))
  have hint_norm_le :
      ‖∫ ζ, (K R ζ * (F R ζ - F₀ ζ) + (K R ζ - K₀ ζ) * F₀ ζ) ∂circleMeasure‖ ≤
        M_K * (∫ ζ, ‖F R ζ - F₀ ζ‖ ∂circleMeasure) +
          (ε / (2 * C_F)) * (∫ ζ, ‖F₀ ζ‖ ∂circleMeasure) := by
    calc ‖∫ ζ, (K R ζ * (F R ζ - F₀ ζ) + (K R ζ - K₀ ζ) * F₀ ζ) ∂circleMeasure‖
        ≤ ∫ ζ, ‖K R ζ * (F R ζ - F₀ ζ) + (K R ζ - K₀ ζ) * F₀ ζ‖ ∂circleMeasure :=
          norm_integral_le_integral_norm _
      _ ≤ ∫ ζ, (M_K * ‖F R ζ - F₀ ζ‖ + (ε / (2 * C_F)) * ‖F₀ ζ‖) ∂circleMeasure :=
          integral_mono ((hint_KR_FR.sub hint_K0_F0).congr
            (Eventually.of_forall fun ζ ↦ by simp only [Pi.sub_apply]; ring)).norm hmaj_int hpt_le
      _ = M_K * (∫ ζ, ‖F R ζ - F₀ ζ‖ ∂circleMeasure) +
            (ε / (2 * C_F)) * (∫ ζ, ‖F₀ ζ‖ ∂circleMeasure) := by
          rw [integral_add (hnorm_sub_int.const_mul M_K) (hF₀_norm_int.const_mul _),
            integral_const_mul, integral_const_mul]
  have hterm1_lt : M_K * (∫ ζ, ‖F R ζ - F₀ ζ‖ ∂circleMeasure) < ε / 2 := by
    have hnn : 0 ≤ ∫ ζ, ‖F R ζ - F₀ ζ‖ ∂circleMeasure := integral_nonneg fun _ ↦ norm_nonneg _
    rw [Real.dist_eq, sub_zero, abs_of_nonneg hnn] at hFR_ε
    calc M_K * (∫ ζ, ‖F R ζ - F₀ ζ‖ ∂circleMeasure)
        < M_K * (ε / (2 * M_K)) := mul_lt_mul_of_pos_left hFR_ε hMK_pos
      _ = ε / 2 := by field_simp [hMK_pos.ne']
  have hterm2_lt : (ε / (2 * C_F)) * (∫ ζ, ‖F₀ ζ‖ ∂circleMeasure) < ε / 2 := by
    have hlt_CF : ∫ ζ, ‖F₀ ζ‖ ∂circleMeasure < C_F := by dsimp [C_F]; linarith
    calc (ε / (2 * C_F)) * (∫ ζ, ‖F₀ ζ‖ ∂circleMeasure)
        < (ε / (2 * C_F)) * C_F := mul_lt_mul_of_pos_left hlt_CF (div_pos hε (by positivity))
      _ = ε / 2 := by field_simp [hCF_pos.ne']
  linarith

/-- Cauchy integral representation on `circleMeasure` for a function holomorphic on a disc of
radius `ρ > 1`. -/
private theorem cauchy_representation_of_holomorphic_gt_one {g : ℂ → ℂ} {ρ : ℝ} (hρ : 1 < ρ)
    (hg : HolomorphicOn g (Metric.ball (0 : ℂ) ρ)) {w₀ : ℂ} (hw₀ : w₀ ∈ Metric.ball (0 : ℂ) 1) :
    g w₀ = ∫ ζ, (1 - w₀ * star (circlePoint ζ))⁻¹ * g (circlePoint ζ) ∂circleMeasure := by
  have hg_hol1 : HolomorphicOn g (Metric.ball (0 : ℂ) 1) :=
    fun z hz ↦ hg z (Metric.ball_subset_ball hρ.le hz)
  have hg_cont_cb : ContinuousOn g (Metric.closedBall (0 : ℂ) 1) :=
    (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hg).mono (Metric.closedBall_subset_ball hρ)
  obtain ⟨z_max, _, hmax⟩ := (isCompact_closedBall (0 : ℂ) 1).exists_isMaxOn
    ⟨0, Metric.mem_closedBall_self zero_le_one⟩ hg_cont_cb.norm
  have hg_top : IsInHardySpace ⊤ g := by
    refine ⟨ENNReal.top_ne_zero, hg_hol1, ?_⟩
    rw [hardySizeENNReal_top_eq_biSup hg_hol1]
    refine lt_of_le_of_lt (iSup₂_le fun z hz ↦ ?_) (ENNReal.ofReal_lt_top (r := ‖g z_max‖))
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hmax (Metric.ball_subset_closedBall hz))
  have hg_h2 : IsInHardySpace 2 g := hg_top.mono_exponent (by norm_num) le_top
  have hbd_eq : ∀ ζ : FourierCircle, radialBoundaryLimit g ζ = g (circlePoint ζ) := by
    intro ζ
    have htend : Tendsto (fun r : ℝ ↦ radialSlice g r ζ) (𝓝[<] 1) (𝓝 (g (circlePoint ζ))) := by
      have hmem_ρ : circlePoint ζ ∈ Metric.ball (0 : ℂ) ρ := by
        simpa [Metric.mem_ball] using hρ
      have hca_g : ContinuousAt g (circlePoint ζ) :=
        (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hg).continuousAt
          (Metric.isOpen_ball.mem_nhds hmem_ρ)
      have hca_r : ContinuousAt (fun r : ℝ ↦ g ((r : ℂ) * circlePoint ζ)) 1 := by
        have h1 : (((1 : ℝ) : ℂ) * circlePoint ζ) = circlePoint ζ := by simp
        exact ContinuousAt.comp (h1.symm ▸ hca_g)
          (Complex.continuous_ofReal.mul continuous_const).continuousAt
      have hval1 : g (((1 : ℝ) : ℂ) * circlePoint ζ) = g (circlePoint ζ) := by simp
      exact hval1 ▸ hca_r.tendsto.mono_left nhdsWithin_le_nhds
    exact htend.limUnder_eq
  have h12 := theorem17_12 hg_hol1
  let b : ℕ → ℂ := fun n ↦ iteratedDeriv n g 0 / (Nat.factorial n : ℂ)
  have hb_sum : HasSum (fun n : ℕ ↦ b n * w₀ ^ n) (g w₀) := h12.1 w₀ hw₀
  have hb_four : ∀ n : ℕ,
      ∫ ζ, g (circlePoint ζ) * star (circlePoint ζ ^ n) ∂circleMeasure = b n := by
    intro n
    have hf := (h12.2.2 hg_h2).2 (n : ℤ)
    simp only [Nat.cast_nonneg, ↓reduceIte, Int.toNat_natCast] at hf
    change _ = b n at hf
    rw [← hf]
    refine integral_congr_ae (Eventually.of_forall fun ζ ↦ ?_)
    dsimp only
    rw [hbd_eq ζ]
    congr 2
    obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
    rw [RudinRCA.Chapter04.trigMonomial_apply_real, circlePoint_coe, ← Complex.exp_nat_mul]
    congr 1; push_cast; ring
  have hw₀_lt : ‖w₀‖ < 1 := by simpa [Metric.mem_ball] using hw₀
  let T : ℕ → FourierCircle → ℂ := fun N ζ ↦
    ∑ n ∈ Finset.range N, (w₀ * star (circlePoint ζ)) ^ n * g (circlePoint ζ)
  have hg_circ_cont : Continuous (fun ζ : FourierCircle ↦ g (circlePoint ζ)) :=
    hg_cont_cb.comp_continuous continuous_circlePoint fun ζ ↦
      Metric.sphere_subset_closedBall (circlePoint_mem_sphere ζ)
  have hT_meas : ∀ N : ℕ, AEStronglyMeasurable (T N) circleMeasure := by
    intro N
    dsimp [T]
    refine Finset.aestronglyMeasurable_fun_sum _ fun n _ ↦ ?_
    have hc : Continuous (fun ζ : FourierCircle ↦
        (w₀ * star (circlePoint ζ)) ^ n * g (circlePoint ζ)) := by
      exact ((continuous_const.mul (continuous_star.comp continuous_circlePoint)).pow n).mul
        hg_circ_cont
    exact hc.aestronglyMeasurable
  have hT_lim : ∀ ζ : FourierCircle,
      Tendsto (fun N : ℕ ↦ T N ζ) atTop
        (𝓝 ((1 - w₀ * star (circlePoint ζ))⁻¹ * g (circlePoint ζ))) := by
    intro ζ
    have hnorm_lt : ‖w₀ * star (circlePoint ζ)‖ < 1 := by
      rw [norm_mul, norm_star, norm_circlePoint, mul_one]; exact hw₀_lt
    exact ((hasSum_geometric_of_norm_lt_one hnorm_lt).mul_right (g (circlePoint ζ))).tendsto_sum_nat
  let M_g : ℝ := (1 - ‖w₀‖)⁻¹ * ‖g z_max‖
  have hT_bound : ∀ N : ℕ, ∀ᵐ ζ ∂circleMeasure, ‖T N ζ‖ ≤ M_g := by
    intro N
    refine Eventually.of_forall fun ζ ↦ ?_
    dsimp [T, M_g]
    have h1 : ‖∑ n ∈ Finset.range N, (w₀ * star (circlePoint ζ)) ^ n * g (circlePoint ζ)‖ ≤
        (∑ n ∈ Finset.range N, ‖w₀‖ ^ n) * ‖g (circlePoint ζ)‖ := by
      rw [Finset.sum_mul]
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun n _ ↦ ?_)
      rw [norm_mul, norm_pow, norm_mul, norm_star, norm_circlePoint, mul_one]
    have h2 : ∑ n ∈ Finset.range N, ‖w₀‖ ^ n ≤ (1 - ‖w₀‖)⁻¹ :=
      sum_le_hasSum (Finset.range N) (fun n _ ↦ pow_nonneg (norm_nonneg w₀) n)
        (hasSum_geometric_of_lt_one (norm_nonneg w₀) hw₀_lt)
    have h3 : ‖g (circlePoint ζ)‖ ≤ ‖g z_max‖ :=
      hmax (Metric.sphere_subset_closedBall (circlePoint_mem_sphere ζ))
    exact h1.trans (mul_le_mul h2 h3 (norm_nonneg _) (inv_nonneg.mpr (sub_nonneg.mpr hw₀_lt.le)))
  have hdom := tendsto_integral_of_dominated_convergence (fun _ ↦ M_g) hT_meas
    (integrable_const M_g) hT_bound (Eventually.of_forall hT_lim)
  have hT_eval : ∀ N : ℕ,
      ∫ ζ, T N ζ ∂circleMeasure = ∑ n ∈ Finset.range N, b n * w₀ ^ n := by
    intro N
    dsimp [T]
    rw [integral_finsetSum _ fun n _ ↦ by
      exact (((continuous_const.mul (continuous_star.comp continuous_circlePoint)).pow n).mul
        hg_circ_cont).integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)]
    refine Finset.sum_congr rfl fun n _ ↦ ?_
    have hrew : ∀ ζ : FourierCircle,
        (w₀ * star (circlePoint ζ)) ^ n * g (circlePoint ζ) =
          w₀ ^ n * (g (circlePoint ζ) * star (circlePoint ζ ^ n)) := by
      intro ζ; rw [mul_pow, star_pow]; ring
    have hcongr : (∫ ζ, (w₀ * star (circlePoint ζ)) ^ n * g (circlePoint ζ) ∂circleMeasure) =
        ∫ ζ, w₀ ^ n * (g (circlePoint ζ) * star (circlePoint ζ ^ n)) ∂circleMeasure :=
      integral_congr_ae (Eventually.of_forall hrew)
    change (∫ ζ, (w₀ * star (circlePoint ζ)) ^ n * g (circlePoint ζ) ∂circleMeasure) = _
    rw [hcongr, integral_const_mul, hb_four n, mul_comm]
  have hT_lim_g : Tendsto (fun N : ℕ ↦ ∫ ζ, T N ζ ∂circleMeasure) atTop (𝓝 (g w₀)) := by
    simp_rw [hT_eval]
    exact hb_sum.tendsto_sum_nat
  exact tendsto_nhds_unique hT_lim_g hdom

/-- **Theorem 17.11** (Rudin, *Real and Complex Analysis*, 3rd ed., pp. 340–341):
Let `0 < p < ∞` (`hp0 : p ≠ 0`, `hptop : p ≠ ⊤`) and `f ∈ H^p`. Then:
1. For every `0 < α < 1`, the nontangential maximal function `N_α f` is a.e. finite and belongs
   to `L^p(circleMeasure)`;
2. For almost every `ζ ∈ FourierCircle`, `f(z) → radialBoundaryLimit f ζ` as `z → circlePoint ζ`
   within `stolzRegion α ζ` for every `0 < α < 1` (and in particular radially as `r → 1⁻`);
3. `radialBoundaryLimit f ∈ L^p(circleMeasure)`,
   `eLpNorm (radialSlice f r - radialBoundaryLimit f) p circleMeasure → 0` as `r → 1⁻`, and
   `eLpNorm (radialBoundaryLimit f) p circleMeasure = hardySizeENNReal p f`;
4. If `1 ≤ p`, then for every `z ∈ Metric.ball 0 1`, `f(z)` is represented by both the Poisson
   integral and the Cauchy integral of `radialBoundaryLimit f` on `circleMeasure`. -/
theorem theorem17_11 {p : ℝ≥0∞} {f : ℂ → ℂ} (hp0 : p ≠ 0) (hptop : p ≠ ⊤)
    (hf : IsInHardySpace p f) :
    (∀ α : ℝ, 0 < α → α < 1 →
      (∀ᵐ ζ ∂circleMeasure, nontangentialMaximalENNReal α f ζ < ⊤) ∧
        MemLp (nontangentialMaximal α f) p circleMeasure) ∧
    (∀ᵐ ζ ∂circleMeasure,
      (∀ α : ℝ, 0 < α → α < 1 →
        Tendsto f (𝓝[stolzRegion α ζ] (circlePoint ζ)) (𝓝 (radialBoundaryLimit f ζ))) ∧
      Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
    MemLp (radialBoundaryLimit f) p circleMeasure ∧
    Tendsto
      (fun r : ℝ ↦ eLpNorm (radialSlice f r - radialBoundaryLimit f) p circleMeasure)
      (𝓝[<] 1) (𝓝 0) ∧
    eLpNorm (radialBoundaryLimit f) p circleMeasure = hardySizeENNReal p f ∧
    (1 ≤ p → ∀ z ∈ Metric.ball (0 : ℂ) 1,
      f z = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit f ζ
        ∂circleMeasure ∧
      f z = ∫ ζ, (1 - z * star (circlePoint ζ))⁻¹ • radialBoundaryLimit f ζ ∂circleMeasure ∧
      f z = ∫ ζ, (radialBoundaryLimit f ζ * circlePoint ζ) / (circlePoint ζ - z)
        ∂circleMeasure) := by
  let p_real : ℝ := p.toReal
  have hp_pos : 0 < p_real := ENNReal.toReal_pos hp0 hptop
  -- Step 1: Nontangential maximal `L^p` bound and a.e. nontangential convergence
  have hcore :
      (∀ α : ℝ, 0 < α → α < 1 →
        (∀ᵐ ζ ∂circleMeasure, nontangentialMaximalENNReal α f ζ < ⊤) ∧
          MemLp (nontangentialMaximal α f) p circleMeasure) ∧
      (∀ᵐ ζ ∂circleMeasure,
        (∀ α : ℝ, 0 < α → α < 1 →
          Tendsto f (𝓝[stolzRegion α ζ] (circlePoint ζ)) (𝓝 (radialBoundaryLimit f ζ))) ∧
        Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) := by
    by_cases hnonzero : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0
    · obtain ⟨B, h, L_h, hB, _, hh_h2, hh_zf, hLh_hol, hLh_exp, hf_fac, _⟩ :=
        theorem17_10 hp0 hptop hf hnonzero
      obtain ⟨hB_hol, hB_le1⟩ := isBlaschkeProduct_holomorphic_and_norm_le_one hB
      -- Part 1a: Nontangential maximal bound from `‖f z‖ ≤ ‖h z‖ ^ (2 / p_real)`
      have hmax_part : ∀ α : ℝ, 0 < α → α < 1 →
          (∀ᵐ ζ ∂circleMeasure, nontangentialMaximalENNReal α f ζ < ⊤) ∧
            MemLp (nontangentialMaximal α f) p circleMeasure := by
        intro α hα0 hα1
        obtain ⟨_, _, hh_lint_lt⟩ := h2_nontangentialMaximal_memLp hh_h2 hα0 hα1
        have h2divp_pos : 0 < 2 / p_real := div_pos (by norm_num) hp_pos
        have hN_le : ∀ ζ : FourierCircle,
            nontangentialMaximalENNReal α f ζ ≤
              nontangentialMaximalENNReal α h ζ ^ (2 / p_real) := by
          intro ζ
          refine iSup₂_le fun z hz ↦ ?_
          have hz_ball : z ∈ Metric.ball (0 : ℂ) 1 := stolzRegion_subset_ball α ζ hz
          have hnorm_le : ‖f z‖ ≤ ‖h z‖ ^ (2 / p_real) := by
            have hhz_norm : ‖h z‖ = Real.exp ((L_h z).re) := by
              rw [← hLh_exp z hz_ball, Complex.norm_exp]
            have hexp_pow : ‖Complex.exp (((2 / p_real : ℝ) : ℂ) * L_h z)‖ =
