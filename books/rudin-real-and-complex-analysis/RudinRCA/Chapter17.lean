    have hρ'_tend : Tendsto ρ' atTop (𝓝[<] 1) := hρ_tend.comp (tendsto_add_atTop_nat N₀)
    have h2M_memLp : MemLp (fun ζ ↦ 2 * M_dom ζ) p circleMeasure := hN_half_memLp.const_mul 2
    have h2M_rpow_int : Integrable (fun ζ ↦ ‖2 * M_dom ζ‖ ^ p_real) circleMeasure :=
      h2M_memLp.integrable_norm_rpow hp0 hptop
    let g_diff : ℕ → FourierCircle → ℝ := fun k ζ ↦
