    have hg_meas : ∀ k : ℕ, AEStronglyMeasurable (g_diff k) circleMeasure := by
      intro k
      have hsub_aem : AEStronglyMeasurable
          (radialSlice f (ρ' k) - radialBoundaryLimit f) circleMeasure :=
        (continuous_radialSlice_of_holomorphicOn hf.2.1
          (hρ'_Ioo k).1.le (hρ'_Ioo k).2).aestronglyMeasurable.sub hbd_aem
      exact (Real.continuous_rpow_const hp_pos.le).comp_aestronglyMeasurable hsub_aem.norm
    have hg_bound : ∀ k : ℕ, ∀ᵐ ζ ∂circleMeasure, ‖g_diff k ζ‖ ≤ ‖2 * M_dom ζ‖ ^ p_real := by
      intro k
      filter_upwards [hrad_le_M (ρ' k) ⟨(hρ'_Ioo k).1.le, (hρ'_Ioo k).2⟩, hbd_le_M] with
        ζ h1 h2
