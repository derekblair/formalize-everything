/-! ### Shared Circle Parameterization and Circle-Integral Bridges -/

/-- Embedding of the `2π`-periodic parameter circle `FourierCircle` into `ℂ` as the unit circle. -/
def circlePoint (ζ : RudinRCA.Chapter04.FourierCircle) : ℂ :=
  (RudinRCA.Chapter04.fourierCircleHomeomorphism ζ : ℂ)

@[simp]
theorem circlePoint_coe (t : ℝ) :
    circlePoint (t : FourierCircle) = Complex.exp ((t : ℂ) * Complex.I) :=
  RudinRCA.Chapter04.fourierCircleHomeomorphism_apply t

@[simp]
theorem circlePoint_zero : circlePoint 0 = 1 := by
  rw [← QuotientAddGroup.mk_zero, circlePoint_coe]
  simp

theorem continuous_circlePoint : Continuous circlePoint :=
  continuous_subtype_val.comp fourierCircleHomeomorphism.continuous

theorem circlePoint_mem_sphere (ζ : FourierCircle) :
    circlePoint ζ ∈ Metric.sphere (0 : ℂ) 1 :=
  (fourierCircleHomeomorphism ζ).2

@[simp]
theorem norm_circlePoint (ζ : FourierCircle) : ‖circlePoint ζ‖ = 1 := by
  simpa [Metric.mem_sphere] using circlePoint_mem_sphere ζ

theorem circlePoint_injective : Function.Injective circlePoint :=
  Subtype.val_injective.comp fourierCircleHomeomorphism.injective

theorem circlePoint_surjective_sphere {w : ℂ} (hw : w ∈ Metric.sphere (0 : ℂ) 1) :
    ∃ ζ : FourierCircle, circlePoint ζ = w :=
  ⟨fourierCircleHomeomorphism.symm ⟨w, hw⟩,
    congrArg Subtype.val (fourierCircleHomeomorphism.apply_symm_apply ⟨w, hw⟩)⟩

theorem circlePoint_add_pi (ζ : FourierCircle) :
    circlePoint (ζ + (Real.pi : FourierCircle)) = -circlePoint ζ := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ
  rw [← QuotientAddGroup.mk_add, circlePoint_coe, circlePoint_coe]
  push_cast
  rw [add_mul, Complex.exp_add, Complex.exp_pi_mul_I]
  ring

theorem affine_circlePoint_eq_circleMap (a : ℂ) (r t : ℝ) :
    a + (r : ℂ) * circlePoint (t : FourierCircle) = circleMap a r t := by
  rw [circlePoint_coe, circleMap]

theorem affine_circlePoint_mem_sphere (a : ℂ) {r : ℝ} (hr : 0 ≤ r) (ζ : FourierCircle) :
    a + (r : ℂ) * circlePoint ζ ∈ Metric.sphere a r := by
  rw [Metric.mem_sphere, dist_self_add_left, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg hr, norm_circlePoint, mul_one]

theorem affine_circlePoint_mem_closedBall (a : ℂ) {r : ℝ} (hr : 0 ≤ r) (ζ : FourierCircle) :
    a + (r : ℂ) * circlePoint ζ ∈ Metric.closedBall a r :=
  Metric.sphere_subset_closedBall (affine_circlePoint_mem_sphere a hr ζ)

theorem integral_circleMeasure_eq_circleAverage {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] (g : ℂ → E) (a : ℂ) (r : ℝ) :
    (∫ ζ, g (a + (r : ℂ) * circlePoint ζ) ∂circleMeasure) = Real.circleAverage g a r := by
  rw [RudinRCA.Chapter04.circleIntegral_interval,
    RudinRCA.Chapter11.circleAverage_eq_integral_neg_pi_pi]
  simp only [circlePoint_coe, one_div]

theorem integrable_circleMeasure_iff_intervalIntegrable {E : Type*}
    [NormedAddCommGroup E] (g : FourierCircle → E) :
    Integrable g circleMeasure ↔
      IntervalIntegrable (fun t : ℝ ↦ g (t : FourierCircle)) volume (-Real.pi) Real.pi := by
  have hT : (0 : ℝ) < 2 * Real.pi := by positivity
  have hvol : (volume : Measure FourierCircle) = ENNReal.ofReal (2 * Real.pi) • circleMeasure :=
    AddCircle.volume_eq_smul_haarAddCircle
  have hint_vol : Integrable g circleMeasure ↔ Integrable g (volume : Measure FourierCircle) := by
    rw [hvol]
    refine ⟨fun h ↦ h.smul_measure (by finiteness), fun h ↦ ?_⟩
    have h' := h.smul_measure (c := (ENNReal.ofReal (2 * Real.pi))⁻¹) (by finiteness)
    rwa [smul_smul, ENNReal.inv_mul_cancel (by positivity) (by finiteness), one_smul] at h'
  rw [hint_vol]
  have hlen : -Real.pi + 2 * Real.pi = Real.pi := by ring
  have hioc : IntervalIntegrable (fun t : ℝ ↦ g (t : FourierCircle)) volume (-Real.pi) Real.pi ↔
      IntegrableOn (fun t : ℝ ↦ g (t : FourierCircle))
        (Ioc (-Real.pi) (-Real.pi + 2 * Real.pi)) volume := by
    rw [hlen, intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith [Real.pi_pos])]
  rw [hioc]
  have hmp : MeasurePreserving ((↑) : ℝ → FourierCircle)
      (volume.restrict (Ioc (-Real.pi) (-Real.pi + 2 * Real.pi))) volume :=
    AddCircle.measurePreserving_mk (2 * Real.pi) (-Real.pi)
  let e := AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
  have hmp_sub : MeasurePreserving (Subtype.val ∘ e) volume
      (volume.restrict (Ioc (-Real.pi) (-Real.pi + 2 * Real.pi))) :=
    (measurePreserving_subtype_coe measurableSet_Ioc).comp
      (AddCircle.measurePreserving_equivIoc (2 * Real.pi) (a := -Real.pi))
  constructor
  · intro hg
    refine ⟨hg.aestronglyMeasurable.comp_quasiMeasurePreserving hmp.quasiMeasurePreserving, ?_⟩
    rw [HasFiniteIntegral, AddCircle.lintegral_preimage (2 * Real.pi) (-Real.pi) (fun z ↦ ‖g z‖ₑ)]
    exact hg.hasFiniteIntegral
  · intro hg
    refine ⟨(hg.1.comp_quasiMeasurePreserving hmp_sub.quasiMeasurePreserving).congr
      (Eventually.of_forall fun z ↦ congrArg g (e.left_inv z)), ?_⟩
    rw [HasFiniteIntegral,
      ← AddCircle.lintegral_preimage (2 * Real.pi) (-Real.pi) (fun z ↦ ‖g z‖ₑ)]
    exact hg.2

theorem integrable_affine_circlePoint_iff_circleIntegrable {E : Type*}
    [NormedAddCommGroup E] (g : ℂ → E) (a : ℂ) (r : ℝ) :
    Integrable (fun ζ ↦ g (a + (r : ℂ) * circlePoint ζ)) circleMeasure ↔
      CircleIntegrable g a r := by
  rw [integrable_circleMeasure_iff_intervalIntegrable]
  have hper : Function.Periodic (fun t : ℝ ↦ g (circleMap a r t)) (2 * Real.pi) :=
    fun t ↦ by dsimp only; rw [periodic_circleMap]
  have heq : (fun t : ℝ ↦ g (a + (r : ℂ) * circlePoint (t : FourierCircle))) =
      fun t : ℝ ↦ g (circleMap a r t) := by
    funext t
    rw [affine_circlePoint_eq_circleMap]
  rw [heq, CircleIntegrable]
  have h1 : -Real.pi + 2 * Real.pi = Real.pi := by ring
  have h2 : (0 : ℝ) + 2 * Real.pi = 2 * Real.pi := by ring
  have hp_iff := hper.intervalIntegrable_iff (t₁ := -Real.pi) (t₂ := 0)
  rwa [h1, h2] at hp_iff

theorem circleMeasure_singleton (ζ₀ : FourierCircle) : circleMeasure {ζ₀} = 0 := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ₀
  have hvol : (volume : Measure FourierCircle) {(t : FourierCircle)} = 0 := by
    rw [← (AddCircle.measurePreserving_mk (2 * Real.pi) (t - 1)).map_eq,
      Measure.map_apply AddCircle.measurable_mk' (measurableSet_singleton _),
      Measure.restrict_apply' measurableSet_Ioc]
    refine measure_mono_null (fun s hs ↦ ?_) (Real.volume_singleton (a := t))
    rcases hs with ⟨hs_mem, hs_Ioc⟩
    rw [mem_preimage, mem_singleton_iff] at hs_mem
    have ht_Ioc : t ∈ Ioc (t - 1) (t - 1 + 2 * Real.pi) :=
      ⟨by linarith, by linarith [Real.two_le_pi]⟩
    have heq_sub : AddCircle.equivIoc (2 * Real.pi) (t - 1) (s : FourierCircle) =
        AddCircle.equivIoc (2 * Real.pi) (t - 1) (t : FourierCircle) :=
      congrArg _ hs_mem
    rw [AddCircle.equivIoc_coe_eq hs_Ioc, AddCircle.equivIoc_coe_eq ht_Ioc] at heq_sub
    exact mem_singleton_iff.mpr (congrArg Subtype.val heq_sub)
  rw [AddCircle.volume_eq_smul_haarAddCircle, Measure.smul_apply, smul_eq_mul,
    mul_eq_zero] at hvol
  exact hvol.resolve_left (ENNReal.ofReal_ne_zero_iff.mpr (by positivity))

instance : NullSingletonClass circleMeasure := ⟨circleMeasure_singleton⟩

/-! ### Node 17.1: Subharmonic Functions (RCA pp. 335–336) -/

/-- **17.1 (Extended-real circle mean, RCA p. 335):**
For `u : ℂ → [-∞, ∞]`, `a : ℂ`, and `r : ℝ`, the normalized circle mean of `u` on the circle
`z = a + r e^{iθ}` is defined as the difference of the upper and lower Lebesgue integrals of the
positive and negative parts against `circleMeasure` (sending `-∞` on the negative part to `⊤`). -/
def erealCircleMean (u : ℂ → EReal) (a : ℂ) (r : ℝ) : EReal :=
  (∫⁻ ζ, ENNReal.ofReal (max 0 (u (a + (r : ℂ) * circlePoint ζ)).toReal)
      ∂RudinRCA.Chapter04.circleMeasure : EReal) -
    (∫⁻ ζ, (if u (a + (r : ℂ) * circlePoint ζ) = ⊥ then ⊤
      else ENNReal.ofReal (max 0 (-(u (a + (r : ℂ) * circlePoint ζ)).toReal)))
      ∂RudinRCA.Chapter04.circleMeasure : EReal)

/-- **17.1 (Definition of Subharmonic Functions, RCA pp. 335–336):**
A function `u : Ω → [-∞, ∞)` on an open set `Ω ⊆ ℂ` is *subharmonic* in `Ω` if:
(a) `u(z) < ∞` for every `z ∈ Ω`,
(b) `u` is upper semicontinuous in `Ω`, and
(c) whenever `closedBall a r ⊆ Ω` (`0 < r`), the circle mean `erealCircleMean u a r` is not `-∞`
and `u(a) ≤ erealCircleMean u a r`. -/
structure SubharmonicOn (Ω : Set ℂ) (u : ℂ → EReal) : Prop where
  isOpen : IsOpen Ω
  lt_top : ∀ z ∈ Ω, u z < ⊤
  upperSemicontinuousOn : UpperSemicontinuousOn u Ω
  submean : ∀ a : ℂ, ∀ r : ℝ, 0 < r → Metric.closedBall a r ⊆ Ω →
    erealCircleMean u a r ≠ ⊥ ∧ u a ≤ erealCircleMean u a r

theorem upperSemicontinuousOn_iff_explicit (Ω : Set ℂ) (u : ℂ → EReal) :
    UpperSemicontinuousOn u Ω ↔
      ∀ z ∈ Ω, ∀ y : EReal, u z < y → ∀ᶠ w in 𝓝[Ω] z, u w < y :=
  Iff.rfl

theorem SubharmonicOn.congr {Ω : Set ℂ} {u₁ u₂ : ℂ → EReal}
    (hu : SubharmonicOn Ω u₁) (heq : Set.EqOn u₁ u₂ Ω) : SubharmonicOn Ω u₂ where
  isOpen := hu.isOpen
  lt_top z hz := heq hz ▸ hu.lt_top z hz
  upperSemicontinuousOn := by
    intro z hz y hy
    rw [← heq hz] at hy
    filter_upwards [hu.upperSemicontinuousOn z hz y hy, self_mem_nhdsWithin] with w hw hwΩ
    rwa [← heq hwΩ]
  submean a r hr hsub := by
    have hmean : erealCircleMean u₁ a r = erealCircleMean u₂ a r := by
      unfold erealCircleMean
      have hpt : ∀ ζ : FourierCircle,
          u₁ (a + (r : ℂ) * circlePoint ζ) = u₂ (a + (r : ℂ) * circlePoint ζ) :=
        fun ζ ↦ heq (hsub (affine_circlePoint_mem_closedBall a hr.le ζ))
      simp_rw [hpt]
    have ha : u₁ a = u₂ a := heq (hsub (Metric.mem_closedBall_self hr.le))
    rw [← hmean, ← ha]
    exact hu.submean a r hr hsub

theorem SubharmonicOn.mono {Ω₁ Ω₂ : Set ℂ} {u : ℂ → EReal}
    (hu : SubharmonicOn Ω₂ u) (hΩ₁ : IsOpen Ω₁) (hsub : Ω₁ ⊆ Ω₂) :
    SubharmonicOn Ω₁ u where
  isOpen := hΩ₁
  lt_top z hz := hu.lt_top z (hsub hz)
  upperSemicontinuousOn := hu.upperSemicontinuousOn.mono hsub
  submean a r hr hcb := hu.submean a r hr (hcb.trans hsub)

/-- Every upper semicontinuous function `< ⊤` on an open set `Ω` is bounded above by a real
constant on any compact subset `K ⊆ Ω`. -/
theorem exists_real_upper_bound_of_usc {Ω K : Set ℂ} {u : ℂ → EReal}
    (h_top : ∀ z ∈ Ω, u z < ⊤) (h_usc : UpperSemicontinuousOn u Ω)
    (hK : IsCompact K) (hKΩ : K ⊆ Ω) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ z ∈ K, u z ≤ (M : EReal) := by
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · exact ⟨0, le_rfl, fun _ hz ↦ False.elim hz⟩
  · obtain ⟨z₀, hz₀K, hz₀max⟩ := (h_usc.mono hKΩ).exists_isMaxOn hKne hK
    have hz₀_top : u z₀ < ⊤ := h_top z₀ (hKΩ hz₀K)
    rcases eq_or_ne (u z₀) ⊥ with hbot | hne_bot
    · refine ⟨0, le_rfl, fun z hz ↦ ?_⟩
      have hle : u z ≤ u z₀ := hz₀max hz
      exact hle.trans (by rw [hbot]; exact bot_le)
    · lift u z₀ to ℝ using ⟨hz₀_top.ne, hne_bot⟩ with c hc
      refine ⟨max 0 c, le_max_left 0 c, fun z hz ↦ ?_⟩
      have hle : u z ≤ u z₀ := hz₀max hz
      rw [← hc] at hle
      exact hle.trans (EReal.coe_le_coe_iff.mpr (le_max_right 0 c))

/-- At radius `r = 0`, `erealCircleMean u a 0 = u a` whenever `u a < ⊤`. -/
theorem erealCircleMean_zero {u : ℂ → EReal} {a : ℂ} (ha : u a < ⊤) :
    erealCircleMean u a 0 = u a := by
  unfold erealCircleMean
  simp only [Complex.ofReal_zero, zero_mul, add_zero]
  rcases eq_or_ne (u a) ⊥ with hbot | hne_bot
  · simp [hbot]
  · lift u a to ℝ using ⟨ha.ne, hne_bot⟩ with x
    simp only [EReal.coe_ne_bot, ↓reduceIte, EReal.toReal_coe, lintegral_const, measure_univ,
      mul_one]
    rw [← EReal.coe_ennreal_toReal ENNReal.ofReal_ne_top,
      ← EReal.coe_ennreal_toReal ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal (le_max_left 0 x),
      ENNReal.toReal_ofReal (le_max_left 0 (-x)), ← EReal.coe_sub]
    congr 1
    rcases le_total 0 x with hx | hx
    · rw [max_eq_right hx, max_eq_left (by linarith : -x ≤ 0), sub_zero]
    · rw [max_eq_left hx, max_eq_right (by linarith : 0 ≤ -x)]
      ring

/-- Non-strict radius `0 ≤ r` submean inequality for subharmonic functions (`r = 0` gives equality). -/
theorem SubharmonicOn.submean_of_nonneg {Ω : Set ℂ} {u : ℂ → EReal}
    (hu : SubharmonicOn Ω u) {a : ℂ} {r : ℝ} (hr : 0 ≤ r) (hsub : Metric.closedBall a r ⊆ Ω) :
    u a ≤ erealCircleMean u a r := by
  rcases hr.eq_or_lt with rfl | hr_pos
  · have ha : a ∈ Ω := hsub (Metric.mem_closedBall_self le_rfl)
    rw [erealCircleMean_zero (hu.lt_top a ha)]
  · exact (hu.submean a r hr_pos hsub).2

/-- Characterization of `erealCircleMean u a r ≠ ⊥` for upper semicontinuous `u < ⊤`:
finiteness holds iff `u ≠ ⊥` almost everywhere on the circle and `u.toReal` is circle-integrable,
in which case `erealCircleMean u a r` coincides with the Bochner circle integral of `u.toReal`. -/
theorem erealCircleMean_ne_bot_iff {Ω : Set ℂ} {u : ℂ → EReal}
    (hΩ : IsOpen Ω) (h_top : ∀ z ∈ Ω, u z < ⊤) (h_usc : UpperSemicontinuousOn u Ω)
    {a : ℂ} {r : ℝ} (hr : 0 ≤ r) (hsub : Metric.closedBall a r ⊆ Ω) :
    (erealCircleMean u a r ≠ ⊥ ↔
      (∀ᵐ ζ ∂circleMeasure, u (a + (r : ℂ) * circlePoint ζ) ≠ ⊥) ∧
        Integrable (fun ζ ↦ (u (a + (r : ℂ) * circlePoint ζ)).toReal) circleMeasure) ∧
    (erealCircleMean u a r ≠ ⊥ →
      erealCircleMean u a r =
        ((∫ ζ, (u (a + (r : ℂ) * circlePoint ζ)).toReal ∂circleMeasure : ℝ) : EReal)) := by
  let v : FourierCircle → EReal := fun ζ ↦ u (a + (r : ℂ) * circlePoint ζ)
  have hv_mem : ∀ ζ : FourierCircle, a + (r : ℂ) * circlePoint ζ ∈ Ω :=
    fun ζ ↦ hsub (affine_circlePoint_mem_closedBall a hr ζ)
  have hv_lt_top : ∀ ζ : FourierCircle, v ζ < ⊤ := fun ζ ↦ h_top _ (hv_mem ζ)
  have hv_usc : UpperSemicontinuous v := by
    intro ζ₀ y hy
    have h1 : ∀ᶠ w in 𝓝 (a + (r : ℂ) * circlePoint ζ₀), u w < y := by
      have hnhds : 𝓝[Ω] (a + (r : ℂ) * circlePoint ζ₀) = 𝓝 (a + (r : ℂ) * circlePoint ζ₀) :=
        nhdsWithin_eq_nhds.mpr (hΩ.mem_nhds (hv_mem ζ₀))
      simpa [hnhds] using h_usc _ (hv_mem ζ₀) y hy
    exact (continuous_const.add (continuous_const.mul continuous_circlePoint)).continuousAt.eventually h1
  have hv_meas : Measurable v := hv_usc.measurable
  obtain ⟨M, hM0, hM_bound⟩ :=
    exists_real_upper_bound_of_usc h_top h_usc (isCompact_closedBall a r) hsub
  let fPos : FourierCircle → ℝ≥0∞ := fun ζ ↦ ENNReal.ofReal (max 0 (v ζ).toReal)
  let fNeg : FourierCircle → ℝ≥0∞ :=
    fun ζ ↦ if v ζ = ⊥ then ⊤ else ENNReal.ofReal (max 0 (-(v ζ).toReal))
  have hfPos_meas : Measurable fPos := by
    exact ENNReal.measurable_ofReal.comp (measurable_const.max hv_meas.ereal_toReal)
  have hfNeg_meas : Measurable fNeg := by
    refine Measurable.ite (measurableSet_eq_fun hv_meas measurable_const) measurable_const ?_
    exact ENNReal.measurable_ofReal.comp (measurable_const.max hv_meas.ereal_toReal.neg)
  have hIPos_lt_top : ∫⁻ ζ, fPos ζ ∂circleMeasure < ⊤ := by
    calc ∫⁻ ζ, fPos ζ ∂circleMeasure
        ≤ ∫⁻ _, ENNReal.ofReal M ∂circleMeasure := by
          refine lintegral_mono fun ζ ↦ ENNReal.ofReal_le_ofReal ?_
          refine max_le hM0 ?_
          rcases eq_or_ne (v ζ) ⊥ with hb | hb
          · simp [hb, hM0]
          · have hle := hM_bound _ (affine_circlePoint_mem_closedBall a hr ζ)
            exact EReal.toReal_le_toReal hle hb (EReal.coe_ne_top M)
      _ = ENNReal.ofReal M := by simp
      _ < ⊤ := ENNReal.ofReal_lt_top
  have hmean_eq : erealCircleMean u a r =
      (∫⁻ ζ, fPos ζ ∂circleMeasure : EReal) - (∫⁻ ζ, fNeg ζ ∂circleMeasure : EReal) := rfl
  have hne_bot_iff_INeg : erealCircleMean u a r ≠ ⊥ ↔ ∫⁻ ζ, fNeg ζ ∂circleMeasure < ⊤ := by
    rw [hmean_eq]
    set IPos := ∫⁻ ζ, fPos ζ ∂circleMeasure
    set INeg := ∫⁻ ζ, fNeg ζ ∂circleMeasure
    have hIPos_coe : (IPos : EReal) = (IPos.toReal : EReal) :=
      (EReal.coe_ennreal_toReal hIPos_lt_top.ne).symm
    rw [hIPos_coe]
    rcases eq_top_or_lt_top INeg with htop | hlt
    · simp [htop, sub_eq_add_neg]
    · have hINeg_coe : (INeg : EReal) = (INeg.toReal : EReal) :=
        (EReal.coe_ennreal_toReal hlt.ne).symm
      rw [hINeg_coe, ← EReal.coe_sub]
      exact iff_of_true (EReal.coe_ne_bot _) hlt
  have h_iff : ∫⁻ ζ, fNeg ζ ∂circleMeasure < ⊤ ↔
      (∀ᵐ ζ ∂circleMeasure, v ζ ≠ ⊥) ∧ Integrable (fun ζ ↦ (v ζ).toReal) circleMeasure := by
    constructor
    · intro hINeg
      have hae_lt : ∀ᵐ ζ ∂circleMeasure, fNeg ζ < ⊤ := ae_lt_top hfNeg_meas hINeg.ne
      have hae_nb : ∀ᵐ ζ ∂circleMeasure, v ζ ≠ ⊥ := by
        filter_upwards [hae_lt] with ζ hζ hbot
        simp [fNeg, hbot] at hζ
      refine ⟨hae_nb, hv_meas.ereal_toReal.aestronglyMeasurable, ?_⟩
      rw [HasFiniteIntegral]
      have hle : ∀ ζ, ‖(v ζ).toReal‖ₑ ≤ fPos ζ + fNeg ζ := by
        intro ζ
        by_cases hb : v ζ = ⊥
        · simp [fNeg, hb]
        · simp only [fPos, fNeg, hb, ↓reduceIte]
          rw [Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_add (le_max_left _ _) (le_max_left _ _)]
          refine ENNReal.ofReal_le_ofReal ?_
          rcases le_total 0 (v ζ).toReal with h0 | h0
          · rw [abs_of_nonneg h0, max_eq_right h0, max_eq_left (by linarith)]
            linarith
          · rw [abs_of_nonpos h0, max_eq_left h0, max_eq_right (by linarith)]
            linarith
      calc ∫⁻ ζ, ‖(v ζ).toReal‖ₑ ∂circleMeasure
          ≤ ∫⁻ ζ, (fPos ζ + fNeg ζ) ∂circleMeasure := lintegral_mono hle
        _ = (∫⁻ ζ, fPos ζ ∂circleMeasure) + ∫⁻ ζ, fNeg ζ ∂circleMeasure :=
            lintegral_add_left hfPos_meas _
        _ < ⊤ := ENNReal.add_lt_top.mpr ⟨hIPos_lt_top, hINeg⟩
    · rintro ⟨hae_nb, hint⟩
      have hae_eq : fNeg =ᵐ[circleMeasure] fun ζ ↦ ENNReal.ofReal (max 0 (-(v ζ).toReal)) := by
        filter_upwards [hae_nb] with ζ hζ
        simp [fNeg, hζ]
      rw [lintegral_congr_ae hae_eq]
      calc ∫⁻ ζ, ENNReal.ofReal (max 0 (-(v ζ).toReal)) ∂circleMeasure
          ≤ ∫⁻ ζ, ‖(v ζ).toReal‖ₑ ∂circleMeasure := by
            refine lintegral_mono fun ζ ↦ ?_
            rw [Real.enorm_eq_ofReal_abs]
            exact ENNReal.ofReal_le_ofReal (max_le (abs_nonneg _) (neg_le_abs _))
        _ < ⊤ := hint.hasFiniteIntegral
  refine ⟨hne_bot_iff_INeg.trans h_iff, fun hne ↦ ?_⟩
  have hINeg : ∫⁻ ζ, fNeg ζ ∂circleMeasure < ⊤ := hne_bot_iff_INeg.mp hne
  obtain ⟨hae_nb, hint⟩ := h_iff.mp hINeg
  rw [hmean_eq]
  have hIPos_coe : (∫⁻ ζ, fPos ζ ∂circleMeasure : EReal) =
      ((∫⁻ ζ, fPos ζ ∂circleMeasure).toReal : EReal) :=
    (EReal.coe_ennreal_toReal hIPos_lt_top.ne).symm
  have hINeg_coe : (∫⁻ ζ, fNeg ζ ∂circleMeasure : EReal) =
      ((∫⁻ ζ, fNeg ζ ∂circleMeasure).toReal : EReal) :=
    (EReal.coe_ennreal_toReal hINeg.ne).symm
  rw [hIPos_coe, hINeg_coe, ← EReal.coe_sub]
  congr 1
  rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hint]
  have hfPos_eq : fPos = fun ζ ↦ ENNReal.ofReal (v ζ).toReal := by
    funext ζ
    dsimp [fPos]
    rcases le_total 0 (v ζ).toReal with h0 | h0
    · rw [max_eq_right h0]
    · rw [max_eq_left h0, ENNReal.ofReal_zero, ENNReal.ofReal_eq_zero.mpr h0]
  have hfNeg_ae : fNeg =ᵐ[circleMeasure] fun ζ ↦ ENNReal.ofReal (-(v ζ).toReal) := by
    filter_upwards [hae_nb] with ζ hζ
    dsimp [fNeg]
    rw [ite_eq_right_iff.mpr fun h ↦ absurd h hζ]
    rcases le_total 0 (-(v ζ).toReal) with h0 | h0
    · rw [max_eq_right h0]
    · rw [max_eq_left h0, ENNReal.ofReal_zero, ENNReal.ofReal_eq_zero.mpr h0]
  rw [hfPos_eq, lintegral_congr_ae hfNeg_ae]

/-- Interval-integral formula for `erealCircleMean u a r` when finite, matching Rudin 17.1(1). -/
theorem SubharmonicOn.erealCircleMean_eq_intervalIntegral {Ω : Set ℂ} {u : ℂ → EReal}
    (hu : SubharmonicOn Ω u) {a : ℂ} {r : ℝ} (hr : 0 < r) (hsub : Metric.closedBall a r ⊆ Ω) :
    erealCircleMean u a r =
      (((2 * Real.pi)⁻¹ * ∫ θ in -Real.pi..Real.pi,
        (u (a + (r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))).toReal : ℝ) : EReal) := by
  have hne := (hu.submean a r hr hsub).1
  have hchar := (erealCircleMean_ne_bot_iff hu.isOpen hu.lt_top hu.upperSemicontinuousOn
    hr.le hsub).2 hne
  rw [hchar, RudinRCA.Chapter04.circleIntegral_interval]
  simp only [circlePoint_coe, one_div, smul_eq_mul]

/-- **Theorem 17.1 (Harmonic functions are subharmonic, RCA pp. 335–336):**
Every real-valued harmonic function `h` on an open set `Ω ⊆ ℂ` (`HarmonicOn h Ω` in Rudin's 11.3
sense) is subharmonic on `Ω`. -/
theorem theorem17_1 {Ω : Set ℂ} (hΩ : IsOpen Ω) {h : ℂ → ℝ}
    (hh : RudinRCA.Chapter11.HarmonicOn h Ω) :
    SubharmonicOn Ω (fun z ↦ (h z : EReal)) := by
  have h_top : ∀ z ∈ Ω, (h z : EReal) < ⊤ := fun z _ ↦ EReal.coe_lt_top (h z)
  have h_usc : UpperSemicontinuousOn (fun z ↦ (h z : EReal)) Ω :=
    (continuous_coe_real_ereal.comp_continuousOn hh.continuousOn).upperSemicontinuousOn
  refine ⟨hΩ, h_top, h_usc, fun a r hr hsub ↦ ?_⟩
  have hcont_circ : Continuous (fun ζ : FourierCircle ↦ h (a + (r : ℂ) * circlePoint ζ)) := by
    refine hh.continuousOn.comp_continuous
      (continuous_const.add (continuous_const.mul continuous_circlePoint)) fun ζ ↦ ?_
    exact hsub (affine_circlePoint_mem_closedBall a hr.le ζ)
  have hint : Integrable (fun ζ : FourierCircle ↦ h (a + (r : ℂ) * circlePoint ζ)) circleMeasure :=
    hcont_circ.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hchar := erealCircleMean_ne_bot_iff hΩ h_top h_usc hr.le hsub
  have hne : erealCircleMean (fun z ↦ (h z : EReal)) a r ≠ ⊥ := by
    refine hchar.1.mpr ⟨Eventually.of_forall fun ζ ↦ EReal.coe_ne_bot _, ?_⟩
    simpa only [EReal.toReal_coe] using hint
  refine ⟨hne, ?_⟩
  rw [hchar.2 hne]
  simp only [EReal.toReal_coe]
  rw [integral_circleMeasure_eq_circleAverage,
    (RudinRCA.Chapter11.theorem11_12_real hΩ hh).1 hr hsub]

/-! ### Node 17.2: Convex Increasing Composition with Subharmonic Functions (RCA p. 336) -/

/-- **17.2 (Monotone extension to `[-∞, ∞]`, RCA p. 336):**
Extends `φ : ℝ → ℝ` to `EReal` by defining `φ(-∞) = inf_{x ∈ ℝ} φ(x)` (`= lim_{x → -∞} φ(x)` when
`φ` is monotonically increasing) and `φ(+∞) = +∞`. -/
def extendMonotoneToBot (φ : ℝ → ℝ) : EReal → EReal
  | ⊥ => ⨅ x : ℝ, (φ x : EReal)
  | ⊤ => ⊤
  | (x : ℝ) => (φ x : EReal)

@[simp]
theorem extendMonotoneToBot_bot (φ : ℝ → ℝ) :
    extendMonotoneToBot φ ⊥ = ⨅ x : ℝ, (φ x : EReal) := rfl

@[simp]
theorem extendMonotoneToBot_top (φ : ℝ → ℝ) :
    extendMonotoneToBot φ ⊤ = ⊤ := rfl

@[simp]
theorem extendMonotoneToBot_coe (φ : ℝ → ℝ) (x : ℝ) :
    extendMonotoneToBot φ (x : EReal) = (φ x : EReal) := rfl

theorem extendMonotoneToBot_lt_top {φ : ℝ → ℝ} {y : EReal} (hy : y < ⊤) :
    extendMonotoneToBot φ y < ⊤ := by
  rcases eq_or_ne y ⊥ with rfl | hnb
  · exact (iInf_le (fun x : ℝ ↦ (φ x : EReal)) 0).trans_lt (EReal.coe_lt_top (φ 0))
  · lift y to ℝ using ⟨hy.ne, hnb⟩
    exact EReal.coe_lt_top (φ y)

theorem monotone_extendMonotoneToBot {φ : ℝ → ℝ} (hφ : Monotone φ) :
    Monotone (extendMonotoneToBot φ) := by
  intro a b hab
  induction a <;> induction b
  · exact le_rfl
  · exact iInf_le (fun x : ℝ ↦ (φ x : EReal)) _
  · exact le_top
  · exact absurd hab (not_le_of_gt (EReal.bot_lt_coe _))
  · exact EReal.coe_le_coe_iff.mpr (hφ (EReal.coe_le_coe_iff.mp hab))
  · exact le_top
  · exact absurd hab (not_le_of_gt bot_lt_top)
  · exact absurd hab (not_le_of_gt (EReal.coe_lt_top _))
  · exact le_rfl

/-- Rudin 17.2's convention at `-∞`: when `φ` is monotone, `extendMonotoneToBot φ ⊥` is the limit
of `φ(x)` as `x → -∞`. -/
theorem tendsto_extendMonotoneToBot_atBot {φ : ℝ → ℝ} (hφ : Monotone φ) :
    Tendsto (fun x : ℝ ↦ (φ x : EReal)) atBot (𝓝 (extendMonotoneToBot φ ⊥)) := by
  rw [extendMonotoneToBot_bot]
  exact tendsto_atBot_iInf fun a b hab ↦ EReal.coe_le_coe_iff.mpr (hφ hab)

/-- Affine lower bound for any monotone convex function `φ : ℝ → ℝ`. -/
private theorem monotone_convex_lower_bound {φ : ℝ → ℝ}
    (hφ_mono : Monotone φ) (hφ_conv : ConvexOn ℝ Set.univ φ) (x : ℝ) :
    φ 0 - (φ 1 - φ 0) * |x| ≤ φ x := by
  have hc_nonneg : 0 ≤ φ 1 - φ 0 := sub_nonneg.mpr (hφ_mono zero_le_one)
  rcases le_or_gt 0 x with hx | hx
  · have h1 : φ 0 ≤ φ x := hφ_mono hx
    have h2 : 0 ≤ (φ 1 - φ 0) * |x| := mul_nonneg hc_nonneg (abs_nonneg x)
    linarith
  · have h1mx : 0 < 1 - x := by linarith
    let a : ℝ := 1 / (1 - x)
    let b : ℝ := (-x) / (1 - x)
    have ha : 0 ≤ a := by positivity
    have hb : 0 ≤ b := div_nonneg (by linarith) h1mx.le
    have hab : a + b = 1 := by
      dsimp [a, b]
      rw [← add_div, div_eq_one_iff_eq h1mx.ne']
      ring
    have hcomb : a • x + b • (1 : ℝ) = 0 := by
      dsimp [a, b]
      field_simp [h1mx.ne']
      ring
    have hconv := hφ_conv.2 (mem_univ x) (mem_univ 1) ha hb hab
    rw [hcomb] at hconv
    change φ 0 ≤ a * φ x + b * φ 1 at hconv
    have hmul : φ 0 * (1 - x) ≤ φ x - x * φ 1 := by
      have := mul_le_mul_of_nonneg_right hconv h1mx.le
      dsimp [a, b] at this
      rw [add_mul, mul_right_comm (1 / (1 - x)) (φ x) (1 - x),
        div_mul_cancel₀ 1 h1mx.ne', one_mul,
        mul_right_comm (-x / (1 - x)) (φ 1) (1 - x),
        div_mul_cancel₀ (-x) h1mx.ne'] at this
      linarith
    rw [abs_of_neg hx]
    linarith

/-- **Theorem 17.2 (RCA p. 336):**
If `φ : ℝ → ℝ` is monotonically increasing and convex on `ℝ`, and `u` is subharmonic in `Ω`, then
`z ↦ φ(u(z))` (with `φ(-∞) = lim_{x → -∞} φ(x)` via `extendMonotoneToBot`) is subharmonic in `Ω`. -/
theorem theorem17_2 {Ω : Set ℂ} {u : ℂ → EReal} {φ : ℝ → ℝ}
    (hu : SubharmonicOn Ω u) (hφ_mono : Monotone φ) (hφ_conv : ConvexOn ℝ Set.univ φ) :
    SubharmonicOn Ω (fun z ↦ extendMonotoneToBot φ (u z)) := by
  have hφ_cont : Continuous φ := continuousOn_univ.mp (hφ_conv.continuousOn isOpen_univ)
  have hext_mono : Monotone (extendMonotoneToBot φ) := monotone_extendMonotoneToBot hφ_mono
  have hv_top : ∀ z ∈ Ω, extendMonotoneToBot φ (u z) < ⊤ :=
    fun z hz ↦ extendMonotoneToBot_lt_top (hu.lt_top z hz)
  have hv_usc : UpperSemicontinuousOn (fun z ↦ extendMonotoneToBot φ (u z)) Ω := by
    intro z hz y hy
    dsimp only at hy
    have huz_top : u z < ⊤ := hu.lt_top z hz
    rcases eq_or_ne (u z) ⊥ with hbot | hnb
    · rw [hbot] at hy
      have hlim := tendsto_extendMonotoneToBot_atBot hφ_mono
      have hev := hlim.eventually (Iio_mem_nhds hy)
      rw [Filter.eventually_atBot] at hev
      obtain ⟨b, hb⟩ := hev
      have hlt_b : u z < (b : EReal) := by rw [hbot]; exact EReal.bot_lt_coe b
      filter_upwards [hu.upperSemicontinuousOn z hz (b : EReal) hlt_b] with w hw
      exact (hext_mono hw.le).trans_lt (hb b le_rfl)
    · lift u z to ℝ using ⟨huz_top.ne, hnb⟩ with x hx
      rw [extendMonotoneToBot_coe] at hy
      have hcont_coe : Continuous (fun t : ℝ ↦ (φ t : EReal)) :=
        continuous_coe_real_ereal.comp hφ_cont
      obtain ⟨δ, hδ_pos, hδ⟩ :=
        Metric.mem_nhds_iff.mp (hcont_coe.continuousAt.eventually (Iio_mem_nhds hy))
      let x' : ℝ := x + δ / 2
      have hx'_mem : x' ∈ Metric.ball x δ := by
        rw [Metric.mem_ball, Real.dist_eq]
        dsimp [x']
        rw [add_sub_cancel_left, abs_of_pos (half_pos hδ_pos)]
        exact half_lt_self hδ_pos
      have hφx'_lt : (φ x' : EReal) < y := hδ hx'_mem
      have huz_lt : u z < (x' : EReal) := by
        rw [← hx, EReal.coe_lt_coe_iff]
        dsimp [x']
        linarith
      filter_upwards [hu.upperSemicontinuousOn z hz (x' : EReal) huz_lt] with w hw
      exact (hext_mono hw.le).trans_lt hφx'_lt
  refine ⟨hu.isOpen, hv_top, hv_usc, fun a r hr hsub ↦ ?_⟩
  obtain ⟨hmean_u_nb, hua_le⟩ := hu.submean a r hr hsub
  have hchar_u := erealCircleMean_ne_bot_iff hu.isOpen hu.lt_top hu.upperSemicontinuousOn
    hr.le hsub
  obtain ⟨hae_u_nb, hint_u⟩ := hchar_u.1.mp hmean_u_nb
  have hmean_u_eq := hchar_u.2 hmean_u_nb
  let U_real : FourierCircle → ℝ := fun ζ ↦ (u (a + (r : ℂ) * circlePoint ζ)).toReal
  obtain ⟨M, _, hM_bound⟩ :=
    exists_real_upper_bound_of_usc hu.lt_top hu.upperSemicontinuousOn
      (isCompact_closedBall a r) hsub
  have hU_le : ∀ ζ : FourierCircle, U_real ζ ≤ max 0 M := by
    intro ζ
    have hw := affine_circlePoint_mem_closedBall a hr.le ζ
    rcases eq_or_ne (u (a + (r : ℂ) * circlePoint ζ)) ⊥ with hb | hb
    · dsimp [U_real]; rw [hb, EReal.toReal_bot]; exact le_max_left 0 M
    · exact (EReal.toReal_le_toReal (hM_bound _ hw) hb (EReal.coe_ne_top M)).trans
        (le_max_right 0 M)
  have hint_φU : Integrable (fun ζ ↦ φ (U_real ζ)) circleMeasure := by
    let c : ℝ := φ 1 - φ 0
    have hdom : Integrable
        (fun ζ ↦ |φ (max 0 M)| + |φ 0| + |c| * ‖U_real ζ‖) circleMeasure :=
      ((integrable_const _).add (integrable_const _)).add (hint_u.norm.const_mul |c|)
    refine hdom.mono' (hφ_cont.comp_aestronglyMeasurable hint_u.aestronglyMeasurable)
      (Eventually.of_forall fun ζ ↦ ?_)
    have hup : φ (U_real ζ) ≤ φ (max 0 M) := hφ_mono (hU_le ζ)
    have hlo : φ 0 - c * |U_real ζ| ≤ φ (U_real ζ) :=
      monotone_convex_lower_bound hφ_mono hφ_conv (U_real ζ)
    have hc_pos : 0 ≤ c := sub_nonneg.mpr (hφ_mono zero_le_one)
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hc_pos]
    rw [abs_le]
    constructor
    · have h1 : -|φ 0| ≤ φ 0 := neg_abs_le (φ 0)
      have h2 : 0 ≤ |φ (max 0 M)| := abs_nonneg _
      linarith
    · have h1 : φ (max 0 M) ≤ |φ (max 0 M)| := le_abs_self _
      have h2 : 0 ≤ |φ 0| + c * |U_real ζ| :=
        add_nonneg (abs_nonneg _) (mul_nonneg hc_pos (abs_nonneg _))
      linarith
  have hae_v_eq : ∀ᵐ ζ ∂circleMeasure,
      extendMonotoneToBot φ (u (a + (r : ℂ) * circlePoint ζ)) = (φ (U_real ζ) : EReal) := by
    filter_upwards [hae_u_nb] with ζ hζ
    have hlt := hu.lt_top _ (hsub (affine_circlePoint_mem_closedBall a hr.le ζ))
    have hcoe : u (a + (r : ℂ) * circlePoint ζ) = (U_real ζ : EReal) :=
      (EReal.coe_toReal hlt.ne hζ).symm
    rw [hcoe, extendMonotoneToBot_coe]
  have hchar_v := erealCircleMean_ne_bot_iff hu.isOpen hv_top hv_usc hr.le hsub
  have hmean_v_nb : erealCircleMean (fun z ↦ extendMonotoneToBot φ (u z)) a r ≠ ⊥ := by
    refine hchar_v.1.mpr ⟨?_, ?_⟩
    · filter_upwards [hae_v_eq] with ζ hζ
      rw [hζ]
      exact EReal.coe_ne_bot _
    · refine hint_φU.congr ?_
      filter_upwards [hae_v_eq] with ζ hζ
      rw [hζ, EReal.toReal_coe]
  refine ⟨hmean_v_nb, ?_⟩
  rw [hchar_v.2 hmean_v_nb]
  have hint_eq : ∫ ζ, (extendMonotoneToBot φ (u (a + (r : ℂ) * circlePoint ζ))).toReal ∂circleMeasure =
      ∫ ζ, φ (U_real ζ) ∂circleMeasure := by
    refine integral_congr_ae ?_
    filter_upwards [hae_v_eq] with ζ hζ
    rw [hζ, EReal.toReal_coe]
  rw [hint_eq]
  have hjensen : φ (∫ ζ, U_real ζ ∂circleMeasure) ≤ ∫ ζ, φ (U_real ζ) ∂circleMeasure :=
    hφ_conv.map_integral_le hφ_cont.continuousOn isClosed_univ
      (Eventually.of_forall fun _ ↦ mem_univ _) hint_u hint_φU
  calc extendMonotoneToBot φ (u a)
      ≤ extendMonotoneToBot φ (erealCircleMean u a r) := hext_mono hua_le
    _ = extendMonotoneToBot φ ((∫ ζ, U_real ζ ∂circleMeasure : ℝ) : EReal) := by rw [hmean_u_eq]
    _ = (φ (∫ ζ, U_real ζ ∂circleMeasure) : EReal) := rfl
    _ ≤ ((∫ ζ, φ (U_real ζ) ∂circleMeasure : ℝ) : EReal) := EReal.coe_le_coe_iff.mpr hjensen

/-! ### Node 17.3: Subharmonicity of `log|f|`, `log⁺|f|`, and `|f|ᵖ` (RCA p. 336) -/

/-- **17.3 (Extended-real logarithm of modulus, RCA p. 336):**
`log|w|` with the convention `log 0 = -∞` (`⊥ : EReal`). -/
def eLogNorm (w : ℂ) : EReal :=
  if w = 0 then ⊥ else (Real.log ‖w‖ : EReal)

@[simp]
theorem eLogNorm_zero : eLogNorm 0 = ⊥ := by
  simp [eLogNorm]

theorem eLogNorm_of_ne_zero {w : ℂ} (hw : w ≠ 0) :
    eLogNorm w = (Real.log ‖w‖ : EReal) := by
  simp [eLogNorm, hw]

@[simp]
theorem toReal_eLogNorm (w : ℂ) : (eLogNorm w).toReal = Real.log ‖w‖ := by
  by_cases hw : w = 0
  · simp [hw]
  · simp [eLogNorm_of_ne_zero hw]

theorem eLogNorm_lt_top (w : ℂ) : eLogNorm w < ⊤ := by
  by_cases hw : w = 0
  · simp [hw]
  · rw [eLogNorm_of_ne_zero hw]
    exact EReal.coe_lt_top _

theorem upperSemicontinuous_eLogNorm : UpperSemicontinuous eLogNorm := by
  intro w₀ y hy
  by_cases hw₀ : w₀ = 0
  · subst hw₀
    have hy_nb : y ≠ ⊥ := (bot_lt_iff_ne_bot.mp (by simpa using hy))
    obtain ⟨b, hb⟩ : ∃ b : ℝ, (b : EReal) < y := by
      rcases eq_top_or_lt_top y with rfl | hyt
      · exact ⟨0, EReal.coe_lt_top 0⟩
      · lift y to ℝ using ⟨hyt.ne, hy_nb⟩
        exact ⟨y - 1, EReal.coe_lt_coe_iff.mpr (by linarith)⟩
    filter_upwards [Metric.ball_mem_nhds (0 : ℂ) (Real.exp_pos b)] with w hw
    have hnorm : ‖w‖ < Real.exp b := by simpa [Metric.mem_ball] using hw
    by_cases hw0 : w = 0
    · simp [hw0, bot_lt_iff_ne_bot, hy_nb]
    · rw [eLogNorm_of_ne_zero hw0]
      refine lt_trans ?_ hb
      rw [EReal.coe_lt_coe_iff]
      exact (Real.log_lt_iff_lt_exp (norm_pos_iff.mpr hw0)).mpr hnorm
  · rw [eLogNorm_of_ne_zero hw₀] at hy
    have hcont : ContinuousAt (fun w : ℂ ↦ (Real.log ‖w‖ : EReal)) w₀ :=
      continuous_coe_real_ereal.continuousAt.comp
        ((Real.continuousAt_log (norm_ne_zero_iff.mpr hw₀)).comp continuous_norm.continuousAt)
    filter_upwards [hcont.eventually (Iio_mem_nhds hy),
      isOpen_compl_singleton.mem_nhds hw₀] with w hw hne
    rwa [eLogNorm_of_ne_zero hne]

/-- **Theorem 17.3(a) (`log|f|` is subharmonic, RCA p. 336):**
If `Ω` is a region, `f ∈ H(Ω)`, and `f` is not identically zero on `Ω`, then `z ↦ eLogNorm (f z)`
(`log|f(z)|` with `log 0 = -∞`) is subharmonic in `Ω`. -/
theorem subharmonicOn_eLogNorm {Ω : Set ℂ} {f : ℂ → ℂ}
    (hΩ : IsRegion Ω) (hf : HolomorphicOn f Ω) (hne : ∃ z₀ ∈ Ω, f z₀ ≠ 0) :
    SubharmonicOn Ω (fun z ↦ eLogNorm (f z)) := by
  have hf_cont : ContinuousOn f Ω := RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf
  have h_top : ∀ z ∈ Ω, eLogNorm (f z) < ⊤ := fun z _ ↦ eLogNorm_lt_top (f z)
  have h_usc : UpperSemicontinuousOn (fun z ↦ eLogNorm (f z)) Ω := by
    intro z hz y hy
    exact (hf_cont z hz).eventually (upperSemicontinuous_eLogNorm (f z) y hy)
  refine ⟨hΩ.1, h_top, h_usc, fun a r hr hsub ↦ ?_⟩
  have hne_eqOn : ¬ Set.EqOn f 0 Ω := by
    rcases hne with ⟨z₀, hz₀, hfz₀⟩
    intro h0
    exact hfz₀ (h0 hz₀)
  have hfin_sph : (RudinRCA.Chapter10.zeroSet f Ω ∩ Metric.sphere a r).Finite :=
    RudinRCA.Chapter10.zeroSet_inter_compact_finite hΩ hf hne_eqOn
      (isCompact_sphere a r) (Metric.sphere_subset_closedBall.trans hsub)
  have hfin_circ : {ζ : FourierCircle | f (a + (r : ℂ) * circlePoint ζ) = 0}.Finite := by
    have hinj : Function.Injective (fun ζ : FourierCircle ↦ a + (r : ℂ) * circlePoint ζ) := by
      intro ζ₁ ζ₂ h
      have hr_ne : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr.ne'
      exact circlePoint_injective (mul_left_cancel₀ hr_ne (add_left_cancel h))
    refine (hfin_sph.preimage hinj.injOn).subset fun ζ hζ ↦ ?_
    have hmem_sph := affine_circlePoint_mem_sphere a hr.le ζ
    exact ⟨⟨hsub (Metric.sphere_subset_closedBall hmem_sph), hζ⟩, hmem_sph⟩
  have hae_nz : ∀ᵐ ζ ∂circleMeasure, f (a + (r : ℂ) * circlePoint ζ) ≠ 0 := by
    rw [ae_iff]
    simpa only [not_ne_iff] using hfin_circ.measure_zero circleMeasure
  have h_ana : AnalyticOnNhd ℂ f Ω :=
    ((RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn hΩ.1).mp hf).analyticOnNhd hΩ.1
  have h_ana_cb : AnalyticOnNhd ℂ f (Metric.closedBall a |r|) := by
    rw [abs_of_pos hr]
    exact h_ana.mono hsub
  have hci : CircleIntegrable (fun z ↦ Real.log ‖f z‖) a r := by
    have hmero : MeromorphicOn f (Metric.sphere a |r|) :=
      (h_ana_cb.mono Metric.sphere_subset_closedBall).meromorphicOn
    exact hmero.circleIntegrable_log_norm
  have hint : Integrable (fun ζ ↦ Real.log ‖f (a + (r : ℂ) * circlePoint ζ)‖) circleMeasure :=
    (integrable_affine_circlePoint_iff_circleIntegrable (fun z ↦ Real.log ‖f z‖) a r).mpr hci
  have hchar := erealCircleMean_ne_bot_iff hΩ.1 h_top h_usc hr.le hsub
  have hmean_nb : erealCircleMean (fun z ↦ eLogNorm (f z)) a r ≠ ⊥ := by
    refine hchar.1.mpr ⟨?_, ?_⟩
    · filter_upwards [hae_nz] with ζ hζ
      rw [eLogNorm_of_ne_zero hζ]
      exact EReal.coe_ne_bot _
    · simpa only [toReal_eLogNorm] using hint
  refine ⟨hmean_nb, ?_⟩
  rw [hchar.2 hmean_nb]
  simp only [toReal_eLogNorm]
  rw [integral_circleMeasure_eq_circleAverage (fun z ↦ Real.log ‖f z‖) a r]
  by_cases hfa : f a = 0
  · simp [hfa]
  · rw [eLogNorm_of_ne_zero hfa, EReal.coe_le_coe_iff]
    rw [h_ana_cb.circleAverage_log_norm hr.ne' hfa]
    suffices hsum_nonneg :
        0 ≤ ∑ᶠ u, MeromorphicOn.divisor f (Metric.closedBall a |r|) u * Real.log (r * ‖a - u‖⁻¹) by
      linarith
    refine finsum_nonneg fun u ↦ ?_
    by_cases hu_cb : u ∈ Metric.closedBall a |r|
    · have hdiv_nonneg : 0 ≤ (MeromorphicOn.divisor f (Metric.closedBall a |r|) u : ℝ) := by
        rw [MeromorphicOn.AnalyticOnNhd.divisor_apply h_ana_cb hu_cb]
        have h0 : (0 : ℤ) ≤ ((analyticOrderAt f u).map (↑)).untop₀ := by
          cases analyticOrderAt f u using ENat.recTopCoe <;> simp
        exact_mod_cast h0
      by_cases hua : u = a
      · subst hua
        have hdiv0 : MeromorphicOn.divisor f (Metric.closedBall u |r|) u = 0 := by
          rw [MeromorphicOn.AnalyticOnNhd.divisor_apply h_ana_cb hu_cb,
            (h_ana_cb u hu_cb).analyticOrderAt_eq_zero.mpr hfa]
          simp
        simp [hdiv0]
      · have hdist_pos : 0 < ‖a - u‖ := norm_pos_iff.mpr (sub_ne_zero.mpr (Ne.symm hua))
        have hdist_le : ‖a - u‖ ≤ r := by
          rw [abs_of_pos hr, Metric.mem_closedBall, dist_eq_norm'] at hu_cb
          exact hu_cb
        have hge1 : 1 ≤ r * ‖a - u‖⁻¹ := by
          rw [← div_eq_mul_inv, one_le_div hdist_pos]
          exact hdist_le
        exact mul_nonneg hdiv_nonneg (Real.log_nonneg hge1)
    · have hdiv0 : MeromorphicOn.divisor f (Metric.closedBall a |r|) u = 0 := by
        simp [hu_cb]
      simp [hdiv0]

/-- **Theorem 17.3(b) (`log⁺|f|` is subharmonic, RCA p. 336):**
For any `f ∈ H(Ω)` on an open set `Ω ⊆ ℂ` (on a region by 17.2 + 17.3(a), and also when `f ≡ 0`),
`z ↦ log⁺ ‖f z‖` is subharmonic in `Ω`. -/
theorem subharmonicOn_posLog_norm_region {Ω : Set ℂ} {f : ℂ → ℂ}
    (hΩ : IsRegion Ω) (hf : HolomorphicOn f Ω) :
    SubharmonicOn Ω (fun z ↦ (Real.posLog ‖f z‖ : EReal)) := by
  by_cases hne : ∃ z₀ ∈ Ω, f z₀ ≠ 0
  · have hsub_log := subharmonicOn_eLogNorm hΩ hf hne
    have hmono : Monotone (fun t : ℝ ↦ max 0 t) := fun _ _ hab ↦ max_le_max_left 0 hab
    have hconv : ConvexOn ℝ Set.univ (fun t : ℝ ↦ max 0 t) :=
      (convexOn_const 0 convex_univ).sup (convexOn_id convex_univ)
    refine (theorem17_2 hsub_log hmono hconv).congr fun z _ ↦ ?_
    by_cases hfz : f z = 0
    · simp only [hfz, eLogNorm_zero, extendMonotoneToBot_bot, norm_zero, Real.posLog_zero]
      refine le_antisymm ?_ (le_iInf fun x ↦ EReal.coe_nonneg.mpr (le_max_left 0 x))
      exact (iInf_le (fun x : ℝ ↦ ((max 0 x : ℝ) : EReal)) 0).trans (by simp)
    · simp [eLogNorm_of_ne_zero hfz, Real.posLog_def]
  · push Not at hne
    have h0 : SubharmonicOn Ω (fun _ ↦ ((0 : ℝ) : EReal)) :=
      theorem17_1 hΩ.1 (RudinRCA.Chapter11.node11_4_holomorphic_harmonic hΩ.1
        (differentiableOn_const (0 : ℂ)) |>.comp_clm hΩ.1 Complex.reCLM)
    refine h0.congr fun z hz ↦ ?_
    simp [hne z hz]

/-- **Theorem 17.3(c) (`|f|ᵖ` is subharmonic for `0 < p`, RCA p. 336):**
For any `f ∈ H(Ω)` on a region `Ω ⊆ ℂ` and `0 < p`, `z ↦ ‖f z‖ ^ p` is subharmonic in `Ω`. -/
theorem subharmonicOn_rpow_norm_region {Ω : Set ℂ} {f : ℂ → ℂ}
    (hΩ : IsRegion Ω) (hf : HolomorphicOn f Ω) {p : ℝ} (hp : 0 < p) :
    SubharmonicOn Ω (fun z ↦ ((‖f z‖ ^ p : ℝ) : EReal)) := by
  by_cases hne : ∃ z₀ ∈ Ω, f z₀ ≠ 0
  · have hsub_log := subharmonicOn_eLogNorm hΩ hf hne
    have hmono : Monotone (fun t : ℝ ↦ Real.exp (p * t)) :=
      fun _ _ hab ↦ Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hab hp.le)
    have hconv : ConvexOn ℝ Set.univ (fun t : ℝ ↦ Real.exp (p * t)) := by
      simpa [Function.comp_def] using
        convexOn_exp.comp_linearMap (LinearMap.mulLeft ℝ p)
    refine (theorem17_2 hsub_log hmono hconv).congr fun z _ ↦ ?_
    by_cases hfz : f z = 0
    · simp only [hfz, eLogNorm_zero, extendMonotoneToBot_bot, norm_zero, Real.zero_rpow hp.ne']
      refine le_antisymm ?_ (le_iInf fun x ↦ EReal.coe_nonneg.mpr (Real.exp_pos _).le)
      have hlim : Tendsto (fun x : ℝ ↦ (Real.exp (p * x) : EReal)) atBot
          (𝓝 ((0 : ℝ) : EReal)) := by
        rw [EReal.tendsto_coe]
        exact Real.tendsto_exp_atBot.comp (tendsto_id.const_mul_atBot hp)
      exact (tendsto_nhds_unique (tendsto_atBot_iInf fun a b hab ↦
        EReal.coe_le_coe_iff.mpr (hmono hab)) hlim).le
    · simp only [eLogNorm_of_ne_zero hfz, extendMonotoneToBot_coe]
      rw [Real.rpow_def_of_pos (norm_pos_iff.mpr hfz) p, mul_comm]
  · push Not at hne
    have h0 : SubharmonicOn Ω (fun _ ↦ ((0 : ℝ) : EReal)) :=
      theorem17_1 hΩ.1 (RudinRCA.Chapter11.node11_4_holomorphic_harmonic hΩ.1
        (differentiableOn_const (0 : ℂ)) |>.comp_clm hΩ.1 Complex.reCLM)
    refine h0.congr fun z hz ↦ ?_
    simp [hne z hz, Real.zero_rpow hp.ne']

/-- **Theorem 17.3 (RCA p. 336, packaged statement):**
If `Ω` is a region and `f ∈ H(Ω)` is not identically `0`, then `log|f|`, `log⁺|f|`, and `|f|ᵖ`
(`0 < p < ∞`) are subharmonic in `Ω`. -/
theorem theorem17_3 {Ω : Set ℂ} {f : ℂ → ℂ}
    (hΩ : IsRegion Ω) (hf : HolomorphicOn f Ω) (hne : ∃ z₀ ∈ Ω, f z₀ ≠ 0) :
    SubharmonicOn Ω (fun z ↦ eLogNorm (f z)) ∧
    SubharmonicOn Ω (fun z ↦ (Real.posLog ‖f z‖ : EReal)) ∧
    (∀ p : ℝ, 0 < p → SubharmonicOn Ω (fun z ↦ ((‖f z‖ ^ p : ℝ) : EReal))) :=
  ⟨subharmonicOn_eLogNorm hΩ hf hne,
   subharmonicOn_posLog_norm_region hΩ hf,
   fun _ hp ↦ subharmonicOn_rpow_norm_region hΩ hf hp⟩

/-! ### Node 17.4: Harmonic Majorization on Compact Sets (RCA pp. 336–337) -/

private theorem integral_circleMeasure_lt_of_continuous_le_of_exists_lt
    {g : FourierCircle → ℝ} {m : ℝ} (hg_cont : Continuous g)
    (h_le : ∀ ζ : FourierCircle, g ζ ≤ m) (hex : ∃ ζ₀ : FourierCircle, g ζ₀ < m) :
    ∫ ζ, g ζ ∂circleMeasure < m := by
  obtain ⟨ζ₀, hlt⟩ := hex
  let d : FourierCircle → ℝ := fun ζ ↦ m - g ζ
  have hd_cont : Continuous d := continuous_const.sub hg_cont
  have hd_nonneg : ∀ ζ : FourierCircle, 0 ≤ d ζ := fun ζ ↦ sub_nonneg.mpr (h_le ζ)
  have hd_pos : 0 < d ζ₀ := sub_pos.mpr hlt
  let U : Set FourierCircle := {ζ : FourierCircle | d ζ₀ / 2 < d ζ}
  have hU_open : IsOpen U := isOpen_lt continuous_const hd_cont
  have hζ₀_mem : ζ₀ ∈ U := half_lt_self hd_pos
  have hU_pos : circleMeasure U ≠ 0 :=
    hU_open.measure_ne_zero circleMeasure ⟨ζ₀, hζ₀_mem⟩
  have hU_lt_top : circleMeasure U < ⊤ :=
    (measure_mono (subset_univ U)).trans_lt (by simp)
  have hU_real_pos : 0 < (circleMeasure U).toReal :=
    ENNReal.toReal_pos hU_pos hU_lt_top.ne
  have hind_int : Integrable (U.indicator fun _ : FourierCircle ↦ d ζ₀ / 2) circleMeasure :=
    (integrable_const (d ζ₀ / 2)).indicator hU_open.measurableSet
  have hd_int : Integrable d circleMeasure :=
    hd_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hg_int : Integrable g circleMeasure :=
    hg_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hind_le : ∀ ζ : FourierCircle,
      U.indicator (fun _ : FourierCircle ↦ d ζ₀ / 2) ζ ≤ d ζ := by
    intro ζ
    by_cases hζ : ζ ∈ U
    · rw [indicator_of_mem hζ]
      exact ( hζ : d ζ₀ / 2 < d ζ ).le
    · rw [indicator_of_notMem hζ]
      exact hd_nonneg ζ
  have hint_pos : 0 < ∫ ζ, d ζ ∂circleMeasure := by
    calc (0 : ℝ)
        < (circleMeasure U).toReal * (d ζ₀ / 2) := mul_pos hU_real_pos (half_pos hd_pos)
      _ = ∫ _ in U, (d ζ₀ / 2) ∂circleMeasure := by
          rw [setIntegral_const, Measure.real, smul_eq_mul]
      _ = ∫ ζ, U.indicator (fun _ : FourierCircle ↦ d ζ₀ / 2) ζ ∂circleMeasure :=
          (integral_indicator hU_open.measurableSet).symm
      _ ≤ ∫ ζ, d ζ ∂circleMeasure :=
          integral_mono hind_int hd_int hind_le
  have hint_sub : ∫ ζ, d ζ ∂circleMeasure = m - ∫ ζ, g ζ ∂circleMeasure := by
    dsimp [d]
    rw [integral_sub (integrable_const m) hg_int, integral_const, Measure.real,
      measure_univ, ENNReal.toReal_one, one_smul]
  linarith

/-- For a compact set `K ⊆ ℂ`, `frontier K = K \ interior K`. -/
theorem frontier_eq_diff_interior_of_isCompact {K : Set ℂ} (hK : IsCompact K) :
    frontier K = K \ interior K := by
  rw [frontier, hK.isClosed.closure_eq]

/-- **Theorem 17.4 (Harmonic majorant comparison principle, RCA pp. 336–337):**
Suppose `u : ℂ → ℝ` is continuous and subharmonic on an open set `Ω ⊆ ℂ`, `K ⊆ Ω` is compact,
`h : ℂ → ℝ` is continuous on `K` and harmonic in `interior K`, and `u(z) ≤ h(z)` at every boundary
point `z ∈ frontier K` (`= K \ interior K`). Then `u(z) ≤ h(z)` for all `z ∈ K`. -/
theorem theorem17_4 {Ω K : Set ℂ} {u h : ℂ → ℝ}
    (hu_cont : ContinuousOn u Ω)
    (hu_sub : SubharmonicOn Ω (fun z ↦ (u z : EReal)))
    (hK : IsCompact K) (hKΩ : K ⊆ Ω)
    (hh_cont : ContinuousOn h K)
    (hh_harm : RudinRCA.Chapter11.HarmonicOn h (interior K))
    (h_bdry : ∀ z ∈ frontier K, u z ≤ h z) :
    ∀ z ∈ K, u z ≤ h z := by
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · exact fun _ hz ↦ False.elim hz
  let v : ℂ → ℝ := fun z ↦ u z - h z
  have hv_cont : ContinuousOn v K := (hu_cont.mono hKΩ).sub hh_cont
  obtain ⟨z₁, hz₁K, hz₁max⟩ := hK.exists_isMaxOn hKne hv_cont
  let m : ℝ := v z₁
  have hv_le_m : ∀ z ∈ K, v z ≤ m := fun z hz ↦ hz₁max hz
  by_cases hm_nonpos : m ≤ 0
  · intro z hz
    have : u z - h z ≤ 0 := (hv_le_m z hz).trans hm_nonpos
    linarith
  · exfalso
    have hm_pos : 0 < m := not_le.mp hm_nonpos
    let E : Set ℂ := K ∩ v ⁻¹' Set.Ici m
    have hE_compact : IsCompact E :=
      hv_cont.upperSemicontinuousOn.isCompact_inter_preimage_Ici hK m
    have hz₁E : z₁ ∈ E := ⟨hz₁K, show m ≤ v z₁ from le_rfl⟩
    obtain ⟨z₀, hz₀E, hz₀_norm_max⟩ :=
      hE_compact.exists_isMaxOn ⟨z₁, hz₁E⟩ continuous_norm.continuousOn
    have hz₀K : z₀ ∈ K := hz₀E.1
    have hv_z₀ : v z₀ = m := le_antisymm (hv_le_m z₀ hz₀K) hz₀E.2
    have hz₀_int : z₀ ∈ interior K := by
      by_contra hz₀_nint
      have hz₀_fr : z₀ ∈ frontier K := by
        rw [frontier_eq_diff_interior_of_isCompact hK]
        exact ⟨hz₀K, hz₀_nint⟩
      have hle := h_bdry z₀ hz₀_fr
      dsimp [v] at hv_z₀
      linarith
    obtain ⟨R, hR_pos, hball_int⟩ := Metric.isOpen_iff.mp isOpen_interior z₀ hz₀_int
    let r : ℝ := R / 2
    have hr_pos : 0 < r := half_pos hR_pos
    have hcb_int : Metric.closedBall z₀ r ⊆ interior K :=
      (Metric.closedBall_subset_ball (half_lt_self hR_pos)).trans hball_int
    have hcb_K : Metric.closedBall z₀ r ⊆ K := hcb_int.trans interior_subset
    have hcb_Ω : Metric.closedBall z₀ r ⊆ Ω := hcb_K.trans hKΩ
    -- Exhibit a point on `sphere z₀ r` of strictly larger norm than `z₀`
    obtain ⟨w_strict, hw_sph, hw_norm_gt⟩ :
        ∃ w ∈ Metric.sphere z₀ r, ‖z₀‖ < ‖w‖ := by
      by_cases hz₀0 : z₀ = 0
      · subst hz₀0
        refine ⟨(r : ℂ), ?_, ?_⟩
        · simp [abs_of_pos hr_pos]
        · simp [abs_of_pos hr_pos, hr_pos]
      · have hnorm_pos : 0 < ‖z₀‖ := norm_pos_iff.mpr hz₀0
        let w : ℂ := ((1 + r / ‖z₀‖ : ℝ) : ℂ) * z₀
        refine ⟨w, ?_, ?_⟩
        · rw [Metric.mem_sphere, dist_eq_norm]
          have hsub_eq : w - z₀ = ((r / ‖z₀‖ : ℝ) : ℂ) * z₀ := by dsimp [w]; push_cast; ring
          rw [hsub_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos (div_pos hr_pos hnorm_pos), div_mul_cancel₀ r hnorm_pos.ne']
        · dsimp [w]
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos (by positivity : 0 < 1 + r / ‖z₀‖), add_mul, one_mul,
            div_mul_cancel₀ r hnorm_pos.ne']
          linarith
    have hw_K : w_strict ∈ K := hcb_K (Metric.sphere_subset_closedBall hw_sph)
    have hw_lt_m : v w_strict < m := by
      by_contra hge
      have hw_E : w_strict ∈ E := ⟨hw_K, not_lt.mp hge⟩
      have hle_norm : ‖w_strict‖ ≤ ‖z₀‖ := hz₀_norm_max hw_E
      linarith
    have hw_unit : (w_strict - z₀) / (r : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
      rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hr_pos, div_eq_one_iff_eq hr_pos.ne']
      simpa [Metric.mem_sphere, dist_eq_norm] using hw_sph
    obtain ⟨ζ₀, hζ₀⟩ := circlePoint_surjective_sphere hw_unit
    have hζ₀_eq : z₀ + (r : ℂ) * circlePoint ζ₀ = w_strict := by
      rw [hζ₀]
      have hr_ne : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr_pos.ne'
      field_simp [hr_ne]
      ring
    have hv_circ_cont : Continuous (fun ζ : FourierCircle ↦ v (z₀ + (r : ℂ) * circlePoint ζ)) :=
      hv_cont.comp_continuous
        (continuous_const.add (continuous_const.mul continuous_circlePoint))
        fun ζ ↦ hcb_K (affine_circlePoint_mem_closedBall z₀ hr_pos.le ζ)
    have hv_mean_lt : ∫ ζ, v (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure < m :=
      integral_circleMeasure_lt_of_continuous_le_of_exists_lt hv_circ_cont
        (fun ζ ↦ hv_le_m _ (hcb_K (affine_circlePoint_mem_closedBall z₀ hr_pos.le ζ)))
        ⟨ζ₀, by rwa [hζ₀_eq]⟩
    -- Compare with submean of `u` and mean-value equality of `h`
    have hu_circ_cont : Continuous (fun ζ : FourierCircle ↦ u (z₀ + (r : ℂ) * circlePoint ζ)) :=
      hu_cont.comp_continuous
        (continuous_const.add (continuous_const.mul continuous_circlePoint))
        fun ζ ↦ hcb_Ω (affine_circlePoint_mem_closedBall z₀ hr_pos.le ζ)
    have hh_circ_cont : Continuous (fun ζ : FourierCircle ↦ h (z₀ + (r : ℂ) * circlePoint ζ)) :=
      hh_cont.comp_continuous
        (continuous_const.add (continuous_const.mul continuous_circlePoint))
        fun ζ ↦ hcb_K (affine_circlePoint_mem_closedBall z₀ hr_pos.le ζ)
    obtain ⟨hmean_nb, hu_le_mean⟩ := hu_sub.submean z₀ r hr_pos hcb_Ω
    have hchar := (erealCircleMean_ne_bot_iff hu_sub.isOpen hu_sub.lt_top
      hu_sub.upperSemicontinuousOn hr_pos.le hcb_Ω).2 hmean_nb
    rw [hchar] at hu_le_mean
    simp only [EReal.toReal_coe, EReal.coe_le_coe_iff] at hu_le_mean
    have hh_eq_mean : h z₀ = ∫ ζ, h (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure := by
      rw [integral_circleMeasure_eq_circleAverage,
        (RudinRCA.Chapter11.theorem11_12_real isOpen_interior hh_harm).1 hr_pos hcb_int]
    have hv_int_eq : ∫ ζ, v (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure =
        (∫ ζ, u (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure) -
          ∫ ζ, h (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure :=
      integral_sub
        (hu_circ_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
        (hh_circ_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
    dsimp [v] at hv_z₀
    linarith

/-- Formulation of Theorem 17.4 directly using `K \ interior K` as in Rudin p. 336 (`K - V`). -/
theorem theorem17_4_diff_interior {Ω K : Set ℂ} {u h : ℂ → ℝ}
    (hu_cont : ContinuousOn u Ω)
    (hu_sub : SubharmonicOn Ω (fun z ↦ (u z : EReal)))
    (hK : IsCompact K) (hKΩ : K ⊆ Ω)
    (hh_cont : ContinuousOn h K)
    (hh_harm : RudinRCA.Chapter11.HarmonicOn h (interior K))
    (h_bdry : ∀ z ∈ K \ interior K, u z ≤ h z) :
    ∀ z ∈ K, u z ≤ h z := by
  refine theorem17_4 hu_cont hu_sub hK hKΩ hh_cont hh_harm ?_
  rwa [frontier_eq_diff_interior_of_isCompact hK]

/-! ### Node 17.5: Monotonicity of Circle Means on the Unit Disc (RCA p. 337) -/

theorem isRegion_unitDisc : IsRegion (Metric.ball (0 : ℂ) 1) :=
  ⟨Metric.isOpen_ball,
    ⟨⟨0, Metric.mem_ball_self zero_lt_one⟩, (convex_ball (0 : ℂ) 1).isPreconnected⟩⟩

/-- **Theorem 17.5 (Radial monotonicity of circle means, RCA p. 337):**
If `u : ℂ → ℝ` is continuous and subharmonic on the open unit disc `U = ball 0 1`, and
`0 ≤ r₁ ≤ r₂ < 1`, then the circle mean of `u` on `|z| = r₁` is at most the circle mean on
`|z| = r₂`. -/
theorem theorem17_5 {u : ℂ → ℝ}
    (hu_cont : ContinuousOn u (Metric.ball (0 : ℂ) 1))
    (hu_sub : SubharmonicOn (Metric.ball (0 : ℂ) 1) (fun z ↦ (u z : EReal)))
    {r₁ r₂ : ℝ} (hr₁ : 0 ≤ r₁) (hr₁₂ : r₁ ≤ r₂) (hr₂ : r₂ < 1) :
    ∫ ζ, u ((r₁ : ℂ) * circlePoint ζ) ∂circleMeasure ≤
      ∫ ζ, u ((r₂ : ℂ) * circlePoint ζ) ∂circleMeasure := by
  rcases hr₁₂.eq_or_lt with rfl | hr_lt
  · exact le_rfl
  have hr₂_pos : 0 < r₂ := hr₁.trans_lt hr_lt
  have hr₂_ne : (r₂ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr₂_pos.ne'
  -- Rescaled boundary function on `T = sphere 0 1`
  let g : ℂ → ℂ := fun w ↦ (u ((r₂ : ℂ) * w) : ℂ)
  have hg_cont : ContinuousOn g (Metric.sphere (0 : ℂ) 1) := by
    refine Complex.continuous_ofReal.comp_continuousOn
      (hu_cont.comp (continuous_const.mul continuous_id).continuousOn fun w hw ↦ ?_)
    have hw1 : ‖w‖ = 1 := by simpa [Metric.mem_sphere] using hw
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr₂_pos, hw1] using hr₂
  obtain ⟨hP_cont_c, hP_harm_c, _, hP_sph_c⟩ := RudinRCA.Chapter11.theorem11_8 hg_cont
  let H₁ : ℂ → ℝ := fun w ↦ (RudinRCA.Chapter11.poissonExtension g w).re
  have hH₁_cont : ContinuousOn H₁ (Metric.closedBall (0 : ℂ) 1) :=
    Complex.continuous_re.comp_continuousOn hP_cont_c
  have hH₁_harm : RudinRCA.Chapter11.HarmonicOn H₁ (Metric.ball (0 : ℂ) 1) :=
    hP_harm_c.comp_clm Metric.isOpen_ball Complex.reCLM
  have hH₁_sph : ∀ ζ ∈ Metric.sphere (0 : ℂ) 1, H₁ ζ = u ((r₂ : ℂ) * ζ) := by
    intro ζ hζ
    dsimp [H₁]
    rw [hP_sph_c ζ hζ]
    simp [g]
  -- Rescale `H₁` to `K = closedBall 0 r₂`
  let h : ℂ → ℝ := fun z ↦ H₁ (z / (r₂ : ℂ))
  have hmap_cb : MapsTo (fun z : ℂ ↦ z / (r₂ : ℂ))
      (Metric.closedBall (0 : ℂ) r₂) (Metric.closedBall (0 : ℂ) 1) := by
    intro z hz
    rw [Metric.mem_closedBall, dist_zero_right, norm_div, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hr₂_pos, div_le_one hr₂_pos]
    simpa [Metric.mem_closedBall] using hz
  have hmap_ball : MapsTo (fun z : ℂ ↦ z / (r₂ : ℂ))
      (Metric.ball (0 : ℂ) r₂) (Metric.ball (0 : ℂ) 1) := by
    intro z hz
    rw [Metric.mem_ball, dist_zero_right, norm_div, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hr₂_pos, div_lt_one hr₂_pos]
    simpa [Metric.mem_ball] using hz
  have hh_cont : ContinuousOn h (Metric.closedBall (0 : ℂ) r₂) :=
    hH₁_cont.comp (continuous_id.div_const (r₂ : ℂ)).continuousOn hmap_cb
  -- `h` is harmonic on `ball 0 r₂ = interior (closedBall 0 r₂)` via Herglotz representation 11.9
  obtain ⟨hH₁_P, hH₁_H, hG_diff, _⟩ := RudinRCA.Chapter11.theorem11_9_real hH₁_cont hH₁_harm
  have hh_harm_ball : RudinRCA.Chapter11.HarmonicOn h (Metric.ball (0 : ℂ) r₂) := by
    let G₂ : ℂ → ℂ := fun z ↦
      Real.circleAverage (fun ζ ↦ herglotzRieszKernel 0 (z / (r₂ : ℂ)) ζ • (H₁ ζ : ℂ)) 0 1
    have hG₂_diff : DifferentiableOn ℂ G₂ (Metric.ball (0 : ℂ) r₂) :=
      hG_diff.comp (differentiable_id.div_const (r₂ : ℂ)).differentiableOn hmap_ball
    have hG₂_harm : RudinRCA.Chapter11.HarmonicOn (fun z ↦ (G₂ z).re) (Metric.ball (0 : ℂ) r₂) :=
      (RudinRCA.Chapter11.node11_4_holomorphic_harmonic Metric.isOpen_ball hG₂_diff).comp_clm
        Metric.isOpen_ball Complex.reCLM
    refine hG₂_harm.congr_of_isOpen Metric.isOpen_ball fun z hz ↦ ?_
    exact (hH₁_H (z / (r₂ : ℂ)) (hmap_ball hz)).symm
  have hint_eq : interior (Metric.closedBall (0 : ℂ) r₂) = Metric.ball (0 : ℂ) r₂ :=
    interior_closedBall (0 : ℂ) hr₂_pos.ne'
  have hh_harm : RudinRCA.Chapter11.HarmonicOn h (interior (Metric.closedBall (0 : ℂ) r₂)) := by
    rwa [hint_eq]
  have hu_le_h : ∀ z ∈ Metric.closedBall (0 : ℂ) r₂, u z ≤ h z := by
    refine theorem17_4 hu_cont hu_sub (isCompact_closedBall 0 r₂)
      (Metric.closedBall_subset_ball hr₂) hh_cont hh_harm ?_
    rw [frontier_closedBall (0 : ℂ) hr₂_pos.ne']
    intro z hz
    have hzs : z / (r₂ : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
      rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hr₂_pos, div_eq_one_iff_eq hr₂_pos.ne']
      simpa [Metric.mem_sphere] using hz
    dsimp [h]
    rw [hH₁_sph (z / (r₂ : ℂ)) hzs, mul_div_cancel₀ z hr₂_ne]
  -- Integrate `u ≤ h` on the circle of radius `r₁`
  have hu_r₁_cont : Continuous (fun ζ : FourierCircle ↦ u ((r₁ : ℂ) * circlePoint ζ)) :=
    hu_cont.comp_continuous (continuous_const.mul continuous_circlePoint) fun ζ ↦ by
      have := affine_circlePoint_mem_closedBall 0 hr₁ ζ
      rw [zero_add] at this
      exact (Metric.closedBall_subset_ball (hr_lt.trans hr₂)) this
  have hh_r₁_cont : Continuous (fun ζ : FourierCircle ↦ h ((r₁ : ℂ) * circlePoint ζ)) :=
    hh_cont.comp_continuous (continuous_const.mul continuous_circlePoint) fun ζ ↦ by
      have := affine_circlePoint_mem_closedBall 0 hr₁ ζ
      rw [zero_add] at this
      exact (Metric.closedBall_subset_closedBall hr₁₂) this
  have hint_le : ∫ ζ, u ((r₁ : ℂ) * circlePoint ζ) ∂circleMeasure ≤
      ∫ ζ, h ((r₁ : ℂ) * circlePoint ζ) ∂circleMeasure := by
    refine integral_mono
      (hu_r₁_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
      (hh_r₁_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
      fun ζ ↦ hu_le_h _ ?_
    have := affine_circlePoint_mem_closedBall 0 hr₁ ζ
    rw [zero_add] at this
    exact (Metric.closedBall_subset_closedBall hr₁₂) this
  -- `∫ h(r₁ e^{iθ}) = h(0) = H₁(0)`
  have hh_mean_r₁ : ∫ ζ, h ((r₁ : ℂ) * circlePoint ζ) ∂circleMeasure = h 0 := by
    rcases hr₁.eq_or_lt with rfl | hr₁_pos
    · simp
    · have h0_add : (fun ζ : FourierCircle ↦ h ((r₁ : ℂ) * circlePoint ζ)) =
          fun ζ : FourierCircle ↦ h (0 + (r₁ : ℂ) * circlePoint ζ) := by
        funext ζ; rw [zero_add]
      rw [h0_add, integral_circleMeasure_eq_circleAverage,
        (RudinRCA.Chapter11.theorem11_12_real Metric.isOpen_ball hh_harm_ball).1 hr₁_pos
          (Metric.closedBall_subset_ball hr_lt)]
  -- `h 0 = H₁ 0 = poissonIntegral H₁ 0 = ∫ u(r₂ e^{iθ})`
  have hh0_eq : h 0 = ∫ ζ, u ((r₂ : ℂ) * circlePoint ζ) ∂circleMeasure := by
    have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
    have hH0 : h 0 = RudinRCA.Chapter11.poissonIntegral H₁ 0 := by
      dsimp [h]
      rw [zero_div]
      exact hH₁_P 0 h0_mem
    rw [hH0]
    unfold RudinRCA.Chapter11.poissonIntegral
    have hca_eq : Real.circleAverage (fun ζ ↦ _root_.poissonKernel 0 0 ζ • H₁ ζ) 0 1 =
        Real.circleAverage (fun ζ ↦ u ((r₂ : ℂ) * ζ)) 0 1 := by
      refine Real.circleAverage_congr_sphere fun ζ hζ ↦ ?_
      have hζ' : ζ ∈ Metric.sphere (0 : ℂ) 1 := by simpa using hζ
      have hζ1 : ‖ζ‖ = 1 := by simpa [Metric.mem_sphere] using hζ'
      have hpk1 : _root_.poissonKernel 0 0 ζ = 1 := by
        simp [_root_.poissonKernel, hζ1]
      rw [hpk1, one_smul, hH₁_sph ζ hζ']
    rw [hca_eq, ← integral_circleMeasure_eq_circleAverage (fun ζ ↦ u ((r₂ : ℂ) * ζ)) 0 1]
    simp
  linarith

/-- Interval-integral formulation of Theorem 17.5 on `[-π, π]`, matching Rudin 17.5 p. 337. -/
theorem theorem17_5_intervalIntegral {u : ℂ → ℝ}
    (hu_cont : ContinuousOn u (Metric.ball (0 : ℂ) 1))
    (hu_sub : SubharmonicOn (Metric.ball (0 : ℂ) 1) (fun z ↦ (u z : EReal)))
    {r₁ r₂ : ℝ} (hr₁ : 0 ≤ r₁) (hr₁₂ : r₁ ≤ r₂) (hr₂ : r₂ < 1) :
    (2 * Real.pi)⁻¹ * (∫ θ in -Real.pi..Real.pi,
        u ((r₁ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))) ≤
      (2 * Real.pi)⁻¹ * (∫ θ in -Real.pi..Real.pi,
        u ((r₂ : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))) := by
  have h := theorem17_5 hu_cont hu_sub hr₁ hr₁₂ hr₂
  simpa only [RudinRCA.Chapter04.circleIntegral_interval, circlePoint_coe, one_div, smul_eq_mul]
    using h

/-! ### Node 17.6: Radial Slices and Circle Sizes `‖f_r‖_p` (`0 ≤ p ≤ ∞`) (RCA p. 337) -/

/-- **17.6 (Radial slice `f_r`, RCA p. 337):**
`f_r(e^{iθ}) = f(r e^{iθ})` viewed as a function on `FourierCircle`. -/
def radialSlice (f : ℂ → ℂ) (r : ℝ) (ζ : RudinRCA.Chapter04.FourierCircle) : ℂ :=
  f ((r : ℂ) * circlePoint ζ)

/-- **17.6 (`p = 0` radial size `‖f_r‖₀`, RCA p. 337):**
`‖f_r‖₀ = exp ∫_T log⁺ |f_r| dσ`. -/
def radialZeroSize (f : ℂ → ℂ) (r : ℝ) : ℝ :=
  Real.exp (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂RudinRCA.Chapter04.circleMeasure)

/-- **17.6 (Extended-nonnegative radial size `‖f_r‖_p`, RCA p. 337):**
Equals `ENNReal.ofReal (radialZeroSize f r)` for `p = 0`, and `eLpNorm (radialSlice f r) p σ`
for `0 < p ≤ ∞`. -/
def radialSizeENNReal (p : ℝ≥0∞) (f : ℂ → ℂ) (r : ℝ) : ℝ≥0∞ :=
  if p = 0 then ENNReal.ofReal (radialZeroSize f r)
  else MeasureTheory.eLpNorm (radialSlice f r) p RudinRCA.Chapter04.circleMeasure

/-- **17.6 (Real-valued radial size `‖f_r‖_p`, RCA p. 337).** -/
def radialSize (p : ℝ≥0∞) (f : ℂ → ℂ) (r : ℝ) : ℝ :=
  (radialSizeENNReal p f r).toReal

/-- **17.7 (Extended-nonnegative Hardy/Nevanlinna size `‖f‖_p`, RCA pp. 337–338):**
`‖f‖_p = sup_{0 ≤ r < 1} ‖f_r‖_p`. -/
def hardySizeENNReal (p : ℝ≥0∞) (f : ℂ → ℂ) : ℝ≥0∞ :=
  ⨆ r ∈ Set.Ico (0 : ℝ) 1, radialSizeENNReal p f r

/-- **17.7 (Real-valued Hardy/Nevanlinna size `‖f‖_p`, RCA pp. 337–338).** -/
def hardySize (p : ℝ≥0∞) (f : ℂ → ℂ) : ℝ :=
  (hardySizeENNReal p f).toReal

/-- **17.7 (Hardy space membership `f ∈ Hᵖ`, `0 < p ≤ ∞`, RCA p. 337):**
`f ∈ H(U)` and `‖f‖_p < ∞` (`0 < p ≤ ∞`, `∞` explicitly included per `SCOPING-G.md` Caution 7). -/
def IsInHardySpace (p : ℝ≥0∞) (f : ℂ → ℂ) : Prop :=
  p ≠ 0 ∧ HolomorphicOn f (Metric.ball (0 : ℂ) 1) ∧ hardySizeENNReal p f < ⊤

/-- **17.7 (Nevanlinna class membership `f ∈ N`, RCA p. 338):**
`f ∈ H(U)` and `‖f‖₀ = sup_{0 ≤ r < 1} exp ∫_T log⁺|f_r| dσ < ∞`. -/
def IsInNevanlinnaClassCh17 (f : ℂ → ℂ) : Prop :=
  HolomorphicOn f (Metric.ball (0 : ℂ) 1) ∧ hardySizeENNReal 0 f < ⊤

theorem continuous_radialSlice_of_holomorphicOn {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Continuous (radialSlice f r) := by
  refine (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).comp_continuous
    (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_
  simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hr0] using hr1

theorem memLp_circleMeasure_of_continuous {E : Type*} [NormedAddCommGroup E]
    {g : FourierCircle → E} (hg : Continuous g) (p : ℝ≥0∞) :
    MemLp g p circleMeasure := by
  obtain ⟨ζ_max, _, hmax⟩ := isCompact_univ.exists_isMaxOn univ_nonempty hg.norm.continuousOn
  exact MemLp.of_bound hg.aestronglyMeasurable ‖g ζ_max‖
    (Eventually.of_forall fun ζ ↦ hmax (mem_univ ζ))

theorem memLp_radialSlice_of_continuous {f : ℂ → ℂ} {r : ℝ}
    (hcont : Continuous (radialSlice f r)) (p : ℝ≥0∞) :
    MemLp (radialSlice f r) p circleMeasure :=
  memLp_circleMeasure_of_continuous hcont p

theorem eLpNorm_top_eq_iSup_of_continuous (g : FourierCircle → ℂ) (hg : Continuous g) :
    eLpNorm g ⊤ circleMeasure = ⨆ ζ : FourierCircle, ‖g ζ‖ₑ := by
  rw [eLpNorm_exponent_top hg.aestronglyMeasurable, eLpNormEssSup_eq_essSup_enorm]
  have hg_enorm : Continuous (fun ζ : FourierCircle ↦ ‖g ζ‖ₑ) := by
    simpa only [enorm_eq_nnnorm, Function.comp_def] using ENNReal.continuous_coe.comp hg.nnnorm
  exact (iSup_eq_essSup fun ζ _ ha ↦
    (isOpen_lt continuous_const hg_enorm).measure_ne_zero circleMeasure ⟨ζ, ha⟩).symm

theorem radialSizeENNReal_lt_top_of_continuous {f : ℂ → ℂ} {r : ℝ}
    (hcont : Continuous (radialSlice f r)) (p : ℝ≥0∞) :
    radialSizeENNReal p f r < ⊤ := by
  unfold radialSizeENNReal
  split_ifs with hp0
  · exact ENNReal.ofReal_lt_top
  · exact (memLp_radialSlice_of_continuous hcont p).eLpNorm_lt_top

/-- **17.6(a) (Normalized circle measure has total mass `1`, RCA p. 337).** -/
theorem circleMeasure_univ_eq_one : circleMeasure Set.univ = 1 :=
  measure_univ

/-- **17.6(b) (`Lᵖ` interval-integral formula for `radialSize p f r`, `0 < p < ∞`, RCA p. 337).** -/
theorem radialSize_eq_intervalIntegral {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ⊤)
    {f : ℂ → ℂ} {r : ℝ} (hcont : Continuous (radialSlice f r)) :
    radialSize p f r =
      ((2 * Real.pi)⁻¹ * ∫ θ in -Real.pi..Real.pi,
        ‖f ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))‖ ^ p.toReal) ^ p.toReal⁻¹ := by
  unfold radialSize radialSizeENNReal
  rw [ite_eq_right_iff.mpr fun h ↦ absurd h hp0]
  rw [(memLp_radialSlice_of_continuous hcont p).eLpNorm_eq_integral_rpow_norm hp0 hptop,
    ENNReal.toReal_ofReal (by positivity), RudinRCA.Chapter04.circleIntegral_interval]
  simp only [radialSlice, circlePoint_coe, one_div, smul_eq_mul]

/-- **17.6(c) (`L^∞` supremum formula for `radialSize ⊤ f r`, RCA p. 337).** -/
theorem radialSize_top_eq_iSup {f : ℂ → ℂ} {r : ℝ} (hcont : Continuous (radialSlice f r)) :
    radialSize ⊤ f r = ⨆ θ : ℝ, ‖f ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))‖ := by
  unfold radialSize radialSizeENNReal
  rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
    eLpNorm_top_eq_iSup_of_continuous _ hcont]
  obtain ⟨ζ_max, _, hmax⟩ := isCompact_univ.exists_isMaxOn univ_nonempty hcont.norm.continuousOn
  have hiSup_enn : (⨆ ζ : FourierCircle, ‖radialSlice f r ζ‖ₑ) =
      ENNReal.ofReal ‖radialSlice f r ζ_max‖ := by
    refine le_antisymm (iSup_le fun ζ ↦ ?_) ?_
    · rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (hmax (mem_univ ζ))
    · rw [ofReal_norm]
      exact le_iSup (fun ζ : FourierCircle ↦ ‖radialSlice f r ζ‖ₑ) ζ_max
  rw [hiSup_enn, ENNReal.toReal_ofReal (norm_nonneg _)]
  have hbdd : BddAbove (Set.range fun θ : ℝ ↦ ‖radialSlice f r (θ : FourierCircle)‖) :=
    ⟨‖radialSlice f r ζ_max‖, by
      rintro _ ⟨θ, rfl⟩
      exact hmax (mem_univ _)⟩
  refine le_antisymm ?_ ?_
  · obtain ⟨θ₀, rfl⟩ := QuotientAddGroup.mk_surjective ζ_max
    simpa only [radialSlice, circlePoint_coe] using
      le_ciSup hbdd θ₀
  · refine ciSup_le fun θ ↦ ?_
    have hθ : ‖radialSlice f r (θ : FourierCircle)‖ ≤ ‖radialSlice f r ζ_max‖ :=
      hmax (mem_univ (θ : FourierCircle))
    simpa only [radialSlice, circlePoint_coe] using hθ

/-- **17.6(d) (`p = 0` exponential `log⁺` formula for `radialSize 0 f r`, RCA p. 337).** -/
theorem radialSize_zero_eq_exp_intervalIntegral (f : ℂ → ℂ) (r : ℝ) :
    radialSize 0 f r =
      Real.exp ((2 * Real.pi)⁻¹ * ∫ θ in -Real.pi..Real.pi,
        Real.posLog ‖f ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))‖) := by
  unfold radialSize radialSizeENNReal radialZeroSize
  simp only [↓reduceIte, Real.exp_pos, le_of_lt, ENNReal.toReal_ofReal]
  rw [RudinRCA.Chapter04.circleIntegral_interval]
  simp only [radialSlice, circlePoint_coe, one_div, smul_eq_mul]

/-- **17.6(e) (`‖f_r‖₀` is NOT a norm, RCA p. 337):**
`radialZeroSize 0 r = 1 ≠ 0` and positive homogeneity fails (`‖(1/2) · 1_r‖₀ = 1 ≠ (1/2) ‖1_r‖₀`). -/
theorem radialZeroSize_not_norm (r : ℝ) :
    radialZeroSize 0 r = 1 ∧
    radialZeroSize 0 r ≠ 0 ∧
    radialZeroSize ((1 / 2 : ℂ) • fun _ : ℂ ↦ (1 : ℂ)) r ≠
      ‖(1 / 2 : ℂ)‖ * radialZeroSize (fun _ : ℂ ↦ (1 : ℂ)) r := by
  have h0 : radialZeroSize 0 r = 1 := by
    simp [radialZeroSize, radialSlice]
  have h1 : radialZeroSize (fun _ : ℂ ↦ (1 : ℂ)) r = 1 := by
    simp [radialZeroSize, radialSlice]
  have hhalf : radialZeroSize ((1 / 2 : ℂ) • fun _ : ℂ ↦ (1 : ℂ)) r = 1 := by
    unfold radialZeroSize radialSlice
    have hpt : ∀ ζ : FourierCircle,
        Real.posLog ‖(((1 / 2 : ℂ) • fun _ : ℂ ↦ (1 : ℂ)) ((r : ℂ) * circlePoint ζ))‖ = 0 := by
      intro ζ
      have hval : ‖(((1 / 2 : ℂ) • fun _ : ℂ ↦ (1 : ℂ)) ((r : ℂ) * circlePoint ζ))‖ = 2⁻¹ := by
        simp [Pi.smul_apply]
      rw [hval, Real.posLog_eq_zero_iff]
      norm_num
    simp only [hpt, integral_zero, Real.exp_zero]
  refine ⟨h0, by rw [h0]; exact one_ne_zero, ?_⟩
  rw [hhalf, h1]
  norm_num

/-- **Node 17.6 (Packaged summary, RCA p. 337).** -/
theorem theorem17_6 (r : ℝ) :
    circleMeasure Set.univ = 1 ∧
    (∀ f : ℂ → ℂ, radialSize 0 f r =
      Real.exp ((2 * Real.pi)⁻¹ * ∫ θ in -Real.pi..Real.pi,
        Real.posLog ‖f ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I))‖)) ∧
    radialZeroSize 0 r = 1 ∧
    radialZeroSize ((1 / 2 : ℂ) • fun _ : ℂ ↦ (1 : ℂ)) r ≠
      ‖(1 / 2 : ℂ)‖ * radialZeroSize (fun _ : ℂ ↦ (1 : ℂ)) r :=
  ⟨circleMeasure_univ_eq_one,
   fun f ↦ radialSize_zero_eq_exp_intervalIntegral f r,
   (radialZeroSize_not_norm r).1,
   (radialZeroSize_not_norm r).2.2⟩

/-! ### Node 17.7: Definitions and Inclusion Chain `H^∞ ⊆ H^p ⊆ H^s ⊆ N` (RCA pp. 337–338) -/

/-- Characterization of `H^∞` as bounded holomorphic functions on `U = ball 0 1`, with
`hardySizeENNReal ⊤ f = ⨆ z ∈ ball 0 1, ‖f z‖ₑ`. -/
theorem hardySizeENNReal_top_eq_biSup {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    hardySizeENNReal ⊤ f = ⨆ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ₑ := by
  unfold hardySizeENNReal
  refine le_antisymm ?_ ?_
  · refine iSup₂_le fun r hr ↦ ?_
    have hcont := continuous_radialSlice_of_holomorphicOn hf hr.1 hr.2
    unfold radialSizeENNReal
    rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
      eLpNorm_top_eq_iSup_of_continuous _ hcont]
    refine iSup_le fun ζ ↦ ?_
    have hz_mem : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hr.1] using hr.2
    exact le_biSup (fun z ↦ ‖f z‖ₑ) hz_mem
  · refine iSup₂_le fun z hz ↦ ?_
    have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
    let r : ℝ := ‖z‖
    have hr_mem : r ∈ Set.Ico (0 : ℝ) 1 := ⟨norm_nonneg z, hz_lt⟩
    have hcont := continuous_radialSlice_of_holomorphicOn hf hr_mem.1 hr_mem.2
    obtain ⟨ζ, hζ⟩ : ∃ ζ : FourierCircle, (r : ℂ) * circlePoint ζ = z := by
      by_cases hz0 : z = 0
      · refine ⟨0, ?_⟩
        simp [r, hz0]
      · have hr_pos : 0 < r := norm_pos_iff.mpr hz0
        have hw : z / (r : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
          rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
            Real.norm_eq_abs, abs_of_pos hr_pos, div_self hr_pos.ne']
        obtain ⟨ζ, hζ⟩ := circlePoint_surjective_sphere hw
        refine ⟨ζ, ?_⟩
        rw [hζ, mul_div_cancel₀ z (Complex.ofReal_ne_zero.mpr hr_pos.ne')]
    calc ‖f z‖ₑ
        = ‖radialSlice f r ζ‖ₑ := by simp [radialSlice, hζ]
      _ ≤ radialSizeENNReal ⊤ f r := by
          unfold radialSizeENNReal
          rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
            eLpNorm_top_eq_iSup_of_continuous _ hcont]
          exact le_iSup (fun η ↦ ‖radialSlice f r η‖ₑ) ζ
      _ ≤ ⨆ ρ ∈ Set.Ico (0 : ℝ) 1, radialSizeENNReal ⊤ f ρ :=
          le_biSup (radialSizeENNReal ⊤ f) hr_mem

/-- Characterization of `IsInHardySpace ⊤ f` (`H^∞(U)`) as bounded holomorphic functions on `U`. -/
theorem isInHardySpace_top_iff (f : ℂ → ℂ) :
    IsInHardySpace ⊤ f ↔
      HolomorphicOn f (Metric.ball (0 : ℂ) 1) ∧
        BddAbove ((fun z ↦ ‖f z‖) '' Metric.ball (0 : ℂ) 1) := by
  unfold IsInHardySpace
  constructor
  · rintro ⟨_, hf, hlt⟩
    rw [hardySizeENNReal_top_eq_biSup hf] at hlt
    refine ⟨hf, (⨆ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ₑ).toReal, ?_⟩
    rintro _ ⟨z, hz, rfl⟩
    have hle : ‖f z‖ₑ ≤ ⨆ w ∈ Metric.ball (0 : ℂ) 1, ‖f w‖ₑ := le_biSup (fun w ↦ ‖f w‖ₑ) hz
    rw [← ofReal_norm] at hle
    exact (ENNReal.ofReal_le_iff_le_toReal hlt.ne).mp hle
  · rintro ⟨hf, M, hM⟩
    refine ⟨ENNReal.top_ne_zero, hf, ?_⟩
    rw [hardySizeENNReal_top_eq_biSup hf]
    refine lt_of_le_of_lt (iSup₂_le fun z hz ↦ ?_) (ENNReal.ofReal_lt_top (r := M))
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hM ⟨z, hz, rfl⟩)

/-- Characterization of `IsInNevanlinnaClassCh17 f` (`f ∈ N`) via boundedness of
`∫_T log⁺|f_r| dσ` over `0 < r < 1` (bridging Rudin 15.22 and 17.7). -/
theorem isInNevanlinnaClassCh17_iff (f : ℂ → ℂ) :
    IsInNevanlinnaClassCh17 f ↔
      HolomorphicOn f (Metric.ball (0 : ℂ) 1) ∧
        BddAbove ((fun r ↦ ∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) '' Set.Ioo 0 1) := by
  unfold IsInNevanlinnaClassCh17
  constructor
  · rintro ⟨hf, hlt⟩
    refine ⟨hf, Real.log (hardySize 0 f + 1), ?_⟩
    rintro _ ⟨r, hr, rfl⟩
    dsimp only
    have hr_Ico : r ∈ Set.Ico (0 : ℝ) 1 := ⟨hr.1.le, hr.2⟩
    have hle : radialSizeENNReal 0 f r ≤ hardySizeENNReal 0 f :=
      le_biSup (radialSizeENNReal 0 f) hr_Ico
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize] at hle
    have hexp_le : Real.exp (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) ≤
        hardySize 0 f :=
      (ENNReal.ofReal_le_iff_le_toReal hlt.ne).mp hle
    have hexp_lt : Real.exp (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) ≤
        hardySize 0 f + 1 := by linarith
    rw [← Real.log_exp (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure)]
    exact Real.log_le_log (Real.exp_pos _) hexp_lt
  · rintro ⟨hf, B, hB⟩
    refine ⟨hf, ?_⟩
    unfold hardySizeENNReal
    let M : ℝ := max (Real.posLog ‖f 0‖) B
    refine lt_of_le_of_lt (iSup₂_le fun r hr ↦ ?_) (ENNReal.ofReal_lt_top (r := Real.exp M))
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize]
    refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
    rcases hr.1.eq_or_lt with rfl | hr_pos
    · simp only [radialSlice, Complex.ofReal_zero, zero_mul, integral_const, Measure.real,
        measure_univ, ENNReal.toReal_one, one_smul]
      exact le_max_left _ _
    · exact (hB ⟨r, ⟨hr_pos, hr.2⟩, rfl⟩).trans (le_max_right _ _)

/-- Monotonicity of radial `L^p` sizes in the exponent: `radialSizeENNReal s f r ≤ radialSizeENNReal p f r`
whenever `0 < s ≤ p ≤ ∞` (since `circleMeasure univ = 1`). -/
theorem radialSizeENNReal_le_of_exponent_le {s p : ℝ≥0∞} (hs0 : s ≠ 0) (hsp : s ≤ p)
    (f : ℂ → ℂ) (r : ℝ) :
    radialSizeENNReal s f r ≤ radialSizeENNReal p f r := by
  have hp0 : p ≠ 0 := ne_of_gt ( (pos_iff_ne_zero.mpr hs0).trans_le hsp )
  simp only [radialSizeENNReal, hs0, hp0, ↓reduceIte]
  exact eLpNorm_le_eLpNorm_of_exponent_le hsp

theorem hardySizeENNReal_le_of_exponent_le {s p : ℝ≥0∞} (hs0 : s ≠ 0) (hsp : s ≤ p)
    (f : ℂ → ℂ) :
    hardySizeENNReal s f ≤ hardySizeENNReal p f :=
  iSup₂_mono fun r _ ↦ radialSizeENNReal_le_of_exponent_le hs0 hsp f r

/-- Inclusion `H^p ⊆ H^s` for `0 < s ≤ p ≤ ∞` (`∞` included per `SCOPING-G.md` Caution 7). -/
theorem IsInHardySpace.mono_exponent {s p : ℝ≥0∞} (hs0 : s ≠ 0) (hsp : s ≤ p)
    {f : ℂ → ℂ} (hf : IsInHardySpace p f) :
    IsInHardySpace s f :=
  ⟨hs0, hf.2.1, (hardySizeENNReal_le_of_exponent_le hs0 hsp f).trans_lt hf.2.2⟩

/-- Pointwise bound `σ * log⁺ t ≤ t ^ σ` for `σ : ℝ` and `0 ≤ t`. -/
private theorem mul_posLog_le_rpow {σ t : ℝ} (ht : 0 ≤ t) :
    σ * Real.posLog t ≤ t ^ σ := by
  rcases le_or_gt t 1 with ht1 | ht1
  · have hpl : Real.posLog t = 0 := by
      rw [Real.posLog_eq_zero_iff]
      rcases ht.eq_or_lt with rfl | hpos
      · norm_num
      · rwa [abs_of_pos hpos]
    rw [hpl, mul_zero]
    exact Real.rpow_nonneg ht σ
  · have ht_pos : 0 < t := zero_lt_one.trans ht1
    have hlog_pos : 0 < Real.log t := Real.log_pos ht1
    change σ * max 0 (Real.log t) ≤ t ^ σ
    rw [max_eq_right hlog_pos.le]
    have hlog_rpow : σ * Real.log t = Real.log (t ^ σ) := by
      rw [Real.log_rpow ht_pos, mul_comm]
    rw [hlog_rpow]
    have hrpow_pos : 0 < t ^ σ := Real.rpow_pos_of_pos ht_pos σ
    linarith [Real.log_le_sub_one_of_pos hrpow_pos]

/-- Inclusion `H^s ⊆ N` for every `0 < s ≤ ∞`. -/
theorem IsInHardySpace.toNevanlinna {s : ℝ≥0∞} {f : ℂ → ℂ}
    (hf : IsInHardySpace s f) :
    IsInNevanlinnaClassCh17 f := by
  rcases eq_or_ne s ⊤ with rfl | hstop
  · -- Reduce `H^∞` to `H^1`
    have hf1 : IsInHardySpace 1 f := hf.mono_exponent one_ne_zero le_top
    obtain ⟨hf_hol, hlt1⟩ := hf1.2
    rw [isInNevanlinnaClassCh17_iff]
    refine ⟨hf_hol, hardySize 1 f, ?_⟩
    rintro _ ⟨r, hr, rfl⟩
    have hcont := continuous_radialSlice_of_holomorphicOn hf_hol hr.1.le hr.2
    have hpos_int : Integrable (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) circleMeasure :=
      (Real.continuous_posLog.comp hcont.norm).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hnorm_int : Integrable (fun ζ ↦ ‖radialSlice f r ζ‖) circleMeasure :=
      hcont.norm.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    have h1 : ∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure ≤
        ∫ ζ, ‖radialSlice f r ζ‖ ∂circleMeasure := by
      refine integral_mono hpos_int hnorm_int fun ζ ↦ ?_
      simpa using mul_posLog_le_rpow (σ := 1) (norm_nonneg (radialSlice f r ζ))
    have h2 : ENNReal.ofReal (∫ ζ, ‖radialSlice f r ζ‖ ∂circleMeasure) =
        radialSizeENNReal 1 f r := by
      unfold radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h ↦ (one_ne_zero h).elim,
        (memLp_radialSlice_of_continuous hcont 1).eLpNorm_eq_integral_rpow_norm
          one_ne_zero ENNReal.one_ne_top]
      simp
    have h3 : radialSizeENNReal 1 f r ≤ hardySizeENNReal 1 f :=
      le_biSup (radialSizeENNReal 1 f) (⟨hr.1.le, hr.2⟩ : r ∈ Set.Ico (0 : ℝ) 1)
    exact h1.trans ((ENNReal.ofReal_le_iff_le_toReal hlt1.ne).mp (h2.trans_le h3))
  · obtain ⟨hs0, hf_hol, hlts⟩ := hf
    have hσ_pos : 0 < s.toReal := ENNReal.toReal_pos hs0 hstop
    rw [isInNevanlinnaClassCh17_iff]
    refine ⟨hf_hol, (hardySize s f) ^ s.toReal / s.toReal, ?_⟩
    rintro _ ⟨r, hr, rfl⟩
    have hcont := continuous_radialSlice_of_holomorphicOn hf_hol hr.1.le hr.2
    have hpos_int : Integrable (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) circleMeasure :=
      (Real.continuous_posLog.comp hcont.norm).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hrpow_cont : Continuous (fun ζ ↦ ‖radialSlice f r ζ‖ ^ s.toReal) :=
      hcont.norm.rpow_const fun _ ↦ Or.inr hσ_pos.le
    have hrpow_int : Integrable (fun ζ ↦ ‖radialSlice f r ζ‖ ^ s.toReal) circleMeasure :=
      hrpow_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    have hle_int : s.toReal * (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) ≤
        ∫ ζ, ‖radialSlice f r ζ‖ ^ s.toReal ∂circleMeasure := by
      rw [← integral_const_mul]
      exact integral_mono (hpos_int.const_mul s.toReal) hrpow_int fun ζ ↦
        mul_posLog_le_rpow (norm_nonneg _)
    have hrad_eq : ∫ ζ, ‖radialSlice f r ζ‖ ^ s.toReal ∂circleMeasure =
        (radialSize s f r) ^ s.toReal := by
      unfold radialSize radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h ↦ absurd h hs0,
        (memLp_radialSlice_of_continuous hcont s).eLpNorm_eq_integral_rpow_norm hs0 hstop,
        ENNReal.toReal_ofReal (by positivity),
        ← Real.rpow_mul (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _),
        inv_mul_cancel₀ hσ_pos.ne', Real.rpow_one]
    have hrad_le_hardy : radialSize s f r ≤ hardySize s f := by
      unfold radialSize hardySize
      exact ENNReal.toReal_mono hlts.ne
        (le_biSup (radialSizeENNReal s f) (⟨hr.1.le, hr.2⟩ : r ∈ Set.Ico (0 : ℝ) 1))
    have hrad_nonneg : 0 ≤ radialSize s f r := ENNReal.toReal_nonneg
    have hpow_le : (radialSize s f r) ^ s.toReal ≤ (hardySize s f) ^ s.toReal :=
      Real.rpow_le_rpow hrad_nonneg hrad_le_hardy hσ_pos.le
    rw [le_div_iff₀' hσ_pos]
    exact hle_int.trans (hrad_eq.trans_le hpow_le)

/-- **Theorem 17.7 (Inclusion chain `H^∞ ⊆ H^p ⊆ H^s ⊆ N`, RCA pp. 337–338):**
For `0 < s < p < ∞`, `H^∞ ⊆ H^p ⊆ H^s ⊆ N` (`∞` included per `SCOPING-G.md` Caution 7). -/
theorem theorem17_7 {s p : ℝ≥0∞} (hs0 : 0 < s) (hsp : s < p) (hptop : p < ⊤) (f : ℂ → ℂ) :
    (IsInHardySpace ⊤ f → IsInHardySpace p f) ∧
    (IsInHardySpace p f → IsInHardySpace s f) ∧
    (IsInHardySpace s f → IsInNevanlinnaClassCh17 f) ∧
    (IsInHardySpace ⊤ f → IsInNevanlinnaClassCh17 f) :=
  have hp0 : p ≠ 0 := (hs0.trans hsp).ne'
  let _ := hptop
  ⟨fun h ↦ h.mono_exponent hp0 le_top,
   fun h ↦ h.mono_exponent hs0.ne' hsp.le,
   fun h ↦ h.toNevanlinna,
   fun h ↦ h.toNevanlinna⟩

/-! ### Node 17.8(a): Radial Monotonicity and Limit as `r → 1⁻` (RCA p. 338) -/

/-- **17.8(a) (Radial monotonicity of `radialSizeENNReal p f` for ALL `0 ≤ p ≤ ∞`, RCA p. 338):**
For every `f ∈ H(U)` and `0 ≤ p ≤ ∞`, `r ↦ ‖f_r‖_p` is nondecreasing on `[0, 1)`. -/
theorem radialSizeENNReal_mono {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) (p : ℝ≥0∞)
    {r₁ r₂ : ℝ} (hr₁ : 0 ≤ r₁) (hr₁₂ : r₁ ≤ r₂) (hr₂ : r₂ < 1) :
    radialSizeENNReal p f r₁ ≤ radialSizeENNReal p f r₂ := by
  by_cases hp0 : p = 0
  · subst hp0
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize]
    refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
    have hu_cont : ContinuousOn (fun z ↦ Real.posLog ‖f z‖) (Metric.ball (0 : ℂ) 1) :=
      Real.continuous_posLog.comp_continuousOn
        (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).norm
    have hu_sub : SubharmonicOn (Metric.ball (0 : ℂ) 1) (fun z ↦ (Real.posLog ‖f z‖ : EReal)) :=
      subharmonicOn_posLog_norm_region isRegion_unitDisc hf
    exact theorem17_5 hu_cont hu_sub hr₁ hr₁₂ hr₂
  · rcases eq_or_ne p ⊤ with rfl | hptop
    · -- `p = ∞`: Maximum Modulus Principle
      rcases hr₁₂.eq_or_lt with rfl | hr_lt
      · exact le_rfl
      have hr₂_pos : 0 < r₂ := hr₁.trans_lt hr_lt
      have hcont₁ := continuous_radialSlice_of_holomorphicOn hf hr₁ (hr_lt.trans hr₂)
      have hcont₂ := continuous_radialSlice_of_holomorphicOn hf hr₂_pos.le hr₂
      unfold radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
        eLpNorm_top_eq_iSup_of_continuous _ hcont₁,
        eLpNorm_top_eq_iSup_of_continuous _ hcont₂]
      obtain ⟨ζ₂, _, hζ₂_max⟩ :=
        isCompact_univ.exists_isMaxOn univ_nonempty hcont₂.norm.continuousOn
      have hhd : DiffContOnCl ℂ f (Metric.ball (0 : ℂ) r₂) := by
        refine ⟨fun z hz ↦ (hf z ((Metric.ball_subset_ball hr₂.le) hz)).differentiableWithinAt, ?_⟩
        rw [closure_ball 0 hr₂_pos.ne']
        exact (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).mono
          (Metric.closedBall_subset_ball hr₂)
      have hmax_mod : ∀ z ∈ Metric.closedBall (0 : ℂ) r₂, ‖f z‖ ≤ ‖radialSlice f r₂ ζ₂‖ := by
        intro z hz
        rw [← closure_ball 0 hr₂_pos.ne'] at hz
        refine Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball hhd ?_ hz
        rw [frontier_ball 0 hr₂_pos.ne']
        intro w hw
        have hw_unit : w / (r₂ : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
          rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
            Real.norm_eq_abs, abs_of_pos hr₂_pos, div_eq_one_iff_eq hr₂_pos.ne']
          simpa [Metric.mem_sphere] using hw
        obtain ⟨ζ, hζ⟩ := circlePoint_surjective_sphere hw_unit
        have hw_eq : (r₂ : ℂ) * circlePoint ζ = w := by
          rw [hζ, mul_div_cancel₀ w (Complex.ofReal_ne_zero.mpr hr₂_pos.ne')]
        have hζ_le : ‖radialSlice f r₂ ζ‖ ≤ ‖radialSlice f r₂ ζ₂‖ := hζ₂_max (mem_univ ζ)
        simpa only [radialSlice, hw_eq] using hζ_le
      refine iSup_le fun ζ₁ ↦ ?_
      have hz₁_cb : (r₁ : ℂ) * circlePoint ζ₁ ∈ Metric.closedBall (0 : ℂ) r₂ := by
        have := affine_circlePoint_mem_closedBall 0 hr₁ ζ₁
        rw [zero_add] at this
        exact (Metric.closedBall_subset_closedBall hr₁₂) this
      have hle : ‖radialSlice f r₁ ζ₁‖ₑ ≤ ‖radialSlice f r₂ ζ₂‖ₑ := by
        rw [enorm_eq_nnnorm, enorm_eq_nnnorm, ENNReal.coe_le_coe]
        exact hmax_mod _ hz₁_cb
      exact hle.trans (le_iSup (fun η ↦ ‖radialSlice f r₂ η‖ₑ) ζ₂)
    · -- `0 < p < ∞`: subharmonicity of `‖f z‖ ^ p.toReal` + Theorem 17.5
      have hq_pos : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
      have hcont₁ := continuous_radialSlice_of_holomorphicOn hf hr₁ (hr₁₂.trans_lt hr₂)
      have hcont₂ := continuous_radialSlice_of_holomorphicOn hf (hr₁.trans hr₁₂) hr₂
      simp only [radialSizeENNReal, hp0, ↓reduceIte,
        (memLp_radialSlice_of_continuous hcont₁ p).eLpNorm_eq_integral_rpow_norm hp0 hptop,
        (memLp_radialSlice_of_continuous hcont₂ p).eLpNorm_eq_integral_rpow_norm hp0 hptop]
      refine ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow
        (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _) ?_ (inv_nonneg.mpr hq_pos.le))
      have hu_cont : ContinuousOn (fun z ↦ ‖f z‖ ^ p.toReal) (Metric.ball (0 : ℂ) 1) :=
        (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).norm.rpow_const
          fun _ _ ↦ Or.inr hq_pos.le
      have hu_sub : SubharmonicOn (Metric.ball (0 : ℂ) 1)
          (fun z ↦ ((‖f z‖ ^ p.toReal : ℝ) : EReal)) :=
        subharmonicOn_rpow_norm_region isRegion_unitDisc hf hq_pos
      exact theorem17_5 hu_cont hu_sub hr₁ hr₁₂ hr₂

theorem radialSize_mono {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) (p : ℝ≥0∞)
    {r₁ r₂ : ℝ} (hr₁ : 0 ≤ r₁) (hr₁₂ : r₁ ≤ r₂) (hr₂ : r₂ < 1) :
    radialSize p f r₁ ≤ radialSize p f r₂ := by
  have hcont₂ := continuous_radialSlice_of_holomorphicOn hf (hr₁.trans hr₁₂) hr₂
  exact ENNReal.toReal_mono (radialSizeENNReal_lt_top_of_continuous hcont₂ p).ne
    (radialSizeENNReal_mono hf p hr₁ hr₁₂ hr₂)

/-- **17.8(a) (`lim_{r → 1⁻} ‖f_r‖_p = ‖f‖_p`, RCA p. 338):**
Because `r ↦ radialSizeENNReal p f r` is nondecreasing on `[0, 1)`, its left limit at `1` equals
its supremum `hardySizeENNReal p f`. -/
theorem tendsto_radialSizeENNReal_nhdsLT_one {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) (p : ℝ≥0∞) :
    Tendsto (radialSizeENNReal p f) (𝓝[<] (1 : ℝ)) (𝓝 (hardySizeENNReal p f)) := by
  rw [tendsto_order]
  constructor
  · intro a ha
    rw [hardySizeENNReal, lt_biSup_iff] at ha
    obtain ⟨r₀, hr₀_mem, ha_lt⟩ := ha
    filter_upwards [Ico_mem_nhdsLT hr₀_mem.2] with r hr
    exact ha_lt.trans_le (radialSizeENNReal_mono hf p hr₀_mem.1 hr.1 hr.2)
  · intro b hb
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    exact (le_biSup (radialSizeENNReal p f) (⟨hr.1.le, hr.2⟩ : r ∈ Set.Ico (0 : ℝ) 1)).trans_lt hb

theorem tendsto_radialSize_nhdsLT_one {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {p : ℝ≥0∞}
    (hfin : hardySizeENNReal p f < ⊤) :
    Tendsto (radialSize p f) (𝓝[<] (1 : ℝ)) (𝓝 (hardySize p f)) := by
  refine (ENNReal.continuousAt_toReal hfin.ne).tendsto.comp ?_
  exact tendsto_radialSizeENNReal_nhdsLT_one hf p

/-! ### Nodes 17.8(b) & 17.8(c): Algebraic Closure and Banach Space Structure on `Hᵖ` (`1 ≤ p ≤ ∞`) -/

@[simp]
theorem radialSlice_zero (r : ℝ) : radialSlice 0 r = 0 := rfl

@[simp]
theorem radialSlice_add (f g : ℂ → ℂ) (r : ℝ) :
    radialSlice (f + g) r = radialSlice f r + radialSlice g r := rfl

@[simp]
theorem radialSlice_neg (f : ℂ → ℂ) (r : ℝ) :
    radialSlice (-f) r = -radialSlice f r := rfl

@[simp]
theorem radialSlice_sub (f g : ℂ → ℂ) (r : ℝ) :
    radialSlice (f - g) r = radialSlice f r - radialSlice g r := rfl

@[simp]
theorem radialSlice_smul (c : ℂ) (f : ℂ → ℂ) (r : ℝ) :
    radialSlice (c • f) r = c • radialSlice f r := rfl

theorem radialSlice_congr_ball {f g : ℂ → ℂ}
    (hfg : EqOn f g (Metric.ball (0 : ℂ) 1)) {r : ℝ} (hr : r ∈ Set.Ico (0 : ℝ) 1) :
    radialSlice f r = radialSlice g r := by
  funext ζ
  refine hfg ?_
  simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hr.1] using hr.2

theorem radialSizeENNReal_congr_ball (p : ℝ≥0∞) {f g : ℂ → ℂ}
    (hfg : EqOn f g (Metric.ball (0 : ℂ) 1)) {r : ℝ} (hr : r ∈ Set.Ico (0 : ℝ) 1) :
    radialSizeENNReal p f r = radialSizeENNReal p g r := by
  simp only [radialSizeENNReal, radialZeroSize, radialSlice_congr_ball hfg hr]

theorem hardySizeENNReal_congr_ball (p : ℝ≥0∞) {f g : ℂ → ℂ}
    (hfg : EqOn f g (Metric.ball (0 : ℂ) 1)) :
    hardySizeENNReal p f = hardySizeENNReal p g := by
  refine le_antisymm
    (iSup₂_le fun r hr ↦ (radialSizeENNReal_congr_ball p hfg hr).le.trans (le_biSup _ hr))
    (iSup₂_le fun r hr ↦ (radialSizeENNReal_congr_ball p hfg hr).symm.le.trans (le_biSup _ hr))

theorem hardySize_congr_ball (p : ℝ≥0∞) {f g : ℂ → ℂ}
    (hfg : EqOn f g (Metric.ball (0 : ℂ) 1)) :
    hardySize p f = hardySize p g := by
  simp only [hardySize, hardySizeENNReal_congr_ball p hfg]

theorem holomorphicOn_congr_ball {f g : ℂ → ℂ}
    (hfg : EqOn f g (Metric.ball (0 : ℂ) 1)) :
    HolomorphicOn f (Metric.ball (0 : ℂ) 1) ↔ HolomorphicOn g (Metric.ball (0 : ℂ) 1) := by
  constructor
  · intro hf z hz
    exact (hf z hz).congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz) fun w hw ↦ (hfg hw).symm)
  · intro hg z hz
    exact (hg z hz).congr_of_eventuallyEq
      (Filter.eventuallyEq_of_mem (Metric.isOpen_ball.mem_nhds hz) fun w hw ↦ hfg hw)

theorem isInHardySpace_congr_ball {p : ℝ≥0∞} {f g : ℂ → ℂ}
    (hfg : EqOn f g (Metric.ball (0 : ℂ) 1)) :
    IsInHardySpace p f ↔ IsInHardySpace p g := by
  simp only [IsInHardySpace, holomorphicOn_congr_ball hfg, hardySizeENNReal_congr_ball p hfg]

@[simp]
theorem hardySizeENNReal_zero {p : ℝ≥0∞} (hp0 : p ≠ 0) :
    hardySizeENNReal p 0 = 0 := by
  simp [hardySizeENNReal, radialSizeENNReal, hp0]

@[simp]
theorem hardySize_zero {p : ℝ≥0∞} (hp0 : p ≠ 0) :
    hardySize p 0 = 0 := by
  simp [hardySize, hardySizeENNReal_zero hp0]

@[simp]
theorem hardySizeENNReal_neg {p : ℝ≥0∞} (hp0 : p ≠ 0) (f : ℂ → ℂ) :
    hardySizeENNReal p (-f) = hardySizeENNReal p f := by
  simp [hardySizeENNReal, radialSizeENNReal, hp0]

@[simp]
theorem hardySize_neg {p : ℝ≥0∞} (hp0 : p ≠ 0) (f : ℂ → ℂ) :
    hardySize p (-f) = hardySize p f := by
  simp [hardySize, hardySizeENNReal_neg hp0]

theorem hardySizeENNReal_smul_le {p : ℝ≥0∞} (hp0 : p ≠ 0) (c : ℂ) (f : ℂ → ℂ) :
    hardySizeENNReal p (c • f) ≤ ‖c‖ₑ * hardySizeENNReal p f := by
  refine iSup₂_le fun r hr ↦ ?_
  have hle : radialSizeENNReal p f r ≤ hardySizeENNReal p f :=
    le_biSup (radialSizeENNReal p f) hr
  simp only [radialSizeENNReal, hp0, ↓reduceIte, radialSlice_smul, eLpNorm_const_smul] at hle ⊢
  exact mul_le_mul_of_nonneg_left hle zero_le

@[simp]
theorem hardySizeENNReal_smul {p : ℝ≥0∞} (hp0 : p ≠ 0) (c : ℂ) (f : ℂ → ℂ) :
    hardySizeENNReal p (c • f) = ‖c‖ₑ * hardySizeENNReal p f := by
  rcases eq_or_ne c 0 with rfl | hc
  · simp [hardySizeENNReal_zero hp0]
  · refine le_antisymm (hardySizeENNReal_smul_le hp0 c f) ?_
    have hinv := hardySizeENNReal_smul_le hp0 c⁻¹ (c • f)
    rw [inv_smul_smul₀ hc] at hinv
    have hmul : ‖c‖ₑ * ‖c⁻¹‖ₑ = 1 := by
      rw [← enorm_mul, mul_inv_cancel₀ hc, enorm_one]
    calc ‖c‖ₑ * hardySizeENNReal p f
        ≤ ‖c‖ₑ * (‖c⁻¹‖ₑ * hardySizeENNReal p (c • f)) :=
          mul_le_mul_of_nonneg_left hinv zero_le
      _ = (‖c‖ₑ * ‖c⁻¹‖ₑ) * hardySizeENNReal p (c • f) := (mul_assoc _ _ _).symm
      _ = hardySizeENNReal p (c • f) := by rw [hmul, one_mul]

@[simp]
theorem hardySize_smul {p : ℝ≥0∞} (hp0 : p ≠ 0) (c : ℂ) (f : ℂ → ℂ) :
    hardySize p (c • f) = ‖c‖ * hardySize p f := by
  unfold hardySize
  rw [hardySizeENNReal_smul hp0, ENNReal.toReal_mul, ← ofReal_norm,
    ENNReal.toReal_ofReal (norm_nonneg c)]

theorem hardySizeENNReal_add_le' {p : ℝ≥0∞} (hp0 : p ≠ 0) (f g : ℂ → ℂ) :
    hardySizeENNReal p (f + g) ≤
      ENNReal.LpAddConst p * (hardySizeENNReal p f + hardySizeENNReal p g) := by
  refine iSup₂_le fun r hr ↦ ?_
  have hfg : radialSizeENNReal p (f + g) r ≤
      ENNReal.LpAddConst p * (radialSizeENNReal p f r + radialSizeENNReal p g r) := by
    simp only [radialSizeENNReal, hp0, ↓reduceIte, radialSlice_add]
    exact eLpNorm_add_le' p
  exact hfg.trans (mul_le_mul_of_nonneg_left
    (add_le_add (le_biSup (radialSizeENNReal p f) hr) (le_biSup (radialSizeENNReal p g) hr))
    zero_le)

theorem hardySizeENNReal_add_le {p : ℝ≥0∞} (hp1 : 1 ≤ p) (f g : ℂ → ℂ) :
    hardySizeENNReal p (f + g) ≤ hardySizeENNReal p f + hardySizeENNReal p g := by
  have hp0 : p ≠ 0 := ne_of_gt (zero_lt_one.trans_le hp1)
  simpa [ENNReal.LpAddConst_of_one_le hp1] using hardySizeENNReal_add_le' hp0 f g

theorem IsInHardySpace.zero {p : ℝ≥0∞} (hp0 : p ≠ 0) : IsInHardySpace p 0 :=
  ⟨hp0, fun _ _ ↦ differentiableAt_const 0, by simp [hardySizeENNReal_zero hp0]⟩

theorem IsInHardySpace.neg {p : ℝ≥0∞} {f : ℂ → ℂ} (hf : IsInHardySpace p f) :
    IsInHardySpace p (-f) :=
  ⟨hf.1, fun z hz ↦ (hf.2.1 z hz).neg, by simpa [hardySizeENNReal_neg hf.1] using hf.2.2⟩

theorem IsInHardySpace.add {p : ℝ≥0∞} {f g : ℂ → ℂ}
    (hf : IsInHardySpace p f) (hg : IsInHardySpace p g) :
    IsInHardySpace p (f + g) := by
  refine ⟨hf.1, fun z hz ↦ (hf.2.1 z hz).add (hg.2.1 z hz), ?_⟩
  refine (hardySizeENNReal_add_le' hf.1 f g).trans_lt ?_
  exact ENNReal.mul_lt_top (ENNReal.LpAddConst_lt_top p) (ENNReal.add_lt_top.mpr ⟨hf.2.2, hg.2.2⟩)

theorem IsInHardySpace.sub {p : ℝ≥0∞} {f g : ℂ → ℂ}
    (hf : IsInHardySpace p f) (hg : IsInHardySpace p g) :
    IsInHardySpace p (f - g) := by
  rw [sub_eq_add_neg]
  exact hf.add hg.neg

theorem IsInHardySpace.smul {p : ℝ≥0∞} (c : ℂ) {f : ℂ → ℂ} (hf : IsInHardySpace p f) :
    IsInHardySpace p (c • f) := by
  refine ⟨hf.1, fun z hz ↦ (hf.2.1 z hz).const_smul c, ?_⟩
  rw [hardySizeENNReal_smul hf.1]
  exact ENNReal.mul_lt_top enorm_lt_top hf.2.2

/-- **17.8(b) & 17.8(d) (`Hᵖ` as a `ℂ`-linear subspace of `ℂ → ℂ` for every `0 < p ≤ ∞`):**
In particular, for `0 < p < 1`, `hardySubmodule p hp0` is a genuine `ℂ`-vector space (`Module ℂ`). -/
def hardySubmodule (p : ℝ≥0∞) (hp0 : p ≠ 0) : Submodule ℂ (ℂ → ℂ) where
  carrier := {f | IsInHardySpace p f}
  zero_mem' := IsInHardySpace.zero hp0
  add_mem' hf hg := hf.add hg
  smul_mem' c _ hf := hf.smul c

/-- Cauchy integral pointwise estimate on `ball 0 R` (`0 < R < 1`):
for `f ∈ H(U)` and `z ∈ ball 0 R`, `‖f z‖ ≤ (R / (R - ‖z‖)) * radialSize 1 f R`. -/
theorem norm_apply_le_radialSize_one {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1))
    {R : ℝ} (hR0 : 0 < R) (hR1 : R < 1) {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) R) :
    ‖f z‖ ≤ (R / (R - ‖z‖)) * radialSize 1 f R := by
  have hz_lt : ‖z‖ < R := by simpa [Metric.mem_ball] using hz
  have hsub_pos : 0 < R - ‖z‖ := sub_pos.mpr hz_lt
  have hhd : DiffContOnCl ℂ f (Metric.ball (0 : ℂ) R) := by
    refine ⟨fun w hw ↦ (hf w ((Metric.ball_subset_ball hR1.le) hw)).differentiableWithinAt, ?_⟩
    rw [closure_ball 0 hR0.ne']
    exact (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).mono
      (Metric.closedBall_subset_ball hR1)
  have hcauchy := hhd.two_pi_i_inv_smul_circleIntegral_sub_inv_smul hz
  have hnorm_fz : ‖f z‖ ≤ (2 * Real.pi)⁻¹ *
      ∫ θ in (0 : ℝ)..2 * Real.pi,
        ‖deriv (circleMap 0 R) θ • ((circleMap 0 R θ - z)⁻¹ • f (circleMap 0 R θ))‖ := by
    rw [← hcauchy, norm_smul]
    have h2pi : ‖(2 * Real.pi * Complex.I : ℂ)⁻¹‖ = (2 * Real.pi)⁻¹ := by simp
    rw [h2pi]
    exact mul_le_mul_of_nonneg_left
      (intervalIntegral.norm_integral_le_integral_norm Real.two_pi_pos.le)
      (inv_nonneg.mpr Real.two_pi_pos.le)
  have hpt : ∀ θ : ℝ,
      ‖deriv (circleMap 0 R) θ • ((circleMap 0 R θ - z)⁻¹ • f (circleMap 0 R θ))‖ ≤
        (R / (R - ‖z‖)) * ‖f (circleMap 0 R θ)‖ := by
    intro θ
    have hcm_norm : ‖circleMap 0 R θ‖ = R := by
      simp [norm_circleMap_zero, abs_of_pos hR0]
    have hderiv_norm : ‖deriv (circleMap 0 R) θ‖ = R := by
      simp [deriv_circleMap, norm_circleMap_zero, abs_of_pos hR0]
    have hdenom_ge : R - ‖z‖ ≤ ‖circleMap 0 R θ - z‖ := by
      have := norm_sub_norm_le (circleMap 0 R θ) z
      linarith
    have hinv_le : ‖(circleMap 0 R θ - z)⁻¹‖ ≤ (R - ‖z‖)⁻¹ := by
      rw [norm_inv]
      exact inv_anti₀ hsub_pos hdenom_ge
    rw [norm_smul, norm_smul, hderiv_norm, div_eq_mul_inv, mul_assoc]
    exact mul_le_mul_of_nonneg_left
      (mul_le_mul_of_nonneg_right hinv_le (norm_nonneg _)) hR0.le
  have hcont_cm : Continuous (circleMap 0 R) := continuous_circleMap 0 R
  have hf_cm_cont : Continuous (fun θ : ℝ ↦ f (circleMap 0 R θ)) :=
    (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).comp_continuous hcont_cm fun θ ↦ by
      simpa [Metric.mem_ball, norm_circleMap_zero, abs_of_pos hR0] using hR1
  have hsub_ne : ∀ θ : ℝ, circleMap 0 R θ - z ≠ 0 := fun θ h0 ↦ by
    have : ‖circleMap 0 R θ - z‖ = 0 := by simp [h0]
    have hcm_norm : ‖circleMap 0 R θ‖ = R := by simp [norm_circleMap_zero, abs_of_pos hR0]
    linarith [norm_sub_norm_le (circleMap 0 R θ) z]
  have hint_lhs : IntervalIntegrable
      (fun θ : ℝ ↦ ‖deriv (circleMap 0 R) θ • ((circleMap 0 R θ - z)⁻¹ • f (circleMap 0 R θ))‖)
      volume 0 (2 * Real.pi) := by
    have hderiv_cont : Continuous (deriv (circleMap 0 R)) := by
      rw [funext (deriv_circleMap 0 R)]
      exact (continuous_circleMap 0 R).mul continuous_const
    exact (hderiv_cont.smul (((hcont_cm.sub continuous_const).inv₀ hsub_ne).smul
      hf_cm_cont)).norm.intervalIntegrable _ _
  have hint_rhs : IntervalIntegrable
      (fun θ : ℝ ↦ (R / (R - ‖z‖)) * ‖f (circleMap 0 R θ)‖) volume 0 (2 * Real.pi) :=
    (continuous_const.mul hf_cm_cont.norm).intervalIntegrable _ _
  have hint_le : ∫ θ in (0 : ℝ)..2 * Real.pi,
        ‖deriv (circleMap 0 R) θ • ((circleMap 0 R θ - z)⁻¹ • f (circleMap 0 R θ))‖ ≤
      ∫ θ in (0 : ℝ)..2 * Real.pi, (R / (R - ‖z‖)) * ‖f (circleMap 0 R θ)‖ :=
    intervalIntegral.integral_mono_on Real.two_pi_pos.le hint_lhs hint_rhs fun θ _ ↦ hpt θ
  have hrad1_eq : (2 * Real.pi)⁻¹ *
      (∫ θ in (0 : ℝ)..2 * Real.pi, (R / (R - ‖z‖)) * ‖f (circleMap 0 R θ)‖) =
      (R / (R - ‖z‖)) * radialSize 1 f R := by
    rw [intervalIntegral.integral_const_mul, ← mul_assoc, mul_comm (2 * Real.pi)⁻¹, mul_assoc]
    congr 1
    have hca : (2 * Real.pi)⁻¹ * (∫ θ in (0 : ℝ)..2 * Real.pi, ‖f (circleMap 0 R θ)‖) =
        Real.circleAverage (fun w ↦ ‖f w‖) 0 R := by
      simp [Real.circleAverage_def, smul_eq_mul]
    rw [hca, ← integral_circleMeasure_eq_circleAverage]
    have hcontR := continuous_radialSlice_of_holomorphicOn hf hR0.le hR1
    unfold radialSize radialSizeENNReal
    rw [ite_eq_right_iff.mpr fun h ↦ (one_ne_zero h).elim,
      (memLp_radialSlice_of_continuous hcontR 1).eLpNorm_eq_integral_rpow_norm
        one_ne_zero ENNReal.one_ne_top]
    simp [radialSlice, ENNReal.toReal_ofReal (integral_nonneg fun _ ↦ norm_nonneg _)]
  exact hnorm_fz.trans ((mul_le_mul_of_nonneg_left hint_le (inv_nonneg.mpr Real.two_pi_pos.le)).trans_eq
    hrad1_eq)

/-- Uniform bound on compact discs `closedBall 0 r` (`0 ≤ r < 1`) in terms of `hardySize p f`
for `1 ≤ p ≤ ∞`: `‖f z‖ ≤ (2 / (1 - r)) * hardySize p f`. -/
theorem norm_apply_le_of_isInHardySpace {p : ℝ≥0∞} (hp1 : 1 ≤ p) {f : ℂ → ℂ}
    (hf : IsInHardySpace p f) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1)
    {z : ℂ} (hz : z ∈ Metric.closedBall (0 : ℂ) r) :
    ‖f z‖ ≤ (2 / (1 - r)) * hardySize p f := by
  let R : ℝ := (r + 1) / 2
  have hR0 : 0 < R := by dsimp [R]; linarith
  have hR1 : R < 1 := by dsimp [R]; linarith
  have hrR : r < R := by dsimp [R]; linarith
  have hz_le : ‖z‖ ≤ r := by simpa [Metric.mem_closedBall] using hz
  have hz_ball : z ∈ Metric.ball (0 : ℂ) R := by
    simpa [Metric.mem_ball] using hz_le.trans_lt hrR
  have h1 := norm_apply_le_radialSize_one hf.2.1 hR0 hR1 hz_ball
  have hrad_le : radialSize 1 f R ≤ hardySize p f := by
    have hENN : radialSizeENNReal 1 f R ≤ hardySizeENNReal p f :=
      (radialSizeENNReal_le_of_exponent_le one_ne_zero hp1 f R).trans
        (le_biSup (radialSizeENNReal p f) (⟨hR0.le, hR1⟩ : R ∈ Set.Ico (0 : ℝ) 1))
    exact ENNReal.toReal_mono hf.2.2.ne hENN
  have hcoef_le : R / (R - ‖z‖) ≤ 2 / (1 - r) := by
    have hsub1 : 0 < (1 - r) / 2 := by linarith
    have hsub2 : (1 - r) / 2 ≤ R - ‖z‖ := by dsimp [R]; linarith
    have h1mr : 1 - r ≠ 0 := (sub_pos.mpr hr1).ne'
    calc R / (R - ‖z‖)
        ≤ 1 / (R - ‖z‖) := div_le_div_of_nonneg_right hR1.le (hsub1.trans_le hsub2).le
      _ ≤ 1 / ((1 - r) / 2) := one_div_le_one_div_of_le hsub1 hsub2
      _ = 2 / (1 - r) := by field_simp [h1mr]
  have hrad_nn : 0 ≤ radialSize 1 f R := ENNReal.toReal_nonneg
  have hhardy_nn : 0 ≤ hardySize p f := ENNReal.toReal_nonneg
  calc ‖f z‖
      ≤ (R / (R - ‖z‖)) * radialSize 1 f R := h1
    _ ≤ (2 / (1 - r)) * radialSize 1 f R :=
        mul_le_mul_of_nonneg_right hcoef_le hrad_nn
    _ ≤ (2 / (1 - r)) * hardySize p f :=
        mul_le_mul_of_nonneg_left hrad_le (by positivity)

/-- **17.8(b) & 17.8(c) (Bundled Hardy space element, RCA p. 338):**
Holomorphic function on the open unit disc `U = ball 0 1` in `H^p`, canonically extended by `0`
outside `U` so equality is extensional on `U`. -/
structure HardyElem (p : ℝ≥0∞) where
  toFun : ℂ → ℂ
  mem_hardy : IsInHardySpace p toFun
  eq_zero_outside : ∀ z ∉ Metric.ball (0 : ℂ) 1, toFun z = 0

instance (p : ℝ≥0∞) : CoeFun (HardyElem p) (fun _ ↦ ℂ → ℂ) := ⟨HardyElem.toFun⟩

@[ext]
theorem HardyElem.ext {p : ℝ≥0∞} {F G : HardyElem p} (h : ∀ z, F z = G z) : F = G := by
  cases F; cases G; simp only [mk.injEq]; funext z; exact h z

theorem HardyElem.ext_ball {p : ℝ≥0∞} {F G : HardyElem p}
    (h : ∀ z ∈ Metric.ball (0 : ℂ) 1, F z = G z) : F = G := by
  ext z
  by_cases hz : z ∈ Metric.ball (0 : ℂ) 1
  · exact h z hz
  · rw [F.eq_zero_outside z hz, G.eq_zero_outside z hz]

theorem HardyElem.ext_iff_ball {p : ℝ≥0∞} {F G : HardyElem p} :
    F = G ↔ ∀ z ∈ Metric.ball (0 : ℂ) 1, F z = G z :=
  ⟨fun h _ _ ↦ h ▸ rfl, HardyElem.ext_ball⟩

/-- Canonical constructor restricting an arbitrary `f : ℂ → ℂ` with `IsInHardySpace p f` to `ball 0 1`
(setting values outside `ball 0 1` to `0`). -/
def HardyElem.ofIsInHardySpace {p : ℝ≥0∞} (f : ℂ → ℂ) (hf : IsInHardySpace p f) : HardyElem p where
  toFun := (Metric.ball (0 : ℂ) 1).indicator f
  mem_hardy := (isInHardySpace_congr_ball Set.eqOn_indicator).mpr hf
  eq_zero_outside _ hz := Set.indicator_of_notMem hz f

@[simp]
theorem HardyElem.ofIsInHardySpace_apply_of_mem {p : ℝ≥0∞} (f : ℂ → ℂ) (hf : IsInHardySpace p f)
    {z : ℂ} (hz : z ∈ Metric.ball (0 : ℂ) 1) :
    HardyElem.ofIsInHardySpace f hf z = f z :=
  Set.indicator_of_mem hz f

theorem HardyElem.hardySizeENNReal_ofIsInHardySpace {p : ℝ≥0∞} (f : ℂ → ℂ) (hf : IsInHardySpace p f) :
    hardySizeENNReal p (HardyElem.ofIsInHardySpace f hf).toFun = hardySizeENNReal p f :=
  hardySizeENNReal_congr_ball p (fun _ hz ↦ Set.indicator_of_mem hz f)

theorem HardyElem.hardySize_ofIsInHardySpace {p : ℝ≥0∞} (f : ℂ → ℂ) (hf : IsInHardySpace p f) :
    hardySize p (HardyElem.ofIsInHardySpace f hf).toFun = hardySize p f :=
  hardySize_congr_ball p (fun _ hz ↦ Set.indicator_of_mem hz f)

instance fact_ne_zero_of_fact_one_le {p : ℝ≥0∞} [h : Fact (1 ≤ p)] : Fact (p ≠ 0) :=
  ⟨ne_of_gt (zero_lt_one.trans_le h.out)⟩

section HardyElemAlgebra

variable {p : ℝ≥0∞}

instance : Add (HardyElem p) :=
  ⟨fun F G ↦ ⟨F.toFun + G.toFun, F.mem_hardy.add G.mem_hardy, fun z hz ↦ by
    simp [F.eq_zero_outside z hz, G.eq_zero_outside z hz]⟩⟩

instance : Neg (HardyElem p) :=
  ⟨fun F ↦ ⟨-F.toFun, F.mem_hardy.neg, fun z hz ↦ by simp [F.eq_zero_outside z hz]⟩⟩

instance : Sub (HardyElem p) :=
  ⟨fun F G ↦ ⟨F.toFun - G.toFun, F.mem_hardy.sub G.mem_hardy, fun z hz ↦ by
    simp [F.eq_zero_outside z hz, G.eq_zero_outside z hz]⟩⟩

instance : SMul ℕ (HardyElem p) :=
  ⟨fun n F ↦ ⟨(n : ℂ) • F.toFun, F.mem_hardy.smul (n : ℂ), fun z hz ↦ by
    simp [F.eq_zero_outside z hz]⟩⟩

instance : SMul ℤ (HardyElem p) :=
  ⟨fun n F ↦ ⟨(n : ℂ) • F.toFun, F.mem_hardy.smul (n : ℂ), fun z hz ↦ by
    simp [F.eq_zero_outside z hz]⟩⟩

instance : SMul ℂ (HardyElem p) :=
  ⟨fun c F ↦ ⟨c • F.toFun, F.mem_hardy.smul c, fun z hz ↦ by
    simp [F.eq_zero_outside z hz]⟩⟩

instance : SMul ℝ (HardyElem p) :=
  ⟨fun c F ↦ ((c : ℂ) • F)⟩

@[simp] theorem HardyElem.toFun_add (F G : HardyElem p) : (F + G).toFun = F.toFun + G.toFun := rfl
@[simp] theorem HardyElem.toFun_neg (F : HardyElem p) : (-F).toFun = -F.toFun := rfl
@[simp] theorem HardyElem.toFun_sub (F G : HardyElem p) : (F - G).toFun = F.toFun - G.toFun := rfl
@[simp] theorem HardyElem.toFun_smul (c : ℂ) (F : HardyElem p) : (c • F).toFun = c • F.toFun := rfl

theorem HardyElem.toFun_injective : Function.Injective (HardyElem.toFun (p := p)) :=
  fun _ _ h ↦ HardyElem.ext (congrFun h)

variable [Fact (p ≠ 0)]

instance : Zero (HardyElem p) :=
  ⟨⟨0, IsInHardySpace.zero Fact.out, fun _ _ ↦ rfl⟩⟩

@[simp] theorem HardyElem.toFun_zero : (0 : HardyElem p).toFun = 0 := rfl

instance : AddCommGroup (HardyElem p) :=
  HardyElem.toFun_injective.addCommGroup _ rfl (fun _ _ ↦ rfl) (fun _ ↦ rfl) (fun _ _ ↦ rfl)
    (fun F n ↦ funext fun z ↦ Nat.cast_smul_eq_nsmul ℂ n (F.toFun z))
    (fun F n ↦ funext fun z ↦ Int.cast_smul_eq_zsmul ℂ n (F.toFun z))

def HardyElem.toFunAddMonoidHom (p : ℝ≥0∞) [Fact (p ≠ 0)] : HardyElem p →+ (ℂ → ℂ) where
  toFun := HardyElem.toFun
  map_zero' := rfl
  map_add' _ _ := rfl

instance : Module ℂ (HardyElem p) :=
  Function.Injective.module ℂ (HardyElem.toFunAddMonoidHom p) HardyElem.toFun_injective
    (fun _ _ ↦ rfl)

instance : Module ℝ (HardyElem p) :=
  Function.Injective.module ℝ (HardyElem.toFunAddMonoidHom p) HardyElem.toFun_injective
    (fun c F ↦ by ext z; simp [Complex.real_smul]; rfl)

instance : IsScalarTower ℝ ℂ (HardyElem p) :=
  ⟨fun r c F ↦ by ext z; simp [HardyElem.toFun_smul]; change ((r : ℂ) * c) * F z = (r : ℂ) * (c * F z); ring⟩

end HardyElemAlgebra

section HardyElemBanach

variable {p : ℝ≥0∞} [Fact (1 ≤ p)]

/-- The `H^p` group norm on `HardyElem p` for `1 ≤ p ≤ ∞`. -/
def hardyElemAddGroupNorm (p : ℝ≥0∞) [Fact (1 ≤ p)] : AddGroupNorm (HardyElem p) where
  toFun F := hardySize p F.toFun
  map_zero' := hardySize_zero Fact.out
  add_le' F G := by
    unfold hardySize
    have hle := hardySizeENNReal_add_le (Fact.out : 1 ≤ p) F.toFun G.toFun
    exact (ENNReal.toReal_mono (ENNReal.add_lt_top.mpr ⟨F.mem_hardy.2.2, G.mem_hardy.2.2⟩).ne
      hle).trans_eq (ENNReal.toReal_add F.mem_hardy.2.2.ne G.mem_hardy.2.2.ne)
  neg' F := hardySize_neg Fact.out F.toFun
  eq_zero_of_map_eq_zero' F h0 := by
    apply HardyElem.ext_ball
    intro z hz
    have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
    have hz_cb : z ∈ Metric.closedBall (0 : ℂ) ‖z‖ := by simp
    have hle := norm_apply_le_of_isInHardySpace (Fact.out : 1 ≤ p) F.mem_hardy
      (norm_nonneg z) hz_lt hz_cb
    rw [h0, mul_zero] at hle
    exact norm_le_zero_iff.mp hle

/-- **17.8(b) (`NormedAddCommGroup (HardyElem p)` for `1 ≤ p ≤ ∞`, RCA p. 338).** -/
instance : NormedAddCommGroup (HardyElem p) :=
  (hardyElemAddGroupNorm p).toNormedAddCommGroup

@[simp]
theorem HardyElem.norm_def (F : HardyElem p) : ‖F‖ = hardySize p F.toFun := rfl

theorem HardyElem.dist_eq (F G : HardyElem p) :
    dist F G = hardySize p (F.toFun - G.toFun) := by
  rw [dist_eq_norm, HardyElem.norm_def, HardyElem.toFun_sub]

/-- **17.8(b) (`NormedSpace ℂ (HardyElem p)` for `1 ≤ p ≤ ∞`, RCA p. 338).** -/
instance : NormedSpace ℂ (HardyElem p) where
  norm_smul_le c F := (hardySize_smul Fact.out c F.toFun).le

instance : NormedSpace ℝ (HardyElem p) :=
  NormedSpace.restrictScalars ℝ ℂ (HardyElem p)

/-- **17.8(c) (`CompleteSpace (HardyElem p)` — `Hᵖ` is a Banach space for `1 ≤ p ≤ ∞`, RCA p. 338).** -/
instance : CompleteSpace (HardyElem p) := by
  refine Metric.complete_of_cauchySeq_tendsto fun F hF ↦ ?_
  have hp1 : 1 ≤ p := Fact.out
  have hp0 : p ≠ 0 := Fact.out
  -- Step 1: Pointwise Cauchy at every `z : ℂ`, hence pointwise limit `f : ℂ → ℂ`
  have hcauchy_pt : ∀ z : ℂ, CauchySeq (fun n ↦ F n z) := by
    intro z
    by_cases hz : z ∈ Metric.ball (0 : ℂ) 1
    · have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
      have hC_pos : 0 < 2 / (1 - ‖z‖) := by positivity
      rw [Metric.cauchySeq_iff]
      intro ε hε
      obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hF (ε / (2 / (1 - ‖z‖))) (div_pos hε hC_pos)
      refine ⟨N, fun n hn m hm ↦ ?_⟩
      rw [dist_eq_norm]
      have hz_cb : z ∈ Metric.closedBall (0 : ℂ) ‖z‖ := by simp
      have hle := norm_apply_le_of_isInHardySpace hp1 (F n - F m).mem_hardy
        (norm_nonneg z) hz_lt hz_cb
      calc ‖F n z - F m z‖
          ≤ (2 / (1 - ‖z‖)) * ‖F n - F m‖ := hle
        _ < (2 / (1 - ‖z‖)) * (ε / (2 / (1 - ‖z‖))) := by
            rw [← dist_eq_norm]
            exact mul_lt_mul_of_pos_left (hN n hn m hm) hC_pos
        _ = ε := mul_div_cancel₀ ε hC_pos.ne'
    · have hconst : (fun n ↦ F n z) = fun _ ↦ 0 := by
        funext n
        exact (F n).eq_zero_outside z hz
      rw [hconst]
      exact cauchySeq_const 0
  choose f hf_pt using fun z ↦ cauchySeq_tendsto_of_complete (hcauchy_pt z)
  have hf_outside : ∀ z ∉ Metric.ball (0 : ℂ) 1, f z = 0 := by
    intro z hz
    have hconst : (fun n ↦ F n z) = fun _ ↦ 0 := funext fun n ↦ (F n).eq_zero_outside z hz
    exact tendsto_nhds_unique (hf_pt z) (hconst ▸ tendsto_const_nhds)
  -- Step 2: Uniform convergence `(F n).toFun → f` on every `closedBall 0 r` (`0 ≤ r < 1`)
  have hunif_cb : ∀ r ∈ Set.Ico (0 : ℝ) 1,
      TendstoUniformlyOn (fun n ↦ (F n).toFun) f atTop (Metric.closedBall (0 : ℂ) r) := by
    intro r hr
    rw [Metric.tendstoUniformlyOn_iff]
    intro ε hε
    have hC_pos : 0 < 2 / (1 - r) := by have : 0 < 1 - r := sub_pos.mpr hr.2; positivity
    obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hF
      ((ε / 2) / (2 / (1 - r))) (div_pos (half_pos hε) hC_pos)
    refine eventually_atTop.mpr ⟨N, fun n hn z hz ↦ ?_⟩
    have h_m_bound : ∀ m ≥ N, ‖F n z - F m z‖ ≤ ε / 2 := by
      intro m hm
      have hle := norm_apply_le_of_isInHardySpace hp1 (F n - F m).mem_hardy hr.1 hr.2 hz
      calc ‖F n z - F m z‖
          ≤ (2 / (1 - r)) * dist (F n) (F m) := by rwa [dist_eq_norm]
        _ ≤ (2 / (1 - r)) * ((ε / 2) / (2 / (1 - r))) :=
            mul_le_mul_of_nonneg_left (hN n hn m hm).le hC_pos.le
        _ = ε / 2 := mul_div_cancel₀ (ε / 2) hC_pos.ne'
    have htend_norm : Tendsto (fun m ↦ ‖F n z - F m z‖) atTop (𝓝 ‖F n z - f z‖) :=
      (tendsto_const_nhds.sub (hf_pt z)).norm
    have hlim_le : ‖F n z - f z‖ ≤ ε / 2 :=
      le_of_tendsto htend_norm (eventually_atTop.mpr ⟨N, h_m_bound⟩)
    rw [dist_eq_norm, norm_sub_rev]
    exact hlim_le.trans_lt (half_lt_self hε)
  -- Step 3: Compact uniform convergence on `ball 0 1`, hence `HolomorphicOn f (ball 0 1)`
  have hconv_compact : RudinRCA.Chapter10.ConvergesOnCompactSubsets
      (fun n ↦ (F n).toFun) f (Metric.ball (0 : ℂ) 1) := by
    intro K hK_sub hK_comp
    rcases K.eq_empty_or_nonempty with rfl | hKne
    · simp [TendstoUniformlyOn]
    · obtain ⟨z_max, hz_max_K, hz_max⟩ :=
        hK_comp.exists_isMaxOn hKne continuous_norm.continuousOn
      let r : ℝ := ‖z_max‖
      have hr_mem : r ∈ Set.Ico (0 : ℝ) 1 :=
        ⟨norm_nonneg z_max, by simpa [Metric.mem_ball] using hK_sub hz_max_K⟩
      refine (hunif_cb r hr_mem).mono fun z hz ↦ ?_
      simpa [Metric.mem_closedBall] using hz_max hz
  have hf_hol : HolomorphicOn f (Metric.ball (0 : ℂ) 1) :=
    (RudinRCA.Chapter10.holomorphicOn_limit_and_deriv Metric.isOpen_ball
      (fun n ↦ (F n).mem_hardy.2.1) hconv_compact).1
  -- Step 4: Uniform Hardy-size tail bound `∀ δ > 0, ∃ N, ∀ n ≥ N, hardySizeENNReal p (F n - f) ≤ δ`
  have htail : ∀ δ : ℝ, 0 < δ →
      ∃ N : ℕ, ∀ n ≥ N, hardySizeENNReal p ((F n).toFun - f) ≤ ENNReal.ofReal δ := by
    intro δ hδ
    obtain ⟨N, hN⟩ := Metric.cauchySeq_iff.mp hF (δ / 2) (half_pos hδ)
    refine ⟨N, fun n hn ↦ ?_⟩
    refine iSup₂_le fun r hr ↦ ?_
    have hcont_diff : ∀ m, Continuous (radialSlice ((F m).toFun - f) r) := fun m ↦
      continuous_radialSlice_of_holomorphicOn
        (fun z hz ↦ ((F m).mem_hardy.2.1 z hz).sub (hf_hol z hz)) hr.1 hr.2
    obtain ⟨M, hM⟩ := eventually_atTop.mp
      (Metric.tendstoUniformlyOn_iff.mp (hunif_cb r hr) (δ / 2) (half_pos hδ))
    let m : ℕ := max N M
    have hmN : m ≥ N := le_max_left N M
    have hmM : m ≥ M := le_max_right N M
    have h_nm_enn : radialSizeENNReal p ((F n).toFun - (F m).toFun) r ≤
        ENNReal.ofReal (δ / 2) := by
      have hdist_lt : hardySize p ((F n).toFun - (F m).toFun) < δ / 2 := by
        simpa only [HardyElem.dist_eq] using hN n hn m hmN
      have hfin : hardySizeENNReal p ((F n).toFun - (F m).toFun) < ⊤ :=
        (F n - F m).mem_hardy.2.2
      have hhardy_le : hardySizeENNReal p ((F n).toFun - (F m).toFun) ≤
          ENNReal.ofReal (δ / 2) := by
        rw [← ENNReal.ofReal_toReal hfin.ne]
        exact ENNReal.ofReal_le_ofReal hdist_lt.le
      exact (le_biSup (radialSizeENNReal p ((F n).toFun - (F m).toFun)) hr).trans hhardy_le
    have h_mf_enn : radialSizeENNReal p ((F m).toFun - f) r ≤ ENNReal.ofReal (δ / 2) := by
      simp only [radialSizeENNReal, hp0, ↓reduceIte]
      have hbound : ∀ ζ : FourierCircle, ‖radialSlice ((F m).toFun - f) r ζ‖ ≤ δ / 2 := by
        intro ζ
        have hz_cb : (r : ℂ) * circlePoint ζ ∈ Metric.closedBall (0 : ℂ) r := by
          have := affine_circlePoint_mem_closedBall 0 hr.1 ζ
          rwa [zero_add] at this
        have hlt := hM m hmM _ hz_cb
        rw [dist_eq_norm, norm_sub_rev] at hlt
        exact hlt.le
      have hle := eLpNorm_le_of_ae_bound (p := p) (μ := circleMeasure)
        (hcont_diff m).aestronglyMeasurable (Eventually.of_forall hbound)
      simpa [measure_univ] using hle
    have hdecomp : radialSlice ((F n).toFun - f) r =
        radialSlice ((F n).toFun - (F m).toFun) r + radialSlice ((F m).toFun - f) r := by
      funext ζ
      simp [radialSlice, sub_add_sub_cancel]
    calc radialSizeENNReal p ((F n).toFun - f) r
        = eLpNorm (radialSlice ((F n).toFun - f) r) p circleMeasure := by
            simp [radialSizeENNReal, hp0]
      _ ≤ eLpNorm (radialSlice ((F n).toFun - (F m).toFun) r) p circleMeasure +
            eLpNorm (radialSlice ((F m).toFun - f) r) p circleMeasure := by
            rw [hdecomp]
            exact eLpNorm_add_le hp1
      _ = radialSizeENNReal p ((F n).toFun - (F m).toFun) r +
            radialSizeENNReal p ((F m).toFun - f) r := by
            simp [radialSizeENNReal, hp0]
      _ ≤ ENNReal.ofReal (δ / 2) + ENNReal.ofReal (δ / 2) := add_le_add h_nm_enn h_mf_enn
      _ = ENNReal.ofReal δ := by
            rw [← ENNReal.ofReal_add (half_pos hδ).le (half_pos hδ).le, add_halves]
  -- Step 5: Deduce `IsInHardySpace p f`, form `L : HardyElem p`, and show `F → L`
  obtain ⟨N₁, hN₁⟩ := htail 1 zero_lt_one
  have hf_lt_top : hardySizeENNReal p f < ⊤ := by
    have hfeq : f = (F N₁).toFun + -( (F N₁).toFun - f ) := by
      funext z
      simp only [Pi.add_apply, Pi.neg_apply, Pi.sub_apply]
      ring
    rw [hfeq]
    refine (hardySizeENNReal_add_le hp1 (F N₁).toFun (-((F N₁).toFun - f))).trans_lt ?_
    rw [hardySizeENNReal_neg hp0]
    exact ENNReal.add_lt_top.mpr ⟨(F N₁).mem_hardy.2.2,
      (hN₁ N₁ le_rfl).trans_lt ENNReal.ofReal_lt_top⟩
  let L : HardyElem p := ⟨f, ⟨hp0, hf_hol, hf_lt_top⟩, hf_outside⟩
  refine ⟨L, Metric.tendsto_atTop.mpr fun ε hε ↦ ?_⟩
  obtain ⟨N, hN⟩ := htail (ε / 2) (half_pos hε)
  refine ⟨N, fun n hn ↦ ?_⟩
  have hENN := hN n hn
  have htoReal : dist (F n) L ≤ ε / 2 := by
    rw [HardyElem.dist_eq]
    change (hardySizeENNReal p ((F n).toFun - f)).toReal ≤ ε / 2
    rw [← ENNReal.toReal_ofReal (half_pos hε).le]
    exact ENNReal.toReal_mono ENNReal.ofReal_ne_top hENN
  exact htoReal.trans_lt (half_lt_self hε)

end HardyElemBanach

/-! ### Node 17.8(d): Vector Space Structure and Triangle-Inequality Failure for `0 < p < 1` -/

/-- For an entire function `h : ℂ → ℂ` and `0 < p < ∞`, `h ∈ H^p(U)` and its Hardy size equals
its boundary radial size at `r = 1`: `hardySize p h = radialSize p h 1`. -/
theorem hardySize_eq_radialSize_one_of_differentiable {p : ℝ≥0∞} (hp0 : p ≠ 0) (hptop : p ≠ ⊤)
    {h : ℂ → ℂ} (hh : Differentiable ℂ h) :
    IsInHardySpace p h ∧ hardySize p h = radialSize p h 1 := by
  have hh_hol : HolomorphicOn h (Metric.ball (0 : ℂ) 1) := fun z _ ↦ hh z
  have hh_cont : Continuous h := hh.continuous
  let h₂ : ℂ → ℂ := fun z ↦ h (2 * z)
  have hh₂_hol : HolomorphicOn h₂ (Metric.ball (0 : ℂ) 1) :=
    fun z _ ↦ hh.comp ((differentiable_const (2 : ℂ)).mul differentiable_id) z
  have hslice_eq : ∀ s : ℝ, radialSlice h₂ (s / 2) = radialSlice h s := by
    intro s
    funext ζ
    dsimp [radialSlice, h₂]
    congr 1
    push_cast
    ring
  have hrad_eq : ∀ s : ℝ, radialSizeENNReal p h₂ (s / 2) = radialSizeENNReal p h s := by
    intro s
    simp only [radialSizeENNReal, radialZeroSize, hslice_eq s]
  have hle_one : ∀ r ∈ Set.Ico (0 : ℝ) 1, radialSizeENNReal p h r ≤ radialSizeENNReal p h 1 := by
    intro r hr
    rw [← hrad_eq r, ← hrad_eq 1]
    exact radialSizeENNReal_mono hh₂_hol p (by linarith [hr.1]) (by linarith [hr.2]) (by norm_num)
  have hcont1 : Continuous (radialSlice h 1) :=
    hh_cont.comp (continuous_const.mul continuous_circlePoint)
  have hfin1 : radialSizeENNReal p h 1 < ⊤ :=
    radialSizeENNReal_lt_top_of_continuous hcont1 p
  have hhardy_le : hardySizeENNReal p h ≤ radialSizeENNReal p h 1 :=
    iSup₂_le hle_one
  have hhardy_fin : hardySizeENNReal p h < ⊤ := hhardy_le.trans_lt hfin1
  refine ⟨⟨hp0, hh_hol, hhardy_fin⟩, ?_⟩
  -- Show `Tendsto (radialSize p h) (𝓝[<] 1) (𝓝 (radialSize p h 1))` by dominated convergence
  let q : ℝ := p.toReal
  have hq_pos : 0 < q := ENNReal.toReal_pos hp0 hptop
  have hΦ_cont : Continuous (fun z : ℂ ↦ ‖h z‖ ^ q) :=
    hh_cont.norm.rpow_const fun _ ↦ Or.inr hq_pos.le
  obtain ⟨z_max, _, hz_max⟩ := (isCompact_closedBall (0 : ℂ) 1).exists_isMaxOn
    (Metric.nonempty_closedBall.mpr zero_le_one) hΦ_cont.continuousOn
  let C : ℝ := ‖h z_max‖ ^ q
  have hint_tendsto : Tendsto (fun r : ℝ ↦ ∫ ζ, ‖radialSlice h r ζ‖ ^ q ∂circleMeasure)
      (𝓝[<] (1 : ℝ)) (𝓝 (∫ ζ, ‖radialSlice h 1 ζ‖ ^ q ∂circleMeasure)) := by
    refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence (fun _ ↦ C) ?_ ?_
      (integrable_const C) ?_
    · refine Eventually.of_forall fun r ↦ ?_
      exact (hΦ_cont.comp (continuous_const.mul continuous_circlePoint)).aestronglyMeasurable
    · filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
      refine Eventually.of_forall fun ζ ↦ ?_
      have hnn : 0 ≤ ‖radialSlice h r ζ‖ ^ q := Real.rpow_nonneg (norm_nonneg _) q
      rw [Real.norm_eq_abs, abs_of_nonneg hnn]
      have hz_cb : (r : ℂ) * circlePoint ζ ∈ Metric.closedBall (0 : ℂ) 1 := by
        have := affine_circlePoint_mem_closedBall 0 hr.1.le ζ
        rw [zero_add] at this
        exact (Metric.closedBall_subset_closedBall hr.2.le) this
      exact hz_max hz_cb
    · refine Eventually.of_forall fun ζ ↦ ?_
      have hcont_r : Continuous (fun r : ℝ ↦ ‖radialSlice h r ζ‖ ^ q) :=
        hΦ_cont.comp (Complex.continuous_ofReal.mul continuous_const)
      exact hcont_r.continuousAt.tendsto.mono_left nhdsWithin_le_nhds
  have hrpow_tendsto : Tendsto
      (fun r : ℝ ↦ (∫ ζ, ‖radialSlice h r ζ‖ ^ q ∂circleMeasure) ^ q⁻¹)
      (𝓝[<] (1 : ℝ))
      (𝓝 ((∫ ζ, ‖radialSlice h 1 ζ‖ ^ q ∂circleMeasure) ^ q⁻¹)) :=
    ((Real.continuous_rpow_const (inv_nonneg.mpr hq_pos.le)).tendsto _).comp hint_tendsto
  have hrad_formula : ∀ r : ℝ, radialSize p h r =
      (∫ ζ, ‖radialSlice h r ζ‖ ^ q ∂circleMeasure) ^ q⁻¹ := by
    intro r
    have hcontr : Continuous (radialSlice h r) :=
      hh_cont.comp (continuous_const.mul continuous_circlePoint)
    unfold radialSize radialSizeENNReal
    rw [ite_eq_right_iff.mpr fun h0 ↦ absurd h0 hp0,
      (memLp_radialSlice_of_continuous hcontr p).eLpNorm_eq_integral_rpow_norm hp0 hptop,
      ENNReal.toReal_ofReal (by positivity)]
  simp_rw [← hrad_formula] at hrpow_tendsto
  exact tendsto_nhds_unique (tendsto_radialSize_nhdsLT_one hh_hol hhardy_fin) hrpow_tendsto

private theorem norm_sq_one_add_div_two_of_norm_eq_one {w : ℂ} (hw : ‖w‖ = 1) :
    ‖(1 + w) / 2‖ ^ 2 = (1 + w.re) / 2 := by
  have hsq : w.re ^ 2 + w.im ^ 2 = 1 := by
    have hns : Complex.normSq w = 1 := by rw [Complex.normSq_eq_norm_sq, hw, one_pow]
    rw [Complex.normSq_apply] at hns
    nlinarith
  rw [← Complex.normSq_eq_norm_sq, Complex.normSq_apply]
  simp only [Complex.add_re, Complex.one_re, Complex.div_ofNat_re,
    Complex.add_im, Complex.one_im, zero_add, Complex.div_ofNat_im]
  nlinarith

private theorem norm_sq_one_sub_div_two_of_norm_eq_one {w : ℂ} (hw : ‖w‖ = 1) :
    ‖(1 - w) / 2‖ ^ 2 = (1 - w.re) / 2 := by
  have hneg : ‖-w‖ = 1 := by simpa using hw
  have h := norm_sq_one_add_div_two_of_norm_eq_one hneg
  simpa [sub_eq_add_neg] using h

/-- **17.8(d) (Failure of the triangle inequality in `Hᵖ` for `0 < p < 1`, RCA p. 338):**
For every `0 < p < 1`, `Hᵖ` is a complex vector space (`hardySubmodule p hp0`), NOT a normed space:
there exist `f, g ∈ Hᵖ` (in fact polynomials `((1 + z)/2)^n` and `((1 - z)/2)^n`) such that
`hardySize p f + hardySize p g < hardySize p (f + g)`. -/
theorem not_triangle_inequality_of_lt_one {p : ℝ≥0∞} (hp0 : p ≠ 0) (hp1 : p < 1) :
    ∃ f g : ℂ → ℂ,
      IsInHardySpace p f ∧
      IsInHardySpace p g ∧
      hardySize p f + hardySize p g < hardySize p (f + g) := by
  have hptop : p ≠ ⊤ := (hp1.trans ENNReal.one_lt_top).ne
  let q : ℝ := p.toReal
  have hq_pos : 0 < q := ENNReal.toReal_pos hp0 hptop
  have hq_lt_one : q < 1 := by
    dsimp [q]
    simpa using (ENNReal.toReal_lt_toReal hptop ENNReal.one_ne_top).mpr hp1
  let fn : ℕ → ℂ → ℂ := fun n z ↦ ((1 + z) / 2) ^ n
  let gn : ℕ → ℂ → ℂ := fun n z ↦ ((1 - z) / 2) ^ n
  have hfn_diff : ∀ n, Differentiable ℂ (fn n) := fun n ↦
    (((differentiable_const (1 : ℂ)).add differentiable_id).div_const (2 : ℂ)).pow n
  have hgn_diff : ∀ n, Differentiable ℂ (gn n) := fun n ↦
    (((differentiable_const (1 : ℂ)).sub differentiable_id).div_const (2 : ℂ)).pow n
  have hfgn_diff : ∀ n, Differentiable ℂ (fn n + gn n) := fun n ↦
    (hfn_diff n).add (hgn_diff n)
  let If : ℕ → ℝ := fun n ↦ ∫ ζ, ‖radialSlice (fn n) 1 ζ‖ ^ q ∂circleMeasure
  let Ig : ℕ → ℝ := fun n ↦ ∫ ζ, ‖radialSlice (gn n) 1 ζ‖ ^ q ∂circleMeasure
  let Ifg : ℕ → ℝ := fun n ↦ ∫ ζ, ‖radialSlice (fn n + gn n) 1 ζ‖ ^ q ∂circleMeasure
  -- Symmetry `Ig n = If n` via `ζ ↦ ζ + π`
  have hIg_eq_If : ∀ n, Ig n = If n := by
    intro n
    dsimp [Ig, If]
    have hshift : (fun ζ : FourierCircle ↦ ‖radialSlice (gn n) 1 ζ‖ ^ q) =
        fun ζ : FourierCircle ↦ ‖radialSlice (fn n) 1 (ζ + (Real.pi : FourierCircle))‖ ^ q := by
      funext ζ
      simp only [radialSlice, Complex.ofReal_one, one_mul, fn, gn, circlePoint_add_pi,
        sub_eq_add_neg]
    rw [hshift]
    exact integral_add_right_eq_self
      (fun ζ : FourierCircle ↦ ‖radialSlice (fn n) 1 ζ‖ ^ q) (Real.pi : FourierCircle)
  -- Pointwise lower bound on `‖fn n + gn n‖^q` on the unit circle
  let α : ℝ := (Real.sqrt (1 / 2)) ^ q
  let β : ℝ := (Real.sqrt (3 / 4)) ^ q
  have hsqrt_half_pos : 0 < Real.sqrt (1 / 2) := Real.sqrt_pos.mpr (by norm_num)
  have hsqrt_34_pos : 0 < Real.sqrt (3 / 4) := Real.sqrt_pos.mpr (by norm_num)
  have hα_pos : 0 < α := Real.rpow_pos_of_pos hsqrt_half_pos q
  have hβ_pos : 0 < β := Real.rpow_pos_of_pos hsqrt_34_pos q
  have hα_lt_β : α < β := by
    refine Real.rpow_lt_rpow hsqrt_half_pos.le ?_ hq_pos
    exact Real.sqrt_lt_sqrt (by norm_num) (by norm_num)
  have hpt_lower : ∀ (n : ℕ) (ζ : FourierCircle),
      ‖radialSlice (fn n) 1 ζ‖ ^ q + ‖radialSlice (gn n) 1 ζ‖ ^ q - 2 * α ^ n ≤
        ‖radialSlice (fn n + gn n) 1 ζ‖ ^ q := by
    intro n ζ
    let w : ℂ := circlePoint ζ
    have hw : ‖w‖ = 1 := norm_circlePoint ζ
    have hslice_f : radialSlice (fn n) 1 ζ = ((1 + w) / 2) ^ n := by
      simp [radialSlice, fn, w]
    have hslice_g : radialSlice (gn n) 1 ζ = ((1 - w) / 2) ^ n := by
      simp [radialSlice, gn, w]
    have hslice_fg : radialSlice (fn n + gn n) 1 ζ = ((1 + w) / 2) ^ n + ((1 - w) / 2) ^ n := by
      simp [radialSlice, fn, gn, w]
    rw [hslice_f, hslice_g, hslice_fg]
    set a : ℂ := ((1 + w) / 2) ^ n
    set b : ℂ := ((1 - w) / 2) ^ n
    rcases le_total 0 w.re with hw_re | hw_re
    · -- On `0 ≤ w.re`, `‖b‖^q ≤ α^n` and `‖a‖^q ≤ ‖a + b‖^q + ‖b‖^q`
      have hb_le1 : ‖(1 - w) / 2‖ ≤ Real.sqrt (1 / 2) := by
        rw [← Real.sqrt_sq (norm_nonneg _), norm_sq_one_sub_div_two_of_norm_eq_one hw]
        exact Real.sqrt_le_sqrt (by linarith)
      have hb_pow : ‖b‖ ^ q ≤ α ^ n := by
        dsimp [b, α]
        rw [norm_pow, ← Real.rpow_natCast (Real.sqrt (1 / 2) ^ q) n,
          ← Real.rpow_mul hsqrt_half_pos.le, mul_comm q (n : ℝ),
          Real.rpow_mul hsqrt_half_pos.le, Real.rpow_natCast]
        exact Real.rpow_le_rpow (pow_nonneg (norm_nonneg _) n)
          (pow_le_pow_left₀ (norm_nonneg _) hb_le1 n) hq_pos.le
      have hsubadd : ‖a‖ ^ q ≤ ‖a + b‖ ^ q + ‖b‖ ^ q := by
        have htri : ‖a‖ ≤ ‖a + b‖ + ‖b‖ := by
          calc ‖a‖ = ‖(a + b) - b‖ := by ring_nf
            _ ≤ ‖a + b‖ + ‖b‖ := norm_sub_le (a + b) b
        exact (Real.rpow_le_rpow (norm_nonneg a) htri hq_pos.le).trans
          (Real.rpow_add_le_add_rpow (norm_nonneg _) (norm_nonneg _) hq_pos.le hq_lt_one.le)
      linarith
    · -- On `w.re ≤ 0`, `‖a‖^q ≤ α^n` and `‖b‖^q ≤ ‖a + b‖^q + ‖a‖^q`
      have ha_le1 : ‖(1 + w) / 2‖ ≤ Real.sqrt (1 / 2) := by
        rw [← Real.sqrt_sq (norm_nonneg _), norm_sq_one_add_div_two_of_norm_eq_one hw]
        exact Real.sqrt_le_sqrt (by linarith)
      have ha_pow : ‖a‖ ^ q ≤ α ^ n := by
        dsimp [a, α]
        rw [norm_pow, ← Real.rpow_natCast (Real.sqrt (1 / 2) ^ q) n,
          ← Real.rpow_mul hsqrt_half_pos.le, mul_comm q (n : ℝ),
          Real.rpow_mul hsqrt_half_pos.le, Real.rpow_natCast]
        exact Real.rpow_le_rpow (pow_nonneg (norm_nonneg _) n)
          (pow_le_pow_left₀ (norm_nonneg _) ha_le1 n) hq_pos.le
      have hsubadd : ‖b‖ ^ q ≤ ‖a + b‖ ^ q + ‖a‖ ^ q := by
        have htri : ‖b‖ ≤ ‖a + b‖ + ‖a‖ := by
          calc ‖b‖ = ‖(a + b) - a‖ := by ring_nf
            _ ≤ ‖a + b‖ + ‖a‖ := norm_sub_le (a + b) a
        exact (Real.rpow_le_rpow (norm_nonneg b) htri hq_pos.le).trans
          (Real.rpow_add_le_add_rpow (norm_nonneg _) (norm_nonneg _) hq_pos.le hq_lt_one.le)
      linarith
  have hIfg_lower : ∀ n : ℕ, 2 * If n - 2 * α ^ n ≤ Ifg n := by
    intro n
    have hint_f : Integrable (fun ζ ↦ ‖radialSlice (fn n) 1 ζ‖ ^ q) circleMeasure :=
      (((hfn_diff n).continuous.comp (continuous_const.mul continuous_circlePoint)).norm.rpow_const
        fun _ ↦ Or.inr hq_pos.le).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hint_g : Integrable (fun ζ ↦ ‖radialSlice (gn n) 1 ζ‖ ^ q) circleMeasure :=
      (((hgn_diff n).continuous.comp (continuous_const.mul continuous_circlePoint)).norm.rpow_const
        fun _ ↦ Or.inr hq_pos.le).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hint_fg : Integrable (fun ζ ↦ ‖radialSlice (fn n + gn n) 1 ζ‖ ^ q) circleMeasure :=
      (((hfgn_diff n).continuous.comp (continuous_const.mul continuous_circlePoint)).norm.rpow_const
        fun _ ↦ Or.inr hq_pos.le).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hle := integral_mono ((hint_f.add hint_g).sub (integrable_const (2 * α ^ n))) hint_fg
      (hpt_lower n)
    simp only [Pi.sub_apply] at hle
    rw [integral_sub (hint_f.add hint_g) (integrable_const _)] at hle
    simp only [Pi.add_apply] at hle
    rw [integral_add hint_f hint_g,
      integral_const, Measure.real, measure_univ, ENNReal.toReal_one, one_smul] at hle
    change If n + Ig n - 2 * α ^ n ≤ Ifg n at hle
    rw [hIg_eq_If n] at hle
    linarith
  -- Lower bound on `If n` via the open arc `U₀ = {ζ | 1/2 < (circlePoint ζ).re}`
  let U₀ : Set FourierCircle := {ζ : FourierCircle | (1 / 2 : ℝ) < (circlePoint ζ).re}
  have hU₀_open : IsOpen U₀ :=
    isOpen_lt continuous_const (Complex.continuous_re.comp continuous_circlePoint)
  have h0_U₀ : (0 : FourierCircle) ∈ U₀ := by
    dsimp [U₀]
    rw [circlePoint_zero]
    norm_num
  have hU₀_ne : circleMeasure U₀ ≠ 0 := hU₀_open.measure_ne_zero circleMeasure ⟨0, h0_U₀⟩
  let c₀ : ℝ := (circleMeasure U₀).toReal
  have hc₀_pos : 0 < c₀ := ENNReal.toReal_pos hU₀_ne (measure_ne_top circleMeasure U₀)
  have hIf_lower : ∀ n : ℕ, c₀ * β ^ n ≤ If n := by
    intro n
    have hint_f : Integrable (fun ζ ↦ ‖radialSlice (fn n) 1 ζ‖ ^ q) circleMeasure :=
      (((hfn_diff n).continuous.comp (continuous_const.mul continuous_circlePoint)).norm.rpow_const
        fun _ ↦ Or.inr hq_pos.le).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hind_int : Integrable (U₀.indicator fun _ : FourierCircle ↦ β ^ n) circleMeasure :=
      (integrable_const (β ^ n)).indicator hU₀_open.measurableSet
    have hind_le : ∀ ζ : FourierCircle,
        U₀.indicator (fun _ ↦ β ^ n) ζ ≤ ‖radialSlice (fn n) 1 ζ‖ ^ q := by
      intro ζ
      by_cases hζ : ζ ∈ U₀
      · rw [Set.indicator_of_mem hζ]
        have hre : (1 / 2 : ℝ) < (circlePoint ζ).re := hζ
        have hw : ‖circlePoint ζ‖ = 1 := norm_circlePoint ζ
        have h34_le : Real.sqrt (3 / 4) ≤ ‖(1 + circlePoint ζ) / 2‖ := by
          rw [← Real.sqrt_sq (norm_nonneg _), norm_sq_one_add_div_two_of_norm_eq_one hw]
          exact Real.sqrt_le_sqrt (by linarith)
        dsimp [β, radialSlice, fn]
        rw [one_mul, norm_pow,
          ← Real.rpow_natCast (Real.sqrt (3 / 4) ^ q) n,
          ← Real.rpow_mul hsqrt_34_pos.le, mul_comm q (n : ℝ),
          Real.rpow_mul hsqrt_34_pos.le, Real.rpow_natCast]
        exact Real.rpow_le_rpow (pow_nonneg hsqrt_34_pos.le n)
          (pow_le_pow_left₀ hsqrt_34_pos.le h34_le n) hq_pos.le
      · rw [Set.indicator_of_notMem hζ]
        exact Real.rpow_nonneg (norm_nonneg _) q
    have hle := integral_mono hind_int hint_f hind_le
    rw [integral_indicator_const _ hU₀_open.measurableSet, Measure.real, smul_eq_mul] at hle
    exact hle
  -- Choose `n` large enough that `2 * α^n < (2 - 2^q) * (c₀ * β^n)`
  have h2q_lt_2 : (2 : ℝ) ^ q < 2 := by
    calc (2 : ℝ) ^ q < (2 : ℝ) ^ (1 : ℝ) := Real.rpow_lt_rpow_of_exponent_lt one_lt_two hq_lt_one
      _ = 2 := Real.rpow_one 2
  let δ : ℝ := 2 - (2 : ℝ) ^ q
  have hδ_pos : 0 < δ := sub_pos.mpr h2q_lt_2
  have hratio_lt : α / β < 1 := (div_lt_one hβ_pos).mpr hα_lt_β
  have hratio_nn : 0 ≤ α / β := div_nonneg hα_pos.le hβ_pos.le
  have htend_zero : Tendsto (fun n : ℕ ↦ (α / β) ^ n) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one hratio_nn hratio_lt
  obtain ⟨n, hn_lt⟩ := (tendsto_order.mp htend_zero).2 (δ * c₀ / 2) (by positivity) |>.exists
  have h2α_lt : 2 * α ^ n < δ * (c₀ * β ^ n) := by
    have hβn_pos : 0 < β ^ n := pow_pos hβ_pos n
    have hpow_div : α ^ n = (α / β) ^ n * β ^ n := by
      rw [div_pow, div_mul_cancel₀ _ hβn_pos.ne']
    rw [hpow_div]
    calc 2 * ((α / β) ^ n * β ^ n)
        < 2 * ((δ * c₀ / 2) * β ^ n) :=
          mul_lt_mul_of_pos_left (mul_lt_mul_of_pos_right hn_lt hβn_pos) zero_lt_two
      _ = δ * (c₀ * β ^ n) := by ring
  have h2q_If_lt : (2 : ℝ) ^ q * If n < Ifg n := by
    have h1 : δ * (c₀ * β ^ n) ≤ δ * If n :=
      mul_le_mul_of_nonneg_left (hIf_lower n) hδ_pos.le
    have h2 : 2 * α ^ n < (2 - (2 : ℝ) ^ q) * If n := h2α_lt.trans_le h1
    have h3 := hIfg_lower n
    linarith
  -- Raise `(2^q * If n) < Ifg n` to `q⁻¹ > 0` and identify with `hardySize`
  obtain ⟨hf_hardy, hf_eq⟩ := hardySize_eq_radialSize_one_of_differentiable hp0 hptop (hfn_diff n)
  obtain ⟨hg_hardy, hg_eq⟩ := hardySize_eq_radialSize_one_of_differentiable hp0 hptop (hgn_diff n)
  obtain ⟨_, hfg_eq⟩ := hardySize_eq_radialSize_one_of_differentiable hp0 hptop (hfgn_diff n)
  have hrad_integral : ∀ h : ℂ → ℂ, Differentiable ℂ h →
      radialSize p h 1 = (∫ ζ, ‖radialSlice h 1 ζ‖ ^ q ∂circleMeasure) ^ q⁻¹ := by
    intro h hh
    have hcont : Continuous (radialSlice h 1) :=
      hh.continuous.comp (continuous_const.mul continuous_circlePoint)
    unfold radialSize radialSizeENNReal
    rw [ite_eq_right_iff.mpr fun h0 ↦ absurd h0 hp0,
      (memLp_radialSlice_of_continuous hcont p).eLpNorm_eq_integral_rpow_norm hp0 hptop,
      ENNReal.toReal_ofReal (by positivity)]
  have hIf_pos : 0 < If n := (mul_pos hc₀_pos (pow_pos hβ_pos n)).trans_le (hIf_lower n)
  refine ⟨fn n, gn n, hf_hardy, hg_hardy, ?_⟩
  rw [hf_eq, hg_eq, hfg_eq, hrad_integral _ (hfn_diff n), hrad_integral _ (hgn_diff n),
    hrad_integral _ (hfgn_diff n)]
  change (If n) ^ q⁻¹ + (Ig n) ^ q⁻¹ < (Ifg n) ^ q⁻¹
  rw [hIg_eq_If n, ← two_mul]
  have h2_eq : 2 * (If n) ^ q⁻¹ = ((2 : ℝ) ^ q * If n) ^ q⁻¹ := by
    rw [Real.mul_rpow (by positivity) hIf_pos.le, ← Real.rpow_mul zero_le_two,
      mul_inv_cancel₀ hq_pos.ne', Real.rpow_one]
  rw [h2_eq]
  exact Real.rpow_lt_rpow (by positivity) h2q_If_lt (inv_pos.mpr hq_pos)

/-- Bundled `HardyElem p` version of `17.8(d)`: for `0 < p < 1`, the triangle inequality fails on
`HardyElem p`. -/
theorem HardyElem.not_triangle_inequality_of_lt_one {p : ℝ≥0∞} (hp0 : p ≠ 0) (hp1 : p < 1) :
    ∃ F G : HardyElem p,
      hardySize p F.toFun + hardySize p G.toFun < hardySize p (F + G).toFun := by
  obtain ⟨f, g, hf, hg, hlt⟩ := RudinRCA.Chapter17.not_triangle_inequality_of_lt_one hp0 hp1
  let F : HardyElem p := HardyElem.ofIsInHardySpace f hf
  let G : HardyElem p := HardyElem.ofIsInHardySpace g hg
  refine ⟨F, G, ?_⟩
  have hFG_eq : EqOn (F + G).toFun (f + g) (Metric.ball (0 : ℂ) 1) := by
    intro z hz
    simp [F, G, hz]
  rw [HardyElem.hardySize_ofIsInHardySpace f hf,
    HardyElem.hardySize_ofIsInHardySpace g hg,
    hardySize_congr_ball p hFG_eq]
  exact hlt

/-- **Theorem 17.8 (Radial monotonicity, Banach space structure for `1 ≤ p ≤ ∞`, and vector space
without triangle inequality for `0 < p < 1`, RCA p. 338):**
- `(a)` For every `f ∈ H(U)` and `0 ≤ p ≤ ∞`, `r ↦ ‖f_r‖_p` is nondecreasing on `[0, 1)` and
  `lim_{r → 1⁻} ‖f_r‖_p = ‖f‖_p`.
- `(b)` & `(c)` For `1 ≤ p ≤ ∞`, `HardyElem p` with `‖F‖ = hardySize p F.toFun` is a complex Banach
  space (`NormedAddCommGroup (HardyElem p)`, `NormedSpace ℂ (HardyElem p)`,
  `CompleteSpace (HardyElem p)`).
- `(d)` For `0 < p < 1`, `Hᵖ` is a complex vector space (`hardySubmodule p hp0` / `Module ℂ (HardyElem p)`),
  and the triangle inequality `hardySize p (f + g) ≤ hardySize p f + hardySize p g` fails. -/
theorem theorem17_8 :
    -- (a) Radial monotonicity and left limit at `1` for all `0 ≤ p ≤ ∞`
    (∀ (f : ℂ → ℂ), HolomorphicOn f (Metric.ball (0 : ℂ) 1) → ∀ (p : ℝ≥0∞),
      (∀ ⦃r₁ r₂ : ℝ⦄, 0 ≤ r₁ → r₁ ≤ r₂ → r₂ < 1 →
        radialSizeENNReal p f r₁ ≤ radialSizeENNReal p f r₂) ∧
      Tendsto (radialSizeENNReal p f) (𝓝[<] (1 : ℝ)) (𝓝 (hardySizeENNReal p f))) ∧
    -- (b) & (c) Triangle inequality, homogeneity, definiteness, and completeness for `1 ≤ p ≤ ∞`
    (∀ (p : ℝ≥0∞) [Fact (1 ≤ p)],
      (∀ F G : HardyElem p, ‖F + G‖ ≤ ‖F‖ + ‖G‖) ∧
      (∀ (c : ℂ) (F : HardyElem p), ‖c • F‖ = ‖c‖ * ‖F‖) ∧
      CompleteSpace (HardyElem p)) ∧
    -- (d) Vector space closure for `0 < p < 1` and failure of triangle inequality
    (∀ (p : ℝ≥0∞), p ≠ 0 → p < 1 →
      (∀ f g : ℂ → ℂ, IsInHardySpace p f → IsInHardySpace p g → IsInHardySpace p (f + g)) ∧
      (∀ (c : ℂ) (f : ℂ → ℂ), IsInHardySpace p f → IsInHardySpace p (c • f)) ∧
      (∃ f g : ℂ → ℂ, IsInHardySpace p f ∧ IsInHardySpace p g ∧
        hardySize p f + hardySize p g < hardySize p (f + g))) :=
  ⟨fun _ hf p ↦ ⟨fun _ _ hr₁ hr₁₂ hr₂ ↦ radialSizeENNReal_mono hf p hr₁ hr₁₂ hr₂,
      tendsto_radialSizeENNReal_nhdsLT_one hf p⟩,
   fun _ _ ↦ ⟨norm_add_le, norm_smul, inferInstance⟩,
   fun _ hp0 hp1 ↦ ⟨fun _ _ hf hg ↦ hf.add hg,
      fun c _ hf ↦ hf.smul c,
      not_triangle_inequality_of_lt_one hp0 hp1⟩⟩


instance fact_one_le_two : Fact ((1 : ℝ≥0∞) ≤ 2) := ⟨by norm_num⟩

/-- Radial boundary limit `f*(ζ) = lim_{r → 1⁻} f(r ζ)` on `FourierCircle`. -/
def radialBoundaryLimit (f : ℂ → ℂ) (ζ : RudinRCA.Chapter04.FourierCircle) : ℂ :=
  limUnder (𝓝[<] (1 : ℝ)) (fun r : ℝ ↦ radialSlice f r ζ)

structure HardyPartBInterface : Prop where
  blaschke_div :
    ∀ {f : ℂ → ℂ}, IsInNevanlinnaClassCh17 f → (∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) →
      ∃ B g : ℂ → ℂ,
        RudinRCA.Chapter15.IsBlaschkeProduct B ∧
        IsInNevanlinnaClassCh17 g ∧
        (∀ z ∈ Metric.ball (0 : ℂ) 1, g z ≠ 0) ∧
        (∀ z ∈ Metric.ball (0 : ℂ) 1, f z = B z * g z) ∧
        hardySizeENNReal 0 g = hardySizeENNReal 0 f ∧
        (∀ p : ℝ≥0∞, p ≠ 0 →
          (IsInHardySpace p f ↔ IsInHardySpace p g) ∧
          hardySizeENNReal p g = hardySizeENNReal p f)
  hardy_boundary :
    ∀ {p : ℝ≥0∞} {f : ℂ → ℂ}, p ≠ 0 → IsInHardySpace p f →
      (∀ᵐ ζ ∂RudinRCA.Chapter04.circleMeasure,
        Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
      MeasureTheory.MemLp (radialBoundaryLimit f) p RudinRCA.Chapter04.circleMeasure ∧
      MeasureTheory.eLpNorm (radialBoundaryLimit f) p RudinRCA.Chapter04.circleMeasure =
        hardySizeENNReal p f ∧
      (p ≠ ⊤ → Tendsto
        (fun r : ℝ ↦ MeasureTheory.eLpNorm (radialSlice f r - radialBoundaryLimit f) p
          RudinRCA.Chapter04.circleMeasure)
        (𝓝[<] 1) (𝓝 0)) ∧
      (1 ≤ p → ∀ z ∈ Metric.ball (0 : ℂ) 1,
        f z = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit f ζ
          ∂RudinRCA.Chapter04.circleMeasure)
  h2_series :
    ∀ {f : ℂ → ℂ}, HolomorphicOn f (Metric.ball (0 : ℂ) 1) →
      let a : ℕ → ℂ := fun n ↦ iteratedDeriv n f 0 / (Nat.factorial n : ℂ)
      (∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ a n * z ^ n) (f z)) ∧
      (IsInHardySpace 2 f ↔ Summable (fun n : ℕ ↦ ‖a n‖ ^ 2)) ∧
      (IsInHardySpace 2 f →
        (hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖a n‖ ^ 2 ∧
        ∀ n : ℤ,
          ∫ ζ, radialBoundaryLimit f ζ * star (RudinRCA.Chapter04.trigMonomial n ζ)
            ∂RudinRCA.Chapter04.circleMeasure =
            if 0 ≤ n then a n.toNat else 0)

end PartASection

namespace PartB
open Set Function Filter MeasureTheory Topology
open scoped ENNReal NNReal Real
open RudinRCA.Chapter04 (FourierCircle fourierCircleHomeomorphism circleMeasure CircleLp)
open RudinRCA.Chapter10 (HolomorphicOn IsRegion)

/-! ### Private Circle, Subharmonic, and Radial-Monotonicity Helpers -/

@[simp]
private theorem circlePoint_coe (t : ℝ) :
    circlePoint (t : FourierCircle) = Complex.exp ((t : ℂ) * Complex.I) :=
  RudinRCA.Chapter04.fourierCircleHomeomorphism_apply t

@[simp]
private theorem circlePoint_zero : circlePoint 0 = 1 := by
  rw [← QuotientAddGroup.mk_zero, circlePoint_coe]
  simp

private theorem continuous_circlePoint : Continuous circlePoint :=
  continuous_subtype_val.comp fourierCircleHomeomorphism.continuous

private theorem circlePoint_mem_sphere (ζ : FourierCircle) :
    circlePoint ζ ∈ Metric.sphere (0 : ℂ) 1 :=
  (fourierCircleHomeomorphism ζ).2

@[simp]
private theorem norm_circlePoint (ζ : FourierCircle) : ‖circlePoint ζ‖ = 1 :=
  RudinRCA.Chapter17.norm_circlePoint ζ

private theorem circlePoint_injective : Function.Injective circlePoint :=
  Subtype.val_injective.comp fourierCircleHomeomorphism.injective

private theorem circlePoint_surjective_sphere {w : ℂ} (hw : w ∈ Metric.sphere (0 : ℂ) 1) :
    ∃ ζ : FourierCircle, circlePoint ζ = w :=
  ⟨fourierCircleHomeomorphism.symm ⟨w, hw⟩,
    congrArg Subtype.val (fourierCircleHomeomorphism.apply_symm_apply ⟨w, hw⟩)⟩

private theorem affine_circlePoint_eq_circleMap (a : ℂ) (r t : ℝ) :
    a + (r : ℂ) * circlePoint (t : FourierCircle) = circleMap a r t := by
  rw [circlePoint_coe, circleMap]

private theorem affine_circlePoint_mem_sphere (a : ℂ) {r : ℝ} (hr : 0 ≤ r) (ζ : FourierCircle) :
    a + (r : ℂ) * circlePoint ζ ∈ Metric.sphere a r := by
  rw [Metric.mem_sphere, dist_self_add_left, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg hr, norm_circlePoint, mul_one]

private theorem affine_circlePoint_mem_closedBall (a : ℂ) {r : ℝ} (hr : 0 ≤ r) (ζ : FourierCircle) :
    a + (r : ℂ) * circlePoint ζ ∈ Metric.closedBall a r :=
  Metric.sphere_subset_closedBall (affine_circlePoint_mem_sphere a hr ζ)

private theorem integral_circleMeasure_eq_circleAverage {E : Type*}
    [NormedAddCommGroup E] [NormedSpace ℝ E] (g : ℂ → E) (a : ℂ) (r : ℝ) :
    (∫ ζ, g (a + (r : ℂ) * circlePoint ζ) ∂circleMeasure) = Real.circleAverage g a r := by
  rw [RudinRCA.Chapter04.circleIntegral_interval,
    RudinRCA.Chapter11.circleAverage_eq_integral_neg_pi_pi]
  simp only [circlePoint_coe, one_div]

private theorem integrable_circleMeasure_iff_intervalIntegrable {E : Type*}
    [NormedAddCommGroup E] (g : FourierCircle → E) :
    Integrable g circleMeasure ↔
      IntervalIntegrable (fun t : ℝ ↦ g (t : FourierCircle)) volume (-Real.pi) Real.pi := by
  have hT : (0 : ℝ) < 2 * Real.pi := by positivity
  have hvol : (volume : Measure FourierCircle) = ENNReal.ofReal (2 * Real.pi) • circleMeasure :=
    AddCircle.volume_eq_smul_haarAddCircle
  have hint_vol : Integrable g circleMeasure ↔ Integrable g (volume : Measure FourierCircle) := by
    rw [hvol]
    refine ⟨fun h ↦ h.smul_measure (by finiteness), fun h ↦ ?_⟩
    have h' := h.smul_measure (c := (ENNReal.ofReal (2 * Real.pi))⁻¹) (by finiteness)
    rwa [smul_smul, ENNReal.inv_mul_cancel (by positivity) (by finiteness), one_smul] at h'
  rw [hint_vol]
  have hlen : -Real.pi + 2 * Real.pi = Real.pi := by ring
  have hioc : IntervalIntegrable (fun t : ℝ ↦ g (t : FourierCircle)) volume (-Real.pi) Real.pi ↔
      IntegrableOn (fun t : ℝ ↦ g (t : FourierCircle))
        (Ioc (-Real.pi) (-Real.pi + 2 * Real.pi)) volume := by
    rw [hlen, intervalIntegrable_iff_integrableOn_Ioc_of_le (by linarith [Real.pi_pos])]
  rw [hioc]
  have hmp : MeasurePreserving ((↑) : ℝ → FourierCircle)
      (volume.restrict (Ioc (-Real.pi) (-Real.pi + 2 * Real.pi))) volume :=
    AddCircle.measurePreserving_mk (2 * Real.pi) (-Real.pi)
  let e := AddCircle.measurableEquivIoc (2 * Real.pi) (-Real.pi)
  have hmp_sub : MeasurePreserving (Subtype.val ∘ e) volume
      (volume.restrict (Ioc (-Real.pi) (-Real.pi + 2 * Real.pi))) :=
    (measurePreserving_subtype_coe measurableSet_Ioc).comp
      (AddCircle.measurePreserving_equivIoc (2 * Real.pi) (a := -Real.pi))
  constructor
  · intro hg
    refine ⟨hg.aestronglyMeasurable.comp_quasiMeasurePreserving hmp.quasiMeasurePreserving, ?_⟩
    rw [HasFiniteIntegral, AddCircle.lintegral_preimage (2 * Real.pi) (-Real.pi) (fun z ↦ ‖g z‖ₑ)]
    exact hg.hasFiniteIntegral
  · intro hg
    refine ⟨(hg.1.comp_quasiMeasurePreserving hmp_sub.quasiMeasurePreserving).congr
      (Eventually.of_forall fun z ↦ congrArg g (e.left_inv z)), ?_⟩
    rw [HasFiniteIntegral,
      ← AddCircle.lintegral_preimage (2 * Real.pi) (-Real.pi) (fun z ↦ ‖g z‖ₑ)]
    exact hg.2

private theorem integrable_affine_circlePoint_iff_circleIntegrable {E : Type*}
    [NormedAddCommGroup E] (g : ℂ → E) (a : ℂ) (r : ℝ) :
    Integrable (fun ζ ↦ g (a + (r : ℂ) * circlePoint ζ)) circleMeasure ↔
      CircleIntegrable g a r := by
  rw [integrable_circleMeasure_iff_intervalIntegrable]
  have hper : Function.Periodic (fun t : ℝ ↦ g (circleMap a r t)) (2 * Real.pi) :=
    fun t ↦ by dsimp only; rw [periodic_circleMap]
  have heq : (fun t : ℝ ↦ g (a + (r : ℂ) * circlePoint (t : FourierCircle))) =
      fun t : ℝ ↦ g (circleMap a r t) := by
    funext t
    rw [affine_circlePoint_eq_circleMap]
  rw [heq, CircleIntegrable]
  have h1 : -Real.pi + 2 * Real.pi = Real.pi := by ring
  have h2 : (0 : ℝ) + 2 * Real.pi = 2 * Real.pi := by ring
  have hp_iff := hper.intervalIntegrable_iff (t₁ := -Real.pi) (t₂ := 0)
  rwa [h1, h2] at hp_iff

private theorem circleMeasure_singleton (ζ₀ : FourierCircle) : circleMeasure {ζ₀} = 0 := by
  obtain ⟨t, rfl⟩ := QuotientAddGroup.mk_surjective ζ₀
  have hvol : (volume : Measure FourierCircle) {(t : FourierCircle)} = 0 := by
    rw [← (AddCircle.measurePreserving_mk (2 * Real.pi) (t - 1)).map_eq,
      Measure.map_apply AddCircle.measurable_mk' (measurableSet_singleton _),
      Measure.restrict_apply' measurableSet_Ioc]
    refine measure_mono_null (fun s hs ↦ ?_) (Real.volume_singleton (a := t))
    rcases hs with ⟨hs_mem, hs_Ioc⟩
    rw [mem_preimage, mem_singleton_iff] at hs_mem
    have ht_Ioc : t ∈ Ioc (t - 1) (t - 1 + 2 * Real.pi) :=
      ⟨by linarith, by linarith [Real.two_le_pi]⟩
    have heq_sub : AddCircle.equivIoc (2 * Real.pi) (t - 1) (s : FourierCircle) =
        AddCircle.equivIoc (2 * Real.pi) (t - 1) (t : FourierCircle) :=
      congrArg _ hs_mem
    rw [AddCircle.equivIoc_coe_eq hs_Ioc, AddCircle.equivIoc_coe_eq ht_Ioc] at heq_sub
    exact mem_singleton_iff.mpr (congrArg Subtype.val heq_sub)
  rw [AddCircle.volume_eq_smul_haarAddCircle, Measure.smul_apply, smul_eq_mul,
    mul_eq_zero] at hvol
  exact hvol.resolve_left (ENNReal.ofReal_ne_zero_iff.mpr (by positivity))


private def erealCircleMeanP (u : ℂ → EReal) (a : ℂ) (r : ℝ) : EReal :=
  (∫⁻ ζ, ENNReal.ofReal (max 0 (u (a + (r : ℂ) * circlePoint ζ)).toReal)
      ∂RudinRCA.Chapter04.circleMeasure : EReal) -
    (∫⁻ ζ, (if u (a + (r : ℂ) * circlePoint ζ) = ⊥ then ⊤
      else ENNReal.ofReal (max 0 (-(u (a + (r : ℂ) * circlePoint ζ)).toReal)))
      ∂RudinRCA.Chapter04.circleMeasure : EReal)

private structure SubharmonicOnP (Ω : Set ℂ) (u : ℂ → EReal) : Prop where
  isOpen : IsOpen Ω
  lt_top : ∀ z ∈ Ω, u z < ⊤
  upperSemicontinuousOn : UpperSemicontinuousOn u Ω
  submean : ∀ a : ℂ, ∀ r : ℝ, 0 < r → Metric.closedBall a r ⊆ Ω →
    erealCircleMeanP u a r ≠ ⊥ ∧ u a ≤ erealCircleMeanP u a r

private theorem SubharmonicOnP.congr {Ω : Set ℂ} {u₁ u₂ : ℂ → EReal}
    (hu : SubharmonicOnP Ω u₁) (heq : Set.EqOn u₁ u₂ Ω) : SubharmonicOnP Ω u₂ where
  isOpen := hu.isOpen
  lt_top z hz := heq hz ▸ hu.lt_top z hz
  upperSemicontinuousOn := by
    intro z hz y hy
    rw [← heq hz] at hy
    filter_upwards [hu.upperSemicontinuousOn z hz y hy, self_mem_nhdsWithin] with w hw hwΩ
    rwa [← heq hwΩ]
  submean a r hr hsub := by
    have hmean : erealCircleMeanP u₁ a r = erealCircleMeanP u₂ a r := by
      unfold erealCircleMeanP
      have hpt : ∀ ζ : FourierCircle,
          u₁ (a + (r : ℂ) * circlePoint ζ) = u₂ (a + (r : ℂ) * circlePoint ζ) :=
        fun ζ ↦ heq (hsub (affine_circlePoint_mem_closedBall a hr.le ζ))
      simp_rw [hpt]
    have ha : u₁ a = u₂ a := heq (hsub (Metric.mem_closedBall_self hr.le))
    rw [← hmean, ← ha]
    exact hu.submean a r hr hsub

private theorem exists_real_upper_bound_of_usc {Ω K : Set ℂ} {u : ℂ → EReal}
    (h_top : ∀ z ∈ Ω, u z < ⊤) (h_usc : UpperSemicontinuousOn u Ω)
    (hK : IsCompact K) (hKΩ : K ⊆ Ω) :
    ∃ M : ℝ, 0 ≤ M ∧ ∀ z ∈ K, u z ≤ (M : EReal) := by
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · exact ⟨0, le_rfl, fun _ hz ↦ False.elim hz⟩
  · obtain ⟨z₀, hz₀K, hz₀max⟩ := (h_usc.mono hKΩ).exists_isMaxOn hKne hK
    have hz₀_top : u z₀ < ⊤ := h_top z₀ (hKΩ hz₀K)
    rcases eq_or_ne (u z₀) ⊥ with hbot | hne_bot
    · refine ⟨0, le_rfl, fun z hz ↦ ?_⟩
      exact (hz₀max hz).trans (by rw [hbot]; exact bot_le)
    · lift u z₀ to ℝ using ⟨hz₀_top.ne, hne_bot⟩ with c hc
      refine ⟨max 0 c, le_max_left 0 c, fun z hz ↦ ?_⟩
      have hle : u z ≤ u z₀ := hz₀max hz
      rw [← hc] at hle
      exact hle.trans (EReal.coe_le_coe_iff.mpr (le_max_right 0 c))

private theorem erealCircleMeanP_ne_bot_iff {Ω : Set ℂ} {u : ℂ → EReal}
    (hΩ : IsOpen Ω) (h_top : ∀ z ∈ Ω, u z < ⊤) (h_usc : UpperSemicontinuousOn u Ω)
    {a : ℂ} {r : ℝ} (hr : 0 ≤ r) (hsub : Metric.closedBall a r ⊆ Ω) :
    (erealCircleMeanP u a r ≠ ⊥ ↔
      (∀ᵐ ζ ∂circleMeasure, u (a + (r : ℂ) * circlePoint ζ) ≠ ⊥) ∧
        Integrable (fun ζ ↦ (u (a + (r : ℂ) * circlePoint ζ)).toReal) circleMeasure) ∧
    (erealCircleMeanP u a r ≠ ⊥ →
      erealCircleMeanP u a r =
        ((∫ ζ, (u (a + (r : ℂ) * circlePoint ζ)).toReal ∂circleMeasure : ℝ) : EReal)) := by
  let v : FourierCircle → EReal := fun ζ ↦ u (a + (r : ℂ) * circlePoint ζ)
  have hv_mem : ∀ ζ : FourierCircle, a + (r : ℂ) * circlePoint ζ ∈ Ω :=
    fun ζ ↦ hsub (affine_circlePoint_mem_closedBall a hr ζ)
  have hv_usc : UpperSemicontinuous v := by
    intro ζ₀ y hy
    have h1 : ∀ᶠ w in 𝓝 (a + (r : ℂ) * circlePoint ζ₀), u w < y := by
      have hnhds : 𝓝[Ω] (a + (r : ℂ) * circlePoint ζ₀) = 𝓝 (a + (r : ℂ) * circlePoint ζ₀) :=
        nhdsWithin_eq_nhds.mpr (hΩ.mem_nhds (hv_mem ζ₀))
      simpa [hnhds] using h_usc _ (hv_mem ζ₀) y hy
    exact (continuous_const.add (continuous_const.mul continuous_circlePoint)).continuousAt.eventually h1
  have hv_meas : Measurable v := hv_usc.measurable
  obtain ⟨M, hM0, hM_bound⟩ :=
    exists_real_upper_bound_of_usc h_top h_usc (isCompact_closedBall a r) hsub
  let fPos : FourierCircle → ℝ≥0∞ := fun ζ ↦ ENNReal.ofReal (max 0 (v ζ).toReal)
  let fNeg : FourierCircle → ℝ≥0∞ :=
    fun ζ ↦ if v ζ = ⊥ then ⊤ else ENNReal.ofReal (max 0 (-(v ζ).toReal))
  have hfPos_meas : Measurable fPos :=
    ENNReal.measurable_ofReal.comp (measurable_const.max hv_meas.ereal_toReal)
  have hfNeg_meas : Measurable fNeg := by
    refine Measurable.ite (measurableSet_eq_fun hv_meas measurable_const) measurable_const ?_
    exact ENNReal.measurable_ofReal.comp (measurable_const.max hv_meas.ereal_toReal.neg)
  have hIPos_lt_top : ∫⁻ ζ, fPos ζ ∂circleMeasure < ⊤ := by
    calc ∫⁻ ζ, fPos ζ ∂circleMeasure
        ≤ ∫⁻ _, ENNReal.ofReal M ∂circleMeasure := by
          refine lintegral_mono fun ζ ↦ ENNReal.ofReal_le_ofReal ?_
          refine max_le hM0 ?_
          rcases eq_or_ne (v ζ) ⊥ with hb | hb
          · simp [hb, hM0]
          · have hle := hM_bound _ (affine_circlePoint_mem_closedBall a hr ζ)
            exact EReal.toReal_le_toReal hle hb (EReal.coe_ne_top M)
      _ = ENNReal.ofReal M := by simp
      _ < ⊤ := ENNReal.ofReal_lt_top
  have hmean_eq : erealCircleMeanP u a r =
      (∫⁻ ζ, fPos ζ ∂circleMeasure : EReal) - (∫⁻ ζ, fNeg ζ ∂circleMeasure : EReal) := rfl
  have hne_bot_iff_INeg : erealCircleMeanP u a r ≠ ⊥ ↔ ∫⁻ ζ, fNeg ζ ∂circleMeasure < ⊤ := by
    rw [hmean_eq]
    set IPos := ∫⁻ ζ, fPos ζ ∂circleMeasure
    set INeg := ∫⁻ ζ, fNeg ζ ∂circleMeasure
    have hIPos_coe : (IPos : EReal) = (IPos.toReal : EReal) :=
      (EReal.coe_ennreal_toReal hIPos_lt_top.ne).symm
    rw [hIPos_coe]
    rcases eq_top_or_lt_top INeg with htop | hlt
    · simp [htop, sub_eq_add_neg]
    · have hINeg_coe : (INeg : EReal) = (INeg.toReal : EReal) :=
        (EReal.coe_ennreal_toReal hlt.ne).symm
      rw [hINeg_coe, ← EReal.coe_sub]
      exact iff_of_true (EReal.coe_ne_bot _) hlt
  have h_iff : ∫⁻ ζ, fNeg ζ ∂circleMeasure < ⊤ ↔
      (∀ᵐ ζ ∂circleMeasure, v ζ ≠ ⊥) ∧ Integrable (fun ζ ↦ (v ζ).toReal) circleMeasure := by
    constructor
    · intro hINeg
      have hae_lt : ∀ᵐ ζ ∂circleMeasure, fNeg ζ < ⊤ := ae_lt_top hfNeg_meas hINeg.ne
      have hae_nb : ∀ᵐ ζ ∂circleMeasure, v ζ ≠ ⊥ := by
        filter_upwards [hae_lt] with ζ hζ hbot
        simp [fNeg, hbot] at hζ
      refine ⟨hae_nb, hv_meas.ereal_toReal.aestronglyMeasurable, ?_⟩
      rw [HasFiniteIntegral]
      have hle : ∀ ζ, ‖(v ζ).toReal‖ₑ ≤ fPos ζ + fNeg ζ := by
        intro ζ
        by_cases hb : v ζ = ⊥
        · simp [fNeg, hb]
        · simp only [fPos, fNeg, hb, ↓reduceIte]
          rw [Real.enorm_eq_ofReal_abs, ← ENNReal.ofReal_add (le_max_left _ _) (le_max_left _ _)]
          refine ENNReal.ofReal_le_ofReal ?_
          rcases le_total 0 (v ζ).toReal with h0 | h0
          · rw [abs_of_nonneg h0, max_eq_right h0, max_eq_left (by linarith)]
            linarith
          · rw [abs_of_nonpos h0, max_eq_left h0, max_eq_right (by linarith)]
            linarith
      calc ∫⁻ ζ, ‖(v ζ).toReal‖ₑ ∂circleMeasure
          ≤ ∫⁻ ζ, (fPos ζ + fNeg ζ) ∂circleMeasure := lintegral_mono hle
        _ = (∫⁻ ζ, fPos ζ ∂circleMeasure) + ∫⁻ ζ, fNeg ζ ∂circleMeasure :=
            lintegral_add_left hfPos_meas _
        _ < ⊤ := ENNReal.add_lt_top.mpr ⟨hIPos_lt_top, hINeg⟩
    · rintro ⟨hae_nb, hint⟩
      have hae_eq : fNeg =ᵐ[circleMeasure] fun ζ ↦ ENNReal.ofReal (max 0 (-(v ζ).toReal)) := by
        filter_upwards [hae_nb] with ζ hζ
        simp [fNeg, hζ]
      rw [lintegral_congr_ae hae_eq]
      calc ∫⁻ ζ, ENNReal.ofReal (max 0 (-(v ζ).toReal)) ∂circleMeasure
          ≤ ∫⁻ ζ, ‖(v ζ).toReal‖ₑ ∂circleMeasure := by
            refine lintegral_mono fun ζ ↦ ?_
            rw [Real.enorm_eq_ofReal_abs]
            exact ENNReal.ofReal_le_ofReal (max_le (abs_nonneg _) (neg_le_abs _))
        _ < ⊤ := hint.hasFiniteIntegral
  refine ⟨hne_bot_iff_INeg.trans h_iff, fun hne ↦ ?_⟩
  have hINeg : ∫⁻ ζ, fNeg ζ ∂circleMeasure < ⊤ := hne_bot_iff_INeg.mp hne
  obtain ⟨hae_nb, hint⟩ := h_iff.mp hINeg
  rw [hmean_eq]
  have hIPos_coe : (∫⁻ ζ, fPos ζ ∂circleMeasure : EReal) =
      ((∫⁻ ζ, fPos ζ ∂circleMeasure).toReal : EReal) :=
    (EReal.coe_ennreal_toReal hIPos_lt_top.ne).symm
  have hINeg_coe : (∫⁻ ζ, fNeg ζ ∂circleMeasure : EReal) =
      ((∫⁻ ζ, fNeg ζ ∂circleMeasure).toReal : EReal) :=
    (EReal.coe_ennreal_toReal hINeg.ne).symm
  rw [hIPos_coe, hINeg_coe, ← EReal.coe_sub]
  congr 1
  rw [integral_eq_lintegral_pos_part_sub_lintegral_neg_part hint]
  have hfPos_eq : fPos = fun ζ ↦ ENNReal.ofReal (v ζ).toReal := by
    funext ζ
    dsimp [fPos]
    rcases le_total 0 (v ζ).toReal with h0 | h0
    · rw [max_eq_right h0]
    · rw [max_eq_left h0, ENNReal.ofReal_zero, ENNReal.ofReal_eq_zero.mpr h0]
  have hfNeg_ae : fNeg =ᵐ[circleMeasure] fun ζ ↦ ENNReal.ofReal (-(v ζ).toReal) := by
    filter_upwards [hae_nb] with ζ hζ
    dsimp [fNeg]
    rw [ite_eq_right_iff.mpr fun h ↦ absurd h hζ]
    rcases le_total 0 (-(v ζ).toReal) with h0 | h0
    · rw [max_eq_right h0]
    · rw [max_eq_left h0, ENNReal.ofReal_zero, ENNReal.ofReal_eq_zero.mpr h0]
  rw [hfPos_eq, lintegral_congr_ae hfNeg_ae]

private theorem harmonic_subharmonicOnP {Ω : Set ℂ} (hΩ : IsOpen Ω) {h : ℂ → ℝ}
    (hh : RudinRCA.Chapter11.HarmonicOn h Ω) :
    SubharmonicOnP Ω (fun z ↦ (h z : EReal)) := by
  have h_top : ∀ z ∈ Ω, (h z : EReal) < ⊤ := fun z _ ↦ EReal.coe_lt_top (h z)
  have h_usc : UpperSemicontinuousOn (fun z ↦ (h z : EReal)) Ω :=
    (continuous_coe_real_ereal.comp_continuousOn hh.continuousOn).upperSemicontinuousOn
  refine ⟨hΩ, h_top, h_usc, fun a r hr hsub ↦ ?_⟩
  have hcont_circ : Continuous (fun ζ : FourierCircle ↦ h (a + (r : ℂ) * circlePoint ζ)) :=
    hh.continuousOn.comp_continuous
      (continuous_const.add (continuous_const.mul continuous_circlePoint)) fun ζ ↦
      hsub (affine_circlePoint_mem_closedBall a hr.le ζ)
  have hint : Integrable (fun ζ : FourierCircle ↦ h (a + (r : ℂ) * circlePoint ζ)) circleMeasure :=
    hcont_circ.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hchar := erealCircleMeanP_ne_bot_iff hΩ h_top h_usc hr.le hsub
  have hne : erealCircleMeanP (fun z ↦ (h z : EReal)) a r ≠ ⊥ := by
    refine hchar.1.mpr ⟨Eventually.of_forall fun _ ↦ EReal.coe_ne_bot _, ?_⟩
    simpa only [EReal.toReal_coe] using hint
  refine ⟨hne, ?_⟩
  rw [hchar.2 hne]
  simp only [EReal.toReal_coe]
  rw [integral_circleMeasure_eq_circleAverage,
    (RudinRCA.Chapter11.theorem11_12_real hΩ hh).1 hr hsub]

private def extendMonotoneToBotP (φ : ℝ → ℝ) : EReal → EReal
  | ⊥ => ⨅ x : ℝ, (φ x : EReal)
  | ⊤ => ⊤
  | (x : ℝ) => (φ x : EReal)

@[simp]
private theorem extendMonotoneToBotP_bot (φ : ℝ → ℝ) :
    extendMonotoneToBotP φ ⊥ = ⨅ x : ℝ, (φ x : EReal) := rfl

@[simp]
private theorem extendMonotoneToBotP_coe (φ : ℝ → ℝ) (x : ℝ) :
    extendMonotoneToBotP φ (x : EReal) = (φ x : EReal) := rfl

private theorem monotone_extendMonotoneToBotP {φ : ℝ → ℝ} (hφ : Monotone φ) :
    Monotone (extendMonotoneToBotP φ) := by
  intro a b hab
  induction a <;> induction b
  · exact le_rfl
  · exact iInf_le (fun x : ℝ ↦ (φ x : EReal)) _
  · exact le_top
  · exact absurd hab (not_le_of_gt (EReal.bot_lt_coe _))
  · exact EReal.coe_le_coe_iff.mpr (hφ (EReal.coe_le_coe_iff.mp hab))
  · exact le_top
  · exact absurd hab (not_le_of_gt bot_lt_top)
  · exact absurd hab (not_le_of_gt (EReal.coe_lt_top _))
  · exact le_rfl

private theorem monotone_convex_lower_bound {φ : ℝ → ℝ}
    (hφ_mono : Monotone φ) (hφ_conv : ConvexOn ℝ Set.univ φ) (x : ℝ) :
    φ 0 - (φ 1 - φ 0) * |x| ≤ φ x := by
  have hc_nonneg : 0 ≤ φ 1 - φ 0 := sub_nonneg.mpr (hφ_mono zero_le_one)
  rcases le_or_gt 0 x with hx | hx
  · have h1 : φ 0 ≤ φ x := hφ_mono hx
    have h2 : 0 ≤ (φ 1 - φ 0) * |x| := mul_nonneg hc_nonneg (abs_nonneg x)
    linarith
  · have h1mx : 0 < 1 - x := by linarith
    let a : ℝ := 1 / (1 - x)
    let b : ℝ := (-x) / (1 - x)
    have ha : 0 ≤ a := by positivity
    have hb : 0 ≤ b := div_nonneg (by linarith) h1mx.le
    have hab : a + b = 1 := by
      dsimp [a, b]
      rw [← add_div, div_eq_one_iff_eq h1mx.ne']
      ring
    have hcomb : a • x + b • (1 : ℝ) = 0 := by
      dsimp [a, b]
      field_simp [h1mx.ne']
      ring
    have hconv := hφ_conv.2 (mem_univ x) (mem_univ 1) ha hb hab
    rw [hcomb] at hconv
    change φ 0 ≤ a * φ x + b * φ 1 at hconv
    have hmul : φ 0 * (1 - x) ≤ φ x - x * φ 1 := by
      have := mul_le_mul_of_nonneg_right hconv h1mx.le
      dsimp [a, b] at this
      rw [add_mul, mul_right_comm (1 / (1 - x)) (φ x) (1 - x),
        div_mul_cancel₀ 1 h1mx.ne', one_mul,
        mul_right_comm (-x / (1 - x)) (φ 1) (1 - x),
        div_mul_cancel₀ (-x) h1mx.ne'] at this
      linarith
    rw [abs_of_neg hx]
    linarith

private theorem convex_comp_subharmonicOnP {Ω : Set ℂ} {u : ℂ → EReal} {φ : ℝ → ℝ}
    (hu : SubharmonicOnP Ω u) (hφ_mono : Monotone φ) (hφ_conv : ConvexOn ℝ Set.univ φ) :
    SubharmonicOnP Ω (fun z ↦ extendMonotoneToBotP φ (u z)) := by
  have hφ_cont : Continuous φ := continuousOn_univ.mp (hφ_conv.continuousOn isOpen_univ)
  have hext_mono : Monotone (extendMonotoneToBotP φ) := monotone_extendMonotoneToBotP hφ_mono
  have hv_top : ∀ z ∈ Ω, extendMonotoneToBotP φ (u z) < ⊤ := by
    intro z hz
    have hy := hu.lt_top z hz
    rcases eq_or_ne (u z) ⊥ with hb | hnb
    · rw [hb]; exact (iInf_le (fun x : ℝ ↦ (φ x : EReal)) 0).trans_lt (EReal.coe_lt_top (φ 0))
    · lift u z to ℝ using ⟨hy.ne, hnb⟩ with x
      exact EReal.coe_lt_top _
  have hv_usc : UpperSemicontinuousOn (fun z ↦ extendMonotoneToBotP φ (u z)) Ω := by
    intro z hz y hy
    dsimp only at hy
    have huz_top : u z < ⊤ := hu.lt_top z hz
    rcases eq_or_ne (u z) ⊥ with hbot | hnb
    · rw [hbot] at hy
      have hlim : Tendsto (fun x : ℝ ↦ (φ x : EReal)) atBot (𝓝 (extendMonotoneToBotP φ ⊥)) :=
        tendsto_atBot_iInf fun a b hab ↦ EReal.coe_le_coe_iff.mpr (hφ_mono hab)
      have hev := hlim.eventually (Iio_mem_nhds hy)
      rw [Filter.eventually_atBot] at hev
      obtain ⟨b, hb⟩ := hev
      have hlt_b : u z < (b : EReal) := by rw [hbot]; exact EReal.bot_lt_coe b
      filter_upwards [hu.upperSemicontinuousOn z hz (b : EReal) hlt_b] with w hw
      exact (hext_mono hw.le).trans_lt (hb b le_rfl)
    · lift u z to ℝ using ⟨huz_top.ne, hnb⟩ with x hx
      change (φ x : EReal) < y at hy
      have hcont_coe : Continuous (fun t : ℝ ↦ (φ t : EReal)) :=
        continuous_coe_real_ereal.comp hφ_cont
      obtain ⟨δ, hδ_pos, hδ⟩ :=
        Metric.mem_nhds_iff.mp (hcont_coe.continuousAt.eventually (Iio_mem_nhds hy))
      let x' : ℝ := x + δ / 2
      have hx'_mem : x' ∈ Metric.ball x δ := by
        rw [Metric.mem_ball, Real.dist_eq]
        dsimp [x']
        rw [add_sub_cancel_left, abs_of_pos (half_pos hδ_pos)]
        exact half_lt_self hδ_pos
      have hφx'_lt : (φ x' : EReal) < y := hδ hx'_mem
      have huz_lt : u z < (x' : EReal) := by
        rw [← hx, EReal.coe_lt_coe_iff]
        dsimp [x']
        linarith
      filter_upwards [hu.upperSemicontinuousOn z hz (x' : EReal) huz_lt] with w hw
      exact (hext_mono hw.le).trans_lt hφx'_lt
  refine ⟨hu.isOpen, hv_top, hv_usc, fun a r hr hsub ↦ ?_⟩
  obtain ⟨hmean_u_nb, hua_le⟩ := hu.submean a r hr hsub
  have hchar_u := erealCircleMeanP_ne_bot_iff hu.isOpen hu.lt_top hu.upperSemicontinuousOn
    hr.le hsub
  obtain ⟨hae_u_nb, hint_u⟩ := hchar_u.1.mp hmean_u_nb
  have hmean_u_eq := hchar_u.2 hmean_u_nb
  let U_real : FourierCircle → ℝ := fun ζ ↦ (u (a + (r : ℂ) * circlePoint ζ)).toReal
  obtain ⟨M, _, hM_bound⟩ :=
    exists_real_upper_bound_of_usc hu.lt_top hu.upperSemicontinuousOn
      (isCompact_closedBall a r) hsub
  have hU_le : ∀ ζ : FourierCircle, U_real ζ ≤ max 0 M := by
    intro ζ
    have hw := affine_circlePoint_mem_closedBall a hr.le ζ
    rcases eq_or_ne (u (a + (r : ℂ) * circlePoint ζ)) ⊥ with hb | hb
    · dsimp [U_real]; rw [hb, EReal.toReal_bot]; exact le_max_left 0 M
    · exact (EReal.toReal_le_toReal (hM_bound _ hw) hb (EReal.coe_ne_top M)).trans
        (le_max_right 0 M)
  have hint_φU : Integrable (fun ζ ↦ φ (U_real ζ)) circleMeasure := by
    let c : ℝ := φ 1 - φ 0
    have hdom : Integrable
        (fun ζ ↦ |φ (max 0 M)| + |φ 0| + |c| * ‖U_real ζ‖) circleMeasure :=
      ((integrable_const _).add (integrable_const _)).add (hint_u.norm.const_mul |c|)
    refine hdom.mono' (hφ_cont.comp_aestronglyMeasurable hint_u.aestronglyMeasurable)
      (Eventually.of_forall fun ζ ↦ ?_)
    have hup : φ (U_real ζ) ≤ φ (max 0 M) := hφ_mono (hU_le ζ)
    have hlo : φ 0 - c * |U_real ζ| ≤ φ (U_real ζ) :=
      monotone_convex_lower_bound hφ_mono hφ_conv (U_real ζ)
    have hc_pos : 0 ≤ c := sub_nonneg.mpr (hφ_mono zero_le_one)
    rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg hc_pos, abs_le]
    constructor
    · have h1 : -|φ 0| ≤ φ 0 := neg_abs_le (φ 0)
      have h2 : 0 ≤ |φ (max 0 M)| := abs_nonneg _
      linarith
    · have h1 : φ (max 0 M) ≤ |φ (max 0 M)| := le_abs_self _
      have h2 : 0 ≤ |φ 0| + c * |U_real ζ| :=
        add_nonneg (abs_nonneg _) (mul_nonneg hc_pos (abs_nonneg _))
      linarith
  have hae_v_eq : ∀ᵐ ζ ∂circleMeasure,
      extendMonotoneToBotP φ (u (a + (r : ℂ) * circlePoint ζ)) = (φ (U_real ζ) : EReal) := by
    filter_upwards [hae_u_nb] with ζ hζ
    have hlt := hu.lt_top _ (hsub (affine_circlePoint_mem_closedBall a hr.le ζ))
    have hcoe : u (a + (r : ℂ) * circlePoint ζ) = (U_real ζ : EReal) :=
      (EReal.coe_toReal hlt.ne hζ).symm
    rw [hcoe]; rfl
  have hchar_v := erealCircleMeanP_ne_bot_iff hu.isOpen hv_top hv_usc hr.le hsub
  have hmean_v_nb : erealCircleMeanP (fun z ↦ extendMonotoneToBotP φ (u z)) a r ≠ ⊥ := by
    refine hchar_v.1.mpr ⟨?_, ?_⟩
    · filter_upwards [hae_v_eq] with ζ hζ
      rw [hζ]; exact EReal.coe_ne_bot _
    · refine hint_φU.congr ?_
      filter_upwards [hae_v_eq] with ζ hζ
      rw [hζ, EReal.toReal_coe]
  refine ⟨hmean_v_nb, ?_⟩
  rw [hchar_v.2 hmean_v_nb]
  have hint_eq : ∫ ζ, (extendMonotoneToBotP φ (u (a + (r : ℂ) * circlePoint ζ))).toReal ∂circleMeasure =
      ∫ ζ, φ (U_real ζ) ∂circleMeasure := by
    refine integral_congr_ae ?_
    filter_upwards [hae_v_eq] with ζ hζ
    rw [hζ, EReal.toReal_coe]
  rw [hint_eq]
  have hjensen : φ (∫ ζ, U_real ζ ∂circleMeasure) ≤ ∫ ζ, φ (U_real ζ) ∂circleMeasure :=
    hφ_conv.map_integral_le hφ_cont.continuousOn isClosed_univ
      (Eventually.of_forall fun _ ↦ mem_univ _) hint_u hint_φU
  calc extendMonotoneToBotP φ (u a)
      ≤ extendMonotoneToBotP φ (erealCircleMeanP u a r) := hext_mono hua_le
    _ = extendMonotoneToBotP φ ((∫ ζ, U_real ζ ∂circleMeasure : ℝ) : EReal) := by rw [hmean_u_eq]
    _ = (φ (∫ ζ, U_real ζ ∂circleMeasure) : EReal) := rfl
    _ ≤ ((∫ ζ, φ (U_real ζ) ∂circleMeasure : ℝ) : EReal) := EReal.coe_le_coe_iff.mpr hjensen

private def eLogNormP (w : ℂ) : EReal :=
  if w = 0 then ⊥ else (Real.log ‖w‖ : EReal)

private theorem eLogNormP_of_ne_zero {w : ℂ} (hw : w ≠ 0) :
    eLogNormP w = (Real.log ‖w‖ : EReal) := by
  simp [eLogNormP, hw]

private theorem toReal_eLogNormP (w : ℂ) : (eLogNormP w).toReal = Real.log ‖w‖ := by
  by_cases hw : w = 0
  · simp [eLogNormP, hw]
  · simp [eLogNormP_of_ne_zero hw]

private theorem upperSemicontinuous_eLogNormP : UpperSemicontinuous eLogNormP := by
  intro w₀ y hy
  by_cases hw₀ : w₀ = 0
  · subst hw₀
    have hy_nb : y ≠ ⊥ := bot_lt_iff_ne_bot.mp (by simpa [eLogNormP] using hy)
    obtain ⟨b, hb⟩ : ∃ b : ℝ, (b : EReal) < y := by
      rcases eq_top_or_lt_top y with rfl | hyt
      · exact ⟨0, EReal.coe_lt_top 0⟩
      · lift y to ℝ using ⟨hyt.ne, hy_nb⟩
        exact ⟨y - 1, EReal.coe_lt_coe_iff.mpr (by linarith)⟩
    filter_upwards [Metric.ball_mem_nhds (0 : ℂ) (Real.exp_pos b)] with w hw
    have hnorm : ‖w‖ < Real.exp b := by simpa [Metric.mem_ball] using hw
    by_cases hw0 : w = 0
    · simp [eLogNormP, hw0, bot_lt_iff_ne_bot, hy_nb]
    · rw [eLogNormP_of_ne_zero hw0]
      refine lt_trans ?_ hb
      rw [EReal.coe_lt_coe_iff]
      exact (Real.log_lt_iff_lt_exp (norm_pos_iff.mpr hw0)).mpr hnorm
  · rw [eLogNormP_of_ne_zero hw₀] at hy
    have hcont : ContinuousAt (fun w : ℂ ↦ (Real.log ‖w‖ : EReal)) w₀ :=
      continuous_coe_real_ereal.continuousAt.comp
        ((Real.continuousAt_log (norm_ne_zero_iff.mpr hw₀)).comp continuous_norm.continuousAt)
    filter_upwards [hcont.eventually (Iio_mem_nhds hy),
      isOpen_compl_singleton.mem_nhds hw₀] with w hw hne
    rwa [eLogNormP_of_ne_zero hne]

private theorem subharmonicOnP_eLogNorm {Ω : Set ℂ} {f : ℂ → ℂ}
    (hΩ : IsRegion Ω) (hf : HolomorphicOn f Ω) (hne : ∃ z₀ ∈ Ω, f z₀ ≠ 0) :
    SubharmonicOnP Ω (fun z ↦ eLogNormP (f z)) := by
  have hf_cont : ContinuousOn f Ω := RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf
  have h_top : ∀ z ∈ Ω, eLogNormP (f z) < ⊤ := by
    intro z _; by_cases h0 : f z = 0 <;> simp [eLogNormP, h0, EReal.coe_lt_top]
  have h_usc : UpperSemicontinuousOn (fun z ↦ eLogNormP (f z)) Ω :=
    fun z hz y hy ↦ (hf_cont z hz).eventually (upperSemicontinuous_eLogNormP (f z) y hy)
  refine ⟨hΩ.1, h_top, h_usc, fun a r hr hsub ↦ ?_⟩
  have hne_eqOn : ¬ Set.EqOn f 0 Ω := by
    rcases hne with ⟨z₀, hz₀, hfz₀⟩
    exact fun h0 ↦ hfz₀ (h0 hz₀)
  have hfin_sph : (RudinRCA.Chapter10.zeroSet f Ω ∩ Metric.sphere a r).Finite :=
    RudinRCA.Chapter10.zeroSet_inter_compact_finite hΩ hf hne_eqOn
      (isCompact_sphere a r) (Metric.sphere_subset_closedBall.trans hsub)
  have hfin_circ : {ζ : FourierCircle | f (a + (r : ℂ) * circlePoint ζ) = 0}.Finite := by
    have hinj : Function.Injective (fun ζ : FourierCircle ↦ a + (r : ℂ) * circlePoint ζ) := by
      intro ζ₁ ζ₂ h
      have hr_ne : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr.ne'
      exact circlePoint_injective (mul_left_cancel₀ hr_ne (add_left_cancel h))
    refine (hfin_sph.preimage hinj.injOn).subset fun ζ hζ ↦ ?_
    have hmem_sph := affine_circlePoint_mem_sphere a hr.le ζ
    exact ⟨⟨hsub (Metric.sphere_subset_closedBall hmem_sph), hζ⟩, hmem_sph⟩
  have hae_nz : ∀ᵐ ζ ∂circleMeasure, f (a + (r : ℂ) * circlePoint ζ) ≠ 0 := by
    rw [ae_iff]
    simpa only [not_ne_iff] using hfin_circ.measure_zero circleMeasure
  have h_ana : AnalyticOnNhd ℂ f Ω :=
    ((RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn hΩ.1).mp hf).analyticOnNhd hΩ.1
  have h_ana_cb : AnalyticOnNhd ℂ f (Metric.closedBall a |r|) := by
    rw [abs_of_pos hr]; exact h_ana.mono hsub
  have hci : CircleIntegrable (fun z ↦ Real.log ‖f z‖) a r :=
    (h_ana_cb.mono Metric.sphere_subset_closedBall).meromorphicOn.circleIntegrable_log_norm
  have hint : Integrable (fun ζ ↦ Real.log ‖f (a + (r : ℂ) * circlePoint ζ)‖) circleMeasure :=
    (integrable_affine_circlePoint_iff_circleIntegrable (fun z ↦ Real.log ‖f z‖) a r).mpr hci
  have hchar := erealCircleMeanP_ne_bot_iff hΩ.1 h_top h_usc hr.le hsub
  have hmean_nb : erealCircleMeanP (fun z ↦ eLogNormP (f z)) a r ≠ ⊥ := by
    refine hchar.1.mpr ⟨?_, ?_⟩
    · filter_upwards [hae_nz] with ζ hζ
      rw [eLogNormP_of_ne_zero hζ]; exact EReal.coe_ne_bot _
    · simpa only [toReal_eLogNormP] using hint
  refine ⟨hmean_nb, ?_⟩
  rw [hchar.2 hmean_nb]
  simp only [toReal_eLogNormP]
  rw [integral_circleMeasure_eq_circleAverage (fun z ↦ Real.log ‖f z‖) a r]
  by_cases hfa : f a = 0
  · simp [eLogNormP, hfa]
  · rw [eLogNormP_of_ne_zero hfa, EReal.coe_le_coe_iff,
      h_ana_cb.circleAverage_log_norm hr.ne' hfa]
    suffices hsum_nonneg :
        0 ≤ ∑ᶠ u, MeromorphicOn.divisor f (Metric.closedBall a |r|) u * Real.log (r * ‖a - u‖⁻¹) by
      linarith
    refine finsum_nonneg fun u ↦ ?_
    by_cases hu_cb : u ∈ Metric.closedBall a |r|
    · have hdiv_nonneg : 0 ≤ (MeromorphicOn.divisor f (Metric.closedBall a |r|) u : ℝ) := by
        rw [MeromorphicOn.AnalyticOnNhd.divisor_apply h_ana_cb hu_cb]
        have h0 : (0 : ℤ) ≤ ((analyticOrderAt f u).map (↑)).untop₀ := by
          cases analyticOrderAt f u using ENat.recTopCoe <;> simp
        exact_mod_cast h0
      by_cases hua : u = a
      · subst hua
        have hdiv0 : MeromorphicOn.divisor f (Metric.closedBall u |r|) u = 0 := by
          rw [MeromorphicOn.AnalyticOnNhd.divisor_apply h_ana_cb hu_cb,
            (h_ana_cb u hu_cb).analyticOrderAt_eq_zero.mpr hfa]
          simp
        simp [hdiv0]
      · have hdist_pos : 0 < ‖a - u‖ := norm_pos_iff.mpr (sub_ne_zero.mpr (Ne.symm hua))
        have hdist_le : ‖a - u‖ ≤ r := by
          rw [abs_of_pos hr, Metric.mem_closedBall, dist_eq_norm'] at hu_cb
          exact hu_cb
        have hge1 : 1 ≤ r * ‖a - u‖⁻¹ := by
          rw [← div_eq_mul_inv, one_le_div hdist_pos]; exact hdist_le
        exact mul_nonneg hdiv_nonneg (Real.log_nonneg hge1)
    · simp [hu_cb]

private theorem subharmonicOnP_posLog_norm_region {Ω : Set ℂ} {f : ℂ → ℂ}
    (hΩ : IsRegion Ω) (hf : HolomorphicOn f Ω) :
    SubharmonicOnP Ω (fun z ↦ (Real.posLog ‖f z‖ : EReal)) := by
  by_cases hne : ∃ z₀ ∈ Ω, f z₀ ≠ 0
  · have hsub_log := subharmonicOnP_eLogNorm hΩ hf hne
    have hmono : Monotone (fun t : ℝ ↦ max 0 t) := fun _ _ hab ↦ max_le_max_left 0 hab
    have hconv : ConvexOn ℝ Set.univ (fun t : ℝ ↦ max 0 t) :=
      (convexOn_const 0 convex_univ).sup (convexOn_id convex_univ)
    refine (convex_comp_subharmonicOnP hsub_log hmono hconv).congr fun z _ ↦ ?_
    by_cases hfz : f z = 0
    · simp only [hfz, eLogNormP, ↓reduceIte, extendMonotoneToBotP_bot, norm_zero, Real.posLog_zero]
      refine le_antisymm ?_ (le_iInf fun x ↦ EReal.coe_nonneg.mpr (le_max_left 0 x))
      exact (iInf_le (fun x : ℝ ↦ ((max 0 x : ℝ) : EReal)) 0).trans (by simp)
    · simp [eLogNormP_of_ne_zero hfz, Real.posLog_def]
  · push Not at hne
    have h0 : SubharmonicOnP Ω (fun _ ↦ ((0 : ℝ) : EReal)) :=
      harmonic_subharmonicOnP hΩ.1 (RudinRCA.Chapter11.node11_4_holomorphic_harmonic hΩ.1
        (differentiableOn_const (0 : ℂ)) |>.comp_clm hΩ.1 Complex.reCLM)
    exact h0.congr fun z hz ↦ by simp [hne z hz]

private theorem subharmonicOnP_rpow_norm_region {Ω : Set ℂ} {f : ℂ → ℂ}
    (hΩ : IsRegion Ω) (hf : HolomorphicOn f Ω) {p : ℝ} (hp : 0 < p) :
    SubharmonicOnP Ω (fun z ↦ ((‖f z‖ ^ p : ℝ) : EReal)) := by
  by_cases hne : ∃ z₀ ∈ Ω, f z₀ ≠ 0
  · have hsub_log := subharmonicOnP_eLogNorm hΩ hf hne
    have hmono : Monotone (fun t : ℝ ↦ Real.exp (p * t)) :=
      fun _ _ hab ↦ Real.exp_le_exp.mpr (mul_le_mul_of_nonneg_left hab hp.le)
    have hconv : ConvexOn ℝ Set.univ (fun t : ℝ ↦ Real.exp (p * t)) := by
      simpa [Function.comp_def] using
        convexOn_exp.comp_linearMap (LinearMap.mulLeft ℝ p)
    refine (convex_comp_subharmonicOnP hsub_log hmono hconv).congr fun z _ ↦ ?_
    by_cases hfz : f z = 0
    · simp only [hfz, eLogNormP, ↓reduceIte, extendMonotoneToBotP_bot, norm_zero, Real.zero_rpow hp.ne']
      refine le_antisymm ?_ (le_iInf fun x ↦ EReal.coe_nonneg.mpr (Real.exp_pos _).le)
      have hlim : Tendsto (fun x : ℝ ↦ (Real.exp (p * x) : EReal)) atBot
          (𝓝 ((0 : ℝ) : EReal)) := by
        rw [EReal.tendsto_coe]
        exact Real.tendsto_exp_atBot.comp (tendsto_id.const_mul_atBot hp)
      exact (tendsto_nhds_unique (tendsto_atBot_iInf fun a b hab ↦
        EReal.coe_le_coe_iff.mpr (hmono hab)) hlim).le
    · simp only [eLogNormP_of_ne_zero hfz, extendMonotoneToBotP_coe]
      rw [Real.rpow_def_of_pos (norm_pos_iff.mpr hfz) p, mul_comm]
  · push Not at hne
    have h0 : SubharmonicOnP Ω (fun _ ↦ ((0 : ℝ) : EReal)) :=
      harmonic_subharmonicOnP hΩ.1 (RudinRCA.Chapter11.node11_4_holomorphic_harmonic hΩ.1
        (differentiableOn_const (0 : ℂ)) |>.comp_clm hΩ.1 Complex.reCLM)
    exact h0.congr fun z hz ↦ by simp [hne z hz, Real.zero_rpow hp.ne']

private theorem integral_circleMeasure_lt_of_continuous_le_of_exists_lt
    {g : FourierCircle → ℝ} {m : ℝ} (hg_cont : Continuous g)
    (h_le : ∀ ζ : FourierCircle, g ζ ≤ m) (hex : ∃ ζ₀ : FourierCircle, g ζ₀ < m) :
    ∫ ζ, g ζ ∂circleMeasure < m := by
  obtain ⟨ζ₀, hlt⟩ := hex
  let d : FourierCircle → ℝ := fun ζ ↦ m - g ζ
  have hd_cont : Continuous d := continuous_const.sub hg_cont
  have hd_nonneg : ∀ ζ : FourierCircle, 0 ≤ d ζ := fun ζ ↦ sub_nonneg.mpr (h_le ζ)
  have hd_pos : 0 < d ζ₀ := sub_pos.mpr hlt
  let U : Set FourierCircle := {ζ : FourierCircle | d ζ₀ / 2 < d ζ}
  have hU_open : IsOpen U := isOpen_lt continuous_const hd_cont
  have hU_pos : circleMeasure U ≠ 0 := hU_open.measure_ne_zero circleMeasure ⟨ζ₀, half_lt_self hd_pos⟩
  have hU_lt_top : circleMeasure U < ⊤ := (measure_mono (subset_univ U)).trans_lt (by simp)
  have hU_real_pos : 0 < (circleMeasure U).toReal := ENNReal.toReal_pos hU_pos hU_lt_top.ne
  have hind_int : Integrable (U.indicator fun _ : FourierCircle ↦ d ζ₀ / 2) circleMeasure :=
    (integrable_const (d ζ₀ / 2)).indicator hU_open.measurableSet
  have hd_int : Integrable d circleMeasure :=
    hd_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hg_int : Integrable g circleMeasure :=
    hg_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hint_pos : 0 < ∫ ζ, d ζ ∂circleMeasure := by
    calc (0 : ℝ)
        < (circleMeasure U).toReal * (d ζ₀ / 2) := mul_pos hU_real_pos (half_pos hd_pos)
      _ = ∫ _ in U, (d ζ₀ / 2) ∂circleMeasure := by rw [setIntegral_const, Measure.real, smul_eq_mul]
      _ = ∫ ζ, U.indicator (fun _ : FourierCircle ↦ d ζ₀ / 2) ζ ∂circleMeasure :=
          (integral_indicator hU_open.measurableSet).symm
      _ ≤ ∫ ζ, d ζ ∂circleMeasure := by
          refine integral_mono hind_int hd_int fun ζ ↦ ?_
          by_cases hζ : ζ ∈ U
          · rw [indicator_of_mem hζ]; exact (hζ : d ζ₀ / 2 < d ζ).le
          · rw [indicator_of_notMem hζ]; exact hd_nonneg ζ
  have hint_sub : ∫ ζ, d ζ ∂circleMeasure = m - ∫ ζ, g ζ ∂circleMeasure := by
    dsimp [d]
    rw [integral_sub (integrable_const m) hg_int, integral_const, Measure.real,
      measure_univ, ENNReal.toReal_one, one_smul]
  linarith

private theorem harmonic_majorant_on_compact {Ω K : Set ℂ} {u h : ℂ → ℝ}
    (hu_cont : ContinuousOn u Ω)
    (hu_sub : SubharmonicOnP Ω (fun z ↦ (u z : EReal)))
    (hK : IsCompact K) (hKΩ : K ⊆ Ω)
    (hh_cont : ContinuousOn h K)
    (hh_harm : RudinRCA.Chapter11.HarmonicOn h (interior K))
    (h_bdry : ∀ z ∈ frontier K, u z ≤ h z) :
    ∀ z ∈ K, u z ≤ h z := by
  rcases K.eq_empty_or_nonempty with rfl | hKne
  · exact fun _ hz ↦ False.elim hz
  let v : ℂ → ℝ := fun z ↦ u z - h z
  have hv_cont : ContinuousOn v K := (hu_cont.mono hKΩ).sub hh_cont
  obtain ⟨z₁, hz₁K, hz₁max⟩ := hK.exists_isMaxOn hKne hv_cont
  let m : ℝ := v z₁
  have hv_le_m : ∀ z ∈ K, v z ≤ m := fun z hz ↦ hz₁max hz
  by_cases hm_nonpos : m ≤ 0
  · intro z hz
    have : u z - h z ≤ 0 := (hv_le_m z hz).trans hm_nonpos
    linarith
  · exfalso
    let E : Set ℂ := K ∩ v ⁻¹' Set.Ici m
    have hE_compact : IsCompact E :=
      hv_cont.upperSemicontinuousOn.isCompact_inter_preimage_Ici hK m
    have hz₁E : z₁ ∈ E := ⟨hz₁K, show m ≤ v z₁ from le_rfl⟩
    obtain ⟨z₀, hz₀E, hz₀_norm_max⟩ :=
      hE_compact.exists_isMaxOn ⟨z₁, hz₁E⟩ continuous_norm.continuousOn
    have hz₀K : z₀ ∈ K := hz₀E.1
    have hv_z₀ : v z₀ = m := le_antisymm (hv_le_m z₀ hz₀K) hz₀E.2
    have hz₀_int : z₀ ∈ interior K := by
      by_contra hz₀_nint
      have hz₀_fr : z₀ ∈ frontier K := by
        rw [frontier, hK.isClosed.closure_eq]
        exact ⟨hz₀K, hz₀_nint⟩
      have hle := h_bdry z₀ hz₀_fr
      dsimp [v] at hv_z₀
      linarith
    obtain ⟨R, hR_pos, hball_int⟩ := Metric.isOpen_iff.mp isOpen_interior z₀ hz₀_int
    let r : ℝ := R / 2
    have hr_pos : 0 < r := half_pos hR_pos
    have hcb_int : Metric.closedBall z₀ r ⊆ interior K :=
      (Metric.closedBall_subset_ball (half_lt_self hR_pos)).trans hball_int
    have hcb_K : Metric.closedBall z₀ r ⊆ K := hcb_int.trans interior_subset
    have hcb_Ω : Metric.closedBall z₀ r ⊆ Ω := hcb_K.trans hKΩ
    obtain ⟨w_strict, hw_sph, hw_norm_gt⟩ :
        ∃ w ∈ Metric.sphere z₀ r, ‖z₀‖ < ‖w‖ := by
      by_cases hz₀0 : z₀ = 0
      · subst hz₀0
        exact ⟨(r : ℂ), by simp [abs_of_pos hr_pos], by simp [abs_of_pos hr_pos, hr_pos]⟩
      · have hnorm_pos : 0 < ‖z₀‖ := norm_pos_iff.mpr hz₀0
        let w : ℂ := ((1 + r / ‖z₀‖ : ℝ) : ℂ) * z₀
        refine ⟨w, ?_, ?_⟩
        · rw [Metric.mem_sphere, dist_eq_norm]
          have hsub_eq : w - z₀ = ((r / ‖z₀‖ : ℝ) : ℂ) * z₀ := by dsimp [w]; push_cast; ring
          rw [hsub_eq, norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos (div_pos hr_pos hnorm_pos), div_mul_cancel₀ r hnorm_pos.ne']
        · dsimp [w]
          rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_pos (by positivity : 0 < 1 + r / ‖z₀‖), add_mul, one_mul,
            div_mul_cancel₀ r hnorm_pos.ne']
          linarith
    have hw_K : w_strict ∈ K := hcb_K (Metric.sphere_subset_closedBall hw_sph)
    have hw_lt_m : v w_strict < m := by
      by_contra hge
      have hle_norm : ‖w_strict‖ ≤ ‖z₀‖ := hz₀_norm_max ⟨hw_K, not_lt.mp hge⟩
      linarith
    have hw_unit : (w_strict - z₀) / (r : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
      rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hr_pos, div_eq_one_iff_eq hr_pos.ne']
      simpa [Metric.mem_sphere, dist_eq_norm] using hw_sph
    obtain ⟨ζ₀, hζ₀⟩ := circlePoint_surjective_sphere hw_unit
    have hζ₀_eq : z₀ + (r : ℂ) * circlePoint ζ₀ = w_strict := by
      rw [hζ₀]
      have hr_ne : (r : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr_pos.ne'
      field_simp [hr_ne]; ring
    have hv_circ_cont : Continuous (fun ζ : FourierCircle ↦ v (z₀ + (r : ℂ) * circlePoint ζ)) :=
      hv_cont.comp_continuous
        (continuous_const.add (continuous_const.mul continuous_circlePoint))
        fun ζ ↦ hcb_K (affine_circlePoint_mem_closedBall z₀ hr_pos.le ζ)
    have hv_mean_lt : ∫ ζ, v (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure < m :=
      integral_circleMeasure_lt_of_continuous_le_of_exists_lt hv_circ_cont
        (fun ζ ↦ hv_le_m _ (hcb_K (affine_circlePoint_mem_closedBall z₀ hr_pos.le ζ)))
        ⟨ζ₀, by rwa [hζ₀_eq]⟩
    have hu_circ_cont : Continuous (fun ζ : FourierCircle ↦ u (z₀ + (r : ℂ) * circlePoint ζ)) :=
      hu_cont.comp_continuous
        (continuous_const.add (continuous_const.mul continuous_circlePoint))
        fun ζ ↦ hcb_Ω (affine_circlePoint_mem_closedBall z₀ hr_pos.le ζ)
    have hh_circ_cont : Continuous (fun ζ : FourierCircle ↦ h (z₀ + (r : ℂ) * circlePoint ζ)) :=
      hh_cont.comp_continuous
        (continuous_const.add (continuous_const.mul continuous_circlePoint))
        fun ζ ↦ hcb_K (affine_circlePoint_mem_closedBall z₀ hr_pos.le ζ)
    obtain ⟨hmean_nb, hu_le_mean⟩ := hu_sub.submean z₀ r hr_pos hcb_Ω
    have hchar := (erealCircleMeanP_ne_bot_iff hu_sub.isOpen hu_sub.lt_top
      hu_sub.upperSemicontinuousOn hr_pos.le hcb_Ω).2 hmean_nb
    rw [hchar] at hu_le_mean
    simp only [EReal.toReal_coe, EReal.coe_le_coe_iff] at hu_le_mean
    have hh_eq_mean : h z₀ = ∫ ζ, h (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure := by
      rw [integral_circleMeasure_eq_circleAverage,
        (RudinRCA.Chapter11.theorem11_12_real isOpen_interior hh_harm).1 hr_pos hcb_int]
    have hv_int_eq : ∫ ζ, v (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure =
        (∫ ζ, u (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure) -
          ∫ ζ, h (z₀ + (r : ℂ) * circlePoint ζ) ∂circleMeasure :=
      integral_sub
        (hu_circ_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
        (hh_circ_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
    dsimp [v] at hv_z₀
    linarith

private theorem isRegion_unitDisc : IsRegion (Metric.ball (0 : ℂ) 1) :=
  ⟨Metric.isOpen_ball,
    ⟨⟨0, Metric.mem_ball_self zero_lt_one⟩, (convex_ball (0 : ℂ) 1).isPreconnected⟩⟩

private theorem circleMean_mono_unitDisc {u : ℂ → ℝ}
    (hu_cont : ContinuousOn u (Metric.ball (0 : ℂ) 1))
    (hu_sub : SubharmonicOnP (Metric.ball (0 : ℂ) 1) (fun z ↦ (u z : EReal)))
    {r₁ r₂ : ℝ} (hr₁ : 0 ≤ r₁) (hr₁₂ : r₁ ≤ r₂) (hr₂ : r₂ < 1) :
    ∫ ζ, u ((r₁ : ℂ) * circlePoint ζ) ∂circleMeasure ≤
      ∫ ζ, u ((r₂ : ℂ) * circlePoint ζ) ∂circleMeasure := by
  rcases hr₁₂.eq_or_lt with rfl | hr_lt
  · exact le_rfl
  have hr₂_pos : 0 < r₂ := hr₁.trans_lt hr_lt
  have hr₂_ne : (r₂ : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hr₂_pos.ne'
  let g : ℂ → ℂ := fun w ↦ (u ((r₂ : ℂ) * w) : ℂ)
  have hg_cont : ContinuousOn g (Metric.sphere (0 : ℂ) 1) := by
    refine Complex.continuous_ofReal.comp_continuousOn
      (hu_cont.comp (continuous_const.mul continuous_id).continuousOn fun w hw ↦ ?_)
    have hw1 : ‖w‖ = 1 := by simpa [Metric.mem_sphere] using hw
    simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos hr₂_pos, hw1] using hr₂
  obtain ⟨hP_cont_c, hP_harm_c, _, hP_sph_c⟩ := RudinRCA.Chapter11.theorem11_8 hg_cont
  let H₁ : ℂ → ℝ := fun w ↦ (RudinRCA.Chapter11.poissonExtension g w).re
  have hH₁_cont : ContinuousOn H₁ (Metric.closedBall (0 : ℂ) 1) :=
    Complex.continuous_re.comp_continuousOn hP_cont_c
  have hH₁_harm : RudinRCA.Chapter11.HarmonicOn H₁ (Metric.ball (0 : ℂ) 1) :=
    hP_harm_c.comp_clm Metric.isOpen_ball Complex.reCLM
  have hH₁_sph : ∀ ζ ∈ Metric.sphere (0 : ℂ) 1, H₁ ζ = u ((r₂ : ℂ) * ζ) := by
    intro ζ hζ; dsimp [H₁]; rw [hP_sph_c ζ hζ]; simp [g]
  let h : ℂ → ℝ := fun z ↦ H₁ (z / (r₂ : ℂ))
  have hmap_cb : MapsTo (fun z : ℂ ↦ z / (r₂ : ℂ))
      (Metric.closedBall (0 : ℂ) r₂) (Metric.closedBall (0 : ℂ) 1) := by
    intro z hz
    rw [Metric.mem_closedBall, dist_zero_right, norm_div, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hr₂_pos, div_le_one hr₂_pos]
    simpa [Metric.mem_closedBall] using hz
  have hmap_ball : MapsTo (fun z : ℂ ↦ z / (r₂ : ℂ))
      (Metric.ball (0 : ℂ) r₂) (Metric.ball (0 : ℂ) 1) := by
    intro z hz
    rw [Metric.mem_ball, dist_zero_right, norm_div, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hr₂_pos, div_lt_one hr₂_pos]
    simpa [Metric.mem_ball] using hz
  have hh_cont : ContinuousOn h (Metric.closedBall (0 : ℂ) r₂) :=
    hH₁_cont.comp (continuous_id.div_const (r₂ : ℂ)).continuousOn hmap_cb
  obtain ⟨hH₁_P, hH₁_H, hG_diff, _⟩ := RudinRCA.Chapter11.theorem11_9_real hH₁_cont hH₁_harm
  have hh_harm_ball : RudinRCA.Chapter11.HarmonicOn h (Metric.ball (0 : ℂ) r₂) := by
    let G₂ : ℂ → ℂ := fun z ↦
      Real.circleAverage (fun ζ ↦ herglotzRieszKernel 0 (z / (r₂ : ℂ)) ζ • (H₁ ζ : ℂ)) 0 1
    have hG₂_diff : DifferentiableOn ℂ G₂ (Metric.ball (0 : ℂ) r₂) :=
      hG_diff.comp (differentiable_id.div_const (r₂ : ℂ)).differentiableOn hmap_ball
    have hG₂_harm : RudinRCA.Chapter11.HarmonicOn (fun z ↦ (G₂ z).re) (Metric.ball (0 : ℂ) r₂) :=
      (RudinRCA.Chapter11.node11_4_holomorphic_harmonic Metric.isOpen_ball hG₂_diff).comp_clm
        Metric.isOpen_ball Complex.reCLM
    exact hG₂_harm.congr_of_isOpen Metric.isOpen_ball fun z hz ↦ (hH₁_H (z / (r₂ : ℂ)) (hmap_ball hz)).symm
  have hint_eq : interior (Metric.closedBall (0 : ℂ) r₂) = Metric.ball (0 : ℂ) r₂ :=
    interior_closedBall (0 : ℂ) hr₂_pos.ne'
  have hh_harm : RudinRCA.Chapter11.HarmonicOn h (interior (Metric.closedBall (0 : ℂ) r₂)) := by
    rwa [hint_eq]
  have hu_le_h : ∀ z ∈ Metric.closedBall (0 : ℂ) r₂, u z ≤ h z := by
    refine harmonic_majorant_on_compact hu_cont hu_sub (isCompact_closedBall 0 r₂)
      (Metric.closedBall_subset_ball hr₂) hh_cont hh_harm ?_
    rw [frontier_closedBall (0 : ℂ) hr₂_pos.ne']
    intro z hz
    have hzs : z / (r₂ : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
      rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
        Real.norm_eq_abs, abs_of_pos hr₂_pos, div_eq_one_iff_eq hr₂_pos.ne']
      simpa [Metric.mem_sphere] using hz
    dsimp [h]
    rw [hH₁_sph (z / (r₂ : ℂ)) hzs, mul_div_cancel₀ z hr₂_ne]
  have hu_r₁_cont : Continuous (fun ζ : FourierCircle ↦ u ((r₁ : ℂ) * circlePoint ζ)) :=
    hu_cont.comp_continuous (continuous_const.mul continuous_circlePoint) fun ζ ↦ by
      have := affine_circlePoint_mem_closedBall 0 hr₁ ζ
      rw [zero_add] at this
      exact (Metric.closedBall_subset_ball (hr_lt.trans hr₂)) this
  have hh_r₁_cont : Continuous (fun ζ : FourierCircle ↦ h ((r₁ : ℂ) * circlePoint ζ)) :=
    hh_cont.comp_continuous (continuous_const.mul continuous_circlePoint) fun ζ ↦ by
      have := affine_circlePoint_mem_closedBall 0 hr₁ ζ
      rw [zero_add] at this
      exact (Metric.closedBall_subset_closedBall hr₁₂) this
  have hint_le : ∫ ζ, u ((r₁ : ℂ) * circlePoint ζ) ∂circleMeasure ≤
      ∫ ζ, h ((r₁ : ℂ) * circlePoint ζ) ∂circleMeasure := by
    refine integral_mono
      (hu_r₁_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
      (hh_r₁_cont.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _))
      fun ζ ↦ hu_le_h _ ?_
    have := affine_circlePoint_mem_closedBall 0 hr₁ ζ
    rw [zero_add] at this
    exact (Metric.closedBall_subset_closedBall hr₁₂) this
  have hh_mean_r₁ : ∫ ζ, h ((r₁ : ℂ) * circlePoint ζ) ∂circleMeasure = h 0 := by
    rcases hr₁.eq_or_lt with rfl | hr₁_pos
    · simp
    · have h0_add : (fun ζ : FourierCircle ↦ h ((r₁ : ℂ) * circlePoint ζ)) =
          fun ζ : FourierCircle ↦ h (0 + (r₁ : ℂ) * circlePoint ζ) := by
        funext ζ; rw [zero_add]
      rw [h0_add, integral_circleMeasure_eq_circleAverage,
        (RudinRCA.Chapter11.theorem11_12_real Metric.isOpen_ball hh_harm_ball).1 hr₁_pos
          (Metric.closedBall_subset_ball hr_lt)]
  have hh0_eq : h 0 = ∫ ζ, u ((r₂ : ℂ) * circlePoint ζ) ∂circleMeasure := by
    have h0_mem : (0 : ℂ) ∈ Metric.ball (0 : ℂ) 1 := Metric.mem_ball_self zero_lt_one
    have hH0 : h 0 = RudinRCA.Chapter11.poissonIntegral H₁ 0 := by
      dsimp [h]; rw [zero_div]; exact hH₁_P 0 h0_mem
    rw [hH0]
    unfold RudinRCA.Chapter11.poissonIntegral
    have hca_eq : Real.circleAverage (fun ζ ↦ _root_.poissonKernel 0 0 ζ • H₁ ζ) 0 1 =
        Real.circleAverage (fun ζ ↦ u ((r₂ : ℂ) * ζ)) 0 1 := by
      refine Real.circleAverage_congr_sphere fun ζ hζ ↦ ?_
      have hζ' : ζ ∈ Metric.sphere (0 : ℂ) 1 := by simpa using hζ
      have hζ1 : ‖ζ‖ = 1 := by simpa [Metric.mem_sphere] using hζ'
      have hpk1 : _root_.poissonKernel 0 0 ζ = 1 := by simp [_root_.poissonKernel, hζ1]
      rw [hpk1, one_smul, hH₁_sph ζ hζ']
    rw [hca_eq, ← integral_circleMeasure_eq_circleAverage (fun ζ ↦ u ((r₂ : ℂ) * ζ)) 0 1]
    simp
  linarith

private theorem continuous_radialSlice_of_holomorphicOn {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    Continuous (radialSlice f r) := by
  refine (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).comp_continuous
    (continuous_const.mul continuous_circlePoint) fun ζ ↦ ?_
  simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg hr0] using hr1

private theorem memLp_circleMeasure_of_continuous {E : Type*} [NormedAddCommGroup E]
    {g : FourierCircle → E} (hg : Continuous g) (p : ℝ≥0∞) :
    MemLp g p circleMeasure := by
  obtain ⟨ζ_max, _, hmax⟩ := isCompact_univ.exists_isMaxOn univ_nonempty hg.norm.continuousOn
  exact MemLp.of_bound hg.aestronglyMeasurable ‖g ζ_max‖
    (Eventually.of_forall fun ζ ↦ hmax (mem_univ ζ))

private theorem memLp_radialSlice_of_continuous {f : ℂ → ℂ} {r : ℝ}
    (hcont : Continuous (radialSlice f r)) (p : ℝ≥0∞) :
    MemLp (radialSlice f r) p circleMeasure :=
  memLp_circleMeasure_of_continuous hcont p

private theorem eLpNorm_top_eq_iSup_of_continuous (g : FourierCircle → ℂ) (hg : Continuous g) :
    eLpNorm g ⊤ circleMeasure = ⨆ ζ : FourierCircle, ‖g ζ‖ₑ := by
  rw [eLpNorm_exponent_top hg.aestronglyMeasurable, eLpNormEssSup_eq_essSup_enorm]
  have hg_enorm : Continuous (fun ζ : FourierCircle ↦ ‖g ζ‖ₑ) := by
    simpa only [enorm_eq_nnnorm, Function.comp_def] using ENNReal.continuous_coe.comp hg.nnnorm
  exact (iSup_eq_essSup fun ζ _ ha ↦
    (isOpen_lt continuous_const hg_enorm).measure_ne_zero circleMeasure ⟨ζ, ha⟩).symm

private theorem hardySizeENNReal_top_eq_biSup {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    hardySizeENNReal ⊤ f = ⨆ z ∈ Metric.ball (0 : ℂ) 1, ‖f z‖ₑ := by
  unfold hardySizeENNReal
  refine le_antisymm ?_ ?_
  · refine iSup₂_le fun r hr ↦ ?_
    have hcont := continuous_radialSlice_of_holomorphicOn hf hr.1 hr.2
    unfold radialSizeENNReal
    rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
      eLpNorm_top_eq_iSup_of_continuous _ hcont]
    refine iSup_le fun ζ ↦ ?_
    have hz_mem : (r : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hr.1] using hr.2
    exact le_biSup (fun z ↦ ‖f z‖ₑ) hz_mem
  · refine iSup₂_le fun z hz ↦ ?_
    have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
    let r : ℝ := ‖z‖
    have hr_mem : r ∈ Set.Ico (0 : ℝ) 1 := ⟨norm_nonneg z, hz_lt⟩
    have hcont := continuous_radialSlice_of_holomorphicOn hf hr_mem.1 hr_mem.2
    obtain ⟨ζ, hζ⟩ : ∃ ζ : FourierCircle, (r : ℂ) * circlePoint ζ = z := by
      by_cases hz0 : z = 0
      · exact ⟨0, by simp [r, hz0]⟩
      · have hr_pos : 0 < r := norm_pos_iff.mpr hz0
        have hw : z / (r : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
          rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
            Real.norm_eq_abs, abs_of_pos hr_pos, div_self hr_pos.ne']
        obtain ⟨ζ, hζ⟩ := circlePoint_surjective_sphere hw
        exact ⟨ζ, by rw [hζ, mul_div_cancel₀ z (Complex.ofReal_ne_zero.mpr hr_pos.ne')]⟩
    calc ‖f z‖ₑ
        = ‖radialSlice f r ζ‖ₑ := by simp [radialSlice, hζ]
      _ ≤ radialSizeENNReal ⊤ f r := by
          unfold radialSizeENNReal
          rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
            eLpNorm_top_eq_iSup_of_continuous _ hcont]
          exact le_iSup (fun η ↦ ‖radialSlice f r η‖ₑ) ζ
      _ ≤ ⨆ ρ ∈ Set.Ico (0 : ℝ) 1, radialSizeENNReal ⊤ f ρ :=
          le_biSup (radialSizeENNReal ⊤ f) hr_mem

private theorem isInNevanlinnaClassCh17_iff (f : ℂ → ℂ) :
    IsInNevanlinnaClassCh17 f ↔
      HolomorphicOn f (Metric.ball (0 : ℂ) 1) ∧
        BddAbove ((fun r ↦ ∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) '' Set.Ioo 0 1) := by
  unfold IsInNevanlinnaClassCh17
  constructor
  · rintro ⟨hf, hlt⟩
    refine ⟨hf, Real.log (hardySize 0 f + 1), ?_⟩
    rintro _ ⟨r, hr, rfl⟩
    dsimp only
    have hr_Ico : r ∈ Set.Ico (0 : ℝ) 1 := ⟨hr.1.le, hr.2⟩
    have hle : radialSizeENNReal 0 f r ≤ hardySizeENNReal 0 f :=
      le_biSup (radialSizeENNReal 0 f) hr_Ico
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize] at hle
    have hexp_le : Real.exp (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) ≤
        hardySize 0 f :=
      (ENNReal.ofReal_le_iff_le_toReal hlt.ne).mp hle
    have hexp_lt : Real.exp (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) ≤
        hardySize 0 f + 1 := by linarith
    rw [← Real.log_exp (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure)]
    exact Real.log_le_log (Real.exp_pos _) hexp_lt
  · rintro ⟨hf, B, hB⟩
    refine ⟨hf, ?_⟩
    unfold hardySizeENNReal
    let M : ℝ := max (Real.posLog ‖f 0‖) B
    refine lt_of_le_of_lt (iSup₂_le fun r hr ↦ ?_) (ENNReal.ofReal_lt_top (r := Real.exp M))
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize]
    refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
    rcases hr.1.eq_or_lt with rfl | hr_pos
    · simp only [radialSlice, Complex.ofReal_zero, zero_mul, integral_const, Measure.real,
        measure_univ, ENNReal.toReal_one, one_smul]
      exact le_max_left _ _
    · exact (hB ⟨r, ⟨hr_pos, hr.2⟩, rfl⟩).trans (le_max_right _ _)

private theorem radialSizeENNReal_le_of_exponent_le {s p : ℝ≥0∞} (hs0 : s ≠ 0) (hsp : s ≤ p)
    (f : ℂ → ℂ) (r : ℝ) :
    radialSizeENNReal s f r ≤ radialSizeENNReal p f r := by
  have hp0 : p ≠ 0 := ne_of_gt ((pos_iff_ne_zero.mpr hs0).trans_le hsp)
  simp only [radialSizeENNReal, hs0, hp0, ↓reduceIte]
  exact eLpNorm_le_eLpNorm_of_exponent_le hsp

private theorem hardySizeENNReal_le_of_exponent_le {s p : ℝ≥0∞} (hs0 : s ≠ 0) (hsp : s ≤ p)
    (f : ℂ → ℂ) :
    hardySizeENNReal s f ≤ hardySizeENNReal p f :=
  iSup₂_mono fun r _ ↦ radialSizeENNReal_le_of_exponent_le hs0 hsp f r

private theorem IsInHardySpace.mono_exponent {s p : ℝ≥0∞} (hs0 : s ≠ 0) (hsp : s ≤ p)
    {f : ℂ → ℂ} (hf : IsInHardySpace p f) :
    IsInHardySpace s f :=
  ⟨hs0, hf.2.1, (hardySizeENNReal_le_of_exponent_le hs0 hsp f).trans_lt hf.2.2⟩

private theorem mul_posLog_le_rpow {σ t : ℝ} (ht : 0 ≤ t) :
    σ * Real.posLog t ≤ t ^ σ := by
  rcases le_or_gt t 1 with ht1 | ht1
  · have hpl : Real.posLog t = 0 := by
      rw [Real.posLog_eq_zero_iff]
      rcases ht.eq_or_lt with rfl | hpos
      · norm_num
      · rwa [abs_of_pos hpos]
    rw [hpl, mul_zero]
    exact Real.rpow_nonneg ht σ
  · have ht_pos : 0 < t := zero_lt_one.trans ht1
    have hlog_pos : 0 < Real.log t := Real.log_pos ht1
    change σ * max 0 (Real.log t) ≤ t ^ σ
    rw [max_eq_right hlog_pos.le]
    have hlog_rpow : σ * Real.log t = Real.log (t ^ σ) := by
      rw [Real.log_rpow ht_pos, mul_comm]
    rw [hlog_rpow]
    linarith [Real.log_le_sub_one_of_pos (Real.rpow_pos_of_pos ht_pos σ)]

private theorem IsInHardySpace.toNevanlinna {s : ℝ≥0∞} {f : ℂ → ℂ}
    (hf : IsInHardySpace s f) :
    IsInNevanlinnaClassCh17 f := by
  rcases eq_or_ne s ⊤ with rfl | hstop
  · have hf1 : IsInHardySpace 1 f := hf.mono_exponent one_ne_zero le_top
    obtain ⟨hf_hol, hlt1⟩ := hf1.2
    rw [isInNevanlinnaClassCh17_iff]
    refine ⟨hf_hol, hardySize 1 f, ?_⟩
    rintro _ ⟨r, hr, rfl⟩
    have hcont := continuous_radialSlice_of_holomorphicOn hf_hol hr.1.le hr.2
    have hpos_int : Integrable (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) circleMeasure :=
      (Real.continuous_posLog.comp hcont.norm).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hnorm_int : Integrable (fun ζ ↦ ‖radialSlice f r ζ‖) circleMeasure :=
      hcont.norm.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
    have h1 : ∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure ≤
        ∫ ζ, ‖radialSlice f r ζ‖ ∂circleMeasure :=
      integral_mono hpos_int hnorm_int fun ζ ↦ by
        simpa using mul_posLog_le_rpow (σ := 1) (norm_nonneg (radialSlice f r ζ))
    have h2 : ENNReal.ofReal (∫ ζ, ‖radialSlice f r ζ‖ ∂circleMeasure) =
        radialSizeENNReal 1 f r := by
      unfold radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h ↦ (one_ne_zero h).elim,
        (memLp_radialSlice_of_continuous hcont 1).eLpNorm_eq_integral_rpow_norm
          one_ne_zero ENNReal.one_ne_top]
      simp
    have h3 : radialSizeENNReal 1 f r ≤ hardySizeENNReal 1 f :=
      le_biSup (radialSizeENNReal 1 f) (⟨hr.1.le, hr.2⟩ : r ∈ Set.Ico (0 : ℝ) 1)
    exact h1.trans ((ENNReal.ofReal_le_iff_le_toReal hlt1.ne).mp (h2.trans_le h3))
  · obtain ⟨hs0, hf_hol, hlts⟩ := hf
    have hσ_pos : 0 < s.toReal := ENNReal.toReal_pos hs0 hstop
    rw [isInNevanlinnaClassCh17_iff]
    refine ⟨hf_hol, (hardySize s f) ^ s.toReal / s.toReal, ?_⟩
    rintro _ ⟨r, hr, rfl⟩
    have hcont := continuous_radialSlice_of_holomorphicOn hf_hol hr.1.le hr.2
    have hpos_int : Integrable (fun ζ ↦ Real.posLog ‖radialSlice f r ζ‖) circleMeasure :=
      (Real.continuous_posLog.comp hcont.norm).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hrpow_int : Integrable (fun ζ ↦ ‖radialSlice f r ζ‖ ^ s.toReal) circleMeasure :=
      (hcont.norm.rpow_const fun _ ↦ Or.inr hσ_pos.le).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hle_int : s.toReal * (∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure) ≤
        ∫ ζ, ‖radialSlice f r ζ‖ ^ s.toReal ∂circleMeasure := by
      rw [← integral_const_mul]
      exact integral_mono (hpos_int.const_mul s.toReal) hrpow_int fun ζ ↦
        mul_posLog_le_rpow (norm_nonneg _)
    have hrad_eq : ∫ ζ, ‖radialSlice f r ζ‖ ^ s.toReal ∂circleMeasure =
        (radialSize s f r) ^ s.toReal := by
      unfold radialSize radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h ↦ absurd h hs0,
        (memLp_radialSlice_of_continuous hcont s).eLpNorm_eq_integral_rpow_norm hs0 hstop,
        ENNReal.toReal_ofReal (by positivity),
        ← Real.rpow_mul (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _),
        inv_mul_cancel₀ hσ_pos.ne', Real.rpow_one]
    have hrad_le_hardy : radialSize s f r ≤ hardySize s f :=
      ENNReal.toReal_mono hlts.ne
        (le_biSup (radialSizeENNReal s f) (⟨hr.1.le, hr.2⟩ : r ∈ Set.Ico (0 : ℝ) 1))
    have hpow_le : (radialSize s f r) ^ s.toReal ≤ (hardySize s f) ^ s.toReal :=
      Real.rpow_le_rpow ENNReal.toReal_nonneg hrad_le_hardy hσ_pos.le
    rw [le_div_iff₀' hσ_pos]
    exact hle_int.trans (hrad_eq.trans_le hpow_le)

private theorem radialSizeENNReal_mono {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) (p : ℝ≥0∞)
    {r₁ r₂ : ℝ} (hr₁ : 0 ≤ r₁) (hr₁₂ : r₁ ≤ r₂) (hr₂ : r₂ < 1) :
    radialSizeENNReal p f r₁ ≤ radialSizeENNReal p f r₂ := by
  by_cases hp0 : p = 0
  · subst hp0
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize]
    refine ENNReal.ofReal_le_ofReal (Real.exp_le_exp.mpr ?_)
    have hu_cont : ContinuousOn (fun z ↦ Real.posLog ‖f z‖) (Metric.ball (0 : ℂ) 1) :=
      Real.continuous_posLog.comp_continuousOn
        (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).norm
    exact circleMean_mono_unitDisc hu_cont (subharmonicOnP_posLog_norm_region isRegion_unitDisc hf)
      hr₁ hr₁₂ hr₂
  · rcases eq_or_ne p ⊤ with rfl | hptop
    · rcases hr₁₂.eq_or_lt with rfl | hr_lt
      · exact le_rfl
      have hr₂_pos : 0 < r₂ := hr₁.trans_lt hr_lt
      have hcont₁ := continuous_radialSlice_of_holomorphicOn hf hr₁ (hr_lt.trans hr₂)
      have hcont₂ := continuous_radialSlice_of_holomorphicOn hf hr₂_pos.le hr₂
      unfold radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h ↦ (ENNReal.top_ne_zero h).elim,
        eLpNorm_top_eq_iSup_of_continuous _ hcont₁,
        eLpNorm_top_eq_iSup_of_continuous _ hcont₂]
      obtain ⟨ζ₂, _, hζ₂_max⟩ :=
        isCompact_univ.exists_isMaxOn univ_nonempty hcont₂.norm.continuousOn
      have hhd : DiffContOnCl ℂ f (Metric.ball (0 : ℂ) r₂) := by
        refine ⟨fun z hz ↦ (hf z ((Metric.ball_subset_ball hr₂.le) hz)).differentiableWithinAt, ?_⟩
        rw [closure_ball 0 hr₂_pos.ne']
        exact (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).mono
          (Metric.closedBall_subset_ball hr₂)
      have hmax_mod : ∀ z ∈ Metric.closedBall (0 : ℂ) r₂, ‖f z‖ ≤ ‖radialSlice f r₂ ζ₂‖ := by
        intro z hz
        rw [← closure_ball 0 hr₂_pos.ne'] at hz
        refine Complex.norm_le_of_forall_mem_frontier_norm_le Metric.isBounded_ball hhd ?_ hz
        rw [frontier_ball 0 hr₂_pos.ne']
        intro w hw
        have hw_unit : w / (r₂ : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by
          rw [Metric.mem_sphere, dist_zero_right, norm_div, Complex.norm_real,
            Real.norm_eq_abs, abs_of_pos hr₂_pos, div_eq_one_iff_eq hr₂_pos.ne']
          simpa [Metric.mem_sphere] using hw
        obtain ⟨ζ, hζ⟩ := circlePoint_surjective_sphere hw_unit
        have hw_eq : (r₂ : ℂ) * circlePoint ζ = w := by
          rw [hζ, mul_div_cancel₀ w (Complex.ofReal_ne_zero.mpr hr₂_pos.ne')]
        have hζ_le : ‖radialSlice f r₂ ζ‖ ≤ ‖radialSlice f r₂ ζ₂‖ := hζ₂_max (mem_univ ζ)
        simpa only [radialSlice, hw_eq] using hζ_le
      refine iSup_le fun ζ₁ ↦ ?_
      have hz₁_cb : (r₁ : ℂ) * circlePoint ζ₁ ∈ Metric.closedBall (0 : ℂ) r₂ := by
        have := affine_circlePoint_mem_closedBall 0 hr₁ ζ₁
        rw [zero_add] at this
        exact (Metric.closedBall_subset_closedBall hr₁₂) this
      have hle : ‖radialSlice f r₁ ζ₁‖ₑ ≤ ‖radialSlice f r₂ ζ₂‖ₑ := by
        rw [enorm_eq_nnnorm, enorm_eq_nnnorm, ENNReal.coe_le_coe]
        exact hmax_mod _ hz₁_cb
      exact hle.trans (le_iSup (fun η ↦ ‖radialSlice f r₂ η‖ₑ) ζ₂)
    · have hq_pos : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
      have hcont₁ := continuous_radialSlice_of_holomorphicOn hf hr₁ (hr₁₂.trans_lt hr₂)
      have hcont₂ := continuous_radialSlice_of_holomorphicOn hf (hr₁.trans hr₁₂) hr₂
      simp only [radialSizeENNReal, hp0, ↓reduceIte,
        (memLp_radialSlice_of_continuous hcont₁ p).eLpNorm_eq_integral_rpow_norm hp0 hptop,
        (memLp_radialSlice_of_continuous hcont₂ p).eLpNorm_eq_integral_rpow_norm hp0 hptop]
      refine ENNReal.ofReal_le_ofReal (Real.rpow_le_rpow
        (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _) ?_ (inv_nonneg.mpr hq_pos.le))
      have hu_cont : ContinuousOn (fun z ↦ ‖f z‖ ^ p.toReal) (Metric.ball (0 : ℂ) 1) :=
        (RudinRCA.Chapter10.continuousOn_of_holomorphicOn hf).norm.rpow_const
          fun _ _ ↦ Or.inr hq_pos.le
      exact circleMean_mono_unitDisc hu_cont
        (subharmonicOnP_rpow_norm_region isRegion_unitDisc hf hq_pos) hr₁ hr₁₂ hr₂

private theorem tendsto_radialSizeENNReal_nhdsLT_one {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) (p : ℝ≥0∞) :
    Tendsto (radialSizeENNReal p f) (𝓝[<] (1 : ℝ)) (𝓝 (hardySizeENNReal p f)) := by
  rw [tendsto_order]
  constructor
  · intro a ha
    rw [hardySizeENNReal, lt_biSup_iff] at ha
    obtain ⟨r₀, hr₀_mem, ha_lt⟩ := ha
    filter_upwards [Ico_mem_nhdsLT hr₀_mem.2] with r hr
    exact ha_lt.trans_le (radialSizeENNReal_mono hf p hr₀_mem.1 hr.1 hr.2)
  · intro b hb
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    exact (le_biSup (radialSizeENNReal p f) (⟨hr.1.le, hr.2⟩ : r ∈ Set.Ico (0 : ℝ) 1)).trans_lt hb

/-! ### Node 17.9: Blaschke Division in `N` and `Hᵖ` (`0 < p ≤ ∞`, RCA pp. 338–339) -/

/-- Bridge from Chapter 17's `IsInNevanlinnaClassCh17` to Chapter 15's `NevanlinnaClass`. -/
private theorem mem_nevanlinnaClass15_of_ch17 {f : ℂ → ℂ}
    (hfN : IsInNevanlinnaClassCh17 f) :
    f ∈ RudinRCA.Chapter15.NevanlinnaClass := by
  obtain ⟨hf, C, hC⟩ := (isInNevanlinnaClassCh17_iff f).mp hfN
  refine ⟨(RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hf, C, ?_⟩
  intro r hr
  have heq : Real.circleAverage (fun z ↦ Real.posLog ‖f z‖) 0 r =
      ∫ ζ, Real.posLog ‖radialSlice f r ζ‖ ∂circleMeasure := by
    rw [← integral_circleMeasure_eq_circleAverage (fun z ↦ Real.posLog ‖f z‖) 0 r]
    simp [radialSlice]
  rw [heq]
  exact hC ⟨r, hr, rfl⟩

/-- Removable-singularity holomorphic division on `ball 0 1`: when `f, B` are holomorphic on
`ball 0 1` with equal finite analytic orders everywhere on `ball 0 1`, `f / B` extends to a
zero-free holomorphic function `g` on `ball 0 1` satisfying `f = B * g`. -/
private theorem exists_ball_nonvanishing_quotient_of_order_eq {f B : ℂ → ℂ}
    (hf : DifferentiableOn ℂ f (Metric.ball (0 : ℂ) 1))
    (hB : DifferentiableOn ℂ B (Metric.ball (0 : ℂ) 1))
    (hfinite : ∀ z ∈ Metric.ball (0 : ℂ) 1, analyticOrderAt B z ≠ ⊤)
    (horder : ∀ z ∈ Metric.ball (0 : ℂ) 1, analyticOrderAt f z = analyticOrderAt B z) :
    ∃ g : ℂ → ℂ, DifferentiableOn ℂ g (Metric.ball (0 : ℂ) 1) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, g z ≠ 0) ∧
      ∀ z ∈ Metric.ball (0 : ℂ) 1, f z = B z * g z := by
  let U : Set ℂ := Metric.ball (0 : ℂ) 1
  let g : ℂ → ℂ := toMeromorphicNFOn (f / B) U
  have hf_ana : AnalyticOnNhd ℂ f U := hf.analyticOnNhd Metric.isOpen_ball
  have hB_ana : AnalyticOnNhd ℂ B U := hB.analyticOnNhd Metric.isOpen_ball
  have hm : MeromorphicOn (f / B) U :=
    fun z hz ↦ (hf_ana z hz).meromorphicAt.div (hB_ana z hz).meromorphicAt
  have hnf : ∀ z ∈ U, MeromorphicNFAt g z :=
    fun z hz ↦ meromorphicNFOn_toMeromorphicNFOn (f / B) U hz
  have hg_ord : ∀ z ∈ U, meromorphicOrderAt g z = 0 := by
    intro z hz
    dsimp only [g]
    rw [meromorphicOrderAt_toMeromorphicNFOn hm hz,
      meromorphicOrderAt_div (hf_ana z hz).meromorphicAt (hB_ana z hz).meromorphicAt,
      (hf_ana z hz).meromorphicOrderAt_eq, (hB_ana z hz).meromorphicOrderAt_eq,
      horder z hz]
    obtain ⟨m, hm_eq⟩ := ENat.ne_top_iff_exists.mp (hfinite z hz)
    rw [← hm_eq]
    simp
  have hg_ana : ∀ z ∈ U, AnalyticAt ℂ g z := fun z hz ↦
    (hnf z hz).meromorphicOrderAt_nonneg_iff_analyticAt.mp (le_of_eq (hg_ord z hz).symm)
  have hg_diff : DifferentiableOn ℂ g U :=
    fun z hz ↦ (hg_ana z hz).differentiableAt.differentiableWithinAt
  refine ⟨g, hg_diff, fun z hz ↦ (hnf z hz).meromorphicOrderAt_eq_zero_iff.mp (hg_ord z hz), ?_⟩
  intro z hz
  have hne : ∀ᶠ w in 𝓝[≠] z, B w ≠ 0 :=
    (hB_ana z hz).eventually_eq_zero_or_eventually_ne_zero.resolve_left
      (fun h ↦ hfinite z hz (analyticOrderAt_eq_top.mpr h))
  have heq : (fun w ↦ B w * g w) =ᶠ[𝓝[≠] z] f := by
    filter_upwards [hm.toMeromorphicNFOn_eq_self_on_nhdsNE hz, hne] with w hw hBw
    change g w = f w / B w at hw
    rw [hw, mul_div_cancel₀ _ hBw]
  have hmul : ContinuousAt (fun w ↦ B w * g w) z :=
    (hB_ana z hz).continuousAt.mul (hg_ana z hz).continuousAt
  have heqnhds : (fun w ↦ B w * g w) =ᶠ[𝓝 z] f :=
    (ContinuousAt.eventuallyEq_nhds_iff_eventuallyEq_nhdsNE hmul
      (hf_ana z hz).continuousAt).mp heq
  exact heqnhds.eq_of_nhds.symm

/-- Unified scaling comparison for `radialSizeENNReal p` across all `0 ≤ p ≤ ∞` (`p = 0`,
`0 < p < ⊤`, and `p = ⊤`). -/
private theorem radialSizeENNReal_le_of_norm_le_mul (p : ℝ≥0∞) {u v : ℂ → ℂ} {r c : ℝ}
    (hc : 1 ≤ c) (hu_cont : Continuous (radialSlice u r))
    (hv_cont : Continuous (radialSlice v r))
    (hpt : ∀ ζ : FourierCircle, ‖radialSlice u r ζ‖ ≤ c * ‖radialSlice v r ζ‖) :
    radialSizeENNReal p u r ≤ ENNReal.ofReal c * radialSizeENNReal p v r := by
  have hc0 : 0 ≤ c := zero_le_one.trans hc
  have hc_pos : 0 < c := zero_lt_one.trans_le hc
  by_cases hp0 : p = 0
  · subst hp0
    simp only [radialSizeENNReal, ↓reduceIte, radialZeroSize]
    rw [← ENNReal.ofReal_mul hc0]
    refine ENNReal.ofReal_le_ofReal ?_
    have hu_int : Integrable (fun ζ ↦ Real.posLog ‖radialSlice u r ζ‖) circleMeasure :=
      (Real.continuous_posLog.comp hu_cont.norm).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hv_int : Integrable (fun ζ ↦ Real.posLog ‖radialSlice v r ζ‖) circleMeasure :=
      (Real.continuous_posLog.comp hv_cont.norm).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)
    have hlogc : Real.posLog c = Real.log c := Real.posLog_eq_log (by rwa [abs_of_nonneg hc0])
    have hint_le : ∫ ζ, Real.posLog ‖radialSlice u r ζ‖ ∂circleMeasure ≤
        Real.log c + ∫ ζ, Real.posLog ‖radialSlice v r ζ‖ ∂circleMeasure := by
      have hconst_add : Real.log c + ∫ ζ, Real.posLog ‖radialSlice v r ζ‖ ∂circleMeasure =
          ∫ ζ, (Real.log c + Real.posLog ‖radialSlice v r ζ‖) ∂circleMeasure := by
        rw [integral_add (integrable_const _) hv_int, integral_const, Measure.real,
          measure_univ, ENNReal.toReal_one, one_smul]
      rw [hconst_add]
      refine integral_mono hu_int ((integrable_const _).add hv_int) fun ζ ↦ ?_
      calc Real.posLog ‖radialSlice u r ζ‖
          ≤ Real.posLog (c * ‖radialSlice v r ζ‖) :=
            Real.posLog_le_posLog (by linarith [norm_nonneg (radialSlice u r ζ)]) (hpt ζ)
        _ ≤ Real.posLog c + Real.posLog ‖radialSlice v r ζ‖ := Real.posLog_mul
        _ = Real.log c + Real.posLog ‖radialSlice v r ζ‖ := by rw [hlogc]
    calc Real.exp (∫ ζ, Real.posLog ‖radialSlice u r ζ‖ ∂circleMeasure)
        ≤ Real.exp (Real.log c + ∫ ζ, Real.posLog ‖radialSlice v r ζ‖ ∂circleMeasure) :=
          Real.exp_le_exp.mpr hint_le
      _ = c * Real.exp (∫ ζ, Real.posLog ‖radialSlice v r ζ‖ ∂circleMeasure) := by
          rw [Real.exp_add, Real.exp_log hc_pos]
  · simp only [radialSizeENNReal, hp0, ↓reduceIte]
    calc eLpNorm (radialSlice u r) p circleMeasure
        ≤ eLpNorm ((c : ℂ) • radialSlice v r) p circleMeasure := by
          refine eLpNorm_mono_ae hu_cont.aestronglyMeasurable (Eventually.of_forall fun ζ ↦ ?_)
          rw [Pi.smul_apply, norm_smul, Complex.norm_real, Real.norm_of_nonneg hc0]
          exact hpt ζ
      _ = ‖(c : ℂ)‖ₑ * eLpNorm (radialSlice v r) p circleMeasure :=
          eLpNorm_const_smul (c : ℂ) (radialSlice v r) p circleMeasure
      _ = ENNReal.ofReal c * eLpNorm (radialSlice v r) p circleMeasure := by
          rw [← ofReal_norm, Complex.norm_real, Real.norm_of_nonneg hc0]

/-- Helper: if `x ≤ ENNReal.ofReal (t⁻¹) * y` for every `t ∈ (0, 1)`, then `x ≤ y`. -/
private theorem ennreal_le_of_forall_inv_mul {x y : ℝ≥0∞}
    (h : ∀ t ∈ Set.Ioo (0 : ℝ) 1, x ≤ ENNReal.ofReal (t⁻¹) * y) :
    x ≤ y := by
  rcases eq_top_or_lt_top y with rfl | hy
  · exact le_top
  · have htend : Tendsto (fun t : ℝ ↦ ENNReal.ofReal (t⁻¹) * y) (𝓝[<] (1 : ℝ)) (𝓝 y) := by
      have h1 : Tendsto (fun t : ℝ ↦ ENNReal.ofReal (t⁻¹)) (𝓝[<] (1 : ℝ)) (𝓝 1) := by
        have hinv : Tendsto (fun t : ℝ ↦ t⁻¹) (𝓝[<] (1 : ℝ)) (𝓝 (1 : ℝ)) := by
          simpa using ((continuousAt_inv₀ (one_ne_zero : (1 : ℝ) ≠ 0)).tendsto.mono_left
            nhdsWithin_le_nhds)
        have hcomp : Tendsto (ENNReal.ofReal ∘ fun t : ℝ ↦ t⁻¹) (𝓝[<] (1 : ℝ))
            (𝓝 (ENNReal.ofReal 1)) := (ENNReal.continuous_ofReal.tendsto 1).comp hinv
        simpa [Function.comp_def] using hcomp
      simpa only [one_mul] using ENNReal.Tendsto.mul_const h1 (Or.inr hy.ne)
    exact ge_of_tendsto htend (by
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with t ht
      exact h t ht)

/-- Radial bound for a holomorphic factor `h` when `f = B₀ * h` for a finite Blaschke product `B₀`:
for every `0 ≤ p ≤ ∞` and `r ∈ [0, 1)`, `radialSizeENNReal p h r ≤ hardySizeENNReal p f`. -/
private theorem radialSizeENNReal_le_hardy_of_finite_blaschke_mul
    (p : ℝ≥0∞) {f B₀ h : ℂ → ℂ} {k N : ℕ} {b : Fin N → ℂ}
    (hb : ∀ i, b i ∈ Metric.ball (0 : ℂ) 1 ∧ b i ≠ 0)
    (hB₀_eq : B₀ = fun z ↦ z ^ k * ∏ i : Fin N, RudinRCA.Chapter15.blaschkeFactor (b i) z)
    (hf_hol : HolomorphicOn f (Metric.ball (0 : ℂ) 1))
    (hh_hol : HolomorphicOn h (Metric.ball (0 : ℂ) 1))
    (hfac : ∀ z ∈ Metric.ball (0 : ℂ) 1, f z = B₀ z * h z)
    {r : ℝ} (hr : r ∈ Set.Ico (0 : ℝ) 1) :
    radialSizeENNReal p h r ≤ hardySizeENNReal p f := by
  have hfin := RudinRCA.Chapter15.finite_blaschke_product k N b hb
  have hB₀_cont_cb : ContinuousOn B₀ (Metric.closedBall (0 : ℂ) 1) := by
    rw [hB₀_eq]; exact hfin.2.1.continuousOn
  have hB₀_sph : ∀ ζ ∈ Metric.sphere (0 : ℂ) 1, ‖B₀ ζ‖ = 1 := by
    rw [hB₀_eq]; exact hfin.2.2.2.2.1
  have hucont : UniformContinuousOn (fun z : ℂ ↦ ‖B₀ z‖) (Metric.closedBall (0 : ℂ) 1) :=
    (isCompact_closedBall (0 : ℂ) 1).uniformContinuousOn_of_continuous hB₀_cont_cb.norm
  refine ennreal_le_of_forall_inv_mul fun t ht ↦ ?_
  have h1mt_pos : 0 < 1 - t := sub_pos.mpr ht.2
  obtain ⟨δ, hδ_pos, hδ⟩ := Metric.uniformContinuousOn_iff.mp hucont (1 - t) h1mt_pos
  let R : ℝ := (max r (1 - δ / 2) + 1) / 2
  have hmax_lt1 : max r (1 - δ / 2) < 1 := max_lt hr.2 (by linarith)
  have hr_le_R : r ≤ R := by
    have : r ≤ max r (1 - δ / 2) := le_max_left _ _
    dsimp [R]; linarith
  have hR_lt1 : R < 1 := by dsimp [R]; linarith
  have hR0 : 0 ≤ R := hr.1.trans hr_le_R
  have h1mR_lt : 1 - R < δ := by
    have : 1 - δ / 2 ≤ max r (1 - δ / 2) := le_max_right _ _
    dsimp [R]; linarith
  have hB₀_ge_t : ∀ ζ : FourierCircle, t ≤ ‖B₀ ((R : ℂ) * circlePoint ζ)‖ := by
    intro ζ
    have hz_cb : (R : ℂ) * circlePoint ζ ∈ Metric.closedBall (0 : ℂ) 1 := by
      have := affine_circlePoint_mem_closedBall 0 hR0 ζ
      rw [zero_add] at this
      exact (Metric.closedBall_subset_closedBall hR_lt1.le) this
    have hw_sph : circlePoint ζ ∈ Metric.sphere (0 : ℂ) 1 := circlePoint_mem_sphere ζ
    have hw_cb : circlePoint ζ ∈ Metric.closedBall (0 : ℂ) 1 :=
      Metric.sphere_subset_closedBall hw_sph
    have hdist : dist ((R : ℂ) * circlePoint ζ) (circlePoint ζ) < δ := by
      rw [dist_eq_norm]
      have hsub : (R : ℂ) * circlePoint ζ - circlePoint ζ =
          (((R - 1 : ℝ) : ℂ) * circlePoint ζ) := by push_cast; ring
      rw [hsub, norm_mul, norm_circlePoint, mul_one, Complex.norm_real,
        Real.norm_eq_abs, abs_sub_comm, abs_of_pos (sub_pos.mpr hR_lt1)]
      exact h1mR_lt
    have hlt := hδ _ hz_cb _ hw_cb hdist
    rw [Real.dist_eq, hB₀_sph _ hw_sph, abs_lt] at hlt
    linarith [hlt.1]
  have hpt : ∀ ζ : FourierCircle, ‖radialSlice h R ζ‖ ≤ t⁻¹ * ‖radialSlice f R ζ‖ := by
    intro ζ
    have hz_ball : (R : ℂ) * circlePoint ζ ∈ Metric.ball (0 : ℂ) 1 := by
      simpa [Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg hR0] using hR_lt1
    have hf_eq : ‖radialSlice f R ζ‖ =
        ‖B₀ ((R : ℂ) * circlePoint ζ)‖ * ‖radialSlice h R ζ‖ := by
      simp [radialSlice, hfac _ hz_ball]
    have ht_le : t * ‖radialSlice h R ζ‖ ≤ ‖radialSlice f R ζ‖ := by
      rw [hf_eq]
      exact mul_le_mul_of_nonneg_right (hB₀_ge_t ζ) (norm_nonneg _)
    calc ‖radialSlice h R ζ‖
        = t⁻¹ * (t * ‖radialSlice h R ζ‖) := by rw [inv_mul_cancel_left₀ ht.1.ne']
      _ ≤ t⁻¹ * ‖radialSlice f R ζ‖ :=
          mul_le_mul_of_nonneg_left ht_le (inv_nonneg.mpr ht.1.le)
  have hh_cont := continuous_radialSlice_of_holomorphicOn hh_hol hR0 hR_lt1
  have hf_cont := continuous_radialSlice_of_holomorphicOn hf_hol hR0 hR_lt1
  calc radialSizeENNReal p h r
      ≤ radialSizeENNReal p h R := radialSizeENNReal_mono hh_hol p hr.1 hr_le_R hR_lt1
    _ ≤ ENNReal.ofReal (t⁻¹) * radialSizeENNReal p f R :=
        radialSizeENNReal_le_of_norm_le_mul p (one_le_inv₀ ht.1 |>.mpr ht.2.le)
          hh_cont hf_cont hpt
    _ ≤ ENNReal.ofReal (t⁻¹) * hardySizeENNReal p f := by
        gcongr
        exact le_biSup (radialSizeENNReal p f) ⟨hR0, hR_lt1⟩

/-- Elementary finite-product telescoping bound: if `‖w i‖ ≤ 1` for all `i < K`, then
`‖1 - ∏ i ∈ Finset.range K, w i‖ ≤ ∑ i ∈ Finset.range K, ‖1 - w i‖`. -/
private theorem norm_one_sub_prod_range_le {w : ℕ → ℂ} (K : ℕ)
    (hw : ∀ i < K, ‖w i‖ ≤ 1) :
    ‖1 - ∏ i ∈ Finset.range K, w i‖ ≤ ∑ i ∈ Finset.range K, ‖1 - w i‖ := by
  induction K with
  | zero => simp
  | succ K ih =>
    rw [Finset.prod_range_succ, Finset.sum_range_succ]
    set P : ℂ := ∏ i ∈ Finset.range K, w i
    have hid : 1 - P * w K = (1 - P) * w K + (1 - w K) := by ring
    rw [hid]
    calc ‖(1 - P) * w K + (1 - w K)‖
        ≤ ‖(1 - P) * w K‖ + ‖1 - w K‖ := norm_add_le _ _
      _ = ‖1 - P‖ * ‖w K‖ + ‖1 - w K‖ := by rw [norm_mul]
      _ ≤ ‖1 - P‖ * 1 + ‖1 - w K‖ := by
          gcongr
          exact hw K (Nat.lt_succ_self K)
      _ = ‖1 - P‖ + ‖1 - w K‖ := by rw [mul_one]
      _ ≤ (∑ i ∈ Finset.range K, ‖1 - w i‖) + ‖1 - w K‖ :=
          add_le_add (ih fun i hi ↦ hw i (Nat.lt_succ_of_lt hi)) le_rfl

/-- **Theorem 17.9 (Blaschke division in `N` and `Hᵖ`, `0 < p ≤ ∞`, RCA pp. 338–339):**
Suppose `f ∈ N` (`IsInNevanlinnaClassCh17 f`) is not identically `0` on `U = ball 0 1`, and let `B`
be the Blaschke product formed from the zeros of `f` (counted with multiplicity). Then there is a
zero-free holomorphic function `g ∈ N` on `U` such that `f = B · g` on `U`, `‖g‖₀ = ‖f‖₀`, and
furthermore for every `0 < p ≤ ∞` (`p : ℝ≥0∞`, `p ≠ 0`, `∞` explicitly included per `SCOPING-G.md`
Caution 7), `f ∈ Hᵖ ↔ g ∈ Hᵖ` and `‖g‖_p = ‖f‖_p`. -/
theorem theorem17_9 {f : ℂ → ℂ} (hfN : IsInNevanlinnaClassCh17 f)
    (hnonzero : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) :
    ∃ B g : ℂ → ℂ,
      RudinRCA.Chapter15.IsBlaschkeProduct B ∧
      IsInNevanlinnaClassCh17 g ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, g z ≠ 0) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, f z = B z * g z) ∧
      hardySizeENNReal 0 g = hardySizeENNReal 0 f ∧
      (∀ p : ℝ≥0∞, p ≠ 0 →
        (IsInHardySpace p f ↔ IsInHardySpace p g) ∧
        hardySizeENNReal p g = hardySizeENNReal p f) := by
  classical
  let U : Set ℂ := Metric.ball (0 : ℂ) 1
  have hf_hol : HolomorphicOn f U := hfN.1
  have hf_diff : DifferentiableOn ℂ f U :=
    (RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hf_hol
  have hf_ana : AnalyticOnNhd ℂ f U := hf_diff.analyticOnNhd Metric.isOpen_ball
  have hfN15 : f ∈ RudinRCA.Chapter15.NevanlinnaClass := mem_nevanlinnaClass15_of_ch17 hfN
  -- Every point of `U` has finite analytic order for `f` because `f` is not identically zero on `U`
  have hf_ord_ne_top : ∀ z ∈ U, analyticOrderAt f z ≠ ⊤ := by
    intro z hz htop
    obtain ⟨z₀, hz₀, hfz₀⟩ := hnonzero
    have hev : f =ᶠ[𝓝 z] 0 := analyticOrderAt_eq_top.mp htop
    have heq0 := hf_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
      (convex_ball (0 : ℂ) 1).isPreconnected hz hev
    exact hfz₀ (heq0 hz₀)
  -- Enumerate nonzero zeros of `f` in `U \ {0}` with multiplicity
  let A : Set ℂ := {z ∈ U | z ≠ 0 ∧ f z = 0}
  have hAU : A ⊆ U := fun _ hz ↦ hz.1
  have hacc : ∀ z ∈ U, z ∉ closure (A \ {z}) := by
    intro z hz hcl
    have hne : ∀ᶠ w in 𝓝[≠] z, f w ≠ 0 :=
      (hf_ana z hz).eventually_eq_zero_or_eventually_ne_zero.resolve_left
        (fun h ↦ hf_ord_ne_top z hz (analyticOrderAt_eq_top.mpr h))
    rw [eventually_nhdsWithin_iff] at hne
    obtain ⟨V, hV_sub, hV_open, hzV⟩ := mem_nhds_iff.mp hne
    obtain ⟨w, hwV, hwA, hwz⟩ := mem_closure_iff.mp hcl V hV_open hzV
    exact hV_sub hwV hwz hwA.2.2
  have hm_pos : ∀ a ∈ A, 0 < analyticOrderNatAt f a := by
    intro a ha
    have hcast : (analyticOrderNatAt f a : ℕ∞) = analyticOrderAt f a :=
      Nat.cast_analyticOrderNatAt (hf_ord_ne_top a ha.1)
    by_contra hle
    have h0 : analyticOrderNatAt f a = 0 := Nat.eq_zero_of_not_pos hle
    rw [h0, Nat.cast_zero] at hcast
    exact ((hf_ana a ha.1).analyticOrderAt_eq_zero.mp hcast.symm) ha.2.2
  let k : ℕ := analyticOrderNatAt f 0
  obtain ⟨_, henum⟩ := RudinRCA.Chapter15.discrete_multiplicity_enumeration
    Metric.isOpen_ball hAU hacc (fun z ↦ analyticOrderNatAt f z) hm_pos
  rcases henum with ⟨N, a, haA, hcard⟩ | ⟨a, haA, hhasSum⟩
  · -- Case 1: Finitely many zeros in `U \ {0}`
    have ha : ∀ i : Fin N, a i ∈ U ∧ a i ≠ 0 := fun i ↦ ⟨(haA i).1, (haA i).2.1⟩
    let B : ℂ → ℂ := fun z ↦ z ^ k * ∏ i : Fin N, RudinRCA.Chapter15.blaschkeFactor (a i) z
    obtain ⟨hB_is, hB_diff_cl, hB_diff, hB_norm_le, hB_norm_sp, _, hB_ord0, hB_ord_nz⟩ :=
      RudinRCA.Chapter15.finite_blaschke_product k N a ha
    have hB_ana : AnalyticOnNhd ℂ B U := hB_diff.analyticOnNhd Metric.isOpen_ball
    have hB_ord_ne_top : ∀ z ∈ U, analyticOrderAt B z ≠ ⊤ := by
      intro z hz htop
      have heq0 : EqOn B 0 U := hB_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        (convex_ball (0 : ℂ) 1).isPreconnected hz (analyticOrderAt_eq_top.mp htop)
      have hcl_eq : closure U = Metric.closedBall (0 : ℂ) 1 := closure_ball (0 : ℂ) one_ne_zero
      have hB_cont_cl : ContinuousOn B (closure U) := by
        rw [hcl_eq]; exact hB_diff_cl.continuousOn
      have hcl0 : EqOn B 0 (Metric.closedBall (0 : ℂ) 1) := by
        rw [← hcl_eq]
        exact heq0.of_subset_closure hB_cont_cl continuousOn_const subset_closure subset_rfl
      have h1_sph : (1 : ℂ) ∈ Metric.sphere (0 : ℂ) 1 := by simp
      have h1_norm : ‖B 1‖ = 1 := hB_norm_sp 1 h1_sph
      have hB1_zero : B 1 = 0 := hcl0 (Metric.sphere_subset_closedBall h1_sph)
      rw [hB1_zero, norm_zero] at h1_norm
      exact zero_ne_one h1_norm
    have hord_eq : ∀ z ∈ U, analyticOrderAt f z = analyticOrderAt B z := by
      intro z hz
      rw [← Nat.cast_analyticOrderNatAt (hf_ord_ne_top z hz),
        ← Nat.cast_analyticOrderNatAt (hB_ord_ne_top z hz)]
      congr 1
      by_cases hz0 : z = 0
      · subst hz0; exact hB_ord0.symm
      · rw [hB_ord_nz z ⟨hz, hz0⟩, hcard z]
        by_cases hzA : z ∈ A
        · simp [hzA]
        · simp only [hzA, ↓reduceIte]
          have hfnz : f z ≠ 0 := fun hfz ↦ hzA ⟨hz, hz0, hfz⟩
          have h0 : analyticOrderAt f z = 0 := (hf_ana z hz).analyticOrderAt_eq_zero.mpr hfnz
          simp [analyticOrderNatAt, h0]
    obtain ⟨g, hg_diff, hg_nz, hfac⟩ :=
      exists_ball_nonvanishing_quotient_of_order_eq hf_diff hB_diff hB_ord_ne_top hord_eq
    have hg_hol : HolomorphicOn g U :=
      (RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hg_diff
    have hsize_eq : ∀ p : ℝ≥0∞, hardySizeENNReal p g = hardySizeENNReal p f := by
      intro p
      refine le_antisymm ?_ ?_
      · refine iSup₂_le fun r hr ↦ ?_
        exact radialSizeENNReal_le_hardy_of_finite_blaschke_mul p ha rfl hf_hol hg_hol hfac hr
      · refine iSup₂_le fun r hr ↦ ?_
        have hf_cont := continuous_radialSlice_of_holomorphicOn hf_hol hr.1 hr.2
        have hg_cont := continuous_radialSlice_of_holomorphicOn hg_hol hr.1 hr.2
        have hle1 : radialSizeENNReal p f r ≤ ENNReal.ofReal 1 * radialSizeENNReal p g r := by
          refine radialSizeENNReal_le_of_norm_le_mul p le_rfl hf_cont hg_cont fun ζ ↦ ?_
          have hz_ball : (r : ℂ) * circlePoint ζ ∈ U := by
            simpa [U, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hr.1] using hr.2
          have hf_eq : f ((r : ℂ) * circlePoint ζ) =
              B ((r : ℂ) * circlePoint ζ) * g ((r : ℂ) * circlePoint ζ) := hfac _ hz_ball
          dsimp only [radialSlice]
          rw [hf_eq, norm_mul, one_mul]
          exact mul_le_of_le_one_left (norm_nonneg _) (hB_norm_le _ hz_ball)
        rw [ENNReal.ofReal_one, one_mul] at hle1
        exact hle1.trans (le_biSup (radialSizeENNReal p g) hr)
    have hgN : IsInNevanlinnaClassCh17 g := ⟨hg_hol, by rw [hsize_eq 0]; exact hfN.2⟩
    refine ⟨B, g, hB_is, hgN, hg_nz, hfac, hsize_eq 0, fun p hp0 ↦ ⟨?_, hsize_eq p⟩⟩
    exact ⟨fun ⟨_, _, h⟩ ↦ ⟨hp0, hg_hol, (hsize_eq p).trans_lt h⟩,
      fun ⟨_, _, h⟩ ↦ ⟨hp0, hf_hol, (hsize_eq p).symm.trans_lt h⟩⟩
  · -- Case 2: Countably infinitely many zeros in `U \ {0}`
    have ha : ∀ n : ℕ, a n ∈ U ∧ a n ≠ 0 := fun n ↦ ⟨(haA n).1, (haA n).2.1⟩
    have hsum_blaschke : Summable (fun n : ℕ ↦ 1 - ‖a n‖) := by
      refine (RudinRCA.Chapter15.theorem15_23.1 hfN15 hnonzero).2.2 a ha fun z ↦ ?_
      have hmap := (hhasSum z).map (Nat.castAddMonoidHom ℕ∞) continuous_of_discreteTopology
      have htsum : (∑' n : ℕ, if a n = z then (1 : ℕ∞) else 0) =
          ((if z ∈ A then analyticOrderNatAt f z else 0 : ℕ) : ℕ∞) := by
        simpa [Function.comp_def] using hmap.tsum_eq
      rw [htsum]
      by_cases hzA : z ∈ A
      · simp only [hzA, ↓reduceIte, Nat.cast_analyticOrderNatAt (hf_ord_ne_top z hzA.1), le_rfl]
      · simp [hzA]
    let P : ℂ → ℂ := fun z ↦ ∏' n : ℕ, RudinRCA.Chapter15.blaschkeFactor (a n) z
    let B : ℂ → ℂ := fun z ↦ z ^ k * P z
    obtain ⟨hB_is, hP_loc, _, hP_diff, hB_diff, hPB_norm, hP0_ne, _, hB_ord0, hB_ord_nz⟩ :=
      RudinRCA.Chapter15.theorem15_21 k ha hsum_blaschke
    have hB_ana : AnalyticOnNhd ℂ B U := hB_diff.analyticOnNhd Metric.isOpen_ball
    have h0_mem : (0 : ℂ) ∈ U := Metric.mem_ball_self zero_lt_one
    have hB_ord0_ne_top : analyticOrderAt B 0 ≠ ⊤ := by
      intro htop
      have hP0_cont : ContinuousAt P 0 :=
        (hP_diff.differentiableAt (Metric.isOpen_ball.mem_nhds h0_mem)).continuousAt
      obtain ⟨δ, hδ_pos, hδ_nz⟩ := Metric.mem_nhds_iff.mp (hP0_cont.eventually_ne hP0_ne)
      let z₁ : ℂ := ((min (δ / 2) (1 / 2) : ℝ) : ℂ)
      have hz₁_pos : 0 < min (δ / 2) (1 / 2) := lt_min (half_pos hδ_pos) (by norm_num)
      have hz₁_U : z₁ ∈ U := by
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_of_nonneg hz₁_pos.le]
        exact (min_le_right _ _).trans_lt (by norm_num)
      have hz₁_δ : z₁ ∈ Metric.ball (0 : ℂ) δ := by
        rw [Metric.mem_ball, dist_zero_right, Complex.norm_real, Real.norm_of_nonneg hz₁_pos.le]
        exact (min_le_left _ _).trans_lt (half_lt_self hδ_pos)
      have heq0 : EqOn B 0 U := hB_ana.eqOn_zero_of_preconnected_of_eventuallyEq_zero
        (convex_ball (0 : ℂ) 1).isPreconnected h0_mem (analyticOrderAt_eq_top.mp htop)
      have hBz₁_ne : B z₁ ≠ 0 :=
        mul_ne_zero (pow_ne_zero k (Complex.ofReal_ne_zero.mpr hz₁_pos.ne')) (hδ_nz hz₁_δ)
      exact hBz₁_ne (heq0 hz₁_U)
    have hB_ord_ne_top : ∀ z ∈ U, analyticOrderAt B z ≠ ⊤ := by
      intro z hz
      by_cases hz0 : z = 0
      · subst hz0; exact hB_ord0_ne_top
      · exact (hB_ord_nz z ⟨hz, hz0⟩).1
    have hord_eq : ∀ z ∈ U, analyticOrderAt f z = analyticOrderAt B z := by
      intro z hz
      rw [← Nat.cast_analyticOrderNatAt (hf_ord_ne_top z hz),
        ← Nat.cast_analyticOrderNatAt (hB_ord_ne_top z hz)]
      congr 1
      by_cases hz0 : z = 0
      · subst hz0; exact hB_ord0.symm
      · rw [(hB_ord_nz z ⟨hz, hz0⟩).2]
        have htsum_eq : (∑' n : ℕ, if z = a n then (1 : ℕ) else 0) =
            if z ∈ A then analyticOrderNatAt f z else 0 := by
          have hcongr : (fun n : ℕ ↦ if z = a n then (1 : ℕ) else 0) =
              fun n : ℕ ↦ if a n = z then (1 : ℕ) else 0 := by
            funext n; simp [eq_comm]
          rw [hcongr]
          exact (hhasSum z).tsum_eq.trans (by split_ifs <;> rfl)
        rw [htsum_eq]
        by_cases hzA : z ∈ A
        · simp [hzA]
        · simp only [hzA, ↓reduceIte]
          have hfnz : f z ≠ 0 := fun hfz ↦ hzA ⟨hz, hz0, hfz⟩
          have h0 : analyticOrderAt f z = 0 := (hf_ana z hz).analyticOrderAt_eq_zero.mpr hfnz
          simp [analyticOrderNatAt, h0]
    obtain ⟨g, hg_diff, hg_nz, hfac⟩ :=
      exists_ball_nonvanishing_quotient_of_order_eq hf_diff hB_diff hB_ord_ne_top hord_eq
    have hg_hol : HolomorphicOn g U :=
      (RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hg_diff
    -- Show `hardySizeENNReal p g = hardySizeENNReal p f` for all `0 ≤ p ≤ ∞` via partial products
    have hsize_eq : ∀ p : ℝ≥0∞, hardySizeENNReal p g = hardySizeENNReal p f := by
      intro p
      refine le_antisymm ?_ ?_
      · refine iSup₂_le fun r hr ↦ ?_
        refine ennreal_le_of_forall_inv_mul fun t ht ↦ ?_
        have h1mt_pos : 0 < 1 - t := sub_pos.mpr ht.2
        -- Choose `m` so that `(2 / (1 - r)) * ∑' j, (1 - ‖a (m + j)‖) < 1 - t`
        have htail_tend : Tendsto (fun m : ℕ ↦ ∑' j : ℕ, (1 - ‖a (m + j)‖)) atTop (𝓝 0) := by
          let S : ℝ := ∑' n : ℕ, (1 - ‖a n‖)
          have h1 : Tendsto (fun m : ℕ ↦ ∑ n ∈ Finset.range m, (1 - ‖a n‖)) atTop (𝓝 S) :=
            hsum_blaschke.hasSum.tendsto_sum_nat
          have hsub : Tendsto
              (fun m : ℕ ↦ S - ∑ n ∈ Finset.range m, (1 - ‖a n‖)) atTop (𝓝 (S - S)) :=
            tendsto_const_nhds.sub h1
          rw [sub_self] at hsub
          refine hsub.congr fun m ↦ ?_
          have hsplit := Summable.sum_add_tsum_nat_add m hsum_blaschke
          have hcomm : (∑' j : ℕ, (1 - ‖a (j + m)‖)) = ∑' j : ℕ, (1 - ‖a (m + j)‖) := by
            congr 1; funext j; rw [add_comm]
          dsimp [S]
          linarith [hsplit, hcomm]
        have hscaled_tend : Tendsto
            (fun m : ℕ ↦ (2 / (1 - r)) * ∑' j : ℕ, (1 - ‖a (m + j)‖)) atTop (𝓝 0) := by
          simpa using htail_tend.const_mul (2 / (1 - r))
        obtain ⟨m, hm_lt⟩ := (hscaled_tend.eventually (gt_mem_nhds h1mt_pos)).exists
        have ha_shift : ∀ j : ℕ, a (m + j) ∈ U ∧ a (m + j) ≠ 0 := fun j ↦ ha (m + j)
        have hsum_shift : Summable (fun j : ℕ ↦ 1 - ‖a (m + j)‖) := by
          simpa only [add_comm m] using (summable_nat_add_iff m).mpr hsum_blaschke
        let T_m : ℂ → ℂ := fun z ↦ ∏' j : ℕ, RudinRCA.Chapter15.blaschkeFactor (a (m + j)) z
        obtain ⟨_, hTm_loc, _, hTm_diff, _, _, _, _, _, _⟩ :=
          RudinRCA.Chapter15.theorem15_21 0 ha_shift hsum_shift
        let B_m : ℂ → ℂ := fun z ↦
          z ^ k * ∏ i : Fin m, RudinRCA.Chapter15.blaschkeFactor (a i.1) z
        let g_m : ℂ → ℂ := fun z ↦ T_m z * g z
        have hgm_hol : HolomorphicOn g_m U :=
          ((RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr
            (hTm_diff.mul hg_diff))
        -- Verify `B z = B_m z * T_m z` on `U`
        have hB_split : ∀ z ∈ U, B z = B_m z * T_m z := by
          intro z hz
          have hP_pt' : Tendsto
              (fun K : ℕ ↦ ∏ n ∈ Finset.range (K + m), RudinRCA.Chapter15.blaschkeFactor (a n) z)
              atTop (𝓝 (P z)) :=
            (hP_loc.tendsto_at hz).comp (tendsto_add_atTop_nat m)
          have hP_pt : Tendsto
              (fun K : ℕ ↦ ∏ n ∈ Finset.range (m + K), RudinRCA.Chapter15.blaschkeFactor (a n) z)
              atTop (𝓝 (P z)) :=
            hP_pt'.congr fun K ↦ by rw [add_comm]
          have hTm_pt : Tendsto
              (fun K : ℕ ↦ ∏ j ∈ Finset.range K, RudinRCA.Chapter15.blaschkeFactor (a (m + j)) z)
              atTop (𝓝 (T_m z)) :=
            hTm_loc.tendsto_at hz
          have hprod_lim : Tendsto
              (fun K : ℕ ↦ (∏ n ∈ Finset.range m, RudinRCA.Chapter15.blaschkeFactor (a n) z) *
                (∏ j ∈ Finset.range K, RudinRCA.Chapter15.blaschkeFactor (a (m + j)) z))
              atTop (𝓝 ((∏ n ∈ Finset.range m, RudinRCA.Chapter15.blaschkeFactor (a n) z) * T_m z)) :=
            tendsto_const_nhds.mul hTm_pt
          have hP_eq : P z =
              (∏ n ∈ Finset.range m, RudinRCA.Chapter15.blaschkeFactor (a n) z) * T_m z :=
            tendsto_nhds_unique hP_pt (hprod_lim.congr fun K ↦ (Finset.prod_range_add _ m K).symm)
          have hfin_eq : (∏ n ∈ Finset.range m, RudinRCA.Chapter15.blaschkeFactor (a n) z) =
              ∏ i : Fin m, RudinRCA.Chapter15.blaschkeFactor (a i.1) z :=
            (Fin.prod_univ_eq_prod_range
              (fun n ↦ RudinRCA.Chapter15.blaschkeFactor (a n) z) m).symm
          dsimp [B, B_m]
          rw [hP_eq, hfin_eq, mul_assoc]
        have hfac_m : ∀ z ∈ U, f z = B_m z * g_m z := by
          intro z hz
          have hf_eq : f z = B z * g z := hfac z hz
          rw [hf_eq, hB_split z hz]
          dsimp [g_m]
          ring
        have hgm_le_f : radialSizeENNReal p g_m r ≤ hardySizeENNReal p f :=
          radialSizeENNReal_le_hardy_of_finite_blaschke_mul p (fun i : Fin m ↦ ha i.1) rfl
            hf_hol hgm_hol hfac_m hr
        -- Bound `‖T_m z‖ ≥ t` on `sphere 0 r`
        have hTm_ge_t : ∀ ζ : FourierCircle, t ≤ ‖T_m ((r : ℂ) * circlePoint ζ)‖ := by
          intro ζ
          let z : ℂ := (r : ℂ) * circlePoint ζ
          have hz_U : z ∈ U := by
            simpa [z, U, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hr.1] using hr.2
          have hz_cb : z ∈ Metric.closedBall (0 : ℂ) r := by
            have := affine_circlePoint_mem_closedBall 0 hr.1 ζ
            simpa [z] using this
          have hz_cb1 : z ∈ Metric.closedBall (0 : ℂ) 1 :=
            Metric.ball_subset_closedBall hz_U
          have hTm_pt : Tendsto
              (fun K : ℕ ↦ ∏ j ∈ Finset.range K, RudinRCA.Chapter15.blaschkeFactor (a (m + j)) z)
              atTop (𝓝 (T_m z)) :=
            hTm_loc.tendsto_at hz_U
          have hnorm_tend : Tendsto
              (fun K : ℕ ↦ ‖1 - ∏ j ∈ Finset.range K, RudinRCA.Chapter15.blaschkeFactor (a (m + j)) z‖)
              atTop (𝓝 ‖1 - T_m z‖) :=
            (continuous_const.sub continuous_id).norm.tendsto _ |>.comp hTm_pt
          have hsum_tend : Tendsto
              (fun K : ℕ ↦ ∑ j ∈ Finset.range K, (2 / (1 - r)) * (1 - ‖a (m + j)‖))
              atTop (𝓝 ((2 / (1 - r)) * ∑' j : ℕ, (1 - ‖a (m + j)‖))) := by
            simpa only [Finset.mul_sum] using
              (hsum_shift.hasSum.tendsto_sum_nat.const_mul (2 / (1 - r)))
          have hle_tail : ‖1 - T_m z‖ ≤ (2 / (1 - r)) * ∑' j : ℕ, (1 - ‖a (m + j)‖) := by
            refine le_of_tendsto_of_tendsto hnorm_tend hsum_tend
              (Eventually.of_forall fun K ↦ ?_)
            calc ‖1 - ∏ j ∈ Finset.range K, RudinRCA.Chapter15.blaschkeFactor (a (m + j)) z‖
                ≤ ∑ j ∈ Finset.range K, ‖1 - RudinRCA.Chapter15.blaschkeFactor (a (m + j)) z‖ :=
                  norm_one_sub_prod_range_le K fun j _ ↦
                    RudinRCA.Chapter15.norm_blaschkeFactor_le_one (ha (m + j)).1 (ha (m + j)).2 hz_cb1
              _ ≤ ∑ j ∈ Finset.range K, (2 / (1 - r)) * (1 - ‖a (m + j)‖) :=
                  Finset.sum_le_sum fun j _ ↦
                    RudinRCA.Chapter15.norm_one_sub_blaschkeFactor_le
                      (ha (m + j)).1 (ha (m + j)).2 hr.1 hr.2 hz_cb
          have h1 : 1 - ‖T_m z‖ ≤ ‖1 - T_m z‖ := by
            simpa using norm_sub_norm_le (1 : ℂ) (T_m z)
          linarith
        have hpt_g : ∀ ζ : FourierCircle,
            ‖radialSlice g r ζ‖ ≤ t⁻¹ * ‖radialSlice g_m r ζ‖ := by
          intro ζ
          have hgm_eq : ‖radialSlice g_m r ζ‖ =
              ‖T_m ((r : ℂ) * circlePoint ζ)‖ * ‖radialSlice g r ζ‖ := by
            simp [radialSlice, g_m]
          have ht_le : t * ‖radialSlice g r ζ‖ ≤ ‖radialSlice g_m r ζ‖ := by
            rw [hgm_eq]
            exact mul_le_mul_of_nonneg_right (hTm_ge_t ζ) (norm_nonneg _)
          calc ‖radialSlice g r ζ‖
              = t⁻¹ * (t * ‖radialSlice g r ζ‖) := by rw [inv_mul_cancel_left₀ ht.1.ne']
            _ ≤ t⁻¹ * ‖radialSlice g_m r ζ‖ :=
                mul_le_mul_of_nonneg_left ht_le (inv_nonneg.mpr ht.1.le)
        calc radialSizeENNReal p g r
            ≤ ENNReal.ofReal (t⁻¹) * radialSizeENNReal p g_m r :=
              radialSizeENNReal_le_of_norm_le_mul p (one_le_inv₀ ht.1 |>.mpr ht.2.le)
                (continuous_radialSlice_of_holomorphicOn hg_hol hr.1 hr.2)
                (continuous_radialSlice_of_holomorphicOn hgm_hol hr.1 hr.2) hpt_g
          _ ≤ ENNReal.ofReal (t⁻¹) * hardySizeENNReal p f := by
              gcongr
      · refine iSup₂_le fun r hr ↦ ?_
        have hf_cont := continuous_radialSlice_of_holomorphicOn hf_hol hr.1 hr.2
        have hg_cont := continuous_radialSlice_of_holomorphicOn hg_hol hr.1 hr.2
        have hle1 : radialSizeENNReal p f r ≤ ENNReal.ofReal 1 * radialSizeENNReal p g r := by
          refine radialSizeENNReal_le_of_norm_le_mul p le_rfl hf_cont hg_cont fun ζ ↦ ?_
          have hz_ball : (r : ℂ) * circlePoint ζ ∈ U := by
            simpa [U, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hr.1] using hr.2
          have hf_eq : f ((r : ℂ) * circlePoint ζ) =
              B ((r : ℂ) * circlePoint ζ) * g ((r : ℂ) * circlePoint ζ) := hfac _ hz_ball
          dsimp only [radialSlice]
          rw [hf_eq, norm_mul, one_mul]
          exact mul_le_of_le_one_left (norm_nonneg _) (hPB_norm _ hz_ball).2
        rw [ENNReal.ofReal_one, one_mul] at hle1
        exact hle1.trans (le_biSup (radialSizeENNReal p g) hr)
    have hgN : IsInNevanlinnaClassCh17 g := ⟨hg_hol, by rw [hsize_eq 0]; exact hfN.2⟩
    refine ⟨B, g, hB_is, hgN, hg_nz, hfac, hsize_eq 0, fun p hp0 ↦ ⟨?_, hsize_eq p⟩⟩
    exact ⟨fun ⟨_, _, h⟩ ↦ ⟨hp0, hg_hol, (hsize_eq p).trans_lt h⟩,
      fun ⟨_, _, h⟩ ↦ ⟨hp0, hf_hol, (hsize_eq p).symm.trans_lt h⟩⟩

/-! ### 17.10: `H^p = B · h^{2/p}` Factorization (`0 < p < ∞`) and `H^1 = H^2 · H^2` -/

private theorem isSimplyConnected_unitDisc :
    IsSimplyConnected (Metric.ball (0 : ℂ) 1) := by
  let : ContractibleSpace (Metric.ball (0 : ℂ) 1) :=
    (convex_ball (0 : ℂ) 1).contractibleSpace ⟨0, Metric.mem_ball_self zero_lt_one⟩
  exact inferInstanceAs (SimplyConnectedSpace (Metric.ball (0 : ℂ) 1))

private theorem isBlaschkeProduct_holomorphic_and_norm_le_one {B : ℂ → ℂ}
    (hB : RudinRCA.Chapter15.IsBlaschkeProduct B) :
    HolomorphicOn B (Metric.ball (0 : ℂ) 1) ∧
      ∀ z ∈ Metric.ball (0 : ℂ) 1, ‖B z‖ ≤ 1 := by
  rcases hB with ⟨k, N, a, ha, hBeq⟩ | ⟨k, a, ha, hsum, hBeq⟩
  · have hfin := RudinRCA.Chapter15.finite_blaschke_product k N a ha
    refine ⟨(RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr
      (hfin.2.2.1.congr hBeq), fun z hz ↦ ?_⟩
    rw [hBeq z hz]
    exact hfin.2.2.2.1 z hz
  · have hinf := RudinRCA.Chapter15.theorem15_21 k ha hsum
    refine ⟨(RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr
      (hinf.2.2.2.2.1.congr hBeq), fun z hz ↦ ?_⟩
    rw [hBeq z hz]
    exact (hinf.2.2.2.2.2.1 z hz).2

/-- **Theorem 17.10** (Rudin, *Real and Complex Analysis*, 3rd ed., p. 339):
Suppose `0 < p < ∞` (`p ≠ 0`, `p ≠ ⊤`), `f ∈ H^p`, and `f` is not identically `0` on
`Metric.ball 0 1`. Then there exist a Blaschke product `B` with the exact zero set of `f` on
`Metric.ball 0 1`, a zero-free `h ∈ H^2`, and a holomorphic logarithm `L_h` of `h` on
`Metric.ball 0 1` (`exp (L_h z) = h z`) such that for the holomorphic branch
`h^{2/p}(z) = exp ((2 / p) * L_h z)` we have `f z = B z * exp ((2 / p) * L_h z)` on
`Metric.ball 0 1`, `hardySizeENNReal 2 h = (hardySizeENNReal p f) ^ (p / 2)`, and
`(hardySize 2 h) ^ 2 = (hardySize p f) ^ p`. -/
theorem theorem17_10 {p : ℝ≥0∞} {f : ℂ → ℂ} (hp0 : p ≠ 0) (hptop : p ≠ ⊤)
    (hf : IsInHardySpace p f) (hnonzero : ∃ z₀ ∈ Metric.ball (0 : ℂ) 1, f z₀ ≠ 0) :
    ∃ B h L_h : ℂ → ℂ,
      RudinRCA.Chapter15.IsBlaschkeProduct B ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, B z = 0 ↔ f z = 0) ∧
      IsInHardySpace 2 h ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, h z ≠ 0) ∧
      HolomorphicOn L_h (Metric.ball (0 : ℂ) 1) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, Complex.exp (L_h z) = h z) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1,
        f z = B z * Complex.exp (((2 / p.toReal : ℝ) : ℂ) * L_h z)) ∧
      hardySizeENNReal 2 h = (hardySizeENNReal p f) ^ (p.toReal / 2) ∧
      (hardySize 2 h) ^ 2 = (hardySize p f) ^ p.toReal := by
  let U : Set ℂ := Metric.ball (0 : ℂ) 1
  have hq_pos : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
  obtain ⟨B, g, hB_is, hgN, hg_nz, hfac, _, hp_equiv⟩ :=
    theorem17_9 hf.toNevanlinna hnonzero
  obtain ⟨hgp_iff, hsize_gf⟩ := hp_equiv p hp0
  have hg_hp : IsInHardySpace p g := hgp_iff.mp hf
  have hg_diff : DifferentiableOn ℂ g U :=
    (RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hgN.1
  obtain ⟨L, hL_diff, hL_exp⟩ :=
    RudinRCA.Chapter15.exists_holomorphic_log Metric.isOpen_ball isSimplyConnected_unitDisc
      hg_diff hg_nz
  let L_h : ℂ → ℂ := fun z ↦ ((p.toReal / 2 : ℝ) : ℂ) * L z
  let h : ℂ → ℂ := fun z ↦ Complex.exp (L_h z)
  have hLh_diff : DifferentiableOn ℂ L_h U := hL_diff.const_mul _
  have hLh_hol : HolomorphicOn L_h U :=
    (RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hLh_diff
  have hh_diff : DifferentiableOn ℂ h U := hLh_diff.cexp
  have hh_hol : HolomorphicOn h U :=
    (RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mpr hh_diff
  have hh_nz : ∀ z ∈ U, h z ≠ 0 := fun z _ ↦ Complex.exp_ne_zero _
  have hB_zeros : ∀ z ∈ U, B z = 0 ↔ f z = 0 := by
    intro z hz
    rw [hfac z hz, mul_eq_zero]
    exact ⟨Or.inl, fun h ↦ h.resolve_right (hg_nz z hz)⟩
  have hbranch : ∀ z ∈ U, Complex.exp (((2 / p.toReal : ℝ) : ℂ) * L_h z) = g z := by
    intro z hz
    dsimp [L_h]
    have hmul : ((2 / p.toReal : ℝ) : ℂ) * (((p.toReal / 2 : ℝ) : ℂ) * L z) = L z := by
      rw [← mul_assoc]
      have h1 : (2 / p.toReal) * (p.toReal / 2) = 1 := by field_simp [hq_pos.ne']
      have h1c : ((2 / p.toReal : ℝ) : ℂ) * ((p.toReal / 2 : ℝ) : ℂ) = 1 := by
        exact_mod_cast h1
      rw [h1c, one_mul]
    rw [hmul, hL_exp z hz]
  have hnorm_pow : ∀ z ∈ U, ‖h z‖ ^ (2 : ℝ) = ‖g z‖ ^ p.toReal := by
    intro z hz
    have hnorm_h : ‖h z‖ = Real.exp ((p.toReal / 2) * (L z).re) := by
      dsimp [h, L_h]
      rw [Complex.norm_exp]
      simp [Complex.mul_re]
    have hnorm_g : ‖g z‖ = Real.exp ((L z).re) := by
      rw [← hL_exp z hz, Complex.norm_exp]
    rw [hnorm_h, hnorm_g, ← Real.exp_mul, ← Real.exp_mul]
    congr 1
    ring
  have hrad_rel : ∀ r ∈ Set.Ico (0 : ℝ) 1,
      radialSizeENNReal 2 h r = (radialSizeENNReal p g r) ^ (p.toReal / 2) ∧
      radialSizeENNReal p g r = (radialSizeENNReal 2 h r) ^ (2 / p.toReal) := by
    intro r hr
    have hh_cont := continuous_radialSlice_of_holomorphicOn hh_hol hr.1 hr.2
    have hg_cont := continuous_radialSlice_of_holomorphicOn hgN.1 hr.1 hr.2
    have h2_ne0 : (2 : ℝ≥0∞) ≠ 0 := by norm_num
    have h2_netop : (2 : ℝ≥0∞) ≠ ⊤ := by norm_num
    have hpt_eq : ∀ ζ : FourierCircle,
        ‖radialSlice h r ζ‖ ^ (2 : ℝ) = ‖radialSlice g r ζ‖ ^ p.toReal := by
      intro ζ
      have hzU : (r : ℂ) * circlePoint ζ ∈ U := by
        simpa [U, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
          abs_of_nonneg hr.1] using hr.2
      exact hnorm_pow _ hzU
    let I : ℝ := ∫ ζ, ‖radialSlice g r ζ‖ ^ p.toReal ∂circleMeasure
    have hI_nn : 0 ≤ I := integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _
    have hint_h : ∫ ζ, ‖radialSlice h r ζ‖ ^ (2 : ℝ) ∂circleMeasure = I :=
      integral_congr_ae (Eventually.of_forall hpt_eq)
    have hrad_h : radialSizeENNReal 2 h r = ENNReal.ofReal (I ^ (2 : ℝ)⁻¹) := by
      unfold radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h0 ↦ (h2_ne0 h0).elim,
        (memLp_radialSlice_of_continuous hh_cont 2).eLpNorm_eq_integral_rpow_norm h2_ne0 h2_netop]
      simp only [ENNReal.toReal_ofNat]
      rw [hint_h]
    have hrad_g : radialSizeENNReal p g r = ENNReal.ofReal (I ^ p.toReal⁻¹) := by
      unfold radialSizeENNReal
      rw [ite_eq_right_iff.mpr fun h0 ↦ (hp0 h0).elim,
        (memLp_radialSlice_of_continuous hg_cont p).eLpNorm_eq_integral_rpow_norm hp0 hptop]
    rw [hrad_h, hrad_g]
    constructor
    · rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hI_nn _) (by positivity),
        ← Real.rpow_mul hI_nn]
      congr 2
      field_simp [hq_pos.ne']
    · rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hI_nn _) (by positivity),
        ← Real.rpow_mul hI_nn]
      congr 2
      field_simp [hq_pos.ne']
  have hhardy_enn : hardySizeENNReal 2 h = (hardySizeENNReal p f) ^ (p.toReal / 2) := by
    rw [← hsize_gf]
    refine le_antisymm ?_ ?_
    · refine iSup₂_le fun r hr ↦ ?_
      rw [(hrad_rel r hr).1]
      exact ENNReal.rpow_le_rpow (le_biSup (radialSizeENNReal p g) hr) (by positivity)
    · have hle_rev : hardySizeENNReal p g ≤ (hardySizeENNReal 2 h) ^ (2 / p.toReal) := by
        refine iSup₂_le fun r hr ↦ ?_
        rw [(hrad_rel r hr).2]
        exact ENNReal.rpow_le_rpow (le_biSup (radialSizeENNReal 2 h) hr) (by positivity)
      calc (hardySizeENNReal p g) ^ (p.toReal / 2)
          ≤ ((hardySizeENNReal 2 h) ^ (2 / p.toReal)) ^ (p.toReal / 2) :=
            ENNReal.rpow_le_rpow hle_rev (by positivity)
        _ = (hardySizeENNReal 2 h) ^ ((2 / p.toReal) * (p.toReal / 2)) :=
            (ENNReal.rpow_mul _ _ _).symm
        _ = hardySizeENNReal 2 h := by
            have h1 : (2 / p.toReal) * (p.toReal / 2) = 1 := by field_simp [hq_pos.ne']
            rw [h1, ENNReal.rpow_one]
  have hh_lt_top : hardySizeENNReal 2 h < ⊤ := by
    rw [hhardy_enn]
    exact ENNReal.rpow_lt_top_of_nonneg (by positivity) hf.2.2.ne
  have hh_h2 : IsInHardySpace 2 h := ⟨by norm_num, hh_hol, hh_lt_top⟩
  have hhardy_real : (hardySize 2 h) ^ 2 = (hardySize p f) ^ p.toReal := by
    unfold hardySize
    rw [hhardy_enn, ← ENNReal.toReal_rpow, ← Real.rpow_natCast _ 2,
      ← Real.rpow_mul ENNReal.toReal_nonneg]
    congr 1
    push_cast
    ring
  refine ⟨B, h, L_h, hB_is, hB_zeros, hh_h2, hh_nz, hLh_hol, fun _ _ ↦ rfl, ?_,
    hhardy_enn, hhardy_real⟩
  intro z hz
  rw [hfac z hz, hbranch z hz]

/-- **Corollary to Theorem 17.10 (`H^1 = H^2 · H^2`, Rudin p. 339)**:
Every `f ∈ H^1` is the product on `Metric.ball 0 1` of two functions `f₁, f₂ ∈ H^2` satisfying
`hardySize 2 f₁ * hardySize 2 f₂ = hardySize 1 f`. -/
theorem corollary17_10_h1_mul_h2 {f : ℂ → ℂ} (hf : IsInHardySpace 1 f) :
    ∃ f₁ f₂ : ℂ → ℂ,
      IsInHardySpace 2 f₁ ∧
      IsInHardySpace 2 f₂ ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1, f z = f₁ z * f₂ z) ∧
      hardySize 2 f₁ * hardySize 2 f₂ = hardySize 1 f := by
  let U : Set ℂ := Metric.ball (0 : ℂ) 1
  by_cases hnonzero : ∃ z₀ ∈ U, f z₀ ≠ 0
  · obtain ⟨B, h, L_h, hB_is, _, hh_h2, _, _, hLh_exp, hfac, _, hnorm_sq⟩ :=
      theorem17_10 one_ne_zero ENNReal.one_ne_top hf hnonzero
    simp only [ENNReal.toReal_one, Real.rpow_one] at hfac hnorm_sq
    obtain ⟨hB_hol, hB_le1⟩ := isBlaschkeProduct_holomorphic_and_norm_le_one hB_is
    let f₁ : ℂ → ℂ := fun z ↦ B z * h z
    let f₂ : ℂ → ℂ := h
    have hf₁_hol : HolomorphicOn f₁ U := fun z hz ↦ (hB_hol z hz).mul (hh_h2.2.1 z hz)
    have hf₁_le_h : hardySizeENNReal 2 f₁ ≤ hardySizeENNReal 2 h := by
      refine iSup₂_le fun r hr ↦ ?_
      have hf₁_cont := continuous_radialSlice_of_holomorphicOn hf₁_hol hr.1 hr.2
      have hh_cont := continuous_radialSlice_of_holomorphicOn hh_h2.2.1 hr.1 hr.2
      have hle : radialSizeENNReal 2 f₁ r ≤ ENNReal.ofReal 1 * radialSizeENNReal 2 h r := by
        refine radialSizeENNReal_le_of_norm_le_mul 2 le_rfl hf₁_cont hh_cont fun ζ ↦ ?_
        have hzU : (r : ℂ) * circlePoint ζ ∈ U := by
          simpa [U, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_nonneg hr.1] using hr.2
        dsimp [radialSlice, f₁]
        rw [norm_mul, one_mul]
        exact mul_le_of_le_one_left (norm_nonneg _) (hB_le1 _ hzU)
      rw [ENNReal.ofReal_one, one_mul] at hle
      exact hle.trans (le_biSup (radialSizeENNReal 2 h) hr)
    have hf₁_h2 : IsInHardySpace 2 f₁ :=
      ⟨by norm_num, hf₁_hol, hf₁_le_h.trans_lt hh_h2.2.2⟩
    have hf_prod : ∀ z ∈ U, f z = f₁ z * f₂ z := by
      intro z hz
      rw [hfac z hz]
      dsimp [f₁, f₂]
      have hexp2 : Complex.exp (((2 / 1 : ℝ) : ℂ) * L_h z) = h z * h z := by
        have h2 : (((2 / 1 : ℝ) : ℂ) * L_h z) = L_h z + L_h z := by push_cast; ring
        rw [h2, Complex.exp_add, hLh_exp z hz]
      rw [hexp2, mul_assoc]
    have hcs_hardy : hardySize 1 f ≤ hardySize 2 f₁ * hardySize 2 f₂ := by
      have hcs_enn : hardySizeENNReal 1 f ≤
          ENNReal.ofReal (hardySize 2 f₁ * hardySize 2 f₂) := by
        refine iSup₂_le fun r hr ↦ ?_
        have hf_cont := continuous_radialSlice_of_holomorphicOn hf.2.1 hr.1 hr.2
        have hf₁_cont := continuous_radialSlice_of_holomorphicOn hf₁_hol hr.1 hr.2
        have hf₂_cont := continuous_radialSlice_of_holomorphicOn hh_h2.2.1 hr.1 hr.2
        have hrad1 : radialSizeENNReal 1 f r =
            ENNReal.ofReal (∫ ζ, ‖radialSlice f r ζ‖ ∂circleMeasure) := by
          unfold radialSizeENNReal
          rw [ite_eq_right_iff.mpr fun h0 ↦ (one_ne_zero h0).elim,
            (memLp_radialSlice_of_continuous hf_cont 1).eLpNorm_eq_integral_rpow_norm
              one_ne_zero ENNReal.one_ne_top]
          simp
        have hpt_eq : ∀ ζ : FourierCircle,
            ‖radialSlice f r ζ‖ = ‖radialSlice f₁ r ζ‖ * ‖radialSlice f₂ r ζ‖ := by
          intro ζ
          have hzU : (r : ℂ) * circlePoint ζ ∈ U := by
            simpa [U, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg hr.1] using hr.2
          rw [radialSlice, hf_prod _ hzU, norm_mul]
          rfl
        have hholder := MeasureTheory.integral_mul_norm_le_Lp_mul_Lq
          Real.HolderConjugate.two_two
          (by simpa using memLp_radialSlice_of_continuous hf₁_cont 2)
          (by simpa using memLp_radialSlice_of_continuous hf₂_cont 2)
        have hrad2_1 : (∫ ζ, ‖radialSlice f₁ r ζ‖ ^ (2 : ℝ) ∂circleMeasure) ^ (1 / (2 : ℝ)) =
            radialSize 2 f₁ r := by
          unfold radialSize radialSizeENNReal
          have h2_ne0 : (2 : ℝ≥0∞) ≠ 0 := by norm_num
          have h2_netop : (2 : ℝ≥0∞) ≠ ⊤ := by norm_num
          rw [ite_eq_right_iff.mpr fun h0 ↦ (h2_ne0 h0).elim,
            (memLp_radialSlice_of_continuous hf₁_cont 2).eLpNorm_eq_integral_rpow_norm
              h2_ne0 h2_netop]
          simp only [ENNReal.toReal_ofNat, one_div]
          exact (ENNReal.toReal_ofReal
            (Real.rpow_nonneg (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _) _)).symm
        have hrad2_2 : (∫ ζ, ‖radialSlice f₂ r ζ‖ ^ (2 : ℝ) ∂circleMeasure) ^ (1 / (2 : ℝ)) =
            radialSize 2 f₂ r := by
          unfold radialSize radialSizeENNReal
          have h2_ne0 : (2 : ℝ≥0∞) ≠ 0 := by norm_num
          have h2_netop : (2 : ℝ≥0∞) ≠ ⊤ := by norm_num
          rw [ite_eq_right_iff.mpr fun h0 ↦ (h2_ne0 h0).elim,
            (memLp_radialSlice_of_continuous hf₂_cont 2).eLpNorm_eq_integral_rpow_norm
              h2_ne0 h2_netop]
          simp only [ENNReal.toReal_ofNat, one_div]
          exact (ENNReal.toReal_ofReal
            (Real.rpow_nonneg (integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _) _)).symm
        rw [hrad2_1, hrad2_2] at hholder
        have hint_le : ∫ ζ, ‖radialSlice f r ζ‖ ∂circleMeasure ≤
            hardySize 2 f₁ * hardySize 2 f₂ := by
          rw [integral_congr_ae (Eventually.of_forall hpt_eq)]
          exact hholder.trans (mul_le_mul
            (ENNReal.toReal_mono hf₁_h2.2.2.ne (le_biSup (radialSizeENNReal 2 f₁) hr))
            (ENNReal.toReal_mono hh_h2.2.2.ne (le_biSup (radialSizeENNReal 2 f₂) hr))
            ENNReal.toReal_nonneg ENNReal.toReal_nonneg)
        rw [hrad1]
        exact ENNReal.ofReal_le_ofReal hint_le
      have h := ENNReal.toReal_mono ENNReal.ofReal_ne_top hcs_enn
      have hnn : 0 ≤ hardySize 2 f₁ * hardySize 2 f₂ :=
        mul_nonneg (by unfold hardySize; exact ENNReal.toReal_nonneg)
          (by unfold hardySize; exact ENNReal.toReal_nonneg)
      rwa [ENNReal.toReal_ofReal hnn] at h
    have hf₁_real_le : hardySize 2 f₁ ≤ hardySize 2 f₂ :=
      ENNReal.toReal_mono hh_h2.2.2.ne hf₁_le_h
    have hprod_le : hardySize 2 f₁ * hardySize 2 f₂ ≤ hardySize 1 f := by
      calc hardySize 2 f₁ * hardySize 2 f₂
          ≤ hardySize 2 f₂ * hardySize 2 f₂ :=
            mul_le_mul_of_nonneg_right hf₁_real_le ENNReal.toReal_nonneg
        _ = (hardySize 2 h) ^ 2 := by dsimp [f₂]; ring
        _ = hardySize 1 f := hnorm_sq
    exact ⟨f₁, f₂, hf₁_h2, hh_h2, hf_prod, le_antisymm hprod_le hcs_hardy⟩
  · push Not at hnonzero
    let zf : ℂ → ℂ := fun _ ↦ 0
    have hzf_hol : HolomorphicOn zf U := fun _ _ ↦ differentiableAt_const 0
    have hzf_rad : ∀ r ∈ Set.Ico (0 : ℝ) 1, ∀ p : ℝ≥0∞, p ≠ 0 → radialSizeENNReal p zf r = 0 := by
      intro r _ p hp0
      have h0 : radialSlice zf r = 0 := rfl
      simp [radialSizeENNReal, hp0, h0]
    have hzf_hardy0 : ∀ p : ℝ≥0∞, p ≠ 0 → hardySizeENNReal p zf = 0 := by
      intro p hp0
      exact le_antisymm (iSup₂_le fun r hr ↦ (hzf_rad r hr p hp0).le) zero_le
    have hzf_h2 : IsInHardySpace 2 zf := by
      refine ⟨by norm_num, hzf_hol, ?_⟩
      rw [hzf_hardy0 2 (by norm_num)]
      exact ENNReal.zero_lt_top
    have hf_rad0 : ∀ r ∈ Set.Ico (0 : ℝ) 1, radialSizeENNReal 1 f r = 0 := by
      intro r hr
      have h0 : radialSlice f r = 0 := by
        funext ζ
        have hzU : (r : ℂ) * circlePoint ζ ∈ U := by
          simpa [U, Metric.mem_ball, norm_mul, Complex.norm_real, Real.norm_eq_abs,
            abs_of_nonneg hr.1] using hr.2
        exact hnonzero _ hzU
      simp [radialSizeENNReal, h0]
    have hf_hardy0 : hardySize 1 f = 0 := by
      unfold hardySize
      have h0 : hardySizeENNReal 1 f = 0 :=
        le_antisymm (iSup₂_le fun r hr ↦ (hf_rad0 r hr).le) zero_le
      rw [h0]
      simp
    have hzf_size0 : hardySize 2 zf = 0 := by
      unfold hardySize
      rw [hzf_hardy0 2 (by norm_num)]
      simp
    refine ⟨zf, zf, hzf_h2, hzf_h2, fun z hz ↦ by simp [zf, hnonzero z hz], ?_⟩
    rw [hzf_size0, hf_hardy0, mul_zero]

/-! ### 17.12: `H^2` Power Series Characterization & Riesz–Fischer Boundary Representation -/

private theorem poissonIntegral_circleMeasure_eq_interval
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (G : FourierCircle → E) {r : ℝ} (hr0 : 0 ≤ r) (θ : ℝ) :
    (∫ η, _root_.poissonKernel 0 ((r : ℂ) * Complex.exp ((θ : ℂ) * Complex.I)) (circlePoint η) • G η
        ∂circleMeasure) =
      (2 * Real.pi)⁻¹ • ∫ t in (-Real.pi)..Real.pi,
        RudinRCA.Chapter11.poissonKernel r (θ - t) • G (t : FourierCircle) := by
  rw [RudinRCA.Chapter04.circleIntegral_interval, one_div]
  congr 1
  refine intervalIntegral.integral_congr fun t _ ↦ ?_
  have hcm : circlePoint (t : FourierCircle) = circleMap 0 1 t := by
    simp [circleMap]
  rw [hcm, RudinRCA.Chapter11.poissonKernel_eq_mathlib hr0 θ t]

private theorem radialSize_two_sq_eq_integral {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) {r : ℝ} (hr0 : 0 ≤ r) (hr1 : r < 1) :
    (radialSize 2 f r) ^ 2 = ∫ ζ, ‖radialSlice f r ζ‖ ^ 2 ∂circleMeasure := by
  have hcont := continuous_radialSlice_of_holomorphicOn hf hr0 hr1
  have h2_ne0 : (2 : ℝ≥0∞) ≠ 0 := by norm_num
  have h2_netop : (2 : ℝ≥0∞) ≠ ⊤ := by norm_num
  have hnn : 0 ≤ ∫ ζ, ‖radialSlice f r ζ‖ ^ (2 : ℝ) ∂circleMeasure :=
    integral_nonneg fun _ ↦ Real.rpow_nonneg (norm_nonneg _) _
  unfold radialSize radialSizeENNReal
  rw [ite_eq_right_iff.mpr fun h ↦ (h2_ne0 h).elim,
    (memLp_radialSlice_of_continuous hcont 2).eLpNorm_eq_integral_rpow_norm h2_ne0 h2_netop]
  simp only [ENNReal.toReal_ofNat]
  rw [ENNReal.toReal_ofReal (Real.rpow_nonneg hnn _), ← Real.rpow_natCast _ 2,
    ← Real.rpow_mul hnn]
  norm_num

private theorem taylorSeries_hasSum_unitDisc {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    let a : ℕ → ℂ := fun n ↦ iteratedDeriv n f 0 / (Nat.factorial n : ℂ)
    ∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ a n * z ^ n) (f z) := by
  intro a z hz
  have hf_diff : DifferentiableOn ℂ f (Metric.ball (0 : ℂ) 1) :=
    (RudinRCA.Chapter10.holomorphicOn_iff_differentiableOn Metric.isOpen_ball).mp hf
  convert Complex.hasSum_taylorSeries_on_ball hf_diff hz using 2 with n
  simp only [a, sub_zero, smul_eq_mul, div_eq_mul_inv]
  ring

/-- Core `H^2` power-series and Riesz–Fischer boundary theory (used in both `17.12` and `17.11`). -/
private theorem h2_powerSeries_and_boundary {f : ℂ → ℂ}
    (hf : HolomorphicOn f (Metric.ball (0 : ℂ) 1)) :
    let a : ℕ → ℂ := fun n ↦ iteratedDeriv n f 0 / (Nat.factorial n : ℂ)
    (∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ a n * z ^ n) (f z)) ∧
    (IsInHardySpace 2 f ↔ Summable (fun n : ℕ ↦ ‖a n‖ ^ 2)) ∧
    (IsInHardySpace 2 f →
      (hardySize 2 f) ^ 2 = ∑' n : ℕ, ‖a n‖ ^ 2 ∧
      (∀ᵐ ζ ∂circleMeasure,
        (∀ θ₀ : ℝ, (θ₀ : FourierCircle) = ζ →
          ∀ {K : ℝ}, 0 ≤ K → ∀ {ι : Type} {l : Filter ι} (r θ : ι → ℝ),
            Tendsto r l (𝓝[<] 1) →
            (∀ᶠ j in l, |θ j - θ₀| ≤ K * (1 - r j)) →
            Tendsto (fun j ↦ f (((r j : ℝ) : ℂ) * Complex.exp (((θ j : ℝ) : ℂ) * Complex.I)))
              l (𝓝 (radialBoundaryLimit f ζ))) ∧
        Tendsto (fun r : ℝ ↦ radialSlice f r ζ) (𝓝[<] 1) (𝓝 (radialBoundaryLimit f ζ))) ∧
      MemLp (radialBoundaryLimit f) 2 circleMeasure ∧
      eLpNorm (radialBoundaryLimit f) 2 circleMeasure = hardySizeENNReal 2 f ∧
      Tendsto (fun r : ℝ ↦ eLpNorm (radialSlice f r - radialBoundaryLimit f) 2 circleMeasure)
        (𝓝[<] 1) (𝓝 0) ∧
      (∀ z ∈ Metric.ball (0 : ℂ) 1,
        f z = ∫ ζ, _root_.poissonKernel 0 z (circlePoint ζ) • radialBoundaryLimit f ζ
          ∂circleMeasure) ∧
      (∀ n : ℤ,
        ∫ ζ, radialBoundaryLimit f ζ * star (RudinRCA.Chapter04.trigMonomial n ζ) ∂circleMeasure =
          if 0 ≤ n then a n.toNat else 0)) := by
  intro a
  have ha_sum : ∀ z ∈ Metric.ball (0 : ℂ) 1, HasSum (fun n : ℕ ↦ a n * z ^ n) (f z) :=
    taylorSeries_hasSum_unitDisc hf
  have ha_disc : ∀ z ∈ RudinRCA.Chapter10.disc (0 : ℂ) 1,
      HasSum (fun n : ℕ ↦ a n * (z - 0) ^ n) (f z) := by
    intro z hz
    simpa only [sub_zero] using ha_sum z hz
  -- Parseval on circles `0 ≤ r < 1`
  have hparseval_r : ∀ r : ℝ, 0 ≤ r → r < 1 →
      HasSum (fun n : ℕ ↦ ‖a n‖ ^ 2 * r ^ (2 * n)) ((radialSize 2 f r) ^ 2) := by
    intro r hr0 hr1
    rw [radialSize_two_sq_eq_integral hf hr0 hr1]
    rcases hr0.eq_or_lt with rfl | hr_pos
    · have hf0 : f 0 = a 0 := by
        have h0 := ha_sum 0 (Metric.mem_ball_self zero_lt_one)
        have heq : (fun n : ℕ ↦ a n * (0 : ℂ) ^ n) =
            fun n : ℕ ↦ if n = 0 then a 0 else 0 := by
          funext n
          rcases Nat.eq_zero_or_pos n with rfl | hn
          · simp
          · simp [hn.ne']
        rw [heq] at h0
        exact h0.unique (hasSum_ite_eq 0 (a 0))
      have hint0 : ∫ ζ, ‖radialSlice f 0 ζ‖ ^ 2 ∂circleMeasure = ‖a 0‖ ^ 2 := by
        simp [radialSlice, hf0, Measure.real]
      rw [hint0]
      have heq2 : (fun n : ℕ ↦ ‖a n‖ ^ 2 * (0 : ℝ) ^ (2 * n)) =
          fun n : ℕ ↦ if n = 0 then ‖a 0‖ ^ 2 else 0 := by
        funext n
        rcases Nat.eq_zero_or_pos n with rfl | hn
        · simp
        · have h2n : 2 * n ≠ 0 := by omega
          simp [hn.ne', zero_pow h2n]
      rw [heq2]
      exact hasSum_ite_eq 0 (‖a 0‖ ^ 2)
    · have hp := (RudinRCA.Chapter10.theorem10_22 hr_pos hr1 ha_disc).1
      have hca : (∫ ζ, ‖radialSlice f r ζ‖ ^ 2 ∂circleMeasure) =
          (2 * Real.pi)⁻¹ * ∫ θ in (0 : ℝ)..2 * Real.pi, ‖f (circleMap 0 r θ)‖ ^ 2 := by
        have h0add : (fun ζ : FourierCircle ↦ ‖radialSlice f r ζ‖ ^ 2) =
            fun ζ : FourierCircle ↦ (fun z : ℂ ↦ ‖f z‖ ^ 2) (0 + (r : ℂ) * circlePoint ζ) := by
          funext ζ; simp [radialSlice]
        rw [h0add, integral_circleMeasure_eq_circleAverage (fun z : ℂ ↦ ‖f z‖ ^ 2) 0 r,
          Real.circleAverage_def, smul_eq_mul]
      rwa [hca]
  -- Bound `hardySizeENNReal 2 f` from `Summable (fun n ↦ ‖a n‖ ^ 2)` and vice versa
  have hbound_from_sum : Summable (fun n : ℕ ↦ ‖a n‖ ^ 2) →
      hardySizeENNReal 2 f ≤ ENNReal.ofReal (Real.sqrt (∑' n : ℕ, ‖a n‖ ^ 2)) := by
    intro hsum
    refine iSup₂_le fun r hr ↦ ?_
    have hsq_le : (radialSize 2 f r) ^ 2 ≤ ∑' n : ℕ, ‖a n‖ ^ 2 := by
      rw [← (hparseval_r r hr.1 hr.2).tsum_eq]
      refine (hparseval_r r hr.1 hr.2).summable.tsum_mono hsum fun n ↦ ?_
      exact mul_le_of_le_one_right (sq_nonneg _) (pow_le_one₀ hr.1 hr.2.le)
    have hrad_nn : 0 ≤ radialSize 2 f r := by
      unfold radialSize; exact ENNReal.toReal_nonneg
    have hrad_le : radialSize 2 f r ≤ Real.sqrt (∑' n : ℕ, ‖a n‖ ^ 2) := by
      rw [← Real.sqrt_sq hrad_nn]
      exact Real.sqrt_le_sqrt hsq_le
    have hcont := continuous_radialSlice_of_holomorphicOn hf hr.1 hr.2
    have hfin : radialSizeENNReal 2 f r ≠ ⊤ := by
      unfold radialSizeENNReal
      simp [(memLp_radialSlice_of_continuous hcont 2).eLpNorm_lt_top.ne]
    rw [← ENNReal.ofReal_toReal hfin]
    exact ENNReal.ofReal_le_ofReal hrad_le
  have hsum_from_h2 : IsInHardySpace 2 f →
      Summable (fun n : ℕ ↦ ‖a n‖ ^ 2) ∧ (∑' n : ℕ, ‖a n‖ ^ 2) ≤ (hardySize 2 f) ^ 2 := by
    intro h2f
    have hpart : ∀ N : ℕ, ∑ n ∈ Finset.range N, ‖a n‖ ^ 2 ≤ (hardySize 2 f) ^ 2 := by
      intro N
      let r_seq : ℕ → ℝ := fun k ↦ 1 - 1 / ((k : ℝ) + 2)
      have hr_Ico : ∀ k : ℕ, r_seq k ∈ Set.Ico (0 : ℝ) 1 := fun k ↦ by
        dsimp [r_seq]
        have hk : (1 : ℝ) < (k : ℝ) + 2 := by linarith [Nat.cast_nonneg (α := ℝ) k]
        refine ⟨?_, ?_⟩
        · linarith [div_lt_one (by positivity : (0 : ℝ) < (k : ℝ) + 2) |>.mpr hk]
        · linarith [div_pos zero_lt_one (by positivity : (0 : ℝ) < (k : ℝ) + 2)]
      have hr_tend : Tendsto r_seq atTop (𝓝 1) := by
        have hdiv : Tendsto (fun k : ℕ ↦ (1 : ℝ) / ((k : ℝ) + 2)) atTop (𝓝 0) :=
          tendsto_const_nhds.div_atTop
            ((tendsto_natCast_atTop_atTop (R := ℝ)).atTop_add tendsto_const_nhds)
        simpa [r_seq] using (tendsto_const_nhds (x := (1 : ℝ))).sub hdiv
      have hle_k : ∀ k : ℕ,
          ∑ n ∈ Finset.range N, ‖a n‖ ^ 2 * (r_seq k) ^ (2 * n) ≤ (hardySize 2 f) ^ 2 := by
        intro k
        have h1 : ∑ n ∈ Finset.range N, ‖a n‖ ^ 2 * (r_seq k) ^ (2 * n) ≤
            (radialSize 2 f (r_seq k)) ^ 2 :=
          sum_le_hasSum (Finset.range N)
            (fun n _ ↦ mul_nonneg (sq_nonneg _) (pow_nonneg (hr_Ico k).1 _))
            (hparseval_r (r_seq k) (hr_Ico k).1 (hr_Ico k).2)
        have hrad_le : radialSize 2 f (r_seq k) ≤ hardySize 2 f :=
          ENNReal.toReal_mono h2f.2.2.ne (le_biSup (radialSizeENNReal 2 f) (hr_Ico k))
        exact h1.trans (pow_le_pow_left₀ ENNReal.toReal_nonneg hrad_le 2)
      have htend_N : Tendsto (fun k : ℕ ↦ ∑ n ∈ Finset.range N, ‖a n‖ ^ 2 * (r_seq k) ^ (2 * n))
          atTop (𝓝 (∑ n ∈ Finset.range N, ‖a n‖ ^ 2)) := by
        have h := tendsto_finsetSum (Finset.range N) fun n _ ↦
          (tendsto_const_nhds (x := ‖a n‖ ^ 2)).mul (hr_tend.pow (2 * n))
        simpa only [one_pow, mul_one] using h
      exact le_of_tendsto htend_N (Eventually.of_forall hle_k)
    have hsum : Summable (fun n : ℕ ↦ ‖a n‖ ^ 2) :=
      summable_of_sum_range_le (fun _ ↦ sq_nonneg _) hpart
    exact ⟨hsum, hsum.tsum_le_of_sum_range_le hpart⟩
  have hiff : IsInHardySpace 2 f ↔ Summable (fun n : ℕ ↦ ‖a n‖ ^ 2) := by
    refine ⟨fun h ↦ (hsum_from_h2 h).1, fun hsum ↦ ⟨by norm_num, hf, ?_⟩⟩
    exact (hbound_from_sum hsum).trans_lt ENNReal.ofReal_lt_top
  refine ⟨ha_sum, hiff, fun h2f ↦ ?_⟩
  obtain ⟨ha_l2, htsum_le⟩ := hsum_from_h2 h2f
  have hsum_nn : 0 ≤ ∑' n : ℕ, ‖a n‖ ^ 2 := tsum_nonneg fun _ ↦ sq_nonneg _
