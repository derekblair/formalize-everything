    have hrad_seq_tend : Tendsto (fun n : ℕ ↦ radialSizeENNReal p f (r_seq n)) atTop
        (𝓝 (eLpNorm (radialBoundaryLimit f) p circleMeasure)) := by
      have h1 : Tendsto
          (fun n : ℕ ↦ ENNReal.ofReal
            ((∫ ζ, ‖radialSlice f (r_seq n) ζ‖ ^ p_real ∂circleMeasure) ^ p_real⁻¹))
          atTop
          (𝓝 (ENNReal.ofReal
            ((∫ ζ, ‖radialBoundaryLimit f ζ‖ ^ p_real ∂circleMeasure) ^ p_real⁻¹))) := by
        have hpos_inv : 0 < p_real⁻¹ := inv_pos.mpr hp_pos
        have h2 := (Real.continuous_rpow_const hpos_inv.le).continuousAt.tendsto.comp hseq_int_lim
        simpa [Function.comp_def] using ENNReal.continuous_ofReal.continuousAt.tendsto.comp h2
      have hbd_eq_rpow : ENNReal.ofReal
          ((∫ ζ, ‖radialBoundaryLimit f ζ‖ ^ p_real ∂circleMeasure) ^ p_real⁻¹) =
          eLpNorm (radialBoundaryLimit f) p circleMeasure := by
        simpa only [p_real] using (hbd_memLp.eLpNorm_eq_integral_rpow_norm hp0 hptop).symm
      rw [hbd_eq_rpow] at h1
      refine h1.congr' (Eventually.of_forall fun n ↦ ?_)
      have hcont := continuous_radialSlice_of_holomorphicOn hf.2.1 (hr_Ioo n).1.le (hr_Ioo n).2
      unfold radialSizeENNReal
      dsimp only
      rw [ite_eq_right_iff.mpr fun h0 ↦ (hp0 h0).elim]
      simpa only [p_real] using
        ((memLp_radialSlice_of_continuous hcont p).eLpNorm_eq_integral_rpow_norm hp0 hptop).symm
    refine le_antisymm ?_ ?_
    · exact le_of_tendsto hrad_seq_tend (Eventually.of_forall fun n ↦
        le_biSup (radialSizeENNReal p f) (⟨(hr_Ioo n).1.le, (hr_Ioo n).2⟩ : r_seq n ∈ Set.Ico 0 1))
    · refine iSup₂_le fun r hr ↦ ?_
      have hev_ge : ∀ᶠ n in atTop, r ≤ r_seq n := by
        have hlim1 : Tendsto r_seq atTop (𝓝 1) := tendsto_nhdsWithin_iff.mp hr_lt1 |>.1
        filter_upwards [hlim1.eventually (Ioi_mem_nhds hr.2)] with n hn
        exact hn.le
      refine ge_of_tendsto hrad_seq_tend ?_
      filter_upwards [hev_ge] with n hrn
      exact radialSizeENNReal_mono hf.2.1 p hr.1 hrn (hr_Ioo n).2
  -- Step 3: Poisson and Cauchy boundary integral representations for `1 ≤ p`
  refine ⟨hmax_all, hae_nt_rad, hbd_memLp, hl_p_tendsto, heLp_eq_hardy, fun hp1 z hz ↦ ?_⟩
  have hf1 : IsInHardySpace 1 f := hf.mono_exponent one_ne_zero hp1
  have hbd_int : Integrable (radialBoundaryLimit f) circleMeasure := hbd_memLp.integrable hp1
  -- Obtain `L^1` radial convergence `∫ ζ, ‖radialSlice f R ζ - radialBoundaryLimit f ζ‖ → 0`
  have hL1_tendsto : Tendsto
      (fun R : ℝ ↦ ∫ ζ, ‖radialSlice f R ζ - radialBoundaryLimit f ζ‖ ∂circleMeasure)
      (𝓝[<] 1) (𝓝 0) := by
    have heLp1 : Tendsto
        (fun R : ℝ ↦ eLpNorm (radialSlice f R - radialBoundaryLimit f) 1 circleMeasure)
        (𝓝[<] 1) (𝓝 0) := by
      refine tendsto_of_tendsto_of_tendsto_of_le_of_le' tendsto_const_nhds hl_p_tendsto
        (Eventually.of_forall fun _ ↦ zero_le) ?_
      filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with R _
      exact eLpNorm_le_eLpNorm_of_exponent_le hp1
    have htoReal := (ENNReal.tendsto_toReal ENNReal.zero_ne_top).comp heLp1
    simp only [ENNReal.toReal_zero, Function.comp_def] at htoReal
    refine htoReal.congr' ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with R hR
    have hsub_int : Integrable (radialSlice f R - radialBoundaryLimit f) circleMeasure :=
      ((continuous_radialSlice_of_holomorphicOn hf.2.1 hR.1.le hR.2).integrable_of_hasCompactSupport
        (HasCompactSupport.of_compactSpace _)).sub hbd_int
    have hsub_memLp1 : MemLp (radialSlice f R - radialBoundaryLimit f) 1 circleMeasure :=
      memLp_one_iff_integrable.mpr hsub_int
    rw [hsub_memLp1.eLpNorm_eq_integral_rpow_norm one_ne_zero ENNReal.one_ne_top]
    simp [ENNReal.toReal_ofReal (integral_nonneg fun _ ↦ norm_nonneg _)]
  have hz_lt : ‖z‖ < 1 := by simpa [Metric.mem_ball] using hz
  let R₀ : ℝ := (‖z‖ + 1) / 2
  have hR₀_pos : 0 < R₀ := by dsimp [R₀]; linarith [norm_nonneg z]
  have hR₀_lt1 : R₀ < 1 := by dsimp [R₀]; linarith
  have hz_lt_R₀ : ‖z‖ < R₀ := by dsimp [R₀]; linarith
  -- Uniform convergence helper from compactness of `Icc R₀ 1 ×ˢ univ`
  have hunif_of_joint_cont : ∀ Ψ : ℝ × FourierCircle → ℂ,
      ContinuousOn Ψ (Set.Icc R₀ 1 ×ˢ Set.univ) →
      TendstoUniformly (fun R ζ ↦ Ψ (R, ζ)) (fun ζ ↦ Ψ (1, ζ)) (𝓝[<] 1) := by
    intro Ψ hΨ_cont
    have hcomp_prod : IsCompact (Set.Icc R₀ 1 ×ˢ (Set.univ : Set FourierCircle)) :=
      isCompact_Icc.prod isCompact_univ
    have huc := hcomp_prod.uniformContinuousOn_of_continuous hΨ_cont
    rw [Metric.uniformContinuousOn_iff] at huc
    rw [Metric.tendstoUniformly_iff]
    intro ε hε
    obtain ⟨δ, hδ_pos, hδ⟩ := huc ε hε
    filter_upwards [Ioo_mem_nhdsLT hR₀_lt1,
      (tendsto_id.mono_left nhdsWithin_le_nhds).eventually (Metric.ball_mem_nhds (1 : ℝ) hδ_pos)]
      with R hR_Ioo hR_δ ζ
    refine hδ (1, ζ) ⟨⟨hR₀_lt1.le, le_rfl⟩, mem_univ ζ⟩
      (R, ζ) ⟨⟨hR_Ioo.1.le, hR_Ioo.2.le⟩, mem_univ ζ⟩ ?_
    rw [Prod.dist_eq, dist_self, max_eq_left dist_nonneg, dist_comm]
    exact hR_δ
  -- Rescaled representation on `Ioo R₀ 1` for both Poisson and Cauchy
  have hrescaled_both : ∀ R ∈ Set.Ioo R₀ 1,
      f z = ∫ ζ, ((_root_.poissonKernel 0 (z / (R : ℂ)) (circlePoint ζ) : ℂ) *
          radialSlice f R ζ) ∂circleMeasure ∧
      f z = ∫ ζ, (1 - (z / (R : ℂ)) * star (circlePoint ζ))⁻¹ *
          radialSlice f R ζ ∂circleMeasure := by
    intro R hR
    have hR_pos : 0 < R := hR₀_pos.trans hR.1
    have hR_ne : (R : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hR_pos.ne'
    let g_R : ℂ → ℂ := fun w ↦ f ((R : ℂ) * w)
    have hρ_gt1 : 1 < 1 / R := (one_lt_div hR_pos).mpr hR.2
    have hg_R_hol_ρ : HolomorphicOn g_R (Metric.ball (0 : ℂ) (1 / R)) := by
      intro w hw
      have hw_lt : ‖(R : ℂ) * w‖ < 1 := by
        rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hR_pos]
        have hw' : ‖w‖ < 1 / R := by simpa [Metric.mem_ball] using hw
