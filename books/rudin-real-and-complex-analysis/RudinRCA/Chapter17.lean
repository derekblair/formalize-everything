      -- Show `Tendsto f (𝓝[stolzRegion α ζ] (circlePoint ζ))` exists for each `α ∈ (0, 1)`
      have hf_nt_exists : ∀ α : ℝ, 0 < α → α < 1 →
          ∃ L_lim : ℂ, Tendsto f (𝓝[stolzRegion α ζ] (circlePoint ζ)) (𝓝 L_lim) := by
        intro α hα0 hα1
        have hh_α := hh_nt α hα0 hα1
        have hev_ball : ∀ᶠ z in 𝓝[stolzRegion α ζ] (circlePoint ζ), h z ∈ Metric.ball w₀ δ :=
