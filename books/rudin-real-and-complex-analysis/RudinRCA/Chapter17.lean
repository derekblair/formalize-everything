        have hz₁_V : z₁ ∈ V := by
          refine ⟨radial_mem_stolzRegion hα0 hα1 hr₁_0 hr₁_1 ζ, ?_⟩
          rw [Metric.mem_ball, dist_eq_norm]
          have hsub : z₁ - circlePoint ζ = (((r₁ - 1 : ℝ) : ℂ)) * circlePoint ζ := by
            dsimp [z₁]; push_cast; ring
          rw [hsub, norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_circlePoint, mul_one,
            abs_of_neg (sub_neg.mpr hr₁_1)]
