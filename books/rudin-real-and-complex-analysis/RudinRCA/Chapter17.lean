    refine le_of_tendsto hrad.norm ?_
    filter_upwards [Ioo_mem_nhdsLT zero_lt_one] with r hr
    have hz_mem : (r : ℂ) * circlePoint ζ ∈ stolzRegion (1 / 2) ζ :=
