            (Real.continuous_rpow_const hpos_inv.le).continuousAt.tendsto.comp hint_lim0
        simpa [Function.comp_def] using ENNReal.continuous_ofReal.continuousAt.tendsto.comp h1
      refine hrpow_lim.congr' (Eventually.of_forall fun k ↦ ?_)
      have hsub_memLp : MemLp (radialSlice f (ρ' k) - radialBoundaryLimit f) p circleMeasure :=
        (memLp_radialSlice_of_continuous
          (continuous_radialSlice_of_holomorphicOn hf.2.1 (hρ'_Ioo k).1.le (hρ'_Ioo k).2) p).sub
          hbd_memLp
      simpa only [p_real, g_diff, Pi.sub_apply] using
        (hsub_memLp.eLpNorm_eq_integral_rpow_norm hp0 hptop).symm
    exact (tendsto_add_atTop_iff_nat N₀).mp heLp_shift
  -- Norm equality `eLpNorm (radialBoundaryLimit f) p circleMeasure = hardySizeENNReal p f`
  have heLp_eq_hardy : eLpNorm (radialBoundaryLimit f) p circleMeasure = hardySizeENNReal p f := by
    have hM_rpow_int : Integrable (fun ζ ↦ ‖M_dom ζ‖ ^ p_real) circleMeasure :=
      hN_half_memLp.integrable_norm_rpow hp0 hptop
    have hseq_int_lim : Tendsto
        (fun n : ℕ ↦ ∫ ζ, ‖radialSlice f (r_seq n) ζ‖ ^ p_real ∂circleMeasure) atTop
        (𝓝 (∫ ζ, ‖radialBoundaryLimit f ζ‖ ^ p_real ∂circleMeasure)) := by
      refine tendsto_integral_of_dominated_convergence (fun ζ ↦ ‖M_dom ζ‖ ^ p_real)
        (fun n ↦ (Real.continuous_rpow_const hp_pos.le).comp_aestronglyMeasurable
          (continuous_radialSlice_of_holomorphicOn hf.2.1
            (hr_Ioo n).1.le (hr_Ioo n).2).norm.aestronglyMeasurable)
        hM_rpow_int
        (fun n ↦ by
          filter_upwards [hrad_le_M (r_seq n) ⟨(hr_Ioo n).1.le, (hr_Ioo n).2⟩] with ζ h1
          rw [Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
            Real.norm_of_nonneg (hM_dom_nn ζ)]
          exact Real.rpow_le_rpow (norm_nonneg _) h1 hp_pos.le)
        (by
          filter_upwards [hae_nt_rad] with ζ ⟨_, hrad⟩
          exact (Real.continuous_rpow_const hp_pos.le).continuousAt.tendsto.comp
