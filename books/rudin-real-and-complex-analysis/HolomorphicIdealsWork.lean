import RudinRCA.Chapter15

noncomputable section
open Finset Set

namespace RudinRCA.Chapter15

/-- Definition 15.14. Equality is asserted on Ω, so different extensions outside
Ω represent the same holomorphic function on the domain. -/
def InGeneratedHolomorphicIdeal {ι : Type*} [Fintype ι]
    (Ω : Set ℂ) (g : ι → ℂ → ℂ) (f : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ f Ω ∧ ∃ h : ι → ℂ → ℂ,
    (∀ i, DifferentiableOn ℂ (h i) Ω) ∧ ∀ z ∈ Ω, f z = ∑ i, h i z * g i z

/-- Membership in the principal holomorphic ideal generated by g (15.14). -/
def InPrincipalHolomorphicIdeal (Ω : Set ℂ) (g f : ℂ → ℂ) : Prop :=
  DifferentiableOn ℂ f Ω ∧ ∃ h : ℂ → ℂ,
    DifferentiableOn ℂ h Ω ∧ ∀ z ∈ Ω, f z = h z * g z

/-- The principal-ideal property for a finitely generated ideal. The existence
assertion for arbitrary holomorphic generators is the separate Theorem 15.15. -/
def GeneratedHolomorphicIdealIsPrincipal {ι : Type*} [Fintype ι]
    (Ω : Set ℂ) (g : ι → ℂ → ℂ) : Prop :=
  ∃ q : ℂ → ℂ, DifferentiableOn ℂ q Ω ∧ ∀ f : ℂ → ℂ,
    InGeneratedHolomorphicIdeal Ω g f ↔ InPrincipalHolomorphicIdeal Ω q f

/-- The multiplicity notation of 15.14, used at points where the analytic order
is finite; the printed notation does not assign a finite order to a locally
identically zero function. -/
def holomorphicZeroMultiplicity (f : ℂ → ℂ) (z : ℂ) : ℕ := analyticOrderNatAt f z

/-- The assertion [1] = H(Ω) in Definition 15.14. -/
theorem in_principal_ideal_one_iff {Ω : Set ℂ} {f : ℂ → ℂ} :
    InPrincipalHolomorphicIdeal Ω (fun _ ↦ 1) f ↔ DifferentiableOn ℂ f Ω := by
  constructor
  · exact And.left
  · intro hf
    exact ⟨hf, f, hf, fun z _ ↦ by simp⟩

/-- A single generator agrees with the definition of a principal ideal. -/
theorem in_generated_singleton_iff {Ω : Set ℂ} {g f : ℂ → ℂ} :
    InGeneratedHolomorphicIdeal Ω (fun _ : Fin 1 ↦ g) f ↔
      InPrincipalHolomorphicIdeal Ω g f := by
  constructor
  · rintro ⟨hf, h, hh, heq⟩
    exact ⟨hf, h 0, hh 0, fun z hz ↦ by simpa using heq z hz⟩
  · rintro ⟨hf, h, hh, heq⟩
    exact ⟨hf, (fun _ ↦ h), (fun _ ↦ hh), fun z hz ↦ by simpa using heq z hz⟩

/-- The stated zero-multiplicity convention at a nonzero value. -/
theorem holomorphicZeroMultiplicity_eq_zero {f : ℂ → ℂ} {z : ℂ}
    (hf : AnalyticAt ℂ f z) (hzero : f z ≠ 0) : holomorphicZeroMultiplicity f z = 0 := by
  simp [holomorphicZeroMultiplicity, analyticOrderNatAt, hf.analyticOrderAt_eq_zero.mpr hzero]

/-- At a point where the function is not locally zero, the natural multiplicity
recovers its full analytic order. -/
theorem holomorphicZeroMultiplicity_cast {f : ℂ → ℂ} {z : ℂ}
    (hfinite : analyticOrderAt f z ≠ ⊤) :
    (holomorphicZeroMultiplicity f z : ℕ∞) = analyticOrderAt f z :=
  Nat.cast_analyticOrderNatAt hfinite

#print axioms in_principal_ideal_one_iff
#print axioms in_generated_singleton_iff
#print axioms holomorphicZeroMultiplicity_eq_zero
#print axioms holomorphicZeroMultiplicity_cast

end RudinRCA.Chapter15
