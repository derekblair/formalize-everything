import Bech32.Checksum

/-!
# The field GF(1024) = GF(32)[z]/(z^2 + z + 1), pure Lean core

Milestone-2 infrastructure for the Bech32/Bech32m error-detection guarantee
(ticket #16; design: the Argon proof-strategy dossier, Route (c)).

`GF(32)` is `Word = BitVec 5` with multiplication modulo the BIP-173 polynomial
`x^5 + x^3 + 1` (binary `101001` = 41).  `GF(1024)` is `BitVec 10`: the low five
bits are the constant coefficient and the high five bits are the coefficient of
`z`, where `z^2 = z + 1` (since `z^2 + z + 1` is irreducible over `GF(32)`).

The multiplicative group of `GF(1024)` is cyclic of order
`1023 = 3 * 11 * 31`, generated by `gamma = 1 + 3z`.  The discrete-log and
exponential maps are *kernel-certified tables*: two packed `Nat` literals
(10 bits per entry) whose defining properties are proved by `decide` below —
no `native_decide`, no extra axioms.  The BIP-173 generator
`g(x) = x^6 + 29x^5 + 22x^4 + 20x^3 + 21x^2 + 29x + 18` over `GF(32)` splits
over `GF(1024)`; for the primitive root `zeta = gamma^457` its roots are
`zeta^24, zeta^25, zeta^26` (and Frobenius conjugates), which is why the
designed BCH distance is 4, not 5 (dossier Trap 1).
-/

namespace Bech32

/-! ## GF(32) arithmetic on `Word` -/

/-- Multiplication in `GF(2)[x]/(x^5 + x^3 + 1)`, as a `Nat` loop
    (shift-and-XOR, reducing by `41 = 0b101001`). -/
def gf32MulNat (a b : Nat) : Nat :=
  go 5 a b 0
where
  go : Nat → Nat → Nat → Nat → Nat
    | 0, _, _, r => r
    | n + 1, a, b, r =>
      go n (if 32 ≤ a * 2 then (a * 2) ^^^ 41 else a * 2) (b / 2)
        (if b % 2 = 1 then r ^^^ a else r)

/-- Multiplication of `GF(32)` elements (`Word = BitVec 5`). -/
def gf32Mul (a b : Word) : Word :=
  BitVec.ofNat 5 (gf32MulNat a.toNat b.toNat)

/-- Powers in `GF(32)`, for the inverse. -/
def gf32Pow (a : Word) : Nat → Word
  | 0 => 1
  | n + 1 => gf32Mul a (gf32Pow a n)

/-- Multiplicative inverse in `GF(32)` (`a^30`); `gf32Inv 0 = 0` by convention. -/
def gf32Inv (a : Word) : Word := gf32Pow a 30

/-! ## GF(32): certified field laws

The 32 768-case `decide`s for associativity and distributivity exceed the
kernel's `whnf` step budget, so those laws are transported from `Nat`-level
facts instead: a log/exp product formula for associativity (the generator is
`x = 2`; `GF(32)*` has prime order `31`, so every non-identity element
generates it), a five-step unrolling of the defining loop for
distributivity, and a power formula for the inverse. -/

/-- One shift-and-reduce step in `GF(32)`. -/
def xtimeNat (x : Nat) : Nat := if 32 ≤ x * 2 then (x * 2) ^^^ 41 else x * 2

/-- Moving an `ite` off an XOR accumulator. -/
theorem ite_acc (c : Prop) [Decidable c] (x A : Nat) :
    (if c then x ^^^ A else x) = x ^^^ (if c then A else 0) := by
  by_cases h : c <;> simp [h]

/-- The defining loop of `gf32MulNat`, unrolled: an XOR of five conditional
    multiples of `a`, gated on the bits of `b`. -/
theorem gf32MulNat_unroll (a b : Nat) :
    gf32MulNat a b =
      ((((0 ^^^ (if b % 2 = 1 then a else 0)) ^^^
          (if b / 2 % 2 = 1 then xtimeNat a else 0)) ^^^
          (if b / 2 / 2 % 2 = 1 then xtimeNat (xtimeNat a) else 0)) ^^^
          (if b / 2 / 2 / 2 % 2 = 1 then xtimeNat (xtimeNat (xtimeNat a))
            else 0)) ^^^
          (if b / 2 / 2 / 2 / 2 % 2 = 1 then
            xtimeNat (xtimeNat (xtimeNat (xtimeNat a))) else 0) := by
  simp only [gf32MulNat, gf32MulNat.go, xtimeNat, Nat.zero_xor]
  rw [ite_acc, ite_acc, ite_acc, ite_acc, ite_acc]

theorem gf32MulNat_lt : ∀ a b : Fin 32, gf32MulNat a.val b.val < 32 := by
  decide

theorem gf32MulNat_zero_left : ∀ a : Fin 32, gf32MulNat 0 a.val = 0 := by
  decide

theorem gf32MulNat_zero_right : ∀ a : Fin 32, gf32MulNat a.val 0 = 0 := by
  decide

theorem gf32MulNat_ne_zero : ∀ a b : Fin 32, a.val ≠ 0 → b.val ≠ 0 →
    gf32MulNat a.val b.val ≠ 0 := by
  decide

/-- The `BitVec` multiplication is the `Nat` loop, with no truncation. -/
theorem gf32Mul_toNat (a b : Word) :
    (gf32Mul a b).toNat = gf32MulNat a.toNat b.toNat := by
  simp only [gf32Mul, BitVec.toNat_ofNat]
  exact Nat.mod_eq_of_lt (gf32MulNat_lt ⟨a.toNat, a.isLt⟩ ⟨b.toNat, b.isLt⟩)

/-- Bit `m` of an XOR is the XOR of the bits: division form. -/
theorem xor_bit (b c : Nat) (m : Nat) :
    (b ^^^ c) / 2 ^ m % 2 = (b / 2 ^ m % 2) ^^^ (c / 2 ^ m % 2) := by
  rw [Nat.xor_div_two_pow, Nat.xor_mod_two_pow]

/-- Splitting a conditional multiple over an XOR of two bits. -/
theorem ite_xor_split (X Y T : Nat) (hX : X < 2) (hY : Y < 2) :
    (if X ^^^ Y = 1 then T else 0) =
      (if X = 1 then T else 0) ^^^ (if Y = 1 then T else 0) := by
  interval_cases X <;> interval_cases Y <;> simp

/-- Distributivity of `gf32MulNat` in its second argument, from the
    unrolled loop: bit `m` of `b ^^^ c` is the XOR of the bits, and a
    conditional multiple over an XOR of bits splits. -/
theorem gf32MulNat_xor_right (a b c : Nat) :
    gf32MulNat a (b ^^^ c) = gf32MulNat a b ^^^ gf32MulNat a c := by
  rw [gf32MulNat_unroll, gf32MulNat_unroll, gf32MulNat_unroll]
  have hd0 : (b ^^^ c) % 2 = (b % 2) ^^^ (c % 2) := xor_bit b c 0
  have hd1 : (b ^^^ c) / 2 % 2 = (b / 2 % 2) ^^^ (c / 2 % 2) := by
    have h := xor_bit b c 1
    simpa using h
  have hd2 : (b ^^^ c) / 2 / 2 % 2 =
      (b / 2 / 2 % 2) ^^^ (c / 2 / 2 % 2) := by
    rw [Nat.xor_div_two, Nat.xor_div_two]
    exact xor_bit (b / 2 / 2) (c / 2 / 2) 0
  have hd3 : (b ^^^ c) / 2 / 2 / 2 % 2 =
      (b / 2 / 2 / 2 % 2) ^^^ (c / 2 / 2 / 2 % 2) := by
    rw [Nat.xor_div_two, Nat.xor_div_two, Nat.xor_div_two]
    exact xor_bit (b / 2 / 2 / 2) (c / 2 / 2 / 2) 0
  have hd4 : (b ^^^ c) / 2 / 2 / 2 / 2 % 2 =
      (b / 2 / 2 / 2 / 2 % 2) ^^^ (c / 2 / 2 / 2 / 2 % 2) := by
    rw [Nat.xor_div_two, Nat.xor_div_two, Nat.xor_div_two, Nat.xor_div_two]
    exact xor_bit (b / 2 / 2 / 2 / 2) (c / 2 / 2 / 2 / 2) 0
  have hb0 : b % 2 < 2 := Nat.mod_lt _ (by decide)
  have hc0 : c % 2 < 2 := Nat.mod_lt _ (by decide)
  have hb1 : b / 2 % 2 < 2 := Nat.mod_lt _ (by decide)
  have hc1 : c / 2 % 2 < 2 := Nat.mod_lt _ (by decide)
  have hb2 : b / 2 / 2 % 2 < 2 := Nat.mod_lt _ (by decide)
  have hc2 : c / 2 / 2 % 2 < 2 := Nat.mod_lt _ (by decide)
  have hb3 : b / 2 / 2 / 2 % 2 < 2 := Nat.mod_lt _ (by decide)
  have hc3 : c / 2 / 2 / 2 % 2 < 2 := Nat.mod_lt _ (by decide)
  have hb4 : b / 2 / 2 / 2 / 2 % 2 < 2 := Nat.mod_lt _ (by decide)
  have hc4 : c / 2 / 2 / 2 / 2 % 2 < 2 := Nat.mod_lt _ (by decide)
  rw [hd0, hd1, hd2, hd3, hd4,
    ite_xor_split (b % 2) (c % 2) a hb0 hc0,
    ite_xor_split (b / 2 % 2) (c / 2 % 2) (xtimeNat a) hb1 hc1,
    ite_xor_split (b / 2 / 2 % 2) (c / 2 / 2 % 2)
      (xtimeNat (xtimeNat a)) hb2 hc2,
    ite_xor_split (b / 2 / 2 / 2 % 2) (c / 2 / 2 / 2 % 2)
      (xtimeNat (xtimeNat (xtimeNat a))) hb3 hc3,
    ite_xor_split (b / 2 / 2 / 2 / 2 % 2) (c / 2 / 2 / 2 / 2 % 2)
      (xtimeNat (xtimeNat (xtimeNat (xtimeNat a)))) hb4 hc4]
  simp only [Nat.xor_assoc, Nat.xor_comm, Nat.xor_left_comm]

/-- Powers at the `Nat` level. -/
def gf32PowNat (a : Nat) : Nat → Nat
  | 0 => 1
  | n + 1 => gf32MulNat a (gf32PowNat a n)

theorem gf32PowNat_lt (x : Nat) (hx : x < 32) : ∀ n : Nat,
    gf32PowNat x n < 32 := by
  intro n
  induction n with
  | zero => decide
  | succ n ih => exact gf32MulNat_lt ⟨x, hx⟩ ⟨_, ih⟩

theorem gf32Pow_toNat (a : Word) (n : Nat) :
    (gf32Pow a n).toNat = gf32PowNat a.toNat n := by
  induction n with
  | zero => rfl
  | succ n ih => simp only [gf32Pow, gf32PowNat, gf32Mul_toNat, ih]

/-- Discrete logarithm base `x = 2` in `GF(32)`, as a packed kernel-certified
    table (5 bits per entry; entry `v` at bits `5v .. 5v + 4`). -/
def gf32LogNat (v : Nat) : Nat :=
  (931001199420549403946829020058309183778805187584 >>> (5 * (v % 32))) % 32

/-- Exponential base `x = 2` in `GF(32)`. -/
def gf32ExpNat (k : Nat) : Nat := gf32PowNat 2 (k % 31)

theorem gf32ExpNat_mod (k : Nat) : gf32ExpNat k = gf32ExpNat (k % 31) := by
  simp only [gf32ExpNat, Nat.mod_mod]

theorem gf32ExpNat_lt (k : Nat) : gf32ExpNat k < 32 :=
  gf32PowNat_lt 2 (by decide) _

theorem gf32Exp_log : ∀ a : Fin 32, a.val ≠ 0 →
    gf32ExpNat (gf32LogNat a.val) = a.val := by
  decide

theorem gf32Log_exp_small : ∀ k : Fin 31,
    gf32LogNat (gf32ExpNat k.val) = k.val := by
  decide

theorem gf32Log_exp (k : Nat) : gf32LogNat (gf32ExpNat k) = k % 31 := by
  conv_lhs => rw [gf32ExpNat_mod k]
  exact gf32Log_exp_small ⟨k % 31, Nat.mod_lt _ (by decide)⟩

theorem gf32ExpNat_ne_zero : ∀ k : Nat, gf32ExpNat k ≠ 0 := by
  intro k
  have h : ∀ j : Fin 31, gf32ExpNat j.val ≠ 0 := by decide
  rw [gf32ExpNat_mod k]
  exact h ⟨k % 31, Nat.mod_lt _ (by decide)⟩

theorem gf32Log_mul : ∀ a b : Fin 32, a.val ≠ 0 → b.val ≠ 0 →
    gf32LogNat (gf32MulNat a.val b.val) =
      (gf32LogNat a.val + gf32LogNat b.val) % 31 := by
  decide

/-- The product formula in `GF(32)`: multiplication adds discrete logs. -/
theorem gf32MulNat_formula {x y : Nat} (hx : x < 32) (hy : y < 32)
    (hx0 : x ≠ 0) (hy0 : y ≠ 0) :
    gf32MulNat x y = gf32ExpNat (gf32LogNat x + gf32LogNat y) := by
  have hne : gf32MulNat x y ≠ 0 :=
    gf32MulNat_ne_zero ⟨x, hx⟩ ⟨y, hy⟩ hx0 hy0
  have h1 : gf32ExpNat (gf32LogNat (gf32MulNat x y)) = gf32MulNat x y :=
    gf32Exp_log ⟨gf32MulNat x y, gf32MulNat_lt ⟨x, hx⟩ ⟨y, hy⟩⟩ hne
  have h2 : gf32LogNat (gf32MulNat x y) =
      (gf32LogNat x + gf32LogNat y) % 31 :=
    gf32Log_mul ⟨x, hx⟩ ⟨y, hy⟩ hx0 hy0
  rw [← h1, h2]
  exact (gf32ExpNat_mod _).symm

/-- Associativity of `gf32MulNat`, via the product formula. -/
theorem gf32MulNat_assoc (x y z : Nat) (hx : x < 32) (hy : y < 32)
    (hz : z < 32) :
    gf32MulNat (gf32MulNat x y) z = gf32MulNat x (gf32MulNat y z) := by
  by_cases hx0 : x = 0
  · subst hx0
    rw [gf32MulNat_zero_left ⟨y, hy⟩, gf32MulNat_zero_left ⟨z, hz⟩]
  by_cases hy0 : y = 0
  · subst hy0
    rw [gf32MulNat_zero_right ⟨x, hx⟩, gf32MulNat_zero_left ⟨z, hz⟩,
      gf32MulNat_zero_right ⟨x, hx⟩]
  by_cases hz0 : z = 0
  · subst hz0
    rw [gf32MulNat_zero_right
        ⟨gf32MulNat x y, gf32MulNat_lt ⟨x, hx⟩ ⟨y, hy⟩⟩,
      gf32MulNat_zero_right ⟨y, hy⟩, gf32MulNat_zero_right ⟨x, hx⟩]
  have hxy : gf32MulNat x y ≠ 0 := gf32MulNat_ne_zero ⟨x, hx⟩ ⟨y, hy⟩ hx0 hy0
  have hyz : gf32MulNat y z ≠ 0 := gf32MulNat_ne_zero ⟨y, hy⟩ ⟨z, hz⟩ hy0 hz0
  have hxy32 : gf32MulNat x y < 32 := gf32MulNat_lt ⟨x, hx⟩ ⟨y, hy⟩
  have hyz32 : gf32MulNat y z < 32 := gf32MulNat_lt ⟨y, hy⟩ ⟨z, hz⟩
  rw [gf32MulNat_formula hxy32 hz hxy hz0, gf32MulNat_formula hx hyz32 hx0 hyz,
    gf32Log_mul ⟨x, hx⟩ ⟨y, hy⟩ hx0 hy0, gf32Log_mul ⟨y, hy⟩ ⟨z, hz⟩ hy0 hz0,
    gf32ExpNat_mod, gf32ExpNat_mod]
  congr 1
  omega

/-- Powers of a nonzero element are exponentials of multiples of its log. -/
theorem gf32PowNat_exp (x : Nat) (hx : x < 32) (hx0 : x ≠ 0) :
    ∀ n : Nat, gf32PowNat x n = gf32ExpNat (n * gf32LogNat x) := by
  intro n
  induction n with
  | zero => rfl
  | succ n ih =>
    have e1 : gf32PowNat x (n + 1) = gf32MulNat x (gf32PowNat x n) := by
      simp only [gf32PowNat]
    have e2 : (n + 1) * gf32LogNat x = n * gf32LogNat x + gf32LogNat x := by
      rw [Nat.mul_comm (n + 1) _, Nat.mul_succ, Nat.mul_comm]
    rw [e1, ih,
      gf32MulNat_formula hx (gf32ExpNat_lt _) hx0 (gf32ExpNat_ne_zero _),
      gf32Log_exp, e2, gf32ExpNat_mod, gf32ExpNat_mod]
    congr 1
    omega

/-- The `Nat`-level inverse identity: `a * a^30 = 1` for `a ≠ 0`. -/
theorem gf32MulNat_inv (a : Fin 32) (h0 : a.val ≠ 0) :
    gf32MulNat a.val (gf32PowNat a.val 30) = 1 := by
  have e1 : gf32MulNat a.val (gf32PowNat a.val 30) = gf32PowNat a.val 31 := by
    simp only [gf32PowNat]
  have e2 := gf32PowNat_exp a.val a.isLt h0 31
  have e3 : (31 * gf32LogNat a.val) % 31 = 0 := by omega
  have e4 : gf32ExpNat (31 * gf32LogNat a.val) = 1 := by
    rw [gf32ExpNat_mod, e3]
    rfl
  rw [e1, e2]
  exact e4

theorem gf32Mul_comm (a b : Word) : gf32Mul a b = gf32Mul b a := by
  exact (by decide : ∀ a b : Word, gf32Mul a b = gf32Mul b a) a b

theorem gf32Mul_assoc (a b c : Word) :
    gf32Mul (gf32Mul a b) c = gf32Mul a (gf32Mul b c) := by
  apply BitVec.eq_of_toNat_eq
  rw [gf32Mul_toNat, gf32Mul_toNat, gf32Mul_toNat, gf32Mul_toNat]
  exact gf32MulNat_assoc a.toNat b.toNat c.toNat a.isLt b.isLt c.isLt

theorem gf32Mul_xor_right (a b c : Word) :
    gf32Mul a (b ^^^ c) = gf32Mul a b ^^^ gf32Mul a c := by
  apply BitVec.eq_of_toNat_eq
  rw [gf32Mul_toNat, gf32Mul_toNat, gf32Mul_toNat, BitVec.toNat_xor,
    BitVec.toNat_xor]
  exact gf32MulNat_xor_right a.toNat b.toNat c.toNat

theorem gf32Mul_xor_left (a b c : Word) :
    gf32Mul (a ^^^ b) c = gf32Mul a c ^^^ gf32Mul b c := by
  rw [gf32Mul_comm (a ^^^ b) c, gf32Mul_xor_right, gf32Mul_comm c a,
    gf32Mul_comm c b]

theorem gf32Mul_one (a : Word) : gf32Mul a 1 = a := by
  exact (by decide : ∀ a : Word, gf32Mul a 1 = a) a

theorem gf32One_mul (a : Word) : gf32Mul 1 a = a := by
  rw [gf32Mul_comm]; exact gf32Mul_one a

theorem gf32Mul_zero (a : Word) : gf32Mul a 0 = 0 := by
  exact (by decide : ∀ a : Word, gf32Mul a 0 = 0) a

theorem gf32Zero_mul (a : Word) : gf32Mul 0 a = 0 := by
  rw [gf32Mul_comm]; exact gf32Mul_zero a

theorem gf32Mul_eq_zero {a b : Word} (h : gf32Mul a b = 0) : a = 0 ∨ b = 0 := by
  exact (by decide : ∀ a b : Word, gf32Mul a b = 0 → a = 0 ∨ b = 0) a b h

theorem gf32Mul_inv_cancel {a : Word} (h : a ≠ 0) : gf32Mul a (gf32Inv a) = 1 := by
  have ha0 : a.toNat ≠ 0 := fun hz => h (by
    apply BitVec.eq_of_toNat_eq
    rw [hz]
    exact BitVec.toNat_zero.symm)
  apply BitVec.eq_of_toNat_eq
  rw [gf32Mul_toNat]
  show gf32MulNat a.toNat (gf32Pow a 30).toNat = (1 : Word).toNat
  rw [gf32Pow_toNat]
  exact gf32MulNat_inv ⟨a.toNat, a.isLt⟩ ha0

theorem gf32Inv_mul_cancel {a : Word} (h : a ≠ 0) : gf32Mul (gf32Inv a) a = 1 := by
  rw [gf32Mul_comm]; exact gf32Mul_inv_cancel h

/-! ## GF(1024): elements, embedding, arithmetic -/

/-- Elements of `GF(1024)`: low five bits constant coefficient, high five `z`. -/
abbrev GF1024 := BitVec 10

/-- Constant coefficient of an element of `GF(1024)`. -/
def gf1024Lo (x : GF1024) : Word := x.extractLsb' 0 5

/-- `z`-coefficient of an element of `GF(1024)`. -/
def gf1024Hi (x : GF1024) : Word := x.extractLsb' 5 5

/-- Assemble an element of `GF(1024)` from its two `GF(32)` coefficients. -/
def gf1024Mk (a b : Word) : GF1024 := a.setWidth 10 ^^^ (b.setWidth 10 <<< 5)

theorem gf1024Lo_mk (a b : Word) : gf1024Lo (gf1024Mk a b) = a := by
  apply BitVec.eq_of_toNat_eq
  simp only [gf1024Lo, gf1024Mk, BitVec.extractLsb'_toNat, Nat.shiftRight_zero,
    BitVec.toNat_xor, BitVec.toNat_setWidth, BitVec.toNat_shiftLeft]
  have ha : a.toNat < 32 := a.isLt
  have hb : b.toNat < 1024 := by have h := b.isLt; omega
  omega

theorem gf1024Hi_mk (a b : Word) : gf1024Hi (gf1024Mk a b) = b := by
  apply BitVec.eq_of_toNat_eq
  simp only [gf1024Hi, gf1024Mk, BitVec.extractLsb'_toNat, BitVec.toNat_xor,
    BitVec.toNat_setWidth, BitVec.toNat_shiftLeft]
  have ha : a.toNat < 32 := a.isLt
  have hb : b.toNat < 32 := b.isLt
  omega

/-- Two elements of `GF(1024)` are equal iff both coefficients agree. -/
theorem gf1024_toNat_decomp (z : GF1024) :
    z.toNat = (gf1024Lo z).toNat + 32 * (gf1024Hi z).toNat := by
  have h1 : (gf1024Lo z).toNat = z.toNat % 32 := by
    simp [gf1024Lo, BitVec.extractLsb'_toNat]
  have h2 : (gf1024Hi z).toNat = (z.toNat >>> 5) % 32 := by
    simp [gf1024Hi, BitVec.extractLsb'_toNat]
  have hz : z.toNat < 1024 := z.isLt
  omega

theorem gf1024_ext {x y : GF1024} (hlo : gf1024Lo x = gf1024Lo y)
    (hhi : gf1024Hi x = gf1024Hi y) : x = y := by
  apply BitVec.eq_of_toNat_eq
  rw [gf1024_toNat_decomp, gf1024_toNat_decomp, hlo, hhi]

/-- The embedding of `GF(32)` into `GF(1024)` as constant polynomials. -/
def gf1024Emb (w : Word) : GF1024 := w.setWidth 10

theorem gf1024Lo_emb (w : Word) : gf1024Lo (gf1024Emb w) = w := by
  apply BitVec.eq_of_toNat_eq
  simp only [gf1024Lo, gf1024Emb, BitVec.extractLsb'_toNat, Nat.shiftRight_zero,
    BitVec.toNat_setWidth]
  have hw : w.toNat < 32 := w.isLt
  omega

theorem gf1024Hi_emb (w : Word) : gf1024Hi (gf1024Emb w) = 0 := by
  apply BitVec.eq_of_toNat_eq
  simp only [gf1024Hi, gf1024Emb, BitVec.extractLsb'_toNat, BitVec.toNat_setWidth,
    BitVec.toNat_zero]
  have hw : w.toNat < 32 := w.isLt
  omega

/-- Addition in `GF(1024)` is bitwise XOR. -/
def gf1024Add (x y : GF1024) : GF1024 := x ^^^ y

/-- Multiplication in `GF(1024) = GF(32)[z]/(z^2 + z + 1)`:
    `(a + bz)(c + dz) = (ac + bd) + (ad + bc + bd) z`. -/
def gf1024Mul (x y : GF1024) : GF1024 :=
  gf1024Mk (gf32Mul (gf1024Lo x) (gf1024Lo y) ^^^ gf32Mul (gf1024Hi x) (gf1024Hi y))
    (gf32Mul (gf1024Lo x) (gf1024Hi y) ^^^ gf32Mul (gf1024Hi x) (gf1024Lo y) ^^^
      gf32Mul (gf1024Hi x) (gf1024Hi y))

theorem gf1024Lo_add (x y : GF1024) : gf1024Lo (gf1024Add x y) = gf1024Lo x ^^^ gf1024Lo y := by
  apply BitVec.eq_of_toNat_eq
  simp only [gf1024Lo, gf1024Add, BitVec.extractLsb'_toNat, Nat.shiftRight_zero,
    BitVec.toNat_xor]
  have hx : x.toNat < 1024 := x.isLt
  have hy : y.toNat < 1024 := y.isLt
  omega

theorem gf1024Hi_add (x y : GF1024) : gf1024Hi (gf1024Add x y) = gf1024Hi x ^^^ gf1024Hi y := by
  apply BitVec.eq_of_toNat_eq
  simp only [gf1024Hi, gf1024Add, BitVec.extractLsb'_toNat, BitVec.toNat_xor]
  have hx : x.toNat < 1024 := x.isLt
  have hy : y.toNat < 1024 := y.isLt
  omega

theorem gf1024Lo_mul (x y : GF1024) :
    gf1024Lo (gf1024Mul x y) =
      gf32Mul (gf1024Lo x) (gf1024Lo y) ^^^ gf32Mul (gf1024Hi x) (gf1024Hi y) := by
  simp [gf1024Mul, gf1024Lo_mk]

theorem gf1024Hi_mul (x y : GF1024) :
    gf1024Hi (gf1024Mul x y) =
      gf32Mul (gf1024Lo x) (gf1024Hi y) ^^^ gf32Mul (gf1024Hi x) (gf1024Lo y) ^^^
        gf32Mul (gf1024Hi x) (gf1024Hi y) := by
  simp [gf1024Mul, gf1024Hi_mk]

theorem gf1024Add_comm (x y : GF1024) : gf1024Add x y = gf1024Add y x := by
  simp [gf1024Add, BitVec.xor_comm]

theorem gf1024Add_assoc (x y z : GF1024) :
    gf1024Add (gf1024Add x y) z = gf1024Add x (gf1024Add y z) := by
  simp [gf1024Add, BitVec.xor_assoc]

theorem gf1024Add_zero (x : GF1024) : gf1024Add x 0 = x := by
  simp [gf1024Add]

theorem gf1024Mul_comm (x y : GF1024) : gf1024Mul x y = gf1024Mul y x := by
  apply gf1024_ext
  · simp only [gf1024Lo_mul, gf32Mul_comm]
  · simp only [gf1024Hi_mul]
    rw [gf32Mul_comm (gf1024Lo y) (gf1024Hi x), gf32Mul_comm (gf1024Hi y) (gf1024Lo x),
      gf32Mul_comm (gf1024Hi y) (gf1024Hi x)]
    simp [BitVec.xor_comm, BitVec.xor_assoc]

theorem gf1024Lo_one : gf1024Lo 1 = 1 := by decide
theorem gf1024Hi_one : gf1024Hi 1 = 0 := by decide
theorem gf1024Lo_zero : gf1024Lo 0 = 0 := by decide
theorem gf1024Hi_zero : gf1024Hi 0 = 0 := by decide

theorem gf1024Mul_one (x : GF1024) : gf1024Mul x 1 = x := by
  apply gf1024_ext
  · simp [gf1024Lo_mul, gf1024Lo_one, gf1024Hi_one, gf32Mul_one, gf32Mul_zero]
  · simp [gf1024Hi_mul, gf1024Lo_one, gf1024Hi_one, gf32Mul_one, gf32Mul_zero]

theorem gf1024One_mul (x : GF1024) : gf1024Mul 1 x = x := by
  rw [gf1024Mul_comm]; exact gf1024Mul_one x

theorem gf1024Mul_zero (x : GF1024) : gf1024Mul x 0 = 0 := by
  apply gf1024_ext <;>
    simp [gf1024Lo_mul, gf1024Hi_mul, gf1024Lo_zero, gf1024Hi_zero, gf32Mul_zero,
      gf32Zero_mul]

theorem gf1024Zero_mul (x : GF1024) : gf1024Mul 0 x = 0 := by
  rw [gf1024Mul_comm]; exact gf1024Mul_zero x

theorem gf1024Mul_assoc (x y z : GF1024) :
    gf1024Mul (gf1024Mul x y) z = gf1024Mul x (gf1024Mul y z) := by
  apply gf1024_ext
  · simp only [gf1024Lo_mul, gf1024Hi_mul, gf32Mul_xor_left, gf32Mul_xor_right,
      gf32Mul_assoc]
    rw [gf32Mul_comm (gf1024Hi x) (gf32Mul (gf1024Lo y) (gf1024Hi z)),
      gf32Mul_comm (gf1024Hi x) (gf32Mul (gf1024Hi y) (gf1024Lo z))]
    simp only [BitVec.xor_assoc, BitVec.xor_comm, BitVec.xor_left_comm,
      BitVec.xor_self, BitVec.xor_zero, BitVec.zero_xor]
  · simp only [gf1024Lo_mul, gf1024Hi_mul, gf32Mul_xor_left, gf32Mul_xor_right,
      gf32Mul_assoc]
    rw [gf32Mul_comm (gf1024Hi x) (gf32Mul (gf1024Lo y) (gf1024Hi z)),
      gf32Mul_comm (gf1024Hi x) (gf32Mul (gf1024Hi y) (gf1024Lo z)),
      gf32Mul_comm (gf1024Hi x) (gf32Mul (gf1024Hi y) (gf1024Hi z))]
    simp only [BitVec.xor_assoc, BitVec.xor_comm, BitVec.xor_left_comm,
      BitVec.xor_self, BitVec.xor_zero, BitVec.zero_xor]

theorem gf1024Mul_add (x y z : GF1024) :
    gf1024Mul x (gf1024Add y z) = gf1024Add (gf1024Mul x y) (gf1024Mul x z) := by
  apply gf1024_ext
  · simp only [gf1024Lo_mul, gf1024Hi_mul, gf1024Lo_add, gf1024Hi_add,
      gf32Mul_xor_left, BitVec.xor_assoc, BitVec.xor_comm, BitVec.xor_left_comm,
      BitVec.xor_self, BitVec.xor_zero, BitVec.zero_xor]
  · simp only [gf1024Lo_mul, gf1024Hi_mul, gf1024Lo_add, gf1024Hi_add,
      gf32Mul_xor_left, BitVec.xor_assoc, BitVec.xor_comm, BitVec.xor_left_comm,
      BitVec.xor_self, BitVec.xor_zero, BitVec.zero_xor]

theorem gf1024Add_mul (x y z : GF1024) :
    gf1024Mul (gf1024Add x y) z = gf1024Add (gf1024Mul x z) (gf1024Mul y z) := by
  rw [gf1024Mul_comm (gf1024Add x y) z, gf1024Mul_comm x z, gf1024Mul_comm y z]
  exact gf1024Mul_add z x y

theorem gf1024Emb_mul (a b : Word) :
    gf1024Emb (gf32Mul a b) = gf1024Mul (gf1024Emb a) (gf1024Emb b) := by
  apply gf1024_ext
  · simp [gf1024Lo_mul, gf1024Lo_emb, gf1024Hi_emb, gf32Mul_zero]
  · simp [gf1024Hi_mul, gf1024Lo_emb, gf1024Hi_emb, gf32Mul_zero, gf32Zero_mul]

/-! ## Kernel-certified exponential / logarithm tables -/

/-- Packed exponential table: entry `k` (10 bits at offset `10 * k`) is
    `gamma^k`, where `gamma = 1 + 3z` generates `GF(1024)*`. -/
def gf1024ExpPacked : Nat :=


/-- Packed logarithm table: entry `a` (10 bits at offset `10 * a`) is the
    discrete log of `a : GF1024` base `gamma` (entry `0` is unused, set to 0). -/
def gf1024LogPacked : Nat :=


/-- The primitive generator `gamma = 1 + 3 * z` of `GF(1024)*`, order 1023. -/
def gf1024Gamma : GF1024 := 97

/-- `gf1024Exp k = gamma^k` (the exponent is read modulo 1023). -/
def gf1024Exp (k : Nat) : GF1024 :=
  BitVec.ofNat 10 ((gf1024ExpPacked >>> (10 * (k % 1023))) &&& 1023)

/-- Discrete logarithm base `gamma`; `gf1024Log 0 = 0` by convention. -/
def gf1024Log (a : GF1024) : Nat :=
  (gf1024LogPacked >>> (10 * a.toNat)) &&& 1023

theorem gf1024Exp_zero : gf1024Exp 0 = 1 := by decide

/-- `gf1024Exp` only depends on the exponent modulo 1023. -/
theorem gf1024Exp_congr {a b : Nat} (h : a % 1023 = b % 1023) :
    gf1024Exp a = gf1024Exp b := by
  unfold gf1024Exp
  rw [h]

theorem gf1024Log_exp (k : BitVec 10) (hk : k.toNat < 1023) :
    gf1024Log (gf1024Exp k.toNat) = k.toNat := by
  exact (by decide : ∀ k : BitVec 10, k.toNat < 1023 →
    gf1024Log (gf1024Exp k.toNat) = k.toNat) k hk

theorem gf1024Exp_log (a : GF1024) (ha : a ≠ 0) : gf1024Exp (gf1024Log a) = a := by
  exact (by decide : ∀ a : GF1024, a ≠ 0 → gf1024Exp (gf1024Log a) = a) a ha

theorem gf1024Exp_ne_zero (k : BitVec 10) (hk : k.toNat < 1023) :
    gf1024Exp k.toNat ≠ 0 := by
  exact (by decide : ∀ k : BitVec 10, k.toNat < 1023 →
    gf1024Exp k.toNat ≠ 0) k hk

theorem gf1024Log_le (a : GF1024) : gf1024Log a ≤ 1022 := by
  exact (by decide : ∀ a : GF1024, gf1024Log a ≤ 1022) a

/-- One step of the certified table: multiplying by `gamma` advances the
    exponent by one (cyclically). -/
theorem gf1024Exp_step (k : BitVec 10) (hk : k.toNat < 1023) :
    gf1024Exp (k.toNat + 1) = gf1024Mul gf1024Gamma (gf1024Exp k.toNat) := by
  exact (by decide : ∀ k : BitVec 10, k.toNat < 1023 →
    gf1024Exp (k.toNat + 1) = gf1024Mul gf1024Gamma (gf1024Exp k.toNat)) k hk

theorem gf1024Exp_step_all (n : Nat) :
    gf1024Exp (n + 1) = gf1024Mul gf1024Gamma (gf1024Exp n) := by
  have hk : n % 1023 < 1023 := Nat.mod_lt _ (by decide)
  have h1 : gf1024Exp n = gf1024Exp (n % 1023) :=
    gf1024Exp_congr (Nat.mod_mod n 1023).symm
  have h2 : gf1024Exp (n + 1) = gf1024Exp (n % 1023 + 1) :=
    gf1024Exp_congr (by omega)
  rw [h2, h1]
  have hstep := gf1024Exp_step (BitVec.ofNat 10 (n % 1023)) (by
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega : n % 1023 < 1024)]
    exact hk)
  rwa [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega : n % 1023 < 1024)] at hstep

theorem gf1024Exp_add (i j : Nat) :
    gf1024Exp (i + j) = gf1024Mul (gf1024Exp i) (gf1024Exp j) := by
  induction j with
  | zero => simp [gf1024Exp_zero, gf1024Mul_one]
  | succ j ih =>
    have e1 : i + (j + 1) = (i + j) + 1 := by omega
    rw [e1, gf1024Exp_step_all, ih, gf1024Exp_step_all j,
      ← gf1024Mul_assoc, gf1024Mul_comm gf1024Gamma (gf1024Exp i),
      gf1024Mul_assoc]

theorem gf1024Log_exp_nat (n : Nat) : gf1024Log (gf1024Exp n) = n % 1023 := by
  have hk : n % 1023 < 1023 := Nat.mod_lt _ (by decide)
  have h : gf1024Exp n = gf1024Exp (n % 1023) :=
    gf1024Exp_congr (Nat.mod_mod n 1023).symm
  rw [h]
  have hlog := gf1024Log_exp (BitVec.ofNat 10 (n % 1023)) (by
    rw [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega : n % 1023 < 1024)]
    exact hk)
  rwa [BitVec.toNat_ofNat, Nat.mod_eq_of_lt (by omega : n % 1023 < 1024)] at hlog

theorem gf1024Mul_ne_zero {a b : GF1024} (ha : a ≠ 0) (hb : b ≠ 0) :
    gf1024Mul a b ≠ 0 := by
  intro h
  have h1 : gf1024Exp (gf1024Log a + gf1024Log b) = 0 := by
    rw [gf1024Exp_add, gf1024Exp_log a ha, gf1024Exp_log b hb]
    exact h
  have h2 : gf1024Exp (gf1024Log a + gf1024Log b) ≠ 0 := by
    have hne := gf1024Exp_ne_zero (BitVec.ofNat 10
      ((gf1024Log a + gf1024Log b) % 1023)) (by
        rw [BitVec.toNat_ofNat,
          Nat.mod_eq_of_lt (by omega : (gf1024Log a + gf1024Log b) % 1023 < 1024)]
        exact Nat.mod_lt _ (by decide))
    rw [BitVec.toNat_ofNat,
      Nat.mod_eq_of_lt (by omega : (gf1024Log a + gf1024Log b) % 1023 < 1024)] at hne
    rwa [gf1024Exp_congr (Nat.mod_mod _ 1023)] at hne
  exact h2 h1

/-- The logarithm is a homomorphism on nonzero elements. -/
theorem gf1024Log_mul {a b : GF1024} (ha : a ≠ 0) (hb : b ≠ 0) :
    gf1024Log (gf1024Mul a b) = (gf1024Log a + gf1024Log b) % 1023 := by
  have h1 : gf1024Exp (gf1024Log (gf1024Mul a b)) = gf1024Mul a b :=
    gf1024Exp_log _ (gf1024Mul_ne_zero ha hb)
  have h2 : gf1024Exp (gf1024Log a + gf1024Log b) = gf1024Mul a b := by
    rw [gf1024Exp_add, gf1024Exp_log a ha, gf1024Exp_log b hb]
  have h3 : gf1024Exp (gf1024Log (gf1024Mul a b)) =
      gf1024Exp (gf1024Log a + gf1024Log b) := h1.trans h2
  have h4 := congrArg gf1024Log h3
  rw [gf1024Log_exp_nat, gf1024Log_exp_nat] at h4
  have hle : gf1024Log (gf1024Mul a b) ≤ 1022 := gf1024Log_le _
  omega

/-- `GF(32)*` membership in `GF(1024)`: a nonzero element is a constant
    polynomial iff its discrete log is a multiple of `33 = 1023 / 31`
    (the index of `GF(32)*` in `GF(1024)*`). -/
theorem gf1024Log_mod_33 (a : GF1024) (ha : a ≠ 0) :
    gf1024Hi a = 0 ↔ gf1024Log a % 33 = 0 := by
  exact (by decide : ∀ a : GF1024, a ≠ 0 →
    (gf1024Hi a = 0 ↔ gf1024Log a % 33 = 0)) a ha

/-- The multiplicative inverse in `GF(1024)`, from the certified tables. -/
def gf1024Inv (a : GF1024) : GF1024 :=
  if a = 0 then 0 else gf1024Exp (1023 - gf1024Log a)

theorem gf1024Mul_inv_cancel {a : GF1024} (ha : a ≠ 0) :
    gf1024Mul a (gf1024Inv a) = 1 := by
  have hlog : gf1024Log a ≤ 1022 := gf1024Log_le a
  have h1 : gf1024Inv a = gf1024Exp (1023 - gf1024Log a) := by
    unfold gf1024Inv
    rw [if_neg ha]
  rw [h1]
  nth_rewrite 1 [← gf1024Exp_log a ha]
  rw [← gf1024Exp_add]
  have hsum : gf1024Log a + (1023 - gf1024Log a) = 1023 := by omega
  rw [hsum]
  have h1023 : gf1024Exp 1023 = gf1024Exp 0 := gf1024Exp_congr (by decide)
  rw [h1023]
  exact gf1024Exp_zero

theorem gf1024Inv_mul_cancel {a : GF1024} (ha : a ≠ 0) :
    gf1024Mul (gf1024Inv a) a = 1 := by
  rw [gf1024Mul_comm]; exact gf1024Mul_inv_cancel ha

/-! ## The BIP-173 generator over `GF(1024)` -/

/-- The primitive root `zeta = gamma^457` of the dossier: in the `zeta` basis
    the generator's roots are `zeta^24, zeta^25, zeta^26` and conjugates. -/
def gf1024Zeta : GF1024 := gf1024Exp 457

/-- Evaluate `g(x) = x^6 + 29x^5 + 22x^4 + 20x^3 + 21x^2 + 29x + 18` over
    `GF(1024)`, coefficients embedded from `GF(32)`. -/
def gf1024GEval (x : GF1024) : GF1024 :=
  (gf1024Add (gf1024Emb 18) (gf1024Add (gf1024Mul (gf1024Emb 29) x) (gf1024Add (gf1024Mul (gf1024Emb 21) (gf1024Mul x x)) (gf1024Add (gf1024Mul (gf1024Emb 20) (gf1024Mul x (gf1024Mul x x))) (gf1024Add (gf1024Mul (gf1024Emb 22) (gf1024Mul x (gf1024Mul x (gf1024Mul x x)))) (gf1024Add (gf1024Mul (gf1024Emb 29) (gf1024Mul x (gf1024Mul x (gf1024Mul x (gf1024Mul x x))))) (gf1024Mul x (gf1024Mul x (gf1024Mul x (gf1024Mul x (gf1024Mul x x)))))))))))

theorem gf1024Zeta_root_24 : gf1024GEval (gf1024Exp (457 * 24 % 1023)) = 0 := by decide
theorem gf1024Zeta_root_25 : gf1024GEval (gf1024Exp (457 * 25 % 1023)) = 0 := by decide
theorem gf1024Zeta_root_26 : gf1024GEval (gf1024Exp (457 * 26 % 1023)) = 0 := by decide

end Bech32
