import LeanSha256

/-!
Kernel known-answer gates for the original `LeanSha256.hash`. Every message
is at most 120 bytes (at most three padded compression blocks). The ten
message lengths are 0, 3, 56, 1, 55, 63, 64, 65, 119, 120: 17 blocks total.
The million-byte and CAVP vectors belong only to the compiled runner.
-/

namespace Sha256Bridge.Vectors

set_option maxRecDepth 100000
set_option maxHeartbeats 0

/-- A padding-boundary message consisting of `n` ASCII `a` bytes. -/
def repeatedA (n : Nat) : ByteArray := ⟨Array.replicate n 0x61⟩

/-- FIPS 180-4 Appendix B.2, 56 bytes and two padded blocks. -/
def fips56Message : ByteArray :=
  "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq".toUTF8

/-- SHA-256 of the 0-byte message (1 padded block). -/
theorem empty :
    LeanSha256.hash (ByteArray.empty) = ByteArray.mk #[
    0xe3, 0xb0, 0xc4, 0x42, 0x98, 0xfc, 0x1c, 0x14,
    0x9a, 0xfb, 0xf4, 0xc8, 0x99, 0x6f, 0xb9, 0x24,
    0x27, 0xae, 0x41, 0xe4, 0x64, 0x9b, 0x93, 0x4c,
    0xa4, 0x95, 0x99, 0x1b, 0x78, 0x52, 0xb8, 0x55] := by
  decide +kernel

/-- SHA-256 of the 3-byte message (1 padded block). -/
theorem abc :
    LeanSha256.hash ("abc".toUTF8) = ByteArray.mk #[
    0xba, 0x78, 0x16, 0xbf, 0x8f, 0x01, 0xcf, 0xea,
    0x41, 0x41, 0x40, 0xde, 0x5d, 0xae, 0x22, 0x23,
    0xb0, 0x03, 0x61, 0xa3, 0x96, 0x17, 0x7a, 0x9c,
    0xb4, 0x10, 0xff, 0x61, 0xf2, 0x00, 0x15, 0xad] := by
  decide +kernel

/-- SHA-256 of the 56-byte message (2 padded blocks). -/
theorem fips56 :
    LeanSha256.hash (fips56Message) = ByteArray.mk #[
    0x24, 0x8d, 0x6a, 0x61, 0xd2, 0x06, 0x38, 0xb8,
    0xe5, 0xc0, 0x26, 0x93, 0x0c, 0x3e, 0x60, 0x39,
    0xa3, 0x3c, 0xe4, 0x59, 0x64, 0xff, 0x21, 0x67,
    0xf6, 0xec, 0xed, 0xd4, 0x19, 0xdb, 0x06, 0xc1] := by
  decide +kernel

/-- SHA-256 of the 1-byte message (1 padded block). -/
theorem boundary1 :
    LeanSha256.hash (repeatedA 1) = ByteArray.mk #[
    0xca, 0x97, 0x81, 0x12, 0xca, 0x1b, 0xbd, 0xca,
    0xfa, 0xc2, 0x31, 0xb3, 0x9a, 0x23, 0xdc, 0x4d,
    0xa7, 0x86, 0xef, 0xf8, 0x14, 0x7c, 0x4e, 0x72,
    0xb9, 0x80, 0x77, 0x85, 0xaf, 0xee, 0x48, 0xbb] := by
  decide +kernel

/-- SHA-256 of the 55-byte message (1 padded block). -/
theorem boundary55 :
    LeanSha256.hash (repeatedA 55) = ByteArray.mk #[
    0x9f, 0x43, 0x90, 0xf8, 0xd3, 0x0c, 0x2d, 0xd9,
    0x2e, 0xc9, 0xf0, 0x95, 0xb6, 0x5e, 0x2b, 0x9a,
    0xe9, 0xb0, 0xa9, 0x25, 0xa5, 0x25, 0x8e, 0x24,
    0x1c, 0x9f, 0x1e, 0x91, 0x0f, 0x73, 0x43, 0x18] := by
  decide +kernel

/-- SHA-256 of the 63-byte message (2 padded blocks). -/
theorem boundary63 :
    LeanSha256.hash (repeatedA 63) = ByteArray.mk #[
    0x7d, 0x3e, 0x74, 0xa0, 0x5d, 0x7d, 0xb1, 0x5b,
    0xce, 0x4a, 0xd9, 0xec, 0x06, 0x58, 0xea, 0x98,
    0xe3, 0xf0, 0x6e, 0xee, 0xcf, 0x16, 0xb4, 0xc6,
    0xff, 0xf2, 0xda, 0x45, 0x7d, 0xdc, 0x2f, 0x34] := by
  decide +kernel

/-- SHA-256 of the 64-byte message (2 padded blocks). -/
theorem boundary64 :
    LeanSha256.hash (repeatedA 64) = ByteArray.mk #[
    0xff, 0xe0, 0x54, 0xfe, 0x7a, 0xe0, 0xcb, 0x6d,
    0xc6, 0x5c, 0x3a, 0xf9, 0xb6, 0x1d, 0x52, 0x09,
    0xf4, 0x39, 0x85, 0x1d, 0xb4, 0x3d, 0x0b, 0xa5,
    0x99, 0x73, 0x37, 0xdf, 0x15, 0x46, 0x68, 0xeb] := by
  decide +kernel

/-- SHA-256 of the 65-byte message (2 padded blocks). -/
theorem boundary65 :
    LeanSha256.hash (repeatedA 65) = ByteArray.mk #[
    0x63, 0x53, 0x61, 0xc4, 0x8b, 0xb9, 0xea, 0xb1,
    0x41, 0x98, 0xe7, 0x6e, 0xa8, 0xab, 0x7f, 0x1a,
    0x41, 0x68, 0x5d, 0x6a, 0xd6, 0x2a, 0xa9, 0x14,
    0x6d, 0x30, 0x1d, 0x4f, 0x17, 0xeb, 0x0a, 0xe0] := by
  decide +kernel

/-- SHA-256 of the 119-byte message (2 padded blocks). -/
theorem boundary119 :
    LeanSha256.hash (repeatedA 119) = ByteArray.mk #[
    0x31, 0xeb, 0xa5, 0x1c, 0x31, 0x3a, 0x5c, 0x08,
    0x22, 0x6a, 0xdf, 0x18, 0xd4, 0xa3, 0x59, 0xcf,
    0xdf, 0xd8, 0xd2, 0xe8, 0x16, 0xb1, 0x3f, 0x4a,
    0xf9, 0x52, 0xf7, 0xea, 0x65, 0x84, 0xdc, 0xfb] := by
  decide +kernel

/-- SHA-256 of the 120-byte message (3 padded blocks). -/
theorem boundary120 :
    LeanSha256.hash (repeatedA 120) = ByteArray.mk #[
    0x2f, 0x3d, 0x33, 0x54, 0x32, 0xc7, 0x0b, 0x58,
    0x0a, 0xf0, 0xe8, 0xe1, 0xb3, 0x67, 0x4a, 0x7c,
    0x02, 0x0d, 0x68, 0x3a, 0xa5, 0xf7, 0x3a, 0xaa,
    0xed, 0xfd, 0xc5, 0x5a, 0xf9, 0x04, 0xc2, 0x1c] := by
  decide +kernel

end Sha256Bridge.Vectors
